<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="1">
        <report
                id="report_maquinas_ventas"
                model="sat.sat"
                string="Maquinas"
                name="sat.maquina_view"
                file="sat.sat"
                report_type="qweb-pdf"
                print_report_name="object.name"/>

        <template id="maquinas_id">
            <t t-call="report.html_container">
                <t t-foreach="docs" t-as="o">
                <div class="page">
                    <table class="table table-condensed">
                    <thead>
                        <tr>
                        <th>Modelo</th>
                        <th>Serie</th>
                        <th>Problema</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.filtered_data" t-as="data">
                        <tr>
                            <td><t t-esc="data.name"/></td>
                            <td><t t-esc="data.name"/></td>
                            <td><t t-esc="data.name"/></td>
                        </tr>
                        </t>
                    </tbody>
                    </table>
                </div>
                </t>
            </t>
            </template>    
    </data>
    
</odoo>
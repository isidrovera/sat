<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_reparaciones_ventas">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="reparaciones">
        <t t-call="web.external_layout">
          <div class="page">
            <style>
              :root{
                --primary-color:#3498db;--primary-dark:#2980b9;--secondary-color:#2c3e50;--accent-color:#1abc9c;
                --light-bg:#f8f9fa;--border-color:#e9ecef;--text-color:#333;--text-light:#6c757d;--success:#2ecc71;
                --warning:#f39c12;--danger:#e74c3c;--white:#ffffff;
                --estado-sin-revisar:#6c757d;--estado-para-revision:#17a2b8;--estado-en-revision:#ffc107;
                --estado-finalizado:#28a745;--estado-con-problemas:#dc3545;--estado-de-partes:#fd7e14;--estado-entregada:#20c997;
              }
              body{font-family:'Roboto',sans-serif;color:var(--text-color);line-height:1.6;}
              .shadow{box-shadow:0 4px 6px rgba(0,0,0,.1);} .rounded{border-radius:8px;}
              .mb-3{margin-bottom:1rem;} .p-3{padding:1rem;}

              .repair-header{
                background:linear-gradient(135deg,var(--secondary-color) 0%,var(--primary-color) 100%);
                color:var(--white);padding:25px;border-radius:12px;margin-bottom:30px;
                box-shadow:0 6px 12px rgba(0,0,0,.15);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;
              }
              .header-left{flex:1;}
              .header-title{font-size:28px;font-weight:bold;margin-bottom:10px;color:var(--white);}
              .header-subtitle{font-size:16px;color:rgba(255,255,255,.9);}
              .header-right{background:rgba(255,255,255,.15);padding:15px;border-radius:8px;backdrop-filter:blur(10px);min-width:200px;}
              .header-status{font-weight:bold;text-transform:uppercase;text-align:center;}

              .section-title{
                background:var(--secondary-color);color:var(--white);padding:12px 20px;margin:25px 0 15px;border-radius:8px;
                font-size:18px;font-weight:bold;display:flex;align-items:center;box-shadow:0 2px 4px rgba(0,0,0,.1);
              }
              .section-title i{margin-right:10px;}

              .info-card{background:var(--white);border-radius:10px;box-shadow:0 4px 6px rgba(0,0,0,.1);margin-bottom:20px;overflow:hidden;border:1px solid var(--border-color);}
              .info-table{width:100%;border-collapse:separate;border-spacing:0;margin-bottom:0;}
              .info-table th{background:var(--light-bg);color:var(--secondary-color);padding:12px 15px;font-weight:bold;border:1px solid var(--border-color);}
              .info-table td{padding:12px 15px;border:1px solid var(--border-color);}
              .info-table i{margin-right:8px;color:var(--primary-color);}

              .informe-tecnico{padding:20px;background:var(--light-bg);border-radius:8px;border-left:4px solid var(--primary-color);}

              .status-badge{padding:6px 12px;border-radius:20px;font-size:13px;font-weight:bold;display:inline-block;color:white;text-align:center;box-shadow:0 2px 4px rgba(0,0,0,.1);margin:5px 0;min-width:140px;}
              .header-subtitle .status-badge{margin-top:10px;font-size:14px;padding:8px 15px;}
              .status-ok{background:var(--success);} .status-warning{background:var(--warning);} .status-error{background:var(--danger);}
              .status-sin-revisar{background:var(--estado-sin-revisar);} .status-para-revision{background:var(--estado-para-revision);}
              .status-en-revision{background:var(--estado-en-revision);color:#333;} .status-finalizado{background:var(--estado-finalizado);}
              .status-con-problemas{background:var(--estado-con-problemas);} .status-de-partes{background:var(--estado-de-partes);} .status-entregada{background:var(--estado-entregada);}

              .signatures{display:flex;justify-content:space-between;margin-top:40px;}
              .signature-box{flex:0 0 45%;border-top:2px solid var(--secondary-color);padding-top:15px;text-align:center;}
              .signature-icon{font-size:24px;color:var(--secondary-color);margin-bottom:8px;}

              /* Chips de subpartes */
              .chip{display:inline-block;border:1px solid var(--border-color);padding:2px 6px;border-radius:10px;margin:2px 4px 0 0;font-size:12px;white-space:nowrap;}
              .chip i{margin-right:4px;}

              /* Toner: barra */
              .toner-bar{height:8px;border-radius:6px;background:#eee;overflow:hidden}
              .toner-fill{height:100%}
              .k{background:#777;} .c{background:#0bbee6;} .m{background:#ff00d0;} .y{background:#ffd400;}

              /* Columnas compactas */
              .td-compact{vertical-align:top}
            </style>

            <!-- Encabezado -->
            <div class="repair-header">
              <div class="header-left">
                <div class="header-title">
                  <i class="fa fa-tools"></i>
                  Orden de Reparación: <t t-esc="reparaciones.name"/>
                </div>
                <div class="header-subtitle">
                  <t t-set="estado" t-value="selection_labels.get(reparaciones.id, {}).get('estado_id', 'Sin asignar')"/>
                  <t t-if="estado == 'Finalizado'">
                    <div style="display:inline-block;background-color:#28a745;color:white;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;">
                      <i class="fa fa-check-circle"></i> <t t-esc="estado"/>
                    </div>
                  </t>
                  <t t-elif="estado == 'En revisión'">
                    <div style="display:inline-block;background-color:#ffc107;color:#333;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;">
                      <i class="fa fa-sync"></i> <t t-esc="estado"/>
                    </div>
                  </t>
                  <t t-elif="estado == 'Con problemas'">
                    <div style="display:inline-block;background-color:#dc3545;color:white;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;">
                      <i class="fa fa-exclamation-triangle"></i> <t t-esc="estado"/>
                    </div>
                  </t>
                  <t t-elif="estado == 'De partes'">
                    <div style="display:inline-block;background-color:#fd7e14;color:white;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;">
                      <i class="fa fa-tools"></i> <t t-esc="estado"/>
                    </div>
                  </t>
                  <t t-elif="estado == 'Sin revisar'">
                    <div style="display:inline-block;background-color:#6c757d;color:white;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;">
                      <i class="fa fa-clock"></i> <t t-esc="estado"/>
                    </div>
                  </t>
                  <t t-elif="estado == 'Para revision'">
                    <div style="display:inline-block;background-color:#17a2b8;color:white;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;">
                      <i class="fa fa-search"></i> <t t-esc="estado"/>
                    </div>
                  </t>
                  <t t-elif="estado == 'Entregada'">
                    <div style="display:inline-block;background-color:#20c997;color:white;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;">
                      <i class="fa fa-handshake"></i> <t t-esc="estado"/>
                    </div>
                  </t>
                  <t t-else="">
                    <div style="display:inline-block;background-color:#6c757d;color:white;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;">
                      <i class="fa fa-question-circle"></i> <t t-esc="estado"/>
                    </div>
                  </t>
                </div>
              </div>
              <div class="header-right">
                <div class="header-status">
                  Cliente: <t t-esc="reparaciones.cliente_id.name"/>
                </div>
                <div style="margin-top:10px;text-align:center;font-size:12px;">
                  <t t-if="reparaciones.responsable_id">
                    Responsable: <t t-esc="reparaciones.nombre_responsable"/>
                  </t>
                </div>
              </div>
            </div>

            <!-- INFORMACIÓN DEL EQUIPO -->
            <div class="section-title">
              <i class="fa fa-info-circle"></i> INFORMACIÓN DEL EQUIPO
            </div>
            <div class="info-card mb-3">
              <div style="background:var(--secondary-color);color:white;padding:8px 15px;font-weight:bold;">
                <i class="fa fa-desktop"></i> IDENTIFICACIÓN DEL EQUIPO
              </div>
              <table class="info-table">
                <tr>
                  <th style="width:16%"><i class="fa fa-print"></i>Tipo de equipo</th>
                  <td style="width:17%"><t t-esc="reparaciones.tipo_machine"/></td>
                  <th style="width:16%"><i class="fa fa-tag"></i>Marca</th>
                  <td style="width:17%"><t t-esc="reparaciones.marca"/></td>
                  <th style="width:16%"><i class="fa fa-desktop"></i>Modelo</th>
                  <td style="width:18%"><t t-esc="reparaciones.maquina_id.name.name"/></td>
                </tr>
                <tr>
                  <th><i class="fa fa-barcode"></i>Número de serie</th>
                  <td colspan="5"><t t-esc="reparaciones.serie_id"/></td>
                </tr>
              </table>
            </div>

            <div class="info-card mb-3">
              <div style="background:var(--primary-dark);color:white;padding:8px 15px;font-weight:bold;">
                <i class="fa fa-cog"></i> ESTADO TÉCNICO
              </div>
              <table class="info-table">
                <tr>
                  <th style="width:20%"><i class="fa fa-tachometer-alt"></i>Contómetro</th>
                  <td style="width:30%"><t t-esc="reparaciones.contometrok_id"/></td>
                  <th style="width:20%"><i class="fa fa-check-circle"></i>Calidad</th>
                  <td style="width:30%">
                    <t t-if="selection_labels.get(reparaciones.id, {}).get('calidad_id', 'NA') == 'Calidad de Impresión Óptima - Cumple Estándares'">
                      <div style="display:inline-block;background-color:#2ecc71;color:white;padding:5px 10px;border-radius:4px;">
                        <i class="fa fa-check"></i> Óptima
                      </div>
                    </t>
                    <t t-elif="selection_labels.get(reparaciones.id, {}).get('calidad_id', 'NA') == 'Calidad de Impresión Aceptable - Requiere Ajustes'">
                      <div style="display:inline-block;background-color:#f39c12;color:white;padding:5px 10px;border-radius:4px;">
                        <i class="fa fa-exclamation-triangle"></i> Aceptable
                      </div>
                    </t>
                    <t t-elif="selection_labels.get(reparaciones.id, {}).get('calidad_id', 'NA') == 'Calidad de Impresión Deficiente - Requiere Atención Inmediata'">
                      <div style="display:inline-block;background-color:#e74c3c;color:white;padding:5px 10px;border-radius:4px;">
                        <i class="fa fa-times"></i> Deficiente
                      </div>
                    </t>
                    <t t-else="">
                      <t t-esc="selection_labels.get(reparaciones.id, {}).get('calidad_id', 'NA')"/>
                    </t>
                  </td>
                </tr>
              </table>
            </div>

            <!-- INFORME TÉCNICO -->
            <div class="section-title">
              <i class="fa fa-clipboard-list"></i> INFORME TÉCNICO
            </div>
            <div class="info-card">
              <div class="informe-tecnico">
                <t t-raw="reparaciones.informe"/>
              </div>
            </div>

            <!-- ACCESORIOS (nuevo sistema) -->
            <div class="section-title">
              <i class="fa fa-puzzle-piece"></i> ACCESORIOS
            </div>
            <div class="info-card">
              <table class="info-table">
                <thead>
                  <tr>
                    <th style="width:28%"><i class="fa fa-puzzle-piece"></i> Accesorio</th>
                    <th style="width:18%"><i class="fa fa-info-circle"></i> Estado</th>
                    <th style="width:36%"><i class="fa fa-cubes"></i> Subpartes</th>
                    <th style="width:18%"><i class="fa fa-sticky-note"></i> Observaciones</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-if="not reparaciones.accesorio_eval_ids">
                    <tr><td colspan="4" style="text-align:center;color:var(--text-light);">— Sin accesorios evaluados —</td></tr>
                  </t>
                  <t t-foreach="reparaciones.accesorio_eval_ids" t-as="acc">
                    <tr>
                      <td class="td-compact"><i class="fa fa-puzzle-piece"></i> <t t-esc="acc.tipo_id.name"/></td>
                      <td class="td-compact">
                        <t t-if="acc.estado_id">
                          <t t-set="ecode" t-value="acc.estado_id.code or ''"/>
                          <t t-if="ecode in ['instalado_operativo','revisado','nuevo','correcto']">
                            <span class="status-badge status-ok"><i class="fa fa-check"></i> <t t-esc="acc.estado_id.name"/></span>
                          </t>
                          <t t-elif="ecode in ['instalado_con_falla','requiere_cambio','cambio_de_repuestos','falla']">
                            <span class="status-badge status-error"><i class="fa fa-exclamation-triangle"></i> <t t-esc="acc.estado_id.name"/></span>
                          </t>
                          <t t-elif="ecode in ['no_instalado','regular','mantenimiento','gastada_pero_puede_trabajar','sin_probar','sin_revisar']">
                            <span class="status-badge status-warning"><i class="fa fa-info-circle"></i> <t t-esc="acc.estado_id.name"/></span>
                          </t>
                          <t t-else="">
                            <span class="status-badge status-sin-revisar"><i class="fa fa-minus-circle"></i> <t t-esc="acc.estado_id.name"/></span>
                          </t>
                        </t>
                        <t t-else="">—</t>
                      </td>
                      <td class="td-compact">
                        <t t-set="subs" t-value="reparaciones.get_subpartes_accesorio(acc)"/>
                        <t t-if="subs">
                          <t t-foreach="subs" t-as="spn">
                            <span class="chip"><i class="fa fa-puzzle-piece"></i> <t t-esc="spn"/></span>
                          </t>
                        </t>
                        <t t-else="">—</t>
                      </td>
                      <td class="td-compact"><t t-esc="acc.observaciones or '—'"/></td>
                    </tr>
                  </t>
                </tbody>
              </table>
            </div>

            <!-- CHECK LIST (nuevo sistema de componentes) -->
            <div class="section-title">
              <i class="fa fa-tasks"></i> CHECK LIST
            </div>
            <div class="info-card">
              <table class="info-table">
                <thead>
                  <tr>
                    <th style="width:28%"><i class="fa fa-cog"></i> Componente</th>
                    <th style="width:10%"><i class="fa fa-palette"></i> Color</th>
                    <th style="width:18%"><i class="fa fa-info-circle"></i> Estado</th>
                    <th style="width:26%"><i class="fa fa-tools"></i> Subpartes (si requiere cambio)</th>
                    <th style="width:18%"><i class="fa fa-sticky-note"></i> Observaciones</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-if="not reparaciones.evaluacion_ids">
                    <tr><td colspan="5" style="text-align:center;color:var(--text-light);">— Sin componentes evaluados —</td></tr>
                  </t>

                  <!-- 1) Filas de TÓNER con barra -->
                  <t t-foreach="reparaciones.evaluacion_ids" t-as="ev">
                    <t t-set="tcode" t-value="(ev.componente_tipo_id.code or '').upper()"/>
                    <t t-if="tcode == 'TONER_SYSTEM'">
                      <tr>
                        <td class="td-compact">
                          <i class="fa fa-tint"></i>
                          <t t-esc="ev.componente_tipo_id.name"/>
                        </td>
                        <td class="td-compact">
                          <t t-esc="ev.color_id and ev.color_id.name or '—'"/>
                        </td>
                        <td class="td-compact">
                          <t t-if="ev.estado_id">
                            <t t-set="ecode" t-value="ev.estado_id.code or ''"/>
                            <t t-if="ecode in ['correcto','revisado','nuevo']">
                              <span class="status-badge status-ok"><i class="fa fa-check"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                            <t t-elif="ecode in ['vacio','sin_botella','falla','requiere_cambio']">
                              <span class="status-badge status-error"><i class="fa fa-exclamation-triangle"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                            <t t-elif="ecode in ['bajo','regular','mantenimiento','sin_probar','sin_revisar']">
                              <span class="status-badge status-warning"><i class="fa fa-info-circle"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                            <t t-else="">
                              <span class="status-badge status-sin-revisar"><i class="fa fa-minus-circle"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                          </t>
                          <t t-else="">—</t>
                        </td>
                        <td class="td-compact">
                          <!-- Barra de nivel de tóner -->
                          <t t-set="ecode" t-value="ev.estado_id and ev.estado_id.code or ''"/>
                          <t t-set="lvl" t-value="0"/>
                          <t t-if="ecode == 'vacio'">
                            <t t-set="lvl" t-value="0"/>
                          </t>
                          <t t-elif="ecode == 'sin_botella'">
                            <t t-set="lvl" t-value="0"/>
                          </t>
                          <t t-elif="ecode == 'bajo'">
                            <t t-set="lvl" t-value="25"/>
                          </t>
                          <t t-elif="ecode in ['regular','mantenimiento']">
                            <t t-set="lvl" t-value="50"/>
                          </t>
                          <t t-elif="ecode in ['revisado','correcto','nuevo']">
                            <t t-set="lvl" t-value="100"/>
                          </t>
                          <t t-set="color_class" t-value="(ev.color_id and (ev.color_id.code or '').lower()) or ''"/>
                          <div class="toner-bar">
                            <div t-att-class="'toner-fill ' + (color_class or '')" t-attf-style="width:#{lvl}%;"></div>
                          </div>
                          <div style="font-size:12px;color:var(--text-light);margin-top:4px;">
                            <i class="fa fa-tint"></i>
                            <t t-esc="(ev.color_id and ev.color_id.name) or 'Sin color'"/> —
                            <t t-esc="ev.estado_id and ev.estado_id.name or 'Sin estado'"/>
                          </div>
                        </td>
                        <td class="td-compact"><t t-esc="ev.observaciones or '—'"/></td>
                      </tr>
                    </t>
                  </t>

                  <!-- 2) Resto de componentes con subpartes -->
                  <t t-foreach="reparaciones.evaluacion_ids" t-as="ev">
                    <t t-set="tcode" t-value="(ev.componente_tipo_id.code or '').upper()"/>
                    <t t-if="tcode != 'TONER_SYSTEM'">
                      <tr>
                        <td class="td-compact">
                          <i class="fa fa-cog"></i>
                          <t t-esc="ev.componente_tipo_id.name"/>
                        </td>
                        <td class="td-compact">
                          <t t-esc="ev.color_id and ev.color_id.name or '—'"/>
                        </td>
                        <td class="td-compact">
                          <t t-if="ev.estado_id">
                            <t t-set="ecode" t-value="ev.estado_id.code or ''"/>
                            <t t-if="ecode in ['correcto','revisado','nuevo']">
                              <span class="status-badge status-ok"><i class="fa fa-check"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                            <t t-elif="ecode in ['requiere_cambio','cambio_de_repuestos','falla']">
                              <span class="status-badge status-error"><i class="fa fa-exclamation-triangle"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                            <t t-elif="ecode in ['regular','mantenimiento','gastada_pero_puede_trabajar','sin_probar','sin_revisar']">
                              <span class="status-badge status-warning"><i class="fa fa-info-circle"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                            <t t-else="">
                              <span class="status-badge status-sin-revisar"><i class="fa fa-minus-circle"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                          </t>
                          <t t-else="">—</t>
                        </td>
                        <td class="td-compact">
                          <!-- Subpartes solo si requiere cambio/falla -->
                          <t t-set="ecode" t-value="ev.estado_id and ev.estado_id.code or ''"/>
                          <t t-if="ecode in ['requiere_cambio','cambio_de_repuestos','falla']">
                            <t t-set="subs" t-value="reparaciones.get_subpartes_componente(ev)"/>
                            <t t-if="subs">
                              <t t-foreach="subs" t-as="spn">
                                <span class="chip"><i class="fa fa-tools"></i> <t t-esc="spn"/></span>
                              </t>
                            </t>
                            <t t-else="">—</t>
                          </t>
                          <t t-else="">—</t>
                        </td>
                        <td class="td-compact"><t t-esc="ev.observaciones or '—'"/></td>
                      </tr>
                    </t>
                  </t>
                </tbody>
              </table>
            </div>

            <!-- FIRMAS -->
            <div class="signatures">
              <div class="signature-box">
                <div class="signature-icon"><i class="fa fa-user-tie"></i></div>
                <p>Firma del Técnico</p>
                <p><t t-esc="reparaciones.nombre_responsable"/></p>
              </div>
              <div class="signature-box">
                <div class="signature-icon"><i class="fa fa-user"></i></div>
                <p>Firma del Cliente</p>
                <p><t t-esc="reparaciones.cliente_id.name"/></p>
              </div>
            </div>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>

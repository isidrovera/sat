<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_reparaciones_ventas">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="reparaciones">
        <t t-call="web.external_layout">
          <div class="page">
            <style>
              /* ===== Paleta & base ===== */
              :root{
                --primary-color:#3498db; --primary-dark:#2b7bb3; --secondary-color:#2c3e50; --accent-color:#1abc9c;
                --light-bg:#f7f9fb; --border-color:#e6ecf1; --text-color:#2f3640; --text-light:#6c757d; --white:#ffffff;
                --success:#2ecc71; --warning:#f39c12; --danger:#e74c3c;
                --estado-sin-revisar:#6c757d; --estado-para-revision:#17a2b8; --estado-en-revision:#ffc107;
                --estado-finalizado:#28a745; --estado-con-problemas:#dc3545; --estado-de-partes:#fd7e14; --estado-entregada:#20c997;
              }
              body{font-family:'Roboto',sans-serif;color:var(--text-color);line-height:1.6;}
              .shadow{box-shadow:0 6px 14px rgba(28,33,40,.08);} .rounded{border-radius:10px;}
              .mb-3{margin-bottom:14px;} .p-3{padding:1rem;}

              /* ===== Header ===== */
              .repair-header{
                background:linear-gradient(135deg,var(--secondary-color) 0%,var(--primary-color) 100%);
                color:var(--white); padding:24px; border-radius:14px; margin-bottom:26px;
                box-shadow:0 10px 24px rgba(0,0,0,.15); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap;
              }
              .header-left{flex:1; min-width:340px;}
              .header-title{font-size:26px; font-weight:800; letter-spacing:.2px; margin-bottom:8px;}
              .header-subtitle{font-size:15px; color:rgba(255,255,255,.95);}
              .header-right{background:rgba(255,255,255,.14); padding:12px 16px; border-radius:10px; min-width:220px; text-align:center; box-shadow:inset 0 0 0 1px rgba(255,255,255,.1);}
              .header-status{font-weight:700; text-transform:uppercase;}

              /* ===== Títulos de sección ===== */
              .section-title{
                background:var(--secondary-color); color:var(--white);
                padding:10px 16px; margin:20px 0 10px; border-radius:10px; font-size:16px; font-weight:800;
                display:flex; align-items:center; box-shadow:0 2px 6px rgba(0,0,0,.12);
              }
              .section-title i{margin-right:9px;}

              /* ===== Cards & tablas ===== */
              .info-card{background:var(--white); border-radius:12px; box-shadow:0 6px 18px rgba(30,35,40,.07); margin-bottom:16px; overflow:hidden; border:1px solid var(--border-color);}
              .info-table{width:100%; border-collapse:separate; border-spacing:0;}
              .info-table th{background:var(--light-bg); color:#243447; padding:10px 12px; font-weight:800; border:1px solid var(--border-color); font-size:12px; letter-spacing:.2px;}
              .info-table td{padding:10px 12px; border:1px solid var(--border-color); vertical-align:middle; font-size:13px;}
              .info-table i{margin-right:7px; color:var(--primary-dark);}
              .td-compact{vertical-align:top}

              /* ===== Badge de estado (mejor contraste) ===== */
              .status-badge{
                display:inline-flex; align-items:center; gap:6px;
                padding:6px 12px; border-radius:999px; font-size:12px; font-weight:800; letter-spacing:.2px;
                color:#fff; box-shadow:0 2px 6px rgba(0,0,0,.12);
              }
              .status-ok{ background:linear-gradient(135deg,#2ecc71,#29b765);}
              .status-warning{ background:linear-gradient(135deg,#f5a623,#f39c12);}
              .status-error{ background:linear-gradient(135deg,#ff5b5b,#e74c3c);}
              .status-sin-revisar{ background:linear-gradient(135deg,#7b8a97,#6c757d);}

              /* ===== Chips de subpartes ===== */
              .chip{
                display:inline-flex; align-items:center; gap:6px;
                border:1px solid var(--border-color); padding:3px 8px; border-radius:999px; margin:2px 6px 0 0;
                font-size:12px; background:#fafcff;
              }
              .chip i{color:var(--primary-dark);}

              /* ===== Bloque informe ===== */
              .informe-tecnico{padding:18px; background:var(--light-bg); border-radius:10px; border-left:5px solid var(--primary-color);}

              /* ===== Toner: barra de progreso por color ===== */
              .toner-bar{height:9px; border-radius:6px; background:#eceff3; overflow:hidden; box-shadow:inset 0 2px 4px rgba(0,0,0,.06);}
              .toner-fill{height:100%;}
              .k{background:linear-gradient(90deg,#5f6368,#80868b);}
              .c{background:linear-gradient(90deg,#00bcd4,#0bbee6);}
              .m{background:linear-gradient(90deg,#ff5db1,#ff00d0);}
              .y{background:linear-gradient(90deg,#ffd400,#ffea67);}

              /* ===== Etiquetas de la cabecera de equipo ===== */
              .mini-title{display:flex; align-items:center; gap:8px; font-weight:800; color:#1e2a35;}
              .mini-title .dot{width:7px; height:7px; border-radius:50%; background:var(--primary-dark); display:inline-block;}
            </style>

            <!-- ===== Encabezado ===== -->
            <div class="repair-header">
              <div class="header-left">
                <div class="header-title">
                  <i class="fa fa-tools"></i>
                  Orden de Reparación: <t t-esc="reparaciones.name"/>
                </div>
                <div class="header-subtitle">
                  <t t-set="estado" t-value="selection_labels.get(reparaciones.id, {}).get('estado_id', 'Sin asignar')"/>
                  <t t-if="estado == 'Finalizado'">
                    <span class="status-badge" style="background:linear-gradient(135deg,#28a745,#1f8f39);"><i class="fa fa-check-circle"></i><t t-esc="estado"/></span>
                  </t>
                  <t t-elif="estado == 'En revisión'">
                    <span class="status-badge" style="background:linear-gradient(135deg,#fdd835,#ffc107); color:#222;"><i class="fa fa-sync"></i><t t-esc="estado"/></span>
                  </t>
                  <t t-elif="estado == 'Con problemas'">
                    <span class="status-badge status-error"><i class="fa fa-exclamation-triangle"></i><t t-esc="estado"/></span>
                  </t>
                  <t t-elif="estado == 'De partes'">
                    <span class="status-badge" style="background:linear-gradient(135deg,#fd8f3e,#fd7e14);"><i class="fa fa-tools"></i><t t-esc="estado"/></span>
                  </t>
                  <t t-elif="estado == 'Sin revisar'">
                    <span class="status-badge status-sin-revisar"><i class="fa fa-clock"></i><t t-esc="estado"/></span>
                  </t>
                  <t t-elif="estado == 'Para revision'">
                    <span class="status-badge" style="background:linear-gradient(135deg,#2dc7da,#17a2b8);"><i class="fa fa-search"></i><t t-esc="estado"/></span>
                  </t>
                  <t t-elif="estado == 'Entregada'">
                    <span class="status-badge" style="background:linear-gradient(135deg,#27e1b2,#20c997);"><i class="fa fa-handshake"></i><t t-esc="estado"/></span>
                  </t>
                  <t t-else="">
                    <span class="status-badge status-sin-revisar"><i class="fa fa-question-circle"></i><t t-esc="estado"/></span>
                  </t>
                </div>
              </div>
              <div class="header-right">
                <div class="header-status">Cliente: <t t-esc="reparaciones.cliente_id.name"/></div>
                <div style="margin-top:8px; font-size:12px;">
                  <t t-if="reparaciones.responsable_id">
                    Responsable: <t t-esc="reparaciones.nombre_responsable"/>
                  </t>
                </div>
              </div>
            </div>

            <!-- ===== Información del equipo ===== -->
            <div class="section-title"><i class="fa fa-info-circle"/> INFORMACIÓN DEL EQUIPO</div>

            <div class="info-card mb-3">
              <div style="background:var(--secondary-color);color:#fff;padding:8px 14px;font-weight:800;">
                <i class="fa fa-desktop"/> IDENTIFICACIÓN DEL EQUIPO
              </div>
              <table class="info-table">
                <tr>
                  <th style="width:16%"><span class="mini-title"><span class="dot"></span><i class="fa fa-print"></i>Tipo de equipo</span></th>
                  <td style="width:17%"><t t-esc="reparaciones.tipo_machine"/></td>
                  <th style="width:16%"><span class="mini-title"><span class="dot"></span><i class="fa fa-tag"></i>Marca</span></th>
                  <td style="width:17%"><t t-esc="reparaciones.marca"/></td>
                  <th style="width:16%"><span class="mini-title"><span class="dot"></span><i class="fa fa-desktop"></i>Modelo</span></th>
                  <td style="width:18%"><t t-esc="reparaciones.maquina_id.name.name"/></td>
                </tr>
                <tr>
                  <th><span class="mini-title"><span class="dot"></span><i class="fa fa-barcode"></i>Número de serie</span></th>
                  <td colspan="5"><t t-esc="reparaciones.serie_id"/></td>
                </tr>
              </table>
            </div>

            <div class="info-card mb-3">
              <div style="background:var(--primary-dark);color:#fff;padding:8px 14px;font-weight:800;">
                <i class="fa fa-cog"/> ESTADO TÉCNICO
              </div>
              <table class="info-table">
                <tr>
                  <th style="width:20%"><i class="fa fa-tachometer-alt"></i>Contómetro</th>
                  <td style="width:30%"><t t-esc="reparaciones.contometrok_id"/></td>
                  <th style="width:20%"><i class="fa fa-check-circle"></i>Calidad</th>
                  <td style="width:30%">
                    <t t-if="selection_labels.get(reparaciones.id, {}).get('calidad_id', 'NA') == 'Calidad de Impresión Óptima - Cumple Estándares'">
                      <span class="status-badge status-ok"><i class="fa fa-check"></i> Óptima</span>
                    </t>
                    <t t-elif="selection_labels.get(reparaciones.id, {}).get('calidad_id', 'NA') == 'Calidad de Impresión Aceptable - Requiere Ajustes'">
                      <span class="status-badge status-warning"><i class="fa fa-exclamation-triangle"></i> Aceptable</span>
                    </t>
                    <t t-elif="selection_labels.get(reparaciones.id, {}).get('calidad_id', 'NA') == 'Calidad de Impresión Deficiente - Requiere Atención Inmediata'">
                      <span class="status-badge status-error"><i class="fa fa-times"></i> Deficiente</span>
                    </t>
                    <t t-else="">
                      <t t-esc="selection_labels.get(reparaciones.id, {}).get('calidad_id', 'NA')"/>
                    </t>
                  </td>
                </tr>
              </table>
            </div>

            <!-- ===== Informe técnico ===== -->
            <div class="section-title"><i class="fa fa-clipboard-list"/> INFORME TÉCNICO</div>
            <div class="info-card">
              <div class="informe-tecnico">
                <t t-raw="reparaciones.informe"/>
              </div>
            </div>

            <!-- ===== Accesorios (nuevo sistema) ===== -->
            <div class="section-title"><i class="fa fa-puzzle-piece"/> ACCESORIOS</div>
            <div class="info-card">
              <table class="info-table">
                <thead>
                  <tr>
                    <th style="width:28%"><i class="fa fa-puzzle-piece"></i>Accesorio</th>
                    <th style="width:18%"><i class="fa fa-info-circle"></i>Estado</th>
                    <th style="width:36%"><i class="fa fa-cubes"></i>Subpartes</th>
                    <th style="width:18%"><i class="fa fa-sticky-note"></i>Observaciones</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-if="not reparaciones.accesorio_eval_ids">
                    <tr><td colspan="4" style="text-align:center;color:var(--text-light);">— Sin accesorios evaluados —</td></tr>
                  </t>
                  <t t-foreach="reparaciones.accesorio_eval_ids" t-as="acc">
                    <tr>
                      <td class="td-compact"><i class="fa fa-puzzle-piece"></i> <t t-esc="acc.tipo_id.name"/></td>
                      <td class="td-compact">
                        <t t-if="acc.estado_id">
                          <t t-set="ecode" t-value="acc.estado_id.code or ''"/>
                          <t t-if="ecode in ['instalado_operativo','revisado','nuevo','correcto']">
                            <span class="status-badge status-ok"><i class="fa fa-check"></i> <t t-esc="acc.estado_id.name"/></span>
                          </t>
                          <t t-elif="ecode in ['instalado_con_falla','requiere_cambio','cambio_de_repuestos','falla']">
                            <span class="status-badge status-error"><i class="fa fa-exclamation-triangle"></i> <t t-esc="acc.estado_id.name"/></span>
                          </t>
                          <t t-elif="ecode in ['no_instalado','regular','mantenimiento','gastada_pero_puede_trabajar','sin_probar','sin_revisar']">
                            <span class="status-badge status-warning"><i class="fa fa-info-circle"></i> <t t-esc="acc.estado_id.name"/></span>
                          </t>
                          <t t-else="">
                            <span class="status-badge status-sin-revisar"><i class="fa fa-minus-circle"></i> <t t-esc="acc.estado_id.name"/></span>
                          </t>
                        </t>
                        <t t-else="">—</t>
                      </td>
                      <td class="td-compact">
                        <t t-set="subs" t-value="reparaciones.get_subpartes_accesorio(acc)"/>
                        <t t-if="subs">
                          <t t-foreach="subs" t-as="spn">
                            <span class="chip"><i class="fa fa-puzzle-piece"></i> <t t-esc="spn"/></span>
                          </t>
                        </t>
                        <t t-else="">—</t>
                      </td>
                      <td class="td-compact"><t t-esc="acc.observaciones or '—'"/></td>
                    </tr>
                  </t>
                </tbody>
              </table>
            </div>

            <!-- ===== Check list (nuevo sistema de componentes) ===== -->
            <div class="section-title"><i class="fa fa-tasks"/> CHECK LIST</div>
            <div class="info-card">
              <table class="info-table">
                <thead>
                  <tr>
                    <th style="width:28%"><i class="fa fa-cog"></i>Componente</th>
                    <th style="width:10%"><i class="fa fa-palette"></i>Color</th>
                    <th style="width:18%"><i class="fa fa-info-circle"></i>Estado</th>
                    <th style="width:26%"><i class="fa fa-tools"></i>Subpartes (si requiere cambio)</th>
                    <th style="width:18%"><i class="fa fa-sticky-note"></i>Observaciones</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-if="not reparaciones.evaluacion_ids">
                    <tr><td colspan="5" style="text-align:center;color:var(--text-light);">— Sin componentes evaluados —</td></tr>
                  </t>

                  <!-- 1) TONER con barra -->
                  <t t-foreach="reparaciones.evaluacion_ids" t-as="ev">
                    <t t-set="tcode" t-value="(ev.componente_tipo_id.code or '').upper()"/>
                    <t t-if="tcode == 'TONER_SYSTEM'">
                      <tr>
                        <td class="td-compact"><i class="fa fa-tint"></i> <t t-esc="ev.componente_tipo_id.name"/></td>
                        <td class="td-compact"><t t-esc="ev.color_id and ev.color_id.name or '—'"/></td>
                        <td class="td-compact">
                          <t t-if="ev.estado_id">
                            <t t-set="ecode" t-value="ev.estado_id.code or ''"/>
                            <t t-if="ecode in ['correcto','revisado','nuevo']">
                              <span class="status-badge status-ok"><i class="fa fa-check"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                            <t t-elif="ecode in ['vacio','sin_botella','falla','requiere_cambio']">
                              <span class="status-badge status-error"><i class="fa fa-exclamation-triangle"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                            <t t-elif="ecode in ['bajo','regular','mantenimiento','sin_probar','sin_revisar']">
                              <span class="status-badge status-warning"><i class="fa fa-info-circle"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                            <t t-else="">
                              <span class="status-badge status-sin-revisar"><i class="fa fa-minus-circle"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                          </t>
                          <t t-else="">—</t>
                        </td>
                        <td class="td-compact">
                          <!-- Nivel de tóner -->
                          <t t-set="ecode" t-value="ev.estado_id and ev.estado_id.code or ''"/>
                          <t t-set="lvl" t-value="0"/>
                          <t t-if="ecode == 'vacio'"><t t-set="lvl" t-value="0"/></t>
                          <t t-elif="ecode == 'sin_botella'"><t t-set="lvl" t-value="0"/></t>
                          <t t-elif="ecode == 'bajo'"><t t-set="lvl" t-value="25"/></t>
                          <t t-elif="ecode in ['regular','mantenimiento']"><t t-set="lvl" t-value="50"/></t>
                          <t t-elif="ecode in ['revisado','correcto','nuevo']"><t t-set="lvl" t-value="100"/></t>

                          <div class="toner-bar">
                            <div class="toner-fill"
                                 t-att-class="ev.color_id and ev.color_id.code or ''"
                                 t-attf-style="width:#{lvl}%;">
                            </div>
                          </div>
                          <div style="font-size:12px;color:var(--text-light);margin-top:4px;">
                            <i class="fa fa-tint"></i>
                            <t t-esc="(ev.color_id and ev.color_id.name) or 'Sin color'"/> —
                            <t t-esc="ev.estado_id and ev.estado_id.name or 'Sin estado'"/>
                          </div>
                        </td>
                        <td class="td-compact"><t t-esc="ev.observaciones or '—'"/></td>
                      </tr>
                    </t>
                  </t>

                  <!-- 2) Resto de componentes -->
                  <t t-foreach="reparaciones.evaluacion_ids" t-as="ev">
                    <t t-set="tcode" t-value="(ev.componente_tipo_id.code or '').upper()"/>
                    <t t-if="tcode != 'TONER_SYSTEM'">
                      <tr>
                        <td class="td-compact"><i class="fa fa-cog"></i> <t t-esc="ev.componente_tipo_id.name"/></td>
                        <td class="td-compact"><t t-esc="ev.color_id and ev.color_id.name or '—'"/></td>
                        <td class="td-compact">
                          <t t-if="ev.estado_id">
                            <t t-set="ecode" t-value="ev.estado_id.code or ''"/>
                            <t t-if="ecode in ['correcto','revisado','nuevo']">
                              <span class="status-badge status-ok"><i class="fa fa-check"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                            <t t-elif="ecode in ['requiere_cambio','cambio_de_repuestos','falla']">
                              <span class="status-badge status-error"><i class="fa fa-exclamation-triangle"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                            <t t-elif="ecode in ['regular','mantenimiento','gastada_pero_puede_trabajar','sin_probar','sin_revisar']">
                              <span class="status-badge status-warning"><i class="fa fa-info-circle"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                            <t t-else="">
                              <span class="status-badge status-sin-revisar"><i class="fa fa-minus-circle"></i> <t t-esc="ev.estado_id.name"/></span>
                            </t>
                          </t>
                          <t t-else="">—</t>
                        </td>
                        <td class="td-compact">
                          <!-- Subpartes solo si requiere cambio/falla -->
                          <t t-set="ecode" t-value="ev.estado_id and ev.estado_id.code or ''"/>
                          <t t-if="ecode in ['requiere_cambio','cambio_de_repuestos','falla']">
                            <t t-set="subs" t-value="reparaciones.get_subpartes_componente(ev)"/>
                            <t t-if="subs">
                              <t t-foreach="subs" t-as="spn">
                                <span class="chip"><i class="fa fa-tools"></i> <t t-esc="spn"/></span>
                              </t>
                            </t>
                            <t t-else="">—</t>
                          </t>
                          <t t-else="">—</t>
                        </td>
                        <td class="td-compact"><t t-esc="ev.observaciones or '—'"/></td>
                      </tr>
                    </t>
                  </t>
                </tbody>
              </table>
            </div>

            <!-- ===== Firmas ===== -->
            <div class="signatures">
              <div class="signature-box">
                <div class="signature-icon"><i class="fa fa-user-tie"></i></div>
                <p>Firma del Técnico</p>
                <p><t t-esc="reparaciones.nombre_responsable"/></p>
              </div>
              <div class="signature-box">
                <div class="signature-icon"><i class="fa fa-user"></i></div>
                <p>Firma del Cliente</p>
                <p><t t-esc="reparaciones.cliente_id.name"/></p>
              </div>
            </div>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>

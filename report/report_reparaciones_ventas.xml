<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_reparaciones_ventas">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="reparaciones">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            :root{
                                --primary-color:#3498db; --primary-dark:#2980b9; --secondary-color:#2c3e50;
                                --light-bg:#f8f9fa; --border-color:#e9ecef; --text-color:#333;
                                --success:#2ecc71; --warning:#f39c12; --danger:#e74c3c; --white:#fff;
                            }
                            body{font-family:'Roboto',sans-serif;color:var(--text-color);line-height:1.6}
                            .repair-header{background:linear-gradient(135deg,var(--secondary-color) 0%,var(--primary-color) 100%);
                                color:#fff;padding:25px;border-radius:12px;margin-bottom:30px;display:flex;justify-content:space-between;flex-wrap:wrap}
                            .header-left{flex:1}.header-title{font-size:28px;font-weight:bold;margin-bottom:10px}
                            .header-right{background:rgba(255,255,255,.15);padding:15px;border-radius:8px;min-width:200px}
                            .section-title{background:var(--secondary-color);color:#fff;padding:12px 20px;margin:25px 0 15px;border-radius:8px;
                                font-size:18px;font-weight:bold;display:flex;align-items:center}
                            .section-title i{margin-right:10px}
                            .info-card{background:#fff;border-radius:10px;border:1px solid var(--border-color);margin-bottom:20px;overflow:hidden}
                            .info-table{width:100%;border-collapse:separate;border-spacing:0}
                            .info-table th{background:var(--light-bg);color:var(--secondary-color);padding:12px 15px;font-weight:bold;border:1px solid var(--border-color)}
                            .info-table td{padding:12px 15px;border:1px solid var(--border-color)}
                            .badge{display:inline-block;padding:6px 10px;border-radius:14px;font-size:12px;font-weight:700;color:#fff}
                            .b-crit{background:#e74c3c}.b-med{background:#f39c12}.b-ok{background:#2ecc71}.b-na{background:#6c757d}
                            .dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;vertical-align:middle}
                            .k{background:#333}.c{background:#00bcd4}.m{background:#e91e63}.y{background:#ffeb3b}
                            .subpartes-inline{font-size:12px;color:#555}
                            .subpartes-inline .chip{display:inline-block;margin:2px 6px 0 0;padding:2px 6px;border-radius:10px;background:#eef2f7;border:1px solid #dfe6ee}
                            /* Barra de nivel de tóner */
                            .toner-bar{position:relative;height:10px;border-radius:6px;background:#e9ecef;overflow:hidden}
                            .toner-bar > span{position:absolute;left:0;top:0;height:100%}
                            .toner-k{background:#777}.toner-c{background:#0bbee6}.toner-m{background:#ff00d0}.toner-y{background:#ffd000}
                            .toner-meta{display:flex;align-items:center;gap:8px}
                            .toner-ico{font-size:13px}
                            /* Cabeceras internas */
                            .subheader{background:var(--secondary-color);color:#fff;padding:8px 15px;font-weight:bold}
                        </style>

                        <!-- ENCABEZADO -->
                        <div class="repair-header">
                            <div class="header-left">
                                <div class="header-title"><i class="fa fa-tools"></i> Orden de Reparación: <t t-esc="reparaciones.name"/></div>
                                <div class="header-subtitle">
                                    <t t-set="estado" t-value="selection_labels.get(reparaciones.id, {}).get('estado_id', 'Sin asignar')"/>
                                    <t t-if="estado == 'Finalizado'"><div style="display:inline-block;background:#28a745;color:#fff;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;"><i class="fa fa-check-circle"></i> <t t-esc="estado"/></div></t>
                                    <t t-elif="estado == 'En revisión'"><div style="display:inline-block;background:#ffc107;color:#333;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;"><i class="fa fa-sync"></i> <t t-esc="estado"/></div></t>
                                    <t t-elif="estado == 'Con problemas'"><div style="display:inline-block;background:#dc3545;color:#fff;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;"><i class="fa fa-exclamation-triangle"></i> <t t-esc="estado"/></div></t>
                                    <t t-elif="estado == 'De partes'"><div style="display:inline-block;background:#fd7e14;color:#fff;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;"><i class="fa fa-tools"></i> <t t-esc="estado"/></div></t>
                                    <t t-elif="estado == 'Sin revisar'"><div style="display:inline-block;background:#6c757d;color:#fff;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;"><i class="fa fa-clock"></i> <t t-esc="estado"/></div></t>
                                    <t t-elif="estado == 'Para revision'"><div style="display:inline-block;background:#17a2b8;color:#fff;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;"><i class="fa fa-search"></i> <t t-esc="estado"/></div></t>
                                    <t t-elif="estado == 'Entregada'"><div style="display:inline-block;background:#20c997;color:#fff;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;"><i class="fa fa-handshake"></i> <t t-esc="estado"/></div></t>
                                    <t t-else=""><div style="display:inline-block;background:#6c757d;color:#fff;padding:5px 15px;border-radius:20px;font-weight:bold;margin-top:10px;"><i class="fa fa-question-circle"></i> <t t-esc="estado"/></div></t>
                                </div>
                            </div>
                            <div class="header-right">
                                <div style="font-weight:bold;text-transform:uppercase;text-align:center">Cliente: <t t-esc="reparaciones.cliente_id.name"/></div>
                                <div style="margin-top:10px;text-align:center;font-size:12px;">
                                    <t t-if="reparaciones.responsable_id">Responsable: <t t-esc="reparaciones.nombre_responsable"/></t>
                                </div>
                            </div>
                        </div>

                        <div class="section-title"><i class="fa fa-info-circle"/> INFORMACIÓN DEL EQUIPO</div>

                        <!-- INFO BÁSICA -->
                        <div class="info-card">
                            <div class="subheader"><i class="fa fa-desktop"/> IDENTIFICACIÓN DEL EQUIPO</div>
                            <table class="info-table">
                                <tr>
                                    <th style="width:16%"><i class="fa fa-print"/>Tipo de equipo</th>
                                    <td style="width:17%"><t t-esc="reparaciones.tipo_machine"/></td>
                                    <th style="width:16%"><i class="fa fa-tag"/>Marca</th>
                                    <td style="width:17%"><t t-esc="reparaciones.marca"/></td>
                                    <th style="width:16%"><i class="fa fa-desktop"/>Modelo</th>
                                    <td style="width:18%"><t t-esc="reparaciones.maquina_id.name.name"/></td>
                                </tr>
                                <tr>
                                    <th><i class="fa fa-barcode"/>Número de serie</th>
                                    <td colspan="5"><t t-esc="reparaciones.serie_id"/></td>
                                </tr>
                            </table>
                        </div>

                        <!-- ESTADO TÉCNICO -->
                        <div class="info-card">
                            <div class="subheader"><i class="fa fa-cog"/> ESTADO TÉCNICO</div>
                            <table class="info-table">
                                <tr>
                                    <th style="width:20%"><i class="fa fa-tachometer-alt"/>Contómetro</th>
                                    <td style="width:30%"><t t-esc="reparaciones.contometrok_id"/></td>
                                    <th style="width:20%"><i class="fa fa-check-circle"/>Calidad</th>
                                    <td style="width:30%">
                                        <t t-if="selection_labels.get(reparaciones.id, {}).get('calidad_id', 'NA') == 'Calidad de Impresión Óptima - Cumple Estándares'"><div class="badge b-ok"><i class="fa fa-check"></i> Óptima</div></t>
                                        <t t-elif="selection_labels.get(reparaciones.id, {}).get('calidad_id', 'NA') == 'Calidad de Impresión Aceptable - Requiere Ajustes'"><div class="badge b-med"><i class="fa fa-exclamation-triangle"></i> Aceptable</div></t>
                                        <t t-elif="selection_labels.get(reparaciones.id, {}).get('calidad_id', 'NA') == 'Calidad de Impresión Deficiente - Requiere Atención Inmediata'"><div class="badge b-crit"><i class="fa fa-times"></i> Deficiente</div></t>
                                        <t t-else=""><t t-esc="selection_labels.get(reparaciones.id, {}).get('calidad_id', 'NA')"/></t>
                                    </td>
                                </tr>
                                <tr>
                                    <th><i class="fa fa-layer-group"/>Tapas</th>
                                    <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('tapas_id', 'NA')"/></td>
                                    <th><i class="fa fa-tablet"/>Panel</th>
                                    <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('panel_id', 'NA')"/></td>
                                </tr>
                            </table>
                        </div>

                        <!-- INFORME TÉCNICO -->
                        <div class="section-title"><i class="fa fa-clipboard-list"/> INFORME TÉCNICO</div>
                        <div class="info-card"><div class="informe-tecnico"><p><t t-esc="reparaciones.informe"/></p></div></div>

                        <!-- ACCESORIOS (nuevo) -->
                        <div class="section-title"><i class="fa fa-puzzle-piece"/> ACCESORIOS</div>
                        <div class="info-card">
                            <table class="info-table">
                                <thead>
                                    <tr>
                                        <th style="width:28%"><i class="fa fa-tag"/> Tipo</th>
                                        <th style="width:18%"><i class="fa fa-info-circle"/> Estado</th>
                                        <th style="width:36%"><i class="fa fa-tools"/> Subpartes</th>
                                        <th style="width:18%"><i class="fa fa-sticky-note"/> Observaciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="accs" t-value="reparaciones.accesorio_eval_ids"/>
                                    <t t-foreach="accs" t-as="acc">
                                        <tr>
                                            <td><t t-esc="acc.tipo_id and acc.tipo_id.name or '—'"/></td>
                                            <td>
                                                <t t-if="acc.estado_id">
                                                    <t t-set="ecode" t-value="acc.estado_id.code or ''"/>
                                                    <span t-attf-class="badge #{'b-crit' if ecode in ['instalado_con_falla','requiere_cambio','cambio_de_repuestos','falla'] else ('b-med' if ecode in ['no_instalado','regular','mantenimiento'] else ('b-ok' if ecode in ['instalado_operativo','nuevo','revisado','correcto'] else 'b-na'))}">
                                                        <t t-esc="acc.estado_id.name"/>
                                                    </span>
                                                </t>
                                                <t t-else="">—</t>
                                            </td>
                                            <td>
                                                <t t-if="acc.subparte_ids">
                                                    <span class="subpartes-inline">
                                                        <t t-foreach="acc.subparte_ids" t-as="sp">
                                                            <span class="chip"><i class="fa fa-chevron-right"></i> <t t-esc="sp.name"/></span>
                                                        </t>
                                                    </span>
                                                </t>
                                                <t t-else="">—</t>
                                            </td>
                                            <td><t t-esc="acc.observaciones or ''"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="not accs"><tr><td colspan="4" style="text-align:center;color:#6c757d">Sin accesorios evaluados</td></tr></t>
                                </tbody>
                            </table>
                        </div>

                        <!-- CHECK LIST (nuevo) -->
                        <div class="section-title"><i class="fa fa-tasks"/> CHECK LIST</div>

                        <!-- FUNCIONES -->
                        <div class="info-card">
                            <div class="subheader"><i class="fa fa-cogs"/> FUNCIONES</div>
                            <table class="info-table">
                                <thead>
                                    <tr>
                                        <th style="width:35%"><i class="fa fa-tag"/> Función</th>
                                        <th style="width:20%"><i class="fa fa-info-circle"/> Estado</th>
                                        <th style="width:45%"><i class="fa fa-sticky-note"/> Observaciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="ev_funcs" t-value="reparaciones.evaluacion_ids.filtered(lambda e: (e.componente_tipo_id.code or '').startswith('FUNCION_'))"/>
                                    <t t-foreach="ev_funcs" t-as="evf">
                                        <tr>
                                            <td><t t-esc="evf.componente_tipo_id and evf.componente_tipo_id.name or '—'"/></td>
                                            <td>
                                                <t t-if="evf.estado_id">
                                                    <t t-set="ecode" t-value="evf.estado_id.code or ''"/>
                                                    <span t-attf-class="badge #{'b-crit' if ecode in ['falla','requiere_cambio','cambio_de_repuestos'] else ('b-med' if ecode in ['regular','mantenimiento','sin_revisar','sin_probar'] else ('b-ok' if ecode in ['nuevo','revisado','correcto'] else 'b-na'))}">
                                                        <t t-esc="evf.estado_id.name"/>
                                                    </span>
                                                </t>
                                                <t t-else="">—</t>
                                            </td>
                                            <td><t t-esc="evf.observaciones or ''"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="not ev_funcs"><tr><td colspan="3" style="text-align:center;color:#6c757d">Sin funciones evaluadas</td></tr></t>
                                </tbody>
                            </table>
                        </div>

                        <!-- COMPONENTES -->
                        <div class="info-card">
                            <div class="subheader"><i class="fa fa-cog"/> COMPONENTES</div>
                            <table class="info-table">
                                <thead>
                                    <tr>
                                        <th style="width:26%"><i class="fa fa-tag"/> Componente</th>
                                        <th style="width:12%"><i class="fa fa-palette"/> Color</th>
                                        <th style="width:22%"><i class="fa fa-info-circle"/> Estado</th>
                                        <th style="width:40%"><i class="fa fa-tools"/> Subpartes / Indicadores</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="ev_comps" t-value="reparaciones.evaluacion_ids.filtered(lambda e: not (e.componente_tipo_id.code or '').startswith('FUNCION_'))"/>
                                    <t t-foreach="ev_comps" t-as="evc">
                                        <tr>
                                            <!-- Nombre + observación breve -->
                                            <td>
                                                <t t-esc="evc.componente_tipo_id and evc.componente_tipo_id.name or '—'"/>
                                                <t t-if="evc.observaciones">
                                                    <div style="font-size:11px;color:#666;margin-top:4px;"><i class="fa fa-sticky-note"></i> <t t-esc="evc.observaciones"/></div>
                                                </t>
                                            </td>
                                            <!-- Color con punto -->
                                            <td>
                                                <t t-if="evc.color_id">
                                                    <t t-set="cc" t-value="(evc.color_id.code or '').lower()"/>
                                                    <span class="dot" t-attf-class="dot #{cc}"></span>
                                                    <t t-esc="evc.color_id.name"/>
                                                </t>
                                                <t t-else="">—</t>
                                            </td>
                                            <!-- Estado (badge) -->
                                            <td>
                                                <t t-if="evc.estado_id">
                                                    <t t-set="ecode" t-value="evc.estado_id.code or ''"/>
                                                    <span t-attf-class="badge #{'b-crit' if ecode in ['requiere_cambio','cambio_de_repuestos','falla','vacio','sin_botella'] else ('b-med' if ecode in ['regular','gastada_pero_puede_trabajar','mantenimiento','bajo','sin_revisar','sin_probar'] else ('b-ok' if ecode in ['nuevo','revisado','correcto'] else 'b-na'))}">
                                                        <t t-esc="evc.estado_id.name"/>
                                                    </span>
                                                </t>
                                                <t t-else="">—</t>
                                            </td>
                                            <!-- Subpartes en misma fila / Indicadores especiales de TONER -->
                                            <td>
                                                <!-- Si es TONER, mostrar icono + barra -->
                                                <t t-if="(evc.componente_tipo_id.code or '') == 'TONER_SYSTEM'">
                                                    <t t-set="cc" t-value="(evc.color_id and (evc.color_id.code or '').lower()) or ''"/>
                                                    <t t-set="ecode" t-value="evc.estado_id and (evc.estado_id.code or '') or ''"/>
                                                    <!-- Mapeo simple de “porcentaje” -->
                                                    <t t-set="pct"
                                                       t-value="0 if ecode in ['vacio','sin_botella','requiere_cambio','falla'] else (25 if ecode in ['bajo','regular','sin_revisar','sin_probar'] else 100)"/>
                                                    <div class="toner-meta">
                                                        <span class="toner-ico">
                                                            <i class="fa fa-tint" t-att-style="'color:#333' if cc=='k' else ('color:#0bbee6' if cc=='c' else ('color:#ff00d0' if cc=='m' else ('color:#ffd000' if cc=='y' else 'color:#666')))"></i>
                                                        </span>
                                                        <div class="toner-bar" style="flex:1">
                                                            <span t-attf-class="#{'toner-k' if cc=='k' else ('toner-c' if cc=='c' else ('toner-m' if cc=='m' else ('toner-y' if cc=='y' else '')))}"
                                                                  t-att-style="'width:%s%%' % pct"/>
                                                        </div>
                                                        <div style="width:36px;text-align:right;font-size:11px;"><t t-esc="str(pct)+'%'"/></div>
                                                    </div>
                                                    <!-- Si además requiere cambio, listar subpartes en la misma celda -->
                                                    <t t-if="evc.estado_id and (evc.estado_id.code in ['requiere_cambio','cambio_de_repuestos','falla'])">
                                                        <t t-if="evc.subpartes_ids">
                                                            <div class="subpartes-inline" style="margin-top:6px">
                                                                <t t-foreach="evc.subpartes_ids" t-as="sp">
                                                                    <span class="chip"><i class="fa fa-chevron-right"></i> <t t-esc="sp.name"/></span>
                                                                </t>
                                                            </div>
                                                        </t>
                                                    </t>
                                                </t>
                                                <!-- Otros componentes: subpartes solo si requiere cambio -->
                                                <t t-elif="evc.estado_id and (evc.estado_id.code in ['requiere_cambio','cambio_de_repuestos','falla'])">
                                                    <t t-if="evc.subpartes_ids">
                                                        <span class="subpartes-inline">
                                                            <t t-foreach="evc.subpartes_ids" t-as="sp">
                                                                <span class="chip"><i class="fa fa-chevron-right"></i> <t t-esc="sp.name"/></span>
                                                            </t>
                                                        </span>
                                                    </t>
                                                    <t t-else="">—</t>
                                                </t>
                                                <t t-else="">—</t>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="not ev_comps"><tr><td colspan="4" style="text-align:center;color:#6c757d">Sin componentes evaluados</td></tr></t>
                                </tbody>
                            </table>
                        </div>

                        <!-- FIRMAS -->
                        <div style="display:flex;justify-content:space-between;margin-top:40px;">
                            <div style="flex:0 0 45%;border-top:2px solid var(--secondary-color);padding-top:15px;text-align:center">
                                <div style="font-size:24px;color:var(--secondary-color);margin-bottom:8px;"><i class="fa fa-user-tie"/></div>
                                <p>Firma del Técnico</p>
                                <p><t t-esc="reparaciones.nombre_responsable"/></p>
                            </div>
                            <div style="flex:0 0 45%;border-top:2px solid var(--secondary-color);padding-top:15px;text-align:center">
                                <div style="font-size:24px;color:var(--secondary-color);margin-bottom:8px;"><i class="fa fa-user"/></div>
                                <p>Firma del Cliente</p>
                                <p><t t-esc="reparaciones.cliente_id.name"/></p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

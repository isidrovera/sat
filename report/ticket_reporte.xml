<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="ticket_alquiler">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="ticket">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <style>
                                .ticket-header {
                                    background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
                                    color: white;
                                    padding: 25px;
                                    border-radius: 15px;
                                    margin-bottom: 30px;
                                    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
                                }
                                .header-title {
                                    font-size: 28px;
                                    font-weight: bold;
                                    display: flex;
                                    align-items: center;
                                    margin-bottom: 15px;
                                    color: #2c3e50;
                                }
                                .header-subtitle {
                                    font-size: 16px;
                                    opacity: 0.9;
                                    color: #2c3e50;
                                }
                                .section-title {
                                    background: #2c3e50;
                                    color: white;
                                    padding: 12px 20px;
                                    border-radius: 8px;
                                    margin: 25px 0 15px;
                                    font-size: 18px;
                                    font-weight: bold;
                                    display: flex;
                                    align-items: center;
                                }
                                .info-card {
                                    background: white;
                                    border-radius: 10px;
                                    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
                                    margin-bottom: 20px;
                                    overflow: hidden;
                                }
                                .info-table {
                                    width: 100%;
                                    border-collapse: separate;
                                    border-spacing: 0;
                                }
                                .info-table th {
                                    background: #f8f9fa;
                                    color: #2c3e50;
                                    padding: 12px 15px;
                                    font-weight: bold;
                                    border: 1px solid #e9ecef;
                                }
                                .info-table td {
                                    padding: 12px 15px;
                                    border: 1px solid #e9ecef;
                                }
                                .contometer-value {
                                    font-size: 20px;
                                    font-weight: bold;
                                    color: #2c3e50;
                                }
                                .informe-tecnico {
                                    padding: 20px;
                                    background: #f8f9fa;
                                    border-radius: 8px;
                                    border-left: 4px solid #3498db;
                                    margin: 15px;
                                }
                                .avoid-page-break { page-break-inside: avoid; }

                                /* Tabla evaluaciones */
                                .eval-table {
                                    width: 100%;
                                    border-collapse: collapse;
                                    font-size: 9pt;
                                }
                                .eval-table thead tr {
                                    background: #2c3e50;
                                    color: white;
                                }
                                .eval-table thead th {
                                    padding: 8px 12px;
                                    text-align: left;
                                    border: 1px solid #1a252f;
                                }
                                .eval-table tbody tr:nth-child(even) { background: #f4f6f9; }
                                .eval-table tbody tr:nth-child(odd)  { background: #ffffff; }
                                .eval-table tbody td {
                                    padding: 8px 12px;
                                    border: 0.5px solid #e5e7eb;
                                    vertical-align: top;
                                }

                                /* Badges estado */
                                .badge-estado {
                                    display: inline-block;
                                    padding: 3px 8px;
                                    border-radius: 10px;
                                    font-size: 8pt;
                                    font-weight: bold;
                                }
                                .badge-requiere { background: #fee2e2; color: #991b1b; }
                                .badge-nuevo    { background: #d1fae5; color: #065f46; }
                                .badge-regular  { background: #fef3c7; color: #92400e; }
                                .badge-gastada  { background: #ede9fe; color: #5b21b6; }
                                .badge-revisado { background: #dbeafe; color: #1e3a8a; }
                                .badge-correcto { background: #d1fae5; color: #065f46; }
                                .badge-falla    { background: #fee2e2; color: #991b1b; }
                                .badge-default  { background: #f3f4f6; color: #374151; }

                                /* Subpartes inline */
                                .subpartes-inline {
                                    margin-top: 6px;
                                    padding: 6px 10px;
                                    background: #fffbeb;
                                    border: 1px solid #fbbf24;
                                    border-left: 3px solid #f59e0b;
                                    border-radius: 4px;
                                    font-size: 8pt;
                                }
                                .subpartes-inline .sp-title {
                                    font-weight: bold;
                                    color: #92400e;
                                    margin-bottom: 3px;
                                    font-size: 7.5pt;
                                    text-transform: uppercase;
                                    letter-spacing: 0.03em;
                                }
                                .subpartes-inline ul {
                                    margin: 0;
                                    padding-left: 14px;
                                }
                                .subpartes-inline ul li {
                                    padding: 1px 0;
                                    color: #374151;
                                }
                            </style>

                            <!-- ENCABEZADO -->
                            <div class="ticket-header">
                                <div class="header-title">
                                    <i class="fa fa-ticket-alt"/>
                                    Ticket de Servicio: <span t-field="ticket.name"/>
                                </div>
                                <div class="header-subtitle">
                                    <i class="fa fa-calendar"/> Fecha de visita: <span t-field="ticket.agenda_local"/>
                                </div>
                            </div>

                            <!-- INFORMACIÓN DEL EQUIPO -->
                            <div class="info-card avoid-page-break">
                                <table class="info-table">
                                    <tr>
                                        <th><i class="fa fa-building"/> Marca</th>
                                        <td><span t-field="ticket.marca_id_r"/></td>
                                        <th><i class="fa fa-print"/> Máquina</th>
                                        <td><span t-field="ticket.product_alquiler.name.name"/></td>
                                        <th><i class="fa fa-barcode"/> Serie</th>
                                        <td><span t-field="ticket.product_alquiler.serie"/></td>
                                    </tr>
                                    <tr>
                                        <th><i class="fa fa-user"/> Cliente</th>
                                        <td><span t-field="ticket.partner_id.name"/></td>
                                        <th><i class="fa fa-user-tie"/> Técnico</th>
                                        <td><span t-field="ticket.responsable.name"/></td>
                                        <th><i class="fa fa-wrench"/> Tipo Servicio</th>
                                        <td><t t-esc="selection_labels.get(ticket.id, {}).get('tipo_servicio_id', 'NA')"/></td>
                                    </tr>
                                </table>
                            </div>

                            <!-- CONTADORES -->
                            <div class="section-title">
                                <i class="fa fa-tachometer-alt"/>
                                CONTADORES
                            </div>
                            <div class="info-card avoid-page-break">
                                <table class="info-table">
                                    <tr>
                                        <th><i class="fa fa-print"/> Black (K)</th>
                                        <td><span class="contometer-value" t-field="ticket.contometrok_id"/></td>
                                        <th><i class="fa fa-paint-brush"/> Color</th>
                                        <td><span class="contometer-value" t-field="ticket.contometroc_id"/></td>
                                        <th><i class="fa fa-scanner"/> Scanner</th>
                                        <td><span class="contometer-value" t-field="ticket.contometros_id"/></td>
                                    </tr>
                                    <tr>
                                        <th><i class="fa fa-check-circle"/> Calidad</th>
                                        <td colspan="5">
                                            <t t-esc="selection_labels.get(ticket.id, {}).get('calidad_id', 'NA')"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- PROBLEMA REPORTADO -->
                            <div class="section-title">
                                <i class="fa fa-exclamation-circle"/>
                                PROBLEMA REPORTADO
                            </div>
                            <div class="info-card">
                                <div class="informe-tecnico">
                                    <p t-field="ticket.description"/>
                                </div>
                            </div>

                            <!-- INFORME TÉCNICO -->
                            <div class="section-title">
                                <i class="fa fa-clipboard-list"/>
                                INFORME TÉCNICO
                            </div>
                            <div class="info-card">
                                <div class="informe-tecnico">
                                    <p t-field="ticket.informe_id"/>
                                </div>
                            </div>

                            <!-- EVALUACIÓN DE COMPONENTES -->
                            <div class="section-title avoid-page-break">
                                <i class="fa fa-wrench"/>
                                EVALUACIÓN DE COMPONENTES
                            </div>
                            <div class="info-card avoid-page-break">
                                <t t-if="ticket.ticket_componente_eval_ids">
                                    <table class="eval-table">
                                        <thead>
                                            <tr>
                                                <th style="width:30%;">Componente</th>
                                                <th style="width:12%;">Color</th>
                                                <th style="width:20%;">Estado</th>
                                                <th style="width:38%;">Observaciones / Subpartes requeridas</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="ticket.ticket_componente_eval_ids" t-as="eval_comp">
                                                <tr>
                                                    <td><strong><t t-esc="eval_comp.componente_tipo_id.name"/></strong></td>
                                                    <td>
                                                        <t t-if="eval_comp.color_id">
                                                            <t t-esc="eval_comp.color_id.name"/>
                                                        </t>
                                                        <t t-else="">—</t>
                                                    </td>
                                                    <td>
                                                        <t t-if="eval_comp.estado_id">
                                                            <t t-set="ec" t-value="eval_comp.estado_id.code or ''"/>
                                                            <span t-attf-class="badge-estado #{
                                                                'badge-requiere' if ec == 'requiere_cambio' else
                                                                'badge-nuevo'    if ec == 'nuevo' else
                                                                'badge-regular'  if ec == 'regular' else
                                                                'badge-gastada'  if ec == 'gastada_pero_puede_trabajar' else
                                                                'badge-revisado' if ec == 'revisado' else
                                                                'badge-correcto' if ec == 'correcto' else
                                                                'badge-falla'    if ec == 'falla' else
                                                                'badge-default'
                                                            }">
                                                                <t t-esc="eval_comp.estado_id.name"/>
                                                            </span>
                                                        </t>
                                                        <t t-else="">
                                                            <span style="color:#9ca3af;">Sin evaluar</span>
                                                        </t>
                                                    </td>
                                                    <td>
                                                        <!-- Observaciones normales -->
                                                        <t t-if="eval_comp.observaciones">
                                                            <span><t t-esc="eval_comp.observaciones"/></span>
                                                        </t>

                                                        <!-- Subpartes inline si requiere_cambio -->
                                                        <t t-if="eval_comp.estado_id and eval_comp.estado_id.code == 'requiere_cambio'">
                                                            <t t-set="sps" t-value="subpartes_por_eval.get(eval_comp.id, [])"/>
                                                            <t t-if="sps">
                                                                <div class="subpartes-inline">
                                                                    <div class="sp-title">🔩 Subpartes a cambiar</div>
                                                                    <ul>
                                                                        <t t-foreach="sps" t-as="sp">
                                                                            <li>
                                                                                <strong><t t-esc="sp['nombre']"/></strong>
                                                                                — Cant: <t t-esc="'%.0f' % sp['cantidad']"/>
                                                                                <t t-if="sp['observacion']">
                                                                                    — <t t-esc="sp['observacion']"/>
                                                                                </t>
                                                                            </li>
                                                                        </t>
                                                                    </ul>
                                                                </div>
                                                            </t>
                                                            <t t-else="">
                                                                <div class="subpartes-inline">
                                                                    <span style="color:#9ca3af; font-style:italic;">
                                                                        Subpartes pendientes de especificar
                                                                    </span>
                                                                </div>
                                                            </t>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p style="padding:15px; color:#9ca3af; font-style:italic;">
                                        No hay evaluaciones de componentes registradas.
                                    </p>
                                </t>
                            </div>

                            <!-- EVALUACIÓN DE ACCESORIOS -->
                            <div class="section-title avoid-page-break">
                                <i class="fa fa-puzzle-piece"/>
                                EVALUACIÓN DE ACCESORIOS
                            </div>
                            <div class="info-card avoid-page-break">
                                <t t-if="ticket.ticket_accesorio_eval_ids">
                                    <table class="eval-table">
                                        <thead>
                                            <tr>
                                                <th style="width:40%;">Accesorio</th>
                                                <th style="width:22%;">Estado</th>
                                                <th style="width:38%;">Observaciones / Subpartes requeridas</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="ticket.ticket_accesorio_eval_ids" t-as="eval_acc">
                                                <tr>
                                                    <td><strong><t t-esc="eval_acc.tipo_id.name"/></strong></td>
                                                    <td>
                                                        <t t-if="eval_acc.estado_id">
                                                            <t t-set="ea" t-value="eval_acc.estado_id.code or ''"/>
                                                            <span t-attf-class="badge-estado #{
                                                                'badge-requiere' if ea == 'requiere_cambio' else
                                                                'badge-revisado' if ea in ('instalado_operativo', 'revisado') else
                                                                'badge-falla'    if ea == 'no_instalado' else
                                                                'badge-default'
                                                            }">
                                                                <t t-esc="eval_acc.estado_id.name"/>
                                                            </span>
                                                        </t>
                                                        <t t-else="">
                                                            <span style="color:#9ca3af;">Sin evaluar</span>
                                                        </t>
                                                    </td>
                                                    <td>
                                                        <t t-if="eval_acc.observaciones">
                                                            <span><t t-esc="eval_acc.observaciones"/></span>
                                                        </t>

                                                        <!-- Subpartes inline si requiere_cambio -->
                                                        <t t-if="eval_acc.estado_id and eval_acc.estado_id.code == 'requiere_cambio'">
                                                            <t t-set="sps_acc" t-value="subpartes_por_eval.get(eval_acc.id, [])"/>
                                                            <t t-if="sps_acc">
                                                                <div class="subpartes-inline">
                                                                    <div class="sp-title">🔩 Subpartes a cambiar</div>
                                                                    <ul>
                                                                        <t t-foreach="sps_acc" t-as="sp_acc">
                                                                            <li>
                                                                                <strong><t t-esc="sp_acc['nombre']"/></strong>
                                                                                — Cant: <t t-esc="'%.0f' % sp_acc['cantidad']"/>
                                                                                <t t-if="sp_acc['observacion']">
                                                                                    — <t t-esc="sp_acc['observacion']"/>
                                                                                </t>
                                                                            </li>
                                                                        </t>
                                                                    </ul>
                                                                </div>
                                                            </t>
                                                            <t t-else="">
                                                                <div class="subpartes-inline">
                                                                    <span style="color:#9ca3af; font-style:italic;">
                                                                        Subpartes pendientes de especificar
                                                                    </span>
                                                                </div>
                                                            </t>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p style="padding:15px; color:#9ca3af; font-style:italic;">
                                        No hay evaluaciones de accesorios registradas.
                                    </p>
                                </t>
                            </div>

                            <!-- TÉCNICO Y FIRMAS -->
                            <div class="row mt-5">
                                <div class="col-6">
                                    <div class="info-card">
                                        <div class="p-3">
                                            <h4 class="mb-3">
                                                <i class="fa fa-user-tie"/> Información del Técnico
                                            </h4>
                                            <div class="row">
                                                <div class="col-6">
                                                    <strong>Nombre:</strong>
                                                    <span t-esc="ticket.responsable.name"/>
                                                </div>
                                                <div class="col-6">
                                                    <strong>DNI:</strong>
                                                    <span t-esc="ticket.responsable.vat"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-5">
                                <div class="col-6">
                                    <div style="border-top: 2px solid #2c3e50; padding-top: 15px; text-align: center;">
                                        <i class="fa fa-user-tie fa-2x mb-2" style="color: #2c3e50;"/><br/>
                                        Firma del Técnico
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div style="border-top: 2px solid #2c3e50; padding-top: 15px; text-align: center;">
                                        <i class="fa fa-user fa-2x mb-2" style="color: #2c3e50;"/><br/>
                                        Firma del Cliente
                                    </div>
                                </div>
                            </div>

                        </div>
                    </t>
                </t>
            </t>
        </template>

        <template id="report_ticket_repuesto_pedido">
        <t t-name="sat.report_ticket_repuesto_pedido">

            <t t-foreach="docs" t-as="o">

                <main>
                    <div class="page">

                        <style>
                            @page {
                                size: A4 landscape;
                                margin: 8mm;
                            }

                            body {
                                font-family: Arial, sans-serif;
                                font-size: 10px;
                                color: #1f2d3d;
                            }

                            .page { width: 100%; }

                            .header {
                                display: flex;
                                justify-content: space-between;
                                border-bottom: 3px solid #1B3A6B;
                                padding-bottom: 6px;
                                margin-bottom: 10px;
                            }

                            .title {
                                font-size: 14px;
                                font-weight: bold;
                                color: #1B3A6B;
                            }

                            .doc-number {
                                font-size: 16px;
                                font-weight: bold;
                                font-family: monospace;
                            }

                            .estado {
                                background: #f9fafb;
                                border-left: 4px solid #059669;
                                padding: 6px 10px;
                                margin-bottom: 10px;
                            }

                            .grid {
                                display: table;
                                width: 100%;
                                margin-bottom: 10px;
                            }

                            .col {
                                display: table-cell;
                                width: 25%;
                                padding: 4px;
                            }

                            .box {
                                border: 1px solid #e5e7eb;
                                padding: 6px 8px;
                                border-radius: 3px;
                            }

                            table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 10px;
                            }

                            th {
                                background: #1B3A6B;
                                color: #fff;
                                font-size: 9px;
                                padding: 5px;
                                text-transform: uppercase;
                            }

                            td {
                                border: 1px solid #e5e7eb;
                                padding: 4px;
                                font-size: 9px;
                            }

                            .num {
                                text-align: right;
                                font-family: monospace;
                            }

                            .center { text-align: center; }

                            .badge {
                                padding: 2px 6px;
                                border-radius: 8px;
                                color: white;
                                font-size: 8px;
                                font-weight: bold;
                            }

                            .black { background: #374151; }
                            .cyan { background: #0891b2; }
                            .magenta { background: #db2777; }
                            .yellow { background: #d97706; }
                            .bn { background: #6b7280; }

                            .pos { color: #059669; font-weight: bold; }
                            .neg { color: #DC2626; font-weight: bold; }
                            .muted { color: #9ca3af; font-style: italic; }

                            .footer {
                                border-top: 1px solid #e5e7eb;
                                padding-top: 6px;
                                font-size: 8px;
                                color: #9ca3af;
                                display: flex;
                                justify-content: space-between;
                            }

                            thead { display: table-header-group; }
                            tr { page-break-inside: avoid; }

                        </style>

                        <!-- HEADER -->
                        <div class="header">
                            <div>
                                <div class="title">ANDES COPIERS SAC</div>
                                <div>Sistema SAT — Pedido de Repuestos</div>
                            </div>
                            <div style="text-align:right;">
                                <div class="title">PEDIDO</div>
                                <div class="doc-number">
                                    <t t-esc="o.name"/>
                                </div>
                                <div>
                                    <t t-esc="o.fecha.strftime('%d/%m/%Y') if o.fecha else ''"/>
                                </div>
                            </div>
                        </div>

                        <!-- ESTADO -->
                        <div class="estado">
                            Estado: <b><t t-esc="o.estado"/></b><br/>
                            Aprobado por:
                            <t t-esc="o.aprobado_por.name if o.aprobado_por else '-'"/>
                        </div>

                        <!-- GRID -->
                        <div class="grid">
                            <div class="col">
                                <div class="box">
                                    K (B/N)<br/>
                                    <b><t t-esc="o.contometro_k"/></b>
                                </div>
                            </div>
                            <div class="col">
                                <div class="box">
                                    Color<br/>
                                    <b><t t-esc="o.contometro_color or '—'"/></b>
                                </div>
                            </div>
                            <div class="col">
                                <div class="box">
                                    Total líneas<br/>
                                    <b><t t-esc="o.total_lineas"/></b>
                                </div>
                            </div>
                            <div class="col">
                                <div class="box">
                                    Técnico<br/>
                                    <b><t t-esc="o.tecnico_id.name"/></b>
                                </div>
                            </div>
                        </div>

                        <!-- CLIENTE -->
                        <div class="grid">
                            <div class="col">
                                <div class="box">
                                    Cliente: <t t-esc="o.cliente_id.name"/><br/>
                                    Dirección: <t t-esc="o.cliente_id.street or ''"/>
                                </div>
                            </div>
                            <div class="col">
                                <div class="box">
                                    Modelo: <t t-esc="o.modelo_nombre"/><br/>
                                    Serie: <t t-esc="o.serie"/>
                                </div>
                            </div>
                        </div>

                        <!-- TABLA -->
                        <table>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Componente</th>
                                    <th>Subparte</th>
                                    <th>Color</th>
                                    <th>Cant</th>
                                    <th>Actual</th>
                                    <th>Anterior</th>
                                    <th>Diferencia</th>
                                    <th>Fecha</th>
                                    <th>Meses</th>
                                    <th>Obs</th>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-foreach="o.linea_ids" t-as="l">

                                    <t t-set="actual"
                                       t-value="int((l.contometro_actual_linea or '0').replace(',', ''))"/>

                                    <t t-set="anterior"
                                       t-value="int((l.ultimo_cambio_contometro or '0').replace(',', ''))"/>

                                    <t t-set="diff" t-value="actual - anterior"/>

                                    <tr>
                                        <td class="center">
                                            <t t-esc="l_index + 1"/>
                                        </td>

                                        <td><t t-esc="l.componente_display"/></td>

                                        <td>
                                            <t t-esc="l.subparte_id.name or l.nombre_libre"/>
                                        </td>

                                        <td class="center">
                                            <span class="badge"
                                                t-att-class="
                                                    'badge ' +
                                                    ('black' if l.color_id and l.color_id.name == 'Black' else
                                                     'cyan' if l.color_id and l.color_id.name == 'Cyan' else
                                                     'magenta' if l.color_id and l.color_id.name == 'Magenta' else
                                                     'yellow' if l.color_id and l.color_id.name == 'Yellow' else
                                                     'bn')">
                                                <t t-esc="l.color_id.name if l.color_id else 'B/N'"/>
                                            </span>
                                        </td>

                                        <td class="center">
                                            <t t-esc="int(l.cantidad)"/>
                                        </td>

                                        <td class="num">
                                            <t t-esc="l.contometro_actual_linea or '0'"/>
                                        </td>

                                        <td class="num">
                                            <t t-if="l.ultimo_cambio_contometro">
                                                <t t-esc="l.ultimo_cambio_contometro"/>
                                            </t>
                                            <t t-else="">
                                                <span class="muted">—</span>
                                            </t>
                                        </td>

                                        <td class="num">
                                            <t t-if="l.ultimo_cambio_contometro">
                                                <span t-att-class="'pos' if diff >= 0 else 'neg'">
                                                    <t t-esc="diff"/>
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span class="muted">Primer cambio</span>
                                            </t>
                                        </td>

                                        <td class="center">
                                            <t t-if="l.ultimo_cambio_fecha">
                                                <t t-esc="l.ultimo_cambio_fecha.strftime('%d/%m/%Y')"/>
                                            </t>
                                            <t t-else="">
                                                <span class="muted">—</span>
                                            </t>
                                        </td>

                                        <td class="center">
                                            <t t-if="l.meses_desde_ultimo_cambio">
                                                <t t-esc="l.meses_desde_ultimo_cambio"/>m
                                            </t>
                                            <t t-else="">
                                                <span class="muted">—</span>
                                            </t>
                                        </td>

                                        <td>
                                            <t t-esc="l.observacion or ''"/>
                                        </td>

                                    </tr>

                                </t>
                            </tbody>
                        </table>

                        <!-- FOOTER -->
                        <div class="footer">
                            <div>Andes Copiers SAC</div>
                            <div>Pedido: <t t-esc="o.name"/></div>
                        </div>

                    </div>
                </main>

            </t>

        </t>
    </template>

    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formato de papel vertical optimizado -->
    <record id="paperformat_qr_vertical_single" model="report.paperformat">
        <field name="name">QR Vertical Una Página</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <!-- Reporte configurado para una sola página vertical -->
    <record id="action_report_qr_codes_reparaciones_template" model="ir.actions.report">
        <field name="name">Reparaciones QR</field>
        <field name="model">reparaciones.reparaciones</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sat.report_qr_codes_reparaciones_template</field>
        <field name="report_file">sat.report_qr_codes_reparaciones_template</field>
        <field name="print_report_name">'Reparación - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_qr_vertical_single"/>
        <field name="binding_model_id" ref="sat.model_reparaciones_reparaciones"/>
        <field name="binding_type">report</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción del Reporte -->
    <record id="equipment_visit_report_action" model="ir.actions.report">
        <field name="name">Informe de Visitas Técnicas</field>
        <field name="model">equipment.visit.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sat.report_equipment_visit</field>
        <field name="report_file">sat.report_equipment_visit</field>
        <field name="print_report_name">'Informe de Visitas - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_equipment_visit_report"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Assets para CSS -->
    <record id="equipment_visit_report_asset" model="ir.asset">
        <field name="name">Equipment Visit Report Assets</field>
        <field name="bundle">web.assets_backend</field>
        <field name="directive">append</field>
        <field name="target">web.report_assets_common</field>
        <field name="path">sat/static/src/css/equipment_visit_report.css</field>
    </record>
    <!-- Assets para JavaScript en Odoo 18 -->
    <record id="equipment_visit_report_js_asset" model="ir.asset">
        <field name="name">Equipment Visit Report JS</field>
        <field name="bundle">web.report_assets_common</field>
        <field name="directive">append</field>
        <field name="path">sat/static/src/js/equipment_visit_report.js</field>
    </record>

    <!-- Plantilla Principal del Reporte -->
    <template id="report_equipment_visit" name="sat.report_equipment_visit">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <style>
                        /* Archivo: /static/src/css/equipment_visit_report.css */
                        /* Paleta de colores inspirada en Tailwind CSS */
                        :root {
                            /* Colores primarios */
                            --blue-50: #eff6ff;
                            --blue-100: #dbeafe;
                            --blue-500: #3b82f6;
                            --blue-600: #2563eb;
                            --blue-700: #1d4ed8;
                            --blue-800: #1e40af;
                            --blue-900: #1e3a8a;
                            
                            /* Colores secundarios */
                            --red-500: #ef4444;
                            --red-100: #fee2e2;
                            --green-500: #10b981;
                            --green-100: #d1fae5;
                            --amber-500: #f59e0b;
                            --amber-100: #fef3c7;
                            
                            /* Grises */
                            --gray-50: #f9fafb;
                            --gray-100: #f3f4f6;
                            --gray-200: #e5e7eb;
                            --gray-300: #d1d5db;
                            --gray-400: #9ca3af;
                            --gray-500: #6b7280;
                            --gray-600: #4b5563;
                            --gray-700: #374151;
                            --gray-800: #1f2937;
                            --gray-900: #111827;
                            
                            /* Sombras */
                            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
                            --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
                            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
                            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
                            
                            /* Bordes y radios */
                            --border-radius-sm: 0.125rem;
                            --border-radius: 0.25rem;
                            --border-radius-md: 0.375rem;
                            --border-radius-lg: 0.5rem;
                            --border-radius-xl: 0.75rem;
                            --border-radius-2xl: 1rem;
                            --border-radius-3xl: 1.5rem;
                            --border-radius-full: 9999px;
                        }

                        /* Estilos generales modernos */
                        body {
                            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                            color: var(--gray-700);
                            background-color: var(--gray-50);
                            line-height: 1.5;
                        }

                        .page {
                            padding: 0;
                            margin: 0;
                            background-color: white;
                        }

                        /* Cabecera del Dashboard */
                        .ev-dashboard-header {
                            background-color: var(--gray-800);
                            color: white;
                            padding: 1.5rem;
                            border-radius: var(--border-radius-lg);
                            margin-bottom: 1.5rem;
                        }

                        .header-content {
                            display: flex;
                            justify-content: space-between;
                            align-items: center;
                        }

                        .ev-dashboard-title {
                            font-size: 1.5rem;
                            font-weight: 700;
                            letter-spacing: 0.025em;
                            margin: 0;
                        }

                        .ev-period {
                            font-size: 1.125rem;
                            font-weight: 500;
                            background-color: var(--blue-700);
                            padding: 0.5rem 1rem;
                            border-radius: var(--border-radius-full);
                        }

                        /* Resumen Ejecutivo */
                        .ev-executive-summary {
                            margin-bottom: 1.5rem;
                        }

                        .ev-section-header {
                            margin-bottom: 1rem;
                        }

                        .ev-section-title {
                            font-size: 1.25rem;
                            font-weight: 600;
                            color: var(--gray-800);
                            margin: 0;
                            padding-bottom: 0.5rem;
                            border-bottom: 2px solid var(--gray-200);
                        }

                        .ev-summary-stats {
                            display: flex;
                            flex-wrap: wrap;
                            gap: 1rem;
                            margin-top: 1rem;
                        }

                        .ev-stat-card {
                            flex: 1;
                            min-width: 170px;
                            background-color: white;
                            border-radius: var(--border-radius-lg);
                            padding: 1rem;
                            box-shadow: var(--shadow);
                            position: relative;
                            overflow: hidden;
                        }

                        .ev-stat-card::before {
                            content: '';
                            position: absolute;
                            top: 0;
                            left: 0;
                            right: 0;
                            height: 4px;
                        }

                        .ev-stat-visits::before {
                            background-color: var(--blue-500);
                        }

                        .ev-stat-recurring::before {
                            background-color: var(--amber-500);
                        }

                        .ev-stat-resolution::before {
                            background-color: var(--green-500);
                        }

                        .ev-stat-time::before {
                            background-color: var(--gray-500);
                        }

                        .ev-stat-content {
                            text-align: center;
                        }

                        .ev-stat-value {
                            font-size: 2rem;
                            font-weight: 700;
                            color: var(--gray-800);
                            line-height: 1.2;
                        }

                        .ev-stat-label {
                            font-size: 0.875rem;
                            color: var(--gray-500);
                            margin-top: 0.25rem;
                        }

                        /* Gráficos */
                        .ev-dashboard-charts {
                            margin-bottom: 2rem;
                        }

                        .ev-chart-row {
                            display: flex;
                            flex-wrap: wrap;
                            gap: 1.5rem;
                            margin-bottom: 1.5rem;
                        }

                        .ev-chart-column {
                            flex: 1;
                            min-width: 280px;
                        }

                        .ev-chart-full-width {
                            width: 100%;
                        }

                        .ev-chart-card {
                            background-color: white;
                            border-radius: var(--border-radius-lg);
                            box-shadow: var(--shadow-md);
                            overflow: hidden;
                            height: 100%;
                        }

                        .ev-chart-header {
                            padding: 1rem;
                            border-bottom: 1px solid var(--gray-200);
                        }

                        .ev-chart-title {
                            font-size: 1rem;
                            font-weight: 600;
                            color: var(--gray-700);
                            margin: 0;
                        }

                        .ev-chart-body {
                            padding: 1rem;
                            display: flex;
                            flex-direction: column;
                            align-items: center;
                            height: 300px;
                        }

                        .ev-timeline-chart {
                            height: 250px;
                        }

                        .ev-chart-img {
                            max-width: 100%;
                            max-height: 220px;
                            object-fit: contain;
                        }

                        .ev-chart-legend {
                            display: flex;
                            flex-wrap: wrap;
                            gap: 1rem;
                            margin-top: 0.75rem;
                            width: 100%;
                            justify-content: center;
                        }

                        .ev-legend-item {
                            display: flex;
                            align-items: center;
                            font-size: 0.75rem;
                            color: var(--gray-600);
                        }

                        .ev-legend-bullet {
                            display: inline-block;
                            width: 12px;
                            height: 12px;
                            border-radius: var(--border-radius-full);
                            margin-right: 0.375rem;
                        }

                        .ev-critical .ev-legend-bullet {
                            background-color: var(--red-500);
                        }

                        .ev-normal .ev-legend-bullet {
                            background-color: var(--blue-500);
                        }

                        .ev-critical-visits .ev-legend-bullet {
                            background-color: var(--red-500);
                        }

                        .ev-different-issues .ev-legend-bullet {
                            background-color: var(--blue-500);
                        }

                        /* Tablas de datos */
                        .ev-data-table-container {
                            margin-top: 1rem;
                            border-radius: var(--border-radius-lg);
                            overflow: hidden;
                            box-shadow: var(--shadow);
                        }

                        .ev-data-table {
                            width: 100%;
                            border-collapse: collapse;
                        }

                        .ev-data-table thead {
                            background-color: var(--gray-800);
                            color: white;
                        }

                        .ev-data-table th {
                            padding: 0.75rem 1rem;
                            text-align: left;
                            font-weight: 600;
                            font-size: 0.875rem;
                        }

                        .ev-data-table tbody tr {
                            background-color: white;
                            border-bottom: 1px solid var(--gray-200);
                        }

                        .ev-data-table tbody tr:last-child {
                            border-bottom: none;
                        }

                        .ev-data-table td {
                            padding: 0.75rem 1rem;
                            font-size: 0.875rem;
                            color: var(--gray-700);
                        }

                        .ev-close-visits {
                            background-color: var(--amber-100);
                        }

                        .ev-visit-count {
                            display: inline-flex;
                            align-items: center;
                            justify-content: center;
                            background-color: var(--blue-500);
                            color: white;
                            width: 2rem;
                            height: 2rem;
                            border-radius: var(--border-radius-full);
                            font-weight: 600;
                        }

                        /* Cliente Top */
                        .ev-client-card {
                            display: flex;
                            background-color: white;
                            border-radius: var(--border-radius-lg);
                            padding: 1.5rem;
                            box-shadow: var(--shadow-md);
                            margin-top: 1rem;
                            border-left: 5px solid var(--blue-600);
                        }

                        .ev-client-icon-container {
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            width: 4rem;
                            height: 4rem;
                            background-color: var(--blue-100);
                            border-radius: var(--border-radius-full);
                            margin-right: 1.5rem;
                            flex-shrink: 0;
                        }

                        .ev-client-icon {
                            font-size: 1.75rem;
                            color: var(--blue-600);
                        }

                        .ev-client-details {
                            flex-grow: 1;
                        }

                        .ev-client-name {
                            font-size: 1.25rem;
                            font-weight: 600;
                            color: var(--gray-800);
                            margin-bottom: 0.5rem;
                        }

                        .ev-client-stat {
                            display: flex;
                            align-items: center;
                            margin-bottom: 1rem;
                        }

                        .ev-client-count {
                            font-size: 1.125rem;
                            font-weight: 700;
                            color: var(--red-500);
                            background-color: var(--red-100);
                            padding: 0.25rem 0.75rem;
                            border-radius: var(--border-radius-full);
                            margin-right: 0.5rem;
                        }

                        .ev-client-label {
                            color: var(--gray-600);
                            font-size: 0.875rem;
                        }

                        .ev-client-contact-info {
                            display: flex;
                            flex-wrap: wrap;
                            gap: 1rem;
                        }

                        .ev-contact-item {
                            color: var(--gray-600);
                            font-size: 0.875rem;
                            display: flex;
                            align-items: center;
                        }

                        .ev-contact-icon {
                            color: var(--gray-400);
                            margin-right: 0.5rem;
                        }

                        /* Medidor de Tiempo */
                        .ev-gauge-card {
                            background-color: white;
                            border-radius: var(--border-radius-lg);
                            padding: 1.5rem;
                            box-shadow: var(--shadow-md);
                            margin-top: 1rem;
                            text-align: center;
                        }

                        .ev-gauge-value {
                            font-size: 2rem;
                            font-weight: 700;
                            color: var(--gray-800);
                            margin-bottom: 1rem;
                        }

                        .ev-gauge-container {
                            margin: 0 auto;
                            max-width: 500px;
                            margin-bottom: 1rem;
                        }

                        .ev-gauge-track {
                            height: 1rem;
                            background-color: var(--gray-200);
                            border-radius: var(--border-radius-full);
                            overflow: hidden;
                        }

                        .ev-gauge-fill {
                            height: 100%;
                            background: linear-gradient(90deg, var(--green-500) 0%, var(--amber-500) 50%, var(--red-500) 100%);
                            border-radius: var(--border-radius-full);
                        }

                        .ev-gauge-labels {
                            display: flex;
                            justify-content: space-between;
                            margin-top: 0.5rem;
                            color: var(--gray-500);
                            font-size: 0.75rem;
                        }

                        .ev-gauge-assessment {
                            margin-top: 1rem;
                        }

                        .ev-time-excellent,
                        .ev-time-good,
                        .ev-time-average,
                        .ev-time-poor {
                            font-weight: 600;
                            padding: 0.375rem 1rem;
                            border-radius: var(--border-radius-full);
                            display: inline-block;
                        }

                        .ev-time-excellent {
                            background-color: var(--green-100);
                            color: var(--green-500);
                        }

                        .ev-time-good {
                            background-color: var(--blue-100);
                            color: var(--blue-600);
                        }

                        .ev-time-average {
                            background-color: var(--amber-100);
                            color: var(--amber-500);
                        }

                        .ev-time-poor {
                            background-color: var(--red-100);
                            color: var(--red-500);
                        }

                        /* Mensajes vacíos */
                        .ev-no-data {
                            background-color: var(--gray-50);
                            border: 1px dashed var(--gray-300);
                            border-radius: var(--border-radius-lg);
                            padding: 2rem;
                            text-align: center;
                            color: var(--gray-500);
                            margin-top: 1rem;
                        }

                        /* Pie de página */
                        .ev-report-footer {
                            margin-top: 2rem;
                            padding-top: 1rem;
                            border-top: 1px solid var(--gray-200);
                        }

                        .ev-footer-content {
                            display: flex;
                            justify-content: space-between;
                            color: var(--gray-500);
                            font-size: 0.75rem;
                        }

                        /* Media queries para PDF */
                        @media print {
                            .ev-dashboard-header {
                                background-color: var(--gray-800) !important;
                                color: white !important;
                                -webkit-print-color-adjust: exact;
                                print-color-adjust: exact;
                            }
                            
                            .ev-data-table thead {
                                background-color: var(--gray-800) !important;
                                color: white !important;
                                -webkit-print-color-adjust: exact;
                                print-color-adjust: exact;
                            }
                            
                            .ev-close-visits {
                                background-color: var(--amber-100) !important;
                                -webkit-print-color-adjust: exact;
                                print-color-adjust: exact;
                            }
                            
                            .ev-visit-count {
                                background-color: var(--blue-500) !important;
                                color: white !important;
                                -webkit-print-color-adjust: exact;
                                print-color-adjust: exact;
                            }
                            
                            .ev-gauge-fill {
                                -webkit-print-color-adjust: exact;
                                print-color-adjust: exact;
                            }
                        }
                    </style>
                    <div class="page">
                        <!-- Cabecera del Informe - Estilo moderno con fondo oscuro -->
                        <div class="ev-dashboard-header">
                            <div class="header-content">
                                <div class="title-section">
                                    <h1 class="ev-dashboard-title">INFORME MENSUAL DE VISITAS TÉCNICAS</h1>
                                </div>
                                <div class="period-section">
                                    <span class="ev-period">
                                        <!-- Corrección 1: Uso directo de strftime -->
                                        <t t-esc="doc.date_from.strftime('%B %Y')"/>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Resumen Ejecutivo -->
                        <div class="ev-executive-summary">
                            <div class="ev-section-header">
                                <h2 class="ev-section-title">Resumen Ejecutivo</h2>
                            </div>
                            <div class="ev-summary-stats">
                                <div class="ev-stat-card ev-stat-visits">
                                    <div class="ev-stat-content">
                                        <div class="ev-stat-value"><t t-esc="doc.total_visits"/></div>
                                        <div class="ev-stat-label">Total Visitas</div>
                                    </div>
                                </div>
                                <div class="ev-stat-card ev-stat-recurring">
                                    <div class="ev-stat-content">
                                        <div class="ev-stat-value"><t t-esc="doc.recurring_equipment_count"/></div>
                                        <div class="ev-stat-label">Equipos Recurrentes</div>
                                    </div>
                                </div>
                                <div class="ev-stat-card ev-stat-resolution">
                                    <div class="ev-stat-content">
                                        <div class="ev-stat-value"><t t-esc="round(doc.first_visit_resolution_rate, 1)"/>%</div>
                                        <div class="ev-stat-label">Tasa Resolución</div>
                                    </div>
                                </div>
                                <div class="ev-stat-card ev-stat-time">
                                    <div class="ev-stat-content">
                                        <div class="ev-stat-value"><t t-esc="round(doc.average_response_time, 1)"/> días</div>
                                        <div class="ev-stat-label">Tiempo Promedio</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Gráficos principales en formato dashboard -->
                        <div class="ev-dashboard-charts">
                            <div class="ev-chart-row">
                                <div class="ev-chart-column">
                                    <div class="ev-chart-card">
                                        <div class="ev-chart-header">
                                            <h3 class="ev-chart-title">Equipos con Mayor Número de Visitas</h3>
                                        </div>
                                        <div class="ev-chart-body">
                                            <!-- Corrección 2: Acceso directo al objeto chart_images decodificado -->
                                            <t t-if="doc.chart_images">
                                                <img t-if="json.loads(doc.chart_images).get('equipment_chart')" 
                                                    t-att-src="'data:image/png;base64,' + json.loads(doc.chart_images).get('equipment_chart')" 
                                                    class="ev-chart-img"/>
                                            </t>
                                            <div t-if="not doc.chart_images or not json.loads(doc.chart_images or '{}').get('equipment_chart')" class="ev-no-data">
                                                <i class="fa fa-info-circle"/> No hay datos suficientes para mostrar el gráfico.
                                            </div>
                                            <div class="ev-chart-legend">
                                                <div class="ev-legend-item ev-critical">
                                                    <span class="ev-legend-bullet"></span>
                                                    <span class="ev-legend-text">Crítico (≥3 visitas)</span>
                                                </div>
                                                <div class="ev-legend-item ev-normal">
                                                    <span class="ev-legend-bullet"></span>
                                                    <span class="ev-legend-text">Normal (1-2 visitas)</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="ev-chart-column">
                                    <div class="ev-chart-card">
                                        <div class="ev-chart-header">
                                            <h3 class="ev-chart-title">Distribución de Visitas por Cliente</h3>
                                        </div>
                                        <div class="ev-chart-body">
                                            <!-- Corrección 2: Acceso directo al objeto chart_images decodificado -->
                                            <t t-if="doc.chart_images">
                                                <img t-if="json.loads(doc.chart_images).get('client_chart')" 
                                                    t-att-src="'data:image/png;base64,' + json.loads(doc.chart_images).get('client_chart')" 
                                                    class="ev-chart-img"/>
                                            </t>
                                            <div t-if="not doc.chart_images or not json.loads(doc.chart_images or '{}').get('client_chart')" class="ev-no-data">
                                                <i class="fa fa-info-circle"/> No hay datos suficientes para mostrar el gráfico.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Gráfico de línea temporal -->
                            <div class="ev-chart-row">
                                <div class="ev-chart-full-width">
                                    <div class="ev-chart-card">
                                        <div class="ev-chart-header">
                                            <h3 class="ev-chart-title">Línea de Tiempo: Equipos con Problemas Recurrentes</h3>
                                        </div>
                                        <div class="ev-chart-body ev-timeline-chart">
                                            <!-- Corrección 2: Acceso directo al objeto chart_images decodificado -->
                                            <t t-if="doc.chart_images">
                                                <img t-if="json.loads(doc.chart_images).get('trend_chart')" 
                                                    t-att-src="'data:image/png;base64,' + json.loads(doc.chart_images).get('trend_chart')" 
                                                    class="ev-chart-img"/>
                                            </t>
                                            <div t-if="not doc.chart_images or not json.loads(doc.chart_images or '{}').get('trend_chart')" class="ev-no-data">
                                                <i class="fa fa-info-circle"/> No hay datos suficientes para mostrar el gráfico.
                                            </div>
                                            <div class="ev-chart-legend">
                                                <div class="ev-legend-item ev-critical-visits">
                                                    <span class="ev-legend-bullet"></span>
                                                    <span class="ev-legend-text">Visitas críticas (mismo problema)</span>
                                                </div>
                                                <div class="ev-legend-item ev-different-issues">
                                                    <span class="ev-legend-bullet"></span>
                                                    <span class="ev-legend-text">Visitas por problemas distintos</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tabla de Equipos Críticos -->
                        <div class="ev-critical-equipment">
                            <div class="ev-section-header">
                                <h2 class="ev-section-title">Equipos Críticos</h2>
                            </div>
                            <t t-set="table_data" t-value="json.loads(doc.chart_data or '{}').get('table', [])"/>
                            <t t-set="critical_equipment" t-value="[item for item in table_data if item.get('is_critical')]"/>
                            
                            <div t-if="not critical_equipment" class="ev-no-data">
                                <i class="fa fa-info-circle"/> No se encontraron equipos críticos durante este período.
                            </div>
                            
                            <div t-if="critical_equipment" class="ev-data-table-container">
                                <table class="ev-data-table">
                                    <thead>
                                        <tr>
                                            <th>Cliente</th>
                                            <th>Modelo</th>
                                            <th>Serie</th>
                                            <th>Problema Principal</th>
                                            <th class="text-center">Visitas</th>
                                            <th>Técnicos</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="critical_equipment" t-as="item">
                                            <tr t-att-class="'ev-close-visits' if item.get('has_close_visits') else ''">
                                                <td><t t-esc="item.get('partner')"/></td>
                                                <td><t t-esc="item.get('model')"/></td>
                                                <td><t t-esc="item.get('serie')"/></td>
                                                <td><t t-esc="item.get('problem')"/></td>
                                                <td class="text-center">
                                                    <span class="ev-visit-count"><t t-esc="item.get('visit_count')"/></span>
                                                </td>
                                                <td><t t-esc="', '.join(item.get('technicians', []))"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Cliente con Más Visitas - Card moderna -->
                        <div class="ev-top-client">
                            <div class="ev-section-header">
                                <h2 class="ev-section-title">Cliente con Más Visitas</h2>
                            </div>
                            <div class="ev-client-card">
                                <div class="ev-client-icon-container">
                                    <i class="fa fa-building ev-client-icon"/>
                                </div>
                                <div class="ev-client-details">
                                    <div class="ev-client-name"><t t-esc="doc.top_client_id.name or 'Sin datos'"/></div>
                                    <div class="ev-client-stat">
                                        <span class="ev-client-count"><t t-esc="doc.top_client_visit_count or 0"/></span>
                                        <span class="ev-client-label">visitas durante el período</span>
                                    </div>
                                    <div t-if="doc.top_client_id" class="ev-client-contact-info">
                                        <div t-if="doc.top_client_id.phone" class="ev-contact-item">
                                            <i class="fa fa-phone ev-contact-icon"/> <t t-esc="doc.top_client_id.phone"/>
                                        </div>
                                        <div t-if="doc.top_client_id.email" class="ev-contact-item">
                                            <i class="fa fa-envelope ev-contact-icon"/> <t t-esc="doc.top_client_id.email"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tiempo Promedio de Respuesta - Modern gauge -->
                        <div class="ev-response-time">
                            <div class="ev-section-header">
                                <h2 class="ev-section-title">Tiempo Promedio de Respuesta</h2>
                            </div>
                            <div class="ev-gauge-card">
                                <div class="ev-gauge-value">
                                    <t t-esc="round(doc.average_response_time, 1)"/> días
                                </div>
                                <div class="ev-gauge-container">
                                    <div class="ev-gauge-track">
                                        <div t-attf-class="ev-gauge-fill" t-attf-style="width: {{ min(100, max(0, doc.average_response_time * 10)) }}%;">
                                        </div>
                                    </div>
                                    <div class="ev-gauge-labels">
                                        <span class="ev-gauge-min">0</span>
                                        <span class="ev-gauge-mid">5</span>
                                        <span class="ev-gauge-max">10+</span>
                                    </div>
                                </div>
                                <div class="ev-gauge-assessment">
                                    <t t-if="doc.average_response_time &lt; 2">
                                        <span class="ev-time-excellent">Excelente</span>
                                    </t>
                                    <t t-elif="doc.average_response_time &lt; 4">
                                        <span class="ev-time-good">Bueno</span>
                                    </t>
                                    <t t-elif="doc.average_response_time &lt; 7">
                                        <span class="ev-time-average">Regular</span>
                                    </t>
                                    <t t-else="">
                                        <span class="ev-time-poor">Mejorable</span>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Pie de informe -->
                        <div class="ev-report-footer">
                            <div class="ev-footer-content">
                                <div class="ev-report-date">
                                    Generado el: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                                </div>
                                <div class="ev-report-id">
                                    ID de informe: <t t-esc="doc.id"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
        <script type="text/javascript" src="/sat/static/src/js/equipment_visit_report.js"></script>
    </template>
</odoo>
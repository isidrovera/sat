<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <record id="action_report_evaluacion_personal" model="ir.actions.report">
        <field name="name">Evaluación de Personal</field>
        <field name="model">evaluacion.personal</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sat.report_evaluacion_personal</field>
        <field name="report_file">sat.report_evaluacion_personal</field>
        <field name="print_report_name">'Evaluación - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sat.model_evaluacion_personal"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_service_evaluation" model="ir.actions.report">
        <field name="name">Evaluación de Servicio</field>
        <field name="model">client.service.evaluation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sat.report_service_evaluation</field>
        <field name="report_file">sat.report_service_evaluation</field>
        <field name="print_report_name">'Evaluación de Servicio - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sat.model_client_service_evaluation"/>
        <field name="binding_type">report</field>
    </record>
 <record id="action_report_informes_ventas" model="ir.actions.report">
        <field name="name">Informe de Estado de Equipos</field>
        <field name="model">informes</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sat.report_informes_template</field>
        <field name="report_file">sat.report_informes_template</field>
        <field name="print_report_name">'Informe de Estado - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sat.model_informes"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>
     <record id="action_report_reparaciones_ventas" model="ir.actions.report">
        <field name="name">Reparaciones</field>
        <field name="model">reparaciones.reparaciones</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sat.report_reparaciones_ventas</field> <!-- Aquí cambias el nombre -->
        <field name="report_file">sat.report_reparaciones_ventas</field> <!-- Aquí también -->
        <field name="print_report_name">'Reparación - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sat.model_reparaciones_reparaciones"/>
        <field name="binding_type">report</field>
    </record>
    <!-- Formato de papel vertical optimizado -->
    <record id="paperformat_qr_vertical_single" model="report.paperformat">
        <field name="name">QR Vertical Una Página</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <!-- Reporte configurado para una sola página vertical -->
    <record id="action_report_qr_codes_reparaciones_template" model="ir.actions.report">
        <field name="name">Reparaciones QR</field>
        <field name="model">reparaciones.reparaciones</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sat.report_qr_codes_reparaciones_template</field>
        <field name="report_file">sat.report_qr_codes_reparaciones_template</field>
        <field name="print_report_name">'Reparación - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_qr_vertical_single"/>
        <field name="binding_model_id" ref="sat.model_reparaciones_reparaciones"/>
        <field name="binding_type">report</field>
    </record>
    
    <record id="paperformat_landscape_reporte_maquinas" model="report.paperformat">
        <field name="name">A4 Horizontal — Reporte Máquinas</field>
        <field name="default">False</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">3</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_reporte_estado_maquinas_pdf" model="ir.actions.report">
        <field name="name">Reporte de Estado de Máquinas</field>
        <field name="model">reporte.estado.maquina</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sat.reporte_estado_maquinas_pdf</field>
        <field name="report_file">sat.reporte_estado_maquinas_pdf</field>
        <field name="paperformat_id" ref="paperformat_landscape_reporte_maquinas"/>
        <field name="print_report_name">
            'Reporte_Estado_Maquinas_%s' % (object.semana_reporte or object.fecha_generacion or '')
        </field>
        <field name="binding_type">report</field>
    </record>
    <record id="report_alquiler_qr" model="ir.actions.report">
            <field name="name">QR Codes alquiler</field>
            <field name="model">alquiler</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sat.report_qr_alquiler_template</field>
            <field name="report_file">sat.report_qr_alquiler_template</field>
            <field name="print_report_name">object.name</field>
        </record>
     <!-- ============================================ -->
    <!-- FORMATO DE PAPEL LANDSCAPE                   -->
    <!-- ============================================ -->
    <record id="paperformat_repuesto_landscape" model="report.paperformat">
        <field name="name">Pedido Repuestos Landscape</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>
 
    <!-- ============================================ -->
    <!-- ACCIÓN DEL REPORTE                           -->
    <!-- ============================================ -->
        <record id="action_report_ticket_repuesto_pedido" model="ir.actions.report">
        <field name="name">Pedido de Repuestos</field>
        <field name="model">ticket.repuesto.pedido</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sat.report_ticket_repuesto_pedido</field>
        <field name="report_file">sat.report_ticket_repuesto_pedido</field>
        <field name="paperformat_id" ref="sat.paperformat_repuesto_landscape"/>
        <field name="print_report_name">'Pedido Repuestos - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sat.model_ticket_repuesto_pedido"/>
        <field name="binding_type">report</field>
    </record>

    </data>
</odoo>
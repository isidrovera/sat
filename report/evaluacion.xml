<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_evaluacion_personal">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .report-header {
                            display: flex;
                            justify-content: space-between;
                            margin-bottom: 30px;
                            padding: 20px;
                            background: #f8f9fa;
                            border-radius: 10px;
                            }
                            .date-info, .user-info {
                            display: flex;
                            align-items: center;
                            }
                            .date-info i, .user-info i {
                            color: #3498db;
                            margin-right: 10px;
                            }
                            .metrics-container {
                            display: grid;
                            grid-template-columns: repeat(3, 1fr);
                            gap: 20px;
                            margin-bottom: 30px;
                            }
                            .metric-card {
                            background: white;
                            border-radius: 15px;
                            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
                            padding: 20px;
                            position: relative;
                            overflow: hidden;
                            }
                            .metric-card::before {
                            content: '';
                            position: absolute;
                            top: 0;
                            left: 0;
                            width: 100%;
                            height: 4px;
                            }
                            .metric-card.score::before { background: #3498db; }
                            .metric-card.repairs::before { background: #2ecc71; }
                            .metric-card.tickets::before { background: #e74c3c; }
                            .metric-title {
                            color: #2c3e50;
                            font-size: 16px;
                            margin-bottom: 10px;
                            display: flex;
                            align-items: center;
                            }
                            .metric-title i {
                            margin-right: 10px;
                            font-size: 20px;
                            color: #3498db;
                            }
                            .metric-value {
                            font-size: 32px;
                            font-weight: bold;
                            color: #2c3e50;
                            }
                            .section-title {
                            background: #2c3e50;
                            color: white;
                            padding: 15px;
                            border-radius: 10px;
                            margin: 30px 0 20px;
                            font-weight: bold;
                            font-size: 18px;
                            }
                            .progress-container {
                            margin-top: 10px;
                            }
                            .progress-bar {
                            height: 8px;
                            background: #ecf0f1;
                            border-radius: 4px;
                            overflow: hidden;
                            }
                            .progress-fill {
                            height: 100%;
                            transition: width 0.3s ease;
                            }
                            .progress-fill.excellent { background: #27ae60; }
                            .progress-fill.good { background: #2ecc71; }
                            .progress-fill.regular { background: #f1c40f; }
                            .progress-fill.poor { background: #e74c3c; }
                            .evaluation-grid {
                            display: grid;
                            grid-template-columns: repeat(2, 1fr);
                            gap: 20px;
                            margin-bottom: 30px;
                            }
                            .evaluation-item {
                            background: white;
                            border-radius: 10px;
                            padding: 20px;
                            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
                            }
                            .evaluation-label {
                            color: #7f8c8d;
                            margin-bottom: 10px;
                            }
                            .evaluation-value {
                            font-size: 24px;
                            font-weight: bold;
                            color: #2c3e50;
                            margin-bottom: 10px;
                            }
                        </style>

                        <!-- Encabezado -->
                        <div class="report-header">
                            <div class="date-info">
                                <i class="fa fa-calendar"></i>
                                <span>Evaluación N°: <t t-esc="o.name" /></span>
                            </div>
                            <div class="user-info">
                                <i class="fa fa-user"></i>
                                <span>Técnico: <t t-esc="o.nombre_usuario" /></span>
                            </div>
                        </div>

                        <!-- Métricas Principales -->
                        <div class="metrics-container">
                            <!-- Puntaje Total -->
                            <div class="metric-card score">
                                <div class="metric-title">
                                    <i class="fa fa-star"></i> Puntaje Total </div>
                                <div class="metric-value">
                                    <t t-esc="'%.1f' % o.puntaje_total" />% </div>
                                <div class="progress-container">
                                    <div class="progress-bar">
                                        <div
                                            t-attf-class="progress-fill {{
                                            'excellent' if o.puntaje_total >= 90 else
                                            'good' if o.puntaje_total >= 80 else
                                            'regular' if o.puntaje_total >= 70 else
                                            'poor'
                                        }}"
                                            t-attf-style="width: #{min(o.puntaje_total, 100)}%" />
                                    </div>
                                </div>
                            </div>

                            <!-- Reparaciones -->
                            <div class="metric-card repairs">
                                <div class="metric-title">
                                    <i class="fa fa-tools"></i> Reparaciones </div>
                                <div class="metric-value">
                                    <t t-esc="o.cantidad_reparaciones" />
                                </div>
                                <div class="progress-container">
                                    <div class="progress-bar">
                                        <div class="progress-fill good"
                                            t-attf-style="width: #{min((o.cantidad_reparaciones/o.objetivo_reparaciones)*100 if o.objetivo_reparaciones > 0 else 0, 100)}%" />
                                    </div>
                                </div>
                            </div>

                            <!-- Tickets -->
                            <div class="metric-card tickets">
                                <div class="metric-title">
                                    <i class="fa fa-ticket-alt"></i> Tickets </div>
                                <div class="metric-value">
                                    <t t-esc="o.cantidad_tickets" />
                                </div>
                                <div class="progress-container">
                                    <div class="progress-bar">
                                        <div class="progress-fill good"
                                            t-attf-style="width: #{min((o.cantidad_tickets/o.objetivo_tickets)*100 if o.objetivo_tickets > 0 else 0, 100)}%" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Evaluación Técnica -->
                        <div class="section-title">
                            <i class="fa fa-cogs me-2"></i> EVALUACIÓN TÉCNICA </div>
                        <div class="evaluation-grid">
                            <!-- Calidad del Trabajo -->
                            <div class="evaluation-item">
                                <div class="metric-title">
                                    <i class="fa fa-check-circle"></i> Calidad del Trabajo </div>
                                <div class="evaluation-value">
                                    <t
                                        t-esc="dict(o._fields['calidad_trabajo'].selection).get(o.calidad_trabajo)" />
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill good"
                                        t-attf-style="width: #{int(o.calidad_trabajo or '0')*20}%" />
                                </div>
                            </div>

                            <!-- Conocimiento Técnico -->
                            <div class="evaluation-item">
                                <div class="metric-title">
                                    <i class="fa fa-brain"></i> Conocimiento Técnico </div>
                                <div class="evaluation-value">
                                    <t
                                        t-esc="dict(o._fields['conocimiento_tecnico'].selection).get(o.conocimiento_tecnico)" />
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill good"
                                        t-attf-style="width: #{int(o.conocimiento_tecnico or '0')*20}%" />
                                </div>
                            </div>

                            <!-- Resolución de Problemas -->
                            <div class="evaluation-item">
                                <div class="metric-title">
                                    <i class="fa fa-puzzle-piece"></i> Resolución de Problemas </div>
                                <div class="evaluation-value">
                                    <t
                                        t-esc="dict(o._fields['resolucion_problemas'].selection).get(o.resolucion_problemas)" />
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill good"
                                        t-attf-style="width: #{int(o.resolucion_problemas or '0')*20}%" />
                                </div>
                            </div>

                            <!-- Uso de Herramientas -->
                            <div class="evaluation-item">
                                <div class="metric-title">
                                    <i class="fa fa-wrench"></i> Uso de Herramientas </div>
                                <div class="evaluation-value">
                                    <t
                                        t-esc="dict(o._fields['uso_herramientas'].selection).get(o.uso_herramientas)" />
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill good"
                                        t-attf-style="width: #{int(o.uso_herramientas or '0')*20}%" />
                                </div>
                            </div>
                        </div>

                        <!-- Evaluación Actitudinal -->
                        <div class="section-title">
                            <i class="fa fa-user-check me-2"></i> EVALUACIÓN ACTITUDINAL </div>
                        <div class="evaluation-grid">
                            <!-- Puntualidad -->
                            <div class="evaluation-item">
                                <div class="metric-title">
                                    <i class="fa fa-clock"></i> Puntualidad </div>
                                <div class="evaluation-value">
                                    <t
                                        t-esc="dict(o._fields['puntualidad'].selection).get(o.puntualidad)" />
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill good"
                                        t-attf-style="width: #{int(o.puntualidad or '0')*20}%" />
                                </div>
                            </div>

                            <!-- Compromiso -->
                            <div class="evaluation-item">
                                <div class="metric-title">
                                    <i class="fa fa-handshake"></i> Compromiso </div>
                                <div class="evaluation-value">
                                    <t
                                        t-esc="dict(o._fields['compromiso'].selection).get(o.compromiso)" />
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill good"
                                        t-attf-style="width: #{int(o.compromiso or '0')*20}%" />
                                </div>
                            </div>

                            <!-- Trabajo en Equipo -->
                            <div class="evaluation-item">
                                <div class="metric-title">
                                    <i class="fa fa-users"></i> Trabajo en Equipo </div>
                                <div class="evaluation-value">
                                    <t
                                        t-esc="dict(o._fields['trabajo_equipo'].selection).get(o.trabajo_equipo)" />
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill good"
                                        t-attf-style="width: #{int(o.trabajo_equipo or '0')*20}%" />
                                </div>
                            </div>
                        </div>

                        <!-- Atención al Cliente -->
                        <div class="section-title">
                            <i class="fa fa-headset me-2"></i> ATENCIÓN AL CLIENTE </div>
                        <div class="evaluation-grid">
                            <!-- Trato al Cliente -->
                            <div class="evaluation-item">
                                <div class="metric-title">
                                    <i class="fa fa-smile"></i> Trato al Cliente </div>
                                <div class="evaluation-value">
                                    <t
                                        t-esc="dict(o._fields['trato_cliente'].selection).get(o.trato_cliente)" />
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill good"
                                        t-attf-style="width: #{int(o.trato_cliente or '0')*20}%" />
                                </div>
                            </div>

                            <!-- Comunicación con Cliente -->
                            <div class="evaluation-item">
                                <div class="metric-title">
                                    <i class="fa fa-comments"></i> Comunicación con Cliente </div>
                                <div class="evaluation-value">
                                    <t
                                        t-esc="dict(o._fields['comunicacion_cliente'].selection).get(o.comunicacion_cliente)" />
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill good"
                                        t-attf-style="width: #{int(o.comunicacion_cliente or '0')*20}%" />
                                </div>
                            </div>
                        </div>

                        <!-- Retroalimentación -->
                        <div class="section-title">
                            <i class="fa fa-comments me-2"></i> RETROALIMENTACIÓN </div>
                        <div class="feedback-container">
                            <!-- Fortalezas -->
                            <div class="feedback-section">
                                <div class="metric-title">
                                    <i class="fa fa-star"></i> Fortalezas Identificadas </div>
                                <div class="feedback-content">
                                    <t t-esc="o.fortalezas" />
                                </div>
                            </div>

                            <!-- Áreas de Mejora -->
                            <div class="feedback-section">
                                <div class="metric-title">
                                    <i class="fa fa-arrow-up"></i> Áreas de Mejora </div>
                                <div class="feedback-content">
                                    <t t-esc="o.areas_mejora" />
                                </div>
                            </div>

                            <!-- Plan de Acción -->
                            <div class="feedback-section">
                                <div class="metric-title">
                                    <i class="fa fa-tasks"></i> Plan de Acción </div>
                                <div class="feedback-content">
                                    <t t-esc="o.plan_accion" />
                                </div>
                            </div>

                            <!-- Comentarios -->
                            <div class="feedback-section">
                                <div class="metric-title">
                                    <i class="fa fa-comment"></i> Comentarios Adicionales </div>
                                <div class="feedback-content">
                                    <t t-esc="o.comentarios" />
                                </div>
                            </div>
                        </div>

                        <!-- Firmas -->
                        <div class="signatures-section">
                            <div class="row mt-5">
                                <div class="col-6 text-center">
                                    <div class="signature-line">
                                        <i class="fa fa-user-tie"></i> Firma del Evaluador </div>
                                </div>
                                <div class="col-6 text-center">
                                    <div class="signature-line">
                                        <i class="fa fa-user"></i> Firma del Técnico Evaluado </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_reporte_estado_maquinas_pdf" model="ir.actions.report">
        <field name="name">Reporte de Estado de Máquinas</field>
        <field name="model">reporte.estado.maquina</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sat.reporte_estado_maquinas_pdf</field>
        <field name="report_file">sat.reporte_estado_maquinas_pdf</field>
        <field name="print_report_name">
            'Reporte_Estado_Maquinas_%s' % (object.semana_reporte or object.fecha_generacion or '')
        </field>
        <field name="binding_type">report</field>
    </record>

    <template id="reporte_estado_maquinas_pdf" name="Reporte Estado de Máquinas">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="base_url" t-value="env['ir.config_parameter'].sudo().get_param('web.base.url') or ''"/>
                <t t-set="tz" t-value="env.user.tz or 'UTC'"/>

                <div class="page">
                    <style>
                        :root {
                            --ink: #0f172a;
                            --muted: #64748b;
                            --line: #e2e8f0;
                            --panel: #f8fafc;
                            --zebra: #fbfdff;
                            --ok: #16a34a;
                            --good: #3b82f6;
                            --warn: #f59e0b;
                            --attn: #f97316;
                            --bad: #dc2626;
                            --thead: #0b1220;
                            --theadText: #ffffff;
                            --partes-thead: #1e3a5f;
                        }

                        body { font-size: 12px; line-height: 1.28; color: var(--ink); }
                        h1, h2, h3 { margin: 0; }
                        .wrap { padding: 8px 6px; }
                        .tiny { font-size: 10px; color: var(--muted); }
                        .muted { color: var(--muted); }
                        .sec-title { margin: 12px 0 6px 0; font-weight: 700; font-size: 14px; }
                        .report-header { padding: 6px 0 10px 0; border-bottom: 2px solid var(--line); }

                        /* Botón-link */
                        .btn {
                            display: inline-block; padding: 4px 9px; border-radius: 6px;
                            border: 1px solid var(--good); background: #eef6ff; color: #0b5ed7;
                            font-size: 10px; font-weight: 700; text-decoration: none;
                        }

                        /* Badges de estado */
                        .badge {
                            display: inline-block; padding: 3px 10px; border-radius: 999px;
                            font-size: 11px; font-weight: 700; color: #fff;
                        }
                        .b-lista          { background: var(--ok); }
                        .b-revisada       { background: var(--good); }
                        .b-sin_revisar    { background: var(--warn); }
                        .b-con_problemas  { background: var(--attn); }
                        .b-partes         { background: var(--bad); }
                        .b-alquilada      { background: #0ea5e9; }
                        .b-externo        { background: #8b5cf6; }
                        .b-vendida        { background: #6b7280; }

                        /* Badges de fuente */
                        .badge-tecnico { background: #16a34a; }
                        .badge-bodega  { background: #3b82f6; }

                        /* Tabla principal */
                        table.main {
                            width: 100%; border-collapse: collapse;
                            table-layout: fixed; margin-top: 8px;
                        }
                        table.main thead { display: table-header-group; }
                        table.main th, table.main td {
                            border: 1px solid var(--line); padding: 6px 7px;
                            vertical-align: top; word-wrap: break-word;
                            overflow-wrap: break-word; hyphens: auto;
                        }
                        table.main thead th {
                            background: var(--thead); color: var(--theadText); font-weight: 700;
                        }
                        tbody tr:nth-child(odd) td { background: var(--zebra); }

                        /* Sub-tabla partes retiradas */
                        table.main td.partes-cell { padding: 0 !important; border-top: none !important; }
                        table.partes {
                            width: 100%; border-collapse: collapse;
                            margin: 0; font-size: 11px;
                        }
                        table.partes thead th {
                            background: var(--partes-thead); color: #fff;
                            font-weight: 700; padding: 4px 7px;
                            font-size: 10px; letter-spacing: 0.3px;
                        }
                        table.partes td {
                            padding: 3px 7px; border: 1px solid #dde3ec;
                            vertical-align: top; word-wrap: break-word;
                        }
                        table.partes tbody tr:nth-child(odd)  td { background: #fffbeb; }
                        table.partes tbody tr:nth-child(even) td { background: #fef9e7; }

                        .num    { text-align: right; white-space: nowrap; }
                        .nowrap { white-space: nowrap; }
                        .bold   { font-weight: 700; }
                        .small  { font-size: 10px; }
                        .color-muted { color: var(--muted); }

                        /* Anchos columna tabla principal */
                        .w-marca  { width: 11%; }
                        .w-modelo { width: 15%; }
                        .w-serie  { width: 15%; }
                        .w-total  { width: 11%; }
                        .w-info   { width: 24%; }
                        .w-accion { width: 11%; }
                        .w-estado-parte { width: 13%; }

                        /* Anchos columna sub-tabla partes */
                        .wp-parte   { width: 28%; }
                        .wp-fecha   { width: 14%; }
                        .wp-estado  { width: 14%; }
                        .wp-destino { width: 22%; }
                        .wp-fuente  { width: 22%; }

                        .no-break { page-break-inside: avoid; break-inside: avoid; }
                        tr        { page-break-inside: avoid; break-inside: avoid; }
                        .page-break-before { page-break-before: always; break-before: page; }

                        /* Tabla KPIs resumen */
                        table.kpi {
                            width: 100%; border-collapse: collapse;
                            margin-top: 6px; table-layout: fixed;
                        }
                        table.kpi td {
                            border: 1px solid var(--line); padding: 8px 10px;
                            text-align: center; vertical-align: middle;
                        }
                        .kpi-value { font-size: 22px; font-weight: 800; color: var(--ink); }
                        .kpi-label { font-size: 10px; color: var(--muted); margin-top: 2px; }
                        .kpi-ok    { background: #dcfce7; }
                        .kpi-warn  { background: #fef9c3; }
                        .kpi-bad   { background: #fee2e2; }
                        .kpi-info  { background: #dbeafe; }
                        .kpi-neutral { background: var(--panel); }
                    </style>

                    <!-- ══════════════════════════════════════════════════
                         ENCABEZADO
                    ══════════════════════════════════════════════════ -->
                    <div class="report-header wrap no-break">
                        <table style="width:100%; border:none;">
                            <tr>
                                <td style="border:none; padding:0; vertical-align:middle;">
                                    <h2 style="font-weight:800; font-size:18px;">
                                        📊 Estado de Máquinas — Inventario Alquiler
                                    </h2>
                                    <div class="tiny" style="margin-top:4px;">
                                        Generado: <t t-esc="date_print"/>
                                    </div>
                                </td>
                                <td style="border:none; padding:0; text-align:right; vertical-align:middle; width:30%;">
                                    <span class="badge" style="font-size:13px; padding:6px 16px; background:var(--thead);">
                                        <t t-esc="len(docs)"/> equipos
                                    </span>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         KPIs PRINCIPALES
                    ══════════════════════════════════════════════════ -->
                    <div class="wrap no-break">
                        <div class="sec-title">Resumen Ejecutivo</div>
                        <t t-set="total"          t-value="len(docs)"/>
                        <t t-set="total_lista"    t-value="len(docs.filtered(lambda r: r.estado_maquina == 'lista'))"/>
                        <t t-set="total_revisada" t-value="len(docs.filtered(lambda r: r.estado_maquina == 'revisada'))"/>
                        <t t-set="total_sr"       t-value="len(docs.filtered(lambda r: r.estado_maquina == 'sin_revisar'))"/>
                        <t t-set="total_cp"       t-value="len(docs.filtered(lambda r: r.estado_maquina == 'con_problemas'))"/>
                        <t t-set="total_partes"   t-value="len(docs.filtered(lambda r: r.estado_maquina == 'partes'))"/>
                        <t t-set="total_alq"      t-value="len(docs.filtered(lambda r: r.estado_maquina == 'alquilada'))"/>

                        <table class="kpi">
                            <tr>
                                <td class="kpi-neutral">
                                    <div class="kpi-value"><t t-esc="total"/></div>
                                    <div class="kpi-label">TOTAL EQUIPOS</div>
                                </td>
                                <td class="kpi-ok">
                                    <div class="kpi-value"><t t-esc="total_lista"/></div>
                                    <div class="kpi-label">LISTAS</div>
                                </td>
                                <td class="kpi-info">
                                    <div class="kpi-value"><t t-esc="total_revisada"/></div>
                                    <div class="kpi-label">REVISADAS</div>
                                </td>
                                <td class="kpi-warn">
                                    <div class="kpi-value"><t t-esc="total_sr"/></div>
                                    <div class="kpi-label">SIN REVISAR</div>
                                </td>
                                <td class="kpi-bad">
                                    <div class="kpi-value"><t t-esc="total_cp"/></div>
                                    <div class="kpi-label">CON PROBLEMAS</div>
                                </td>
                                <td class="kpi-bad">
                                    <div class="kpi-value"><t t-esc="total_partes"/></div>
                                    <div class="kpi-label">DE PARTES</div>
                                </td>
                                <td class="kpi-info">
                                    <div class="kpi-value"><t t-esc="total_alq"/></div>
                                    <div class="kpi-label">ALQUILADAS</div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         DISTRIBUCIÓN POR ESTADOS
                    ══════════════════════════════════════════════════ -->
                    <div class="wrap no-break">
                        <div class="sec-title">Distribución por Estados</div>
                        <table class="main" style="table-layout:fixed;">
                            <colgroup>
                                <col style="width:40%;"/>
                                <col style="width:30%;"/>
                                <col style="width:30%;"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Estado</th>
                                    <th class="num">Cantidad</th>
                                    <th class="num">%</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="by_state" t-as="s" t-key="s['label']">
                                    <tr>
                                        <td><t t-esc="s['label']"/></td>
                                        <td class="num bold"><t t-esc="s['qty']"/></td>
                                        <td class="num"><t t-esc="s['pct_str']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         DETALLE POR ESTADO
                    ══════════════════════════════════════════════════ -->
                    <div class="wrap">
                        <div class="sec-title">Detalle de Equipos por Estado</div>

                        <t t-set="estados_order" t-value="[
                            ('lista',          'Lista'),
                            ('revisada',       'Revisada'),
                            ('sin_revisar',    'Sin Revisar'),
                            ('con_problemas',  'Con Problemas'),
                            ('partes',         'De Partes'),
                            ('alquilada',      'Alquilada'),
                            ('externo',        'Externo'),
                            ('vendida',        'Vendida')
                        ]"/>

                        <t t-set="primero" t-value="True"/>
                        <t t-foreach="estados_order" t-as="st">
                            <t t-set="code"  t-value="st[0]"/>
                            <t t-set="label" t-value="st[1]"/>
                            <t t-set="rows"  t-value="docs.filtered(lambda r: r.estado_maquina == code)"/>

                            <t t-if="rows">
                                <div t-attf-class="#{'' if primero else 'page-break-before'}"/>
                                <t t-set="primero" t-value="False"/>

                                <!-- Título de grupo -->
                                <div class="sec-title no-break"
                                     style="display:flex; align-items:center; gap:10px; margin-top:14px;">
                                    <span class="badge" t-att-class="'badge b-' + code">
                                        <t t-esc="label"/> — <t t-esc="len(rows)"/> equipo(s)
                                    </span>
                                </div>

                                <table class="main">
                                    <colgroup>
                                        <col class="w-marca"/>
                                        <col class="w-modelo"/>
                                        <col class="w-serie"/>
                                        <col class="w-total"/>
                                        <col class="w-info"/>
                                        <col class="w-accion"/>
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th class="w-marca">Marca</th>
                                            <th class="w-modelo">Modelo</th>
                                            <th class="w-serie">Serie</th>
                                            <th class="w-total num">Contómetro</th>
                                            <th class="w-info">Informe Técnico</th>
                                            <th class="w-accion">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="rows" t-as="r" t-key="r.id">

                                            <!-- Fila principal del equipo -->
                                            <tr>
                                                <td><t t-esc="r.marca or ''"/></td>
                                                <td><t t-esc="r.modelo or ''"/></td>
                                                <td class="nowrap bold"><t t-esc="r.serie or ''"/></td>
                                                <td class="num"><t t-esc="r.contador_total or 0"/></td>
                                                <td class="small">
                                                    <t t-esc="informes_limpios.get(r.id) or ''"/>
                                                </td>
                                                <td>
                                                    <a class="btn"
                                                       t-attf-href="#{base_url}/web#id=#{r.id}&amp;model=reporte.estado.maquina&amp;view_type=form"
                                                       target="_blank">Ver detalle</a>
                                                </td>
                                            </tr>

                                            <!-- Fila de partes retiradas (solo si existen) -->
                                            <t t-if="r.partes_retiradas_ids">
                                                <tr>
                                                    <td class="partes-cell" colspan="6">
                                                        <table class="partes">
                                                            <thead>
                                                                <tr>
                                                                    <th class="wp-parte">🔩 Parte Retirada</th>
                                                                    <th class="wp-fecha">Fecha Solicitud</th>
                                                                    <th class="wp-estado">Estado</th>
                                                                    <th class="wp-destino">Destino (Serie)</th>
                                                                    <th class="wp-fuente">Fuente</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <t t-foreach="r.partes_retiradas_ids" t-as="p" t-key="p.id">
                                                                    <tr>
                                                                        <td>
                                                                            <span class="bold">
                                                                                <t t-esc="p.nombre_parte or ''"/>
                                                                            </span>
                                                                            <t t-if="p.descripcion">
                                                                                <br/>
                                                                                <span class="small color-muted">
                                                                                    <t t-esc="p.descripcion"/>
                                                                                </span>
                                                                            </t>
                                                                        </td>
                                                                        <td class="nowrap small">
                                                                            <t t-if="p.fecha_solicitud">
                                                                                <t t-esc="p.fecha_solicitud.strftime('%d/%m/%Y')"/>
                                                                            </t>
                                                                            <t t-else="">—</t>
                                                                        </td>
                                                                        <td class="small">
                                                                            <t t-esc="p.estado_parte or '—'"/>
                                                                        </td>
                                                                        <td class="small nowrap">
                                                                            <t t-esc="p.maquina_destino or '—'"/>
                                                                        </td>
                                                                        <td class="small">
                                                                            <t t-if="not p.solicitud_partes_id">
                                                                                <span class="badge badge-tecnico"
                                                                                      style="font-size:9px; padding:2px 7px;">
                                                                                    Técnico
                                                                                </span>
                                                                            </t>
                                                                            <t t-else="">
                                                                                <span class="badge badge-bodega"
                                                                                      style="font-size:9px; padding:2px 7px;">
                                                                                    Bodega
                                                                                </span>
                                                                            </t>
                                                                        </td>
                                                                    </tr>
                                                                </t>
                                                            </tbody>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </t>
                                            <!-- fin partes retiradas -->

                                        </t>
                                    </tbody>
                                </table>
                            </t>
                        </t>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         PIE DE PÁGINA
                    ══════════════════════════════════════════════════ -->
                    <div class="tiny wrap" style="margin-top:14px; border-top:1px solid var(--line); padding-top:6px;">
                        Generado por el sistema Andes Solution Copiers —
                        <t t-esc="date_print"/>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
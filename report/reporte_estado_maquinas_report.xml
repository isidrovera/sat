<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formato de papel A4 apaisado con márgenes contenidos -->
    <record id="paperformat_landscape_a4" model="report.paperformat">
        <field name="name">A4 Landscape SAT</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <!-- Opcional en algunos entornos: controla espaciado de header -->
        <field name="header_spacing">0</field>
        <!-- <field name="dpi">96</field> -->
    </record>

    <!-- Acción del reporte PDF -->
    <record id="action_reporte_estado_maquinas_pdf" model="ir.actions.report">
        <field name="name">Reporte de Estado de Máquinas</field>
        <field name="model">reporte.estado.maquina</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sat.reporte_estado_maquinas_pdf</field>
        <field name="report_file">sat.reporte_estado_maquinas_pdf</field>
        <field name="paperformat_id" ref="sat.paperformat_landscape_a4"/>
        <field name="print_report_name">
            'Reporte_Estado_Maquinas_%s' % (object.semana_reporte or object.fecha_generacion or '')
        </field>
        <field name="binding_type">report</field>
    </record>

    <!-- Plantilla QWeb del PDF -->
    <template id="reporte_estado_maquinas_pdf" name="Reporte Estado de Máquinas">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <!-- Precalcular estilo de tarjeta según estado global -->
                <t t-set="card_style">
                    <t t-if="kpis['estado_global'] == 'excelente'">border-color:#86efac;background:#dcfce7</t>
                    <t t-elif="kpis['estado_global'] == 'bueno'">border-color:#fde047;background:#fef9c3</t>
                    <t t-elif="kpis['estado_global'] == 'regular'">border-color:#fdba74;background:#ffedd5</t>
                    <t t-else="">border-color:#fca5a5;background:#fee2e2</t>
                </t>

                <div class="page">
                    <style>
                        /* ====== Reglas de impresión y paginado ====== */
                        @page { size: A4 landscape; }
                        /* Evitar que se corten cabeceras/filas entre páginas */
                        thead { display: table-header-group; }
                        tfoot { display: table-footer-group; }
                        tr, .no-break { page-break-inside: avoid; break-inside: avoid; }
                        .section { page-break-inside: avoid; break-inside: avoid; }
                        /* Margen interno general para que nada se “pegue” a los bordes */
                        .wrap { padding: 6px 4px; }

                        /* ====== Tokens y escala tipográfica ====== */
                        :root{
                            --dark:#111827; --muted:#6b7280; --border:#e5e7eb;
                            --ok:#22c55e; --warn:#f59e0b; --bad:#ef4444; --info:#3b82f6;
                            --card:#f8fafc;
                        }
                        body { font-size: 12px; line-height: 1.25; color: var(--dark); }
                        h1,h2,h3 { margin: 0; }

                        /* ====== Componentes ====== */
                        .tiny{font-size:10px;color:var(--muted);}
                        .muted{color:var(--muted);}
                        .sec-title{margin:12px 0 6px 0; font-weight:700; font-size:14px;}

                        .kpis{display:flex; gap:10px; margin-top:10px;}
                        .kpi{flex:1; border:1px solid var(--border); border-radius:8px; padding:8px 10px; }
                        .kpi .t{font-size:11px;color:var(--muted); margin-bottom:2px;}
                        .kpi .v{font-size:18px;font-weight:700;}

                        .card{background:var(--card); border:1px solid var(--border);
                              border-radius:8px; padding:8px 10px; margin:10px 0;}
                        .badge{display:inline-block;padding:3px 8px;border-radius:14px;
                               font-size:11px;font-weight:700;color:#fff; vertical-align:middle;}
                        .b-ok{background:var(--ok);} .b-warn{background:var(--warn);}
                        .b-bad{background:var(--bad);} .b-info{background:var(--info);}

                        /* ====== Tablas robustas para PDF ====== */
                        table.main{
                            width:100%;
                            border-collapse:collapse;
                            table-layout:fixed;   /* Controla desbordes y asegura ajuste */
                            margin-top:8px;
                        }
                        table.main th, table.main td{
                            border:1px solid var(--border);
                            padding:5px 6px;
                            vertical-align:top;
                            word-wrap:break-word;
                            overflow-wrap:break-word;
                            hyphens:auto;
                        }
                        table.main thead th{
                            background:#1f2937; color:#fff; font-weight:700;
                        }
                        .num{text-align:right; white-space:nowrap;}
                        .nowrap{white-space:nowrap;}
                        .w-date{width: 14%;}
                        .w-marca{width: 10%;}
                        .w-modelo{width: 14%;}
                        .w-serie{width: 15%;}
                        .w-estado{width: 12%;}
                        .w-total{width: 12%;}
                        .w-info{width: 23%;}

                        /* Ligeras filas “zebra” sin sobrecargar tinta */
                        tbody tr:nth-child(odd) td { background: #fbfdff; }

                        /* Encabezado superior con división sutil */
                        .header {
                            padding:6px 0 10px 0; border-bottom:1px solid var(--border);
                        }
                    </style>

                    <!-- Encabezado -->
                    <div class="header wrap no-break">
                        <h2 style="font-weight:700;">📊 Reporte Ejecutivo – Estado de Máquinas</h2>
                        <div class="tiny">
                            Impreso: <t t-esc="date_print"/> — Compañía: <t t-esc="company.display_name"/>
                        </div>
                    </div>

                    <!-- KPIs (no se parten) -->
                    <div class="kpis wrap no-break">
                        <div class="kpi">
                            <div class="t">Total equipos</div>
                            <div class="v" t-esc="kpis['total']"/>
                        </div>
                        <div class="kpi">
                            <div class="t">Operativos (lista + alquilada)</div>
                            <div class="v">
                                <t t-esc="kpis['operativos']"/>
                                <span class="tiny">(<t t-esc="kpis['pct_operativos_str']"/>)</span>
                            </div>
                        </div>
                        <div class="kpi">
                            <div class="t">Con problemas (problemas + partes)</div>
                            <div class="v" t-esc="kpis['problemas']"/>
                        </div>
                        <div class="kpi">
                            <div class="t">Sin revisar</div>
                            <div class="v" t-esc="kpis['sin_revisar']"/>
                        </div>
                    </div>

                    <!-- Estado global -->
                    <div class="wrap">
                        <div class="card no-break" t-att-style="card_style">
                            <strong t-esc="kpis['badge_text']"/>
                            <span class="tiny"> — Operativos: <t t-esc="kpis['pct_operativos_str']"/></span>
                        </div>
                    </div>

                    <!-- Distribución por estados -->
                    <div class="wrap section">
                        <div class="sec-title">Distribución por estados</div>
                        <table class="main">
                            <thead>
                                <tr>
                                    <th>Estado</th>
                                    <th class="num">Cantidad</th>
                                    <th class="num">%</th>
                                    <th class="num">Contómetro total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="by_state" t-as="s">
                                    <tr>
                                        <td><t t-esc="s['label']"/></td>
                                        <td class="num"><t t-esc="s['qty']"/></td>
                                        <td class="num"><t t-esc="s['pct_str']"/></td>
                                        <td class="num"><t t-esc="s['contador_sum']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- Detalle de equipos (cabecera repetida por página) -->
                    <div class="wrap section">
                        <div class="sec-title">Detalle de equipos</div>
                        <table class="main">
                            <!-- Definimos anchos con colgroup para evitar desbordes -->
                            <colgroup>
                                <col class="w-date"/>
                                <col class="w-marca"/>
                                <col class="w-modelo"/>
                                <col class="w-serie"/>
                                <col class="w-estado"/>
                                <col class="w-total"/>
                                <col class="w-info"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th class="w-date nowrap">Fecha</th>
                                    <th class="w-marca">Marca</th>
                                    <th class="w-modelo">Modelo</th>
                                    <th class="w-serie">Serie</th>
                                    <th class="w-estado">Estado</th>
                                    <th class="w-total num">Total contómetro</th>
                                    <th class="w-info">Informe técnico</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs" t-as="r">
                                    <tr>
                                        <td class="nowrap"><t t-esc="(r.fecha_generacion or '')"/></td>
                                        <td><t t-esc="(r.marca or '')"/></td>
                                        <td><t t-esc="(r.modelo or '')"/></td>
                                        <td class="nowrap"><t t-esc="(r.serie or '')"/></td>
                                        <td>
                                            <span class="badge"
                                                  t-att-class="'badge ' + (estado_badges.get(r.estado_maquina,'b-info'))">
                                                <t t-esc="estado_labels.get(r.id) or r.estado_maquina"/>
                                            </span>
                                        </td>
                                        <td class="num"><t t-esc="(r.contador_total or 0)"/></td>
                                        <td><t t-esc="informes_limpios.get(r.id) or ''"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <div class="tiny wrap" style="margin-top:8px;">
                        Generado automáticamente por SAT · Odoo 18
                    </div>
                </div>

            </t>
        </t>
    </template>

</odoo>

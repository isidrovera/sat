<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formato de papel A4 apaisado mejorado -->
    <record id="paperformat_landscape_a4" model="report.paperformat">
        <field name="name">A4 Landscape SAT Premium</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Acción del reporte PDF -->
    <record id="action_reporte_estado_maquinas_pdf" model="ir.actions.report">
        <field name="name">📊 Reporte Estado de Máquinas</field>
        <field name="model">reporte.estado.maquina</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sat.reporte_estado_maquinas_premium_pdf</field>
        <field name="report_file">sat.reporte_estado_maquinas_premium_pdf</field>
        <field name="paperformat_id" ref="sat.paperformat_landscape_a4"/>
        <field name="print_report_name">
            'Reporte_Estado_Maquinas_%s_%s' % (
                (object.semana_reporte or 'S').replace('/', '_'),
                (object.fecha_generacion.strftime('%Y%m%d') if object.fecha_generacion else 'Sin_Fecha')
            )
        </field>
        <field name="binding_type">report</field>
        <field name="attachment_use" eval="False"/>
    </record>

    <!-- Plantilla QWeb del PDF Premium -->
    <template id="reporte_estado_maquinas_premium_pdf" name="Reporte Premium Estado de Máquinas">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">

                    <!-- Variables computadas para mejor rendimiento -->
                    <t t-set="total_equipos" t-value="len(docs)"/>
                    <t t-set="fecha_actual" t-value="datetime.datetime.now().strftime('%d/%m/%Y %H:%M')"/>
                    
                    <!-- Estilos CSS mejorados y más modernos -->
                    <style>
                        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;display=swap');
                        
                        :root {
                            --primary: #2563eb;
                            --secondary: #64748b;
                            --success: #059669;
                            --warning: #d97706;
                            --danger: #dc2626;
                            --info: #0891b2;
                            
                            --gray-50: #f8fafc;
                            --gray-100: #f1f5f9;
                            --gray-200: #e2e8f0;
                            --gray-300: #cbd5e1;
                            --gray-400: #94a3b8;
                            --gray-500: #64748b;
                            --gray-600: #475569;
                            --gray-700: #334155;
                            --gray-800: #1e293b;
                            --gray-900: #0f172a;
                            
                            --radius: 8px;
                            --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
                            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
                        }

                        * { 
                            box-sizing: border-box; 
                            margin: 0; 
                            padding: 0; 
                        }

                        body { 
                            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                            font-size: 12px;
                            line-height: 1.5;
                            color: var(--gray-700);
                            background: #fff;
                        }

                        .page {
                            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
                            min-height: 100vh;
                            padding: 0;
                        }

                        /* Header mejorado */
                        .report-header {
                            background: linear-gradient(135deg, var(--primary) 0%, #1d4ed8 100%);
                            color: white;
                            padding: 20px;
                            border-radius: var(--radius) var(--radius) 0 0;
                            box-shadow: var(--shadow-lg);
                            position: relative;
                            overflow: hidden;
                        }

                        .report-header::before {
                            content: '';
                            position: absolute;
                            top: -50%;
                            right: -50%;
                            width: 200%;
                            height: 200%;
                            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
                            animation: float 6s ease-in-out infinite;
                        }

                        @keyframes float {
                            0%, 100% { transform: translateY(0px) rotate(0deg); }
                            50% { transform: translateY(-10px) rotate(180deg); }
                        }

                        .report-title {
                            font-size: 24px;
                            font-weight: 700;
                            margin-bottom: 8px;
                            display: flex;
                            align-items: center;
                            gap: 12px;
                        }

                        .report-subtitle {
                            font-size: 14px;
                            opacity: 0.9;
                            display: flex;
                            justify-content: space-between;
                            align-items: center;
                        }

                        /* KPIs mejorados con iconos y animaciones */
                        .kpis-container {
                            display: grid;
                            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                            gap: 16px;
                            margin: 20px 0;
                            padding: 0 20px;
                        }

                        .kpi-card {
                            background: white;
                            border-radius: var(--radius);
                            padding: 18px;
                            box-shadow: var(--shadow);
                            border-left: 4px solid var(--primary);
                            transition: all 0.3s ease;
                            position: relative;
                            overflow: hidden;
                        }

                        .kpi-card::before {
                            content: '';
                            position: absolute;
                            top: 0;
                            left: 0;
                            right: 0;
                            height: 2px;
                            background: linear-gradient(90deg, var(--primary), var(--info));
                        }

                        .kpi-card:hover {
                            transform: translateY(-2px);
                            box-shadow: var(--shadow-lg);
                        }

                        .kpi-label {
                            font-size: 11px;
                            color: var(--gray-500);
                            font-weight: 500;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                            margin-bottom: 8px;
                        }

                        .kpi-value {
                            font-size: 28px;
                            font-weight: 700;
                            color: var(--gray-800);
                            display: flex;
                            align-items: center;
                            gap: 8px;
                        }

                        .kpi-subtitle {
                            font-size: 10px;
                            color: var(--gray-400);
                            margin-top: 4px;
                        }

                        /* Estado global mejorado */
                        .status-card {
                            margin: 20px;
                            border-radius: var(--radius);
                            padding: 20px;
                            text-align: center;
                            position: relative;
                            overflow: hidden;
                        }

                        .status-excellent { 
                            background: linear-gradient(135deg, #dcfce7, #bbf7d0);
                            border: 2px solid var(--success);
                            color: #065f46;
                        }
                        .status-good { 
                            background: linear-gradient(135deg, #fef3c7, #fde68a);
                            border: 2px solid var(--warning);
                            color: #92400e;
                        }
                        .status-regular { 
                            background: linear-gradient(135deg, #fed7aa, #fdba74);
                            border: 2px solid #ea580c;
                            color: #9a3412;
                        }
                        .status-poor { 
                            background: linear-gradient(135deg, #fecaca, #fca5a5);
                            border: 2px solid var(--danger);
                            color: #991b1b;
                        }

                        .status-text {
                            font-size: 18px;
                            font-weight: 700;
                            margin-bottom: 4px;
                        }

                        .status-detail {
                            font-size: 12px;
                            opacity: 0.8;
                        }

                        /* Tablas mejoradas */
                        .section {
                            margin: 20px;
                            background: white;
                            border-radius: var(--radius);
                            box-shadow: var(--shadow);
                            overflow: hidden;
                        }

                        .section-header {
                            background: var(--gray-50);
                            padding: 16px 20px;
                            border-bottom: 1px solid var(--gray-200);
                        }

                        .section-title {
                            font-size: 16px;
                            font-weight: 600;
                            color: var(--gray-800);
                            display: flex;
                            align-items: center;
                            gap: 8px;
                        }

                        .table-container {
                            overflow-x: auto;
                        }

                        table.modern-table {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 11px;
                        }

                        .modern-table thead th {
                            background: var(--gray-800);
                            color: white;
                            padding: 12px 10px;
                            text-align: left;
                            font-weight: 600;
                            font-size: 10px;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                        }

                        .modern-table tbody tr {
                            border-bottom: 1px solid var(--gray-200);
                            transition: background-color 0.2s ease;
                        }

                        .modern-table tbody tr:nth-child(even) {
                            background: var(--gray-50);
                        }

                        .modern-table tbody tr:hover {
                            background: var(--gray-100);
                        }

                        .modern-table tbody td {
                            padding: 10px;
                            vertical-align: middle;
                        }

                        /* Badges mejorados */
                        .badge {
                            display: inline-flex;
                            align-items: center;
                            gap: 4px;
                            padding: 4px 10px;
                            border-radius: 12px;
                            font-size: 10px;
                            font-weight: 600;
                            text-transform: uppercase;
                            letter-spacing: 0.3px;
                        }

                        .badge-success { background: var(--success); color: white; }
                        .badge-warning { background: var(--warning); color: white; }
                        .badge-danger { background: var(--danger); color: white; }
                        .badge-info { background: var(--info); color: white; }

                        /* Progreso visual */
                        .progress-bar {
                            height: 6px;
                            background: var(--gray-200);
                            border-radius: 3px;
                            overflow: hidden;
                            margin-top: 8px;
                        }

                        .progress-fill {
                            height: 100%;
                            background: linear-gradient(90deg, var(--primary), var(--info));
                            transition: width 0.3s ease;
                        }

                        /* Footer */
                        .report-footer {
                            text-align: center;
                            padding: 20px;
                            color: var(--gray-500);
                            font-size: 10px;
                            border-top: 1px solid var(--gray-200);
                            background: var(--gray-50);
                        }

                        /* Responsive */
                        @media print {
                            .kpis-container {
                                grid-template-columns: repeat(4, 1fr);
                            }
                        }

                        /* Iconos usando Unicode */
                        .icon::before {
                            margin-right: 6px;
                        }
                        .icon-chart::before { content: "📊"; }
                        .icon-machine::before { content: "🔧"; }
                        .icon-status::before { content: "📈"; }
                        .icon-detail::before { content: "📋"; }
                        .icon-time::before { content: "⏰"; }
                        .icon-company::before { content: "🏢"; }
                    </style>

                    <div class="page">
                        <!-- Header Premium -->
                        <div class="report-header">
                            <div class="report-title">
                                <span class="icon-chart"></span>
                                Reporte Ejecutivo - Estado de Máquinas
                            </div>
                            <div class="report-subtitle">
                                <div>
                                    <span class="icon-company"></span>
                                    <t t-esc="company.display_name or 'SAT Company'"/>
                                </div>
                                <div>
                                    <span class="icon-time"></span>
                                    <t t-esc="fecha_actual"/>
                                </div>
                            </div>
                        </div>

                        <!-- KPIs mejorados -->
                        <div class="kpis-container">
                            <div class="kpi-card">
                                <div class="kpi-label">Total Equipos</div>
                                <div class="kpi-value">
                                    <t t-esc="kpis.get('total', 0)"/>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: 100%;"></div>
                                </div>
                            </div>

                            <div class="kpi-card">
                                <div class="kpi-label">Equipos Operativos</div>
                                <div class="kpi-value">
                                    <t t-esc="kpis.get('operativos', 0)"/>
                                </div>
                                <div class="kpi-subtitle">
                                    <t t-esc="kpis.get('pct_operativos_str', '0%')"/>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill" t-att-style="'width: ' + str(kpis.get('pct_operativos', 0)) + '%;'"></div>
                                </div>
                            </div>

                            <div class="kpi-card">
                                <div class="kpi-label">Con Problemas</div>
                                <div class="kpi-value">
                                    <t t-esc="kpis.get('problemas', 0)"/>
                                </div>
                                <div class="kpi-subtitle">Requieren atención</div>
                            </div>

                            <div class="kpi-card">
                                <div class="kpi-label">Sin Revisar</div>
                                <div class="kpi-value">
                                    <t t-esc="kpis.get('sin_revisar', 0)"/>
                                </div>
                                <div class="kpi-subtitle">Pendientes de inspección</div>
                            </div>
                        </div>

                        <!-- Estado Global -->
                        <t t-set="status_class">
                            <t t-if="kpis.get('estado_global') == 'excelente'">status-excellent</t>
                            <t t-elif="kpis.get('estado_global') == 'bueno'">status-good</t>
                            <t t-elif="kpis.get('estado_global') == 'regular'">status-regular</t>
                            <t t-else="">status-poor</t>
                        </t>

                        <div t-att-class="'status-card ' + status_class">
                            <div class="status-text">
                                <t t-esc="kpis.get('badge_text', 'Estado no definido')"/>
                            </div>
                            <div class="status-detail">
                                Operativos: <t t-esc="kpis.get('pct_operativos_str', '0%')"/> del total
                            </div>
                        </div>

                        <!-- Distribución por Estados -->
                        <div class="section">
                            <div class="section-header">
                                <div class="section-title">
                                    <span class="icon-status"></span>
                                    Distribución por Estados
                                </div>
                            </div>
                            <div class="table-container">
                                <table class="modern-table">
                                    <thead>
                                        <tr>
                                            <th>Estado</th>
                                            <th style="text-align: right;">Cantidad</th>
                                            <th style="text-align: right;">Porcentaje</th>
                                            <th style="text-align: right;">Contómetro Total</th>
                                            <th style="text-align: center;">Tendencia</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="by_state or []" t-as="s">
                                            <tr>
                                                <td>
                                                    <strong t-esc="s.get('label', 'N/A')"/>
                                                </td>
                                                <td style="text-align: right;">
                                                    <t t-esc="s.get('qty', 0)"/>
                                                </td>
                                                <td style="text-align: right;">
                                                    <t t-esc="s.get('pct_str', '0%')"/>
                                                </td>
                                                <td style="text-align: right;">
                                                    <t t-esc="'{:,}'.format(s.get('contador_sum', 0))"/>
                                                </td>
                                                <td style="text-align: center;">
                                                    <div class="progress-bar" style="width: 60px; margin: 0 auto;">
                                                        <div class="progress-fill" t-att-style="'width: ' + str(min(s.get('qty', 0) * 10, 100)) + '%;'"></div>
                                                    </div>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Detalle de Equipos -->
                        <div class="section">
                            <div class="section-header">
                                <div class="section-title">
                                    <span class="icon-detail"></span>
                                    Detalle de Equipos (<t t-esc="len(docs)"/> registros)
                                </div>
                            </div>
                            <div class="table-container">
                                <table class="modern-table">
                                    <thead>
                                        <tr>
                                            <th>Fecha</th>
                                            <th>Marca</th>
                                            <th>Modelo</th>
                                            <th>N° Serie</th>
                                            <th style="text-align: center;">Estado</th>
                                            <th style="text-align: right;">Contómetro</th>
                                            <th>Informe Técnico</th>
                                            <th style="text-align: center;">Prioridad</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="docs" t-as="r">
                                            <tr>
                                                <td>
                                                    <t t-if="r.fecha_generacion">
                                                        <t t-esc="r.fecha_generacion"/>
                                                    </t>
                                                    <t t-else="">Sin fecha</t>
                                                </td>
                                                <td>
                                                    <strong t-esc="r.marca or 'N/A'"/>
                                                </td>
                                                <td t-esc="r.modelo or 'N/A'"/>
                                                <td>
                                                    <code style="background: var(--gray-100); padding: 2px 6px; border-radius: 4px; font-size: 10px;">
                                                        <t t-esc="r.serie or 'N/A'"/>
                                                    </code>
                                                </td>
                                                <td style="text-align: center;">
                                                    <t t-set="badge_class">
                                                        <t t-if="estado_badges_data.get(r.estado_maquina) == 'b-ok'">badge-success</t>
                                                        <t t-elif="estado_badges_data.get(r.estado_maquina) == 'b-warn'">badge-warning</t>
                                                        <t t-elif="estado_badges_data.get(r.estado_maquina) == 'b-bad'">badge-danger</t>
                                                        <t t-else="">badge-info</t>
                                                    </t>
                                                    <span t-att-class="'badge ' + badge_class">
                                                        <t t-esc="estado_labels_data.get(r.id) or r.estado_maquina or 'N/A'"/>
                                                    </span>
                                                </td>
                                                <td style="text-align: right;">
                                                    <strong t-esc="r.contador_total or 0"/>
                                                </td>
                                                <td>
                                                    <div style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                                         t-att-title="informes_limpios_data.get(r.id) or ''">
                                                        <t t-esc="informes_limpios_data.get(r.id) or 'Sin informe'"/>
                                                    </div>
                                                </td>
                                                <td style="text-align: center;">
                                                    <t t-if="r.estado_maquina in ['problemas', 'partes']">
                                                        <span style="color: var(--danger); font-weight: bold;">🚨 Alta</span>
                                                    </t>
                                                    <t t-elif="r.estado_maquina == 'sin_revisar'">
                                                        <span style="color: var(--warning); font-weight: bold;">⚠️ Media</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span style="color: var(--success);">✅ Baja</span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="report-footer">
                            <div style="margin-bottom: 8px;">
                                <strong>SAT - Sistema de Administración Técnica</strong>
                            </div>
                            <div>
                                Generado automáticamente • Odoo 18 • 
                                <t t-esc="fecha_actual"/> • 
                                Página <span class="page">1</span> de <span class="topage">1</span>
                            </div>
                        </div>
                    </div>

                </t>
            </t>
        </t>
    </template>

    <!-- Template adicional para vista previa web (opcional) -->
    <template id="reporte_estado_maquinas_web_preview" name="Vista Previa Web">
        <div class="container-fluid mt-3">
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"/> Esta es una vista previa del reporte. 
                        <a href="#" class="btn btn-primary btn-sm ml-2">
                            <i class="fa fa-download"/> Descargar PDF
                        </a>
                    </div>
                </div>
            </div>
            <!-- Aquí iría el contenido de la vista previa -->
        </div>
    </template>

</odoo>
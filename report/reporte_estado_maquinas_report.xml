<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_reporte_estado_maquinas_pdf" model="ir.actions.report">
        <field name="name">Reporte de Estado de Máquinas</field>
        <field name="model">reporte.estado.maquina</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sat.reporte_estado_maquinas_pdf</field>
        <field name="report_file">sat.reporte_estado_maquinas_pdf</field>
        <!-- SIN paperformat_id -->
        <field name="print_report_name">
            'Reporte_Estado_Maquinas_%s' % (object.semana_reporte or object.fecha_generacion or '')
        </field>
        <field name="binding_type">report</field>
    </record>
    <!-- Plantilla QWeb -->
    <template id="reporte_estado_maquinas_pdf" name="Reporte Estado de Máquinas">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <!-- Helpers para URL absoluta y zona horaria -->
                <t t-set="base_url" t-value="env['ir.config_parameter'].sudo().get_param('web.base.url') or ''"/>
                <t t-set="tz" t-value="env.user.tz or 'UTC'"/>
                <!-- Estilo de tarjeta según estado global -->
                <t t-set="card_style">
                    <t t-if="kpis['estado_global'] == 'excelente'">border-color:#16a34a;background:#dcfce7</t>
                    <t t-elif="kpis['estado_global'] == 'bueno'">border-color:#f59e0b;background:#fef9c3</t>
                    <t t-elif="kpis['estado_global'] == 'regular'">border-color:#f97316;background:#ffedd5</t>
                    <t t-else="">border-color:#dc2626;background:#fee2e2</t>
                </t>
                <div class="page">
                    <style>
                        :root{
                            --ink:#0f172a; --muted:#64748b; --line:#e2e8f0;
                            --panel:#f8fafc; --zebra:#fbfdff;
                            --ok:#16a34a; --good:#3b82f6; --warn:#f59e0b; --attn:#f97316; --bad:#dc2626;
                            --thead:#0b1220; --theadText:#ffffff;
                        }
                        body { font-size:12px; line-height:1.28; color:var(--ink); }
                        h1,h2,h3 { margin:0; }
                        .wrap { padding:8px 6px; }
                        .tiny { font-size:10px; color:var(--muted); }
                        .muted { color:var(--muted); }
                        .sec-title { margin:12px 0 6px 0; font-weight:700; font-size:14px; }
                        .report-header { padding:6px 0 10px 0; border-bottom:1px solid var(--line); }

                        /* Botón-link para PDF */
                        .btn {
                            display:inline-block; padding:5px 10px; border-radius:6px;
                            border:1px solid var(--good); background:#eef6ff; color:#0b5ed7;
                            font-size:11px; font-weight:700; text-decoration:none;
                        }
                        .btn:hover { text-decoration:none; }

                        /* Badges */
                        .badge { display:inline-block; padding:3px 10px; border-radius:999px; font-size:11px; font-weight:700; color:#fff; }
                        .b-lista{background:var(--ok);} .b-revisada{background:var(--good);} .b-sin_revisar{background:var(--warn);}
                        .b-con_problemas{background:var(--attn);} .b-partes{background:var(--bad);}
                        .b-alquilada{background:#0ea5e9;} .b-externo{background:#8b5cf6;} .b-vendida{background:#6b7280;}

                        /* Tablas */
                        table.main { width:100%; border-collapse:collapse; table-layout:fixed; margin-top:8px; }
                        table.main thead { display: table-header-group; }
                        table.main th, table.main td {
                            border:1px solid var(--line); padding:6px 7px; vertical-align:top;
                            word-wrap:break-word; overflow-wrap:break-word; hyphens:auto;
                        }
                        table.main thead th { background:var(--thead); color:var(--theadText); font-weight:700; }
                        tbody tr:nth-child(odd) td { background:var(--zebra); }
                        .num { text-align:right; white-space:nowrap; }
                        .nowrap { white-space:nowrap; }

                        /* Anchos columna (ajustados para nuevas columnas) */
                        .w-marca{width:12%;}
                        .w-modelo{width:16%;}
                        .w-serie{width:16%;}
                        .w-total{width:12%;}
                        .w-creado{width:14%;}
                        .w-info{width:18%;}
                        .w-accion{width:12%;}

                        .no-break, tr { page-break-inside: avoid; break-inside: avoid; }
                        .page-break-before { page-break-before: always; break-before: page; }
                    </style>
                    <!-- Encabezado -->
                    <div class="report-header wrap no-break">
                        <h2 style="font-weight:800;">📊 Estado de Máquinas Alquiler</h2>
                        <div class="tiny">
                            Generado:
                            <t t-esc="date_print"/>
                        </div>
                    </div>
                    <!-- Distribución por estados (tabla de totales) -->
                    <div class="wrap">
                        <div class="sec-title">Distribución por estados</div>
                        <table class="main">
                            <thead>
                                <tr>
                                    <th>Estado</th>
                                    <th class="num">Cantidad</th>
                                    <th class="num">%</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="by_state" t-as="s" t-key="s['label']">
                                    <tr>
                                        <td>
                                            <t t-esc="s['label']"/>
                                        </td>
                                        <td class="num">
                                            <t t-esc="s['qty']"/>
                                        </td>
                                        <td class="num">
                                            <t t-esc="s['pct_str']"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <!-- Detalle de equipos: una TABLA por ESTADO -->
                    <div class="wrap">
                        <div class="sec-title">Detalle de equipos por estado</div>
                        <!-- Orden/etiquetas -->
                        <t t-set="estados_order"
                           t-value="[
                               ('lista','Lista'),
                               ('revisada','Revisada'),
                               ('sin_revisar','Sin Revisar'),
                               ('con_problemas','Con Problemas'),
                               ('partes','De Partes'),
                               ('alquilada','Alquilada'),
                               ('externo','Externo'),
                               ('vendida','Vendida')
                           ]"/>
                        <t t-set="primero" t-value="True"/>
                        <t t-foreach="estados_order" t-as="st">
                            <t t-set="code" t-value="st[0]"/>
                            <t t-set="label" t-value="st[1]"/>
                            <t t-set="rows" t-value="docs.filtered(lambda r: r.estado_maquina == code)"/>
                            <t t-if="rows">
                                <div t-attf-class="#{'' if primero else 'page-break-before'}"></div>
                                <t t-set="primero" t-value="False"/>
                                <div class="sec-title no-break" style="display:flex; align-items:center; gap:10px;">
                                    <span>
                                        <t t-esc="label"/>
                                    </span>
                                    <span class="badge" t-att-class="'badge b-' + (code.replace('_','-'))">
                                        <t t-esc="label"/> —
                                        <t t-esc="len(rows)"/> equipo(s)
                                    </span>
                                </div>
                                <table class="main">
                                    <colgroup>
                                        <col class="w-marca"/>
                                        <col class="w-modelo"/>
                                        <col class="w-serie"/>
                                        <col class="w-total"/>                                      
                                        <col class="w-info"/>
                                        <col class="w-accion"/>
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th class="w-marca">Marca</th>
                                            <th class="w-modelo">Modelo</th>
                                            <th class="w-serie">Serie</th>
                                            <th class="w-total num">Contómetro</th>                                            
                                            <th class="w-info">Informe técnico</th>
                                            <th class="w-accion">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="rows" t-as="r" t-key="r.id">
                                            <tr>
                                                <td>
                                                    <t t-esc="r.marca or ''"/>
                                                </td>
                                                <td>
                                                    <t t-esc="r.modelo or ''"/>
                                                </td>
                                                <td class="nowrap">
                                                    <t t-esc="r.serie or ''"/>
                                                </td>
                                                <td class="num">
                                                    <t t-esc="r.contador_total or 0"/>
                                                </td>                                                
                                                <!-- Informe técnico limpio (como ya lo tienes en informes_limpios) -->
                                                <td>
                                                    <t t-esc="informes_limpios.get(r.id) or ''"/>
                                                </td>
                                                <!-- Botón que abre el registro -->
                                                <td>
                                                    <a class="btn"
                                                        t-attf-href="#{base_url}/web#id=#{r.id}&amp;model=reporte.estado.maquina&amp;view_type=form"
                                                        target="_blank">Ver información
                                                    </a>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                        </t>
                    </div>
                    <div class="tiny wrap" style="margin-top:8px;">
                        Generado por Isidro
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
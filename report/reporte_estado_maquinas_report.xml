<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════
         PAPER FORMAT — A4 Horizontal
    ══════════════════════════════════════════════════════════════ -->
    <record id="paperformat_landscape_reporte_maquinas" model="report.paperformat">
        <field name="name">A4 Horizontal — Reporte Máquinas</field>
        <field name="default">False</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">3</field>
        <field name="dpi">96</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         ACCIÓN DE REPORTE
    ══════════════════════════════════════════════════════════════ -->
    <record id="action_reporte_estado_maquinas_pdf" model="ir.actions.report">
        <field name="name">Reporte de Estado de Máquinas</field>
        <field name="model">reporte.estado.maquina</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sat.reporte_estado_maquinas_pdf</field>
        <field name="report_file">sat.reporte_estado_maquinas_pdf</field>
        <field name="paperformat_id" ref="paperformat_landscape_reporte_maquinas"/>
        <field name="print_report_name">
            'Reporte_Estado_Maquinas_%s' % (object.semana_reporte or object.fecha_generacion or '')
        </field>
        <field name="binding_type">report</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         PLANTILLA QWEB
         IMPORTANTE: usa web.basic_layout (hoja limpia, sin header/footer
         de Odoo que desalinea el contenido)
    ══════════════════════════════════════════════════════════════ -->
    <template id="reporte_estado_maquinas_pdf" name="Reporte Estado de Máquinas">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">

                <t t-set="base_url" t-value="env['ir.config_parameter'].sudo().get_param('web.base.url') or ''"/>

                <style>
                    /* ── Reset total ─────────────────────────────────────────── */
                    * { box-sizing: border-box; margin: 0; padding: 0; }
                    body {
                        font-family: 'DejaVu Sans', Arial, sans-serif;
                        font-size: 11px;
                        line-height: 1.35;
                        color: #0f172a;
                        background: #fff;
                    }

                    /* ── Layout general ──────────────────────────────────────── */
                    .rpt-wrap { width: 100%; padding: 0; margin: 0; }

                    /* ── Encabezado principal ────────────────────────────────── */
                    .rpt-header {
                        background: #0f172a;
                        color: #fff;
                        padding: 10px 14px;
                        border-radius: 5px;
                        margin-bottom: 10px;
                        width: 100%;
                    }
                    .rpt-header table { width: 100%; border-collapse: collapse; }
                    .rpt-header td    { border: none; padding: 0; vertical-align: middle; }
                    .rpt-header h2    { font-size: 15px; font-weight: 800; color: #fff; }
                    .rpt-header .meta { font-size: 9px; color: #94a3b8; margin-top: 3px; }
                    .total-pill {
                        background: #f59e0b; color: #0f172a; font-weight: 800;
                        font-size: 12px; padding: 4px 14px; border-radius: 20px;
                        display: inline-block; white-space: nowrap;
                    }

                    /* ── Título de sección ───────────────────────────────────── */
                    .sec-title {
                        font-size: 10px; font-weight: 700; color: #64748b;
                        text-transform: uppercase; letter-spacing: 0.8px;
                        margin: 10px 0 5px 0; padding-left: 6px;
                        border-left: 3px solid #f59e0b;
                    }

                    /* ── KPIs ────────────────────────────────────────────────── */
                    table.kpi-grid {
                        width: 100%; border-collapse: separate; border-spacing: 4px;
                        table-layout: fixed; margin-bottom: 10px;
                    }
                    table.kpi-grid td {
                        border-radius: 5px; padding: 7px 4px 6px 4px;
                        text-align: center; vertical-align: middle;
                        border: 1.5px solid transparent;
                    }
                    .kpi-num { font-size: 24px; font-weight: 900; line-height: 1; display: block; }
                    .kpi-lbl { font-size: 8px; font-weight: 700; text-transform: uppercase;
                               letter-spacing: 0.5px; margin-top: 3px; display: block; }
                    .kpi-ico { font-size: 14px; display: block; margin-bottom: 1px; }

                    .kc-total  { background: #0f172a; color: #fff;    border-color: #0f172a; }
                    .kc-lista  { background: #dcfce7; color: #15803d; border-color: #15803d; }
                    .kc-rev    { background: #dbeafe; color: #1d4ed8; border-color: #1d4ed8; }
                    .kc-sr     { background: #fef3c7; color: #b45309; border-color: #b45309; }
                    .kc-cp     { background: #ffedd5; color: #c2410c; border-color: #c2410c; }
                    .kc-partes { background: #fee2e2; color: #b91c1c; border-color: #b91c1c; }
                    .kc-alq    { background: #e0f2fe; color: #0369a1; border-color: #0369a1; }
                    .kc-crit   { background: #fef2f2; color: #991b1b; border-color: #fca5a5; }

                    /* ── Tabla distribución ──────────────────────────────────── */
                    table.dist {
                        width: 100%; border-collapse: collapse;
                        margin-bottom: 10px; table-layout: fixed;
                    }
                    table.dist th {
                        background: #0f172a; color: #fff; font-size: 9px; font-weight: 700;
                        padding: 5px 8px; text-transform: uppercase; letter-spacing: 0.4px;
                        border-right: 1px solid #1e293b;
                    }
                    table.dist td {
                        padding: 5px 8px; border-bottom: 1px solid #e2e8f0;
                        font-size: 10px; vertical-align: middle;
                    }
                    table.dist tbody tr:nth-child(odd) td { background: #f8fafc; }

                    .bar-wrap {
                        background: #e2e8f0; border-radius: 3px; height: 5px;
                        width: 100%; overflow: hidden; margin-top: 2px;
                    }
                    .bar-fill { height: 5px; border-radius: 3px; background: #f59e0b; display: block; }

                    /* ── Badges ──────────────────────────────────────────────── */
                    .badge {
                        display: inline-block; padding: 2px 8px; border-radius: 999px;
                        font-size: 9px; font-weight: 700; color: #fff; white-space: nowrap;
                    }
                    .b-lista         { background: #15803d; }
                    .b-revisada      { background: #1d4ed8; }
                    .b-sin_revisar   { background: #b45309; }
                    .b-con_problemas { background: #c2410c; }
                    .b-partes        { background: #b91c1c; }
                    .b-alquilada     { background: #0369a1; }
                    .b-externo       { background: #7c3aed; }
                    .b-vendida       { background: #475569; }
                    .badge-tecnico   { background: #15803d; font-size: 9px; padding: 2px 6px; }
                    .badge-bodega    { background: #1d4ed8; font-size: 9px; padding: 2px 6px; }

                    /* ── Barra de grupo de estado ────────────────────────────── */
                    .grupo-bar {
                        padding: 5px 10px; border-radius: 4px 4px 0 0;
                        margin-top: 12px; width: 100%;
                    }
                    .grupo-bar table { width: 100%; border-collapse: collapse; }
                    .grupo-bar td    { border: none; padding: 0; vertical-align: middle; }
                    .grupo-cnt       { color: #fff; font-size: 9px; opacity: 0.8; text-align: right; }

                    .bar-lista         { background: #14532d; }
                    .bar-revisada      { background: #1e3a8a; }
                    .bar-sin_revisar   { background: #78350f; }
                    .bar-con_problemas { background: #7c2d12; }
                    .bar-partes        { background: #7f1d1d; }
                    .bar-alquilada     { background: #0c4a6e; }
                    .bar-externo       { background: #4c1d95; }
                    .bar-vendida       { background: #1e293b; }

                    /* ── Tabla principal equipos ─────────────────────────────── */
                    table.main {
                        width: 100%; border-collapse: collapse;
                        table-layout: fixed; border: 1px solid #dde3ec; margin-bottom: 0;
                    }
                    table.main thead th {
                        background: #0f172a; color: #fff; font-size: 9px; font-weight: 700;
                        padding: 5px 7px; text-transform: uppercase; letter-spacing: 0.3px;
                        border-right: 1px solid #1e293b;
                    }
                    table.main td {
                        border: 1px solid #e2e8f0; padding: 5px 7px;
                        vertical-align: top; word-wrap: break-word;
                        overflow-wrap: break-word; font-size: 10px;
                    }
                    table.main tbody tr:nth-child(odd) td  { background: #fafbfd; }
                    table.main tbody tr:nth-child(even) td { background: #ffffff; }

                    .w-marca  { width: 9%;  }
                    .w-modelo { width: 13%; }
                    .w-serie  { width: 11%; }
                    .w-tipo   { width: 7%;  }
                    .w-ubic   { width: 8%;  }
                    .w-cont   { width: 8%;  }
                    .w-info   { width: 30%; }
                    .w-accion { width: 8%;  }

                    /* ── Contexto partes retiradas ───────────────────────────── */
                    .partes-ctx {
                        background: #1e3a5f; color: #fff;
                        padding: 5px 10px; font-size: 10px; font-weight: 700;
                        letter-spacing: 0.2px; border-left: 4px solid #f59e0b; width: 100%;
                    }
                    .partes-ctx table { width: 100%; border-collapse: collapse; }
                    .partes-ctx td    { border: none; padding: 0; vertical-align: middle; }
                    .partes-ref {
                        background: rgba(255,255,255,0.13); border-radius: 3px;
                        padding: 2px 9px; font-size: 11px; margin-left: 6px;
                    }
                    .partes-cnt { color: #94a3b8; font-weight: 400; font-size: 9px; margin-left: 6px; }

                    /* ── Sub-tabla partes ────────────────────────────────────── */
                    table.partes { width: 100%; border-collapse: collapse; font-size: 10px; }
                    table.partes thead th {
                        background: #263550; color: #cbd5e1; font-size: 8px; font-weight: 700;
                        padding: 4px 7px; text-transform: uppercase; letter-spacing: 0.3px;
                        border-right: 1px solid #1e3a5f;
                    }
                    table.partes td {
                        padding: 3px 7px; border-bottom: 1px solid #e8edf4;
                        border-right: 1px solid #e8edf4; vertical-align: top;
                    }
                    table.partes tbody tr:nth-child(odd)  td { background: #fffbeb; }
                    table.partes tbody tr:nth-child(even) td { background: #fef9e7; }

                    .wp-parte   { width: 25%; }
                    .wp-desc    { width: 22%; }
                    .wp-fecha   { width: 11%; }
                    .wp-estado  { width: 10%; }
                    .wp-destino { width: 17%; }
                    .wp-fuente  { width: 15%; }

                    td.partes-cell {
                        padding: 0 !important; border-top: none !important;
                        background: #eef2f7 !important;
                    }

                    /* ── Botón enlace ────────────────────────────────────────── */
                    .btn-ver {
                        display: inline-block; padding: 3px 7px; border-radius: 3px;
                        border: 1px solid #1d4ed8; background: #eff6ff; color: #1d4ed8;
                        font-size: 8px; font-weight: 700; text-decoration: none; white-space: nowrap;
                    }

                    /* ── Utilidades ──────────────────────────────────────────── */
                    .bold   { font-weight: 700; }
                    .small  { font-size: 9px; }
                    .muted  { color: #64748b; }
                    .num    { text-align: right; white-space: nowrap; }
                    .center { text-align: center; }
                    .nowrap { white-space: nowrap; }

                    /* ── Pie de página ───────────────────────────────────────── */
                    .rpt-footer {
                        margin-top: 12px; padding-top: 5px;
                        border-top: 1px solid #e2e8f0;
                        font-size: 8px; color: #94a3b8; width: 100%;
                    }
                    .rpt-footer table { width: 100%; border-collapse: collapse; }
                    .rpt-footer td    { border: none; padding: 0; vertical-align: middle; }

                    /* ── Control de páginas ──────────────────────────────────── */
                    .no-break          { page-break-inside: avoid; break-inside: avoid; }
                    tr                 { page-break-inside: avoid; break-inside: avoid; }
                    .page-break-before { page-break-before: always; break-before: page; }
                </style>

                <div class="rpt-wrap">

                    <!-- ════════════════════════════════════════════════
                         ENCABEZADO
                    ════════════════════════════════════════════════ -->
                    <div class="rpt-header no-break">
                        <table>
                            <tr>
                                <td>
                                    <h2>📊 Reporte de Estado de Máquinas — Inventario Alquiler</h2>
                                    <div class="meta">
                                        Generado: <t t-esc="date_print"/>
                                        &#160;·&#160; Sistema: Andes Solution Copiers
                                    </div>
                                </td>
                                <td style="text-align:right; width:28%;">
                                    <span class="total-pill">
                                        <t t-esc="len(docs)"/> equipos en reporte
                                    </span>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- ════════════════════════════════════════════════
                         KPIs
                    ════════════════════════════════════════════════ -->
                    <t t-set="total"          t-value="len(docs)"/>
                    <t t-set="total_lista"    t-value="len(docs.filtered(lambda r: r.estado_maquina == 'lista'))"/>
                    <t t-set="total_revisada" t-value="len(docs.filtered(lambda r: r.estado_maquina == 'revisada'))"/>
                    <t t-set="total_sr"       t-value="len(docs.filtered(lambda r: r.estado_maquina == 'sin_revisar'))"/>
                    <t t-set="total_cp"       t-value="len(docs.filtered(lambda r: r.estado_maquina == 'con_problemas'))"/>
                    <t t-set="total_partes"   t-value="len(docs.filtered(lambda r: r.estado_maquina == 'partes'))"/>
                    <t t-set="total_alq"      t-value="len(docs.filtered(lambda r: r.estado_maquina == 'alquilada'))"/>
                    <t t-set="total_criticos" t-value="total_cp + total_partes"/>

                    <div class="sec-title">Resumen Ejecutivo del Inventario</div>
                    <table class="kpi-grid no-break">
                        <tr>
                            <td class="kc-total">
                                <span class="kpi-ico">🏭</span>
                                <span class="kpi-num"><t t-esc="total"/></span>
                                <span class="kpi-lbl">Total Equipos</span>
                            </td>
                            <td class="kc-lista">
                                <span class="kpi-ico">✅</span>
                                <span class="kpi-num"><t t-esc="total_lista"/></span>
                                <span class="kpi-lbl">Listas p/ Alquilar</span>
                            </td>
                            <td class="kc-rev">
                                <span class="kpi-ico">🔵</span>
                                <span class="kpi-num"><t t-esc="total_revisada"/></span>
                                <span class="kpi-lbl">Revisadas</span>
                            </td>
                            <td class="kc-sr">
                                <span class="kpi-ico">⏳</span>
                                <span class="kpi-num"><t t-esc="total_sr"/></span>
                                <span class="kpi-lbl">Pend. Revisión</span>
                            </td>
                            <td class="kc-cp">
                                <span class="kpi-ico">⚠️</span>
                                <span class="kpi-num"><t t-esc="total_cp"/></span>
                                <span class="kpi-lbl">Con Problemas</span>
                            </td>
                            <td class="kc-partes">
                                <span class="kpi-ico">🔩</span>
                                <span class="kpi-num"><t t-esc="total_partes"/></span>
                                <span class="kpi-lbl">De Partes</span>
                            </td>
                            <td class="kc-alq">
                                <span class="kpi-ico">📋</span>
                                <span class="kpi-num"><t t-esc="total_alq"/></span>
                                <span class="kpi-lbl">En Servicio</span>
                            </td>
                            <td class="kc-crit">
                                <span class="kpi-ico">🚨</span>
                                <span class="kpi-num"><t t-esc="total_criticos"/></span>
                                <span class="kpi-lbl">Total Críticos</span>
                            </td>
                        </tr>
                    </table>

                    <!-- ════════════════════════════════════════════════
                         DISTRIBUCIÓN
                    ════════════════════════════════════════════════ -->
                    <div class="sec-title">Distribución por Estados</div>
                    <table class="dist no-break">
                        <colgroup>
                            <col style="width:30%;"/>
                            <col style="width:12%;"/>
                            <col style="width:12%;"/>
                            <col style="width:46%;"/>
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Estado</th>
                                <th class="num">Cantidad</th>
                                <th class="num">Porcentaje</th>
                                <th>Distribución visual</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="by_state" t-as="s" t-key="s['label']">
                                <tr>
                                    <td class="bold"><t t-esc="s['label']"/></td>
                                    <td class="num bold"><t t-esc="s['qty']"/></td>
                                    <td class="num"><t t-esc="s['pct_str']"/></td>
                                    <td style="vertical-align:middle; padding-top:7px;">
                                        <div class="bar-wrap">
                                            <span class="bar-fill"
                                                  t-attf-style="width:#{s['pct_str']};"/>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- ════════════════════════════════════════════════
                         DETALLE POR ESTADO
                    ════════════════════════════════════════════════ -->
                    <div class="sec-title" style="margin-top:14px;">Detalle de Equipos por Estado</div>

                    <t t-set="estados_order" t-value="[
                        ('lista',         'Lista — Disponible para alquilar'),
                        ('revisada',      'Revisada — En preparación'),
                        ('sin_revisar',   'Sin Revisar — Pendiente de evaluación'),
                        ('con_problemas', 'Con Problemas — Requiere atención'),
                        ('partes',        'De Partes — Solo para repuestos'),
                        ('alquilada',     'Alquilada — En servicio con cliente'),
                        ('externo',       'Externo'),
                        ('vendida',       'Vendida')
                    ]"/>

                    <t t-set="primero" t-value="True"/>
                    <t t-foreach="estados_order" t-as="st">
                        <t t-set="code"  t-value="st[0]"/>
                        <t t-set="label" t-value="st[1]"/>
                        <t t-set="rows"  t-value="docs.filtered(lambda r: r.estado_maquina == code)"/>

                        <t t-if="rows">
                            <div t-attf-class="#{'' if primero else 'page-break-before'}"/>
                            <t t-set="primero" t-value="False"/>

                            <!-- Barra de grupo -->
                            <div class="grupo-bar no-break"
                                 t-att-class="'grupo-bar bar-' + code">
                                <table>
                                    <tr>
                                        <td>
                                            <span class="badge" t-att-class="'badge b-' + code"
                                                  style="font-size:10px; padding:3px 12px;">
                                                <t t-esc="label"/>
                                            </span>
                                        </td>
                                        <td class="grupo-cnt">
                                            <t t-esc="len(rows)"/> equipo(s)
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Tabla equipos -->
                            <table class="main">
                                <colgroup>
                                    <col class="w-marca"/>
                                    <col class="w-modelo"/>
                                    <col class="w-serie"/>
                                    <col class="w-tipo"/>
                                    <col class="w-ubic"/>
                                    <col class="w-cont"/>
                                    <col class="w-info"/>
                                    <col class="w-accion"/>
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>Marca</th>
                                        <th>Modelo</th>
                                        <th>Serie</th>
                                        <th class="center">Tipo</th>
                                        <th>Ubicación</th>
                                        <th class="num">Contómetro</th>
                                        <th>Informe Técnico</th>
                                        <th class="center">Ver</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="rows" t-as="r" t-key="r.id">

                                        <!-- Fila principal equipo -->
                                        <tr class="no-break">
                                            <td class="bold">
                                                <t t-esc="r.marca or ''"/>
                                            </td>
                                            <td>
                                                <t t-esc="r.modelo or ''"/>
                                            </td>
                                            <td class="bold nowrap"
                                                style="color:#1e3a5f; font-size:11px;">
                                                <t t-esc="r.serie or ''"/>
                                            </td>
                                            <td class="center small">
                                                <t t-if="r.tipo_maquina == 'color'">🎨 Color</t>
                                                <t t-elif="r.tipo_maquina == 'monocromatica'">⬛ Mono</t>
                                                <t t-else="">—</t>
                                            </td>
                                            <td class="small">
                                                <t t-if="r.ubicacion_fisica == 'primer_piso'">1° Piso</t>
                                                <t t-elif="r.ubicacion_fisica == 'tercer_piso'">3° Piso</t>
                                                <t t-elif="r.ubicacion_fisica == 'segundo_local'">2° Local</t>
                                                <t t-elif="r.ubicacion_fisica == 'covida'">Covida</t>
                                                <t t-else="">—</t>
                                            </td>
                                            <td class="num bold" style="font-size:11px;">
                                                <t t-esc="'{:,}'.format(r.contador_total or 0)"/>
                                            </td>
                                            <td style="font-size:9px; line-height:1.3;">
                                                <t t-esc="informes_limpios.get(r.id) or '—'"/>
                                            </td>
                                            <td class="center">
                                                <a class="btn-ver"
                                                   t-attf-href="#{base_url}/web#id=#{r.id}&amp;model=reporte.estado.maquina&amp;view_type=form"
                                                   target="_blank">Ver detalle</a>
                                            </td>
                                        </tr>

                                        <!-- Fila partes retiradas -->
                                        <t t-if="r.partes_retiradas_ids">
                                            <tr>
                                                <td class="partes-cell" colspan="8">

                                                    <!-- Cabecera de contexto -->
                                                    <div class="partes-ctx">
                                                        <table>
                                                            <tr>
                                                                <td>
                                                                    🔩 PARTES RETIRADAS DE:
                                                                    <span class="partes-ref">
                                                                        <t t-esc="r.marca or ''"/>
                                                                        &#160;
                                                                        <t t-esc="r.modelo or ''"/>
                                                                        &#160;—&#160;Serie:&#160;
                                                                        <t t-esc="r.serie or ''"/>
                                                                    </span>
                                                                    <span class="partes-cnt">
                                                                        (<t t-esc="len(r.partes_retiradas_ids)"/> parte(s))
                                                                    </span>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </div>

                                                    <!-- Sub-tabla -->
                                                    <table class="partes">
                                                        <thead>
                                                            <tr>
                                                                <th class="wp-parte">Parte / Componente</th>
                                                                <th class="wp-desc">Descripción</th>
                                                                <th class="wp-fecha">Fecha Solicitud</th>
                                                                <th class="wp-estado">Estado</th>
                                                                <th class="wp-destino">Instalada en (Serie)</th>
                                                                <th class="wp-fuente">Origen</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>

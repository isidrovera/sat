<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Modelo del asistente -->
    <record id="model_evaluacion_personal_envio_masivo" model="ir.model">
        <field name="name">Envío Masivo de Evaluaciones</field>
        <field name="model">evaluacion.personal.envio.masivo</field>
        <field name="arch" type="xml">
            <form string="Envío Masivo">
                <field name="name" class="oe_inline" readonly="1"/>
            </form>
        </field>
        <field name="rule_group_id" ref="base.group_system"/>
    </record>
    
    <!-- Vista del formulario del asistente -->
    <record id="view_evaluacion_personal_envio_masivo_form" model="ir.ui.view">
        <field name="name">evaluacion.personal.envio.masivo.form</field>
        <field name="model">evaluacion.personal.envio.masivo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Se enviarán reportes PDF de las evaluaciones seleccionadas.
                    </div>
                    <group>
                        <field name="email" placeholder="correo@ejemplo.com"/>
                        <field name="subject"/>
                    </group>
                    <group>
                        <field name="body" widget="html" options="{'style-inline': true}"/>
                    </group>
                    <group>
                        <field name="evaluacion_ids" widget="many2many_tags" options="{'no_create': true}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_enviar_reportes" string="Enviar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Acción para abrir el asistente -->
    <record id="action_evaluacion_personal_envio_masivo" model="ir.actions.act_window">
        <field name="name">Enviar Reportes por Correo</field>
        <field name="res_model">evaluacion.personal.envio.masivo</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_evaluacion_personal"/>
        <field name="binding_view_types">list</field>
    </record>
    
    <!-- Acción del servidor para el botón en la vista de lista -->
    <record id="ir_action_server_enviar_reportes_masivo" model="ir.actions.server">
        <field name="name">Enviar Reportes por Correo</field>
        <field name="model_id" ref="model_evaluacion_personal"/>
        <field name="binding_model_id" ref="model_evaluacion_personal"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = {
                'name': 'Enviar Reportes por Correo',
                'type': 'ir.actions.act_window',
                'res_model': 'evaluacion.personal.envio.masivo',
                'view_mode': 'form',
                'target': 'new',
                'context': {
                    'active_ids': env.context.get('active_ids', []),
                },
            }
        </field>
    </record>
    
    <!-- Enlace de menú para acceder al asistente (opcional) -->
    <record id="menu_action_evaluacion_personal_envio_masivo" model="ir.ui.menu">
        <field name="name">Enviar Reportes por Correo</field>
        <field name="parent_id" ref="sat_menu_root"/>
        <field name="action" ref="action_evaluacion_personal_envio_masivo"/>
        <field name="sequence" eval="20"/>
        <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
    </record>
    
    <!-- Configuración de seguridad para el nuevo modelo -->
    <record id="access_evaluacion_personal_envio_masivo" model="ir.model.access">
        <field name="name">evaluacion.personal.envio.masivo.access</field>
        <field name="model_id" ref="model_evaluacion_personal_envio_masivo"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
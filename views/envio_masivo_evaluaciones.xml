<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista para el asistente de envío masivo -->
    <record id="view_evaluacion_personal_envio_masivo_form" model="ir.ui.view">
        <field name="name">evaluacion.personal.envio.masivo.form</field>
        <field name="model">evaluacion.personal.envio.masivo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Se enviarán reportes PDF de las evaluaciones seleccionadas.
                    </div>
                    <group>
                        <field name="email" placeholder="correo@ejemplo.com"/>
                        <field name="subject"/>
                    </group>
                    <group>
                        <field name="body" widget="html" options="{'style-inline': true}"/>
                    </group>
                    <group>
                        <field name="evaluacion_ids" widget="many2many_tags" options="{'no_create': true}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_enviar_reportes" string="Enviar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Vista de lista personalizada (en lugar de heredar la existente) -->
    <record id="view_evaluacion_personal_list_con_boton" model="ir.ui.view">
        <field name="name">evaluacion.personal.list.con.boton</field>
        <field name="model">evaluacion.personal</field>
        <field name="arch" type="xml">
            <list default_order="fecha desc" 
                  decoration-danger="puntaje_total&lt;60"
                  decoration-warning="puntaje_total&lt;80" 
                  decoration-success="puntaje_total>=80"
                  decoration-muted="state=='borrador'">
                <header>
                    <button name="action_enviar_reportes_masivo" string="Enviar Reportes" type="object" class="btn-primary"/>
                </header>
                <field name="name" />
                <field name="fecha" />
                <field name="usuario_id" />
                <field name="cantidad_reparaciones" />
                <field name="objetivo_reparaciones" />
                <field name="porcentaje_reparaciones" widget="percentage" />
                <field name="cantidad_tickets" />
                <field name="objetivo_tickets" />
                <field name="porcentaje_tickets" widget="percentage" />
                <field name="puntaje_total" widget="progressbar" />
                <field name="nivel_desempeno" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <!-- Acción para el botón en la vista de lista -->
    <record id="action_evaluacion_personal_envio_masivo" model="ir.actions.act_window">
        <field name="name">Enviar Reportes por Correo</field>
        <field name="res_model">evaluacion.personal.envio.masivo</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_evaluacion_personal"/>
        <field name="binding_view_types">list</field>
    </record>
    
    <!-- Modificar la acción de ventana para usar nuestra vista personalizada -->
    <record id="evaluacion_personal.action_evaluacion_personal" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,pivot,graph</field>
        <field name="view_id" ref="view_evaluacion_personal_list_con_boton"/>
    </record>
    
    <!-- Configuración de seguridad para el nuevo modelo -->
    <record id="access_evaluacion_personal_envio_masivo" model="ir.model.access">
        <field name="name">evaluacion.personal.envio.masivo.access</field>
        <field name="model_id" ref="model_evaluacion_personal_envio_masivo"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
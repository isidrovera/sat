<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Assets -->
        <record id="equipment_blocking_dashboard_assets" model="ir.asset">
            <field name="name">Equipment Blocking Dashboard Assets</field>
            <field name="bundle">web.assets_backend</field>
            <field name="path">equipment_blocking/static/src/css/equipment_blocking.css</field>
        </record>
        
        <record id="equipment_blocking_dashboard_js" model="ir.asset">
            <field name="name">Equipment Blocking Dashboard JS</field>
            <field name="bundle">web.assets_backend</field>
            <field name="path">equipment_blocking/static/src/js/equipment_blocking.js</field>
        </record>

        <!-- Template principal del dashboard -->
        <template id="equipment_blocking_dashboard_template" name="Dashboard Bloqueo de Equipos">
            <t t-call="website.layout">
                <div id="wrap">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-12">
                                <!-- Header -->
                                <div class="card mt-4 mb-4 border-0 shadow-sm">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-shield-alt fa-2x text-primary me-3"></i>
                                            <div>
                                                <h1 class="h2 mb-1 fw-bold">Sistema de Bloqueo de Equipos</h1>
                                                <p class="text-muted mb-0">Gestión centralizada de estados de servicio y bloqueos remotos</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Dashboard Cards -->
                                <div class="row g-3 mb-4">
                                    <div class="col-xl-2 col-lg-4 col-md-6">
                                        <div class="card border-0 shadow-sm h-100 dashboard-card">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <h6 class="text-muted text-uppercase fw-bold small mb-2">Equipos Activos</h6>
                                                        <h2 class="h1 fw-bold mb-0" id="equipos-activos">
                                                            <t t-esc="dashboard_data.get('equipos_activos', 0)"/>
                                                        </h2>
                                                        <small class="text-success">
                                                            <i class="fas fa-arrow-up"></i> Funcionando normal
                                                        </small>
                                                    </div>
                                                    <div class="bg-success rounded-circle p-3">
                                                        <i class="fas fa-check-circle text-white fa-lg"></i>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-footer bg-success" style="height: 4px; padding: 0;"></div>
                                        </div>
                                    </div>

                                    <div class="col-xl-2 col-lg-4 col-md-6">
                                        <div class="card border-0 shadow-sm h-100 dashboard-card">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <h6 class="text-muted text-uppercase fw-bold small mb-2">Suspendidos</h6>
                                                        <h2 class="h1 fw-bold mb-0" id="equipos-suspendidos">
                                                            <t t-esc="dashboard_data.get('equipos_suspendidos', 0)"/>
                                                        </h2>
                                                        <small class="text-warning">
                                                            <i class="fas fa-exclamation-triangle"></i> Por mora
                                                        </small>
                                                    </div>
                                                    <div class="bg-warning rounded-circle p-3">
                                                        <i class="fas fa-pause-circle text-white fa-lg"></i>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-footer bg-warning" style="height: 4px; padding: 0;"></div>
                                        </div>
                                    </div>

                                    <div class="col-xl-2 col-lg-4 col-md-6">
                                        <div class="card border-0 shadow-sm h-100 dashboard-card">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <h6 class="text-muted text-uppercase fw-bold small mb-2">Bloqueados</h6>
                                                        <h2 class="h1 fw-bold mb-0" id="equipos-bloqueados">
                                                            <t t-esc="dashboard_data.get('equipos_bloqueados', 0)"/>
                                                        </h2>
                                                        <small class="text-danger">
                                                            <i class="fas fa-ban"></i> Acceso denegado
                                                        </small>
                                                    </div>
                                                    <div class="bg-danger rounded-circle p-3">
                                                        <i class="fas fa-lock text-white fa-lg"></i>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-footer bg-danger" style="height: 4px; padding: 0;"></div>
                                        </div>
                                    </div>

                                    <div class="col-xl-2 col-lg-4 col-md-6">
                                        <div class="card border-0 shadow-sm h-100 dashboard-card">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <h6 class="text-muted text-uppercase fw-bold small mb-2">No Accesibles</h6>
                                                        <h2 class="h1 fw-bold mb-0" id="equipos-no-accesibles">
                                                            <t t-esc="dashboard_data.get('equipos_no_accesibles', 0)"/>
                                                        </h2>
                                                        <small class="text-muted">
                                                            <i class="fas fa-tools"></i> Requiere manual
                                                        </small>
                                                    </div>
                                                    <div class="bg-secondary rounded-circle p-3">
                                                        <i class="fas fa-wifi-slash text-white fa-lg"></i>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-footer bg-secondary" style="height: 4px; padding: 0;"></div>
                                        </div>
                                    </div>

                                    <div class="col-xl-2 col-lg-4 col-md-6">
                                        <div class="card border-0 shadow-sm h-100 dashboard-card">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <h6 class="text-muted text-uppercase fw-bold small mb-2">Pend. Bloqueo</h6>
                                                        <h2 class="h1 fw-bold mb-0" id="pendientes-bloqueo">
                                                            <t t-esc="dashboard_data.get('pendientes_bloqueo', 0)"/>
                                                        </h2>
                                                        <small class="text-info">
                                                            <i class="fas fa-hourglass-half"></i> En proceso
                                                        </small>
                                                    </div>
                                                    <div class="bg-info rounded-circle p-3">
                                                        <i class="fas fa-clock text-white fa-lg"></i>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-footer bg-info" style="height: 4px; padding: 0;"></div>
                                        </div>
                                    </div>

                                    <div class="col-xl-2 col-lg-4 col-md-6">
                                        <div class="card border-0 shadow-sm h-100 dashboard-card">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <h6 class="text-muted text-uppercase fw-bold small mb-2">Pend. Desbloqueo</h6>
                                                        <h2 class="h1 fw-bold mb-0" id="pendientes-desbloqueo">
                                                            <t t-esc="dashboard_data.get('pendientes_desbloqueo', 0)"/>
                                                        </h2>
                                                        <small class="text-primary">
                                                            <i class="fas fa-sync-alt"></i> Restaurando
                                                        </small>
                                                    </div>
                                                    <div class="bg-primary rounded-circle p-3">
                                                        <i class="fas fa-unlock-alt text-white fa-lg"></i>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-footer bg-primary" style="height: 4px; padding: 0;"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Search Section -->
                                <div class="card mb-4 border-0 shadow-sm">
                                    <div class="card-body">
                                        <div class="row g-3 align-items-end">
                                            <div class="col-lg-6">
                                                <label for="search-input" class="form-label fw-bold">
                                                    <i class="fas fa-search me-2"></i>Buscar Equipos
                                                </label>
                                                <input type="text" id="search-input" class="form-control form-control-lg" 
                                                       placeholder="Buscar por serie, cliente, modelo o marca..." />
                                            </div>
                                            <div class="col-lg-6">
                                                <div class="d-flex gap-2 flex-wrap">
                                                    <button type="button" class="btn btn-primary btn-lg" onclick="searchEquipments()">
                                                        <i class="fas fa-search me-2"></i>Buscar
                                                    </button>
                                                    <button type="button" class="btn btn-success btn-lg" onclick="loadAllEquipments()">
                                                        <i class="fas fa-list me-2"></i>Ver Todos
                                                    </button>
                                                    <button type="button" class="btn btn-warning btn-lg" onclick="loadPendingEquipments()">
                                                        <i class="fas fa-exclamation-circle me-2"></i>Ver Pendientes
                                                    </button>
                                                    <button type="button" class="btn btn-info btn-lg" onclick="refreshDashboard()">
                                                        <i class="fas fa-sync-alt me-2"></i>Actualizar
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Results Section -->
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-light">
                                        <h4 class="mb-0">
                                            <i class="fas fa-list me-2"></i>Resultados de Búsqueda
                                        </h4>
                                    </div>
                                    <div class="card-body" id="equipment-results">
                                        <div class="text-center py-5">
                                            <i class="fas fa-search fa-3x text-muted mb-3"></i>
                                            <p class="text-muted">Utiliza el buscador para encontrar equipos o haz clic en "Ver Pendientes" para equipos que requieren atención.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal para acciones -->
                <div class="modal fade" id="actionModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="modalTitle">Acción en Equipo</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div id="modalAlert"></div>
                                <form id="actionForm">
                                    <div class="mb-3">
                                        <label for="motivoInput" class="form-label fw-bold">Motivo / Observaciones:</label>
                                        <textarea class="form-control" id="motivoInput" rows="3" 
                                                  placeholder="Describe el motivo de esta acción..."></textarea>
                                    </div>
                                    <div class="mb-3" id="equipmentDetails" style="display: none;">
                                        <div class="border rounded p-3 bg-light">
                                            <h6 class="fw-bold mb-2">Detalles del Equipo:</h6>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <small class="text-muted">Cliente:</small>
                                                    <div id="detailCliente" class="fw-bold"></div>
                                                </div>
                                                <div class="col-md-6">
                                                    <small class="text-muted">Modelo:</small>
                                                    <div id="detailModelo" class="fw-bold"></div>
                                                </div>
                                                <div class="col-md-6 mt-2">
                                                    <small class="text-muted">IP:</small>
                                                    <div id="detailIP"></div>
                                                </div>
                                                <div class="col-md-6 mt-2">
                                                    <small class="text-muted">Estado Actual:</small>
                                                    <div id="detailEstado"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="button" class="btn btn-primary" id="confirmActionBtn">
                                    <span id="btnLoading" class="d-none">
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        Procesando...
                                    </span>
                                    <span id="btnText">Confirmar</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- JavaScript inline para evitar problemas de carga -->
        <template id="equipment_blocking_dashboard_js_inline" name="Equipment Blocking JS Inline">
            <script type="text/javascript">
                // Funciones globales disponibles inmediatamente
                function searchEquipments() {
                    if (window.equipmentBlockingDashboard &amp;&amp; window.equipmentBlockingDashboard.searchEquipments) {
                        window.equipmentBlockingDashboard.searchEquipments();
                    }
                }
                
                function loadAllEquipments() {
                    if (window.equipmentBlockingDashboard &amp;&amp; window.equipmentBlockingDashboard.loadAllEquipments) {
                        window.equipmentBlockingDashboard.loadAllEquipments();
                    }
                }
                
                function loadPendingEquipments() {
                    if (window.equipmentBlockingDashboard &amp;&amp; window.equipmentBlockingDashboard.loadPendingEquipments) {
                        window.equipmentBlockingDashboard.loadPendingEquipments();
                    }
                }
                
                function refreshDashboard() {
                    if (window.equipmentBlockingDashboard &amp;&amp; window.equipmentBlockingDashboard.refreshDashboard) {
                        window.equipmentBlockingDashboard.refreshDashboard();
                    }
                }
                
                function openActionModal(action, equipmentId, serie, equipmentData) {
                    if (window.equipmentBlockingDashboard &amp;&amp; window.equipmentBlockingDashboard.openActionModal) {
                        window.equipmentBlockingDashboard.openActionModal(action, equipmentId, serie, equipmentData);
                    }
                }
            </script>
        </template>

        <!-- Template de error -->
        <template id="error_template" name="Error Template">
            <t t-call="website.layout">
                <div id="wrap">
                    <div class="container mt-5">
                        <div class="row justify-content-center">
                            <div class="col-md-6">
                                <div class="alert alert-danger text-center">
                                    <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                                    <h4>Error</h4>
                                    <p t-esc="error_message"/>
                                    <a href="/equipment/blocking/dashboard" class="btn btn-primary">
                                        <i class="fas fa-arrow-left me-2"></i>Volver al Dashboard
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
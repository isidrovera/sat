<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════
         Vista modal para ver foto de evidencia
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_ticket_evidencia_foto_form_modal" model="ir.ui.view">
        <field name="name">ticket.evidencia.foto.form.modal</field>
        <field name="model">ticket.evidencia.foto</field>
        <field name="arch" type="xml">
            <form string="Foto de evidencia" create="false" edit="false" delete="false">
                <sheet>

                    <group>
                        <group string="Datos de la evidencia">
                            <field name="ticket_id" readonly="1"/>
                            <field name="momento" readonly="1"/>
                            <field name="timestamp_captura" readonly="1"/>
                            <field name="imagen_original_filename" readonly="1"/>
                        </group>

                        <group string="Ubicación">
                            <field name="latitud" readonly="1"/>
                            <field name="longitud" readonly="1"/>
                            <field name="precision_gps" readonly="1"/>
                            <field name="tiene_coordenadas" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Imagen"/>

                    <div style="text-align:center; background:#f8fafc; padding:12px; border-radius:8px;">
                        <field name="imagen_original"
                               widget="image"
                               readonly="1"
                               nolabel="1"
                               options="{'size': [1400, 1000]}"/>
                    </div>

                    <separator string="Información técnica"/>

                    <group>
                        <field name="user_agent" readonly="1"/>
                        <field name="ip_origen" readonly="1"/>
                    </group>

                </sheet>

                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>


    <!-- ════════════════════════════════════════════════════════════════
         Herencia del formulario de ticket.alquiler
         Agrega pestaña Evidencia fotográfica
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_ticket_alquiler_form_evidencia" model="ir.ui.view">
        <field name="name">ticket.alquiler.form.evidencia</field>
        <field name="model">ticket.alquiler</field>
        <field name="inherit_id" ref="sat.soporte_form_viw"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="📸 Evidencia fotográfica" name="evidencia">

                    <group>
                        <group string="Acciones">
                            <button name="action_abrir_link_evidencia"
                                    type="object"
                                    string="🔗 Abrir link de subida"
                                    class="btn-primary"/>

                            <button name="action_copiar_link_evidencia"
                                    type="object"
                                    string="📋 Mostrar link"
                                    class="btn-secondary"/>

                            <button name="action_enviar_link_whatsapp_tecnico"
                                    type="object"
                                    string="📲 Enviar al técnico por WhatsApp"
                                    class="btn-success"
                                    invisible="not responsable"/>
                        </group>

                        <group string="Resumen">
                            <field name="evidencia_antes_count" readonly="1"/>
                            <field name="evidencia_despues_count" readonly="1"/>
                            <field name="evidencia_token" readonly="1" groups="base.group_no_one"/>
                        </group>
                    </group>


                    <!-- ════════════════════════════════════════════════
                         FOTOS ANTES
                         ════════════════════════════════════════════════ -->
                    <separator string="📷 Fotos antes (al llegar)"/>

                    <field name="evidencia_foto_ids"
                           domain="[('momento', '=', 'antes')]"
                           context="{'default_momento': 'antes'}"
                           mode="kanban"
                           nolabel="1">

                        <kanban records_draggable="0" create="1" edit="0" delete="0">
                            <field name="id"/>
                            <field name="imagen_original"/>
                            <field name="timestamp_captura"/>
                            <field name="latitud"/>
                            <field name="longitud"/>
                            <field name="precision_gps"/>
                            <field name="tiene_coordenadas"/>

                            <templates>
                                <t t-name="kanban-box">
                                    <div style="padding:8px; border:1px solid #d8dee4; border-radius:6px; background:white;">

                                        <button name="action_ver_foto"
                                                type="object"
                                                class="btn btn-link p-0"
                                                style="display:block; width:100%; border:0; background:transparent; padding:0; cursor:zoom-in;">
                                            <img t-att-src="kanban_image('ticket.evidencia.foto', 'imagen_original', record.id.raw_value)"
                                                 alt="Foto evidencia antes"
                                                 style="width:100%; height:140px; object-fit:cover; border-radius:6px; border:1px solid #e5e7eb;"/>
                                        </button>

                                        <div style="margin-top:6px; font-size:12px; color:#718096;">
                                            <field name="timestamp_captura"/>
                                        </div>

                                        <div style="font-size:11px; color:#a0aec0;"
                                             t-if="record.tiene_coordenadas.raw_value">
                                            📍 <field name="latitud"/>, <field name="longitud"/>
                                        </div>

                                        <div style="margin-top:6px;">
                                            <button name="action_ver_foto"
                                                    type="object"
                                                    class="btn btn-sm btn-secondary"
                                                    style="font-size:12px;">
                                                🔍 Ver foto
                                            </button>
                                        </div>

                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>


                    <!-- ════════════════════════════════════════════════
                         FOTOS DESPUÉS
                         ════════════════════════════════════════════════ -->
                    <separator string="✅ Fotos después (al finalizar)"/>

                    <field name="evidencia_foto_ids"
                           domain="[('momento', '=', 'despues')]"
                           context="{'default_momento': 'despues'}"
                           mode="kanban"
                           nolabel="1">

                        <kanban records_draggable="0" create="1" edit="0" delete="0">
                            <field name="id"/>
                            <field name="imagen_original"/>
                            <field name="timestamp_captura"/>
                            <field name="latitud"/>
                            <field name="longitud"/>
                            <field name="precision_gps"/>
                            <field name="tiene_coordenadas"/>

                            <templates>
                                <t t-name="kanban-box">
                                    <div style="padding:8px; border:1px solid #d8dee4; border-radius:6px; background:white;">

                                        <button name="action_ver_foto"
                                                type="object"
                                                class="btn btn-link p-0"
                                                style="display:block; width:100%; border:0; background:transparent; padding:0; cursor:zoom-in;">
                                            <img t-att-src="kanban_image('ticket.evidencia.foto', 'imagen_original', record.id.raw_value)"
                                                 alt="Foto evidencia después"
                                                 style="width:100%; height:140px; object-fit:cover; border-radius:6px; border:1px solid #e5e7eb;"/>
                                        </button>

                                        <div style="margin-top:6px; font-size:12px; color:#718096;">
                                            <field name="timestamp_captura"/>
                                        </div>

                                        <div style="font-size:11px; color:#a0aec0;"
                                             t-if="record.tiene_coordenadas.raw_value">
                                            📍 <field name="latitud"/>, <field name="longitud"/>
                                        </div>

                                        <div style="margin-top:6px;">
                                            <button name="action_ver_foto"
                                                    type="object"
                                                    class="btn btn-sm btn-secondary"
                                                    style="font-size:12px;">
                                                🔍 Ver foto
                                            </button>
                                        </div>

                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>

                </page>
            </xpath>

        </field>
    </record>

</odoo>
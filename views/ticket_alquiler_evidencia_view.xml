<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_ticket_evidencia_foto_form_modal" model="ir.ui.view">
        <field name="name">ticket.evidencia.foto.form.modal</field>
        <field name="model">ticket.evidencia.foto</field>
        <field name="arch" type="xml">
            <form string="Foto de evidencia" create="false" edit="false" delete="false">
                <sheet>

                    <div style="
                        display:flex;
                        align-items:center;
                        justify-content:space-between;
                        gap:12px;
                        padding:10px 12px;
                        margin-bottom:12px;
                        background:#f8fafc;
                        border:1px solid #e5e7eb;
                        border-radius:10px;
                    ">
                        <div>
                            <h2 style="margin:0; font-size:18px; font-weight:700; color:#1f2937;">
                                📸 Foto de evidencia
                            </h2>
                            <div style="margin-top:4px; color:#6b7280; font-size:13px;">
                                Vista previa, ubicación y datos técnicos
                            </div>
                        </div>

                        <div style="display:flex; gap:8px; flex-wrap:wrap;">
                            <button name="action_abrir_foto_original"
                                    type="object"
                                    string="🔎 Abrir original"
                                    class="btn-secondary"/>

                            <button name="action_descargar_foto"
                                    type="object"
                                    string="⬇️ Descargar"
                                    class="btn-primary"/>
                        </div>
                    </div>

                    <group>
                        <group string="Datos de la evidencia">
                            <field name="ticket_id" readonly="1"/>
                            <field name="momento" readonly="1"/>
                            <field name="timestamp_captura" readonly="1"/>
                            <field name="imagen_original_filename" readonly="1"/>
                            <field name="imagen_procesada_filename" readonly="1"/>
                        </group>

                        <group string="Ubicación GPS">
                            <field name="latitud" readonly="1"/>
                            <field name="longitud" readonly="1"/>
                            <field name="precision_gps" readonly="1"/>
                            <field name="tiene_coordenadas" readonly="1"/>
                            <field name="direccion_capturada" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Imagen"/>

                    <div style="
                        width:100%;
                        text-align:center;
                        background:#111827;
                        padding:14px;
                        border-radius:12px;
                        border:1px solid #374151;
                        max-height:72vh;
                        overflow:auto;
                    ">
                        <div style="
                            display:inline-block;
                            max-width:100%;
                            background:#ffffff;
                            padding:8px;
                            border-radius:10px;
                            box-shadow:0 10px 28px rgba(0,0,0,0.30);
                        ">
                            <field name="imagen_procesada"
                                   widget="image"
                                   readonly="1"
                                   nolabel="1"
                                   invisible="not imagen_procesada"
                                   options="{'size': [1200, 0]}"/>

                            <field name="imagen_original"
                                   widget="image"
                                   readonly="1"
                                   nolabel="1"
                                   invisible="imagen_procesada"
                                   options="{'size': [1200, 0]}"/>
                        </div>
                    </div>

                    <div style="
                        margin-top:12px;
                        padding:10px 12px;
                        background:#f9fafb;
                        border:1px solid #e5e7eb;
                        border-radius:10px;
                        color:#6b7280;
                        font-size:13px;
                    ">
                        💡 La vista principal muestra la imagen procesada cuando existe
                        (fecha, ubicación y precisión GPS). Usa
                        <strong>“Abrir original”</strong> para consultar la fotografía
                        sin marcas o <strong>“Descargar”</strong> para guardarla.
                    </div>

                    <separator string="Información técnica"/>

                    <group>
                        <field name="user_agent" readonly="1"/>
                        <field name="ip_origen" readonly="1"/>
                    </group>

                </sheet>

                <footer>
                    <button name="action_abrir_foto_original"
                            type="object"
                            string="🔎 Abrir original"
                            class="btn-secondary"/>

                    <button name="action_descargar_foto"
                            type="object"
                            string="⬇️ Descargar"
                            class="btn-primary"/>

                    <button string="Cerrar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="view_ticket_alquiler_form_evidencia" model="ir.ui.view">
        <field name="name">ticket.alquiler.form.evidencia</field>
        <field name="model">ticket.alquiler</field>
        <field name="inherit_id" ref="sat.soporte_form_viw"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="📸 Evidencia fotográfica" name="evidencia">

                    <group>
                        <group string="Acciones">
                            <button name="action_abrir_link_evidencia"
                                    type="object"
                                    string="🔗 Abrir link de subida"
                                    class="btn-primary"/>

                            <button name="action_copiar_link_evidencia"
                                    type="object"
                                    string="📋 Mostrar link"
                                    class="btn-secondary"/>

                            <button name="action_enviar_link_whatsapp_tecnico"
                                    type="object"
                                    string="📲 Enviar al técnico por WhatsApp"
                                    class="btn-success"
                                    invisible="not responsable"/>
                        </group>

                        <group string="Resumen">
                            <field name="evidencia_antes_count" readonly="1"/>
                            <field name="evidencia_despues_count" readonly="1"/>
                            <field name="evidencia_token" readonly="1" groups="base.group_no_one"/>
                        </group>
                    </group>

                    <separator string="📷 Fotos antes (al llegar)"/>

                    <field name="evidencia_foto_antes_ids"
                           context="{'default_momento': 'antes'}"
                           mode="kanban"
                           nolabel="1"
                           readonly="1">

                        <kanban records_draggable="0" create="0" edit="0" delete="0" class="o_evidencia_kanban">
                            <field name="id"/>
                            <field name="imagen_original"/>
                            <field name="imagen_procesada"/>
                            <field name="timestamp_captura"/>
                            <field name="latitud"/>
                            <field name="longitud"/>
                            <field name="precision_gps"/>
                            <field name="tiene_coordenadas"/>

                            <templates>
                                <t t-name="kanban-box">
                                    <div style="padding:10px; border:1px solid #d8dee4; border-radius:10px; background:#ffffff; box-shadow:0 2px 8px rgba(15,23,42,0.06);">

                                        <button name="action_ver_foto"
                                                type="object"
                                                class="btn btn-link p-0"
                                                title="Ver foto"
                                                style="display:block; width:100%; border:0; background:transparent; padding:0; cursor:zoom-in; text-align:left;">
                                            <div style="position:relative; width:100%; height:150px; overflow:hidden; border-radius:8px; background:#f1f5f9; border:1px solid #e5e7eb;">
                                                <t t-if="record.imagen_procesada.raw_value">
                                                    <img t-att-src="kanban_image('ticket.evidencia.foto', 'imagen_procesada', record.id.raw_value)"
                                                         alt="Foto evidencia antes procesada"
                                                         style="width:100%; height:100%; object-fit:cover; display:block;"/>
                                                </t>
                                                <t t-else="">
                                                    <img t-att-src="kanban_image('ticket.evidencia.foto', 'imagen_original', record.id.raw_value)"
                                                         alt="Foto evidencia antes original"
                                                         style="width:100%; height:100%; object-fit:cover; display:block;"/>
                                                </t>

                                                <div style="position:absolute; left:8px; top:8px; padding:3px 8px; border-radius:999px; background:rgba(22,163,74,0.92); color:white; font-size:11px; font-weight:700;">
                                                    ANTES
                                                </div>

                                                <div style="position:absolute; right:8px; bottom:8px; padding:4px 8px; border-radius:999px; background:rgba(0,0,0,0.62); color:white; font-size:11px;">
                                                    🔍 Ver
                                                </div>

                                                <div t-if="record.imagen_procesada.raw_value"
                                                     style="position:absolute; right:8px; top:8px; padding:3px 8px; border-radius:999px; background:rgba(2,122,72,0.92); color:white; font-size:10px; font-weight:700;">
                                                    GPS
                                                </div>
                                            </div>
                                        </button>

                                        <div style="margin-top:8px; padding:7px 8px; background:#f8fafc; border-radius:7px; border:1px solid #eef2f7;">
                                            <div style="font-size:12px; color:#475569; font-weight:600; margin-bottom:4px;">
                                                🕒 <field name="timestamp_captura"/>
                                            </div>

                                            <div style="font-size:11px; color:#64748b; line-height:1.35;" t-if="record.tiene_coordenadas.raw_value">
                                                📍 <field name="latitud"/>, <field name="longitud"/>
                                            </div>

                                            <div style="font-size:11px; color:#94a3b8; margin-top:3px;" t-if="record.precision_gps.raw_value">
                                                🎯 Precisión: <field name="precision_gps"/> m
                                            </div>
                                        </div>

                                        <div style="display:flex; gap:6px; margin-top:8px; flex-wrap:wrap;">
                                            <button name="action_ver_foto"
                                                    type="object"
                                                    string="🔍 Ver foto"
                                                    class="btn btn-sm btn-secondary"
                                                    style="font-size:12px;"/>

                                            <button name="action_abrir_foto_original"
                                                    type="object"
                                                    string="🖼️ Original"
                                                    class="btn btn-sm btn-secondary"
                                                    style="font-size:12px;"/>

                                            <button name="action_descargar_foto"
                                                    type="object"
                                                    string="⬇️ Descargar"
                                                    class="btn btn-sm btn-primary"
                                                    style="font-size:12px;"/>
                                        </div>

                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>


                    <separator string="✅ Fotos después (al finalizar)"/>

                    <field name="evidencia_foto_despues_ids"
                           context="{'default_momento': 'despues'}"
                           mode="kanban"
                           nolabel="1"
                           readonly="1">

                        <kanban records_draggable="0" create="0" edit="0" delete="0" class="o_evidencia_kanban">
                            <field name="id"/>
                            <field name="imagen_original"/>
                            <field name="imagen_procesada"/>
                            <field name="timestamp_captura"/>
                            <field name="latitud"/>
                            <field name="longitud"/>
                            <field name="precision_gps"/>
                            <field name="tiene_coordenadas"/>

                            <templates>
                                <t t-name="kanban-box">
                                    <div style="padding:10px; border:1px solid #d8dee4; border-radius:10px; background:#ffffff; box-shadow:0 2px 8px rgba(15,23,42,0.06);">

                                        <button name="action_ver_foto"
                                                type="object"
                                                class="btn btn-link p-0"
                                                title="Ver foto"
                                                style="display:block; width:100%; border:0; background:transparent; padding:0; cursor:zoom-in; text-align:left;">
                                            <div style="position:relative; width:100%; height:150px; overflow:hidden; border-radius:8px; background:#f1f5f9; border:1px solid #e5e7eb;">
                                                <t t-if="record.imagen_procesada.raw_value">
                                                    <img t-att-src="kanban_image('ticket.evidencia.foto', 'imagen_procesada', record.id.raw_value)"
                                                         alt="Foto evidencia después procesada"
                                                         style="width:100%; height:100%; object-fit:cover; display:block;"/>
                                                </t>
                                                <t t-else="">
                                                    <img t-att-src="kanban_image('ticket.evidencia.foto', 'imagen_original', record.id.raw_value)"
                                                         alt="Foto evidencia después original"
                                                         style="width:100%; height:100%; object-fit:cover; display:block;"/>
                                                </t>

                                                <div style="position:absolute; left:8px; top:8px; padding:3px 8px; border-radius:999px; background:rgba(37,99,235,0.92); color:white; font-size:11px; font-weight:700;">
                                                    DESPUÉS
                                                </div>

                                                <div style="position:absolute; right:8px; bottom:8px; padding:4px 8px; border-radius:999px; background:rgba(0,0,0,0.62); color:white; font-size:11px;">
                                                    🔍 Ver
                                                </div>

                                                <div t-if="record.imagen_procesada.raw_value"
                                                     style="position:absolute; right:8px; top:8px; padding:3px 8px; border-radius:999px; background:rgba(2,122,72,0.92); color:white; font-size:10px; font-weight:700;">
                                                    GPS
                                                </div>
                                            </div>
                                        </button>

                                        <div style="margin-top:8px; padding:7px 8px; background:#f8fafc; border-radius:7px; border:1px solid #eef2f7;">
                                            <div style="font-size:12px; color:#475569; font-weight:600; margin-bottom:4px;">
                                                🕒 <field name="timestamp_captura"/>
                                            </div>

                                            <div style="font-size:11px; color:#64748b; line-height:1.35;" t-if="record.tiene_coordenadas.raw_value">
                                                📍 <field name="latitud"/>, <field name="longitud"/>
                                            </div>

                                            <div style="font-size:11px; color:#94a3b8; margin-top:3px;" t-if="record.precision_gps.raw_value">
                                                🎯 Precisión: <field name="precision_gps"/> m
                                            </div>
                                        </div>

                                        <div style="display:flex; gap:6px; margin-top:8px; flex-wrap:wrap;">
                                            <button name="action_ver_foto"
                                                    type="object"
                                                    string="🔍 Ver foto"
                                                    class="btn btn-sm btn-secondary"
                                                    style="font-size:12px;"/>

                                            <button name="action_abrir_foto_original"
                                                    type="object"
                                                    string="🖼️ Original"
                                                    class="btn btn-sm btn-secondary"
                                                    style="font-size:12px;"/>

                                            <button name="action_descargar_foto"
                                                    type="object"
                                                    string="⬇️ Descargar"
                                                    class="btn btn-sm btn-primary"
                                                    style="font-size:12px;"/>
                                        </div>

                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>

                </page>
            </xpath>

        </field>
    </record>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="solicitar_toner_form_template" name="Solicitar Toner Form">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <h1 class="text-center">Solicitar Toner</h1>
                <form action="/toner/enviar_solicitud" method="post" class="solicitar_toner_form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="id_registro" t-att-value="id_registro"/>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="nombre">Nombre</label>
                            <input type="text" class="form-control" id="nombre" name="nombre" required/>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="celular">Celular</label>
                            <input type="tel" class="form-control" id="celular" name="celular" required/>
                        </div>
                    </div>
                    <!-- Más campos según sean necesarios -->
                    <button class="btn btn-primary btn-lg btn-block" type="submit">Enviar Solicitud</button>
                </form>
            </div>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- REEMPLAZAR EL TEMPLATE EXISTENTE CON ESTE -->
    <template id="solicitar_toner_form_template" name="Solicitar Toner Form">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <!-- Información del equipo -->
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white text-center">
                        <h3><i class="fa fa-print"></i> Solicitud de Tóner</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6><strong>📋 Información del Equipo:</strong></h6>
                                <p><strong>Cliente:</strong> <span t-esc="values.get('cliente', 'Sin cliente')"/></p>
                                <p><strong>Modelo:</strong> <span t-esc="values.get('modelo_maquina', 'Sin modelo')"/></p>
                                <p><strong>Serie:</strong> <span t-esc="values.get('serie', 'Sin serie')"/></p>
                            </div>
                            <div class="col-md-6">
                                <h6><strong>⚙️ Configuración:</strong></h6>
                                <p><strong>Tipo:</strong> <span t-esc="'Color' if values.get('tipo_maquina_id') == 'color' else 'Monocromática'"/></p>
                                <p><strong>Ubicación:</strong> <span t-esc="values.get('ubicacion_instalacion', 'No especificada')"/></p>
                                <p><strong>Gestión:</strong> <span t-esc="'Automática' if values.get('gestion_automatica', True) else 'Manual'"/></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stock actual (NUEVO) -->
                <t t-if="values.get('stock_info')">
                    <div class="card mb-4">
                        <div class="card-header bg-info text-white">
                            <h5><i class="fa fa-boxes"></i> Stock Actual de Tóner</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <!-- Tóner Negro -->
                                <div class="col-md-3 mb-3">
                                    <div class="stock-item">
                                        <div class="stock-color-indicator" style="background-color: #000; display: inline-block; width: 20px; height: 20px; border-radius: 50%; margin-right: 8px;"></div>
                                        <strong>Negro</strong>
                                        <br/>
                                        <span class="badge" t-attf-class="badge-{{'success' if values['stock_info']['black']['stock_total'] >= values['stock_info']['black']['stock_minimo'] else 'warning' if values['stock_info']['black']['stock_total'] > 0 else 'danger'}}">
                                            <span t-esc="values['stock_info']['black']['stock_total']"/> unidades
                                        </span>
                                        <br/>
                                        <small class="text-muted">Mínimo: <span t-esc="values['stock_info']['black']['stock_minimo']"/></small>
                                    </div>
                                </div>
                                
                                <!-- Tóners Color (solo si es máquina color) -->
                                <t t-if="values['stock_info']['has_color']">
                                    <div class="col-md-3 mb-3">
                                        <div class="stock-item">
                                            <div class="stock-color-indicator" style="background-color: cyan; display: inline-block; width: 20px; height: 20px; border-radius: 50%; margin-right: 8px;"></div>
                                            <strong>Cian</strong>
                                            <br/>
                                            <span class="badge" t-attf-class="badge-{{'success' if values['stock_info']['cyan']['stock_total'] >= values['stock_info']['cyan']['stock_minimo'] else 'warning' if values['stock_info']['cyan']['stock_total'] > 0 else 'danger'}}">
                                                <span t-esc="values['stock_info']['cyan']['stock_total']"/> unidades
                                            </span>
                                            <br/>
                                            <small class="text-muted">Mínimo: <span t-esc="values['stock_info']['cyan']['stock_minimo']"/></small>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-3 mb-3">
                                        <div class="stock-item">
                                            <div class="stock-color-indicator" style="background-color: magenta; display: inline-block; width: 20px; height: 20px; border-radius: 50%; margin-right: 8px;"></div>
                                            <strong>Magenta</strong>
                                            <br/>
                                            <span class="badge" t-attf-class="badge-{{'success' if values['stock_info']['magenta']['stock_total'] >= values['stock_info']['magenta']['stock_minimo'] else 'warning' if values['stock_info']['magenta']['stock_total'] > 0 else 'danger'}}">
                                                <span t-esc="values['stock_info']['magenta']['stock_total']"/> unidades
                                            </span>
                                            <br/>
                                            <small class="text-muted">Mínimo: <span t-esc="values['stock_info']['magenta']['stock_minimo']"/></small>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-3 mb-3">
                                        <div class="stock-item">
                                            <div class="stock-color-indicator" style="background-color: yellow; display: inline-block; width: 20px; height: 20px; border-radius: 50%; margin-right: 8px;"></div>
                                            <strong>Amarillo</strong>
                                            <br/>
                                            <span class="badge" t-attf-class="badge-{{'success' if values['stock_info']['yellow']['stock_total'] >= values['stock_info']['yellow']['stock_minimo'] else 'warning' if values['stock_info']['yellow']['stock_total'] > 0 else 'danger'}}">
                                                <span t-esc="values['stock_info']['yellow']['stock_total']"/> unidades
                                            </span>
                                            <br/>
                                            <small class="text-muted">Mínimo: <span t-esc="values['stock_info']['yellow']['stock_minimo']"/></small>
                                        </div>
                                    </div>
                                </t>
                            </div>
                            
                            <!-- Mensaje informativo sobre gestión automática -->
                            <t t-if="values.get('gestion_automatica', True)">
                                <div class="alert alert-info mt-3">
                                    <i class="fa fa-info-circle"></i> 
                                    <strong>Sistema Inteligente Activo:</strong> Su solicitud será evaluada automáticamente. 
                                    Solo se aprobará tóner si realmente es necesario según su stock actual.
                                </div>
                            </t>
                            <t t-else="">
                                <div class="alert alert-warning mt-3">
                                    <i class="fa fa-exclamation-triangle"></i> 
                                    <strong>Gestión Manual:</strong> Su solicitud será procesada sin validación automática.
                                </div>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- Formulario -->
                <div class="card">
                    <div class="card-header bg-secondary text-white">
                        <h5><i class="fa fa-edit"></i> Datos de la Solicitud</h5>
                    </div>
                    <div class="card-body">
                        <form id="tonerForm" action="/toner/enviar_solicitud" method="post" class="solicitar_toner_form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="modelo_maquina" t-att-value="values['modelo_maquina']"/>
                            <input type="hidden" name="cliente" t-att-value="values['cliente']"/>
                            <input type="hidden" name="serie" t-att-value="values['serie']"/>
                            <input type="hidden" name="id_registro" t-att-value="values['id_registro']"/>
                            <input type="hidden" name="tipo_maquina_id" t-att-value="values['tipo_maquina_id']"/>

                            <!-- Datos del solicitante -->
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="nombre"><strong>Nombre Completo *</strong></label>
                                    <input type="text" class="form-control" id="nombre" name="nombre" t-att-value="values.get('nombre', '')" required="1" placeholder="Ingrese su nombre completo"/>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="celular"><strong>Número de Celular *</strong></label>
                                    <input type="tel" class="form-control" id="celular" name="celular" t-att-value="values.get('celular', '')" required="1" placeholder="Ej: 999123456"/>
                                </div>
                            </div>

                            <!-- Contadores -->
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="contometro_black"><strong>Contador Blanco y Negro *</strong></label>
                                    <input type="number" class="form-control" id="contometro_black" name="contometro_black" 
                                           t-att-value="values.get('contador_actual_bn', 0)" 
                                           min="1" required="1" 
                                           placeholder="Lectura actual del contador B/N"
                                           oninvalid="this.setCustomValidity('El contador no puede ser 0 o menor.')" 
                                           oninput="setCustomValidity('')"/>
                                </div>

                                <t t-if="values['tipo_maquina_id'] == 'color'">
                                    <div class="col-md-6 mb-3">
                                        <label for="contometro_color"><strong>Contador Color</strong></label>
                                        <input type="number" class="form-control" id="contometro_color" name="contometro_color" 
                                               t-att-value="values.get('contador_actual_color', 0)"
                                               min="0" 
                                               placeholder="Lectura actual del contador color"/>
                                    </div>
                                </t>
                            </div>

                            <!-- Tóners solicitados (MEJORADO) -->
                            <div class="mb-4">
                                <h6><strong>📦 Seleccione los tóners que necesita:</strong></h6>
                                <div class="row">
                                    <!-- Tóner Negro -->
                                    <div class="col-md-6 col-lg-3 mb-3">
                                        <div class="card h-100 toner-card" data-color="black">
                                            <div class="card-body text-center">
                                                <div class="toner-color-circle" style="background-color: #000; width: 40px; height: 40px; border-radius: 50%; margin: 0 auto 10px;"></div>
                                                <h6>Tóner Negro</h6>
                                                <div class="form-check">
                                                    <input class="form-check-input toner-checkbox" type="checkbox" id="toner_black" name="toner_black" value="1"/>
                                                    <label class="form-check-label" for="toner_black">
                                                        Solicitar
                                                    </label>
                                                </div>
                                                <t t-if="values.get('stock_info')">
                                                    <small class="text-muted">
                                                        Stock: <span t-esc="values['stock_info']['black']['stock_total']"/> unidades
                                                    </small>
                                                </t>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Tóners Color (solo si es máquina color) -->
                                    <t t-if="values['tipo_maquina_id'] == 'color'">
                                        <div class="col-md-6 col-lg-3 mb-3">
                                            <div class="card h-100 toner-card" data-color="cyan">
                                                <div class="card-body text-center">
                                                    <div class="toner-color-circle" style="background-color: cyan; width: 40px; height: 40px; border-radius: 50%; margin: 0 auto 10px;"></div>
                                                    <h6>Tóner Cian</h6>
                                                    <div class="form-check">
                                                        <input class="form-check-input toner-checkbox" type="checkbox" id="toner_cyan" name="toner_cyan" value="1"/>
                                                        <label class="form-check-label" for="toner_cyan">
                                                            Solicitar
                                                        </label>
                                                    </div>
                                                    <small class="text-muted">
                                                        Stock: <span t-esc="values['stock_info']['cyan']['stock_total']"/> unidades
                                                    </small>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6 col-lg-3 mb-3">
                                            <div class="card h-100 toner-card" data-color="magenta">
                                                <div class="card-body text-center">
                                                    <div class="toner-color-circle" style="background-color: magenta; width: 40px; height: 40px; border-radius: 50%; margin: 0 auto 10px;"></div>
                                                    <h6>Tóner Magenta</h6>
                                                    <div class="form-check">
                                                        <input class="form-check-input toner-checkbox" type="checkbox" id="toner_magenta" name="toner_magenta" value="1"/>
                                                        <label class="form-check-label" for="toner_magenta">
                                                            Solicitar
                                                        </label>
                                                    </div>
                                                    <small class="text-muted">
                                                        Stock: <span t-esc="values['stock_info']['magenta']['stock_total']"/> unidades
                                                    </small>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6 col-lg-3 mb-3">
                                            <div class="card h-100 toner-card" data-color="yellow">
                                                <div class="card-body text-center">
                                                    <div class="toner-color-circle" style="background-color: yellow; width: 40px; height: 40px; border-radius: 50%; margin: 0 auto 10px; border: 1px solid #ccc;"></div>
                                                    <h6>Tóner Amarillo</h6>
                                                    <div class="form-check">
                                                        <input class="form-check-input toner-checkbox" type="checkbox" id="toner_yellow" name="toner_yellow" value="1"/>
                                                        <label class="form-check-label" for="toner_yellow">
                                                            Solicitar
                                                        </label>
                                                    </div>
                                                    <small class="text-muted">
                                                        Stock: <span t-esc="values['stock_info']['yellow']['stock_total']"/> unidades
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Observaciones -->
                            <div class="mb-3">
                                <label for="observaciones"><strong>Observaciones adicionales (opcional):</strong></label>
                                <textarea class="form-control" id="observaciones" name="observaciones" rows="3" placeholder="Comentarios adicionales sobre la solicitud..."></textarea>
                            </div>

                            <!-- Validación en tiempo real (NUEVO) -->
                            <div id="validationAlert" class="alert d-none" role="alert"></div>

                            <!-- Botones -->
                            <div class="text-center mt-4">
                                <button type="button" class="btn btn-secondary mr-2" onclick="goBack()">
                                    <i class="fa fa-arrow-left"></i> Volver
                                </button>
                                <button type="button" id="validateBtn" class="btn btn-warning mr-2" style="display: none;">
                                    <i class="fa fa-check-circle"></i> Validar Solicitud
                                </button>
                                <button class="btn btn-primary" type="submit" id="submitBtn">
                                    <i class="fa fa-paper-plane"></i> Enviar Solicitud
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- CSS y JavaScript mejorado -->
            <style>
                .toner-card {
                    border: 2px solid #e9ecef;
                    transition: all 0.3s ease;
                    cursor: pointer;
                }

                .toner-card:hover {
                    border-color: #007bff;
                    box-shadow: 0 4px 8px rgba(0,123,255,0.25);
                }

                .toner-card.selected {
                    border-color: #28a745;
                    background-color: #f8fff9;
                }

                .stock-item {
                    text-align: center;
                    padding: 10px;
                    border: 1px solid #e9ecef;
                    border-radius: 8px;
                    background-color: #f8f9fa;
                }

                .badge-success { background-color: #28a745; }
                .badge-warning { background-color: #ffc107; color: #212529; }
                .badge-danger { background-color: #dc3545; }
            </style>

            <script>
               function goBack() {
    if (document.referrer) {
        window.location.href = document.referrer;
    } else {
        window.history.back();
    }
}

// Funcionalidad para seleccionar tóners
document.addEventListener('DOMContentLoaded', function() {
    const tonerCards = document.querySelectorAll('.toner-card');
    const checkboxes = document.querySelectorAll('.toner-checkbox');
    const validateBtn = document.getElementById('validateBtn');
    const submitBtn = document.getElementById('submitBtn');
    const validationAlert = document.getElementById('validationAlert');

    // Funcionalidad de selección de tarjetas
    tonerCards.forEach(function(card) {
        card.addEventListener('click', function() {
            const checkbox = card.querySelector('.toner-checkbox');
            checkbox.checked = !checkbox.checked;
            card.classList.toggle('selected', checkbox.checked);
            checkTonerSelection();
        });
    });

    // Sincronizar checkboxes con tarjetas
    checkboxes.forEach(function(checkbox) {
        checkbox.addEventListener('change', function() {
            const card = checkbox.closest('.toner-card');
            card.classList.toggle('selected', checkbox.checked);
            checkTonerSelection();
        });
    });

    function checkTonerSelection() {
        const hasSelection = Array.from(checkboxes).some(cb =&gt; cb.checked);
        
        if (hasSelection &amp;&amp; validateBtn) {
            validateBtn.style.display = 'inline-block';
            submitBtn.textContent = 'Enviar sin Validar';
            submitBtn.className = 'btn btn-outline-primary';
        } else {
            if (validateBtn) {
                validateBtn.style.display = 'none';
            }
            submitBtn.textContent = 'Enviar Solicitud';
            submitBtn.className = 'btn btn-primary';
            hideValidationAlert();
        }
    }

    // Validación previa usando FormData (CORREGIDO)
    if (validateBtn) {
        validateBtn.addEventListener('click', function() {
            console.log("=== INICIANDO VALIDACIÓN ===");
            
            validateBtn.disabled = true;
            validateBtn.innerHTML = 'Validando...';
            
            // Crear FormData en lugar de JSON
            const formData = new FormData();
            formData.append('equipment_id', document.querySelector('input[name="id_registro"]').value);
            formData.append('toner_black', document.getElementById('toner_black').checked);
            formData.append('toner_cyan', document.getElementById('toner_cyan') ? document.getElementById('toner_cyan').checked : false);
            formData.append('toner_magenta', document.getElementById('toner_magenta') ? document.getElementById('toner_magenta').checked : false);
            formData.append('toner_yellow', document.getElementById('toner_yellow') ? document.getElementById('toner_yellow').checked : false);
            formData.append('counter_bn', document.getElementById('contometro_black').value);
            formData.append('counter_color', document.getElementById('contometro_color') ? document.getElementById('contometro_color').value : 0);

            // Log para debug
            console.log("Datos enviados:");
            for (let pair of formData.entries()) {
                console.log(pair[0] + ': ' + pair[1]);
            }

            fetch('/toner/validate_request_http', {
                method: 'POST',
                body: formData  // Sin Content-Type, el navegador lo establece automáticamente
            })
            .then(response =&gt; {
                console.log("Status:", response.status);
                if (!response.ok) {
                    throw new Error('Error HTTP: ' + response.status);
                }
                return response.json();
            })
            .then(data =&gt; {
                console.log("Respuesta:", data);
                showValidationResult(data);
                validateBtn.disabled = false;
                validateBtn.innerHTML = 'Validar Solicitud';
            })
            .catch(error =&gt; {
                console.error('Error completo:', error);
                showValidationAlert('Error al validar: ' + error.message, 'danger');
                validateBtn.disabled = false;
                validateBtn.innerHTML = 'Validar Solicitud';
            });
        });
    }

    function showValidationResult(result) {
        console.log("Mostrando resultado:", result);
        
        if (result.valid) {
            showValidationAlert('Solicitud válida. Puede proceder con el envío.', 'success');
            submitBtn.textContent = 'Enviar Solicitud Validada';
            submitBtn.className = 'btn btn-success';
        } else {
            let message = result.message;
            if (result.blocked_toners &amp;&amp; result.blocked_toners.length &gt; 0) {
                message += ' - Tóners no necesarios: ';
                const blockedList = result.blocked_toners.map(function(blocked) {
                    return blocked.color + ' (' + blocked.reason + ')';
                });
                message += blockedList.join(', ');
            }
            showValidationAlert(message, 'warning');
        }
    }

    function showValidationAlert(message, type) {
        validationAlert.className = 'alert alert-' + type;
        validationAlert.innerHTML = message;
        validationAlert.classList.remove('d-none');
        
        // Scroll hacia el alert
        validationAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function hideValidationAlert() {
        if (validationAlert) {
            validationAlert.classList.add('d-none');
        }
    }
});
            </script>
        </t>
    </template>
    <template id="solicitud_toner_rechazada" name="Solicitud de Tóner Rechazada">
    <t t-call="website.layout">
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card border-warning">
                        <div class="card-header bg-warning text-dark text-center">
                            <h3><i class="fa fa-exclamation-triangle"></i> Solicitud No Aprobada</h3>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-warning">
                                <h5>❌ Su solicitud de tóner no ha sido aprobada</h5>
                                <p><strong>Motivo:</strong> <span t-esc="validation_result.get('message', 'Stock suficiente')"/></p>
                            </div>
                            
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <h6><strong>📋 Información del Equipo:</strong></h6>
                                    <p>
                                        <strong>Cliente:</strong> <span t-esc="datos_formulario.get('cliente')"/><br/>
                                        <strong>Modelo:</strong> <span t-esc="datos_formulario.get('modelo_maquina')"/><br/>
                                        <strong>Serie:</strong> <span t-esc="datos_formulario.get('serie')"/>
                                    </p>
                                </div>
                                <div class="col-md-6">
                                    <h6><strong>👤 Solicitante:</strong></h6>
                                    <p>
                                        <strong>Nombre:</strong> <span t-esc="datos_formulario.get('nombre')"/><br/>
                                        <strong>Teléfono:</strong> <span t-esc="datos_formulario.get('celular')"/>
                                    </p>
                                </div>
                            </div>
                            
                            <t t-if="validation_result.get('blocked_toners')">
                                <div class="alert alert-info">
                                    <h6><strong>🚫 Tóners no necesarios:</strong></h6>
                                    <ul class="mb-0">
                                        <t t-foreach="validation_result.get('blocked_toners', [])" t-as="blocked">
                                            <li><strong><span t-esc="blocked['color'].title()"/>:</strong> <span t-esc="blocked['reason']"/></li>
                                        </t>
                                    </ul>
                                </div>
                            </t>
                            
                            <div class="alert alert-success">
                                <h6><strong>✅ Su equipo actualmente tiene stock suficiente</strong></h6>
                                <p class="mb-0">Nuestro sistema ha determinado que no es necesario enviar tóner en este momento.</p>
                            </div>
                            
                            <div class="text-center mt-4">
                                <h6><strong>¿Considera que hay un error?</strong></h6>
                                <p>Puede contactarnos directamente:</p>
                                <a href="tel:+51924894829" class="btn btn-primary me-2">
                                    <i class="fa fa-phone"></i> +51 975 399 303
                                </a>
                                <a href="mailto:soporte@andescopiers.com.pe" class="btn btn-outline-primary">
                                    <i class="fa fa-envelope"></i> soporte@andescopiers.com.pe
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</template>
<!-- AGREGAR ESTE TEMPLATE NUEVO -->
<template id="solicitud_toner_aprobada" name="Solicitud de Tóner Aprobada">
    <t t-call="website.layout">
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card border-success">
                        <div class="card-header bg-success text-white text-center">
                            <h3><i class="fa fa-check-circle"></i> Solicitud Aprobada</h3>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-success">
                                <h5>✅ Su solicitud de tóner ha sido aprobada</h5>
                                <p><strong>Número de Reporte:</strong> <span t-esc="creation_result.get('secuencia')"/></p>
                            </div>
                            
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <h6><strong>📋 Información del Equipo:</strong></h6>
                                    <p>
                                        <strong>Cliente:</strong> <span t-esc="datos_formulario.get('cliente')"/><br/>
                                        <strong>Modelo:</strong> <span t-esc="datos_formulario.get('modelo_maquina')"/><br/>
                                        <strong>Serie:</strong> <span t-esc="datos_formulario.get('serie')"/>
                                    </p>
                                </div>
                                <div class="col-md-6">
                                    <h6><strong>👤 Solicitante:</strong></h6>
                                    <p>

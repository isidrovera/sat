<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ===================================================== -->
        <!-- FORMULARIO DE FAMILIA                                 -->
        <!-- ===================================================== -->

        <record
            id="modelo_maquina_familia_form_view"
            model="ir.ui.view"
        >
            <field name="name">modelo.maquina.familia.form</field>
            <field name="model">modelo.maquina.familia</field>
            <field name="arch" type="xml">

                <form string="Familia técnica">

                    <header>

                        <button
                            name="action_generate_external_id"
                            type="object"
                            string="Generar ID externo"
                            icon="fa-link"
                            class="btn-primary"
                            invisible="not id or external_id_state == 'generated'"
                        />

                    </header>

                    <sheet>

                        <div class="oe_button_box" name="button_box">

                            <button
                                class="oe_stat_button"
                                type="object"
                                name="action_view_modelos"
                                icon="fa-print"
                            >
                                <field
                                    name="modelo_count"
                                    string="Modelos"
                                    widget="statinfo"
                                />
                            </button>

                        </div>

                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field
                                    name="name"
                                    placeholder="Nombre de la familia"
                                />
                            </h1>
                        </div>

                        <group>

                            <group string="Información principal">

                                <field name="marca_id"/>

                                <field
                                    name="name"
                                    string="Familia"
                                />

                                <field
                                    name="codigo_tecnico"
                                    placeholder="Ejemplo: mp_cxx04"
                                />

                                <field name="tipo_id"/>

                                <field name="active"/>

                            </group>

                            <group string="Referencia XML">

                                <field
                                    name="external_id_state"
                                    widget="badge"
                                    readonly="1"
                                    decoration-success="external_id_state == 'generated'"
                                    decoration-warning="external_id_state == 'pending'"
                                    decoration-danger="external_id_state == 'conflict'"
                                />

                                <field
                                    name="external_id_display"
                                    readonly="1"
                                />

                                <field
                                    name="external_id_generated_date"
                                    readonly="1"
                                    invisible="not external_id_generated_date"
                                />

                                <field
                                    name="external_id_generated_by"
                                    readonly="1"
                                    invisible="not external_id_generated_by"
                                />

                            </group>

                        </group>

                        <notebook>

                            <page
                                name="modelos"
                                string="Modelos"
                            >

                                <field
                                    name="modelo_ids"
                                    context="{
                                        'default_marca_id': marca_id,
                                        'default_familia_id': id
                                    }"
                                >

                                    <list editable="bottom">

                                        <field name="marca_id"/>

                                        <field name="name"/>

                                        <field name="codigo_tecnico"/>

                                        <field name="tipo_id"/>

                                        <field name="tipo_maquina_id"/>

                                    </list>

                                </field>

                            </page>

                            <page
                                name="informacion_tecnica"
                                string="Información técnica"
                            >

                                <group>

                                    <field name="descripcion"/>

                                    <field name="notas_tecnicas"/>

                                </group>

                            </page>

                        </notebook>

                    </sheet>

                </form>

            </field>
        </record>

        <!-- ===================================================== -->
        <!-- LISTA DE FAMILIAS                                     -->
        <!-- ===================================================== -->

        <record
            id="modelo_maquina_familia_list_view"
            model="ir.ui.view"
        >
            <field name="name">modelo.maquina.familia.list</field>
            <field name="model">modelo.maquina.familia</field>
            <field name="arch" type="xml">

                <list string="Familias técnicas">

                    <field name="marca_id"/>

                    <field name="name"/>

                    <field name="codigo_tecnico"/>

                    <field name="tipo_id"/>

                    <field
                        name="modelo_count"
                        string="Modelos"
                    />

                    <field
                        name="external_id_display"
                        string="ID externo"
                        optional="show"
                    />

                    <field
                        name="external_id_state"
                        string="Estado ID"
                        widget="badge"
                        optional="show"
                        decoration-success="external_id_state == 'generated'"
                        decoration-warning="external_id_state == 'pending'"
                        decoration-danger="external_id_state == 'conflict'"
                    />

                    <field
                        name="active"
                        optional="hide"
                    />

                    <button
                        name="action_generate_external_id"
                        type="object"
                        icon="fa-link"
                        title="Generar ID externo"
                        invisible="external_id_state == 'generated'"
                    />

                </list>

            </field>
        </record>

        <!-- ===================================================== -->
        <!-- BÚSQUEDA DE FAMILIAS                                  -->
        <!-- ===================================================== -->

        <record
            id="modelo_maquina_familia_search_view"
            model="ir.ui.view"
        >
            <field name="name">modelo.maquina.familia.search</field>
            <field name="model">modelo.maquina.familia</field>
            <field name="arch" type="xml">

                <search string="Buscar familias">

                    <field name="name"/>
                    <field name="codigo_tecnico"/>
                    <field name="marca_id"/>
                    <field name="tipo_id"/>

                    <separator/>

                    <filter
                        name="familias_activas"
                        string="Activas"
                        domain="[('active', '=', True)]"
                    />

                    <filter
                        name="familias_archivadas"
                        string="Archivadas"
                        domain="[('active', '=', False)]"
                    />

                    <group expand="1" string="Agrupar por">

                        <filter
                            name="group_brand"
                            string="Marca"
                            context="{'group_by': 'marca_id'}"
                        />

                        <filter
                            name="group_type"
                            string="Tecnología"
                            context="{'group_by': 'tipo_id'}"
                        />

                    </group>

                </search>

            </field>
        </record>

       

        <!-- ===================================================== -->
        <!-- ACCIÓN MASIVA                                         -->
        <!-- ===================================================== -->

        <record
            id="server_action_generate_family_external_ids"
            model="ir.actions.server"
        >
            <field name="name">Generar IDs externos</field>
            <field
                name="model_id"
                ref="model_modelo_maquina_familia"
            />
            <field
                name="binding_model_id"
                ref="model_modelo_maquina_familia"
            />
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
action = records.action_generate_external_id()
            </field>
        </record>

    </data>
</odoo>
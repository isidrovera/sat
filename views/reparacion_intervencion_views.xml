<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ===================================================== -->
    <!-- 1) CATÁLOGO: Subpartes por componente                 -->
    <!-- ===================================================== -->

    <!-- VISTA LISTA - Subpartes -->
    <record id="view_reparacion_subparte_list" model="ir.ui.view">
      <field name="name">reparacion.subparte.list</field>
      <field name="model">reparacion.subparte</field>
      <field name="arch" type="xml">
        <list string="Subpartes">
          <field name="name"/>
          <field name="componente"/>
          <field name="default_code"/>
          <field name="active"/>
        </list>
      </field>
    </record>

    <!-- VISTA FORMULARIO - Subpartes -->
    <record id="view_reparacion_subparte_form" model="ir.ui.view">
      <field name="name">reparacion.subparte.form</field>
      <field name="model">reparacion.subparte</field>
      <field name="arch" type="xml">
        <form string="Subparte">
          <sheet>
            <group>
              <field name="name"/>
              <field name="componente"/>
              <field name="default_code"/>
              <field name="active"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- ACCIÓN VENTANA - Subpartes -->
    <record id="action_reparacion_subparte" model="ir.actions.act_window">
      <field name="name">Catálogo de Subpartes</field>
      <field name="res_model">reparacion.subparte</field>
      <field name="view_mode">list,form</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">¡Crea tu primer catálogo de subpartes!</p>
        <p>Define las subpartes disponibles para cada componente de reparación.</p>
      </field>
    </record>

    <!-- ===================================================== -->
    <!-- 2) WIZARD PARA AÑADIR/EDITAR SUBPARTES                -->
    <!-- ===================================================== -->

    <!-- VISTA LISTA - Líneas del Wizard -->
    <record id="view_reparacion_add_subparts_wizard_line_list" model="ir.ui.view">
      <field name="name">reparacion.add.subparts.wizard.line.list</field>
      <field name="model">reparacion.add.subparts.wizard.line</field>
      <field name="arch" type="xml">
        <list string="Líneas de Subpartes" editable="bottom">
          <field name="subparte_id" options="{'no_open': True}"/>
          <field name="accion_sub"/>
          <field name="codigo"/>
          <field name="cantidad"/>
          <field name="nota"/>
        </list>
      </field>
    </record>

    <!-- VISTA FORMULARIO - Wizard Principal -->
    <record id="view_reparacion_add_subparts_wizard_form" model="ir.ui.view">
      <field name="name">reparacion.add.subparts.wizard.form</field>
      <field name="model">reparacion.add.subparts.wizard</field>
      <field name="arch" type="xml">
        <form string="Seleccionar Subpartes">
          <sheet>
            <group>
              <field name="reparacion_id" readonly="1"/>
              <field name="intervencion_id" readonly="1"/>
              <field name="componente" readonly="1"/>
            </group>
            <group>
              <field name="line_ids">
                <list editable="bottom">
                  <field name="subparte_id" options="{'no_open': True}"/>
                  <field name="accion_sub"/>
                  <field name="codigo"/>
                  <field name="cantidad"/>
                  <field name="nota"/>
                </list>
              </field>
            </group>
          </sheet>
          <footer>
            <button string="Aplicar" name="action_apply" type="object" class="btn-primary"/>
            <button string="Cancelar" special="cancel" class="btn-secondary"/>
          </footer>
        </form>
      </field>
    </record>

    <!-- ACCIÓN DEL WIZARD -->
    <record id="action_reparacion_add_subparts_wizard" model="ir.actions.act_window">
      <field name="name">Añadir/Editar Subpartes</field>
      <field name="res_model">reparacion.add.subparts.wizard</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="view_reparacion_add_subparts_wizard_form"/>
      <field name="target">new</field>
      <!-- Pasar el registro origen (intervención) al wizard -->
      <field name="context">{'default_intervencion_id': active_id}</field>
    </record>

    <!-- ===================================================== -->
    <!-- 3) INTERVENCIONES                                     -->
    <!-- ===================================================== -->

    <!-- VISTA LISTA - Detalle de Intervención (reutilizable) -->
    <record id="view_reparacion_intervencion_detalle_list" model="ir.ui.view">
      <field name="name">reparacion.intervencion.detalle.list</field>
      <field name="model">reparacion.intervencion.detalle</field>
      <field name="arch" type="xml">
        <list string="Detalle de Intervención">
          <field name="subparte_id"/>
          <field name="accion_sub"/>
          <field name="codigo"/>
          <field name="cantidad"/>
          <field name="nota"/>
        </list>
      </field>
    </record>

    <!-- VISTA FORMULARIO - Detalle de Intervención -->
    <record id="view_reparacion_intervencion_detalle_form" model="ir.ui.view">
      <field name="name">reparacion.intervencion.detalle.form</field>
      <field name="model">reparacion.intervencion.detalle</field>
      <field name="arch" type="xml">
        <form string="Detalle de Intervención">
          <sheet>
            <group>
              <field name="subparte_id"/>
              <field name="accion_sub"/>
              <field name="codigo"/>
              <field name="cantidad"/>
              <field name="nota"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- VISTA LISTA - Intervenciones -->
    <record id="view_reparacion_intervencion_list" model="ir.ui.view">
      <field name="name">reparacion.intervencion.list</field>
      <field name="model">reparacion.intervencion</field>
      <field name="arch" type="xml">
        <list string="Intervenciones">
          <field name="reparacion_id"/>
          <field name="componente"/>
          <field name="accion"/>
          <field name="es_cambio"/>
          <field name="observacion"/>
        </list>
      </field>
    </record>

    <!-- VISTA FORMULARIO - Intervenciones -->
    <record id="view_reparacion_intervencion_form" model="ir.ui.view">
      <field name="name">reparacion.intervencion.form</field>
      <field name="model">reparacion.intervencion</field>
      <field name="arch" type="xml">
        <form string="Intervención">
          <header>
            <button name="%(action_reparacion_add_subparts_wizard)d"
                    type="action"
                    string="Añadir/Editar Subpartes"
                    class="oe_highlight"/>
          </header>
          <sheet>
            <group>
              <field name="reparacion_id" readonly="1"/>
              <field name="componente"/>
              <field name="accion"/>
              <field name="es_cambio" readonly="1"/>
              <field name="observacion" placeholder="Breve nota de la intervención"/>
            </group>
            <group string="Subpartes Incluidas">
              <!-- Campo solo lectura para forzar uso del wizard -->
              <field name="detalle_ids" readonly="1">
                <list>
                  <field name="subparte_id"/>
                  <field name="accion_sub"/>
                  <field name="codigo"/>
                  <field name="cantidad"/>
                  <field name="nota"/>
                </list>
                <form>
                  <group>
                    <field name="subparte_id"/>
                    <field name="accion_sub"/>
                    <field name="codigo"/>
                    <field name="cantidad"/>
                    <field name="nota"/>
                  </group>
                </form>
              </field>
              <!-- En vez de <label> sin 'for', usar un span decorativo -->
              <span class="o_form_label">Utiliza el botón “Añadir/Editar Subpartes” para gestionar el detalle.</span>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- ACCIÓN VENTANA - Intervenciones -->
    <record id="action_reparacion_intervencion" model="ir.actions.act_window">
      <field name="name">Intervenciones de Reparación</field>
      <field name="res_model">reparacion.intervencion</field>
      <field name="view_mode">list,form</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">¡Crea tu primera intervención de reparación!</p>
        <p>Registra las intervenciones realizadas en cada componente y sus subpartes asociadas.</p>
      </field>
    </record>

  </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ===================================================== -->
    <!-- 1) CATÁLOGO: Subpartes por componente                 -->
    <!-- ===================================================== -->

  

    <!-- LIST -->
    <record id="view_reparacion_subparte_list" model="ir.ui.view">
      <field name="name">reparacion.subparte.list</field>
      <field name="model">reparacion.subparte</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="componente"/>
          <field name="default_code"/>
          <field name="active"/>
        </list>
      </field>
    </record>

    <!-- FORM -->
    <record id="view_reparacion_subparte_form" model="ir.ui.view">
      <field name="name">reparacion.subparte.form</field>
      <field name="model">reparacion.subparte</field>
      <field name="arch" type="xml">
        <form string="Subparte">
          <sheet>
            <group>
              <field name="name"/>
              <field name="componente"/>
              <field name="default_code"/>
              <field name="active"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    

    <!-- ===================================================== -->
    <!-- 2) INTERVENCIONES                                     -->
    <!-- ===================================================== -->

    

    <!-- LIST detalle (reutilizable) -->
    <record id="view_reparacion_intervencion_detalle_list" model="ir.ui.view">
      <field name="name">reparacion.intervencion.detalle.list</field>
      <field name="model">reparacion.intervencion.detalle</field>
      <field name="arch" type="xml">
        <list>
          <field name="subparte_id"/>
          <field name="accion_sub"/>
          <field name="codigo"/>
          <field name="cantidad"/>
          <field name="nota"/>
        </list>
      </field>
    </record>

    <!-- LIST intervenciones -->
    <record id="view_reparacion_intervencion_list" model="ir.ui.view">
      <field name="name">reparacion.intervencion.list</field>
      <field name="model">reparacion.intervencion</field>
      <field name="arch" type="xml">
        <list>
          <field name="reparacion_id"/>
          <field name="componente"/>
          <field name="accion"/>
          <field name="es_cambio"/>
          <field name="observacion"/>
        </list>
      </field>
    </record>

    <!-- FORM intervenciones -->
    <record id="view_reparacion_intervencion_form" model="ir.ui.view">
      <field name="name">reparacion.intervencion.form</field>
      <field name="model">reparacion.intervencion</field>
      <field name="arch" type="xml">
        <form string="Intervención">
          <header>
            <!-- Sin 'states'; botón siempre visible -->
            <button name="%(action_reparacion_add_subparts_wizard)d"
                    type="action"
                    string="Añadir/Editar subpartes"
                    class="oe_highlight"
                    context="{'active_intervencion_id': active_id}"/>
          </header>
          <sheet>
            <group>
              <field name="reparacion_id" readonly="1"/>
              <field name="componente"/>
              <field name="accion"/>
              <field name="es_cambio" readonly="1"/>
              <field name="observacion" placeholder="Breve nota de la intervención"/>
            </group>
            <group string="Subpartes incluidas">
              <!-- Forzamos uso del wizard: solo lectura -->
              <field name="detalle_ids" readonly="1">
                <list>
                  <field name="subparte_id"/>
                  <field name="accion_sub"/>
                  <field name="codigo"/>
                  <field name="cantidad"/>
                  <field name="nota"/>
                </list>
                <form>
                  <group>
                    <field name="subparte_id"/>
                    <field name="accion_sub"/>
                    <field name="codigo"/>
                    <field name="cantidad"/>
                    <field name="nota"/>
                  </group>
                </form>
              </field>
              <label string="Usa el botón 'Añadir/Editar subpartes' para gestionar el detalle."/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

 

    <!-- LIST líneas del wizard -->
    <record id="view_reparacion_add_subparts_wizard_line_list" model="ir.ui.view">
      <field name="name">reparacion.add.subparts.wizard.line.list</field>
      <field name="model">reparacion.add.subparts.wizard.line</field>
      <field name="arch" type="xml">
        <list editable="bottom">
          <field name="subparte_id" options="{'no_open': True}" domain="[('componente','=',parent.componente)]"/>
          <field name="accion_sub"/>
          <field name="codigo"/>
          <field name="cantidad"/>
          <field name="nota"/>
        </list>
      </field>
    </record>

    <!-- FORM wizard -->
    <record id="view_reparacion_add_subparts_wizard_form" model="ir.ui.view">
      <field name="name">reparacion.add.subparts.wizard.form</field>
      <field name="model">reparacion.add.subparts.wizard</field>
      <field name="arch" type="xml">
        <form string="Seleccionar Subpartes">
          <sheet>
            <group>
              <field name="reparacion_id" readonly="1"/>
              <field name="intervencion_id" readonly="1"/>
              <field name="componente" readonly="1"/>
            </group>
            <group>
              <field name="line_ids" context="{'default_wizard_id': active_id}">
                <list editable="bottom">
                  <field name="subparte_id" domain="[('componente','=',parent.componente)]"/>
                  <field name="accion_sub"/>
                  <field name="codigo"/>
                  <field name="cantidad"/>
                  <field name="nota"/>
                </list>
              </field>
            </group>
          </sheet>
          <footer>
            <button string="Aplicar" name="action_apply" type="object" class="btn-primary"/>
            <button string="Cancelar" special="cancel" class="btn-secondary"/>
          </footer>
        </form>
      </field>
    </record>

    <!-- ACTION del wizard -->
    <record id="action_reparacion_add_subparts_wizard" model="ir.actions.act_window">
      <field name="name">Añadir subpartes</field>
      <field name="res_model">reparacion.add.subparts.wizard</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="view_reparacion_add_subparts_wizard_form"/>
      <field name="target">new</field>
    </record>

  </data>
</odoo>

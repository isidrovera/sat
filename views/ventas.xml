<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="maquinas_form_view" model="ir.ui.view">
    <field name="name">Sat.form</field>
    <field name="model">sat.sat</field>
    <field name="arch" type="xml">
        <form string="Gestión de Equipos de Fotocopiado">
          <!-- HEADER: Con botones mejorados e iconos modernos -->
          <header>
            <button string="Enviar Reportes" name="send_records_by_email" type="object" 
                class="oe_highlight" icon="fa-paper-plane-o" 
                help="Envía por correo electrónico un listado completo de las máquinas con problemas o fallas y el estatus de partes en proceso" 
                groups="base.group_system" />
                
            <button string="Nueva Reparación" name="create_reparacion" type="object" 
                class="btn btn-success" icon="fa-wrench" 
                help="Crea una nueva orden de reparación para esta máquina. Asegúrese de haber registrado correctamente las observaciones del equipo." 
                groups="base.group_system" />
                
            <!--<button name="action_crear_reparaciones" string="Crear Reparaciones Masivas" 
                type="object" class="btn-primary" icon="fa-cogs"
                help="Permite generar múltiples órdenes de reparación para varios equipos desde una sola operación" />-->
                
            <field name="disponibilidad_id" widget="statusbar" statusbar_visible="true" />
            <field name="estado_ventas_id" widget="statusbar" options="{'clickable': '1'}" 
                class="custom_statusbar" 
                groups="base.group_system, sat_jefes_group_user"/>
          </header>

          <!-- ALERTAS MEJORADAS: Con iconos y mejor formato -->
          <div class="alert alert-danger" role="alert" style="margin-bottom: 0px; display: flex; align-items: center; gap: 10px;" invisible="activador == 'no'">
            <i class="fa fa-exclamation-circle fa-2x" style="color: #dc3545;"></i>
            <div>
              <strong style="font-size: 15px;">¡ATENCIÓN: MÁQUINA CON PROBLEMAS!</strong><br/>
              Esta máquina tiene observaciones críticas: <field name='descripcion' style="color: red; font-weight: bold;" /><br/>
              <b>Importante:</b> Si está gestionando una separación o venta, revise las observaciones con detenimiento y consulte
              con el área técnica antes de proceder. Se requiere aprobación del responsable técnico.
            </div>
          </div>

          <div class="alert alert-warning" role="alert" style="margin-bottom: 0px; display: flex; align-items: center; gap: 10px; background-color: #fff3cd;" invisible="ubicacion_id == 'primer_piso' or ubicacion_id == 'tercer_piso'">
            <i class="fa fa-warehouse fa-2x" style="color: #ff9800;"></i>
            <div>
              <strong style="font-size: 15px;">¡ALERTA DE UBICACIÓN!</strong><br/>
              Esta máquina se encuentra en: <field name="ubicacion_id" style="background-color: #ffee99; padding: 2px 5px; border-radius: 3px; font-weight: bold;" /><br/>
              <b>Proceso a seguir:</b> Para separación o venta, notifique con mínimo 24 horas de anticipación al área de almacén
              para coordinar su traslado. Sin este aviso, no se garantiza disponibilidad inmediata del equipo.
            </div>
          </div>

          <sheet>
            <!-- BOTONES ESTADÍSTICOS: Con tooltip mejorado -->
            <div class="oe_button_box" name="button_box">
              <button name="view_reparaciones_ids" type="object" class="oe_stat_button" icon="fa-wrench"
                    help="Ver todas las reparaciones históricas y en curso asociadas a este equipo. Revise esta información antes de realizar cualquier operación de venta.">
                <field name="reparaciones_count" string="Reparaciones" widget="statinfo" />
              </button>
            </div>

            <!-- TÍTULO Y CLIENTE -->
            <div class="oe_title">
              <label for="cliente_id" style="font-size: 16px; color: #212529;">Cliente / Distribuidor</label>
              <h1>
                <field name="cliente_id" domain="[('tipo_cliente', '=', 'distribuidor')]" 
                    placeholder="Seleccione el cliente o distribuidor asociado" widget="many2one_avatar" 
                    style="width:100%; font-size: 20px;" options="{'no_create': True}" />
              </h1>
              <div style="margin-top: 5px; font-size: 13px; color: #6c757d; border-top: 1px dotted #ddd; padding-top: 5px;">
                <i class="fa fa-info-circle"></i> El cliente seleccionado determina las condiciones comerciales y logísticas aplicables.
                Verifique que sea el correcto antes de proceder.
              </div>
            </div>

            <!-- GRUPOS DE DATOS: Mejorando presentación visual e instrucciones -->
            <group>
              <group string="Datos del Equipo" style="background-color: #f8f9fa; border-radius: 8px; padding: 15px; border-left: 4px solid #007bff;">
                <div style="margin-bottom: 15px; font-size: 13px; color: #495057; border-bottom: 1px solid #dee2e6; padding-bottom: 8px;">
                  <i class="fa fa-clipboard-check"></i> <b>Instrucciones:</b> Verifique que todos los datos técnicos coincidan con los físicos del equipo.
                  Si detecta discrepancias entre la información registrada y la máquina física, reporte inmediatamente al área técnica.
                </div>
                
                <field name="tipo_maquina" help="Seleccione el tipo de equipo (fotocopiadora, impresora, multifuncional, etc.)"/>
                <field name="marca" help="Marca del fabricante del equipo"/>
                <field name="name" search="True" options="{'no_create': True}" help="Seleccione el modelo exacto del equipo. No crear nuevos registros sin autorización."/>
                <field name="serie_id" help="IMPORTANTE: Verifique que el número de serie coincida exactamente con el físico del equipo. En caso de discrepancia, notifique al supervisor."/>
                <field name="contometro" help="Lectura actual del contador de impresiones/copias del equipo. Verifique físicamente este valor."/>
                <field name="ubicacion_id" help="Ubicación física actual del equipo dentro de las instalaciones."/>
                <field name="fecha_separacion" invisible="disponibilidad_id == 'disponible'" readonly="1" help="Fecha en que se realizó la separación del equipo. Campo automático."/>
                
                <div style="margin-top: 10px; font-size: 12px; background-color: #e9ecef; padding: 8px; border-radius: 4px;">
                  <i class="fa fa-exclamation-triangle" style="color: #fd7e14;"></i> <b>Nota:</b> Verifique siempre que el número
                  de serie coincida exactamente con el equipo físico. Las discrepancias pueden causar problemas legales o de inventario.
                </div>
              </group>

              <group string="Datos de Importación" style="background-color: #e8f4f8; border-radius: 8px; padding: 15px; border-left: 4px solid #17a2b8;">
                <div style="margin-bottom: 15px; font-size: 13px; color: #495057; border-bottom: 1px solid #dee2e6; padding-bottom: 8px;">
                  <i class="fa fa-ship"></i> <b>Instrucciones:</b> Esta información es crítica para trazabilidad legal y contable.
                  Todos los campos deben completarse con la documentación oficial de importación.
                </div>
                
                <field name="proveedor_id" domain="[('tipo_cliente', '=', 'proveedor')]" options="{'no_create': True}" 
                    help="Proveedor internacional que suministró el equipo. Si no aparece en la lista, contacte al departamento de compras."/>
                <field name="importacion" help="Número o referencia del lote de importación. Este dato es fundamental para trazabilidad aduanera."/>
                <field name="invoice" help="Número de factura internacional de compra. Documento requerido para garantía del fabricante."/>
                
                <div style="margin-top: 10px; font-size: 12px; background-color: #e9ecef; padding: 8px; border-radius: 4px;">
                  <i class="fa fa-file-text" style="color: #17a2b8;"></i> <b>Documentación:</b> Asegúrese de que todos los documentos
                  de importación estén adjuntos en la sección de chatter para consulta futura.
                </div>
              </group>
              
              <group string="Datos para revisión" style="background-color: #fff8f8; border-radius: 8px; padding: 15px; border-left: 4px solid #dc3545;">
                <div style="margin-bottom: 15px; font-size: 13px; color: #495057; border-bottom: 1px solid #dee2e6; padding-bottom: 8px;">
                  <i class="fa fa-search"></i> <b>Instrucciones:</b> Establezca el tipo de revisión técnica requerida y la prioridad.
                  Estos campos determinan cómo el departamento técnico programará la atención del equipo.
                </div>
                
                <field name="tipo_revision" widget="kanban_label_selection" options="{'classes': {'draft': 'default', 'done': 'success'}}" 
                    help="Seleccione el tipo de revisión técnica necesaria. 'Draft' para pendiente, 'Done' para completada."/>
                <field name="prioridad" widget="selection" 
                    help="Establezca la prioridad de atención técnica. Alta prioridad implica atención inmediata para equipos críticos o con cliente en espera."/>
                
                <div style="margin-top: 10px; font-size: 12px; background-color: #f8d7da; padding: 8px; border-radius: 4px;">
                  <i class="fa fa-clock-o" style="color: #dc3545;"></i> <b>Tiempo de respuesta:</b> Alta prioridad: 24h, Media: 48h, Baja: 72h.
                  El incumplimiento de estos tiempos debe ser reportado a la gerencia técnica.
                </div>
              </group>

              <group string="Notificar" style="background-color: #f0f9e8; border-radius: 8px; padding: 15px; border-left: 4px solid #28a745;">
                <div style="margin-bottom: 15px; font-size: 13px; color: #495057; border-bottom: 1px solid #dee2e6; padding-bottom: 8px;">
                  <i class="fa fa-bell"></i> <b>Instrucciones:</b> Configure las notificaciones y asignaciones para el seguimiento del equipo.
                  Estos campos determinan quién recibe alertas y es responsable del proceso.
                </div>
                
                <field name="trabajadores_id" widget="many2one_avatar" 
                    help="Técnico o trabajador asignado como responsable principal de este equipo. Recibirá todas las notificaciones relevantes."/>
                <field name="asesora_id" 
                    help="Asesor(a) comercial asignado(a) cuando el equipo está en proceso de venta o atención a distribuidor."/>
                <field name="fecha_para_revision" 
                    help="Fecha programada para la próxima revisión técnica. Establecer con al menos 48 horas de anticipación."/>
                <field name="autorizacion_cambio_digitos" 
                    help="Marque esta casilla si se ha autorizado modificación de dígitos o configuración especial del equipo."/>
                
                <div style="margin-top: 10px; font-size: 12px; background-color: #d4edda; padding: 8px; border-radius: 4px;">
                  <i class="fa fa-user-circle" style="color: #28a745;"></i> <b>Asignación:</b> El técnico responsable debe
                  confirmar la recepción de la asignación dentro de las 4 horas siguientes a su notificación.
                </div>
              </group>
            </group>

            <!-- PESTAÑAS: Con instrucciones mejoradas -->
            <notebook>
              <page string="Observaciones del equipo">
                <div style="margin: 10px 0; padding: 12px; background-color: #f8f9fa; border-left: 4px solid #17a2b8; border-radius: 4px;">
                  <h4 style="margin-top: 0; font-size: 16px; color: #17a2b8;"><i class="fa fa-info-circle"></i> Instrucciones para Observaciones</h4>
                  <p style="margin-bottom: 5px; font-size: 13px;">
                    En esta sección debe documentar detalladamente:
                  </p>
                  <ul style="margin-bottom: 0; font-size: 13px;">
                    <li><b>Problemas técnicos:</b> Describa cualquier falla, mal funcionamiento o comportamiento anormal.</li>
                    <li><b>Condiciones físicas:</b> Reporte daños estéticos, piezas faltantes o desgaste visible.</li>
                    <li><b>Requisitos especiales:</b> Indique si el equipo requiere configuraciones especiales o partes no estándar.</li>
                    <li><b>Historial relevante:</b> Mencione problemas recurrentes o reparaciones anteriores importantes.</li>
                  </ul>
                  <p style="margin-top: 8px; font-size: 13px; font-style: italic;">
                    <b>Nota:</b> Las observaciones claras y completas facilitan la correcta valoración técnica y comercial del equipo.
                  </p>
                </div>
                
                <group>
                  <group>
                    <field name="descripcion" placeholder="Detalle aquí todos los problemas, condiciones especiales o requisitos del equipo..." 
                        style="min-height: 120px; font-family: 'Courier New', monospace; padding: 10px; background-color: #f8f9fa;" />
                  </group>
                  <group>
                    <field name="activador" class="oe_form_field_bottom_separator" invisible="1" />
                    <label for="foto_problema" style="font-weight: bold; display: block; margin-bottom: 5px;">Evidencia Fotográfica:</label>
                    <field name="foto_problema" widget="image"/>
                    <div style="font-size: 13px; color: #6c757d; margin-top: 10px; padding: 8px; background-color: #f8f9fa; border-radius: 4px;">
                      <b>Recomendaciones para fotos:</b>
                      <ul style="margin-top: 5px; margin-bottom: 0;">
                        <li>Capture claramente el número de serie</li>
                        <li>Muestre el panel de control y lecturas</li>
                        <li>Fotografíe todas las áreas dañadas</li>
                        <li>Incluya una imagen de muestra si hay problemas de calidad de impresión</li>
                      </ul>
                    </div>
                  </group>
                </group>
              </page>

              <page string="Precios">
                <div style="margin: 10px 0; padding: 12px; background-color: #f8f9fa; border-left: 4px solid #28a745; border-radius: 4px;">
                  <h4 style="margin-top: 0; font-size: 16px; color: #28a745;"><i class="fa fa-money-bill"></i> Instrucciones para Gestión de Precios</h4>
                  <p style="margin-bottom: 5px; font-size: 13px;">
                    La información financiera en esta sección es crítica para los procesos comerciales y contables:
                  </p>
                  <ul style="margin-bottom: 0; font-size: 13px;">
                    <li><b>Precio de venta:</b> Debe reflejar el valor actualizado según política comercial vigente.</li>
                    <li><b>Moneda:</b> Seleccione la moneda correcta según el mercado objetivo del equipo.</li>
                    <li><b>Precio de compra:</b> Información confidencial visible solo para roles autorizados.</li>
                  </ul>
                  <p style="margin-top: 8px; font-size: 13px; font-style: italic;">
                    <b>Importante:</b> Toda modificación de precios queda registrada en el historial del sistema.
                    Los precios deben ser validados por el departamento comercial antes de presentarlos al cliente.
                  </p>
                </div>
                
                <group>
                  <group style="background-color: #f8fffa; border-radius: 6px; padding: 10px;">
                    <field name="precio_venta" widget="monetary" options="{'currency_field': 'currency_id'}" 
                        groups="base.group_system, sat.Sat_ventas_group_user"
                        style="font-size: 18px; font-weight: bold; color: #28a745;" />
                    <field name="currency_id" string="Tipo de moneda" />
                    <div style="font-size: 12px; color: #6c757d; margin-top: 8px;">
                      <i class="fa fa-info-circle"></i> El precio de venta debe incluir todos los costos asociados
                      (importación, impuestos, garantía, etc.) según la política comercial actual.
                    </div>
                  </group>
                  <group style="background-color: #fff8f8; border-radius: 6px; padding: 10px;" groups="base.group_system, sat_jefes_group_user">
                    <field name="precio_compra" widget="monetary" options="{'currency_field': 'currency_id'}" 
                        groups="base.group_system, sat_jefes_group_user"
                        style="font-size: 16px; color: #dc3545;" />
                    <div style="font-size: 12px; color: #6c757d; margin-top: 8px; border-top: 1px dotted #ddd; padding-top: 8px;">
                      <i class="fa fa-lock"></i> <b>Confidencial:</b> Esta información es restringida y solo visible para administradores y jefes.
                      No comparta estos valores con distribuidores o clientes.
                    </div>
                  </group>
                </group>
              </page>

              <page string="Logística">
                <div style="margin: 10px 0; padding: 12px; background-color: #f8f9fa; border-left: 4px solid #fd7e14; border-radius: 4px;">
                  <h4 style="margin-top: 0; font-size: 16px; color: #fd7e14;"><i class="fa fa-truck"></i> Instrucciones para Gestión Logística</h4>
                  <p style="margin-bottom: 5px; font-size: 13px;">
                    Esta sección gestiona la documentación comercial y logística para equipos en proceso de venta o entrega:
                  </p>
                  <ul style="margin-bottom: 0; font-size: 13px;">
                    <li><b>Factura de venta:</b> Registre el número de factura comercial emitida al cliente.</li>
                    <li><b>Fecha de entrega:</b> Programe o registre la fecha real de entrega al cliente final.</li>
                  </ul>
                  <p style="margin-top: 8px; font-size: 13px; font-style: italic;">
                    <b>Proceso completo:</b> Para equipos vendidos, asegúrese de completar esta sección y verificar
                    que toda la documentación esté correctamente registrada antes de autorizar la salida física.
                  </p>
                </div>
                
                <group>
                  <group style="background-color: #fff9f0; border-radius: 6px; padding: 10px;">
                    <field name="factura_venta" placeholder="Ej: F001-00012345" />
                    <div style="font-size: 12px; color: #6c757d; margin-top: 8px;">
                      <i class="fa fa-file-text"></i> Ingrese el número completo de la factura emitida al cliente.
                      Este campo es obligatorio para equipos vendidos y en proceso de despacho.
                    </div>
                  </group>
                  <group style="background-color: #fff9f0; border-radius: 6px; padding: 10px;">
                    <field name="fecha_entrega" />
                    <div style="font-size: 12px; color: #6c757d; margin-top: 8px;">
                      <i class="fa fa-calendar"></i> Fecha programada o ejecutada de entrega física al cliente.
                      Las entregas deben programarse con mínimo 24 horas de anticipación.
                    </div>
                  </group>
                </group>
                
                <div style="margin-top: 20px; padding: 15px; background-color: #fffbf0; border: 1px solid #ffeeba; border-radius: 6px;">
                  <h5 style="margin-top: 0; color: #856404; font-size: 15px;"><i class="fa fa-clipboard-list"></i> Protocolo de Entrega</h5>
                  <ol style="margin-bottom: 0; padding-left: 25px;">
                    <li style="margin-bottom: 8px;"><b>Verificación técnica:</b> Confirme que la máquina ha pasado todas las pruebas técnicas antes de programar entrega.</li>
                    <li style="margin-bottom: 8px;"><b>Documentación:</b> Prepare ficha técnica, manual de usuario y certificado de garantía para entregar junto con el equipo.</li>
                    <li style="margin-bottom: 8px;"><b>Coordinación:</b> Si la máquina está en almacén, notifique con 24h de anticipación para asegurar disponibilidad.</li>
                    <li style="margin-bottom: 8px;"><b>Insumos:</b> Verifique que todos los insumos iniciales (tóner, tambor, etc.) estén incluidos según lo acordado.</li>
                    <li><b>Confirmación:</b> Una vez entregado, registre la conformidad del cliente en el sistema dentro de las 24 horas siguientes.</li>
                  </ol>
                </div>
              </page>
            </notebook>
          </sheet>
          
          <!-- COMENTARIOS -->
          <chatter />
        </form>
      </field>
    </record>
    

  <record id="maquinas_tree_sat" model="ir.ui.view">
    <field name="name">sat.tree</field>
    <field name="model">sat.sat</field>
    <field name="type">list</field>    
    <field name="arch" type="xml">
        <list default_order="id desc" class="modern-sat-table animate__animated animate__fadeIn">
            <!-- Campos ocultos -->
            <field name="importacion" optional="hide"/>
            <field name="proveedor_id" optional="hide"/>
            <field name="descripcion" optional="hide"/>
            
            <!-- Información del Cliente -->
            <field name="cliente_nombre" 
                   string="Cliente"
                   class="client-info animate__animated animate__slideInLeft"/>
            
            <field name="tipo_maquina" 
                   string="Tipo Máquina"
                   class="machine-type-modern"/>
            
            <field name="marca" 
                   string="Marca"
                   class="brand-modern"/>
            
            <!-- Información Principal -->
            <field name="name" 
                   string="Nombre"
                   class="machine-name-modern h6 fw-bold text-primary bg-gradient-light rounded-3 px-3 py-2 shadow-sm"/>
            
            <field name="serie_id" 
                   string="Serie"
                   class="serial-modern font-monospace bg-dark text-info rounded px-2 py-1"/>
            
            <!-- Datos Operativos -->
            <field name="contometro" 
                   string="Contador"
                   class="counter-modern text-end bg-info bg-opacity-10 rounded-3 px-3 py-2 fw-bold position-relative"/>
            
            <field name="ubicacion_id" 
                   string="Ubicación"
                   class="location-modern fst-italic text-muted bg-light rounded-pill px-3 py-1"/>
            
            <!-- Estados y Alertas con efectos modernos -->
            <field name="disponibilidad_id" 
                   string="Disponibilidad"
                   widget="badge"
                   class="availability-badge-modern rounded-pill px-4 py-2 fw-bold text-uppercase letter-spacing-wide shadow-modern position-relative overflow-hidden" 
                   decoration-success="disponibilidad_id == 'disponible'" 
                   decoration-warning="disponibilidad_id == 'separada'" 
                   decoration-danger="disponibilidad_id == 'no_disponible'"/>
                   
            <field name="estado_ventas_id" 
                   string="Estado Ventas"
                   widget="badge"
                   class="sales-status-modern rounded-pill px-4 py-2 fw-semibold backdrop-blur border-modern" 
                   decoration-muted="estado_ventas_id == 'sin_revisar'" 
                   decoration-info="estado_ventas_id == 'en_revision'" 
                   decoration-success="estado_ventas_id == 'finalizado'" 
                   decoration-danger="estado_ventas_id not in ('sin_revisar', 'en_revision', 'finalizado', 'entregada')" 
                   decoration-warning="estado_ventas_id == 'entregada'"/>
            
            <field name="icono_rojo" 
                   widget="html" 
                   string="Alerta" 
                   invisible="activador == 'no'"
                   class="alert-modern text-danger fs-4 animate__animated animate__heartBeat animate__infinite filter-glow cursor-pointer"/>
            
            <!-- Campos Opcionales con estilos modernos -->
            <field name="create_date" 
                   string="Fecha Ingreso" 
                   widget="remaining_days" 
                   optional="hide"
                   class="date-modern text-muted small bg-light rounded px-2 py-1"/>
            
            <field name="fecha_separacion" 
                   string="Fecha Separada" 
                   widget="remaining_days" 
                   invisible="disponibilidad_id != 'separada'" 
                   optional="hide"
                   class="separation-date-modern text-warning bg-warning bg-opacity-10 rounded px-2 py-1 animate__animated animate__pulse"/>
            
            <field name="fecha_para_revision" 
                   string="Fecha Revisión" 
                   optional="hide"
                   class="review-date-modern"/>
            
            <field name="activador" optional="hide"/>
            <field name="currency_id" string="Moneda" optional="hide"/>
            
            <field name="precio_compra" 
                   string="Precio Compra"
                   widget="monetary" 
                   options="{'currency_field': 'currency_id'}" 
                   optional="hide" 
                   groups="base.group_system, sat_jefes_group_user"
                   class="price-modern fw-bold text-success bg-success bg-opacity-10 rounded-3 px-3 py-2 font-monospace"/>
            
            <field name="asesora_id" 
                   string="Asesora" 
                   optional="hide"
                   class="advisor-modern"/>
                   
            <!-- Botones modernizados con efectos hover -->
            <button name="action_primer" 
                    type="object" 
                    string="Primer Piso" 
                    class="btn-modern btn btn-outline-primary btn-sm rounded-pill me-2 shadow-hover transition-all" 
                    icon="fa-building-o" 
                    groups="base.group_system" 
                    title="Primer Piso" optional="hide"/>
                    
            <button name="action_tercero" 
                    type="object" 
                    string="Tercer Piso" 
                    class="btn-modern btn btn-outline-info btn-sm rounded-pill me-2 shadow-hover transition-all" 
                    icon="fa-building" 
                    groups="base.group_system" 
                    title="Tercer Piso" optional="hide"/>
                    
            <button name="action_segundo" 
                    type="object" 
                    string="Segundo Local" 
                    class="btn-modern btn btn-outline-warning btn-sm rounded-pill me-2 shadow-hover transition-all" 
                    icon="fa-truck" 
                    groups="base.group_system" 
                    title="Segundo Local" optional="hide"/>
                    
            <button name="view_reparaciones_ids" 
                    type="object" 
                    string="Reparaciones" 
                    class="btn-repair-modern btn btn-primary btn-sm rounded-pill shadow-lg position-relative overflow-hidden" 
                    icon="fa-wrench" 
                    invisible="estado_ventas_id != 'finalizado'"
                    title="Reparaciones"/>
        </list>
    </field>
</record>

    <!-- Búsqueda -->
    <record id="Sat_search_view" model="ir.ui.view">
    <field name="name">sat.sat.search</field>
    <field name="model">sat.sat</field>
    <field name="arch" type="xml">
        <search>
            <!-- Campos de búsqueda -->
            <field name="tipo_maquina"/>
            <field name="marca"/>
            <field name="name"/>
            <field name="serie_id"/>
            <field name="cliente_id"/>
            <field name="ubicacion_id"/>
            <field name="asesora_id"/>

            <!-- Filtros -->
            <filter name="filter_disponible" 
                    string="Disponibles" 
                    domain="[('disponibilidad_id', '=', 'disponible')]"/>
            <filter name="filter_separada" 
                    string="Separadas" 
                    domain="[('disponibilidad_id', '=', 'separada')]"/>
            <filter name="filter_no_disponible" 
                    string="No disponibles" 
                    domain="[('disponibilidad_id', '=', 'no_disponible')]"/>
            
            <separator/>
            
            <filter name="filter_sin_revisar" 
                    string="Sin revisar" 
                    domain="[('estado_ventas_id', '=', 'sin_revisar')]"/>
            <filter name="filter_revision" 
                    string="En revisión" 
                    domain="[('estado_ventas_id', '=', 'en_revision')]"/>
            <filter name="filter_finalizado" 
                    string="Finalizado" 
                    domain="[('estado_ventas_id', '=', 'finalizado')]"/>
            <filter name="filter_problemas" 
                    string="Con problemas" 
                    domain="[('estado_ventas_id', '=', 'con_problemas')]"/>
            <filter name="filter_partes" 
                    string="De partes" 
                    domain="[('estado_ventas_id', '=', 'de_partes')]"/>
            <filter name="filter_entregada" 
                    string="Entregada" 
                    domain="[('estado_ventas_id', '=', 'entregada')]"/>
            

            <!-- Agrupamiento -->
            <group expand="0" string="Agrupar Por">
                <filter name="group_disponibilidad" 
                        string="Disponibilidad" 
                        context="{'group_by': 'disponibilidad_id'}"/>
                <filter name="group_estado" 
                        string="Estado" 
                        context="{'group_by': 'estado_ventas_id'}"/>
                <filter name="group_marca" 
                        string="Marca" 
                        context="{'group_by': 'marca'}"/>
                <filter name="group_ubicacion" 
                        string="Ubicación" 
                        context="{'group_by': 'ubicacion_id'}"/>
            </group>
           <!-- <searchpanel>            
              <field name="estado_ventas_id" string="Estado" icon="fa-hourglass-start" enable_counters="1" colors='{"sin_revisar": "red", "en_revision": "blue", "finalizado": "green", "entregada": "purple"}'/>
              <field name="disponibilidad_id" string="Disponibilidad" icon="fa-check-circle" enable_counters="1" colors='{"disponible": "green", "separada": "orange", "no_disponible": "red"}'/>                                 
          </searchpanel>-->              
        </search>
    </field>
</record>
    <!-- Kanban -->
    <record id="maquinas_kanban_view" model="ir.ui.view">
      <field name="name">maquinas.kanban</field>
      <field name="model">sat.sat</field>
      <field name="arch" type="xml">
        <kanban default_group_by="estado_ventas_id" class="o_kanban_dashboard" sample="1">
          <field name="id"/>
          <field name="name"/>
          <field name="cliente_id"/>
          <field name="tipo_maquina"/>
          <field name="marca"/>
          <field name="serie_id"/>
          <field name="contometro"/>
          <field name="disponibilidad_id"/>
          <field name="estado_ventas_id"/>
          <field name="tipo_id"/>
          <field name="precio_venta"/>
          <field name="precio_compra" groups="base.group_system, sat_jefes_group_user"/>
          <field name="asesora_id"/>
          <field name="ubicacion_id"/>
          <field name="importacion"/>
          <field name="descripcion"/>
          <field name="factura_venta"/>
          <field name="fecha_entrega"/>
          <field name="activador"/>

          <progressbar field="estado_ventas_id" colors='{"finalizado": "success", 
                        "con_problemas": "warning", 
                        "de_partes": "danger",
                        "en_revision": "info",
                        "sin_revisar": "secondary",
                        "entregada": "primary"}'/>

          <templates>
            <t t-name="card">
              <div class="oe_kanban_global_click position-relative shadow-sm rounded">
                <!-- Header con estado y disponibilidad -->
                <div class="d-flex justify-content-between align-items-center p-2 bg-light border-bottom">
                  <div class="d-flex align-items-center">
                    <!-- Icono dinámico según estado -->
                    <i t-attf-class="fa me-2 #{
                                    record.estado_ventas_id.raw_value == 'sin_revisar' ? 'fa-clock text-secondary' :
                                    record.estado_ventas_id.raw_value == 'para_revision' ? 'fa-search text-info' :
                                    record.estado_ventas_id.raw_value == 'asignado' ? 'fa-user-check text-primary' :
                                    record.estado_ventas_id.raw_value == 'en_revision' ? 'fa-tools text-info' :
                                    record.estado_ventas_id.raw_value == 'finalizado' ? 'fa-check-circle text-success' :
                                    record.estado_ventas_id.raw_value == 'con_problemas' ? 'fa-exclamation-triangle text-warning' :
                                    record.estado_ventas_id.raw_value == 'de_partes' ? 'fa-cog text-danger' :
                                    record.estado_ventas_id.raw_value == 'entregada' ? 'fa-truck text-success' :
                                    'fa-question text-secondary'}" title="Estado"/>
                    <field name="estado_ventas_id" widget="badge" decoration-success="estado_ventas_id == 'finalizado' or estado_ventas_id == 'entregada'" decoration-warning="estado_ventas_id == 'con_problemas'" decoration-danger="estado_ventas_id == 'de_partes'" decoration-info="estado_ventas_id == 'en_revision' or estado_ventas_id == 'para_revision'" decoration-primary="estado_ventas_id == 'asignado'" decoration-secondary="estado_ventas_id == 'sin_revisar'"/>
                  </div>
                  <div class="d-flex align-items-center">
                    <!-- Icono dinámico según disponibilidad -->
                    <i t-attf-class="fa me-2 #{
                                    record.disponibilidad_id.raw_value == 'disponible' ? 'fa-check-circle text-success' :
                                    record.disponibilidad_id.raw_value == 'separada' ? 'fa-bookmark text-warning' :
                                    record.disponibilidad_id.raw_value == 'no_disponible' ? 'fa-times-circle text-danger' :
                                    'fa-question text-secondary'}" title="Disponibilidad"/>
                    <field name="disponibilidad_id" widget="badge" decoration-success="disponibilidad_id == 'disponible'" decoration-warning="disponibilidad_id == 'separada'" decoration-danger="disponibilidad_id == 'no_disponible'"/>
                  </div>
                </div>

                <div class="p-3">
                  <!-- Información del Cliente y Asesora -->
                  <div class="mb-3">
                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-building text-primary me-2" title="Cliente"/>
                      <span class="text-muted me-1">Cliente:</span>
                      <field name="cliente_id" class="fw-bold"/>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-female text-pink me-2" title="Asesora"/>
                      <span class="text-muted me-1">Asesora:</span>
                      <field name="asesora_id"/>
                    </div>
                  </div>

                  <!-- Información de la Máquina -->
                  <div class="mb-3">
                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-print text-success me-2" title="Tipo"/>
                      <span class="text-muted me-1">Tipo:</span>
                      <field name="tipo_maquina"/>
                     
                    </div>

                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-trademark text-info me-2" title="Marca"/>
                      <span class="text-muted me-1">Marca:</span>
                      <field name="marca"/>
 -                     
                    </div>
										<div class="d-flex align-items-center mb-2">
                      <i class="fa fa-trademark text-info me-2" title="Modelo"/>
                      <span class="text-muted me-1">Modelo:</span>
                      <field name="name"/>
 -                     
                    </div>

                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-barcode text-secondary me-2" title="Serie"/>
                      <span class="text-muted me-1">Serie:</span>
                      
                    </div>

                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-calculator text-dark me-2" title="Contómetro"/>
                      <span class="text-muted me-1">Contómetro:</span>
                      <field name="contometro"/>
                    </div>
                  </div>

                  <!-- Precios -->
                  <div class="mb-3">
                    <div class="d-flex justify-content-between">
                      <div class="d-flex align-items-center">
                        <i class="fa fa-tag text-success me-2" title="Precio Venta"/>
                        <span class="text-muted me-1">Venta:</span>
                        <field name="precio_venta"/>
                      </div>
                      <div class="d-flex align-items-center" groups="base.group_system, sat_jefes_group_user">
                        <i class="fa fa-shopping-cart text-danger me-2" title="Precio Compra"/>
                        <span class="text-muted me-1">Compra:</span>
                        <field name="precio_compra"/>
                      </div>
                    </div>
                  </div>

                  <!-- Ubicación e Importación -->
                  <div class="mb-3">
                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-map-marker-alt text-danger me-2" title="Ubicación"/>
                      <span class="text-muted me-1">Ubicación:</span>
                      <field name="ubicacion_id"/>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-plane text-info me-2" title="Importación"/>
                      <span class="text-muted me-1">Import.:</span>
                      <field name="importacion"/>
                    </div>
                  </div>

                  <!-- Facturación -->
                  <div class="pt-2 border-top" t-if="record.factura_venta.raw_value">
                    <div class="d-flex justify-content-between align-items-center">
                      <div class="d-flex align-items-center">
                        <i class="fa fa-file-invoice text-primary me-2" title="Factura"/>
                        <span class="text-muted me-1">Factura:</span>
                        <field name="factura_venta"/>
                      </div>
                      <div class="d-flex align-items-center">
                        <i class="fa fa-calendar text-success me-2" title="Fecha Entrega"/>
                        <field name="fecha_entrega"/>
                      </div>
                    </div>
                  </div>

                  <!-- Alerta -->
                  <div t-if="record.activador.raw_value == 'si'" class="position-absolute top-0 end-0 p-2">
                    <i class="fa fa-exclamation-circle fa-lg text-danger"/>
                  </div>
                </div>

                <!-- Indicador lateral de estado -->
                <div t-attf-class="position-absolute top-0 start-0 h-100 w-1 
                            #{record.estado_ventas_id.raw_value == 'finalizado' ? 'bg-success' : 
                            record.estado_ventas_id.raw_value == 'con_problemas' ? 'bg-warning' :
                            record.estado_ventas_id.raw_value == 'de_partes' ? 'bg-danger' :
                            record.estado_ventas_id.raw_value == 'en_revision' ? 'bg-info' : 
                            record.estado_ventas_id.raw_value == 'entregada' ? 'bg-success' :
                            record.estado_ventas_id.raw_value == 'asignado' ? 'bg-primary' :
                            record.estado_ventas_id.raw_value == 'para_revision' ? 'bg-info' : 'bg-secondary'}"/>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>
    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="sat.action_reparaciones_window">
      <field name="name">Reparaciones</field>
      <field name="res_model">reparaciones.reparaciones</field>
      <field name="view_mode">list,form,graph,kanban</field>
    </record>

    <record model="ir.actions.act_window" id="sat.action_alquiler_window">
      <field name="name">Alquiler</field>
      <field name="res_model">alquiler</field>
      <field name="view_mode">list,form,calendar,graph,kanban</field>
    </record>
    <record model="ir.actions.act_window" id="sat.action_ajustes_window">
      <field name="name">Configuración</field>
      <field name="res_model">ajustes.ajustes</field>
      <field name="view_mode">list,form</field>
    </record>
    <record model="ir.actions.act_window" id="sat.action_window">
      <field name="name">Maquina</field>
      <field name="res_model">sat.sat</field>
      <field name="view_mode">list,kanban,form,pivot</field>
      <field name="help" type="html">
        <p class="button_in_tree">
          Registra un equipo
        </p>
      </field>
    </record>
    <record id="action_crear_reparaciones" model="ir.actions.server">
      <field name="name">Crear Reparaciones</field>
      <field name="model_id" ref="model_sat_sat"/>
      <field name="binding_model_id" ref="model_sat_sat"/>
      <field name="state">code</field>
      <field name="code">action = env['sat.sat'].browse(env.context.get('active_ids')).action_crear_reparaciones()</field>
  </record>
    <record model="ir.actions.act_window" id="sat.action_marca_window">
      <field name="name">Marcas</field>
      <field name="res_model">marca.marca</field>
      <field name="view_mode">list,form</field>
    </record>
    <record model="ir.actions.act_window" id="sat.action_modelo_window">
      <field name="name">Modelo</field>
      <field name="res_model">modelo.maquina</field>
      <field name="view_mode">list,form</field>
    </record>
    <record model="ir.actions.act_window" id="sat.action_tipo_window">
      <field name="name">Tipo de maquina</field>
      <field name="res_model">tipo.maquina</field>
      <field name="view_mode">list,form</field>
    </record>
    <record model="ir.actions.act_window" id="sat.action_falla_window">
      <field name="name">Fallas</field>
      <field name="res_model">fallas</field>
      <field name="view_mode">list,form</field>
    </record>
    <record model="ir.actions.act_window" id="sat.action_informe_window">
      <field name="name">Informes</field>
      <field name="res_model">informes</field>
      <field name="view_mode">list,form</field>
    </record>
    <record model="ir.actions.act_window" id="sat.action_repuestos_window">
      <field name="name">Repuestos alquiler</field>
      <field name="res_model">repuestos.alquiler</field>
      <field name="view_mode">list,form,kanban</field>
    </record>
    <!-- server action to the one above -->
    <record model="ir.actions.server" id="sat.action_server">
      <field name="name">SAT server</field>
      <field name="model_id" ref="model_sat_sat" />
      <field name="state">code</field>
      <field name="code">
        action = {
        "type": "ir.actions.act_window",
        "view_mode": "list,form",
        "res_model": model._name,
        }
      </field>
    </record>

    


    <record model="ir.actions.server" id="sat.action_server_revision">
      <field name="name">Ver Maquinas Para Revisión</field>
      <field name="model_id" ref="model_sat_sat" />
      <field name="state">code</field>
      <field name="code">
        action = {
        "type": "ir.actions.act_window",
        "view_mode": "list",
        "res_model": "sat.sat",
        "domain": [('estado_ventas_id', '=', 'para_revision')],
        "context": {'order': 'fecha_para_revision asc'},
        }
      </field>
    </record>

    <!-- menu categories -->
    <menuitem name="Maquinas" id="sat.stock_maquinas" parent="sat_menu_root" action="sat.action_window" sequence="10" />
    <menuitem name="Reparaciones" id="sat.reparaciones" parent="sat_menu_root" action="sat.action_reparaciones_window" sequence="20" />
    <menuitem name="Alquiler" id="sat.alquiler" parent="sat_menu_root" action="sat.action_alquiler_window" sequence="30" />
    <menuitem name="Repuestos" id="sat.repuestos" parent="sat_menu_root" action="sat.action_repuestos_window" sequence="40" />

    <menuitem name="Configuración" id="sat.ajustes" parent="sat_menu_root" sequence="80" />
    <!-- actions -->
    <menuitem name="Marcas" id="sat.menu_marca" parent="sat.ajustes" action="sat.action_marca_window" />
    <menuitem name="Modelo" id="sat.menu_modelo" parent="sat.ajustes" action="sat.action_modelo_window" />
    <menuitem name="Tipo de maquina" id="sat.menu_tipo" parent="sat.ajustes" action="sat.action_tipo_window" />
    <menuitem name="Registro de fallas" id="sat.menu_fallas" parent="sat.ajustes" action="sat.action_falla_window" />
    <menuitem name="Informes proveedor" id="sat.menu_informes" parent="sat.ajustes" action="sat.action_informe_window" />
  </data>
</odoo>
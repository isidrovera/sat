<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="maquinas_form_view" model="ir.ui.view">
    <field name="name">Sat.form</field>
    <field name="model">sat.sat</field>
    <field name="arch" type="xml">
        <form string="Gestión de Equipos">
            <header>
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div class="d-flex gap-2">
                        <button name="send_records_by_email" type="object" 
                            class="btn btn-primary"
                            icon="fa-paper-plane">
                            <i class="fa fa-paper-plane me-2"/>Enviar Reporte
                        </button>

                        <button name="create_reparacion" type="object" 
                            class="btn btn-success"
                            icon="fa-wrench" 
                            groups="base.group_system">
                            <i class="fa fa-wrench me-2"/>Nueva Reparación
                        </button>

                        <button name="action_crear_reparaciones" 
                            string="Crear Reparaciones" 
                            type="object" 
                            class="btn btn-info">
                            <i class="fa fa-tools me-2"/>Crear Reparaciones
                        </button>
                    </div>
                    
                    <div class="d-flex gap-2">
                        <field name="disponibilidad_id" widget="statusbar" statusbar_visible="true" class="ms-3"/>
                        <field name="estado_ventas_id" widget="statusbar" options="{'clickable': '1'}" 
                               class="ms-3 custom_statusbar" groups="base.group_system"/>
                    </div>
                </div>
            </header>

            <!-- Alertas -->
            <div class="alert alert-danger d-flex align-items-center" role="alert" 
                 invisible="activador == 'no'">
                <i class="fa fa-exclamation-triangle me-2"/>
                <div>
                    ¡Esta máquina tiene observaciones: 
                    <field name='descripcion' class="text-danger"/>
                    Si está separando o vendiendo revise antes, consulte con el área correspondiente!
                </div>
            </div>

            <div class="alert alert-warning d-flex align-items-center" role="alert" 
                 invisible="ubicacion_id == 'primer_piso' or ubicacion_id == 'tercer_piso'">
                <i class="fa fa-exclamation-circle me-2"/>
                <div>
                    ¡Esta máquina está en el almacén 
                    <field name="ubicacion_id" class="badge bg-warning text-dark"/>
                    Si está separando o vendiendo, avisar con anticipación para que pueda ser traída.
                </div>
            </div>

            <sheet>
                <!-- Botones Estadísticos -->
                <div class="oe_button_box" name="button_box">
                    <button name="view_reparaciones_ids" type="object" 
                            class="oe_stat_button" icon="fa-wrench">
                        <div class="o_stat_info">
                            <field name="reparaciones_count" class="o_stat_value"/>
                            <span class="o_stat_text">Reparaciones</span>
                        </div>
                    </button>
                </div>

                <!-- Título y Cliente -->
                <div class="oe_title">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa fa-building text-primary me-2"/>
                        <h1 class="mb-0">
                            <field name="cliente_id" 
                                   domain="[('tipo_cliente', '=', 'distribuidor')]" 
                                   placeholder="Datos del Cliente" 
                                   widget="many2one_avatar" 
                                   options="{'no_create': True}"/>
                        </h1>
                    </div>
                </div>

                <div class="row">
                    <!-- Datos del Equipo -->
                    <div class="col-12 col-md-6">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <i class="fa fa-print me-2"/>Datos del Equipo
                            </div>
                            <div class="card-body">
                                <group>
                                    <field name="tipo_maquina" icon="fa-tag"/>
                                    <field name="marca" icon="fa-trademark"/>
                                    <field name="name" options="{'no_create': True}" icon="fa-cube"/>
                                    <field name="serie_id" icon="fa-barcode"/>
                                    <field name="contometro" icon="fa-tachometer-alt"/>
                                    <field name="ubicacion_id" icon="fa-map-marker-alt"/>
                                    <field name="fecha_separacion" 
                                           invisible="disponibilidad_id == 'disponible'" 
                                           readonly="1" 
                                           icon="fa-calendar"/>
                                </group>
                            </div>
                        </div>
                    </div>

                    <!-- Datos de Importación -->
                    <div class="col-12 col-md-6">
                        <div class="card">
                            <div class="card-header bg-success text-white">
                                <i class="fa fa-ship me-2"/>Datos de Importación
                            </div>
                            <div class="card-body">
                                <group>
                                    <field name="proveedor_id" 
                                           domain="[('tipo_cliente', '=', 'proveedor')]" 
                                           options="{'no_create': True}" 
                                           icon="fa-user-tie"/>
                                    <field name="importacion" icon="fa-boxes"/>
                                    <field name="invoice" icon="fa-file-invoice"/>
                                </group>
                            </div>
                        </div>
                    </div>

                    <!-- Datos para revisión -->
                    <div class="col-12 col-md-6 mt-3">
                        <div class="card">
                            <div class="card-header bg-danger text-white">
                                <i class="fa fa-clipboard-check me-2"/>Datos para Revisión
                            </div>
                            <div class="card-body">
                                <group>
                                    <field name="tipo_revision" 
                                           widget="kanban_label_selection" 
                                           options="{'classes': {'draft': 'default', 'done': 'success'}}" 
                                           icon="fa-tasks"/>
                                    <field name="prioridad" widget="priority" icon="fa-flag"/>
                                </group>
                            </div>
                        </div>
                    </div>

                    <!-- Notificaciones -->
                    <div class="col-12 col-md-6 mt-3">
                        <div class="card">
                            <div class="card-header bg-info text-white">
                                <i class="fa fa-bell me-2"/>Notificaciones
                            </div>
                            <div class="card-body">
                                <group>
                                    <field name="trabajadores_id" widget="many2one_avatar" icon="fa-user-cog"/>
                                    <field name="asesora_id" icon="fa-user"/>
                                    <field name="fecha_para_revision" icon="fa-calendar-alt"/>
                                    <field name="autorizacion_cambio_digitos" icon="fa-lock"/>
                                </group>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pestañas -->
                <notebook class="mt-4">
                    <page string="Observaciones del equipo" icon="fa-sticky-note">
                        <div class="card">
                            <div class="card-body">
                                <field name="descripcion" placeholder="Ingrese las observaciones aquí..."
                                       class="form-control"/>
                                <field name="activador" invisible="1"/>
                            </div>
                        </div>
                    </page>

                    <page string="Precios" icon="fa-dollar-sign">
                        <div class="card">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Precio de Venta</label>
                                            <field name="precio_venta" 
                                                   widget="monetary" 
                                                   options="{'currency_field': 'currency_id'}" 
                                                   groups="base.group_system, sat.Sat_ventas_group_user"
                                                   class="form-control"/>
                                        </div>
                                        <div class="form-group mt-3">
                                            <label>Moneda</label>
                                            <field name="currency_id" class="form-control"/>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Precio de Compra</label>
                                            <field name="precio_compra" 
                                                   widget="monetary" 
                                                   options="{'currency_field': 'currency_id'}" 
                                                   groups="base.group_system"
                                                   class="form-control"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </page>

                    <page string="Logística" icon="fa-truck">
                        <div class="card">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Factura de Venta</label>
                                            <field name="factura_venta" class="form-control"/>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Fecha de Entrega</label>
                                            <field name="fecha_entrega" class="form-control"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </page>
                </notebook>
            </sheet>
            <div class="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="activity_ids"/>
                <field name="message_ids"/>
            </div>
        </form>
    </field>
</record>

    <record id="maquinas_tree_sat" model="ir.ui.view">
      <field name="name">sat.tree</field>
      <field name="model">sat.sat</field>
      <field name="type">list</field>
      <field name="arch" type="xml">
        <list default_order="id desc">


          <!-- Lista de registros -->
          <field name="create_date" string="Ingreso" widget="remaining_days" width="80%" optional="hide" />
          <field name="fecha_separacion" string="Separada" widget="remaining_days" width="80%" invisible="disponibilidad_id != 'separada'" optional="hide" />
          <field name="fecha_para_revision" string="Fecha para revisión" optional="hide" />
          <field name="importacion" optional="hide" />
          <field name="proveedor_id" optional="hide" />
          <field name="cliente_nombre" string="Cliente" />
          <field name="tipo_maquina" />
          <field name="marca" />
          <field name="activador" optional="hide" />
          <field name="icono_rojo" widget="html" string=" " invisible="activador == 'no'" />
          <field name="name" />
          <field name="serie_id" />
          <field name="descripcion" optional="hide" />
          <field name="contometro" />
          <field name="currency_id" string="Tipo de moneda" optional="hide" />
          <field name="precio_compra" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide" groups="base.group_system" />
          <field name="ubicacion_id" />
          <field name="disponibilidad_id" widget="badge" decoration-success="disponibilidad_id == 'disponible'" decoration-warning="disponibilidad_id == 'separada'" decoration-danger="disponibilidad_id == 'no_disponible'" />
          <field name="estado_ventas_id" widget="badge" decoration-muted="estado_ventas_id == 'sin_revisar'" decoration-info="estado_ventas_id == 'en_revision'" decoration-success="estado_ventas_id == 'finalizado'" decoration-danger="estado_ventas_id not in ('sin_revisar', 'en_revision', 'finalizado', 'entregada')" decoration-warning="estado_ventas_id == 'entregada'" />
          <field name="asesora_id" optional="hide" />
          <button name="action_primer" type="object" class="oe_stat_button" icon="fa-building-o" groups="base.group_system" help="Primer piso" />
          <button name="action_tercero" type="object" class="oe_stat_button" icon="fa-building" groups="base.group_system" help="Tercer piso" />
          <button name="action_segundo" type="object" class="oe_stat_button" icon="fa-truck" groups="base.group_system" help="Segundo local" />
          <field name="activity_ids" widget="list_activity" optional="hide" />
          <button name="view_reparaciones_ids" type="object" icon="fa-wrench" invisible="estado_ventas_id != 'finalizado'" />
        </list>
      </field>
    </record>



    <!-- Búsqueda -->
    <record id="Sat_search_view" model="ir.ui.view">
      <field name="name">sat.sat.search</field>
      <field name="model">sat.sat</field>
      <field name="arch" type="xml">
        <search string="ModelTitle">
          <group>
            <filter name="disponibilidad_id" string="Disponibles" domain="[('disponibilidad_id', '=', 'disponible')]" />
            <filter name="separadas_id" string="Separadas" domain="[('disponibilidad_id', '=', 'separada')]" />
            <filter name="no_disponibles_id" string="No disponibles" domain="[('disponibilidad_id', '=', 'no_disponible')]" />
            <filter name="sin_revisar_id" string="Sin revisar" domain="[('estado_ventas_id', '=', 'sin_revisar')]" />
            <filter name="revision_id" string="En revisión" domain="[('estado_ventas_id', '=', 'en_revision')]" />
            <filter name="finalizado_id" string="Finalizado" domain="[('estado_ventas_id', '=', 'finalizado')]" />
            <filter name="problemas_id" string="Con problemas" domain="[('estado_ventas_id', '=', 'con_problemas')]" />
            <filter name="partes_id" string="De partes" domain="[('estado_ventas_id', '=', 'de_partes')]" />
            <filter name="entregada_id" string="Entregada" domain="[('estado_ventas_id', '=', 'entregada')]" />
          </group>

          <field name="tipo_maquina" />
          <field name="marca" />
          <field name="name" />
          <field name="serie_id" />
          <field name="cliente_id" string="Cliente" />
          <field name="ubicacion_id" />
          <field name="asesora_id" />
          <searchpanel>
            <field name="estado_ventas_id" string="Estado" icon="fa-hourglass-start" enable_counters="1" colors='{"sin_revisar": "red", "en_revision": "blue", "finalizado": "green", "entregada": "purple"}' />
            <field name="disponibilidad_id" string="Disponibilidad" icon="fa-check-circle" enable_counters="1" colors='{"disponible": "green", "separada": "orange", "no_disponible": "red"}' />
          </searchpanel>
        </search>
      </field>
    </record>

    <!-- Kanban -->
    <record id="maquinas_kanban_view" model="ir.ui.view">
      <field name="name">maquinas.kanban</field>
      <field name="model">sat.sat</field>
      <field name="arch" type="xml">
        <kanban default_group_by="estado_ventas_id" class="o_kanban_dashboard" sample="1">
          <field name="id"/>
          <field name="name"/>
          <field name="cliente_id"/>
          <field name="tipo_maquina"/>
          <field name="marca"/>
          <field name="serie_id"/>
          <field name="contometro"/>
          <field name="disponibilidad_id"/>
          <field name="estado_ventas_id"/>
          <field name="tipo_id"/>
          <field name="precio_venta"/>
          <field name="precio_compra"/>
          <field name="asesora_id"/>
          <field name="ubicacion_id"/>
          <field name="importacion"/>
          <field name="descripcion"/>
          <field name="factura_venta"/>
          <field name="fecha_entrega"/>
          <field name="activador"/>

          <progressbar field="estado_ventas_id" colors='{"finalizado": "success", 
                        "con_problemas": "warning", 
                        "de_partes": "danger",
                        "en_revision": "info",
                        "sin_revisar": "secondary",
                        "entregada": "primary"}'/>

          <templates>
            <t t-name="card">
              <div class="oe_kanban_global_click position-relative shadow-sm rounded">
                <!-- Header con estado y disponibilidad -->
                <div class="d-flex justify-content-between align-items-center p-2 bg-light border-bottom">
                  <div class="d-flex align-items-center">
                    <!-- Icono dinámico según estado -->
                    <i t-attf-class="fa me-2 #{
                                    record.estado_ventas_id.raw_value == 'sin_revisar' ? 'fa-clock text-secondary' :
                                    record.estado_ventas_id.raw_value == 'para_revision' ? 'fa-search text-info' :
                                    record.estado_ventas_id.raw_value == 'asignado' ? 'fa-user-check text-primary' :
                                    record.estado_ventas_id.raw_value == 'en_revision' ? 'fa-tools text-info' :
                                    record.estado_ventas_id.raw_value == 'finalizado' ? 'fa-check-circle text-success' :
                                    record.estado_ventas_id.raw_value == 'con_problemas' ? 'fa-exclamation-triangle text-warning' :
                                    record.estado_ventas_id.raw_value == 'de_partes' ? 'fa-cog text-danger' :
                                    record.estado_ventas_id.raw_value == 'entregada' ? 'fa-truck text-success' :
                                    'fa-question text-secondary'}" title="Estado"/>
                    <field name="estado_ventas_id" widget="badge" decoration-success="estado_ventas_id == 'finalizado' or estado_ventas_id == 'entregada'" decoration-warning="estado_ventas_id == 'con_problemas'" decoration-danger="estado_ventas_id == 'de_partes'" decoration-info="estado_ventas_id == 'en_revision' or estado_ventas_id == 'para_revision'" decoration-primary="estado_ventas_id == 'asignado'" decoration-secondary="estado_ventas_id == 'sin_revisar'"/>
                  </div>
                  <div class="d-flex align-items-center">
                    <!-- Icono dinámico según disponibilidad -->
                    <i t-attf-class="fa me-2 #{
                                    record.disponibilidad_id.raw_value == 'disponible' ? 'fa-check-circle text-success' :
                                    record.disponibilidad_id.raw_value == 'separada' ? 'fa-bookmark text-warning' :
                                    record.disponibilidad_id.raw_value == 'no_disponible' ? 'fa-times-circle text-danger' :
                                    'fa-question text-secondary'}" title="Disponibilidad"/>
                    <field name="disponibilidad_id" widget="badge" decoration-success="disponibilidad_id == 'disponible'" decoration-warning="disponibilidad_id == 'separada'" decoration-danger="disponibilidad_id == 'no_disponible'"/>
                  </div>
                </div>

                <div class="p-3">
                  <!-- Información del Cliente y Asesora -->
                  <div class="mb-3">
                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-building text-primary me-2" title="Cliente"/>
                      <span class="text-muted me-1">Cliente:</span>
                      <field name="cliente_id" class="fw-bold"/>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-female text-pink me-2" title="Asesora"/>
                      <span class="text-muted me-1">Asesora:</span>
                      <field name="asesora_id"/>
                    </div>
                  </div>

                  <!-- Información de la Máquina -->
                  <div class="mb-3">
                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-print text-success me-2" title="Tipo"/>
                      <span class="text-muted me-1">Tipo:</span>
                      <field name="tipo_maquina"/>
                      <span class="badge bg-info ms-2">
                        <field name="tipo_id"/>
                      </span>
                    </div>

                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-trademark text-info me-2" title="Marca"/>
                      <span class="text-muted me-1">Marca/Modelo:</span>
                      <field name="marca"/>
 -                      <field name="name"/>
                    </div>

                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-barcode text-secondary me-2" title="Serie"/>
                      <span class="text-muted me-1">Serie:</span>
                      <field name="serie_id"/>
                    </div>

                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-calculator text-dark me-2" title="Contómetro"/>
                      <span class="text-muted me-1">Contómetro:</span>
                      <field name="contometro"/>
                    </div>
                  </div>

                  <!-- Precios -->
                  <div class="mb-3">
                    <div class="d-flex justify-content-between">
                      <div class="d-flex align-items-center">
                        <i class="fa fa-tag text-success me-2" title="Precio Venta"/>
                        <span class="text-muted me-1">Venta:</span>
                        <field name="precio_venta"/>
                      </div>
                      <div class="d-flex align-items-center">
                        <i class="fa fa-shopping-cart text-danger me-2" title="Precio Compra"/>
                        <span class="text-muted me-1">Compra:</span>
                        <field name="precio_compra"/>
                      </div>
                    </div>
                  </div>

                  <!-- Ubicación e Importación -->
                  <div class="mb-3">
                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-map-marker-alt text-danger me-2" title="Ubicación"/>
                      <span class="text-muted me-1">Ubicación:</span>
                      <field name="ubicacion_id"/>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                      <i class="fa fa-plane text-info me-2" title="Importación"/>
                      <span class="text-muted me-1">Import.:</span>
                      <field name="importacion"/>
                    </div>
                  </div>

                  <!-- Facturación -->
                  <div class="pt-2 border-top" t-if="record.factura_venta.raw_value">
                    <div class="d-flex justify-content-between align-items-center">
                      <div class="d-flex align-items-center">
                        <i class="fa fa-file-invoice text-primary me-2" title="Factura"/>
                        <span class="text-muted me-1">Factura:</span>
                        <field name="factura_venta"/>
                      </div>
                      <div class="d-flex align-items-center">
                        <i class="fa fa-calendar text-success me-2" title="Fecha Entrega"/>
                        <field name="fecha_entrega"/>
                      </div>
                    </div>
                  </div>

                  <!-- Alerta -->
                  <div t-if="record.activador.raw_value == 'si'" class="position-absolute top-0 end-0 p-2">
                    <i class="fa fa-exclamation-circle fa-lg text-danger"/>
                  </div>
                </div>

                <!-- Indicador lateral de estado -->
                <div t-attf-class="position-absolute top-0 start-0 h-100 w-1 
                            #{record.estado_ventas_id.raw_value == 'finalizado' ? 'bg-success' : 
                            record.estado_ventas_id.raw_value == 'con_problemas' ? 'bg-warning' :
                            record.estado_ventas_id.raw_value == 'de_partes' ? 'bg-danger' :
                            record.estado_ventas_id.raw_value == 'en_revision' ? 'bg-info' : 
                            record.estado_ventas_id.raw_value == 'entregada' ? 'bg-success' :
                            record.estado_ventas_id.raw_value == 'asignado' ? 'bg-primary' :
                            record.estado_ventas_id.raw_value == 'para_revision' ? 'bg-info' : 'bg-secondary'}"/>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>
    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="sat.action_reparaciones_window">
      <field name="name">Reparaciones</field>
      <field name="res_model">reparaciones.reparaciones</field>
      <field name="view_mode">list,form,graph,kanban</field>
    </record>

    <record model="ir.actions.act_window" id="sat.action_alquiler_window">
      <field name="name">Alquiler</field>
      <field name="res_model">alquiler</field>
      <field name="view_mode">list,form,calendar,graph</field>
    </record>
    <record model="ir.actions.act_window" id="sat.action_ajustes_window">
      <field name="name">Configuración</field>
      <field name="res_model">ajustes.ajustes</field>
      <field name="view_mode">list,form</field>
    </record>
    <record model="ir.actions.act_window" id="sat.action_window">
      <field name="name">Maquina</field>
      <field name="res_model">sat.sat</field>
      <field name="view_mode">list,kanban,form,pivot</field>
      <field name="help" type="html">
        <p class="button_in_tree">
          Registra un equipo
        </p>
      </field>
    </record>
    <record model="ir.actions.act_window" id="sat.action_marca_window">
      <field name="name">Marcas</field>
      <field name="res_model">marca.marca</field>
      <field name="view_mode">list,form</field>
    </record>
    <record model="ir.actions.act_window" id="sat.action_modelo_window">
      <field name="name">Modelo</field>
      <field name="res_model">modelo.maquina</field>
      <field name="view_mode">list,form</field>
    </record>
    <record model="ir.actions.act_window" id="sat.action_tipo_window">
      <field name="name">Tipo de maquina</field>
      <field name="res_model">tipo.maquina</field>
      <field name="view_mode">list,form</field>
    </record>
    <record model="ir.actions.act_window" id="sat.action_falla_window">
      <field name="name">Fallas</field>
      <field name="res_model">fallas</field>
      <field name="view_mode">list,form</field>
    </record>

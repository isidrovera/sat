<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  WIZARD: Diagnóstico GPS Tracking                          -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <record id="view_tracking_diagnostico_form" model="ir.ui.view">
        <field name="name">tracking.diagnostico.form</field>
        <field name="model">tracking.diagnostico</field>
        <field name="arch" type="xml">
            <form string="Diagnóstico GPS Tracking">
                <sheet>
                    <div class="oe_title">
                        <h1>🔍 Diagnóstico GPS Tracking</h1>
                        <p class="text-muted">
                            Verifica la cadena completa: Vínculos → Tickets → Agenda → Simulación
                        </p>
                    </div>

                    <group string="Filtros (opcional)">
                        <group>
                            <field name="tecnico_id"
                                   placeholder="Dejar vacío para todos los técnicos"/>
                            <field name="simular_evento"/>
                        </group>
                    </group>

                    <div class="text-center mt-3 mb-3">
                        <button name="action_diagnosticar"
                                type="object"
                                string="▶  Ejecutar diagnóstico"
                                class="btn btn-primary btn-lg"/>
                    </div>

                    <group string="Resultado" invisible="not resultado">
                        <field name="resultado"
                               nolabel="1"
                               widget="text"
                               style="font-family: monospace; font-size: 12px; background: #1e1e1e; color: #d4d4d4; padding: 16px; border-radius: 6px; white-space: pre;"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Botón en el header del formulario del ticket -->
    <record id="view_ticket_form_diagnostico" model="ir.ui.view">
        <field name="name">ticket.alquiler.form.diagnostico</field>
        <field name="model">ticket.alquiler</field>
        <field name="inherit_id" ref="sat.soporte_form_viw"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='tracking_gps_page']//group[last()]" position="after">
                <div class="mt-3">
                    <button name="action_abrir_diagnostico_gps"
                            string="🔍 Diagnóstico GPS de este técnico"
                            type="object"
                            class="btn btn-secondary"
                            invisible="not responsable"/>
                </div>
            </xpath>
        </field>
    </record>

 
</data>
</odoo>
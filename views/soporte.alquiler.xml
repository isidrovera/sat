<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="soporte_form_viw" model="ir.ui.view">
            <field name="name">soporte_ticket.form</field>
            <field name="model">ticket.alquiler</field>
            <field name="arch" type="xml">
                <form string="">
                    <header>
                        <field name="estado" widget="statusbar" options="{'clickable_group': 'base.group_system'}"/>
                        <button string="Cerrar" name="action_finalizar" type="object" class="btn btn-info" icon="fa-wrench" invisible="estado !='proceso'" />
                        <button name="action_cargar_contadores"
        type="object"
        string="🔄 Cargar Contadores"
        class="btn-primary"
        icon="fa-download"
        
        options="{'no_required_fields_validation': true}"
        confirm="¿Está seguro de que desea cargar los contadores desde el equipo? Esto sobrescribirá los valores actuales en los campos de contómetros."
        help="Carga automáticamente los contadores desde el equipo cuando las fechas de agenda y última actualización coinciden"/>
                        <button class="oe_highlight" name="action_asignar_ticket" type="object" icon="fa-paper-plane" string="Asignar Ticket" invisible="estado != 'nuevo'" />
                        <button name="action_crear_evaluacion" string="Generar Evaluación" type="object"                          
                            icon="fa-check-circle"  groups="base.group_system"/>
                        <button string="Proceso" name="action_proceso" type="object" class="oe_highlight" groups="base.group_system" />
                        <button string="Nuevo" name="action_nuevo" type="object" class="oe_highlight" groups="base.group_system" options="{'no_required_fields_validation': true}" />
                        <button string="Crear pedido" name="create_sale_order" type="object" class="oe_highlight"  groups="base.group_system"/>
                    </header>
                    <sheet>
                        <div name="button_box">
                            <button class="oe_stat_button" type="object" name="get_pedidos" icon="fa-cart-plus">
                                <field string="Pedido" name="pedidos_count" widget="statinfo" />
                            </button>
                            <button class="oe_stat_button" type="object" name="get_repuestos_ticket" icon="fa-cogs" style="background-color: #FF0000;">
                                <field string="Repuestos" name="repuestos_count_ticket" widget="statinfo" />
                            </button>
                        </div>
                        <div class="alert alert-info" 
                            invisible="estado != 'proceso' or mostrar_boton_contadores == True">
                            <strong>ℹ️ Información:</strong> Los contadores se pueden cargar automáticamente cuando:
                            <ul>
                                <li>El ticket esté en proceso</li>
                                <li>Existan lecturas de PrintTracker para este equipo</li>
                                <li>Existan correos procesados para este equipo</li>
                                <li>El equipo tenga contadores registrados</li>
                            </ul>
                        </div>

                        <!-- Alerta de éxito (cuando SÍ puede cargar) -->
                        <div class="alert alert-success" 
                            invisible="mostrar_boton_contadores == False">
                            <strong>✅ Disponible:</strong> Se encontraron contadores para cargar automáticamente.
                            <br/>
                            <small>El sistema buscará en PrintTracker, correos y registros del equipo.</small>
                        </div>
                        <div class="oe_title">
                            <label for="name" />
                            <h1>
                                <field name="name" />
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="marca_id_r" />
                                <field name="product_alquiler" readonly="1" />
                                <field name="serie_id_r" />
                                <!--<field name="modelo_id_r" />-->
                                <field name="contometrok_id" />
                                <field name="contometroc_id" invisible="tipo_id != 'color'" readonly="estado == 'finalizado'" />
                                <field name="contometros_id"  />
                                <field name="total_copias_id" invisible="1" />
                                <field name="tipo_id" invisible="1" />
                                <field name="url" invisible="1" />
                                <field name="mostrar_boton_contadores" invisible="1"/>

                            </group>
                            <group>
                                <field name="partner_id" widget="many2one_avatar" readonly="1" />
                                <field name="direccion_id_r" readonly="estado == 'proceso' or estado == 'finalizado'"/>
                                <field name="contacto_id_r" readonly="estado == 'proceso' or estado == 'finalizado'"/>
                                <field name="tipo_servicio_id" readonly="estado == 'proceso' or estado == 'finalizado'" />
                                <field name="retorno_id" />
                                <field name="asistencia_id" readonly="estado == 'proceso' or estado == 'finalizado'"/>
                                <field name="agenda" required="estado =='nuevo'" readonly="estado == 'proceso' or estado == 'finalizado'" />
                                <field name="agenda_local" readonly="1" />
                                <field name="responsable" widget="many2one_avatar" required="estado == 'nuevo'" readonly="estado == 'proceso' or estado == 'finalizado'" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Problema Reportado">
                                <group>
                                    <group>
                                        <field name="description" required="estado == 'nuevo'" readonly="estado == 'proceso' or estado == 'finalizado'"/>
                                    </group>
                                    <group>
                                        <field name="reporter_name" readonly="estado == 'proceso' or estado == 'finalizado'"/>
                                        <field name="reporter_phone" widget="phone" readonly="estado == 'proceso' or estado == 'finalizado'"/>
                                        <field name="problem_photo" widget="image" readonly="estado == 'proceso' or estado == 'finalizado'"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Informe Técnico">
                                <group>
                                    <field name="informe_id"  readonly="estado == 'finalizado'"/>
                                </group>
                            </page>
                            <page string="Accesorios">
                                <group>
                                    <group>
                                        <field name="tray_id" placeholder="Detalla la cantidad de caseteras." readonly="estado == 'finalizado'"/>
                                        <field name="adf_simple_id" readonly="estado == 'finalizado'"/>
                                        <field name="adf_dual_id" readonly="estado == 'finalizado'" />
                                        <field name="finalizador_interno_id" readonly="estado == 'finalizado'"/>
                                        <field name="finalizador_externo_id" readonly="estado == 'finalizado'"/>
                                        <field name="transformador_id" readonly="estado == 'finalizado'" />
                                        <field name="estabilizador" readonly="estado == 'finalizado'"/>
                                    </group>
                                    <group>
                                        <field name="mueble_id" readonly="estado == 'finalizado'"/>
                                        <field name="panel_normal_id" readonly="estado == 'finalizado'"/>
                                        <field name="panel_smart_id" readonly="estado == 'finalizado'"/>
                                        <field name="wi_fi_id" readonly="estado == 'finalizado'"/>
                                        <field name="bluetooth_id" readonly="estado == 'finalizado'"/>
                                        <field name="cable_usb_id" readonly="estado == 'finalizado'"/>
                                        <field name="cable_red_id" readonly="estado == 'finalizado'"/>

                                    </group>
                                </group>
                            </page>
                            <page string="Check List">
                                <group>
                                    <group>
                                        <field name="calidad_id"  readonly="estado == 'finalizado'"/>
                                        <field name="copia_id"  readonly="estado == 'finalizado'" />
                                        <field name="impresion_id" readonly="estado == 'finalizado'" />
                                        <field name="impresion_usb_id"  readonly="estado == 'finalizado'"/>
                                        <field name="scaner_smb_id"  readonly="estado == 'finalizado'"/>
                                        <field name="scaner_usb_id"  readonly="estado == 'finalizado'"/>
                                        <field name="scaner_ftp_id"  readonly="estado == 'finalizado'"/>
                                        <field name="scaner_mail_id" readonly="estado == 'finalizado'"/>
                                        <field name="toner_black_id"  readonly="estado == 'finalizado'"/>
                                        <field name="toner_magenta_id"  invisible="tipo_id != 'color'" readonly="estado == 'finalizado'"/>
                                        <field name="toner_cyan_id"  invisible="tipo_id != 'color'" readonly="estado == 'finalizado'"/>
                                        <field name="toner_yellow_id"  invisible="tipo_id != 'color'" readonly="estado == 'finalizado'"/>
                                        <field name="bypass_id"  readonly="estado == 'finalizado'"/>
                                        <field name="tray1_id"  readonly="estado == 'finalizado'"/>
                                    </group>
                                    <group>
                                        <field name="tray2_id"  readonly="estado == 'finalizado'"/>
                                        <field name="tray3_id"  readonly="estado == 'finalizado'"/>
                                        <field name="tray4_id" readonly="estado == 'finalizado'"/>
                                        <field name="adf_id"  readonly="estado == 'finalizado'"/>
                                        <field name="finalizador_id" readonly="estado == 'finalizado'"/>
                                        <field name="tacho_id"  readonly="estado == 'finalizado'"/>
                                        <field name="fusora_id"  readonly="estado == 'finalizado'"/>
                                        <field name="transfer_id"  readonly="estado == 'finalizado'"/>
                                        <field name="optico_id" readonly="estado == 'finalizado'"/>
                                        <field name="black_id"  readonly="estado == 'finalizado'"/>
                                        <field name="magenta_id"  invisible="tipo_id != 'color'" readonly="estado == 'finalizado'"/>
                                        <field name="cyan_id"  invisible="tipo_id != 'color'" readonly="estado == 'finalizado'"/>
                                        <field name="yellow_id"  invisible="tipo_id != 'color'" readonly="estado == 'finalizado'"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Productos">
                                <field name="line_ids" context="{'default_ticket_id': id}">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="product_uom_qty"/>
                                        <field name="price_unit" optional="hide"/>
                                        <field name="price_subtotal" readonly="True" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>

        <record id="ticket_tree_view" model="ir.ui.view">
            <field name="name">ticket_alquiler.tree</field>
            <field name="model">ticket.alquiler</field>
            <field name="arch" type="xml">
                <list default_order="id desc">
                    <field name="name" />
                    <field name="partner_id" />
                    <field name="direccion_id_r" optional="hide" />
                    <field name="product_alquiler" string="Equipo" />
                    <field name="serie_id_r" />
                    <field name="tipo_servicio_id" widget="badge" />
                    <field name="agenda" widget="remaining_days" />
                    <field name="asistencia_id" widget="badge" optional="hide" />
                    <field name="responsable" widget="many2one_avatar" />
                    <button string=" " name="action_nuevo" type="object" class="oe_highlight" icon="fa-exchange" />
                    <field name="estado" widget="badge" decoration-success="estado == 'finalizado' " decoration-warning="estado == 'proceso' " />

                </list>
            </field>
        </record>
        <record id="model_name_view_kanban" model="ir.ui.view">
            <field name="name">ticket.view.kanban</field>
            <field name="model">ticket.alquiler</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_dashboard" default_group_by="estado" sample="1">
                    <field name="name" />
                    <field name="partner_id" />
                    <field name="product_alquiler" />
                    <field name="agenda" />
                    <field name="tipo_servicio_id" />
                    <field name="estado" />
                    <field name="description" />
                    <field name="informe_id" />
                    <field name="responsable" />

                    <progressbar field="estado" colors='{"finalizado": "success", "nuevo": "danger", "proceso": "info"}' />

                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click position-relative shadow-sm rounded">
                                <!-- Header con número de ticket y badge de estado -->
                                <div class="d-flex justify-content-between align-items-center p-2">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-hashtag text-muted me-1"/>
                                        <field name="name" class="h6 mb-0"/>
                                    </div>
                                    <field name="estado" widget="badge" decoration-danger="estado == 'nuevo'" decoration-warning="estado == 'proceso'" decoration-success="estado == 'finalizado'"/>
                                </div>

                                <!-- Contenido principal -->
                                <div class="p-3">
                                    <!-- Cliente -->
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fa fa-building text-info me-2" style="width: 20px;"/>
                                        <span class="text-muted me-2">Cliente:</span>
                                        <field name="partner_id" class="fw-bold"/>
                                    </div>

                                    <!-- Equipo -->
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fa fa-print text-success me-2" style="width: 20px;"/>
                                        <span class="text-muted me-2">Equipo:</span>
                                        <field name="product_alquiler"/>
                                    </div>
                                     <!-- Serie -->
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fa fa-qrcode text-secondary me-2" style="width: 20px;"/>
                                        <span class="text-muted me-1">Serie:</span>
                                        <field name="serie_id_r"/>
                                    </div>

                                    <!-- Servicio -->
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fa fa-tools text-primary me-2" style="width: 20px;"/>
                                        <span class="text-muted me-2">Servicio:</span>
                                        <field name="tipo_servicio_id" widget="badge"/>
                                    </div>

                                    <!-- Descripción -->
                                    <div class="d-flex align-items-start mb-2" t-if="record.description.raw_value">
                                        <i class="fa fa-comment text-danger me-2" style="width: 20px;"/>
                                        <div>
                                            <span class="text-muted">Descripción:</span>
                                            <div class="text-danger">
                                                <field name="description"/>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Informe -->
                                    <div class="d-flex align-items-start mb-2" t-if="record.informe_id.raw_value">
                                        <i class="fa fa-file-alt text-success me-2" style="width: 20px;"/>
                                        <div>
                                            <span class="text-muted">Informe:</span>
                                            <div class="text-success">
                                                <field name="informe_id"/>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Fecha -->
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fa fa-calendar text-warning me-2" style="width: 20px;"/>
                                        <span class="text-muted me-2">Fecha:</span>
                                        <field name="agenda"/>
                                    </div>

                                    <!-- Separador -->
                                    <div class="border-top my-2"></div>

                                    <!-- Responsable y Estrellas -->
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center">
                                            <i class="fa fa-user text-secondary me-2" style="width: 20px;"/>
                                            <span class="text-muted me-2"></span>
                                            <field name="responsable" widget="many2one_avatar"/>
                                        </div>
                                        <div>
                                            <field name="priority" widget="priority"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Indicador lateral de estado -->
                                <div t-attf-class="position-absolute top-0 start-0 h-100 w-1 
                            #{record.estado.raw_value == 'finalizado' ? 'bg-success' : 
                            record.estado.raw_value == 'proceso' ? 'bg-warning' : 'bg-danger'}"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="ticket_graph" model="ir.ui.view">
            <field name="name">ticket.graph</field>
            <field name="model">ticket.alquiler</field>
            <field name="arch" type="xml">
                <graph string="Distribución de Tickets por Servicio" type="bar" stacked="True">
                    <field name="responsable" />
                    <field name="tipo_servicio_id" type="row" />
                </graph>
            </field>
        </record>
        <record id="ticket_search" model="ir.ui.view">
            <field name="name">ticket.search</field>
            <field name="model">ticket.alquiler</field>
            <field name="arch" type="xml">
                <search string="">
                    <field name="product_alquiler" />
                    <field name="partner_id" />
                    <field name="agenda" />
                    <field name="tipo_servicio_id" />
                    <field name="estado" />
                    <field name="responsable" />

                </search>
            </field>
        </record>
        <record id="ticket_calendar" model="ir.ui.view">
            <field name="name">ticket.calendar</field>
            <field name="model">ticket.alquiler</field>
            <field name="arch" type="xml">
                <calendar date_start="" color="partner_id" event_limit="5">
                    <field name="partner_id" filters="1" />
                    <field name="partner_id" />
                    <!--<field name="maintenance_type"/>-->
                </calendar>
            </field>
        </record>
        <record id="ticket_pivot" model="ir.ui.view">
            <field name="name">ticket.pivot</field>
            <field name="model">ticket.alquiler</field>
            <field name="arch" type="xml">
                <pivot string="">
                    <field name="agenda" type="row" />
                    <field name="partner_id" type="row" />
                    <field name="product_alquiler" type="row" />
                    <field name="tipo_servicio_id" type="col" />
                </pivot>
            </field>
        </record>
        <record model="ir.actions.act_window" id="sat.action_soporte_window">
            <field name="name">Tickets</field>
            <field name="res_model">ticket.alquiler</field>
            <field name="view_mode">list,form,kanban,search,graph,calendar,pivot</field>
            <field name="view_id" ref="sat.model_name_view_kanban" />
        </record>
        <!-- VISTA DEL WIZARD PARA ODOO 18 (NUEVA SINTAXIS) -->

<record id="view_whatsapp_notification_wizard_form_massive" model="ir.ui.view">
    <field name="name">whatsapp.notification.wizard.form.massive</field>
    <field name="model">whatsapp.notification.wizard</field>
    <field name="arch" type="xml">
        <form string="Asignación de Tickets">
            <!-- Alert para asignación masiva -->
            <div class="alert alert-info" invisible="not es_asignacion_masiva">
                <strong>Asignación Masiva:</strong> Se procesarán <field name="total_tickets"/> tickets seleccionados.
            </div>
            
            <!-- SECCIÓN INDIVIDUAL (cuando es_asignacion_masiva = False) -->
            <group invisible="es_asignacion_masiva" string="Asignación Individual">
                <group string="Información del Ticket">
                    <field name="ticket_id" invisible="1"/>
                    <field name="cliente_name" readonly="1"/>
                    <field name="direccion" readonly="1"/>
                    <field name="modelo_equipo" readonly="1"/>
                    <field name="serie_equipo" readonly="1"/>
                    <field name="problema_descripcion" readonly="1"/>
               
                    <field name="tecnico_name" readonly="1"/>
                </group>
                
                <!-- Configuración de notificación individual -->
                <group string="Configuración">
                    <field name="notificar_grupos"/>
                    <field name="grupo_seleccionado" 
                           invisible="not notificar_grupos"
                           required="notificar_grupos"/>
                    <field name="cliente_solicita_toner"/>
                    <field name="enviar_toner"/>
                    <field name="observaciones_toner" 
                           invisible="not enviar_toner"/>
                    <field name="mensaje_adicional"/>
                </group>
            </group>
            
            <!-- SECCIÓN MASIVA (cuando es_asignacion_masiva = True) -->
            <group invisible="not es_asignacion_masiva" string="Asignación Masiva">
                
                <!-- Campos ocultos para control -->
                <field name="es_asignacion_masiva" invisible="1"/>
                <field name="tickets_masivos_ids" invisible="1"/>
                
                <!-- Información general -->
                <group col="4" string="Resumen General">
                    <field name="total_tickets" readonly="1"/>
                    <field name="clientes_involucrados" readonly="1" colspan="3"/>
                </group>
                
                <!-- Valores comunes OBLIGATORIOS -->
                <group col="2" string="Valores Comunes (se aplicarán a todos los tickets)">
                    <field name="tecnico_asignado" 
                           required="es_asignacion_masiva"
                           placeholder="Seleccione el técnico..."
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="fecha_visita" 
                           required="es_asignacion_masiva"
                           placeholder="Seleccione fecha y hora..."/>
                    <field name="asistencia_directa"/>
                </group>
                
                <!-- Configuración de notificaciones -->
                <group string="Notificaciones (Opcional)">
                    <field name="notificar_grupos"/>
                    <field name="grupo_seleccionado" 
                           invisible="not notificar_grupos"
                           required="notificar_grupos"/>
                    <field name="cliente_solicita_toner"/>
                    <field name="enviar_toner"/>
                    <field name="observaciones_toner" 
                           invisible="not enviar_toner"/>
                    <field name="mensaje_adicional" placeholder="Observaciones adicionales..."/>
                </group>
                
                <!-- Lista de tickets para configurar individualmente -->
                <notebook>
    <page string="Configuración por Ticket" name="tickets_config">
        <group>
            <field name="resumen_servicios" readonly="1" nolabel="1"/>
        </group>

        <field name="ticket_line_ids"
               context="{'default_wizard_id': id}"
               nolabel="1">
            <!-- Si tu versión es Odoo 15/16 usa <tree>; en 17+ <list> también es válido -->
            <list editable="bottom"
                  create="0"
                  delete="0"
                  decoration-danger="estado_actual != 'nuevo'"
                  decoration-warning="not tipo_servicio_id">

                <field name="ticket_name" readonly="1" string="Ticket"/>
                <field name="cliente_name" readonly="1" string="Cliente"/>
                <field name="modelo_equipo" readonly="1" string="Modelo" optional="show"/>
                <field name="serie_equipo" readonly="1" string="Serie" optional="show"/>
                <field name="tipo_servicio_id" required="1" string="Tipo de Servicio"/>
                <field name="observaciones" string="Observaciones Específicas"/>

                <!-- Campos ocultos para control -->
                <field name="estado_actual" invisible="1"/>
                <field name="wizard_id" invisible="1"/>
                <field name="ticket_id" invisible="1"/>
            </list>
        </field>

        <div class="text-muted mt-2">
            <small>
                💡 <strong>Tip:</strong> Configure el tipo de servicio para cada ticket según sus necesidades específicas.
                Las observaciones son opcionales pero recomendadas para casos especiales.
            </small>
        </div>
    </page>
</notebook>

            </group>
            
            <!-- Botones de acción -->
            <footer>
                <!-- Botones para asignación individual -->
                <div invisible="es_asignacion_masiva">
                    <button name="action_confirmar_asignacion" 
                            type="object" 
                            string="Confirmar Asignación Individual" 
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </div>
                
                <!-- Botones para asignación masiva -->
                <div invisible="not es_asignacion_masiva">
                    <button name="action_confirmar_asignacion_masiva" 
                            type="object" 
                            string="Confirmar Asignación Masiva" 
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </div>
            </footer>
        </form>
    </field>
</record>

<!-- VISTA ESPECÍFICA PARA LAS LÍNEAS DEL WIZARD -->
<record id="view_whatsapp_notification_wizard_line_list" model="ir.ui.view">
    <field name="name">whatsapp.notification.wizard.line.list</field>
    <field name="model">whatsapp.notification.wizard.line</field>
    <field name="arch" type="xml">
        <list string="Tickets a Procesar" 
              editable="bottom"
              create="false"
              delete="false"
              decoration-danger="estado_actual != 'nuevo'"
              decoration-warning="not tipo_servicio_id"
              decoration-info="tipo_servicio_id in ['mantenimiento_correctivo', 'cambio_repuestos']">
            
            <field name="ticket_name" readonly="1" string="Ticket"/>
            <field name="cliente_name" readonly="1" string="Cliente"/>
            <field name="modelo_equipo" readonly="1" string="Modelo" optional="show"/>
            <field name="serie_equipo" readonly="1" string="Serie" optional="show"/>

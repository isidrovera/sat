<?xml version='1.0' encoding='utf-8'?>
<odoo>
<record id="view_reparacion_autenticacion_wizard_form" model="ir.ui.view">
    <field name="name">Autenticación de Serie y Modelo</field>
    <field name="model">reparacion.autenticacion.wizard</field>
    <field name="arch" type="xml">
        <form string="Autenticación de Serie y Modelo" class="oe_form_custom">
            <sheet>
                <div class="alert alert-warning o_default_snippet_text" role="alert" style="margin-bottom: 20px;">
                    <i class="fa fa-exclamation-triangle" aria-hidden="true" style="color: #FFA500;"></i>
                    <b> Instrucciones:</b> Antes de continuar, verifique físicamente la <b>serie</b> y el <b>modelo</b> en la máquina. Asegúrese de que coincidan con los valores registrados en el sistema. Si no coinciden, contacte al administrador antes de proceder.
                </div>
                <group>
                    <field name="serie" placeholder="Ingrese la serie del equipo" class="oe_highlight"/>
                    <field name="modelo_id" placeholder="Seleccione el modelo del equipo" class="oe_highlight" options="{'no_create': True}"/>
                </group>
            </sheet>
            <footer>
                <button string="Confirmar Autenticación" type="object" name="validar_acceso" class="btn-primary oe_highlight" icon="fa-check-circle"/>
                <button string="Cancelar" class="btn-secondary" special="cancel" icon="fa-times-circle"/>
            </footer>
        </form>
    </field>
</record>
</odoo>
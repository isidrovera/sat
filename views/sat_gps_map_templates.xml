<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sat_gps_live_map" name="Seguimiento GPS de visita SAT">
        <t t-call="website.layout">
            <t t-set="title">Seguimiento GPS - Andes</t>
            <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet"/>
            <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
            <main class="container my-4" id="sat_gps_tracking"
                  t-att-data-url="data_url" t-att-data-tiles-url="tiles_url">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <div>
                        <h2 class="mb-0">Andes</h2>
                        <div class="text-muted" t-esc="visita.name"/>
                    </div>
                    <span class="badge text-bg-primary">Seguimiento GPS</span>
                </div>
                <div id="sat_gps_map" style="height: min(65vh, 600px); min-height: 350px; border-radius: 14px; overflow: hidden;"/>
                <div class="alert alert-light border mt-3" role="status" id="sat_gps_status">
                    Cargando posiciones del servicio…
                </div>
                <div id="sat_gps_tecnicos" class="row g-2"/>
                <p class="small text-muted mt-3">
                    Los datos dependen de la señal GPS. Si no hay una ubicación reciente,
                    se mostrará la hora de la última posición registrada.
                    Las líneas reflejan las coordenadas reportadas por Traccar.
                </p>
            </main>
            <script type="text/javascript" src="/sat/static/src/js/sat_gps_tracking.js"></script>
        </t>
    </template>
</odoo>

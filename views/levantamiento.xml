<!-- Scripts mejorados para la funcionalidad del formulario -->
<script type="text/javascript">
document.addEventListener("DOMContentLoaded", function() {
    // Inicialización de tooltips de Bootstrap 5
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    const tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    });
    
    // Manejo de la visibilidad del contacto de sistemas basado en el checkbox
    const areaSistemasCheck = document.getElementById('area_sistemas');
    const contactoSistemasDiv = document.getElementById('contacto_sistemas_div');
    
    function toggleContactoSistemas() {
        contactoSistemasDiv.classList.toggle('d-none', !areaSistemasCheck.checked);
    }
    
    if (areaSistemasCheck && contactoSistemasDiv) {
        areaSistemasCheck.addEventListener('change', toggleContactoSistemas);
        // Inicializar estado
        toggleContactoSistemas();
    }
    
    // Toggle opciones de control de impresión
    const controlImpresionCheck = document.getElementById('control_impresion');
    const opcionesControlDiv = document.getElementById('opciones_control_impresion');
    
    function toggleControlImpresion() {
        if (opcionesControlDiv) {
            opcionesControlDiv.classList.toggle('d-none', !controlImpresionCheck.checked);
        }
    }
    
    if (controlImpresionCheck) {
        controlImpresionCheck.addEventListener('change', toggleControlImpresion);
        // Inicializar estado
        toggleControlImpresion();
    }
    
    // Toggle opciones de email
    const usarEmailCheck = document.getElementById('usar_email');
    const opcionesEmailDiv = document.getElementById('opciones_email');
    
    function toggleOpcionesEmail() {
        if (opcionesEmailDiv) {
            opcionesEmailDiv.classList.toggle('d-none', !usarEmailCheck.checked);
        }
    }
    
    if (usarEmailCheck) {
        usarEmailCheck.addEventListener('change', toggleOpcionesEmail);
        // Inicializar estado
        toggleOpcionesEmail();
    }
    
    // Habilitar/deshabilitar selector de frecuencia de reportes
    const requiereReportesCheck = document.getElementById('requiere_reportes');
    const frecuenciaReportesSelect = document.getElementById('frecuencia_reportes');
    
    function toggleFrecuenciaReportes() {
        if (frecuenciaReportesSelect) {
            frecuenciaReportesSelect.disabled = !requiereReportesCheck.checked;
            if (!requiereReportesCheck.checked) {
                frecuenciaReportesSelect.value = '';
            }
        }
    }
    
    if (requiereReportesCheck) {
        requiereReportesCheck.addEventListener('change', toggleFrecuenciaReportes);
        // Inicializar estado
        toggleFrecuenciaReportes();
    }
    
    // Validación del formulario
    const form = document.querySelector("form.needs-validation");
    
    if (form) {
        form.addEventListener("submit", function(event) {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
                
                // Mostrar mensaje de error
                const errorElements = form.querySelectorAll(":invalid");
                if (errorElements.length &gt; 0) {
                    // Scroll hacia el primer elemento con error
                    errorElements[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
                    
                    // Resaltar visualmente
                    errorElements[0].classList.add('highlight-error');
                    setTimeout(() =&gt; {
                        errorElements[0].classList.remove('highlight-error');
                    }, 2000);
                }
            }
            
            form.classList.add("was-validated");
        });
    }
    
    // Validación de valores numéricos para asegurar mínimos
    const numericalInputs = document.querySelectorAll('input[type="number"][min]');
    numericalInputs.forEach(input =&gt; {
        input.addEventListener('change', function() {
            const min = parseFloat(this.min);
            if (this.value && parseFloat(this.value) &lt; min) {
                this.value = min;
            }
        });
    });
});
</script>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="formulario_inspeccion_template">
        <t t-call="website.layout">
            <!-- CSS personalizado -->
            <style>
                .section-card {
                margin-bottom: 2rem; /* Espaciado entre secciones */
                padding: 1.5rem; /* Espaciado interno */
                border-radius: 15px; /* Bordes redondeados */
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* Sombra */
                background-color: #fff; /* Fondo blanco */
                }

                .section-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
                }
                .icon-circle {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-right: 15px;
                }
                .form-label {
                font-weight: 600; /* Negrita */
                color: #333; /* Color del texto */
                margin-bottom: 0.5rem; /* Espaciado inferior */
                display: flex;
                align-items: center; /* Alineación de icono y texto */
                }
                .info-tooltip {
                color: #6c757d;
                cursor: help;
                }
                .card-header {
                background-color: #ffc107; /* Fondo amarillo */
                color: #fff; /* Texto blanco */
                padding: 1rem; /* Espaciado interno del encabezado */
                border-radius: 15px 15px 0 0; /* Bordes redondeados solo arriba */
                font-weight: bold; /* Texto en negrita */
                }
                .alert {
                margin-top: 1rem; /* Espaciado superior */
                margin-bottom: 1.5rem; /* Espaciado inferior */
                padding: 1rem; /* Espaciado interno */
                background-color: #ffeeba; /* Fondo amarillo claro */
                color: #856404; /* Texto marrón */
                border-radius: 10px; /* Bordes redondeados */
                display: flex;
                align-items: center; /* Centrado vertical del contenido */
                }
                .form-control {
                border-radius: 0.5rem; /* Bordes redondeados */
                padding: 0.5rem 0.75rem; /* Espaciado interno */
                border: 1px solid #ced4da; /* Borde gris */
                font-size: 1rem; /* Tamaño de fuente */
                }
                .form-group {
                margin-bottom: 1.5rem; /* Espaciado entre los grupos de campos */
                }
                .input-group {
                display: flex;
                align-items: center; /* Centrar contenido verticalmente */
                }
                .input-group-text {
                background-color: #f8f9fa; /* Fondo gris claro */
                border: 1px solid #ced4da; /* Borde gris */
                border-radius: 0.25rem; /* Bordes ligeramente redondeados */
                padding: 0.375rem 0.75rem; /* Espaciado interno */
                }
            </style>

            <div class="container my-5">
                <!-- Mensaje informativo IP fija -->
                <!--<div class="alert alert-info mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-info-circle fa-2x me-3"></i>
                        <div>
                            <h4 class="alert-heading mb-1">Información Importante</h4>
                            <p class="mb-0">Para una correcta instalación y funcionamiento del equipo, todas las computadoras deben tener IP fija configurada.</p>
                        </div>
                    </div>
                </div>-->


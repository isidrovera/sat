            <!-- Scripts para la funcionalidad del formulario -->
            <script type="text/javascript">
                $(document).ready(function() {
                // Toggle opciones de control de impresión
                $('#control_impresion').change(function() {
                $('#opciones_control_impresion').toggleClass('d-none', !this.checked);
                });

                // Toggle opciones de email
                $('#usar_email').change(function() {
                $('#opciones_email').toggleClass('d-none', !this.checked);
                });

                // Inicialización
                $('#opciones_control_impresion').toggleClass('d-none',
                !$('#control_impresion').is(':checked'));
                $('#opciones_email').toggleClass('d-none', !$('#usar_email').is(':checked'));

                // Habilitar tooltips
                $('[data-bs-toggle="tooltip"]').tooltip();
                });
            </script>
            <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", function () {
                const form = document.querySelector("form.needs-validation");
                form.addEventListener("submit", function (event) {
                // Verifica que todos los campos requeridos estén llenos
                if (!form.checkValidity()) {
                event.preventDefault(); // Detener el envío
                event.stopPropagation();

                // Agregar clase de validación
                form.classList.add("was-validated");
                }
                });
                });
            </script>


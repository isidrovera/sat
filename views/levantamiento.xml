                    <!-- Sección de Instalación Eléctrica -->
                    <div class="section-card">
                        <div class="card-header bg-warning text-white py-3">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle bg-white text-warning">
                                    <i class="fa fa-bolt"></i>
                                </div>
                                <h3 class="mb-0">Instalación Eléctrica</h3>
                            </div>
                            <div class="invalid-feedback">
                                Por favor, ingrese un voltaje válido.
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-warning bg-warning bg-opacity-10 border-0">
                                <i class="fa fa-exclamation-triangle me-2"></i> Para una correcta
                                instalación, asegúrese de que el punto de corriente sea estable y
                                suministre un voltaje de 220V. </div>
                            <div class="row g-4">
                                <!-- Campo Punto de Corriente -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <i class="fa fa-plug me-2"></i> ¿Cuenta con un punto de
                                            corriente cercano? <i
                                                class="fa fa-question-circle info-tooltip ms-1"
                                                title="Seleccione si el área tiene un punto de corriente disponible."></i>
                                        </label>
                                        <select name="punto_corriente" class="form-select"
                                            required="required">
                                            <option value="">Seleccionar...</option>
                                            <option value="si">Sí</option>
                                            <option value="no">No</option>
                                            <option value="pendiente">Requiere instalación</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Campo Voltaje -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <i class="fa fa-battery-three-quarters me-2"></i>
                                            Voltaje medido (V) <i
                                                class="fa fa-question-circle info-tooltip ms-1"
                                                title="Indique el voltaje medido en el punto de corriente."></i>
                                        </label>
                                        <div class="input-group">
                                            <input type="number" name="voltaje" class="form-control"
                                                required="required" step="0.1" placeholder="220" />
                                            <span class="input-group-text">V</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="section-card">
                        <div class="card-header bg-info text-white py-3">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle bg-white text-info">
                                    <i class="fa fa-network-wired"></i>
                                </div>
                                <h3 class="mb-0">Infraestructura de Red</h3>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-info bg-info bg-opacity-10 border-0">
                                <i class="fa fa-info-circle me-2"></i> Todas las PCs deben tener IP
                                fija para garantizar la comunicación estable con el equipo. </div>

                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <i class="fa fa-ethernet me-2"></i> Punto de Red <i
                                                class="fa fa-question-circle info-tooltip ms-1"
                                                title="Se requiere un punto de red para la conexión del equipo"></i>
                                        </label>
                                        <select name="punto_red" class="form-select"
                                            required="required">
                                            <option value="">Seleccionar...</option>
                                            <option value="si">Sí cuenta con punto de red</option>
                                            <option value="no">No cuenta con punto de red</option>
                                            <option value="pendiente">Se instalará punto de red</option>
                                        </select>
                                        <div class="form-text">Es necesario un punto de red cercano
                                            al equipo</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <i class="fa fa-wifi me-2"></i> WiFi Disponible </label>
                                        <select name="wifi" class="form-select" required="required">
                                            <option value="si">Sí</option>
                                            <option value="no">No</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-4">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <i class="fa fa-laptop-code me-2"></i> ¿Cuenta con área
                                            de sistemas? </label>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox"
                                                name="area_sistemas" id="area_sistemas" />
                                            <label class="form-check-label" for="area_sistemas">Sí,
                                                contamos con área de TI</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6" id="contacto_sistemas_div">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <i class="fa fa-id-card me-2"></i> Contacto del área de
                                            sistemas </label>
                                        <input type="text" name="contacto_sistemas"
                                            class="form-control"
                                            placeholder="Nombre y forma de contacto" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Entorno de PCs -->
                    <div class="section-card">
                        <div class="card-header bg-primary text-white py-3">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle bg-white text-primary">
                                    <i class="fa fa-desktop"></i>
                                </div>
                                <h3 class="mb-0">Entorno de PCs</h3>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row g-4">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="form-label d-flex align-items-center">
                                            <i class="fab fa-windows me-2"></i> PCs Windows <i
                                                class="fa fa-question-circle info-tooltip ms-2"
                                                title="Cantidad de computadoras con Windows que necesitarán acceso"></i>
                                        </label>
                                        <div class="input-group">
                                            <input type="number" name="cantidad_windows"
                                                class="form-control"
                                                required="required" min="0" value="0" />
                                            <span class="input-group-text">PCs</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="form-label d-flex align-items-center">
                                            <i class="fab fa-apple me-2"></i> PCs Mac <i
                                                class="fa fa-question-circle info-tooltip ms-2"
                                                title="Cantidad de computadoras Mac que necesitarán acceso"></i>
                                        </label>
                                        <div class="input-group">
                                            <input type="number" name="cantidad_mac"
                                                class="form-control"
                                                required="required" min="0" value="0" />
                                            <span class="input-group-text">PCs</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="form-label d-flex align-items-center">
                                            <i class="fab fa-linux me-2"></i> PCs Linux <i
                                                class="fa fa-question-circle info-tooltip ms-2"
                                                title="Cantidad de computadoras Linux que necesitarán acceso"></i>
                                        </label>
                                        <div class="input-group">
                                            <input type="number" name="cantidad_linux"
                                                class="form-control"
                                                required="required" min="0" value="0" />
                                            <span class="input-group-text">PCs</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="section-card">
                        <div class="card-header bg-success text-white py-3">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle bg-white text-success">
                                    <i class="fa fa-user-lock"></i>
                                </div>
                                <h3 class="mb-0">Control de Impresión</h3>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="form-check form-switch mb-4">
                                <input class="form-check-input" type="checkbox"
                                    name="control_impresion" id="control_impresion" />
                                <label class="form-check-label fs-5" for="control_impresion">
                                    <i class="fa fa-shield-alt me-2"></i> Activar control de
                                    impresión </label>
                            </div>

                            <div id="opciones_control_impresion" class="border rounded p-4 bg-light">
                                <div class="row g-4">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="form-label d-flex align-items-center">
                                                <i class="fa fa-users-cog me-2"></i> Tipo de Control <i
                                                    class="fa fa-question-circle info-tooltip ms-2"
                                                    title="Seleccione cómo se organizará el control de impresión"></i>
                                            </label>
                                            <select name="tipo_control" class="form-select">
                                                <option value="">Seleccionar...</option>
                                                <option value="usuario">Por Usuario</option>
                                                <option value="departamento">Por Departamento</option>
                                                <option value="proyecto">Por Proyecto</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="form-label d-flex align-items-center">
                                                <i class="fa fa-users me-2"></i> Cantidad de
                                                Usuarios <i
                                                    class="fa fa-question-circle info-tooltip ms-2"
                                                    title="Número total de usuarios que necesitarán acceso"></i>
                                            </label>
                                            <input type="number" name="cantidad_usuarios"
                                                class="form-control" min="0" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="checkbox"
                                                    name="requiere_reportes" id="requiere_reportes" />
                                                <label class="form-check-label"
                                                    for="requiere_reportes">
                                                    <i class="fa fa-chart-bar me-2"></i> Requiere
                                                    reportes de uso </label>
                                            </div>
                                            <select name="frecuencia_reportes" class="form-select"
                                                id="frecuencia_reportes">
                                                <option value="">Frecuencia de reportes...</option>
                                                <option value="diario">Diario</option>
                                                <option value="semanal">Semanal</option>
                                                <option value="mensual">Mensual</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Configuración de Escaneo -->
                    <div class="section-card">
                        <div class="card-header bg-warning text-dark py-3">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle bg-white text-warning">
                                    <i class="fa fa-scanner"></i>
                                </div>
                                <h3 class="mb-0">Configuración de Escaneo</h3>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-warning bg-warning bg-opacity-10 border-0">
                                <i class="fa fa-exclamation-triangle me-2"></i> Recuerde que para
                                utilizar el escaneo a FTP, todas las PCs deben tener IP fija
                                configurada. </div>

                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="card h-100 border-0 bg-light">
                                        <div class="card-body">
                                            <div class="form-check mb-3">
                                                <input class="form-check-input" type="checkbox"
                                                    name="usar_smb" id="usar_smb" />
                                                <label class="form-check-label fs-5" for="usar_smb">
                                                    <i class="fa fa-folder-open me-2"></i> Escaneo a
                                                    carpeta compartida (SMB) </label>
                                            </div>
                                            <small class="text-muted">
                                                <i class="fa fa-info-circle me-1"></i> Permite
                                                escanear directamente a carpetas compartidas en la
                                                red </small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card h-100 border-0 bg-light">
                                        <div class="card-body">
                                            <div class="form-check mb-3">
                                                <input class="form-check-input" type="checkbox"
                                                    name="usar_ftp" id="usar_ftp" />
                                                <label class="form-check-label fs-5" for="usar_ftp">
                                                    <i class="fa fa-upload me-2"></i> Escaneo a FTP </label>
                                            </div>
                                            <small class="text-muted">
                                                <i class="fa fa-info-circle me-1"></i> Se requiere
                                                IP fija en todas las PCs para esta funcionalidad </small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-4">
                                <div class="col-12">
                                    <div class="card border-0 bg-light">
                                        <div class="card-body">
                                            <div class="form-check mb-3">
                                                <input class="form-check-input" type="checkbox"
                                                    name="usar_email" id="usar_email" />
                                                <label class="form-check-label fs-5"
                                                    for="usar_email">
                                                    <i class="fa fa-envelope me-2"></i> Escaneo a
                                                    Email </label>
                                            </div>
                                            <div id="opciones_email" class="mt-3">
                                                <div class="form-group">
                                                    <label class="form-label">Tipo de servidor de
                                                        correo</label>
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio"
                                                            name="tipo_servidor_email"
                                                            id="servidor_propio" value="propio" />
                                                        <label class="form-check-label"
                                                            for="servidor_propio">
                                                            Servidor de correo propio
                                                        </label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio"
                                                            name="tipo_servidor_email"
                                                            id="servidor_proveedor"
                                                            value="proveedor" />
                                                        <label class="form-check-label"
                                                            for="servidor_proveedor">
                                                            Usar servidor del proveedor
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="section-card">
                        <div class="card-header bg-danger text-white py-3">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle bg-white text-danger">
                                    <i class="fa fa-ruler-combined"></i>
                                </div>
                                <h3 class="mb-0">Espacio Físico y Acceso</h3>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-info bg-info bg-opacity-10 border-0">
                                <i class="fa fa-info-circle me-2"></i> Se requiere un espacio mínimo
                                de 2m² y un pasillo de al menos 1m de ancho para la instalación y
                                mantenimiento. </div>

                            <div class="row g-4">
                                <!-- Medidas del espacio -->
                                <div class="col-md-6">
                                    <div class="card border-0 bg-light h-100">
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <i class="fa fa-expand-arrows-alt me-2"></i> Medidas
                                                del Espacio </h5>
                                            <div class="form-group mb-3">
                                                <label class="form-label d-flex align-items-center">
                                                    <i class="fa fa-square me-2"></i> Espacio
                                                    Disponible <i
                                                        class="fa fa-question-circle info-tooltip ms-2"
                                                        title="Mínimo requerido: 2m²"></i>
                                                </label>
                                                <div class="input-group">
                                                    <input type="number" name="espacio"
                                                        class="form-control"
                                                        step="0.1" required="required" />
                                                    <span class="input-group-text">m²</span>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label d-flex align-items-center">
                                                    <i class="fa fa-arrows-alt-h me-2"></i> Ancho
                                                    del Pasillo <i
                                                        class="fa fa-question-circle info-tooltip ms-2"
                                                        title="Mínimo requerido: 1m"></i>
                                                </label>
                                                <div class="input-group">
                                                    <input type="number" name="ancho_pasillo"
                                                        class="form-control"
                                                        step="0.1" required="required" />
                                                    <span class="input-group-text">m</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Acceso -->
                                <div class="col-md-6">
                                    <div class="card border-0 bg-light h-100">
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <i class="fa fa-door-open me-2"></i> Acceso al Local </h5>
                                            <div class="form-group mb-3">
                                                <label class="form-label">
                                                    <i class="fa fa-building me-2"></i> Número de
                                                    Piso </label>
                                                <input type="number" name="piso"
                                                    class="form-control" required="required" min="0" />
                                            </div>
                                            <div class="form-check mb-3">
                                                <input class="form-check-input" type="checkbox"
                                                    name="ascensor" id="ascensor" />
                                                <label class="form-check-label" for="ascensor">
                                                    <i class="fa fa-elevator me-2"></i> Cuenta con
                                                    ascensor </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Estacionamiento -->
                                <div class="col-12">
                                    <div class="card border-0 bg-light">
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <i class="fa fa-truck me-2"></i> Acceso para Entrega </h5>

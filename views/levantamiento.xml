<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="formulario_inspeccion_template">
        <t t-call="website.layout">
            <!-- CSS personalizado -->
            <style>
                /* Variables CSS para consistencia en colores y estilos */
                :root {
                    --primary-color: #3498db;
                    --secondary-color: #2c3e50;
                    --success-color: #2ecc71;
                    --warning-color: #f39c12;
                    --danger-color: #e74c3c;
                    --info-color: #3498db;
                    --light-color: #f8f9fa;
                    --dark-color: #343a40;
                    --border-radius: 15px;
                    --box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
                    --transition-speed: 0.3s;
                }

                /* Mejoras para secciones */
                .section-card {
                    margin-bottom: 2.5rem; 
                    padding: 0;
                    border-radius: var(--border-radius);
                    box-shadow: var(--box-shadow);
                    background-color: #fff;
                    transition: transform var(--transition-speed), box-shadow var(--transition-speed);
                    overflow: hidden; /* Para que los border-radius afecten a los hijos */
                }

                .section-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
                }

                /* Diseño mejorado de encabezados */
                .card-header {
                    padding: 1.25rem;
                    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
                    font-weight: 600;
                    display: flex;
                    align-items: center;
                }

                /* Mejora para íconos */
                .icon-circle {
                    width: 42px;
                    height: 42px;
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    margin-right: 15px;
                    flex-shrink: 0;
                    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
                    transition: all var(--transition-speed);
                }

                .card-header:hover .icon-circle {
                    transform: scale(1.1);
                }

                /* Mejoras para formularios y controles */
                .form-label {
                    font-weight: 600;
                    color: var(--dark-color);
                    margin-bottom: 0.5rem;
                    display: flex;
                    align-items: center;
                }

                .form-control, .form-select {
                    border-radius: 0.5rem;
                    padding: 0.65rem 0.75rem;
                    border: 1px solid #ddd;
                    transition: all 0.25s;
                    font-size: 1rem;
                }

                .form-control:focus, .form-select:focus {
                    border-color: var(--primary-color);
                    box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
                }

                /* Mejoras para alertas y tooltips */
                .alert {
                    border-radius: 10px;
                    padding: 1rem 1.25rem;
                    margin-bottom: 1.5rem;
                    display: flex;
                    align-items: flex-start;
                    border-left: 4px solid;
                }

                .alert-warning {
                    border-left-color: var(--warning-color);
                }

                .alert-info {
                    border-left-color: var(--info-color);
                }

                .info-tooltip {
                    color: #6c757d;
                    cursor: help;
                    margin-left: 0.5rem;
                    transition: color 0.2s;
                }

                .info-tooltip:hover {
                    color: var(--primary-color);
                }

                /* Mejora de contenedor para una mejor responsividad */
                .container {
                    max-width: 100%;
                    padding: 0 20px;
                }

                @media (min-width: 576px) {
                    .container {
                        max-width: 540px;
                    }
                }

                @media (min-width: 768px) {
                    .container {
                        max-width: 720px;
                    }
                }

                @media (min-width: 992px) {
                    .container {
                        max-width: 960px;
                    }
                }

                @media (min-width: 1200px) {
                    .container {
                        max-width: 1140px;
                    }
                }

                /* Mejoras para espaciado en dispositivos móviles */
                @media (max-width: 767.98px) {
                    .section-card {
                        margin-bottom: 1.5rem;
                    }
                    
                    .card-header {
                        padding: 1rem;
                    }
                    
                    .card-body {
                        padding: 1rem;
                    }
                    
                    .icon-circle {
                        width: 36px;
                        height: 36px;
                    }
                }

                /* Mejorar el aspecto del botón de envío */
                .btn-primary {
                    background-color: var(--primary-color);
                    border-color: var(--primary-color);
                    border-radius: 50px;
                    padding: 0.75rem 2rem;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    transition: all 0.3s;
                    box-shadow: 0 4px 6px rgba(52, 152, 219, 0.25);
                }

                .btn-primary:hover {
                    background-color: #2980b9;
                    border-color: #2980b9;
                    transform: translateY(-2px);
                    box-shadow: 0 6px 8px rgba(52, 152, 219, 0.35);
                }

                /* Card body */
                .card-body {
                    padding: 1.5rem;
                }
            </style>

            <!-- Continuación del template con mejoras para las secciones específicas -->

<!-- Título y sección de Levantamiento de Información -->
<div class="section-card">
    <div class="card-header bg-secondary text-white">
        <div class="d-flex align-items-center">
            <div class="icon-circle bg-white text-secondary">
                <i class="fa fa-clipboard-list"></i>
            </div>
            <h3 class="mb-0 fs-4">Levantamiento de Información para la Instalación</h3>
        </div>
    </div>
    <div class="card-body">
        <div class="alert alert-info bg-info bg-opacity-10 border-0">
            <i class="fa fa-info-circle me-2 fs-5"></i>
            <div>
                <p class="mb-0">Por favor, complete la siguiente información para asegurar una instalación exitosa del equipo. Todos los campos con <span class="text-danger">*</span> son obligatorios.</p>
            </div>
        </div>
    </div>
</div>

<!-- Sección de Instalación Eléctrica Mejorada -->
<div class="section-card">
    <div class="card-header bg-warning text-white">
        <div class="d-flex align-items-center">
            <div class="icon-circle bg-white text-warning">
                <i class="fa fa-bolt"></i>
            </div>
            <h3 class="mb-0 fs-4">Instalación Eléctrica</h3>
        </div>
    </div>
    <div class="card-body">
        <div class="alert alert-warning bg-warning bg-opacity-10 border-0">
            <i class="fa fa-exclamation-triangle me-2 fs-5"></i>
            <div>
                <p class="mb-0">Para una correcta instalación, asegúrese de que el punto de corriente sea estable y suministre un voltaje de 220V.</p>
            </div>
        </div>
        <div class="row g-4">
            <!-- Campo Punto de Corriente -->
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label class="form-label">
                        <i class="fa fa-plug me-2"></i> ¿Cuenta con un punto de corriente cercano? <span class="text-danger">*</span>
                        <i class="fa fa-question-circle info-tooltip" data-bs-toggle="tooltip" title="Seleccione si el área tiene un punto de corriente disponible."></i>
                    </label>
                    <select name="punto_corriente" class="form-select" required="required">
                        <option value="">Seleccionar...</option>
                        <option value="si">Sí</option>
                        <option value="no">No</option>
                        <option value="pendiente">Requiere instalación</option>
                    </select>
                    <div class="invalid-feedback">Por favor, seleccione una opción.</div>
                </div>
            </div>

            <!-- Campo Voltaje -->
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label class="form-label">
                        <i class="fa fa-battery-three-quarters me-2"></i> Voltaje medido (V) <span class="text-danger">*</span>
                        <i class="fa fa-question-circle info-tooltip" data-bs-toggle="tooltip" title="Indique el voltaje medido en el punto de corriente."></i>
                    </label>
                    <div class="input-group">
                        <input type="number" name="voltaje" class="form-control" required="required" step="0.1" placeholder="220" min="200" max="240" />
                        <span class="input-group-text">V</span>
                    </div>
                    <div class="invalid-feedback">Por favor, ingrese un voltaje válido entre 200V y 240V.</div>
                    <div class="form-text">El voltaje recomendado es 220V.</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sección de Infraestructura de Red Mejorada -->
<div class="section-card">
    <div class="card-header bg-info text-white">
        <div class="d-flex align-items-center">
            <div class="icon-circle bg-white text-info">
                <i class="fa fa-network-wired"></i>
            </div>
            <h3 class="mb-0 fs-4">Infraestructura de Red</h3>
        </div>
    </div>
    <div class="card-body">
        <div class="alert alert-info bg-info bg-opacity-10 border-0">
            <i class="fa fa-info-circle me-2 fs-5"></i>
            <div>
                <p class="mb-0">Todas las PCs deben tener IP fija para garantizar la comunicación estable con el equipo.</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="form-group mb-3">
                    <label class="form-label">
                        <i class="fa fa-ethernet me-2"></i> Punto de Red <span class="text-danger">*</span>
                        <i class="fa fa-question-circle info-tooltip" data-bs-toggle="tooltip" title="Se requiere un punto de red para la conexión del equipo"></i>
                    </label>
                    <select name="punto_red" class="form-select" required="required">
                        <option value="">Seleccionar...</option>
                        <option value="si">Sí cuenta con punto de red</option>
                        <option value="no">No cuenta con punto de red</option>
                        <option value="pendiente">Se instalará punto de red</option>
                    </select>
                    <div class="invalid-feedback">Por favor, seleccione una opción.</div>
                    <div class="form-text">Es necesario un punto de red cercano al equipo</div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="form-group mb-3">
                    <label class="form-label">
                        <i class="fa fa-wifi me-2"></i> WiFi Disponible <span class="text-danger">*</span>
                    </label>
                    <select name="wifi" class="form-select" required="required">
                        <option value="">Seleccionar...</option>
                        <option value="si">Sí</option>
                        <option value="no">No</option>
                    </select>
                    <div class="invalid-feedback">Por favor, seleccione una opción.</div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-lg-6">
                <div class="form-group mb-3">
                    <label class="form-label">
                        <i class="fa fa-laptop-code me-2"></i> ¿Cuenta con área de sistemas?
                    </label>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="area_sistemas" id="area_sistemas" />
                        <label class="form-check-label" for="area_sistemas">Sí, contamos con área de TI</label>
                    </div>
                </div>
            </div>
            <div class="col-lg-6" id="contacto_sistemas_div">
                <div class="form-group mb-3">
                    <label class="form-label">
                        <i class="fa fa-id-card me-2"></i> Contacto del área de sistemas
                    </label>
                    <input type="text" name="contacto_sistemas" class="form-control" placeholder="Nombre y forma de contacto" />
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Entorno de PCs Mejorado -->
<div class="section-card">
    <div class="card-header bg-primary text-white">
        <div class="d-flex align-items-center">
            <div class="icon-circle bg-white text-primary">
                <i class="fa fa-desktop"></i>
            </div>
            <h3 class="mb-0 fs-4">Entorno de PCs</h3>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="form-group mb-3">
                    <label class="form-label d-flex align-items-center">
                        <i class="fa fa-windows me-2"></i> PCs Windows <span class="text-danger">*</span>
                        <i class="fa fa-question-circle info-tooltip" data-bs-toggle="tooltip" title="Cantidad de computadoras con Windows que necesitarán acceso"></i>
                    </label>
                    <div class="input-group">
                        <input type="number" name="cantidad_windows" class="form-control" required="required" min="0" value="0" />
                        <span class="input-group-text">PCs</span>
                    </div>
                    <div class="invalid-feedback">Por favor, ingrese un número válido.</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group mb-3">
                    <label class="form-label d-flex align-items-center">
                        <i class="fa fa-apple me-2"></i> PCs Mac <span class="text-danger">*</span>
                        <i class="fa fa-question-circle info-tooltip" data-bs-toggle="tooltip" title="Cantidad de computadoras Mac que necesitarán acceso"></i>
                    </label>
                    <div class="input-group">
                        <input type="number" name="cantidad_mac" class="form-control" required="required" min="0" value="0" />
                        <span class="input-group-text">PCs</span>
                    </div>
                    <div class="invalid-feedback">Por favor, ingrese un número válido.</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group mb-3">
                    <label class="form-label d-flex align-items-center">
                        <i class="fa fa-linux me-2"></i> PCs Linux <span class="text-danger">*</span>
                        <i class="fa fa-question-circle info-tooltip" data-bs-toggle="tooltip" title="Cantidad de computadoras Linux que necesitarán acceso"></i>
                    </label>
                    <div class="input-group">
                        <input type="number" name="cantidad_linux" class="form-control" required="required" min="0" value="0" />
                        <span class="input-group-text">PCs</span>
                    </div>
                    <div class="invalid-feedback">Por favor, ingrese un número válido.</div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Control de Impresión Mejorado -->
<div class="section-card">
    <div class="card-header bg-success text-white">
        <div class="d-flex align-items-center">
            <div class="icon-circle bg-white text-success">
                <i class="fa fa-user-lock"></i>
            </div>
            <h3 class="mb-0 fs-4">Control de Impresión</h3>
        </div>
    </div>
    <div class="card-body">
        <div class="form-check form-switch mb-4">
            <input class="form-check-input" type="checkbox" name="control_impresion" id="control_impresion" />
            <label class="form-check-label fs-5" for="control_impresion">
                <i class="fa fa-shield-alt me-2"></i> Activar control de impresión
            </label>
        </div>

        <div id="opciones_control_impresion" class="border rounded p-4 bg-light">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label class="form-label d-flex align-items-center">
                            <i class="fa fa-users-cog me-2"></i> Tipo de Control
                            <i class="fa fa-question-circle info-tooltip" data-bs-toggle="tooltip" 
                               title="Seleccione cómo se organizará el control de impresión"></i>
                        </label>
                        <select name="tipo_control" class="form-select">
                            <option value="">Seleccionar...</option>
                            <option value="usuario">Por Usuario</option>
                            <option value="departamento">Por Departamento</option>
                            <option value="proyecto">Por Proyecto</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label class="form-label d-flex align-items-center">
                            <i class="fa fa-users me-2"></i> Cantidad de Usuarios
                            <i class="fa fa-question-circle info-tooltip" data-bs-toggle="tooltip"
                               title="Número total de usuarios que necesitarán acceso"></i>
                        </label>
                        <input type="number" name="cantidad_usuarios" class="form-control" min="0" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="requiere_reportes" id="requiere_reportes" />
                            <label class="form-check-label" for="requiere_reportes">
                                <i class="fa fa-chart-bar me-2"></i> Requiere reportes de uso
                            </label>
                        </div>
                        <select name="frecuencia_reportes" class="form-select" id="frecuencia_reportes">
                                <option value="">Frecuencia de reportes...</option>
                                <option value="diario">Diario</option>
                                <option value="semanal">Semanal</option>
                                <option value="mensual">Mensual</option>
                            </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Configuración de Escaneo Mejorada -->
<div class="section-card">
    <div class="card-header bg-warning text-dark">
        <div class="d-flex align-items-center">
            <div class="icon-circle bg-white text-warning">
                <i class="fa fa-scanner"></i>
            </div>
            <h3 class="mb-0 fs-4">Configuración de Escaneo</h3>
        </div>
    </div>
    <div class="card-body">
        <div class="alert alert-warning bg-warning bg-opacity-10 border-0">
            <i class="fa fa-exclamation-triangle me-2 fs-5"></i>
            <div>
                <p class="mb-0">Recuerde que para utilizar el escaneo a FTP, todas las PCs deben tener IP fija configurada.</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card h-100 border-0 bg-light rounded-3">
                    <div class="card-body">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="usar_smb" id="usar_smb" />
                            <label class="form-check-label fs-5" for="usar_smb">
                                <i class="fa fa-folder-open me-2"></i> Escaneo a carpeta compartida (SMB)
                            </label>
                        </div>
                        <small class="text-muted d-block mt-2">
                            <i class="fa fa-info-circle me-1"></i> Permite escanear directamente a carpetas compartidas en la red
                        </small>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100 border-0 bg-light rounded-3">
                    <div class="card-body">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="usar_ftp" id="usar_ftp" />
                            <label class="form-check-label fs-5" for="usar_ftp">
                                <i class="fa fa-upload me-2"></i> Escaneo a FTP
                            </label>
                        </div>
                        <small class="text-muted d-block mt-2">
                            <i class="fa fa-info-circle me-1"></i> Se requiere IP fija en todas las PCs para esta funcionalidad
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-0 bg-light rounded-3">
                    <div class="card-body">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="usar_email" id="usar_email" />
                            <label class="form-check-label fs-5" for="usar_email">
                                <i class="fa fa-envelope me-2"></i> Escaneo a Email
                            </label>
                        </div>
                        <div id="opciones_email" class="mt-3 border-top pt-3">
                            <div class="form-group">
                                <label class="form-label d-block mb-2">Tipo de servidor de correo</label>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="tipo_servidor_email" 
                                           id="servidor_propio" value="propio" />
                                    <label class="form-check-label" for="servidor_propio">
                                        Servidor de correo propio
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="tipo_servidor_email" 
                                           id="servidor_proveedor" value="proveedor" />
                                    <label class="form-check-label" for="servidor_proveedor">
                                        Usar servidor del proveedor
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Espacio Físico y Acceso -->
<div class="section-card">
    <div class="card-header bg-danger text-white">
        <div class="d-flex align-items-center">
            <div class="icon-circle bg-white text-danger">
                <i class="fa fa-ruler-combined"></i>
            </div>
            <h3 class="mb-0 fs-4">Espacio Físico y Acceso</h3>
        </div>
    </div>
    <div class="card-body">
        <div class="alert alert-info bg-info bg-opacity-10 border-0">
            <i class="fa fa-info-circle me-2 fs-5"></i>
            <div>
                <p class="mb-0">Se requiere un espacio mínimo de 2m² y un pasillo de al menos 1m de ancho para la instalación y mantenimiento.</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- Medidas del espacio -->
            <div class="col-md-6">
                <div class="card border-0 bg-light h-100 rounded-3">
                    <div class="card-body">
                        <h5 class="card-title fw-bold mb-3">
                            <i class="fa fa-expand-arrows-alt me-2"></i> Medidas del Espacio
                        </h5>
                        <div class="form-group mb-3">
                            <label class="form-label d-flex align-items-center">
                                <i class="fa fa-square me-2"></i> Espacio Disponible <span class="text-danger">*</span>
                                <i class="fa fa-question-circle info-tooltip" data-bs-toggle="tooltip" 
                                   title="Mínimo requerido: 2m²"></i>
                            </label>
                            <div class="input-group">
                                <input type="number" name="espacio" class="form-control" step="0.1" 
                                       required="required" min="2" />
                                <span class="input-group-text">m²</span>
                            </div>
                            <div class="invalid-feedback">El espacio mínimo debe ser de 2m².</div>
                        </div>
                        <div class="form-group">
                            <label class="form-label d-flex align-items-center">
                                <i class="fa fa-arrows-alt-h me-2"></i> Ancho del Pasillo <span class="text-danger">*</span>
                                <i class="fa fa-question-circle info-tooltip" data-bs-toggle="tooltip" 
                                   title="Mínimo requerido: 1m"></i>
                            </label>
                            <div class="input-group">
                                <input type="number" name="ancho_pasillo" class="form-control" step="0.1" 
                                       required="required" min="1" />
                                <span class="input-group-text">m</span>
                            </div>
                            <div class="invalid-feedback">El ancho mínimo debe ser de 1m.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Acceso -->
            <div class="col-md-6">
                <div class="card border-0 bg-light h-100 rounded-3">
                    <div class="card-body">
                        <h5 class="card-title fw-bold mb-3">
                            <i class="fa fa-door-open me-2"></i> Acceso al Local
                        </h5>
                        <div class="form-group mb-3">
                            <label class="form-label">
                                <i class="fa fa-building me-2"></i> Número de Piso <span class="text-danger">*</span>
                            </label>
                            <input type="number" name="piso" class="form-control" required="required" min="0" />
                            <div class="invalid-feedback">Por favor, ingrese un número de piso válido.</div>
                        </div>
                        <div class="form-check mb-3">

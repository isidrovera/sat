<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ===================================================== -->
        <!-- FORMULARIO DE MODELO DE MÁQUINA                       -->
        <!-- ===================================================== -->

        <record id="modelos_maquina_form_view" model="ir.ui.view">
            <field name="name">modelo.maquina.form</field>
            <field name="model">modelo.maquina</field>
            <field name="arch" type="xml">
                <form string="Modelo de máquina">

                    <header>

                        <button
                            name="action_generate_external_id"
                            type="object"
                            string="Generar ID externo"
                            icon="fa-link"
                            class="btn-primary"
                            invisible="not id or external_id_state == 'generated'"
                        />

                        <button
                            name="action_export_models_xml"
                            type="object"
                            string="Exportar XML"
                            icon="fa-download"
                            class="btn-secondary"
                            invisible="not id or external_id_state != 'generated'"
                        />

                    </header>

                    <sheet>

                        <!-- ===================================== -->
                        <!-- BOTONES ESTADÍSTICOS                  -->
                        <!-- ===================================== -->

                        <div class="oe_button_box" name="button_box">

                            <button
                                class="oe_stat_button"
                                type="object"
                                name="action_view_equipos_modelo"
                                icon="fa-print"
                            >
                                <field
                                    string="Equipos activos"
                                    name="equipos_activos_count"
                                    widget="statinfo"
                                />
                            </button>

                            <button
                                class="oe_stat_button"
                                type="object"
                                name="action_configurar_valores_predeterminados"
                                icon="fa-magic"
                            >
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">
                                        Configurar
                                    </span>
                                    <span class="o_stat_text">
                                        valores
                                    </span>
                                </div>
                            </button>

                            <button
                                class="oe_stat_button"
                                type="object"
                                name="action_ver_componentes"
                                icon="fa-cog"
                            >
                                <field
                                    string="Componentes"
                                    name="total_componentes"
                                    widget="statinfo"
                                />
                            </button>

                            <button
                                class="oe_stat_button"
                                type="object"
                                name="action_ver_accesorios"
                                icon="fa-puzzle-piece"
                            >
                                <field
                                    string="Accesorios"
                                    name="total_accesorios"
                                    widget="statinfo"
                                />
                            </button>

                        </div>

                        <!-- ===================================== -->
                        <!-- TÍTULO                                -->
                        <!-- ===================================== -->

                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field
                                    name="name"
                                    placeholder="Modelo de máquina"
                                />
                            </h1>
                        </div>

                        <!-- ===================================== -->
                        <!-- INFORMACIÓN PRINCIPAL                 -->
                        <!-- ===================================== -->

                        <group>

                            <group string="Información básica">

                                <field name="marca_id"/>

                                <field
                                    name="familia_id"
                                    options="{
                                        'no_create_edit': False
                                    }"
                                />

                                <field
                                    name="codigo_tecnico"
                                    placeholder="Ejemplo: mp_c4504"
                                />

                                <field name="tipo_id"/>

                                <field name="tipo_maquina_id"/>

                                <field
                                    name="modelo_referencia_id"
                                    invisible="id"
                                    options="{
                                        'no_create': True,
                                        'no_open': True
                                    }"
                                    placeholder="Seleccione un modelo de referencia"
                                />

                                <field
                                    name="mostrar_toner_color"
                                    column_invisible="1"
                                />

                                <field name="gestionar_toner_automatico"/>

                            </group>

                            <group string="Identificación XML">

                                <field
                                    name="external_id_state"
                                    widget="badge"
                                    readonly="1"
                                    decoration-success="external_id_state == 'generated'"
                                    decoration-warning="external_id_state == 'pending'"
                                    decoration-danger="external_id_state == 'conflict'"
                                />

                                <field
                                    name="external_id_display"
                                    readonly="1"
                                    placeholder="Pendiente de generar"
                                />

                                <field
                                    name="external_id_generated_date"
                                    readonly="1"
                                    invisible="not external_id_generated_date"
                                />

                                <field
                                    name="external_id_generated_by"
                                    readonly="1"
                                    invisible="not external_id_generated_by"
                                />

                            </group>

                        </group>

                        <group>

                            <group string="Información comercial">

                                <field
                                    name="currency_id"
                                    string="Tipo de moneda"
                                />

                                <field
                                    name="precio_venta"
                                    widget="monetary"
                                    options="{
                                        'currency_field': 'currency_id'
                                    }"
                                />

                                <field
                                    name="equipos_activos_count"
                                    readonly="1"
                                />

                            </group>

                            <group string="Estado de configuración">

                                <field
                                    name="total_componentes"
                                    readonly="1"
                                />

                                <field
                                    name="total_accesorios"
                                    readonly="1"
                                />

                            </group>

                        </group>

                        <!-- ===================================== -->
                        <!-- ALERTAS DE ID EXTERNO                 -->
                        <!-- ===================================== -->

                        <div
                            class="alert alert-info"
                            invisible="external_id_state == 'generated'"
                        >
                            <strong>ID externo pendiente.</strong>
                            Después de guardar el modelo, utilice
                            <strong>Generar ID externo</strong>.
                        </div>

                        <div
                            class="alert alert-success"
                            invisible="external_id_state != 'generated'"
                        >
                            El modelo ya puede actualizarse mediante XML
                            utilizando:
                            <strong>
                                <field
                                    name="external_id_display"
                                    readonly="1"
                                />
                            </strong>
                        </div>

                        <div
                            class="alert alert-danger"
                            invisible="external_id_state != 'conflict'"
                        >
                            Existe otro registro utilizando el ID externo
                            propuesto. Revise la marca y el código técnico.
                        </div>

                        <!-- ===================================== -->
                        <!-- PESTAÑAS                              -->
                        <!-- ===================================== -->

                        <notebook>

                            <!-- CONFIGURACIÓN -->

                            <page
                                string="Configuración"
                                name="configuracion"
                            >

                                <group>

                                    <group
                                        string="Copiar desde otro modelo"
                                        invisible="not id"
                                    >

                                        <field
                                            name="modelo_referencia_id"
                                            nolabel="1"
                                            options="{
                                                'no_create': True,
                                                'no_open': True
                                            }"
                                            placeholder="Seleccione un modelo"
                                        />

                                        <button
                                            name="action_copiar_desde_modelo"
                                            string="Copiar configuración ahora"
                                            type="object"
                                            icon="fa-copy"
                                            class="btn-primary"
                                            invisible="not modelo_referencia_id or not id"
                                        />

                                    </group>

                                    <group
                                        string="Configuración actual"
                                        invisible="not id"
                                    >

                                        <button
                                            name="action_ver_componentes"
                                            type="object"
                                            class="btn-link"
                                            icon="fa-cog"
                                        >
                                            Ver componentes configurados
                                        </button>

                                        <button
                                            name="action_ver_accesorios"
                                            type="object"
                                            class="btn-link"
                                            icon="fa-puzzle-piece"
                                        >
                                            Ver accesorios configurados
                                        </button>

                                    </group>

                                </group>

                                <div class="alert alert-info">

                                    <strong>
                                        Funcionamiento de la configuración:
                                    </strong>

                                    <ul class="mb-0">

                                        <li>
                                            La configuración específica del
                                            modelo tendrá prioridad.
                                        </li>

                                        <li>
                                            La familia se utilizará como apoyo
                                            para compatibilidades comunes.
                                        </li>

                                        <li>
                                            Los modelos monocromáticos solo
                                            copiarán componentes negros.
                                        </li>

                                        <li>
                                            Los componentes o accesorios que
                                            ya existan no se duplicarán.
                                        </li>

                                    </ul>

                                </div>

                            </page>

                            <!-- TÓNER -->

                            <page
                                string="Configuración de tóner"
                                name="toner_config"
                            >

                                <group>

                                    <group string="Durabilidad de tóners">

                                        <field
                                            name="durabilidad_toner_black"
                                            string="Tóner negro"
                                        />

                                        <field
                                            name="durabilidad_toner_cyan"
                                            string="Tóner cian"
                                            invisible="tipo_id != 'color'"
                                        />

                                        <field
                                            name="durabilidad_toner_magenta"
                                            string="Tóner magenta"
                                            invisible="tipo_id != 'color'"
                                        />

                                        <field
                                            name="durabilidad_toner_yellow"
                                            string="Tóner amarillo"
                                            invisible="tipo_id != 'color'"
                                        />

                                        <button
                                            name="action_configurar_valores_predeterminados"
                                            type="object"
                                            string="Configurar valores típicos"
                                            class="btn-secondary"
                                            icon="fa-magic"
                                        />

                                    </group>

                                    <group string="Stock mínimo">

                                        <field
                                            name="stock_minimo_black"
                                            string="Tóner negro"
                                        />

                                        <field
                                            name="stock_minimo_cyan"
                                            string="Tóner cian"
                                            invisible="tipo_id != 'color'"
                                        />

                                        <field
                                            name="stock_minimo_magenta"
                                            string="Tóner magenta"
                                            invisible="tipo_id != 'color'"
                                        />

                                        <field
                                            name="stock_minimo_yellow"
                                            string="Tóner amarillo"
                                            invisible="tipo_id != 'color'"
                                        />

                                    </group>

                                </group>

                                <group>

                                    <group string="Tiempos">

                                        <field name="tiempo_entrega_dias"/>

                                        <field name="margen_seguridad_dias"/>

                                        <field
                                            name="tiempo_total_prevencion"
                                            readonly="1"
                                        />

                                    </group>

                                    <group string="Alertas">

                                        <field
                                            name="alerta_stock_critico"
                                            widget="boolean_toggle"
                                        />

                                        <field
                                            name="alerta_consumo_alto"
                                            widget="boolean_toggle"
                                        />

                                        <field
                                            name="gestionar_toner_automatico"
                                            widget="boolean_toggle"
                                        />

                                    </group>

                                </group>

                                <group string="Resumen">
                                    <field
                                        name="resumen_configuracion_toner"
                                        readonly="1"
                                        nolabel="1"
                                    />
                                </group>

                            </page>

                            <!-- EQUIPOS ASOCIADOS -->

                            <page
                                string="Equipos asociados"
                                name="equipos"
                            >

                                <group>

                                    <group>

                                        <field
                                            name="equipos_activos_count"
                                            readonly="1"
                                        />

                                    </group>

                                    <group>

                                        <button
                                            name="action_view_equipos_modelo"
                                            type="object"
                                            string="Ver equipos"
                                            class="btn-primary"
                                            icon="fa-print"
                                        />

                                        <button
                                            name="action_aplicar_configuracion_equipos"
                                            type="object"
                                            string="Aplicar configuración"
                                            class="btn-secondary"
                                            icon="fa-refresh"
                                            invisible="equipos_activos_count == 0"
                                        />

                                    </group>

                                </group>

                                <div
                                    class="alert alert-info"
                                    invisible="equipos_activos_count > 0"
                                >
                                    No hay equipos alquilados utilizando este
                                    modelo actualmente.
                                </div>

                                <div
                                    class="alert alert-warning"
                                    invisible="equipos_activos_count == 0"
                                >
                                    Los cambios de tóner afectarán los cálculos
                                    futuros. Los registros históricos no serán
                                    modificados.
                                </div>

                            </page>

                        </notebook>

                    </sheet>

                   

                </form>
            </field>
        </record>

        <!-- ===================================================== -->
        <!-- LISTA DE MODELOS                                      -->
        <!-- ===================================================== -->

        <record id="modelos_maquina_tree_view" model="ir.ui.view">
            <field name="name">modelo.maquina.list</field>
            <field name="model">modelo.maquina</field>
            <field name="arch" type="xml">

                <list string="Modelos de máquinas">

                    <field name="marca_id"/>

                    <field
                        name="familia_id"
                        optional="show"
                    />

                    <field name="name"/>

                    <field
                        name="codigo_tecnico"
                        optional="show"
                    />

                    <field name="tipo_id"/>

                    <field
                        name="tipo_maquina_id"
                        optional="show"
                    />

                    <field
                        name="external_id_display"
                        string="ID externo"
                        optional="show"
                    />

                    <field
                        name="external_id_state"
                        string="Estado ID"
                        widget="badge"
                        optional="show"
                        decoration-success="external_id_state == 'generated'"
                        decoration-warning="external_id_state == 'pending'"
                        decoration-danger="external_id_state == 'conflict'"
                    />

                    <field
                        name="currency_id"
                        string="Moneda"
                        optional="hide"
                    />

                    <field
                        name="precio_venta"
                        widget="monetary"
                        options="{
                            'currency_field': 'currency_id'
                        }"
                        optional="hide"
                    />

                    <field
                        name="durabilidad_toner_black"
                        string="Dur. negro"
                        optional="hide"
                    />

                    <field
                        name="stock_minimo_black"
                        string="Stock mínimo"
                        optional="hide"
                    />

                    <field
                        name="tiempo_entrega_dias"
                        string="Entrega"
                        optional="hide"
                    />

                    <field
                        name="gestionar_toner_automatico"
                        string="Gestión automática"
                        widget="boolean_toggle"
                        optional="hide"
                    />

                    <field
                        name="total_componentes"
                        string="Componentes"
                        optional="hide"
                    />

                    <field
                        name="total_accesorios"
                        string="Accesorios"
                        optional="hide"
                    />

                    <field
                        name="equipos_activos_count"
                        string="Equipos"
                        optional="show"
                    />

                    <button
                        name="action_generate_external_id"
                        type="object"
                        icon="fa-link"
                        title="Generar ID externo"
                        invisible="external_id_state == 'generated'"
                    />

                    <button
                        name="action_export_models_xml"
                        type="object"
                        icon="fa-download"
                        title="Exportar XML"
                        invisible="external_id_state != 'generated'"
                    />

                </list>

            </field>
        </record>

        <!-- ===================================================== -->
        <!-- BÚSQUEDA DE MODELOS                                   -->
        <!-- ===================================================== -->

        <record id="modelos_maquina_search_view" model="ir.ui.view">
            <field name="name">modelo.maquina.search</field>
            <field name="model">modelo.maquina</field>
            <field name="arch" type="xml">

                <search string="Buscar modelos de máquinas">

                    <field name="name"/>
                    <field name="codigo_tecnico"/>
                    <field name="marca_id"/>
                    <field name="familia_id"/>
                    <field name="tipo_id"/>
                    <field name="tipo_maquina_id"/>

                    <separator/>

                    <filter
                        string="Sin código técnico"
                        name="sin_codigo_tecnico"
                        domain="[
                            '|',
                            ('codigo_tecnico', '=', False),
                            ('codigo_tecnico', '=', '')
                        ]"
                    />

                    <filter
                        string="Sin familia"
                        name="sin_familia"
                        domain="[('familia_id', '=', False)]"
                    />

                    <filter
                        string="Con gestión de tóner"
                        name="with_toner_management"
                        domain="[
                            ('gestionar_toner_automatico', '=', True)
                        ]"
                    />

                    <filter
                        string="Máquinas color"
                        name="color_machines"
                        domain="[('tipo_id', '=', 'color')]"
                    />

                    <filter
                        string="Máquinas monocromáticas"
                        name="mono_machines"
                        domain="[('tipo_id', '=', 'monocromatica')]"
                    />

                    <filter
                        string="Con equipos activos"
                        name="with_active_equipment"
                        domain="[('equipos_activos_count', '>', 0)]"
                    />

                    <group expand="1" string="Agrupar por">

                        <filter
                            string="Marca"
                            name="group_marca"
                            context="{'group_by': 'marca_id'}"
                        />

                        <filter
                            string="Familia"
                            name="group_familia"
                            context="{'group_by': 'familia_id'}"
                        />

                        <filter
                            string="Tipo"
                            name="group_tipo"
                            context="{'group_by': 'tipo_id'}"
                        />

                        <filter
                            string="Tipo de máquina"
                            name="group_tipo_maquina"
                            context="{'group_by': 'tipo_maquina_id'}"
                        />

                    </group>

                </search>

            </field>
        </record>

        <!-- ===================================================== -->
        <!-- ACCIONES MASIVAS                                      -->
        <!-- ===================================================== -->

        <record
            id="server_action_generate_model_external_ids"
            model="ir.actions.server"
        >
            <field name="name">Generar IDs externos</field>
            <field
                name="model_id"
                ref="model_modelo_maquina"
            />
            <field
                name="binding_model_id"
                ref="model_modelo_maquina"
            />
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
action = records.action_generate_external_id()
            </field>
        </record>

        <record
            id="server_action_export_models_xml"
            model="ir.actions.server"
        >
            <field name="name">Exportar modelos a XML</field>
            <field
                name="model_id"
                ref="model_modelo_maquina"
            />
            <field
                name="binding_model_id"
                ref="model_modelo_maquina"
            />
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
action = records.action_export_models_xml()
            </field>
        </record>

    </data>
</odoo>
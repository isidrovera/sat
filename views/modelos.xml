<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ===================================================== -->
        <!-- FORMULARIO                                            -->
        <!-- ===================================================== -->

        <record id="modelos_maquina_form_view" model="ir.ui.view">
            <field name="name">modelo.maquina.form</field>
            <field name="model">modelo.maquina</field>
            <field name="arch" type="xml">

                <form string="Modelo de máquina">

                    <header>

                        <button
                            name="action_generate_external_id"
                            type="object"
                            string="Generar ID externo"
                            icon="fa-link"
                            class="btn-primary"
                            invisible="not id or external_id_state == 'generated'"
                        />

                        <button
                            name="action_export_models_xml"
                            type="object"
                            string="Exportar XML"
                            icon="fa-download"
                            class="btn-secondary"
                            invisible="not id or external_id_state != 'generated'"
                        />

                    </header>

                    <sheet>

                        <!-- ===================================== -->
                        <!-- BOTONES ESTADÍSTICOS                  -->
                        <!-- ===================================== -->

                        <div class="oe_button_box" name="button_box">

                            <button
                                class="oe_stat_button"
                                type="object"
                                name="action_view_equipos_modelo"
                                icon="fa-print"
                            >
                                <field
                                    name="equipos_activos_count"
                                    string="Equipos activos"
                                    widget="statinfo"
                                />
                            </button>

                            <button
                                class="oe_stat_button"
                                type="object"
                                name="action_ver_componentes"
                                icon="fa-cog"
                            >
                                <field
                                    name="total_componentes"
                                    string="Componentes"
                                    widget="statinfo"
                                />
                            </button>

                            <button
                                class="oe_stat_button"
                                type="object"
                                name="action_ver_accesorios"
                                icon="fa-puzzle-piece"
                            >
                                <field
                                    name="total_accesorios"
                                    string="Accesorios"
                                    widget="statinfo"
                                />
                            </button>

                        </div>

                        <!-- ===================================== -->
                        <!-- TÍTULO                                -->
                        <!-- ===================================== -->

                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field
                                    name="name"
                                    placeholder="Modelo de máquina"
                                />
                            </h1>
                        </div>

                        <!-- ===================================== -->
                        <!-- INFORMACIÓN PRINCIPAL                 -->
                        <!-- ===================================== -->

                        <group>

                            <group string="Información básica">

                                <field name="marca_id"/>

                                <field
                                    name="familia_id"
                                    options="{'no_create_edit': False}"
                                />

                                <field
                                    name="codigo_tecnico"
                                    placeholder="Ejemplo: bizhub_c258"
                                />

                                <field name="tipo_id"/>

                                <field name="tipo_maquina_id"/>

                                <field
                                    name="mostrar_toner_color"
                                    invisible="1"
                                />

                                <field
                                    name="gestionar_toner_automatico"
                                    widget="boolean_toggle"
                                />

                            </group>

                            <group string="Identificación XML">

                                <field
                                    name="external_id_state"
                                    widget="badge"
                                    readonly="1"
                                    decoration-success="external_id_state == 'generated'"
                                    decoration-warning="external_id_state == 'pending'"
                                    decoration-danger="external_id_state == 'conflict'"
                                />

                                <field
                                    name="external_id_display"
                                    readonly="1"
                                    placeholder="Pendiente de generar"
                                />

                                <field
                                    name="external_id_generated_date"
                                    readonly="1"
                                    invisible="not external_id_generated_date"
                                />

                                <field
                                    name="external_id_generated_by"
                                    readonly="1"
                                    invisible="not external_id_generated_by"
                                />

                            </group>

                        </group>

                        <group>

                            <group string="Información comercial">

                                <field
                                    name="currency_id"
                                    string="Moneda"
                                />

                                <field
                                    name="precio_venta"
                                    widget="monetary"
                                    options="{'currency_field': 'currency_id'}"
                                />

                            </group>

                            <group string="Configuración técnica">

                                <field
                                    name="total_componentes"
                                    readonly="1"
                                />

                                <field
                                    name="total_accesorios"
                                    readonly="1"
                                />

                                <field
                                    name="equipos_activos_count"
                                    readonly="1"
                                />

                            </group>

                        </group>

                        <!-- ===================================== -->
                        <!-- MENSAJES XML                          -->
                        <!-- ===================================== -->

                        <div
                            class="alert alert-info"
                            invisible="external_id_state == 'generated'"
                        >
                            <strong>ID externo pendiente.</strong>
                            Guarde el modelo y genere su ID externo antes
                            de exportarlo a XML.
                        </div>

                        <div
                            class="alert alert-success"
                            invisible="external_id_state != 'generated'"
                        >
                            Este modelo puede actualizarse desde XML mediante:
                            <strong>
                                <field
                                    name="external_id_display"
                                    readonly="1"
                                />
                            </strong>
                        </div>

                        <div
                            class="alert alert-danger"
                            invisible="external_id_state != 'conflict'"
                        >
                            El ID externo propuesto está siendo utilizado
                            por otro registro.
                        </div>

                        <notebook>

                            <!-- ================================= -->
                            <!-- CONFIGURACIÓN GENERAL             -->
                            <!-- ================================= -->

                            <page
                                string="Configuración"
                                name="configuracion"
                            >

                                <group>

                                    <group
                                        string="Copiar desde otro modelo"
                                        invisible="not id"
                                    >

                                        <field
                                            name="modelo_referencia_id"
                                            options="{
                                                'no_create': True,
                                                'no_open': True
                                            }"
                                            placeholder="Seleccione un modelo"
                                        />

                                        <button
                                            name="action_copiar_desde_modelo"
                                            string="Copiar configuración"
                                            type="object"
                                            icon="fa-copy"
                                            class="btn-primary"
                                            invisible="not modelo_referencia_id"
                                        />

                                    </group>

                                    <group
                                        string="Configuración actual"
                                        invisible="not id"
                                    >

                                        <button
                                            name="action_ver_componentes"
                                            string="Ver componentes"
                                            type="object"
                                            icon="fa-cog"
                                            class="btn-secondary"
                                        />

                                        <button
                                            name="action_ver_accesorios"
                                            string="Ver accesorios"
                                            type="object"
                                            icon="fa-puzzle-piece"
                                            class="btn-secondary"
                                        />

                                    </group>

                                </group>

                                <div class="alert alert-info">
                                    La configuración exacta de tóner, unidades
                                    y subpartes pertenece al modelo. La familia
                                    se utiliza principalmente para organizar
                                    compatibilidades comunes.
                                </div>

                            </page>

                            <!-- ================================= -->
                            <!-- CONFIGURACIÓN DE TÓNER            -->
                            <!-- ================================= -->

                            <page
                                string="Configuración de tóner"
                                name="toner_config"
                            >

                                <div class="alert alert-info">
                                    Las duraciones registradas aquí representan
                                    los valores oficiales del fabricante. El
                                    rendimiento real se calcula y conserva en
                                    cada pedido o entrega de tóner.
                                </div>

                                <!-- NEGRO -->

                                <div class="card border-dark mb-3">

                                    <div class="card-header">
                                        <strong>Tóner negro</strong>
                                    </div>

                                    <div class="card-body">

                                        <group>

                                            <group string="Identificación">

                                                <field
                                                    name="toner_modelo_black"
                                                    placeholder="Ejemplo: TN-324K"
                                                />

                                                <field
                                                    name="toner_codigo_parte_black"
                                                    placeholder="Ejemplo: A8DA130"
                                                />

                                            </group>

                                            <group string="Fabricante y control">

                                                <field
                                                    name="durabilidad_toner_black"
                                                    string="Duración fabricante"
                                                />

                                                <field
                                                    name="stock_minimo_black"
                                                />

                                            </group>

                                        </group>

                                    </div>

                                </div>

                                <!-- CIAN -->

                                <div
                                    class="card border-info mb-3"
                                    invisible="tipo_id != 'color'"
                                >

                                    <div class="card-header">
                                        <strong>Tóner cian</strong>
                                    </div>

                                    <div class="card-body">

                                        <group>

                                            <group string="Identificación">

                                                <field
                                                    name="toner_modelo_cyan"
                                                    placeholder="Ejemplo: TN-324C"
                                                />

                                                <field
                                                    name="toner_codigo_parte_cyan"
                                                    placeholder="Código OEM"
                                                />

                                            </group>

                                            <group string="Fabricante y control">

                                                <field
                                                    name="durabilidad_toner_cyan"
                                                    string="Duración fabricante"
                                                />

                                                <field
                                                    name="stock_minimo_cyan"
                                                />

                                            </group>

                                        </group>

                                    </div>

                                </div>

                                <!-- MAGENTA -->

                                <div
                                    class="card border-danger mb-3"
                                    invisible="tipo_id != 'color'"
                                >

                                    <div class="card-header">
                                        <strong>Tóner magenta</strong>
                                    </div>

                                    <div class="card-body">

                                        <group>

                                            <group string="Identificación">

                                                <field
                                                    name="toner_modelo_magenta"
                                                    placeholder="Ejemplo: TN-324M"
                                                />

                                                <field
                                                    name="toner_codigo_parte_magenta"
                                                    placeholder="Código OEM"
                                                />

                                            </group>

                                            <group string="Fabricante y control">

                                                <field
                                                    name="durabilidad_toner_magenta"
                                                    string="Duración fabricante"
                                                />

                                                <field
                                                    name="stock_minimo_magenta"
                                                />

                                            </group>

                                        </group>

                                    </div>

                                </div>

                                <!-- AMARILLO -->

                                <div
                                    class="card border-warning mb-3"
                                    invisible="tipo_id != 'color'"
                                >

                                    <div class="card-header">
                                        <strong>Tóner amarillo</strong>
                                    </div>

                                    <div class="card-body">

                                        <group>

                                            <group string="Identificación">

                                                <field
                                                    name="toner_modelo_yellow"
                                                    placeholder="Ejemplo: TN-324Y"
                                                />

                                                <field
                                                    name="toner_codigo_parte_yellow"
                                                    placeholder="Código OEM"
                                                />

                                            </group>

                                            <group string="Fabricante y control">

                                                <field
                                                    name="durabilidad_toner_yellow"
                                                    string="Duración fabricante"
                                                />

                                                <field
                                                    name="stock_minimo_yellow"
                                                />

                                            </group>

                                        </group>

                                    </div>

                                </div>

                                <!-- FUENTE -->

                                <group string="Información técnica">

                                    <group>

                                        <field
                                            name="toner_fuente_informacion"
                                        />

                                        <field
                                            name="toner_fecha_verificacion"
                                        />

                                    </group>

                                    <group>

                                        <field
                                            name="toner_observaciones"
                                            placeholder="Referencias alternativas, región o información pendiente"
                                        />

                                    </group>

                                </group>

                                <!-- TIEMPOS Y ALERTAS -->

                                <group>

                                    <group string="Tiempos">

                                        <field name="tiempo_entrega_dias"/>

                                        <field name="margen_seguridad_dias"/>

                                        <field
                                            name="tiempo_total_prevencion"
                                            readonly="1"
                                        />

                                    </group>

                                    <group string="Alertas">

                                        <field
                                            name="alerta_stock_critico"
                                            widget="boolean_toggle"
                                        />

                                        <field
                                            name="alerta_consumo_alto"
                                            widget="boolean_toggle"
                                        />

                                        <field
                                            name="gestionar_toner_automatico"
                                            widget="boolean_toggle"
                                        />

                                    </group>

                                </group>

                                <group string="Resumen">

                                    <field
                                        name="resumen_configuracion_toner"
                                        readonly="1"
                                        nolabel="1"
                                    />

                                </group>

                            </page>

                            <!-- ================================= -->
                            <!-- EQUIPOS ASOCIADOS                 -->
                            <!-- ================================= -->

                            <page
                                string="Equipos asociados"
                                name="equipos"
                            >

                                <group>

                                    <group>

                                        <field
                                            name="equipos_activos_count"
                                            readonly="1"
                                        />

                                    </group>

                                    <group>

                                        <button
                                            name="action_view_equipos_modelo"
                                            type="object"
                                            string="Ver equipos"
                                            class="btn-primary"
                                            icon="fa-print"
                                        />

                                        <button
                                            name="action_aplicar_configuracion_equipos"
                                            type="object"
                                            string="Aplicar configuración"
                                            class="btn-secondary"
                                            icon="fa-refresh"
                                            invisible="equipos_activos_count == 0"
                                        />

                                    </group>

                                </group>

                                <div
                                    class="alert alert-info"
                                    invisible="equipos_activos_count > 0"
                                >
                                    No existen equipos alquilados utilizando
                                    este modelo.
                                </div>

                                <div
                                    class="alert alert-warning"
                                    invisible="equipos_activos_count == 0"
                                >
                                    Los cambios realizados en las referencias
                                    y duraciones serán utilizados en los pedidos
                                    futuros. El historial anterior no se modifica.
                                </div>

                            </page>

                        </notebook>

                    </sheet>

                </form>

            </field>
        </record>

        <!-- ===================================================== -->
        <!-- LISTA                                                 -->
        <!-- ===================================================== -->

        <record id="modelos_maquina_tree_view" model="ir.ui.view">
            <field name="name">modelo.maquina.list</field>
            <field name="model">modelo.maquina</field>
            <field name="arch" type="xml">

                <list string="Modelos de máquinas">

                    <field name="marca_id"/>

                    <field
                        name="familia_id"
                        optional="show"
                    />

                    <field name="name"/>

                    <field
                        name="codigo_tecnico"
                        optional="show"
                    />

                    <field name="tipo_id"/>

                    <field
                        name="tipo_maquina_id"
                        optional="show"
                    />

                    <field
                        name="toner_modelo_black"
                        string="Tóner negro"
                        optional="show"
                    />

                    <field
                        name="toner_codigo_parte_black"
                        string="Código negro"
                        optional="hide"
                    />

                    <field
                        name="durabilidad_toner_black"
                        string="Duración negro"
                        optional="show"
                    />

                    <field
                        name="toner_modelo_cyan"
                        string="Tóner cian"
                        optional="hide"
                    />

                    <field
                        name="toner_modelo_magenta"
                        string="Tóner magenta"
                        optional="hide"
                    />

                    <field
                        name="toner_modelo_yellow"
                        string="Tóner amarillo"
                        optional="hide"
                    />

                    <field
                        name="external_id_display"
                        string="ID externo"
                        optional="show"
                    />

                    <field
                        name="external_id_state"
                        string="Estado ID"
                        widget="badge"
                        optional="show"
                        decoration-success="external_id_state == 'generated'"
                        decoration-warning="external_id_state == 'pending'"
                        decoration-danger="external_id_state == 'conflict'"
                    />

                    <field
                        name="equipos_activos_count"
                        string="Equipos"
                        optional="show"
                    />

                    <button
                        name="action_generate_external_id"
                        type="object"
                        icon="fa-link"
                        title="Generar ID externo"
                        invisible="external_id_state == 'generated'"
                    />

                    <button
                        name="action_export_models_xml"
                        type="object"
                        icon="fa-download"
                        title="Exportar XML"
                        invisible="external_id_state != 'generated'"
                    />

                </list>

            </field>
        </record>

        <!-- ===================================================== -->
        <!-- BÚSQUEDA                                              -->
        <!-- ===================================================== -->

        <record id="modelos_maquina_search_view" model="ir.ui.view">
            <field name="name">modelo.maquina.search</field>
            <field name="model">modelo.maquina</field>
            <field name="arch" type="xml">

                <search string="Buscar modelos de máquinas">

                    <field name="name"/>

                    <field name="codigo_tecnico"/>

                    <field name="marca_id"/>

                    <field name="familia_id"/>

                    <field name="tipo_id"/>

                    <field name="tipo_maquina_id"/>

                    <field name="toner_modelo_black"/>

                    <field name="toner_codigo_parte_black"/>

                    <field name="toner_modelo_cyan"/>

                    <field name="toner_codigo_parte_cyan"/>

                    <field name="toner_modelo_magenta"/>

                    <field name="toner_codigo_parte_magenta"/>

                    <field name="toner_modelo_yellow"/>

                    <field name="toner_codigo_parte_yellow"/>

                    <separator/>

                    <filter
                        string="Sin referencia negra"
                        name="without_black_reference"
                        domain="[
                            ('toner_modelo_black', '=', False),
                            ('toner_codigo_parte_black', '=', False)
                        ]"
                    />

                    <filter
                        string="Información pendiente"
                        name="pending_toner_verification"
                        domain="[
                            ('toner_fuente_informacion', '=', 'pendiente')
                        ]"
                    />

                    <filter
                        string="Máquinas color"
                        name="color_machines"
                        domain="[('tipo_id', '=', 'color')]"
                    />

                    <filter
                        string="Máquinas monocromáticas"
                        name="mono_machines"
                        domain="[('tipo_id', '=', 'monocromatica')]"
                    />

                    <filter
                        string="Con equipos activos"
                        name="with_active_equipment"
                        domain="[('equipos_activos_count', '>', 0)]"
                    />

                    <group expand="1" string="Agrupar por">

                        <filter
                            string="Marca"
                            name="group_brand"
                            context="{'group_by': 'marca_id'}"
                        />

                        <filter
                            string="Familia"
                            name="group_family"
                            context="{'group_by': 'familia_id'}"
                        />

                        <filter
                            string="Tecnología"
                            name="group_type"
                            context="{'group_by': 'tipo_id'}"
                        />

                        <filter
                            string="Fuente de tóner"
                            name="group_toner_source"
                            context="{
                                'group_by': 'toner_fuente_informacion'
                            }"
                        />

                    </group>

                </search>

            </field>
        </record>

        <!-- ===================================================== -->
        <!-- KANBAN                                                -->
        <!-- ===================================================== -->

        <record id="modelos_maquina_kanban_view" model="ir.ui.view">
            <field name="name">modelo.maquina.kanban</field>
            <field name="model">modelo.maquina</field>
            <field name="arch" type="xml">

                <kanban
                    class="o_kanban_small_column"
                    sample="1"
                >

                    <field name="name"/>
                    <field name="marca_id"/>
                    <field name="familia_id"/>
                    <field name="tipo_id"/>
                    <field name="toner_modelo_black"/>
                    <field name="toner_codigo_parte_black"/>
                    <field name="durabilidad_toner_black"/>
                    <field name="equipos_activos_count"/>
                    <field name="external_id_state"/>

                    <templates>

                        <t t-name="card">

                            <div class="d-flex flex-column gap-2">

                                <div>

                                    <strong class="fs-5">
                                        <field name="name"/>
                                    </strong>

                                    <div class="text-muted">
                                        <field name="marca_id"/>
                                    </div>

                                    <div
                                        class="text-muted"
                                        t-if="record.familia_id.raw_value"
                                    >
                                        <field name="familia_id"/>
                                    </div>

                                </div>

                                <div>

                                    <strong>Tóner negro:</strong>

                                    <span
                                        t-if="record.toner_modelo_black.raw_value"
                                    >
                                        <field name="toner_modelo_black"/>
                                    </span>

                                    <span
                                        class="text-muted"
                                        t-else=""
                                    >
                                        Sin configurar
                                    </span>

                                </div>

                                <div
                                    t-if="record.toner_codigo_parte_black.raw_value"
                                >
                                    <strong>Código:</strong>
                                    <field name="toner_codigo_parte_black"/>
                                </div>

                                <div>
                                    <strong>Fabricante:</strong>
                                    <field name="durabilidad_toner_black"/>
                                    páginas
                                </div>

                                <div class="d-flex justify-content-between">

                                    <span>
                                        <field name="tipo_id"/>
                                    </span>

                                    <span>
                                        <field name="equipos_activos_count"/>
                                        equipos
                                    </span>

                                </div>

                            </div>

                        </t>

                    </templates>

                </kanban>

            </field>
        </record>

        <!-- ===================================================== -->
        <!-- ACCIONES MASIVAS                                      -->
        <!-- ===================================================== -->

        <record
            id="server_action_generate_model_external_ids"
            model="ir.actions.server"
        >
            <field name="name">Generar IDs externos</field>
            <field name="model_id" ref="model_modelo_maquina"/>
            <field name="binding_model_id" ref="model_modelo_maquina"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
action = records.action_generate_external_id()
            </field>
        </record>

        <record
            id="server_action_export_models_xml"
            model="ir.actions.server"
        >
            <field name="name">Exportar modelos a XML</field>
            <field name="model_id" ref="model_modelo_maquina"/>
            <field name="binding_model_id" ref="model_modelo_maquina"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
action = records.action_export_models_xml()
            </field>
        </record>

    </data>
</odoo>
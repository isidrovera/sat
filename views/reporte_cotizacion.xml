<odoo>
    <data>
        <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document">
            <xpath expr="//div[@class='row mt-4 mb-4' and @id='informations']" position="after">
                <div class="col-auto col-3 mw-100 mb-2">
                    <strong>Equipo:</strong>
                    <p class="m-0" t-field="doc.equipo_id"/>
                </div>
                <div class="col-auto col-3 mw-100 mb-2">
                    <strong>Observaciones:</strong>
                    <p class="m-0" t-field="doc.obs"/>
                </div>
            </xpath>
            <xpath expr="//td[@name='td_name']" position="inside">
                <span style="color: darkblue;">Total de copias:</span>
                <span t-field="line.total_copias_id"/>
            </xpath>
        </template>
    </data>
</odoo>

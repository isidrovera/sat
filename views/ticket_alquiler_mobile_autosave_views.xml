<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="soporte_form_viw_mobile_autosave_inherit" model="ir.ui.view">
            <field name="name">ticket.alquiler.form.mobile.autosave.inherit</field>
            <field name="model">ticket.alquiler</field>
            <field name="inherit_id" ref="sat.soporte_form_viw"/>
            <field name="arch" type="xml">

                <!-- Ocultar el retorno_id original para mostrarlo en una sección más visible -->
                <xpath expr="//field[@name='retorno_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- Insertar bloque móvil después del título -->
                <xpath expr="//div[contains(@class, 'oe_title')]" position="after">

                    <group string="📩 Decisión del técnico" class="o_mobile_retorno_box">
                        <group>
                            <field name="retorno_id"
                                   string="¿Requiere retorno?"
                                   required="estado in ('proceso', 'en_ruta', 'en_sitio', 'en_revision')"
                                   readonly="estado == 'finalizado'"/>
                        </group>
                        <group>
                            <div class="alert alert-warning"
                                 invisible="retorno_id">
                                <i class="fa fa-exclamation-triangle me-1"/>
                                Antes de enviar el informe, indica si requiere retorno.
                            </div>
                        </group>
                    </group>

                    <div class="o_mobile_save_bar">
                        <button name="action_guardar_cambios_movil"
                                type="object"
                                string="💾 Guardar cambios"
                                class="btn btn-primary oe_highlight"
                                invisible="estado == 'finalizado'"/>

                        <button name="action_guardar_y_volver_movil"
                                type="object"
                                string="← Guardar y volver"
                                class="btn btn-secondary"
                                invisible="estado == 'finalizado'"
                                confirm="¿Guardar los cambios y volver a la lista de tickets?"/>
                    </div>

                </xpath>

                <!-- Activar autoguardado en componentes -->
                <xpath expr="//page[@name='componentes_dinamicos']//field[@name='estado_id'][@widget='chip_select']" position="attributes">
                    <attribute name="options">{'filter_by_field': 'componente_tipo_id', 'filter_relation': 'componente_tipo_ids', 'shorten_labels': true, 'auto_save': true}</attribute>
                </xpath>

                <!-- Activar autoguardado en accesorios -->
                <xpath expr="//page[@name='accesorios_dinamicos']//field[@name='estado_id'][@widget='chip_select']" position="attributes">
                    <attribute name="options">{'shorten_labels': false, 'auto_save': true}</attribute>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- ================================
       Acción
  =================================== -->
  <record id="action_equipment_visit_report" model="ir.actions.act_window">
    <field name="name">Informes de Visitas</field>
    <field name="res_model">equipment.visit.report</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="help" type="html">
      <p>Crea y consulta informes estadísticos sobre visitas técnicas por equipo.</p>
    </field>
  </record>

  <!-- ================================
       Menú
  =================================== -->
  <menuitem id="menu_equipment_visit_reports"
            name="Informes de Visitas"
            parent="sat.ajustes"
            action="action_equipment_visit_report"
            sequence="90" />

  <!-- ================================
       Vista Listado (list)
  =================================== -->
  <record id="view_equipment_visit_report_list" model="ir.ui.view">
    <field name="name">equipment.visit.report.list</field>
    <field name="model">equipment.visit.report</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="date_from"/>
        <field name="date_to"/>
        <field name="total_visits"/>
        <field name="critical_equipment_count"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <!-- ================================
       Vista Formulario (form)
  =================================== -->
  <record id="view_equipment_visit_report_form" model="ir.ui.view">
    <field name="name">equipment.visit.report.form</field>
    <field name="model">equipment.visit.report</field>
    <field name="arch" type="xml">
      <form string="Informe de Visitas Técnicas">
        <header>
          <button name="action_generate_report" type="object" string="Generar" class="btn-primary"
                  invisible="state != 'draft'"/>
          <button name="action_send_report" type="object" string="Enviar" class="btn-secondary"
                  invisible="state != 'generated'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,generated,sent"/>
        </header>
        <sheet>
          <group>
            <field name="name"/>
            <field name="date_from"/>
            <field name="date_to"/>
            <field name="user_id"/>
            <field name="company_id"/>
          </group>
          <group string="Estadísticas" col="2">
            <field name="total_visits" readonly="1"/>
            <field name="recurring_equipment_count" readonly="1"/>
            <field name="critical_equipment_count" readonly="1"/>
            <field name="first_visit_resolution_rate" readonly="1"/>
            <field name="average_response_time" readonly="1"/>
            <field name="top_client_id" readonly="1"/>
            <field name="top_client_visit_count" readonly="1"/>
          </group>
          <group string="Configuración">
            <field name="visit_threshold"/>
            <field name="same_issue_days"/>
          </group>
          <group string="Destinatarios">
            <field name="recipient_ids" widget="many2many_tags"/>
            <field name="email_to"/>
          </group>
          <group string="Archivo">
            <field name="report_filename" readonly="1"/>
            <field name="report_data" filename="report_filename" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ================================
       Vista Kanban
  =================================== -->
  <record id="view_equipment_visit_report_kanban" model="ir.ui.view">
    <field name="name">equipment.visit.report.kanban</field>
    <field name="model">equipment.visit.report</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_example">
        <field name="name"/>
        <field name="state"/>
        <field name="date_from"/>
        <field name="date_to"/>
        <field name="total_visits"/>
        <templates>
          <t t-name="kanban-box">
            <div class="o_kanban_record">
              <div class="oe_kanban_details">
                <strong><field name="name"/></strong>
                <div><i class="fa fa-calendar"></i> <field name="date_from"/> – <field name="date_to"/></div>
                <div><i class="fa fa-cogs"></i> Visitas: <field name="total_visits"/></div>
                <div><i class="fa fa-exclamation-triangle"></i> Críticos: <field name="critical_equipment_count"/></div>
                <div>
                  <span class="badge badge-primary">
                    <field name="state"/>
                  </span>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- ================================
       Acción para informe de visitas
  =================================== -->
  <record id="action_equipment_visit_report" model="ir.actions.act_window">
    <field name="name">Informes de Visitas</field>
    <field name="res_model">equipment.visit.report</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="help" type="html">
      <p>Crea y consulta informes estadísticos sobre visitas técnicas por equipo.</p>
    </field>
  </record>

  <!-- ================================
       Acción para informe de desempeño de técnicos
  =================================== -->
  <record id="action_equipment_technician_performance_report" model="ir.actions.act_window">
    <field name="name">Desempeño de Técnicos</field>
    <field name="res_model">equipment.technician.performance.report</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p>Analiza el desempeño de los técnicos con métricas detalladas.</p>
    </field>
  </record>

  <!-- ================================
       Menú
  =================================== -->
  <menuitem id="menu_equipment_visit_reports"
            name="Informes de Visitas"
            parent="sat.ajustes"
            action="action_equipment_visit_report"
            sequence="90" />
            
  <menuitem id="menu_equipment_technician_reports"
            name="Desempeño de Técnicos"
            parent="sat.ajustes"
            action="action_equipment_technician_performance_report"
            sequence="91" />

  <!-- ================================
       Vista Listado (list) para informes de visitas
  =================================== -->
  <record id="view_equipment_visit_report_list" model="ir.ui.view">
    <field name="name">equipment.visit.report.list</field>
    <field name="model">equipment.visit.report</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="date_from"/>
        <field name="date_to"/>
        <field name="total_visits"/>
        <field name="critical_equipment_count"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <!-- ================================
       Vista Listado (list) para informes de desempeño de técnicos
  =================================== -->
  <record id="view_equipment_technician_performance_report_list" model="ir.ui.view">
    <field name="name">equipment.technician.performance.report.list</field>
    <field name="model">equipment.technician.performance.report</field>
    <field name="arch" type="xml">
      <list>
        
        <field name="date_from"/>
        <field name="date_to"/>
        <field name="technician_id"/>
        <field name="total_visits"/>
        <field name="repeat_rate" string="Tasa de Repetición (%)"/>
        <field name="performance_state" decoration-success="performance_state == 'excellent'" 
                                       decoration-primary="performance_state == 'good'"
                                       decoration-warning="performance_state == 'average'"
                                       decoration-danger="performance_state in ('poor', 'critical')"/>
      </list>
    </field>
  </record>

  <!-- ================================
       Vista Formulario (form) para informes de visitas
  =================================== -->
  <record id="view_equipment_visit_report_form" model="ir.ui.view">
    <field name="name">equipment.visit.report.form</field>
    <field name="model">equipment.visit.report</field>
    <field name="arch" type="xml">
      <form string="Informe de Visitas Técnicas">
        <header>
          <button name="action_generate_report" type="object" string="Generar" class="btn-primary"
                  invisible="state != 'draft'"/>
          <button name="action_send_report" type="object" string="Enviar" class="btn-secondary"
                  invisible="state != 'generated'"/>
          <button name="action_reset_to_draft" type="object" string="Reiniciar" 
                  invisible="state == 'sent'" class="btn-secondary"/>
          <button name="action_view_problematic_technicians" type="object" string="Ver Técnicos Problemáticos" 
                  invisible="state != 'generated'" class="btn-warning"/>
          <button name="action_export_technician_analysis" type="object" string="Exportar Análisis de Técnicos" 
                  invisible="state != 'generated'" class="btn-info"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,generated,sent"/>
        </header>
        <sheet>
          
          <group>
            <group>
              <field name="date_from"/>
              <field name="date_to"/>
              <field name="user_id"/>
              <field name="company_id"/>
            </group>
            <group>
              <field name="visit_threshold"/>
              <field name="same_issue_days"/>
            </group>
          </group>
          
          <notebook invisible="state == 'draft'">
            <page string="Estadísticas Generales">
              <group>
                <group string="Visitas">
                  <field name="total_visits" readonly="1"/>
                  <field name="recurring_equipment_count" readonly="1"/>
                  <field name="critical_equipment_count" readonly="1"/>
                  <field name="first_visit_resolution_rate" readonly="1" widget="percentage"/>
                  <field name="average_response_time" readonly="1" widget="float_time"/>
                </group>
                <group string="Clientes">
                  <field name="top_client_id" readonly="1"/>
                  <field name="top_client_visit_count" readonly="1"/>
                </group>
              </group>
            </page>
            
            <page string="Análisis de Técnicos" invisible="state == 'draft'">
              <group>
                <group string="Visitas Post-Servicio">
                  <field name="post_installation_visit_rate" readonly="1" widget="percentage"/>
                  <field name="post_maintenance_visit_rate" readonly="1" widget="percentage"/>
                  <field name="post_repair_visit_rate" readonly="1" widget="percentage"/>
                  <field name="post_review_visit_rate" readonly="1" widget="percentage"/>
                </group>
                <group string="Técnicos Problemáticos">
                  <field name="problematic_technicians" widget="many2many_tags" readonly="1"/>
                </group>
              </group>
            </page>
            
            <page string="Destinatarios">
              <group>
                <field name="recipient_ids" widget="many2many_tags"/>
                <field name="email_to"/>
              </group>
            </page>
            
            <page string="Archivos">
              <group>
                <field name="report_filename" readonly="1"/>
                <field name="report_data" filename="report_filename" readonly="1"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ================================
       Vista Formulario (form) para informes de desempeño de técnicos
  =================================== -->
  <record id="view_equipment_technician_performance_report_form" model="ir.ui.view">
    <field name="name">equipment.technician.performance.report.form</field>
    <field name="model">equipment.technician.performance.report</field>
    <field name="arch" type="xml">
      <form string="Desempeño de Técnico">
        <sheet>
          <div class="oe_title">
            <h1><field name="date_range" placeholder="Rango de Fechas"/></h1>
          </div>
          <group>
            <group>
              <field name="technician_id" required="1"/>
              <field name="date_from"/>
              <field name="date_to"/>
              <field name="performance_state" widget="badge" 
                     decoration-success="performance_state == 'excellent'"
                     decoration-primary="performance_state == 'good'"
                     decoration-warning="performance_state == 'average'"
                     decoration-danger="performance_state in ('poor', 'critical')"/>
            </group>
            <group>
              <field name="total_visits"/>
              <field name="repeat_visits"/>
              <field name="repeat_rate" widget="percentage"/>
              <field name="resolution_rate" widget="percentage"/>
            </group>
          </group>
          
          <notebook>
            <page string="Métricas por Tipo de Servicio">
              <group>
                <group>
                  <field name="post_installation_rate" widget="percentage"/>
                  <field name="post_maintenance_rate" widget="percentage"/>
                </group>
                <group>
                  <field name="post_repair_rate" widget="percentage"/>
                  <field name="post_review_rate" widget="percentage"/>
                </group>
              </group>
            </page>
            
            <page string="Equipos Problemáticos">
              <field name="problematic_equipment_ids" widget="html"/>
            </page>
            
            <page string="Gráficos">
              <field name="chart_data" widget="html"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ================================
       Vista Kanban para informes de visitas
  =================================== -->
  <record id="view_equipment_visit_report_kanban" model="ir.ui.view">
    <field name="name">equipment.visit.report.kanban</field>
    <field name="model">equipment.visit.report</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_example">
        <field name="name"/>
        <field name="state"/>
        <field name="date_from"/>
        <field name="date_to"/>
        <field name="total_visits"/>
        <field name="critical_equipment_count"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click">
              <div class="oe_kanban_details">
                <strong><field name="name"/></strong>
                <div class="text-muted"><i class="fa fa-calendar me-1"/> <field name="date_from"/> – <field name="date_to"/></div>
                <div><i class="fa fa-cogs me-1"/> Visitas: <field name="total_visits"/></div>
                <div><i class="fa fa-exclamation-triangle me-1"/> Críticos: <field name="critical_equipment_count"/></div>
                <div>
                  <span t-if="record.state.raw_value == 'draft'" 
                        class="badge text-bg-secondary">
                    Borrador
                  </span>
                  <span t-if="record.state.raw_value == 'generated'" 
                        class="badge text-bg-success">
                    Generado
                  </span>
                  <span t-if="record.state.raw_value == 'sent'" 
                        class="badge text-bg-primary">
                    Enviado
                  </span>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- ================================
       Vista para configuración
  =================================== -->
  <record id="view_equipment_visit_report_settings_form" model="ir.ui.view">
    <field name="name">equipment.visit.report.settings.form</field>
    <field name="model">equipment.visit.report.settings</field>
    <field name="arch" type="xml">
      <form string="Configuración de Informes">
        <sheet>
          <group>
            <group string="Parámetros Generales">
              <field name="visit_threshold"/>
              <field name="same_issue_days"/>
            </group>
            <group string="Umbrales de Alerta">
              <field name="post_installation_alert"/>
              <field name="post_maintenance_alert"/>
              <field name="post_repair_alert"/>
              <field name="post_review_alert"/>
            </group>
          </group>
          <group string="Destinatarios Predeterminados">
            <field name="recipient_ids" widget="many2many_tags"/>
            <field name="email_to"/>
          </group>
          <footer>
            <button string="Guardar" name="save_settings" type="object" class="btn-primary"/>
            <button string="Cancelar" class="btn-secondary" special="cancel"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Acción para acceder a configuraciones -->
  <record id="action_equipment_visit_report_settings" model="ir.actions.act_window">
    <field name="name">Configuración de Informes</field>
    <field name="res_model">equipment.visit.report.settings</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <!-- Menú para configuraciones -->
  <menuitem id="menu_equipment_visit_report_settings"
            name="Configuración de Informes"
            parent="sat.ajustes"
            action="action_equipment_visit_report_settings"
            sequence="92" />

</odoo>
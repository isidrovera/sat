<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- =========================== -->
    <!-- SEARCH (Búsqueda avanzada)  -->
    <!-- =========================== -->
    <record id="view_informe_regla_search" model="ir.ui.view">
      <field name="name">informe.regla.search</field>
      <field name="model">informe.regla</field>
      <field name="arch" type="xml">
        <search string="Buscar Reglas de Informe">
          <field name="tipo_id"/>
          <field name="color"/>
          <field name="estado_check"/>
          <field name="calidad"/>
          <field name="estado_operativo"/>
          <field name="severidad"/>

          <!-- Filtros rápidos -->
          <filter name="fil_sev_alta"  string="Severidad Alta"  domain="[('severidad','=','alta')]"/>
          <filter name="fil_sev_media" string="Severidad Media" domain="[('severidad','=','media')]"/>
          <filter name="fil_sev_baja"  string="Severidad Baja"  domain="[('severidad','=','baja')]"/>

          <filter name="fil_op_ok"     string="Operativo"          domain="[('estado_operativo','=','operativo')]"/>
          <filter name="fil_op_par"    string="Operativo parcial"  domain="[('estado_operativo','=','parcial')]"/>
          <filter name="fil_op_no"     string="No operativo"       domain="[('estado_operativo','=','no_op')]"/>

          <!-- Agrupar por -->
          <group expand="0" string="Agrupar por">
            <filter name="grp_tipo"   string="Tipo de componente" context="{'group_by':'tipo_id'}"/>
            <filter name="grp_color"  string="Color"              context="{'group_by':'color'}"/>
            <filter name="grp_check"  string="Estado check"       context="{'group_by':'estado_check'}"/>
            <filter name="grp_calid"  string="Calidad"            context="{'group_by':'calidad'}"/>
            <filter name="grp_oper"   string="Estado operativo"   context="{'group_by':'estado_operativo'}"/>
            <filter name="grp_sever"  string="Severidad"          context="{'group_by':'severidad'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ============ -->
    <!-- LIST (lista) -->
    <!-- ============ -->
    <record id="view_informe_regla_list" model="ir.ui.view">
      <field name="name">informe.regla.list</field>
      <field name="model">informe.regla</field>
      <field name="arch" type="xml">
        <list string="Reglas de Informe"
              create="1" edit="1" delete="1"
              default_order="sequence asc, tipo_id asc">
          <field name="sequence" widget="handle" optional="show"/>
          <field name="tipo_id"/>
          <field name="color" optional="show"/>
          <field name="estado_check"/>
          <field name="calidad"/>
          <field name="estado_operativo"/>
          <field name="severidad"/>
          <field name="frase_hallazgo" optional="show"/>
          <field name="frase_recomendacion" optional="show"/>
        </list>
      </field>
    </record>

    <!-- ============ -->
    <!-- FORM (form)  -->
    <!-- ============ -->
    <record id="view_informe_regla_form" model="ir.ui.view">
      <field name="name">informe.regla.form</field>
      <field name="model">informe.regla</field>
      <field name="arch" type="xml">
        <form string="Regla de Informe">
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="frase_hallazgo" placeholder="Hallazgo (8–15 palabras)"/>
              </h1>
            </div>

            <group>
              <group>
                <field name="tipo_id"/>
                <field name="color"/>
                <field name="sequence"/>
              </group>
              <group>
                <field name="estado_check"/>
                <field name="calidad"/>
                <field name="estado_operativo"/>
                <field name="severidad"/>
              </group>
            </group>

            <group string="Recomendación">
              <field name="frase_recomendacion" placeholder="Recomendación breve y accionable"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
  </data>
</odoo>

<?xml version='1.0' encoding='utf-8'?>

<odoo>
    <data>
        <template id="portal_my_home_ticket_alquiler" name="Tickets de alquiler" inherit_id="portal.portal_my_home">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Tickets de alquiler</t>
                    <t t-set="url">/my/ticket/alquiler</t>
                </t>
            </xpath>
        </template>
    </data>
    <record model="ir.ui.view" id="portal_my_ticket_alquiler_view">
        <field name="name">portal.my_ticket_alquiler_view</field>
        <field name="model">ticket.alquiler</field>
        <field name="arch" type="xml">
            <form>
                <field name="product_alquiler"/>
            </form>
        </field>
    </record>
</odoo>

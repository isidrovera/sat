<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="gallery_page_template" name="Gallery Page">
            <t t-name="sat.gallery_page_template">
                <html>
                    <head>
                        <title>Galería de Fotos - Reparación</title>
                        <meta charset="utf-8"/>
                        <meta name="viewport" content="width=device-width, initial-scale=1"/>
                        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
                        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet"/>
                        <link href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/css/lightbox.min.css" rel="stylesheet"/>
                        
                        <style>
                            /* ... (estilos anteriores) ... */
                            
                            .photo-container {
                                position: relative;
                                padding-top: 75%;
                                background: #f8f9fa;
                                overflow: hidden;
                            }
                            
                            .photo-container img {
                                position: absolute;
                                top: 0;
                                left: 0;
                                width: 100%;
                                height: 100%;
                                object-fit: contain;
                            }
                            
                            .photo-link {
                                display: block;
                                width: 100%;
                                height: 100%;
                                text-decoration: none;
                            }
                            
                            /* Corregir problema con Lightbox */
                            #lightbox img {
                                object-fit: contain;
                            }
                        </style>
                    </head>
                    <body>
                        <div class="gallery-container">
                            <div class="gallery-header">
                                <div class="d-flex justify-content-between align-items-center flex-wrap">
                                    <h1 class="h3 mb-0">Galería de Fotos - Reparación #<t t-esc="reparacion.id"/></h1>
                                    <t t-if="fotos">
                                        <a t-att-href="'/gallery/download_all/%s' % reparacion.id" 
                                           class="btn-custom btn-primary-custom">
                                            <i class="fas fa-download"/>
                                            <span>Descargar Todas</span>
                                        </a>
                                    </t>
                                </div>
                            </div>

                            <t t-if="fotos">
                                <div class="gallery-grid">
                                    <t t-foreach="fotos" t-as="foto">
                                        <div class="photo-card">
                                            <a class="photo-link" 
                                               t-att-href="foto['preview_url']"
                                               t-att-data-lightbox="'gallery'"
                                               t-att-data-title="foto['nombre']">
                                                <div class="photo-container">
                                                    <img t-att-src="foto['thumb_url']"
                                                         t-att-alt="foto['nombre']"
                                                         loading="lazy"/>
                                                </div>
                                            </a>
                                            <div class="photo-info">
                                                <div class="photo-name" t-esc="foto['nombre']"/>
                                                <a t-att-href="foto['download_url']"
                                                   class="btn-custom btn-secondary-custom w-100"
                                                   download="">
                                                    <i class="fas fa-download"/>
                                                    <span>Descargar</span>
                                                </a>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="text-center p-5 bg-white rounded-3">
                                    <h3>No hay fotos disponibles</h3>
                                </div>
                            </t>
                        </div>

                        <!-- Scripts -->
                        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"/>
                        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"/>
                        <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/js/lightbox.min.js"/>
                        <script>
                            lightbox.option({
                                'resizeDuration': 200,
                                'wrapAround': true,
                                'albumLabel': "Imagen %1 de %2",
                                'fitImagesInViewport': true
                            });
                        </script>
                    </body>
                </html>
            </t>
        </template>
    </data>
</odoo>
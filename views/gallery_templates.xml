<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="gallery_page_template">
        
        <html>
            <head>
                <title>Galería de Fotos - Reparación</title>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet"/>
                <style>
                    /* ... (estilos anteriores se mantienen igual) ... */
                </style>
            </head>
            <body>
                <div class="container">
                    <div class="gallery-header">
                        <h1 class="gallery-title">Galería de Fotos - Reparación #<t t-esc="reparacion.id"/></h1>
                        <t t-if="fotos">
                            <a t-att-href="'/gallery/download_all/%s' % reparacion.id" 
                               class="btn btn-primary">
                                <i class="fas fa-download"></i>Descargar Todas
                            </a>
                        </t>
                    </div>

                    <t t-if="fotos">
                        <div class="gallery-grid">
                            <t t-foreach="fotos" t-as="foto">
                                <div class="photo-card">
                                    <div class="photo-container">
                                        <img t-att-src="foto['image_url']"
                                             t-att-alt="foto['nombre']"
                                             class="photo-image"
                                             loading="lazy"/>
                                    </div>
                                    <div class="photo-info">
                                        <div class="photo-name" t-esc="foto['nombre']"/>
                                        <a t-att-href="foto['download_url']"
                                           class="btn btn-secondary">
                                            <i class="fas fa-download"></i>Descargar
                                        </a>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="text-center p-4">
                            <h3>No hay fotos disponibles</h3>
                        </div>
                    </t>
                </div>
            </body>
        </html>
    </template>
</odoo>
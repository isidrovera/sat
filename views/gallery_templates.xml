<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="gallery_page_template" name="Gallery Page">
        <t t-name="sat.gallery_page_template">
            <html>
                <head>
                    <title>Galería de Fotos - Reparación</title>
                    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
                </head>
                <body>
                    <div class="container">
                        <h2>Galería de Fotos - Reparación #<t t-esc="reparacion.id"/></h2>
                        <form action="/gallery/upload_photo" method="post" enctype="multipart/form-data" class="mb-3">
                            <input type="hidden" name="reparacion_id" t-att-value="reparacion.id"/>
                            <div class="input-group">
                                <input type="file" name="file" class="form-control" required/>
                                <button class="btn btn-primary" type="submit">Subir Foto</button>
                            </div>
                        </form>
                        
                        <div class="row">
                            <t t-foreach="fotos" t-as="foto">
                                <div class="col-md-3">
                                    <div class="card mb-4">
                                        <img t-att-src="foto['thumb_url']" class="card-img-top" alt="Foto"/>
                                        <div class="card-body">
                                            <h5 class="card-title" t-esc="foto['nombre']"/>
                                            <a t-att-href="foto['download_url']" class="btn btn-secondary">Descargar</a>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </body>
            </html>
        </t>
    </template>
</odoo>

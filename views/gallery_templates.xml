<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="gallery_page_template" name="Galería de Fotos">
    <html>
      <head>
        <title>Galería de Fotos</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet"/>
        <style>
          :root {
            --primary-color: #4a90e2;
            --primary-dark: #3a7bc8;
            --secondary-color: #f5f6fa;
            --text-color: #2d3436;
            --text-muted: #636e72;
            --card-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            --card-shadow-hover: 0 4px 12px rgba(0, 0, 0, 0.12);
            --success-color: #00b894;
            --camera-color: #fd79a8;
            --danger-color: #d63031;
            --border-radius: 12px;
            --transition: all 0.3s ease;
          }

          * { box-sizing: border-box; }

          body { 
            background-color: var(--secondary-color);
            color: var(--text-color);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            margin: 0;
            padding: 0;
            line-height: 1.6;
          }

          .container-fluid {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0;
          }

          /* HEADER CARD */
          .header-card { 
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
            border-radius: var(--border-radius);
            box-shadow: var(--card-shadow);
            margin: 1rem;
            padding: 1.25rem 1.5rem;
            border: 1px solid rgba(0,0,0,0.05);
          }

          .header-content { 
            display: flex;
            flex-direction: column;
            gap: 1rem;
          }

          .header-info h2 { 
            font-size: clamp(1.2rem, 4vw, 1.7rem);
            margin: 0 0 0.5rem 0;
            color: var(--primary-color);
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
          }

          .header-info h2::before {
            content: '📸';
            font-size: 1.4em;
          }

          .header-sub { 
            font-size: 0.85rem;
            color: var(--text-muted);
          }

          /* META GRID */
          .meta-grid { 
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
            gap: 0.75rem;
            margin-top: 0.25rem;
          }

          .meta-pill { 
            background: #ffffff;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 0.5rem 0.8rem;
            font-size: 0.85rem;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
          }

          .meta-pill:hover {
            border-color: var(--primary-color);
            box-shadow: 0 2px 4px rgba(74, 144, 226, 0.1);
          }

          .meta-pill b { 
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
          }

          /* ACTION BUTTONS */
          .action-buttons { 
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            align-items: center;
            justify-content: flex-start;
          }

          .btn { 
            padding: 0.45rem 0.9rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            white-space: nowrap;
          }

          .btn i {
            font-size: 0.9em; /* iconos un poco más pequeños */
          }

          .btn-main {
            min-width: 110px;
            justify-content: center;
          }

          .btn-camera { 
            background: linear-gradient(135deg, var(--camera-color) 0%, #e84393 100%);
            color: #fff;
            box-shadow: 0 4px 10px rgba(253, 121, 168, 0.25);
          }

          .btn-camera:hover { 
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(253, 121, 168, 0.35);
          }

          .btn-download-all {
            background: linear-gradient(135deg, var(--success-color) 0%, #00a383 100%);
            color: #fff;
            box-shadow: 0 4px 10px rgba(0, 184, 148, 0.25);
          }

          .btn-download-all:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(0, 184, 148, 0.35);
            color: #fff;
          }

          .btn-share-gallery {
            border: 1px solid #d0d6dc;
            background: #ffffff;
            color: var(--text-muted);
          }

          .btn-share-gallery:hover {
            background: #f1f3f5;
          }

          /* PHOTO GRID */
          .photo-grid { 
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
            gap: 1.25rem;
            padding: 0.9rem;
          }

          @media (min-width: 576px) {
            .photo-grid {
              grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
              padding: 1rem;
            }
          }

          @media (min-width: 768px) {
            .header-content { 
              flex-direction: row;
              justify-content: space-between;
              align-items: flex-start;
            }
            
            .action-buttons {
              justify-content: flex-end;
            }

            .photo-grid {
              grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
              padding: 1.25rem;
            }
          }

          @media (min-width: 1200px) {
            .photo-grid {
              grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            }
          }

          /* PHOTO CARD */
          .photo-card { 
            background: #fff;
            border-radius: var(--border-radius);
            overflow: hidden;
            box-shadow: var(--card-shadow);
            transition: var(--transition);
            border: 1px solid rgba(0,0,0,0.05);
          }

          .photo-card:hover {
            box-shadow: var(--card-shadow-hover);
            transform: translateY(-2px);
          }

          .photo-container { 
            position: relative;
            padding-top: 75%;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            cursor: zoom-in;
            overflow: hidden;
          }

          .photo-container img { 
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
          }

          .photo-container:hover img { 
            transform: scale(1.06);
          }

          .photo-badge { 
            position: absolute;
            top: 8px;
            right: 8px;
            background: rgba(0,0,0,0.72);
            backdrop-filter: blur(6px);
            color: #fff;
            padding: 3px 9px;
            border-radius: 999px;
            font-size: 0.7rem;
            font-weight: 600;
            z-index: 10;
          }

          .photo-info { 
            padding: 0.75rem;
            border-top: 1px solid #f1f3f5;
            font-size: 0.83rem;
            color: var(--text-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.6rem;
            flex-wrap: wrap;
          }

          .photo-info > span {
            font-weight: 500;
            flex: 1;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
          }

          .btn-sm {
            padding: 0.3rem 0.55rem;
            font-size: 0.8rem;
            border-radius: 6px;
          }

          .btn-outline-secondary {
            border: 1px solid #dee2e6;
            color: var(--text-muted);
            background: transparent;
          }

          .btn-outline-secondary:hover {
            background: var(--text-muted);
            color: white;
            border-color: var(--text-muted);
          }

          .btn-outline-danger {
            border: 1px solid #fecccb;
            color: var(--danger-color);
            background: transparent;
          }

          .btn-outline-danger:hover {
            background: var(--danger-color);
            color: white;
            border-color: var(--danger-color);
          }

          /* SLIDESHOW MODAL */
          .slideshow-modal { 
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.95);
            z-index: 10000;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(4px);
          }

          .slideshow-modal.show { 
            display: flex;
            animation: fadeIn 0.25s ease;
          }

          @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
          }

          .slideshow-content { 
            position: relative;
            width: 96vw;
            height: 92vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1rem;
          }

          .slideshow-image-container { 
            flex: 1;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
          }

          #slideshowImage { 
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            border-radius: 8px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.5);
          }

          .slideshow-close, .slideshow-prev, .slideshow-next { 
            position: absolute;
            background: rgba(255,255,255,0.15);
            backdrop-filter: blur(10px);
            color: #fff;
            border: 2px solid rgba(255,255,255,0.3);
            width: 46px;
            height: 46px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            font-size: 1.1rem;
          }

          .slideshow-close:hover, .slideshow-prev:hover, .slideshow-next:hover {
            background: rgba(255,255,255,0.25);
            transform: scale(1.05);
          }

          .slideshow-close { 
            top: 18px;
            right: 18px;
          }

          .slideshow-prev, .slideshow-next { 
            top: 50%;
            transform: translateY(-50%);
          }

          .slideshow-prev { left: 18px; }
          .slideshow-next { right: 18px; }

          /* LOADING OVERLAY */
          #loadingOverlay {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(0,0,0,0.9);
            color: white;
            padding: 1.2rem 2rem;
            border-radius: 12px;
            font-weight: 600;
            z-index: 9999;
            box-shadow: 0 8px 32px rgba(0,0,0,0.5);
            font-size: 0.95rem;
          }

          .hidden { 
            display: none !important;
          }

          #pendingStrip { 
            border-top: 2px dashed #dee2e6;
            margin-top: 0.75rem;
            padding-top: 0.75rem;
          }

          /* APP MODAL (para alertas / confirmaciones) */
          .app-modal {
            position: fixed;
            inset: 0;
            z-index: 11000;
            display: none;
            align-items: center;
            justify-content: center;
            background: rgba(0,0,0,0.45);
            backdrop-filter: blur(3px);
          }

          .app-modal.show {
            display: flex;
            animation: fadeIn 0.2s ease;
          }

          .app-modal-dialog {
            background: #ffffff;
            border-radius: 14px;
            padding: 1.5rem 1.75rem 1.25rem;
            max-width: 420px;
            width: 92vw;
            box-shadow: 0 12px 30px rgba(0,0,0,0.25);
            text-align: center;
          }

          .app-modal-icon {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            margin: 0 auto 0.9rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
          }

          .app-modal-icon.success { 
            background: rgba(0, 184, 148, 0.12);
            color: #00b894;
            border: 2px solid rgba(0, 184, 148, 0.5);
          }

          .app-modal-icon.error {
            background: rgba(214, 48, 49, 0.12);
            color: #d63031;
            border: 2px solid rgba(214, 48, 49, 0.5);
          }

          .app-modal-icon.warning {
            background: rgba(251, 197, 49, 0.12);
            color: #e1a500;
            border: 2px solid rgba(241, 196, 15, 0.5);
          }

          .app-modal-title {
            margin: 0 0 0.35rem;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text-color);
          }

          .app-modal-message {
            margin: 0 0 1rem;
            font-size: 0.9rem;
            color: var(--text-muted);
          }

          .app-modal-actions {
            display: flex;
            justify-content: center;
            gap: 0.5rem;
            flex-wrap: wrap;
          }

          .app-modal-actions .btn {
            min-width: 90px;
            font-size: 0.85rem;
          }

          .btn-primary-soft {
            background: var(--primary-color);
            color: #fff;
          }

          .btn-primary-soft:hover {
            background: var(--primary-dark);
          }

          /* MOBILE OPTIMIZATIONS */
          @media (max-width: 575px) {
            .header-card {
              margin: 0.6rem;
              padding: 0.9rem;
            }

            .photo-grid {
              padding: 0.6rem;
              gap: 0.9rem;
            }

            .photo-info {
              flex-direction: column;
              align-items: flex-start;
              gap: 0.4rem;
            }

            .photo-info > span {
              white-space: normal;
            }

            .slideshow-close, .slideshow-prev, .slideshow-next {
              width: 40px;
              height: 40px;
              font-size: 1rem;
            }

            .slideshow-prev { left: 10px; }
            .slideshow-next { right: 10px; }
            .slideshow-close { top: 10px; right: 10px; }

            .app-modal-dialog {
              padding: 1.2rem 1.2rem 1rem;
            }
          }

          /* SCROLLBAR STYLING */
          ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
          }

          ::-webkit-scrollbar-track {
            background: #f1f1f1;
          }

          ::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 5px;
          }

          ::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
          }
        </style>
      </head>
      <body>
        <div class="container-fluid">
          <!-- ENCABEZADO + METADATOS REPARACIÓN -->
          <div class="header-card">
            <div class="header-content">
              <div class="header-info">
                <h2>
                  <t t-if="reparacion.name">
                    <t t-esc="reparacion.name"/>
                  </t>
                  <t t-else="">
                    <t t-esc="reparacion.id"/>
                  </t>
                </h2>

                <!-- Datos de equipo / técnico -->
                <div class="meta-grid">
                  <div class="meta-pill">
                    <b>Modelo</b>
                    <span>
                      <t t-esc="(reparacion.maquina_id and (reparacion.maquina_id.display_name or reparacion.maquina_id.name)) or '—'"/>
                    </span>
                  </div>
                  <div class="meta-pill">
                    <b>Serie</b>
                    <span><t t-esc="reparacion.serie_id or '—'"/></span>
                  </div>
                  <div class="meta-pill">
                    <b>Técnico</b>
                    <span><t t-esc="reparacion.responsable_id.name or '—'"/></span>
                  </div>
                </div>
              </div>

              <div class="action-buttons">
                <!-- BOTÓN COMPARTIR GALERÍA -->
                <button id="shareGalleryBtn" class="btn btn-main btn-share-gallery">
                  <i class="fa-solid fa-share-nodes"></i>
                  <span>Compartir</span>
                </button>

                <!-- BOTÓN CÁMARA -->
                <button id="cameraBtn" class="btn btn-main btn-camera">
                  <i class="fa-solid fa-camera"></i> 
                  <span>Tomar Foto</span>
                </button>
                
                <!-- BOTÓN DESCARGAR TODAS -->
                <t t-if="fotos and len(fotos) > 0">
                  <a t-attf-href="/gallery/download_all/#{reparacion.id}" 
                     class="btn btn-main btn-download-all"
                     title="Descargar todas las fotos en ZIP">
                    <i class="fa-solid fa-download"></i>
                    <span>Descargar Todas (<t t-esc="len(fotos)"/>)</span>
                  </a>
                </t>
                
                <input id="cameraCapture" type="file" accept="image/*" capture="environment" style="display:none"/>
                <div id="loadingOverlay" class="hidden">
                  <i class="fa-solid fa-spinner fa-spin"></i> Subiendo...
                </div>
              </div>
            </div>
          </div>

          <!-- GRID DE FOTOS -->
          <div id="photoGrid" class="photo-grid">
            <t t-foreach="fotos" t-as="f">
              <div class="photo-card" t-att-data-foto-id="f['id']">
                <div class="photo-container" data-open-viewer="1" t-att-data-download-url="'/gallery/download/%s' % f['id']">
                  <span class="photo-badge">
                    <i class="fa-solid fa-image"></i> Foto
                  </span>
                  <img t-att-src="f.get('thumb_url') or ('/gallery/preview/%s' % f['id'])" alt="Foto" loading="lazy"/>
                </div>
                <div class="photo-info">
                  <span>
                    #<t t-esc="f.get('sequence', 0)"/> — <t t-esc="f.get('nombre_foto','Sin nombre')"/>
                  </span>
                  <div class="d-flex gap-2">
                    <!-- botón compartir foto -->
                    <button
                      type="button"
                      class="btn btn-sm btn-outline-secondary btn-share-photo"
                      t-att-data-download-url="'/gallery/download/%s' % f['id']"
                      title="Compartir / Copiar enlace">
                      <i class="fa-solid fa-share-nodes"></i>
                    </button>

                    <!-- Descargar -->
                    <a class="btn btn-sm btn-outline-secondary"
                       t-att-href="'/gallery/download/%s' % f['id']"
                       target="_blank" title="Descargar">
                      <i class="fa-solid fa-download"></i>
                    </a>

                    <!-- Eliminar -->
                    <button type="button" class="btn btn-sm btn-outline-danger btn-delete-photo" title="Eliminar">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </div>
                </div>
              </div>
            </t>
          </div>
        </div>

        <!-- Modal visor -->
        <div id="slideshowModal" class="slideshow-modal" aria-hidden="true">
          <div class="slideshow-content">
            <button class="slideshow-close" id="slideshowClose" title="Cerrar" aria-label="Cerrar">
              <i class="fa-solid fa-xmark"></i>
            </button>
            <button class="slideshow-prev" id="slideshowPrev" title="Anterior" aria-label="Foto anterior">
              <i class="fa-solid fa-chevron-left"></i>
            </button>
            <div class="slideshow-image-container">
              <img id="slideshowImage" src="" alt="Imagen completa"/>
            </div>
            <button class="slideshow-next" id="slideshowNext" title="Siguiente" aria-label="Foto siguiente">
              <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>
        </div>

        <!-- Modal genérico para alertas / confirmaciones -->
        <div id="appModal" class="app-modal" aria-hidden="true">
          <div class="app-modal-dialog">
            <div id="appModalIcon" class="app-modal-icon success">
              <i class="fa-solid fa-check"></i>
            </div>
            <h3 id="appModalTitle" class="app-modal-title">Título</h3>
            <p id="appModalMessage" class="app-modal-message">Mensaje</p>
            <div class="app-modal-actions">
              <button type="button" id="appModalCancel" class="btn btn-sm btn-outline-secondary">Cancelar</button>
              <button type="button" id="appModalOk" class="btn btn-sm btn-primary-soft">Aceptar</button>
            </div>
          </div>
        </div>

        <script src="/sat/static/src/js/gallery_widget_v15.js"></script>
      </body>
    </html>
  </template>
</odoo>

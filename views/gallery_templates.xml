<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="gallery_page_template" name="Galería de Fotos">
        <t t-call="website.layout">
            <div class="container">
                <h1>Galería de Fotos - Reparación <t t-esc="reparacion.name"/></h1>
                <div class="row">
                    <t t-foreach="fotos" t-as="foto">
                        <div class="col-md-3">
                            <div class="card mb-4 shadow-sm">
                                <img t-att-src="foto['thumb_url']" class="card-img-top" alt="Foto de reparación"/>
                                <div class="card-body">
                                    <p class="card-text" t-esc="foto['nombre_foto']"/>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="btn-group">
                                            <a t-att-href="foto['download_url']" class="btn btn-sm btn-outline-secondary">Descargar</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
    
    
</odoo>

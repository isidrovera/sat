<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="gallery_page_template" name="Galería de Fotos">
        <html>
            <head>
                <title>Galería de Fotos</title>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
                <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet"/>
                <style>
                    :root {
                        --primary-color: #4a90e2;
                        --secondary-color: #f5f6fa;
                        --text-color: #2d3436;
                        --card-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                        --success-color: #00b894;
                        --camera-color: #fd79a8;
                    }
                    body { background-color: var(--secondary-color); color: var(--text-color); font-family: system-ui, -apple-system, sans-serif; }
                    .header-card { background: #fff; border-radius: 15px; box-shadow: var(--card-shadow); margin: 1rem; padding: 1.25rem; }
                    .header-content { display: flex; flex-direction: column; gap: .5rem; }
                    @media (min-width: 768px) { .header-content { flex-direction: row; justify-content: space-between; align-items: center; } }
                    .header-info h2 { font-size: 1.5rem; margin: 0; color: var(--primary-color); }
                    .action-buttons { display: flex; flex-wrap: wrap; gap: .5rem; }
                    .btn { padding: .5rem 1rem; border-radius: 10px; font-weight: 600; }
                    .btn-camera { background-color: var(--camera-color); color: #fff; }
                    .btn-camera:hover { background-color: #e84393; color: #fff; transform: translateY(-1px); }
                    .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; padding: 1rem; }
                    .photo-card { background: #fff; border-radius: 12px; overflow: hidden; box-shadow: var(--card-shadow); }
                    .photo-container { position: relative; padding-top: 75%; background: #f8f9fa; cursor: zoom-in; }
                    .photo-container img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .25s; }
                    .photo-container:hover img { transform: scale(1.03); }
                    .photo-info { padding: .6rem .75rem; border-top: 1px solid #eee; font-size: .85rem; color: #555; display:flex; justify-content:space-between; align-items:center;}
                    .photo-badge { position: absolute; top: 8px; right: 8px; background: rgba(0,0,0,.7); color:#fff; padding:2px 6px; border-radius: 4px; font-size: .7rem; }
                    /* Modal (visor de imagen completa) */
                    .slideshow-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.92); z-index: 10000; align-items: center; justify-content: center; }
                    .slideshow-modal.show { display: flex; }
                    .slideshow-content { position: relative; width: 96vw; height: 92vh; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.75rem; }
                    .slideshow-image-container { flex:1; width:100%; display:flex; align-items:center; justify-content:center; overflow:hidden; }
                    #slideshowImage { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 8px; }
                    .slideshow-close, .slideshow-prev, .slideshow-next { position: absolute; top: 16px; background: rgba(0,0,0,.6); color:#fff; border:0; width:46px; height:46px; border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer; }
                    .slideshow-close { right: 16px; }
                    .slideshow-prev, .slideshow-next { top: 50%; transform: translateY(-50%); }
                    .slideshow-prev { left: 16px; }
                    .slideshow-next { right: 16px; }
                    .hidden { display:none !important; }
                </style>
            </head>
            <body>
                <div class="container-fluid">
                    <div class="header-card">
                        <div class="header-content">
                            <div class="header-info">
                                <h2>Galería de reparación <t t-esc="reparacion.name or reparacion.id"/></h2>
                                <div class="text-muted">Solo captura con cámara (adjuntar está desactivado)</div>
                            </div>
                            <div class="action-buttons">
                                <!-- SOLO CÁMARA -->
                                <button id="cameraBtn" class="btn btn-camera">
                                    <i class="fa-solid fa-camera"></i> Tomar foto
                                </button>
                                <!-- Input oculto solo-cámara -->
                                <input id="cameraCapture" type="file" accept="image/*" capture="environment" style="display:none" />
                                <!-- Overlay básico -->
                                <div id="loadingOverlay" class="hidden">Subiendo...</div>
                            </div>
                        </div>
                    </div>

                    <div id="photoGrid" class="photo-grid">
                        <t t-foreach="fotos" t-as="f">
                            <div class="photo-card" t-att-data-foto-id="f['id']">
                                <div class="photo-container" data-open-viewer="1" t-att-data-download-url="'/gallery/download/%s' % f['id']">
                                    <span class="photo-badge">Foto</span>
                                    <img t-att-src="f.get('thumb_url') or ('/gallery/preview/%s' % f['id'])" alt="Foto"/>
                                </div>
                                <div class="photo-info">
                                    <span>#<t t-esc="f.get('sequence', 0)"/> — <t t-esc="f.get('nombre_foto','')"/></span>
                                    <a class="btn btn-sm btn-outline-secondary" t-att-href="'/gallery/download/%s' % f['id']" target="_blank">
                                        <i class="fa-solid fa-download"></i>
                                    </a>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Modal visor -->
                <div id="slideshowModal" class="slideshow-modal" aria-hidden="true">
                    <div class="slideshow-content">
                        <button class="slideshow-close" id="slideshowClose" title="Cerrar"><i class="fa-solid fa-xmark"></i></button>
                        <button class="slideshow-prev" id="slideshowPrev" title="Anterior"><i class="fa-solid fa-chevron-left"></i></button>
                        <div class="slideshow-image-container">
                            <img id="slideshowImage" src="" alt="Imagen completa"/>
                        </div>
                        <button class="slideshow-next" id="slideshowNext" title="Siguiente"><i class="fa-solid fa-chevron-right"></i></button>
                    </div>
                </div>

                <script src="/sat/static/src/js/gallery_widget_v15.js"></script>
            </body>
        </html>
    </template>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="gallery_page_template" name="Gallery Page">
        <t t-call="website.layout">
            <div class="container mt-5">
                <h1>Galería de Fotos de Reparación</h1>
                <h2 t-field="reparacion.name" class="mb-3" />
                
                <div class="row">
                    <t t-foreach="fotos" t-as="foto">
                        <div class="col-md-4 mb-4">
                            <div class="card">
                                <!-- Imagen de miniatura o previsualización -->
                                <img t-att-src="foto['thumb_url']" class="card-img-top" alt="Imagen de Reparación"/>
    
                                <div class="card-body">
                                    <!-- Nombre de la foto -->
                                    <h5 class="card-title" t-esc="foto['nombre']"/>
    
                                    <!-- Enlace público y de descarga (si existe) -->
                                    <div class="btn-group" role="group">
                                        <a t-att-href="foto['public_link']" class="btn btn-primary">Ver Público</a>
                                        <t t-if="foto['download_url']">
                                            <a t-att-href="foto['download_url']" class="btn btn-secondary">Descargar</a>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
    
</odoo>

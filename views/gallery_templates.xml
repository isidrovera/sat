<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="gallery_page_template" name="Galería de Fotos">
        <html>
            <head>
                <title>Galería de Fotos</title>
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
                <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
                
                <style>
                    :root {
                        --primary-color: #4a90e2;
                        --secondary-color: #f5f6fa;
                        --text-color: #2d3436;
                        --card-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                    }

                    body {
                        background-color: var(--secondary-color);
                        color: var(--text-color);
                        font-family: system-ui, -apple-system, sans-serif;
                    }

                    .header-card {
                        background: white;
                        border-radius: 15px;
                        box-shadow: var(--card-shadow);
                        margin-bottom: 2rem;
                        padding: 1.5rem;
                    }

                    .header-content {
                        display: flex;
                        flex-direction: column;
                        gap: 0.5rem;
                    }

                    @media (min-width: 768px) {
                        .header-content {
                            flex-direction: row;
                            justify-content: space-between;
                            align-items: center;
                        }
                    }

                    .header-info h2 {
                        font-size: 1.75rem;
                        margin: 0;
                        color: var(--primary-color);
                    }

                    .header-info h4, .header-info h5, .header-info h6 {
                        font-size: 1rem;
                        margin: 0.25rem 0;
                        color: #666;
                    }

                    .action-buttons {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 0.5rem;
                    }

                    .btn {
                        padding: 0.5rem 1rem;
                        border-radius: 8px;
                        font-weight: 500;
                        transition: all 0.3s ease;
                    }

                    .photo-grid {
                        display: grid;
                        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                        gap: 1.5rem;
                        padding: 1rem;
                    }

                    .photo-card {
                        background: white;
                        border-radius: 12px;
                        overflow: hidden;
                        box-shadow: var(--card-shadow);
                        transition: transform 0.2s ease;
                    }

                    .photo-card:hover {
                        transform: translateY(-5px);
                    }

                    .photo-container {
                        position: relative;
                        padding-top: 75%;
                        background-color: #f8f9fa;
                    }

                    .photo-container img {
                        position: absolute;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        transition: transform 0.3s ease;
                    }

                    .photo-container:hover img {
                        transform: scale(1.05);
                    }

                    .actions-bar {
                        display: flex;
                        justify-content: space-between;
                        padding: 0.75rem;
                        background-color: white;
                    }

                    .photo-info {
                        padding: 0.75rem;
                        border-top: 1px solid #eee;
                    }

                    .photo-name {
                        font-size: 0.875rem;
                        color: #666;
                        margin: 0;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                    }

                    @media (max-width: 768px) {
                        .header-card {
                            margin: 1rem;
                        }
                        
                        .action-buttons {
                            justify-content: center;
                            margin-top: 1rem;
                        }

                        .photo-grid {
                            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                            gap: 1rem;
                        }
                    }
                </style>
            </head>
            <body>
                <div class="container-fluid py-4">
                    <div class="header-card">
                        <div class="header-content">
                            <div class="header-info">
                                <h2>Galería de Fotos - <span t-esc="reparacion.name"/></h2>
                                <h4>Modelo: <span t-esc="reparacion.maquina_id.name.name"/></h4>
                                <h5>Serie: <span t-esc="reparacion.maquina_id.serie_id"/></h5>
                                <h6>Técnico: <span t-esc="reparacion.responsable_id.name"/></h6>
                            </div>
                            <div class="action-buttons">
                                <button id="shareGalleryBtn" class="btn btn-outline-secondary" data-action="share">
                                    <i class="fas fa-share-alt me-2"></i>Compartir
                                </button>
                              <!-- <button id="syncButton" class="btn btn-info text-white">
                                    <i class="fas fa-sync me-2"></i>Sincronizar
                                </button>-->
                                <label class="btn btn-primary mb-0">
                                    <i class="fas fa-upload me-2"></i>Subir Fotos
                                    <input type="file" id="fileUpload" multiple="multiple" class="d-none" accept="image/*"/>
                                </label>
                                <a t-att-href="'/gallery/download_all/' + str(reparacion.id)" class="btn btn-secondary">
                                    <i class="fas fa-download me-2"></i>Descargar Todas
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="photo-grid">
                        <t t-foreach="fotos" t-as="foto">
                            <div class="photo-card" t-att-data-photo-id="foto['id']">
                                <div class="photo-container">
                                    <img t-att-src="foto['thumb_url']" t-att-alt="foto['nombre_foto']"/>
                                </div>
                                <div class="actions-bar">
                                    <a t-att-href="foto['download_url']" 
                                       class="btn btn-sm btn-outline-primary download-photo" 
                                       t-att-data-photo-id="foto['id']" 
                                       download="">
                                        <i class="fas fa-download"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger delete-photo" 
                                            t-att-data-photo-id="foto['id']">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                                <div class="photo-info">
                                    <p class="photo-name" t-esc="foto['nombre_foto']"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
                <!-- Visor de imágenes a pantalla completa -->
                <div id="slideshowModal" class="slideshow-modal">
                    <div class="slideshow-content">
                        <span class="slideshow-close">×</span>
                        <div class="slideshow-container">
                            <div class="slideshow-image-container">
                                <img id="slideshowImage" src="" alt="" 
                                    style="position: static !important; 
                                            top: auto !important;
                                            left: auto !important;
                                            width: auto !important; 
                                            height: auto !important; 
                                            max-width: 90% !important; 
                                            max-height: 90% !important; 
                                            object-fit: contain !important;
                                            transform: none !important;"/>
                            </div>
                            <h4 id="slideshowCaption" class="slideshow-caption"></h4>
                            <a class="slideshow-prev">&#10094;</a>
                            <a class="slideshow-next">&#10095;</a>
                        </div>
                        <div class="slideshow-counter">
                            <span id="slideshowCurrent">1</span> / <span id="slideshowTotal">0</span>
                        </div>
                    </div>
                </div>

                <!-- Scripts -->
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
                <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
                <script src="/sat/static/src/js/gallery.js"></script>
                <!-- Añade esto justo antes del cierre del body -->
                 <script src="/sat/static/src/js/image-viewer.js"></script>
            </body>
        </html>
    </template>
</odoo>
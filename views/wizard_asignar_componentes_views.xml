<!-- views/wizard_asignar_componentes_views.xml -->
<odoo>
    <record id="view_wizard_asignar_componentes_form" model="ir.ui.view">
        <field name="name">wizard.asignar.componentes.form</field>
        <field name="model">wizard.asignar.componentes</field>
        <field name="arch" type="xml">
            <form string="Asignar Componentes y Accesorios">
                <group>
                    <field name="modelo_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="sobrescribir_existentes"/>
                </group>
                
                <notebook>
                    <page string="Componentes">
                        <field name="componente_line_ids">
                            <list>
                                <field name="tipo_id"/>
                                <field name="prioridad"/>
                                <field name="vida_util_paginas"/>
                                <field name="vida_util_meses"/>
                            </list>
                            <form string="Componente">
                                <group>
                                    <group>
                                        <field name="tipo_id"/>
                                        <field name="prioridad"/>
                                    </group>
                                    <group>
                                        <field name="vida_util_paginas"/>
                                        <field name="vida_util_meses"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="frase_desgaste"/>
                                    <field name="frase_cambio"/>
                                </group>
                                <notebook>
                                    <page string="Subpartes">
                                        <group string="Nota">
                                            <div class="alert alert-info" style="margin-bottom: 10px;">
                                                ℹ️ Las subpartes se cargan automáticamente al seleccionar el tipo de componente. 
                                                Desmarca las que NO quieras agregar.
                                            </div>
                                        </group>
                                        <field name="subparte_ids">
                                            <list editable="bottom" create="false" delete="true">
                                                <!-- 🎯 Checkbox para seleccionar -->
                                                <field name="seleccionado" widget="boolean_toggle"/>
                                                <!-- Subparte en modo solo lectura -->
                                                <field name="subparte_id" readonly="1"/>
                                                <field name="cantidad"/>
                                                <field name="nota"/>
                                            </list>
                                        </field>
                                    </page>
                                </notebook>
                            </form>
                        </field>
                        <group string="Nota">
                            <div class="alert alert-info">
                                ℹ️ Los tipos sensibles a color (tóners, UI, developer) crearán automáticamente:
                                <ul style="margin: 5px 0 0 20px;">
                                    <li><strong>Monocromáticas:</strong> Solo negro (K)</li>
                                    <li><strong>Color:</strong> Todos los colores (K, C, M, Y)</li>
                                </ul>
                            </div>
                        </group>
                    </page>
                    
                    <page string="Accesorios">
                        <field name="accesorio_line_ids">
                            <list editable="bottom">
                                <field name="tipo_id"/>
                                <field name="obligatorio" widget="boolean_toggle"/>
                                <field name="nota"/>
                            </list>
                        </field>
                    </page>
                    
                    <page string="Resumen">
                        <field name="resumen" readonly="1" nolabel="1"/>
                    </page>
                </notebook>
                
                <footer>
                    <button name="action_asignar" 
                            string="Ejecutar Asignación" 
                            type="object" 
                            class="btn-primary"
                            icon="fa-check"/>
                    <button string="Cancelar" 
                            class="btn-secondary" 
                            special="cancel"
                            icon="fa-times"/>
                </footer>
            </form>
        </field>
    </record>

    
</odoo>
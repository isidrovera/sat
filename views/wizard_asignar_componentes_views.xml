<!-- views/wizard_asignar_componentes_views.xml -->
<odoo>
    <record id="view_wizard_asignar_componentes_form" model="ir.ui.view">
        <field name="name">wizard.asignar.componentes.form</field>
        <field name="model">wizard.asignar.componentes</field>
        <field name="arch" type="xml">
            <form string="Asignar Componentes y Accesorios">
                <group>
                    <field name="modelo_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                
                <notebook>
                    <page string="Componentes">
                        <group>
                            <field name="componente_tipo_ids" widget="many2many_tags"/>
                            <field name="prioridad_default"/>
                            <field name="vida_util_paginas_default"/>
                            <field name="vida_util_meses_default"/>
                        </group>
                        <group string="Nota">
                            <div class="alert alert-info">
                                ℹ️ Los tipos sensibles a color (tóners) crearán automáticamente 4 registros (K, C, M, Y)
                            </div>
                        </group>
                    </page>
                    
                    <page string="Subpartes">
                        <field name="subparte_line_ids">
                            <list editable="bottom">
                                <field name="subparte_id"/>
                                <field name="componente_tipo_id" placeholder="Todos los componentes"/>
                                <field name="cantidad"/>
                                <field name="nota"/>
                            </list>
                        </field>
                        <group string="Instrucciones">
                            <div class="alert alert-info">
                                ℹ️ <strong>Tipo de componente:</strong><br/>
                                • Si lo dejas vacío, la subparte se agregará a TODOS los componentes seleccionados.<br/>
                                • Si seleccionas un tipo específico, solo se agregará a componentes de ese tipo.<br/><br/>
                                💡 Ejemplo: Si seleccionas "Unidad Fusora" como tipo, la subparte solo se agregará a componentes tipo "Unidad Fusora".
                            </div>
                        </group>
                    </page>
                    
                    <page string="Accesorios">
                        <group>
                            <field name="accesorio_tipo_ids" widget="many2many_tags"/>
                            <field name="obligatorio_default"/>
                        </group>
                    </page>
                    
                    <page string="Opciones">
                        <group>
                            <field name="sobrescribir_existentes"/>
                        </group>
                    </page>
                    
                    <page string="Resumen">
                        <field name="resumen" readonly="1"/>
                    </page>
                </notebook>
                
                <footer>
                    <button name="action_asignar" string="Ejecutar Asignación" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
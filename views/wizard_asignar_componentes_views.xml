<!-- views/wizard_asignar_componentes_views.xml -->
<odoo>

    <!-- WIZARD PRINCIPAL -->
    <record id="view_wizard_asignar_componentes_form" model="ir.ui.view">
        <field name="name">wizard.asignar.componentes.form</field>
        <field name="model">wizard.asignar.componentes</field>
        <field name="arch" type="xml">
            <form string="Asignar Componentes y Accesorios">
                <group>
                    <field name="modelo_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="sobrescribir_existentes"/>
                </group>

                <notebook>
                    <page string="Componentes">
                        <field name="componente_line_ids">
                            <list>
                                <field name="tipo_id"/>
                                <field name="prioridad"/>
                                <field name="vida_util_paginas"/>
                                <field name="vida_util_meses"/>
                            </list>
                            <form string="Componente">
                                <group>
                                    <group>
                                        <field name="tipo_id"/>
                                        <field name="prioridad"/>
                                    </group>
                                    <group>
                                        <field name="vida_util_paginas"/>
                                        <field name="vida_util_meses"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="frase_desgaste"/>
                                    <field name="frase_cambio"/>
                                </group>
                                <notebook>
                                    <page string="Subpartes">
                                        <group>
                                            <!-- Botón para abrir el wizard de selección múltiple -->
                                            <button name="action_open_subparte_multi_wizard"
                                                    type="object"
                                                    string="Agregar múltiples subpartes"
                                                    class="oe_highlight"/>
                                        </group>
                                        <field name="subparte_ids">
                                            <list editable="bottom">
                                                <field name="subparte_id"/>
                                                <field name="cantidad"/>
                                                <field name="nota"/>
                                            </list>
                                        </field>
                                    </page>
                                </notebook>
                            </form>
                        </field>
                        <group string="Nota">
                            <div class="alert alert-info">
                                ℹ️ Los tipos sensibles a color (tóners) crearán automáticamente 4 registros (K, C, M, Y) con las mismas subpartes.
                            </div>
                        </group>
                    </page>

                    <page string="Accesorios">
                        <group>
                            <!-- Botón para abrir el wizard de selección múltiple de accesorios -->
                            <button name="action_open_accesorio_multi_wizard"
                                    type="object"
                                    string="Agregar múltiples accesorios"
                                    class="oe_highlight"/>
                        </group>
                        <field name="accesorio_line_ids">
                            <list editable="bottom">
                                <field name="tipo_id"/>
                                <field name="obligatorio"/>
                                <field name="nota"/>
                            </list>
                        </field>
                    </page>

                    <page string="Resumen">
                        <group>
                            <field name="resumen" readonly="1" nolabel="1" widget="html"/>
                        </group>
                    </page>
                </notebook>

                <footer>
                    <button name="action_asignar" string="Ejecutar Asignación" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <!-- WIZARD MULTI-SUBPARTES -->
    <record id="view_wizard_asignar_componentes_subparte_multi_form" model="ir.ui.view">
        <field name="name">wizard.asignar.componentes.subparte.multi.form</field>
        <field name="model">wizard.asignar.componentes.subparte.multi</field>
        <field name="arch" type="xml">
            <form string="Agregar múltiples subpartes">
                <group>
                    <field name="componente_line_id" readonly="1"/>
                    <field name="tipo_componente_id" readonly="1"/>
                </group>
                <group>
                    <!-- Many2many normal para tener el popup con checkboxes -->
                    <field name="subparte_ids"/>
                </group>
                <group>
                    <field name="cantidad"/>
                    <field name="nota"/>
                </group>
                <footer>
                    <button string="Agregar" type="object" name="action_confirm" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>


    <!-- WIZARD MULTI-ACCESORIOS -->
    <record id="view_wizard_asignar_componentes_accesorio_multi_form" model="ir.ui.view">
        <field name="name">wizard.asignar.componentes.accesorio.multi.form</field>
        <field name="model">wizard.asignar.componentes.accesorio.multi</field>
        <field name="arch" type="xml">
            <form string="Agregar múltiples accesorios">
                <group>
                    <field name="wizard_id" readonly="1"/>
                </group>
                <group>
                    <!-- Many2many normal para popup con selección múltiple -->
                    <field name="accesorio_ids"/>
                </group>
                <group>
                    <field name="obligatorio"/>
                    <field name="nota"/>
                </group>
                <footer>
                    <button string="Agregar" type="object" name="action_confirm" class="oe_highlight"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

<!-- views/wizard_asignar_componentes_views.xml -->
<odoo>

    <record id="view_wizard_asignar_componentes_form" model="ir.ui.view">
        <field name="name">wizard.asignar.componentes.form</field>
        <field name="model">wizard.asignar.componentes</field>
        <field name="arch" type="xml">
            <form string="Asignar Componentes/Accesorios">
                <group>
                    <field name="modelo_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="sobrescribir_existentes"/>
                </group>

                <notebook>
                    <!-- ===== PÁGINA COMPONENTES ===== -->
                    <page string="Componentes">
                        <field name="componente_line_ids">
                            <list>
                                <field name="tipo_id"/>
                                <field name="prioridad"/>
                                <field name="vida_util_paginas"/>
                                <field name="vida_util_meses"/>
                            </list>
                            <form string="Componentes a agregar">
                                <group>
                                    <group>
                                        <field name="tipo_id"/>
                                        <field name="prioridad"/>
                                    </group>
                                    <group>
                                        <field name="vida_util_paginas"/>
                                        <field name="vida_util_meses"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="frase_desgaste"/>
                                    <field name="frase_cambio"/>
                                </group>

                                <group string="Subpartes">
                                    <!-- Many2many: abre popup "Agregar: Subpartes" con multi-selección -->
                                    <field name="subparte_ids"/>
                                    <field name="subparte_cantidad"/>
                                    <field name="subparte_nota"/>
                                </group>
                            </form>
                        </field>

                        <group string="Nota">
                            <div class="alert alert-info">
                                ℹ️ Los tipos sensibles a color (tóners) crearán automáticamente 4 registros
                                (K, C, M, Y) con las mismas subpartes.
                            </div>
                        </group>
                    </page>

                    <!-- ===== PÁGINA ACCESORIOS ===== -->
                    <page string="Accesorios">
                        <group>
                            <!-- Many2many: se comporta igual que tu informe de fallas -->
                            <field name="accesorio_ids"/>
                        </group>
                        <group>
                            <field name="accesorio_obligatorio"/>
                            <field name="accesorio_nota"/>
                        </group>
                    </page>

                    <!-- ===== PÁGINA RESUMEN ===== -->
                    <page string="Resumen">
                        <group>
                            <field name="resumen" readonly="1" nolabel="1" widget="html"/>
                        </group>
                    </page>
                </notebook>

                <footer>
                    <button name="action_asignar"
                            string="Ejecutar Asignación"
                            type="object"
                            class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

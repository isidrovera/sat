<!-- views/wizard_asignar_componentes_views.xml -->
<odoo>
    <record id="view_wizard_asignar_componentes_form" model="ir.ui.view">
        <field name="name">wizard.asignar.componentes.form</field>
        <field name="model">wizard.asignar.componentes</field>
        <field name="arch" type="xml">
            <form string="Asignar Componentes y Accesorios">
                <group>
                    <field name="modelo_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="sobrescribir_existentes"/>
                </group>
                
                <notebook>
                    <page string="Componentes">
                        <field name="componente_line_ids">
                            <list editable="bottom">
                                <field name="tipo_id"/>
                                <field name="prioridad"/>
                                <field name="vida_util_paginas"/>
                                <field name="vida_util_meses"/>
                                <field name="frase_desgaste"/>
                                <field name="frase_cambio"/>
                            </list>
                            <form string="Componente">
                                <group>
                                    <group>
                                        <field name="tipo_id"/>
                                        <field name="prioridad"/>
                                    </group>
                                    <group>
                                        <field name="vida_util_paginas"/>
                                        <field name="vida_util_meses"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="frase_desgaste"/>
                                    <field name="frase_cambio"/>
                                </group>
                                <notebook>
                                    <page string="Subpartes">
                                        <field name="subparte_ids">
                                            <tree editable="bottom">
                                                <field name="subparte_id"/>
                                                <field name="cantidad"/>
                                                <field name="nota"/>
                                            </tree>
                                        </field>
                                    </page>
                                </notebook>
                            </form>
                        </field>
                        <group string="Nota">
                            <div class="alert alert-info">
                                ℹ️ Los tipos sensibles a color (tóners) crearán automáticamente 4 registros (K, C, M, Y) con las mismas subpartes.
                            </div>
                        </group>
                    </page>
                    
                    <page string="Accesorios">
                        <field name="accesorio_line_ids">
                            <list editable="bottom">
                                <field name="tipo_id"/>
                                <field name="obligatorio"/>
                                <field name="nota"/>
                            </list>
                        </field>
                    </page>
                    
                    <page string="Resumen">
                        <field name="resumen" readonly="1"/>
                    </page>
                </notebook>
                
                <footer>
                    <button name="action_asignar" string="Ejecutar Asignación" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
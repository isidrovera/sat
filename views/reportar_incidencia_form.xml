<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="reportar_incidencia_form" name="Reportar Incidencia">
    <t t-call="website.layout">
      <div id="wrap" class="oe_structure">
        <!-- Hero Section -->
        <section class="bg-gradient-to-r from-blue-600 to-purple-700 text-white py-5 mb-5">
          <div class="container">
            <div class="row justify-content-center">
              <div class="col-lg-8 text-center">
                <h1 class="display-4 fw-bold mb-3">
                  <i class="fa fa-headset me-3"></i>
                  Reportar un Problema
                </h1>
                <p class="lead">Estamos aquí para ayudarte. Describe tu problema y nuestro equipo técnico te contactará pronto.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Main Form Section -->
        <div class="container mb-5">
          <div class="row justify-content-center">
            <div class="col-lg-8">
              <!-- Card Container -->
              <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                  <!-- Form: LOGICA ORIGINAL CONSERVADA -->
                  <form id="ticket_form" action="/ticket/reportar_incidencia" method="post" enctype="multipart/form-data">
                    <!-- CSRF + hidden originales -->
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" id="partner_id" name="partner_id" t-att-value="partner_id"/>
                    <input type="hidden" id="direccion" name="direccion" t-att-value="direccion"/>
                    <input type="hidden" id="correo" name="correo" t-att-value="correo"/>
                    <input type="hidden" id="product_id" name="product_id" t-att-value="product_id"/>

                    <!-- Bloque: Información del Reportante -->
                    <div class="mb-5">
                      <div class="d-flex align-items-center mb-4">
                        <div class="bg-primary rounded-circle p-2 me-3">
                          <i class="fa fa-user text-white"></i>
                        </div>
                        <h3 class="mb-0 text-primary fw-semibold">Tus Datos</h3>
                      </div>

                      <div class="row g-4">
                        <div class="col-md-6">
                          <div class="form-floating">
                            <input type="text"
                                   id="reporter_name"
                                   name="reporter_name"
                                   class="form-control bg-light"
                                   t-att-value="contacto_id"
                                   placeholder="Ingresa tu nombre"
                                   required="required"
                                   autocomplete="name"/>
                            <label for="reporter_name">
                              <i class="fa fa-id-badge me-2 text-primary"></i>
                              Nombre
                            </label>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <div class="form-floating">
                            <input type="tel"
                                   id="reporter_phone"
                                   name="reporter_phone"
                                   class="form-control bg-light"
                                   t-att-value="celular"
                                   placeholder="Ingresa tu número de celular"
                                   required="required"
                                   autocomplete="tel"
                                   pattern="[0-9+\-\s]{6,}"
                                   maxlength="20"/>
                            <label for="reporter_phone">
                              <i class="fa fa-phone me-2 text-primary"></i>
                              Celular
                            </label>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Bloque: Descripción del Problema -->
                    <div class="mb-5">
                      <div class="d-flex align-items-center mb-4">
                        <div class="bg-warning rounded-circle p-2 me-3">
                          <i class="fa fa-exclamation-triangle text-white"></i>
                        </div>
                        <h3 class="mb-0 text-warning fw-semibold">Descripción del Problema</h3>
                      </div>

                      <div class="form-floating">
                        <textarea id="description"
                                  name="description"
                                  class="form-control"
                                  placeholder="Describa detalladamente el problema que está experimentando..."
                                  style="height: 150px;"
                                  required="required"></textarea>
                        <label for="description">
                          <i class="fa fa-edit me-2 text-warning"></i>
                          Describa detalladamente el problema
                        </label>
                      </div>

                      <div class="form-text mt-2">
                        <i class="fa fa-info-circle me-1"></i>
                        Incluya detalles como: cuándo ocurrió, qué estaba haciendo, códigos de error, etc.
                      </div>
                    </div>

                    <!-- Bloque: Foto del Problema -->
                    <div class="mb-5">
                      <div class="d-flex align-items-center mb-3">
                        <div class="bg-secondary rounded-circle p-2 me-3">
                          <i class="fa fa-camera text-white"></i>
                        </div>
                        <h4 class="mb-0 text-secondary fw-semibold">Evidencia (opcional)</h4>
                      </div>

                      <div class="form-group">
                        <input type="file"
                               id="problem_photo"
                               name="problem_photo"
                               class="form-control"
                               accept="image/*"
                               capture="environment"/>
                        <small class="text-muted">
                          Formatos permitidos: imágenes. Use la cámara para capturar el problema.
                        </small>
                      </div>
                    </div>

                    <!-- Acciones -->
                    <div class="d-flex justify-content-center gap-2">
                      <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2" onclick="goBack()">
                        <i class="fa fa-arrow-left me-2"></i>Volver
                      </button>
                      <button id="submit_btn" type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold">
                        <i class="fa fa-paper-plane me-2"></i>Enviar Reporte
                      </button>
                    </div>

                    <div class="text-center mt-4">
                      <small class="text-muted">
                        <i class="fa fa-clock me-1"></i>
                        Tiempo de respuesta estimado: 2–4 horas laborales
                      </small>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Custom CSS -->
      <style>
        .bg-gradient-to-r {
          background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
        }
        .card {
          background: rgba(255, 255, 255, 0.95);
          backdrop-filter: blur(10px);
        }
        .rounded-4 { border-radius: 1rem !important; }
        .btn-primary {
          background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
          border: none;
          transition: all 0.3s ease;
        }
        .btn-primary:hover {
          background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
          transform: translateY(-1px);
          box-shadow: 0 8px 25px rgba(59,130,246,0.4);
        }
        /* Mejora visual para form-floating */
        .form-floating &gt; .form-control:focus ~ label,
        .form-floating &gt; .form-control:not(:placeholder-shown) ~ label,
        .form-floating &gt; textarea.form-control:focus ~ label,
        .form-floating &gt; textarea.form-control:not(:placeholder-shown) ~ label {
          opacity: 0.85;
          transform: scale(0.85) translateY(-0.5rem) translateX(0.15rem);
        }
      </style>

      <!-- JavaScript -->
      <script>
        function goBack() {
          if (document.referrer) {
            window.location.href = document.referrer;
          } else {
            window.history.back();
          }
        }

        document.addEventListener('DOMContentLoaded', function () {
          const form = document.getElementById('ticket_form');
          const description = document.getElementById('description');
          const submitBtn = document.getElementById('submit_btn');

          form.addEventListener('submit', function (e) {
            if (description.value.trim().length &lt; 10) {
              e.preventDefault();
              alert('Por favor, proporcione una descripción más detallada del problema (mínimo 10 caracteres).');
              description.focus();
              return;
            }
            // Evita doble envío
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i>Enviando...';
          });
        });
      </script>
    </t>
  </template>
</odoo>
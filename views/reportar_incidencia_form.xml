<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="reportar_incidencia_form" name="Reportar Incidencia">
    <t t-call="website.layout">

      <!-- Custom CSS matching the equipos design -->
      <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap');
        
        .ticket-container {
          font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
          background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
          min-height: 100vh;
          padding: 2rem 0;
        }
        
        .ticket-hero {
          background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
          border-radius: 24px;
          padding: 3rem 2rem;
          margin-bottom: 2rem;
          box-shadow: 0 20px 60px rgba(220, 38, 38, 0.2);
          position: relative;
          overflow: hidden;
        }
        
        .ticket-hero::before {
          content: '';
          position: absolute;
          top: -50%;
          right: -20%;
          width: 400px;
          height: 400px;
          background: radial-gradient(circle, rgba(254, 202, 202, 0.15) 0%, transparent 70%);
          border-radius: 50%;
        }
        
        .ticket-hero h1 {
          color: #fff;
          font-weight: 700;
          font-size: 2.25rem;
          margin: 0 0 0.75rem 0;
          letter-spacing: -0.5px;
          position: relative;
          z-index: 1;
        }
        
        .ticket-hero-subtitle {
          color: rgba(255,255,255,0.85);
          font-size: 1.1rem;
          margin: 0;
          position: relative;
          z-index: 1;
        }
        
        .ticket-card {
          background: #fff;
          border-radius: 20px;
          border: none;
          box-shadow: 0 4px 20px rgba(0,0,0,0.08);
          overflow: hidden;
        }
        
        .ticket-card-body {
          padding: 2.5rem;
        }
        
        .section-title {
          display: flex;
          align-items: center;
          gap: 0.75rem;
          font-size: 1.25rem;
          font-weight: 700;
          margin-bottom: 1.5rem;
          padding-bottom: 0.75rem;
          border-bottom: 2px solid #f3f4f6;
        }
        
        .section-title i {
          width: 32px;
          height: 32px;
          display: flex;
          align-items: center;
          justify-content: center;
          border-radius: 8px;
          font-size: 1rem;
        }
        
        .section-datos .section-title i {
          background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
          color: #fff;
        }
        
        .section-datos .section-title {
          color: #6366f1;
        }
        
        .section-problema .section-title i {
          background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
          color: #fff;
        }
        
        .section-problema .section-title {
          color: #f59e0b;
        }
        
        .section-evidencia .section-title i {
          background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
          color: #fff;
        }
        
        .section-evidencia .section-title {
          color: #06b6d4;
        }
        
        .form-label {
          font-weight: 600;
          color: #374151;
          margin-bottom: 0.5rem;
          font-size: 0.9rem;
          text-transform: uppercase;
          letter-spacing: 0.3px;
        }
        
        .form-control {
          border: 2px solid #e5e7eb;
          border-radius: 12px;
          padding: 0.875rem 1rem;
          font-size: 1rem;
          transition: all 0.2s;
          background: #f9fafb;
        }
        
        .form-control:focus {
          border-color: #6366f1;
          box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
          background: #fff;
          outline: none;
        }
        
        textarea.form-control {
          resize: vertical;
          min-height: 140px;
          font-family: inherit;
        }
        
        .help-text {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          margin-top: 0.75rem;
          padding: 0.75rem 1rem;
          background: #f0f9ff;
          border-left: 3px solid #0ea5e9;
          border-radius: 8px;
          font-size: 0.875rem;
          color: #0c4a6e;
        }
        
        .help-text i {
          color: #0ea5e9;
        }
        
        .file-upload-wrapper {
          position: relative;
          background: #f9fafb;
          border: 2px dashed #d1d5db;
          border-radius: 12px;
          padding: 2rem;
          text-align: center;
          transition: all 0.2s;
        }
        
        .file-upload-wrapper:hover {
          border-color: #6366f1;
          background: #f5f3ff;
        }
        
        .file-upload-wrapper input[type="file"] {
          position: absolute;
          width: 100%;
          height: 100%;
          top: 0;
          left: 0;
          opacity: 0;
          cursor: pointer;
        }
        
        .file-upload-label {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 0.75rem;
          pointer-events: none;
        }
        
        .file-upload-icon {
          width: 48px;
          height: 48px;
          background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
          border-radius: 12px;
          display: flex;
          align-items: center;
          justify-content: center;
          color: #fff;
          font-size: 1.5rem;
        }
        
        .file-upload-text {
          font-size: 0.95rem;
          color: #374151;
        }
        
        .file-upload-hint {
          font-size: 0.8rem;
          color: #6b7280;
        }
        
        .btn-action-primary {
          background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
          color: #fff;
          border: none;
          border-radius: 12px;
          padding: 1rem 1.5rem;
          font-weight: 700;
          font-size: 1rem;
          transition: all 0.2s;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.5rem;
          width: 100%;
        }
        
        .btn-action-primary:hover {
          transform: translateY(-2px);
          box-shadow: 0 12px 24px rgba(99, 102, 241, 0.3);
          color: #fff;
        }
        
        .btn-action-primary:disabled {
          opacity: 0.6;
          cursor: not-allowed;
          transform: none;
        }
        
        .btn-action-secondary {
          background: #fff;
          color: #374151;
          border: 2px solid #e5e7eb;
          border-radius: 12px;
          padding: 1rem 1.5rem;
          font-weight: 600;
          font-size: 1rem;
          transition: all 0.2s;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.5rem;
          width: 100%;
        }
        
        .btn-action-secondary:hover {
          background: #f9fafb;
          border-color: #d1d5db;
          transform: translateY(-2px);
          color: #374151;
        }
        
        .response-time-badge {
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          background: #fef3c7;
          color: #92400e;
          padding: 0.75rem 1.25rem;
          border-radius: 50px;
          font-size: 0.875rem;
          font-weight: 600;
          border: 2px solid #fbbf24;
          margin-top: 1.5rem;
        }
        
        .divider {
          height: 1px;
          background: linear-gradient(to right, transparent, #e5e7eb, transparent);
          margin: 2rem 0;
        }
        
        @media (max-width: 768px) {
          .ticket-hero {
            padding: 2rem 1.5rem;
          }
          
          .ticket-hero h1 {
            font-size: 1.75rem;
          }
          
          .ticket-card-body {
            padding: 1.5rem;
          }
          
          .section-title {
            font-size: 1.1rem;
          }
        }
      </style>

      <div class="ticket-container">
        <div class="container">
          
          <!-- Hero Section -->
          <div class="ticket-hero">
            <div class="text-center">
              <h1>
                <i class="fa fa-exclamation-triangle me-2"></i>
                Reportar un Problema
              </h1>
              <p class="ticket-hero-subtitle">
                Describe tu problema y nuestro equipo técnico te contactará pronto
              </p>
            </div>
          </div>

          <!-- Form Card -->
          <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-8">

              <div class="ticket-card">
                <div class="ticket-card-body">

                  <form id="ticket_form"
                        action="/ticket/reportar_incidencia"
                        method="post"
                        enctype="multipart/form-data">

                    <!-- Hidden Fields -->
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="partner_id" t-att-value="partner_id"/>
                    <input type="hidden" name="direccion" t-att-value="direccion"/>
                    <input type="hidden" name="correo" t-att-value="correo"/>
                    <input type="hidden" name="product_id" t-att-value="product_id"/>

                    <!-- Sección: Datos Personales -->
                    <div class="section-datos mb-4">
                      <div class="section-title">
                        <i class="fa fa-user"></i>
                        <span>Tus Datos</span>
                      </div>

                      <div class="row g-3">
                        <div class="col-12 col-md-6">
                          <label class="form-label">
                            <i class="fa fa-id-card me-1"></i> Nombre Completo
                          </label>
                          <input type="text"
                                 name="reporter_name"
                                 class="form-control"
                                 t-att-value="contacto_id"
                                 placeholder="Tu nombre"
                                 required="required"/>
                        </div>

                        <div class="col-12 col-md-6">
                          <label class="form-label">
                            <i class="fa fa-phone me-1"></i> Teléfono de Contacto
                          </label>
                          <input type="tel"
                                 name="reporter_phone"
                                 class="form-control"
                                 t-att-value="celular"
                                 placeholder="999 999 999"
                                 required="required"/>
                        </div>
                      </div>
                    </div>

                    <div class="divider"></div>

                    <!-- Sección: Descripción del Problema -->
                    <div class="section-problema mb-4">
                      <div class="section-title">
                        <i class="fa fa-exclamation-triangle"></i>
                        <span>Descripción del Problema</span>
                      </div>

                      <div>
                        <label class="form-label">
                          <i class="fa fa-edit me-1"></i> Detalla qué está ocurriendo
                        </label>
                        <textarea name="description"
                                  class="form-control"
                                  rows="6"
                                  required="required"
                                  placeholder="Describe detalladamente el problema que estás experimentando...&#10;&#10;Ejemplo: La impresora no enciende, muestra un error en pantalla, no imprime en color, etc."></textarea>

                        <div class="help-text">
                          <i class="fa fa-lightbulb"></i>
                          <span>Incluye detalles como: mensajes de error, luces parpadeantes, sonidos extraños, cuándo comenzó el problema, etc.</span>
                        </div>
                      </div>
                    </div>

                    <div class="divider"></div>

                    <!-- Sección: Evidencia Fotográfica -->
                    <div class="section-evidencia mb-4">
                      <div class="section-title">
                        <i class="fa fa-camera"></i>
                        <span>Evidencia Fotográfica (Opcional)</span>
                      </div>

                      <div class="file-upload-wrapper">
                        <input type="file"
                               name="problem_photo"
                               id="problem_photo"
                               accept="image/*"/>
                        
                        <label for="problem_photo" class="file-upload-label">
                          <div class="file-upload-icon">
                            <i class="fa fa-cloud-upload-alt"></i>
                          </div>
                          <div class="file-upload-text">
                            Arrastra una imagen aquí o <strong>haz clic para seleccionar</strong>
                          </div>
                          <div class="file-upload-hint">
                            Formatos: JPG, PNG, GIF (Máx. 10MB)
                          </div>
                        </label>
                      </div>
                    </div>

                    <div class="divider"></div>

                    <!-- Botones de Acción -->
                    <div class="row g-3">
                      <div class="col-12 col-md-6 order-md-1 order-2">
                        <button type="button"
                                onclick="window.history.back()"
                                class="btn-action-secondary">
                          <i class="fa fa-arrow-left"></i>
                          <span>Volver</span>
                        </button>
                      </div>

                      <div class="col-12 col-md-6 order-md-2 order-1">
                        <button id="submit_btn"
                                type="submit"
                                class="btn-action-primary">
                          <i class="fa fa-paper-plane"></i>
                          <span>Enviar Reporte</span>
                        </button>
                      </div>
                    </div>

                    <!-- Tiempo de Respuesta -->
                    <div class="text-center">
                      <div class="response-time-badge">
                        <i class="fa fa-clock"></i>
                        <span>Tiempo de respuesta estimado: 2–4 horas laborales</span>
                      </div>
                    </div>

                  </form>

                </div>
              </div>

            </div>
          </div>

        </div>
      </div>

      <!-- JavaScript -->
      <script>
        document.addEventListener('DOMContentLoaded', function () {
          const form = document.getElementById('ticket_form');
          const submitBtn = document.getElementById('submit_btn');
          const fileInput = document.getElementById('problem_photo');
          const fileUploadLabel = document.querySelector('.file-upload-label');

          // Handle form submission
          form.addEventListener('submit', function () {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i><span>Enviando reporte...</span>';
          });

          // Handle file upload display
          fileInput.addEventListener('change', function () {
            if (this.files &amp;&amp; this.files[0]) {
              const fileName = this.files[0].name;
              const fileSize = (this.files[0].size / 1024 / 1024).toFixed(2);
              
              fileUploadLabel.innerHTML = `
                <div class="file-upload-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                  <i class="fa fa-check"></i>
                </div>
                <div class="file-upload-text" style="color: #059669;">
                  <strong>${fileName}</strong> (${fileSize} MB)
                </div>
                <div class="file-upload-hint">
                  Haz clic para cambiar la imagen
                </div>
              `;
            }
          });

          // Add animation on scroll
          const observer = new IntersectionObserver((entries) =&gt; {
            entries.forEach(entry =&gt; {
              if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
              }
            });
          }, { threshold: 0.1 });

          document.querySelectorAll('.section-datos, .section-problema, .section-evidencia').forEach(section =&gt; {
            section.style.opacity = '0';
            section.style.transform = 'translateY(20px)';
            section.style.transition = 'all 0.5s ease-out';
            observer.observe(section);
          });
        });
      </script>

    </t>
  </template>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="reportar_incidencia_form" name="Reportar Incidencia">
    <t t-call="website.layout">

      <div id="wrap" class="oe_structure">

        <!-- HERO -->
        <section class="bg-primary text-white py-4 py-md-5 mb-4">
          <div class="container">
            <div class="row justify-content-center">
              <div class="col-12 col-md-10 col-lg-8 text-center">
                <h1 class="fw-bold mb-2">
                  <i class="fa fa-headset me-2"></i>
                  Reportar un Problema
                </h1>
                <p class="mb-0 opacity-75">
                  Describe tu problema y nuestro equipo técnico te contactará pronto.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- FORM -->
        <div class="container mb-5">
          <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-8 col-xl-7">

              <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-3 p-md-4 p-lg-5">

                  <form id="ticket_form"
                        action="/ticket/reportar_incidencia"
                        method="post"
                        enctype="multipart/form-data">

                    <!-- Hidden -->
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="partner_id" t-att-value="partner_id"/>
                    <input type="hidden" name="direccion" t-att-value="direccion"/>
                    <input type="hidden" name="correo" t-att-value="correo"/>
                    <input type="hidden" name="product_id" t-att-value="product_id"/>

                    <!-- DATOS -->
                    <div class="mb-4">
                      <h5 class="fw-semibold text-primary mb-3">
                        <i class="fa fa-user me-2"></i>Tus Datos
                      </h5>

                      <div class="row g-3">
                        <div class="col-12 col-md-6">
                          <label class="form-label">Nombre</label>
                          <input type="text"
                                 name="reporter_name"
                                 class="form-control"
                                 t-att-value="contacto_id"
                                 required="required"/>
                        </div>

                        <div class="col-12 col-md-6">
                          <label class="form-label">Celular</label>
                          <input type="tel"
                                 name="reporter_phone"
                                 class="form-control"
                                 t-att-value="celular"
                                 required="required"/>
                        </div>
                      </div>
                    </div>

                    <!-- DESCRIPCION -->
                    <div class="mb-4">
                      <h5 class="fw-semibold text-warning mb-3">
                        <i class="fa fa-exclamation-triangle me-2"></i>
                        Descripción del Problema
                      </h5>

                      <textarea name="description"
                                class="form-control"
                                rows="5"
                                required="required"
                                placeholder="Describe detalladamente el problema..."></textarea>

                      <small class="text-muted d-block mt-2">
                        Incluye detalles como sonidos, mensajes, luces o cuándo ocurrió.
                      </small>
                    </div>

                    <!-- FOTO -->
                    <div class="mb-4">
                      <h6 class="fw-semibold mb-2">
                        <i class="fa fa-camera me-2"></i>Evidencia (opcional)
                      </h6>

                      <input type="file"
                             name="problem_photo"
                             class="form-control"
                             accept="image/*"/>
                    </div>

                    <!-- ACCIONES -->
                    <div class="row g-2 mt-4">
                      <div class="col-12 col-md-6">
                        <button type="button"
                                onclick="window.history.back()"
                                class="btn btn-outline-secondary w-100">
                          <i class="fa fa-arrow-left me-1"></i> Volver
                        </button>
                      </div>

                      <div class="col-12 col-md-6">
                        <button id="submit_btn"
                                type="submit"
                                class="btn btn-primary w-100 fw-bold">
                          <i class="fa fa-paper-plane me-1"></i> Enviar Reporte
                        </button>
                      </div>
                    </div>

                    <div class="text-center mt-4">
                      <small class="text-muted">
                        Tiempo de respuesta estimado: 2–4 horas laborales.
                      </small>
                    </div>

                  </form>

                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- JS -->
        <script>
          document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('ticket_form');
            const submitBtn = document.getElementById('submit_btn');

            form.addEventListener('submit', function () {
              submitBtn.disabled = true;
              submitBtn.innerHTML =
                '<i class="fa fa-spinner fa-spin me-2"></i>Enviando...';
            });
          });
        </script>

      </div>
    </t>
  </template>
</odoo>

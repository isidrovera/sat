<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <!-- =====================================================================
         FORM VIEW
         ===================================================================== -->
    <record id="view_solicitud_partes_form" model="ir.ui.view">
        <field name="name">solicitud.partes.form</field>
        <field name="model">solicitud.partes</field>
        <field name="arch" type="xml">
            <form>
                <header>

                    <!-- Gerencia aprueba por token (WhatsApp/email) — no hay botón manual -->

                    <button name="action_complete"
                            string="Marcar Retiro Completo"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'approved' or not todas_retiradas"/>

                    <button name="action_replace"
                            string="Finalizar Reposición"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'completed' or not todas_repuestas"/>

                    <button name="action_reject"
                            string="Rechazar"
                            type="object"
                            invisible="state in ('rejected', 'replaced', 'completed', 'approved')"/>

                    <button name="action_forzar_reposicion"
                            string="⚡ Forzar Reposición"
                            type="object"
                            class="btn-warning"
                            invisible="state not in ('approved', 'completed')"
                            confirm="¿Cerrar forzadamente esta solicitud? Las partes pendientes quedarán como reemplazadas."/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="submitted,approved,completed,replaced"/>
                </header>

                <sheet>

                    <!-- ── Stat buttons ─────────────────────────────────── -->
                    <div class="oe_button_box" name="button_box">

                        <button class="oe_stat_button"
                                icon="fa-check-circle-o"
                                invisible="not todas_retiradas"
                                type="object"
                                name="action_complete">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text text-success">Todas</span>
                                <span class="o_stat_text text-success">Retiradas</span>
                            </div>
                        </button>

                        <button class="oe_stat_button"
                                icon="fa-check-square-o"
                                invisible="not todas_repuestas"
                                type="object"
                                name="action_replace">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text text-success">Todas</span>
                                <span class="o_stat_text text-success">Repuestas</span>
                            </div>
                        </button>

                    </div>

                    <!-- ── Alertas de estado ─────────────────────────────── -->
                    <div class="alert alert-success mb-2"
                         role="alert"
                         invisible="state not in ('approved', 'completed', 'replaced')">
                        <strong>✅ Aprobada por Gerencia</strong>
                        <span invisible="not fecha_autorizacion">
                            el <field name="fecha_autorizacion" readonly="1" widget="datetime" class="oe_inline"/>
                        </span>
                    </div>

                    <div class="alert alert-danger mb-2"
                         role="alert"
                         invisible="state != 'rejected'">
                        <strong>❌ Solicitud Rechazada</strong>
                    </div>

                    <!-- ── Título ────────────────────────────────────────── -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- ── Grupo principal: todos los campos visibles al crear ── -->
                    <group>
                        <group string="Máquinas">
                            <field name="maquina_origen_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="maquina_destino_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                        </group>

                        <group string="Solicitud">
                            <field name="fecha_solicitud" readonly="1"/>
                            <field name="solicitante_id"
                                   options="{'no_open': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group>
                        <!-- Técnico de retiro: se define al crear, no al aprobar -->
                        <group string="Técnico de Retiro">
                            <field name="tecnico_asignado_id"
                                   options="{'no_create': True}"
                                   readonly="state not in ('draft', 'submitted')"
                                   help="Técnico que retirará físicamente las partes. Gerencia solo aprueba o rechaza."/>
                            <field name="tecnico_asignado_mobile_clean"
                                   string="Teléfono"
                                   readonly="1"
                                   invisible="not tecnico_asignado_id"/>
                            <field name="estado_origen_al_retirar" required="1"/>
                        </group>

                        <!-- Responsable de reposición: se define al crear -->
                        <group string="Responsable de Reposición">
                            <field name="responsable_reposicion_id"
                                   options="{'no_create': True}"
                                   readonly="state not in ('draft', 'submitted')"
                                   help="Recibirá alertas automáticas si no repone en 48h."/>
                            <field name="responsable_reposicion_mobile_clean"
                                   string="Teléfono"
                                   readonly="1"
                                   invisible="not responsable_reposicion_id"/>
                        </group>
                    </group>

                    <!-- ── Auditoría aprobación: visible solo post-submit ── -->
                    <group string="Aprobación"
                           invisible="state in ('draft', 'submitted')">
                        <field name="autorizado_por"
                               readonly="1"
                               invisible="not autorizado_por"/>
                        <field name="fecha_autorizacion"
                               readonly="1"
                               invisible="not fecha_autorizacion"/>
                    </group>

                    <!-- ── Auditoría retiro/reposición: visible solo post-retiro ── -->
                    <group string="Retiro / Reposición"
                           invisible="state not in ('completed', 'replaced')">
                        <group>
                            <field name="retirado_por"
                                   readonly="1"
                                   invisible="not retirado_por"/>
                            <field name="fecha_retiro"
                                   readonly="1"
                                   invisible="not fecha_retiro"/>
                        </group>
                        <group>
                            <field name="reemplazado_por"
                                   readonly="1"
                                   invisible="not reemplazado_por"/>
                            <field name="fecha_reemplazo"
                                   readonly="1"
                                   invisible="not fecha_reemplazo"/>
                        </group>
                    </group>

                    <!-- Campos invisibles para lógica de vistas -->
                    <group invisible="1">
                        <field name="todas_retiradas"/>
                        <field name="todas_repuestas"/>
                    </group>

                    <!-- ── Notebook ──────────────────────────────────────── -->
                    <notebook>
                        <page string="Partes Solicitadas" name="partes">
                            <field name="parte_ids"
                                   readonly="state not in ('draft', 'submitted')">
                                <list decoration-success="estado == 'reemplazado'"
                                      decoration-warning="estado == 'retirado'"
                                      decoration-muted="estado == 'pendiente'">

                                    <field name="parte" string="Parte / Componente"/>
                                    <field name="descripcion"/>
                                    <field name="estado"
                                           widget="badge"
                                           decoration-success="estado == 'reemplazado'"
                                           decoration-warning="estado == 'retirado'"
                                           decoration-muted="estado == 'pendiente'"/>
                                    <field name="estado_reposicion"
                                           optional="show"
                                           widget="badge"
                                           decoration-warning="estado_reposicion == 'notificado'"
                                           decoration-muted="estado_reposicion == 'pendiente'"
                                           decoration-success="estado_reposicion == 'repuesta'"/>
                                    <field name="condicion" optional="hide"/>
                                    <field name="fecha_reemplazo" optional="hide"/>
                                    <field name="reemplazado_por" optional="hide"/>
                                    <field name="fecha_retiro_real" optional="hide"/>

                                </list>

                                <form>
                                    <sheet>

                                        <div class="oe_button_box" name="button_box">
                                            <button class="oe_stat_button"
                                                    icon="fa-camera"
                                                    invisible="not foto_reposicion">
                                                <div class="o_field_widget o_stat_info">
                                                    <span class="o_stat_text">Foto</span>
                                                    <span class="o_stat_text">Adjuntada</span>
                                                </div>
                                            </button>
                                        </div>

                                        <group>
                                            <group string="Información de la Parte">
                                                <field name="parte"/>
                                                <field name="descripcion"/>
                                                <field name="estado" widget="badge"/>
                                            </group>

                                            <group string="Control">
                                                <field name="fecha_retiro_real"
                                                       readonly="1"
                                                       invisible="not fecha_retiro_real"/>
                                                <field name="estado_reposicion"
                                                       widget="badge"
                                                       invisible="estado == 'pendiente'"/>
                                            </group>
                                        </group>

                                        <group string="Reposición"
                                               invisible="estado != 'reemplazado'">
                                            <group>
                                                <field name="condicion" readonly="1"/>
                                                <field name="fecha_reemplazo" readonly="1"/>
                                                <field name="reemplazado_por" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="foto_reposicion"
                                                       widget="image"
                                                       class="oe_avatar"
                                                       readonly="1"
                                                       options="{'size': [400, 400]}"/>
                                            </group>
                                        </group>

                                        <group string="Observaciones"
                                               invisible="not observaciones_instalacion">
                                            <field name="observaciones_instalacion"
                                                   nolabel="1"
                                                   readonly="1"/>
                                        </group>

                                        <group invisible="1">
                                            <field name="solicitud_id"/>
                                            <field name="maquina_origen_id"/>
                                            <field name="foto_reposicion_filename"/>
                                        </group>

                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>

                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- =====================================================================
         LIST VIEW
         ===================================================================== -->
    <record id="view_solicitud_partes_list" model="ir.ui.view">
        <field name="name">solicitud.partes.list</field>
        <field name="model">solicitud.partes</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'rejected'"
                  decoration-success="state in ('completed', 'replaced')"
                  decoration-warning="state == 'approved'"
                  decoration-info="state == 'submitted'"
                  decoration-muted="state == 'draft'">

                <field name="name"/>
                <field name="maquina_origen_id"/>
                <field name="maquina_destino_id" optional="show"/>
                <field name="fecha_solicitud"/>
                <field name="solicitante_id"/>
                <field name="tecnico_asignado_id" optional="show"/>
                <field name="responsable_reposicion_id" optional="show"/>
                <field name="autorizado_por" optional="hide"/>
                <field name="fecha_autorizacion" optional="hide"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state in ('completed', 'replaced')"
                       decoration-warning="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-info="state == 'submitted'"
                       decoration-muted="state == 'draft'"/>

            </list>
        </field>
    </record>

    <!-- =====================================================================
         SEARCH VIEW
         ===================================================================== -->
    <record id="view_solicitud_partes_search" model="ir.ui.view">
        <field name="name">solicitud.partes.search</field>
        <field name="model">solicitud.partes</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="maquina_origen_id"/>
                <field name="maquina_destino_id"/>
                <field name="solicitante_id"/>
                <field name="tecnico_asignado_id"/>
                <field name="responsable_reposicion_id"/>

                <filter name="mis_solicitudes"
                        string="Mis Solicitudes"
                        domain="[('solicitante_id', '=', uid)]"/>

                <filter name="mis_retiros"
                        string="Mis Retiros"
                        domain="[('tecnico_asignado_id', '=', uid)]"/>

                <filter name="mis_reposiciones"
                        string="Mis Reposiciones"
                        domain="[('responsable_reposicion_id', '=', uid)]"/>

                <separator/>

                <filter name="pendientes"
                        string="Pendientes aprobación"
                        domain="[('state', '=', 'submitted')]"/>

                <filter name="aprobadas"
                        string="Aprobadas"
                        domain="[('state', '=', 'approved')]"/>

                <filter name="completadas"
                        string="Completadas / Repuestas"
                        domain="[('state', 'in', ('completed', 'replaced'))]"/>

                <filter name="rechazadas"
                        string="Rechazadas"
                        domain="[('state', '=', 'rejected')]"/>

                <separator/>

                <filter name="group_state"
                        string="Por Estado"
                        context="{'group_by': 'state'}"/>

                <filter name="group_solicitante"
                        string="Por Solicitante"
                        context="{'group_by': 'solicitante_id'}"/>

                <filter name="group_tecnico"
                        string="Por Técnico Retiro"
                        context="{'group_by': 'tecnico_asignado_id'}"/>

                <filter name="group_maquina"
                        string="Por Máquina Origen"
                        context="{'group_by': 'maquina_origen_id'}"/>

                <filter name="group_fecha"
                        string="Por Fecha"
                        context="{'group_by': 'fecha_solicitud:month'}"/>

            </search>
        </field>
    </record>
</data>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista del asistente de notificación WhatsApp. Mantiene acciones e identificadores originales. -->
        <record id="view_whatsapp_notification_wizard_form" model="ir.ui.view">
            <field name="name">whatsapp.notification.wizard.form</field>
            <field name="model">whatsapp.notification.wizard</field>
            <field name="arch" type="xml">
                <form string="Notificar visita técnica">
                    <header>
                        <button name="action_enviar_notificacion"
                                string="Notificar y Proceder"
                                type="object"
                                class="btn-primary"
                                invisible="not notificar_grupos"/>
                        <button name="action_solo_notificar"
                                string="Solo Notificar"
                                type="object"
                                class="btn-secondary"
                                invisible="not notificar_grupos"/>
                        <button name="action_cancelar"
                                string="Proceder sin Notificar"
                                type="object"
                                class="btn-secondary"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="ticket_id" readonly="1" options="{'no_open': True}"/>
                            </h1>
                        </div>

                        <group string="Visita programada">
                            <group>
                                <field name="cliente_name" readonly="1"/>
                                <field name="direccion" readonly="1"/>
                            </group>
                            <group>
                                <field name="tecnico_name" readonly="1"/>
                                <field name="fecha_visita_ticket" readonly="1"/>
                            </group>
                        </group>

                        <!-- Se mantienen los campos del asistente para uso operativo,
                             pero no se envían en el mensaje breve del grupo. -->
                        <group string="Configuración de notificación">
                            <group string="Destino">
                                <field name="notificar_grupos"/>
                                <field name="grupo_seleccionado"
                                       required="notificar_grupos"
                                       invisible="not notificar_grupos"/>
                            </group>
                            <group string="Gestión interna de tóner">
                                <field name="cliente_solicita_toner"/>
                                <field name="enviar_toner" readonly="cliente_solicita_toner"/>
                            </group>
                        </group>

                        <group string="Observaciones de tóner"
                               invisible="not cliente_solicita_toner and not enviar_toner">
                            <field name="observaciones_toner" nolabel="1"
                                   placeholder="Tipo de tóner, cantidades u observaciones internas"/>
                        </group>

                        <group string="Mensaje adicional">
                            <field name="mensaje_adicional" nolabel="1"
                                   placeholder="Observaciones de la asignación"/>
                        </group>

                        <!-- Vista previa ajustada al texto real de _generar_mensaje_notificacion().
                             El mensaje adicional y las observaciones de tóner NO se envían al grupo. -->
                        <separator string="Vista previa de WhatsApp" invisible="not notificar_grupos"/>
                        <div invisible="not notificar_grupos"
                             style="background-color: #f8f9fa; padding: 16px; border-radius: 6px; margin-bottom: 12px;">
                            <div style="background-color: white; padding: 16px; border: 1px solid #dee2e6; border-radius: 4px; font-size: 13px;">
                                <p><strong>VISITA TÉCNICA PROGRAMADA</strong></p>
                                <p>
                                    <strong>Cliente:</strong>
                                    <field name="cliente_name" readonly="1" nolabel="1" class="d-inline"/>
                                </p>
                                <p>
                                    <strong>Dirección:</strong>
                                    <field name="direccion" readonly="1" nolabel="1" class="d-inline"/>
                                </p>
                                <p>
                                    <strong>Técnico:</strong>
                                    <field name="tecnico_name" readonly="1" nolabel="1" class="d-inline"/>
                                </p>
                                <p>
                                    <strong>Fecha y hora:</strong>
                                    <field name="fecha_visita_ticket" readonly="1" nolabel="1" class="d-inline"/>
                                </p>
                                <p class="mb-0 mt-3">
                                    Aprovechar la visita programada para evaluar si existen pedidos pendientes de tóner.
                                </p>
                            </div>
                        </div>
                        <p class="text-muted" invisible="not notificar_grupos">
                            La notificación al grupo incluye únicamente los datos de la visita y el recordatorio para Logística.
                        </p>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista de lista: se conservan el ID y los campos originales. -->
        <record id="view_whatsapp_notification_wizard_list" model="ir.ui.view">
            <field name="name">whatsapp.notification.wizard.list</field>
            <field name="model">whatsapp.notification.wizard</field>
            <field name="arch" type="xml">
                <list string="Notificaciones WhatsApp" create="false" edit="false">
                    <field name="ticket_id"/>
                    <field name="cliente_name"/>
                    <field name="fecha_visita"/>
                    <field name="grupo_seleccionado"/>
                    <field name="enviar_toner"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <!-- Se conserva el registro de acceso original sin cambiar su XML ID. -->
        <record id="access_whatsapp_notification_wizard_all" model="ir.model.access">
            <field name="name">whatsapp.notification.wizard.all</field>
            <field name="model_id" ref="model_whatsapp_notification_wizard"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>

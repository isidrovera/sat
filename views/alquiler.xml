                                                style="background: #2B2E4A; color: white;">
                                            <i class="fa fa-qrcode"/>
                                            <span class="small">QR</span>
                                        </button>
        
                                        <button name="create_ticket" type="object" 
                                                class="btn flex-fill rounded-2 d-flex align-items-center justify-content-center gap-1 py-1 fs-6"
                                                style="background: #4ECDC4; color: white;">
                                            <i class="fa fa-plus"/>
                                            <span class="small">Ticket</span>
                                        </button>
        
                                        <button name="create_sale_order" type="object" 
                                                class="btn flex-fill rounded-2 d-flex align-items-center justify-content-center gap-1 py-1 fs-6"
                                                style="background: #FF6B6B; color: white;">
                                            <i class="fa fa-file-invoice"/>
                                            <span class="small">Orden</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <record id="Alquiler_tree_view" model="ir.ui.view">
    <field name="name">Alquiler.tree</field>
    <field name="model">alquiler</field>
    <field name="arch" type="xml">
        <list string="Alquiler List" 
              decoration-bf="fecha_recurrente and fecha_recurrente &lt;= current_date"
              decoration-danger="estado_alquiler_id in ('con_problemas', 'partes')" 
              decoration-warning="estado_alquiler_id == 'sin_revisar'" 
              decoration-info="estado_alquiler_id == 'alquilada'" 
              decoration-success="estado_alquiler_id == 'lista'"
              decoration-muted="estado_alquiler_id == 'vendida'">
            
            <field name="cliente_id" class="oe_avatar" />
            <field name="tipo_maquina_id" optional="hide" />
            <field name="tipo_maquina" optional="hide" />
            <field name="marca" optional="hide" />
            <field name="name" string="Modelo" />
            <field name="serie" />
            <field name="direccion" optional="hide" />
            <field name="contacto_id" optional="hide" />
            <field name="celular" widget="phone" optional="hide" />
            <field name="fecha_recurrente" string="Fecha Man." widget="remaining_days" 
                   decoration-danger="fecha_recurrente and fecha_recurrente &lt;= current_date" />
            
            <field name="estado_alquiler_id" string="Estado" widget="badge"
                decoration-muted="estado_alquiler_id == 'sin_revisar'"
                decoration-info="estado_alquiler_id == 'alquilada'"
                decoration-success="estado_alquiler_id == 'lista'"
                decoration-danger="estado_alquiler_id in ('con_problemas', 'partes')"
                decoration-warning="estado_alquiler_id == 'vendida'"
                decoration-primary="estado_alquiler_id == 'externo'" />
            
            <field name="estado_programacion"
                decoration-success="estado_programacion == 'confirmado'"
                decoration-warning="estado_programacion == 'pendiente'"
                decoration-danger="estado_programacion == 'reprogramado'" string="Mantenimiento"/>

            
            <field name="qr_image" widget="binary" />
            <field name="ticket_count" string="Tickets" sum="Total Tickets" optional="show"/>
            <field name="pedidos_count" string="Pedidos" sum="Total Pedidos" optional="show"/>
            <field name="repuestos_count" string="Repuestos" sum="Total Repuestos" optional="show"/>
            
            <button string=" " type="object" name="generate_qr_code" icon="fa-qrcode" class="text-primary" />
            <button class="oe_stat_button text-info" type="object" name="get_ticket" icon="fa-wrench">
            </button>
            <button class="oe_stat_button text-success" type="object" name="get_pedidos"
                icon="fa-shopping-cart">
            </button>
            <button class="oe_stat_button text-warning" type="object" name="get_repuestos" icon="fa-cogs">
            </button>
        </list>
    </field>
</record>
        <record id="alquiler_andes_search_view" model="ir.ui.view">
    <field name="name">alquiler_andes.search</field>
    <field name="model">alquiler</field>
    <field name="arch" type="xml">
        <search string="alquiler">
            <field name="serie" />
            <field name="cliente_id" />
            <field name="marca" />
            <field name="name" />
            
            <filter name="mantenimiento_hoy" string="Mantenimiento Hoy" 
                    domain="[('fecha_recurrente', '=', context_today())]"/>
            <filter name="mantenimiento_pendiente" string="Mantenimiento Pendiente" 
                    domain="[('fecha_recurrente', '&lt;=', context_today())]"/>
            
            <separator />
            <filter name="estado_sin_revisar" string="Sin revisar"
                domain="[('estado_alquiler_id', '=', 'sin_revisar')]" />
            <separator />
            <filter name="estado_lista" string="Lista"
                domain="[('estado_alquiler_id', '=', 'lista')]" />
            <separator />
            <filter name="estado_revisada" string="Revisada"
                domain="[('estado_alquiler_id', '=', 'revisada')]" />
            <separator />
            <filter name="estado_alquilada" string="Alquilada"
                domain="[('estado_alquiler_id', '=', 'alquilada')]" />
            <separator />
            <filter name="estado_con_problemas" string="Con problemas"
                domain="[('estado_alquiler_id', '=', 'con_problemas')]" />
            <separator />
            <filter name="estado_partes" string="De partes"
                domain="[('estado_alquiler_id', '=', 'partes')]" />
            <separator />
            <filter name="estado_externo" string="Externo"
                domain="[('estado_alquiler_id', '=', 'externo')]" />
            <separator />
            <filter name="estado_vendida" string="Vendida"
                domain="[('estado_alquiler_id', '=', 'vendida')]" />
            <separator />

            <group>
                <filter name="group_by_estado" string="Estado"
                    context="{'group_by': 'estado_alquiler_id'}" />
                <filter name="group_by_cliente" string="Cliente" 
                    context="{'group_by': 'cliente_id'}" />
                <filter name="group_by_marca" string="Marca" 
                    context="{'group_by': 'marca'}" />
            </group>
            
            <searchpanel>
                <field name="estado_alquiler_id" string="Estado" enable_counters="1" icon="fa-tasks"/>
                
            </searchpanel>
        </search>
    </field>
</record>

        <record id="alquiler_view_calendar" model="ir.ui.view">
            <field name="name">alquiler.calendar</field>
            <field name="model">alquiler</field>
            <field name="arch" type="xml">
                <calendar date_start="fecha_recurrente" color="cliente_id" event_limit="5">
                    <field name="cliente_id" />
                    <field name="direccion" />
                </calendar>
            </field>
        </record>
        <record id="alquiler_view_graph" model="ir.ui.view">
            <field name="name">alquiler.graph</field>
            <field name="model">alquiler</field>
            <field name="arch" type="xml">
                <graph string="Alquiler" sample="1">
                    <field name="cliente_id" />
                    <field name="pedidos_count" />
                </graph>
            </field>
        </record>

         <!-- Vista Form Wizard -->

                                                    <i class="fa fa-tools mb-1" style="color: #FFE66D; font-size: 1rem;"/>
                                                    <div class="fw-bold"><field name="repuestos_count"/></div>
                                                    <div class="text-muted small">Repuestos</div>
                                                </div>
                                            </button>
                                        </div>

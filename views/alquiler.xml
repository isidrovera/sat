<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="Alquiler_form_view" model="ir.ui.view">
            <field name="name">Alquiler.form</field>
            <field name="model">alquiler</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        
                        <button string="Crear Pedido" name="create_sale_order" type="object"
                            icon="fa-cart-plus" class="btn btn-success" />
                        <button string="Crear Ticket" name="create_ticket" type="object"
                            icon="fa-wrench" class="btn btn-primary" />

                        <button string="Enviar Recordatorio" type="object" class="oe_highlight"
                            name="button_send_test_mail" />
                        <button name="action_enviar_inspeccion" 
                            string="Enviar Inspección" 
                            type="object" 
                            class="btn-primary"/>
                        <button 
                            name="action_solicitar_partes" 
                            string="Solicitar Partes" 
                            type="object" 
                            class="oe_highlight"
                           
                        />
                        
                        <field name="estado_alquiler_id" widget="statusbar"
                            options="{'clickable': '1'}" />

                    </header>
                    <sheet>
                        <div name="button_box">
                            <button class="oe_stat_button" type="object" name="get_ticket"
                                icon="fa-wrench">
                                <field string="Tickets" name="ticket_count" widget="statinfo" />
                            </button>
                            <button class="oe_stat_button" type="object" name="get_pedidos"
                                icon="fa-shopping-cart">
                                <field string="Pedidos" name="pedidos_count" widget="statinfo" />
                            </button>
                            <button class="oe_stat_button" type="object" name="get_repuestos"
                                icon="fa-cogs">
                                <field string="Repuestos" name="repuestos_count" widget="statinfo" />
                            </button>
                            <button name="action_view_partes" type="object" class="oe_stat_button" icon="fa-cog">
                                <field name="partes_solicitadas_count" widget="statinfo" string="Pedidos Partes"/>
                            </button>
                        </div>

                        <!--<div
                        name="button_box">
                            <button class="oe_stat_button" type="object" name="get_pedidos" icon="fa-shopping-cart">
                                <field string="Pedidos" name="pedidos_count" widget="statinfo"/>
                            </button>
                        </div> -->
                        <separator />
                        <separator />
                        <separator />
                        <div class="oe_title">
                            <label for="cliente_id" />
                            <h1>
                                <field name="cliente_id" placeholder="Datos del Cliente"
                                    widget="many2one_avatar" options="{'no_create': True}" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="direccion" required="estado_alquiler_id == 'alquilada'" />
                                <field name="contacto_id" required="estado_alquiler_id == 'alquilada'" />
                                <field name="celular" widget="phone"
                                    required="estado_alquiler_id == 'alquilada'"/>
                                <field name="correo_" widget="email"
                                    required="estado_alquiler_id == 'alquilada'" />
                                <field name="estado_instalacion" widget="badge"/>

                                <!--<field
                                name="image_qr" widget="image" options="{'size': [128, 128]}"/>-->

                            </group>
                            <group>
                                <field name="tipo_maquina_id" invisible="1" />
                                <field name="tipo_maquina" invisible="1" />
                                <field name="marca" />
                                <field name="name" options="{'no_create': True}" />
                                <field name="serie" />
                                <field name="ubicacion_id"
                                    invisible="estado_alquiler_id == 'alquilada'" />
                                <field name="observaciones" />
                                <field name="ubicacion_instalacion" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Datos de compra">
                                <group>
                                    <field name="factura_compra" />
                                    <field name="fecha_compra" />
                                    <field name="currency_id" string="Tipo de moneda" />
                                    <field name="precio_compra" widget="monetary"
                                        options="{'currency_field': 'currency_id'}" />
                                </group>
                            </page>
                            <page string="Mantenimiento Preventivo" name="maintenance_page">
                                <div class="py-2">
                                    <!-- Control Principal -->
                                    <div class="d-flex align-items-center gap-2 mb-4">
                                        <field name="control_mantenimiento" widget="toggle"/>
                                        <span class="text-muted">Control de Mantenimiento</span>
                                    </div>
                            
                                    <div invisible="not control_mantenimiento">
                                        <!-- Campos Principales -->
                                        <div class="row g-3">
                                            <!-- Columna Izquierda -->
                                            <div class="col-12 col-lg-6">
                                                <div class="card">
                                                    <div class="card-body">
                                                        <h6 class="mb-3">Configuración de Fechas</h6>
                                                        <group>
                                                            <field name="fecha_inicio" 
                                                                required="control_mantenimiento == True and estado_alquiler_id == 'alquilada'"
                                                                class="mb-3"/>
                                                            <field name="fecha_recurrente" 
                                                                readonly="1" 
                                                                class="mb-3"
                                                                decoration-info="True"/>
                                                        </group>
                                                    </div>
                                                </div>
                                            </div>
                            
                                            <!-- Columna Derecha -->
                                            <div class="col-12 col-lg-6">
                                                <div class="card">
                                                    <div class="card-body">
                                                        <h6 class="mb-3">Configuración de Intervalos</h6>
                                                        <field name="intervalo_meses" 
                                                            invisible="not control_mantenimiento"
                                                            required="control_mantenimiento"
                                                            widget="radio"
                                                            options="{'horizontal': true}"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                            
                                        <!-- Panel de Instrucciones -->
                                        <div class="alert alert-info mt-4" role="alert">
                                            <div class="d-flex gap-2 mb-2">
                                                <i class="bi bi-info-circle-fill"></i>
                                                <strong>Instrucciones de Mantenimiento</strong>
                                            </div>
                                            <ul class="list-unstyled m-0">
                                                <li class="d-flex gap-2 mb-2">
                                                    <i class="bi bi-calendar-check"></i>
                                                    <span>La fecha que seleccione determinará el patrón de mantenimiento</span>
                                                </li>
                                                <li class="d-flex gap-2 mb-2">
                                                    <i class="bi bi-calendar-week"></i>
                                                    <span>Si elige un primer viernes del mes, los mantenimientos serán los primeros viernes</span>
                                                </li>
                                                <li class="d-flex gap-2 mb-2">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                    <span>El intervalo determina cada cuántos meses se repetirá el patrón</span>
                                                </li>
                                                <li class="d-flex gap-2">
                                                    <i class="bi bi-clock"></i>
                                                    <span>La fecha recurrente mostrará la próxima fecha programada</span>
                                                </li>
                                            </ul>
                                        </div>
                            
                                        <!-- Estado de Programación -->
                                        <div class="card mt-4">
                                            <div class="card-body">
                                                <h6 class="mb-3">Estado del Mantenimiento</h6>
                                                <field name="estado_programacion" 
                                                       widget="state_selection" 
                                                       class="d-block"
                                                       options="{
                                                           'state_colors': {
                                                               'pendiente': 'warning',
                                                               'confirmado': 'success',
                                                               'reprogramado': 'danger'
                                                           }
                                                       }"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </page>
                            <page string="Datos de cliente externo">
                                <group>
                                    <group>
                                        <field name="factura_venta" />
                                        <field name="fecha_venta" />
                                        <field name="currency_id" string="Tipo de moneda" />
                                        <field name="precio_venta" widget="monetary"
                                            options="{'currency_field': 'currency_id'}" />
                                    </group>
                                    <group>
                                        <field name="garantia" />
                                        <field name="contometro_venta" />
                                    </group>
                                </group>
                            </page>
                            <page string="Partes Solicitadas">
                                <field name="partes_ids">
                                    <list>
                                        <field name="solicitud_id"/>
                                        <field name="parte"/>
                                        <field name="descripcion"/>
                                        <field name="estado"/>
                                        <field name="fecha_reemplazo"/>
                                        <field name="reemplazado_por"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>
        <record id="alquiler_kanban_view" model="ir.ui.view">
            <field name="name">alquiler.kanban</field>
            <field name="model">alquiler</field>
            <field name="arch" type="xml">
                <kanban default_group_by="estado_alquiler_id" 
                        class="o_kanban_small_column" 
                        records_draggable="1" 
                        group_create="0" 
                        sample="1">
                    
                    <field name="cliente_id"/>
                    <field name="name"/>
                    <field name="serie"/>
                    <field name="marca"/>
                    <field name="estado_alquiler_id"/>
                    <field name="fecha_recurrente"/>
                    <field name="celular"/>
                    <field name="direccion"/>
                    <field name="ticket_count"/>
                    <field name="pedidos_count"/>
                    <field name="repuestos_count"/>
                    
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card position-relative rounded-4 overflow-hidden" 
                                 style="box-shadow: rgba(17, 12, 46, 0.15) 0px 48px 100px 0px; transition: all 0.3s ease;">
                                
                                <!-- Estado como badge flotante -->
                                <div class="position-absolute top-0 end-0 m-3">
                                    <span t-attf-class="badge #{record.estado_alquiler_id.raw_value == 'sin_revisar' ? 'bg-danger' : 
                                                             (record.estado_alquiler_id.raw_value == 'alquilada' ? 'bg-success' : 
                                                             (record.estado_alquiler_id.raw_value == 'lista' ? 'bg-info' : 'bg-secondary'))} 
                                                             rounded-pill px-3 py-2">
                                        <field name="estado_alquiler_id"/>
                                    </span>
                                </div>
        
                                <!-- Contenedor principal con gradiente -->
                                <div class="position-relative p-4" 
                                     style="background: linear-gradient(135deg, #2B2E4A 0%, #1A1B2E 100%);">
                                    
                                    <!-- Información principal -->
                                    <div class="mb-3">
                                        <h5 class="d-flex align-items-center mb-2 text-white">
                                            <i class="fa fa-print me-2" style="color: #4ECDC4;"/>
                                            <field name="name"/> - <field name="serie"/>
                                        </h5>
                                        <div class="d-flex align-items-center text-white-50 mb-1">
                                            <i class="fa fa-building me-2" style="color: #FF6B6B;"/>
                                            <field name="marca"/>
                                        </div>
                                        <div class="d-flex align-items-center text-white-50">
                                            <i class="fa fa-map-marker me-2" style="color: #FFE66D;"/>
                                            <field name="direccion" class="text-truncate"/>
                                        </div>
                                    </div>
                                </div>
        
                                <!-- Área de estadísticas -->
                                <div class="bg-white p-4">
                                    <!-- Contadores -->
                                    <div class="d-flex justify-content-between gap-3 mb-4">
                                        <!-- Tickets -->
                                        <div class="flex-fill">
                                            <button name="get_ticket" type="object" 
                                                    class="w-100 btn btn-light rounded-3 p-3 h-100 position-relative">
                                                <div class="text-center">
                                                    <i class="fa fa-headset mb-2" style="color: #4ECDC4; font-size: 1.5rem;"/>
                                                    <div class="fs-4 fw-bold"><field name="ticket_count"/></div>
                                                    <small class="text-muted">Tickets</small>
                                                </div>
                                            </button>
                                        </div>
        
                                        <!-- Pedidos -->
                                        <div class="flex-fill">
                                            <button name="get_pedidos" type="object" 
                                                    class="w-100 btn btn-light rounded-3 p-3 h-100 position-relative">
                                                <div class="text-center">
                                                    <i class="fa fa-shopping-cart mb-2" style="color: #FF6B6B; font-size: 1.5rem;"/>
                                                    <div class="fs-4 fw-bold"><field name="pedidos_count"/></div>
                                                    <small class="text-muted">Pedidos</small>
                                                </div>
                                            </button>
                                        </div>
        
                                        <!-- Repuestos -->
                                        <div class="flex-fill">
                                            <button name="get_repuestos" type="object" 
                                                    class="w-100 btn btn-light rounded-3 p-3 h-100 position-relative">
                                                <div class="text-center">
                                                    <i class="fa fa-tools mb-2" style="color: #FFE66D; font-size: 1.5rem;"/>
                                                    <div class="fs-4 fw-bold"><field name="repuestos_count"/></div>
                                                    <small class="text-muted">Repuestos</small>
                                                </div>
                                            </button>
                                        </div>
                                    </div>
        
                                    <!-- Botones de acción -->
                                    <div class="d-flex gap-2">
                                        <button name="generate_qr_code" type="object" 
                                                class="btn flex-1 rounded-3 d-flex align-items-center justify-content-center gap-2 py-2"
                                                style="background: #2B2E4A; color: white;">
                                            <i class="fa fa-qrcode"/>
                                            <span>QR Code</span>
                                        </button>
        
                                        <button name="create_ticket" type="object" 
                                                class="btn flex-1 rounded-3 d-flex align-items-center justify-content-center gap-2 py-2"
                                                style="background: #4ECDC4; color: white;">
                                            <i class="fa fa-plus"/>
                                            <span>Nuevo Ticket</span>
                                        </button>
        
                                        <button name="create_sale_order" type="object" 
                                                class="btn flex-1 rounded-3 d-flex align-items-center justify-content-center gap-2 py-2"
                                                style="background: #FF6B6B; color: white;">
                                            <i class="fa fa-file-invoice"/>
                                            <span>Nueva Orden</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <record id="Alquiler_tree_view" model="ir.ui.view">
            <field name="name">Alquiler.tree</field>
            <field name="model">alquiler</field>
            <field name="arch" type="xml">
                <list string="Alquiler List " >
                    <field name="cliente_id" class="oe_avatar" />
                    <field name="tipo_maquina_id" optional="hide" />
                    <field name="tipo_maquina" optional="hide" />
                    <field name="marca" optional="hide" />
                    <field name="name" string="Modelo" />
                    <field name="serie" />
                    <field name="direccion" optional="hide" />
                    <field name="contacto_id" optional="hide" />
                    <field name="celular" widget="phone" optional="hide" />
                    <field name="fecha_recurrente" string="Mantenimiento" widget="remaining_days" />
                    <field name="estado_alquiler_id" string="Estado" widget="badge"
                        decoration-muted="estado_alquiler_id == 'sin_revisar'"
                        decoration-info="estado_alquiler_id == 'alquilada'"
                        decoration-success="estado_alquiler_id == 'lista' "
                        decoration-danger="estado_alquiler_id not in ('sin_revisar','alquilada','lista','vendida')"
                        decoration-warning="estado_alquiler_id == 'vendida' " />
                    <field name="estado_programacion" 
                        widget="state_selection" 
                        class="d-block"
                        options="{
                            'state_colors': {
                                'pendiente': 'warning',
                                'confirmado': 'success',
                                'reprogramado': 'danger'
                            }
                        }"/>
                    <field name="qr_image" widget="binary" />
                    <button string=" " type="object" name="generate_qr_code" icon="fa-qrcode" />
                    <button class="oe_stat_button" type="object" name="get_ticket" icon="fa-wrench">
                    </button>
                    <button class="oe_stat_button" type="object" name="get_pedidos"
                        icon="fa-shopping-cart">
                    </button>
                    <button class="oe_stat_button" type="object" name="get_repuestos" icon="fa-cogs">
                    </button>
                </list>
            </field>
        </record>
        <record id="alquiler_andes_search_view" model="ir.ui.view">
            <field name="name">alquiler_andes.search</field>
            <field name="model">alquiler</field>
            <field name="arch" type="xml">
                <search string="alquiler" position="inside">
                    <group>
                        <!--Este
                        son filtros rapidos-->
                        <separator />
                        <filter name="estado_alquiler_id" string="Sin revisar"
                            domain="[('estado_alquiler_id', '=', 'sin_revisar')]" />
                        <separator />
                        <filter name="estado_alquiler_id" string="Lista"
                            domain="[('estado_alquiler_id', '=', 'lista')]" />
                        <separator />
                        <filter name="estado_alquiler_id" string="Revisada"
                            domain="[('estado_alquiler_id', '=', 'revisada')]" />
                        <separator />
                        <filter name="estado_alquiler_id" string="Alquilada"
                            domain="[('estado_alquiler_id', '=', 'alquilada')]" />
                        <separator />
                        <filter name="estado_alquiler_id" string="Con problemas"
                            domain="[('estado_alquiler_id', '=', 'con_problemas')]" />
                        <separator />
                        <filter name="estado_alquiler_id" string="De partes"
                            domain="[('estado_alquiler_id', '=', 'partes')]" />
                        <separator />
                        <filter name="estado_alquiler_id" string="Externo"
                            domain="[('estado_alquiler_id', '=', 'externo')]" />
                        <separator />
                        <filter name="estado_alquiler_id" string="Vendida"
                            domain="[('estado_alquiler_id', '=', 'vendida')]" />
                        <separator />


                        <!--Este
                        es agrupar rapido-->
                        <filter name="estado_alquiler_id" string="Estado"
                            context="{'group_by': 'estado_alquiler_id'}" />
                    </group>
                    <field name="serie" />
                    <field name="cliente_id" />
                    <field name="marca" />
                    <field name="name" />
                    
                </search>


            </field>
        </record>
        <record id="alquiler_view_calendar" model="ir.ui.view">
            <field name="name">alquiler.calendar</field>
            <field name="model">alquiler</field>
            <field name="arch" type="xml">
                <calendar date_start="fecha_recurrente" color="cliente_id" event_limit="5">
                    <field name="cliente_id" />
                    <field name="direccion" />
                </calendar>
            </field>
        </record>
        <record id="alquiler_view_graph" model="ir.ui.view">
            <field name="name">alquiler.graph</field>
            <field name="model">alquiler</field>
            <field name="arch" type="xml">
                <graph string="Alquiler" sample="1">
                    <field name="cliente_id" />
                    <field name="pedidos_count" />
                </graph>
            </field>
        </record>

         <!-- Vista Form Wizard -->
    <record id="wizard_enviar_inspeccion_form" model="ir.ui.view">
        <field name="name">wizard.enviar.inspeccion.form</field>
        <field name="model">wizard.enviar.inspeccion</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="correo"/>
                    <field name="alquiler_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_enviar" 
                            string="Enviar" 
                            type="object" 
                            class="btn-primary"/>
                    <button special="cancel" 
                            string="Cancelar" 
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    </data>
</odoo>

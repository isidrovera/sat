<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <!-- SECUENCIA -->
    <record id="seq_solicitud_parte_tecnico" model="ir.sequence">
        <field name="name">Solicitud Parte Técnico</field>
        <field name="code">solicitud.parte.tecnico</field>
        <field name="prefix">SPT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- FORM -->
    <record id="view_solicitud_parte_tecnico_form" model="ir.ui.view">
        <field name="name">solicitud.parte.tecnico.form</field>
        <field name="model">solicitud.parte.tecnico</field>
        <field name="arch" type="xml">

            <form string="Solicitud de Parte">

                <header>
                    <button name="action_cancelar"
                            string="Cancelar"
                            type="object"
                            class="btn-danger"
                            invisible="state in ['completada','cancelada']"
                            confirm="¿Cancelar esta solicitud?"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="enviada,en_gestion,completada"/>
                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>

                        <group string="Solicitud">
                            <field name="reparacion_id" readonly="1"/>
                            <field name="tecnico_id" readonly="1"/>
                            <field name="fecha_solicitud" readonly="1"/>
                        </group>

                        <group string="Máquina">
                            <field name="maquina_id" readonly="1"/>
                            <field name="marca" readonly="1"/>
                            <field name="modelo" readonly="1"/>
                            <field name="serie" readonly="1"/>
                        </group>

                    </group>

                    <group string="Resumen" invisible="state == 'enviada'">

                        <group>
                            <field name="total_partes" readonly="1"/>
                            <field name="partes_pendientes" readonly="1"/>
                        </group>

                        <group>
                            <field name="partes_encontradas" readonly="1"/>
                            <field name="partes_por_conseguir" readonly="1"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Partes Solicitadas">

                            <field name="linea_ids">

                                <list>

                                    <field name="parte"/>
                                    <field name="descripcion"/>

                                    <field name="foto_referencia"
                                           widget="image"
                                           class="oe_avatar"
                                           options="{'size':[50,50]}"
                                           accept="image/*;capture=camera"/>

                                    <field name="state"
                                           widget="badge"
                                           decoration-info="state == 'buscando'"
                                           decoration-success="state in ['encontrada','entregada']"
                                           decoration-warning="state == 'por_conseguir'"/>

                                    <field name="tipo_origen" optional="show"/>
                                    <field name="gestionado_por" optional="show"/>
                                    <field name="notas_jefe" optional="show"/>

                                    <button name="action_gestionar"
                                            string="Gestionar"
                                            type="object"
                                            icon="fa-search"
                                            invisible="state not in ['buscando','por_conseguir']"
                                            groups="base.group_system"/>

                                </list>

                                <form string="Detalle de Parte">

                                    <group>

                                        <group>
                                            <field name="parte"/>
                                            <field name="descripcion"/>
                                        </group>

                                        <group>
                                            <field name="foto_referencia"
                                                   widget="image"
                                                   class="oe_avatar"
                                                   accept="image/*;capture=camera"/>
                                        </group>

                                    </group>

                                    <group string="Gestión"
                                           invisible="state == 'buscando'">

                                        <field name="state" readonly="1"/>
                                        <field name="tipo_origen" readonly="1"/>

                                        <field name="maquina_origen_alquiler_id"
                                               readonly="1"
                                               invisible="tipo_origen != 'alquiler'"/>

                                        <field name="maquina_origen_sat_id"
                                               readonly="1"
                                               invisible="tipo_origen != 'sat'"/>

                                        <field name="notas_jefe" readonly="1"/>
                                        <field name="gestionado_por" readonly="1"/>
                                        <field name="fecha_gestion" readonly="1"/>

                                    </group>

                                </form>

                            </field>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>


    <!-- LIST -->
    <record id="view_solicitud_parte_tecnico_list" model="ir.ui.view">
        <field name="name">solicitud.parte.tecnico.list</field>
        <field name="model">solicitud.parte.tecnico</field>
        <field name="arch" type="xml">

            <list string="Solicitudes de Partes"
                  decoration-warning="state == 'enviada'"
                  decoration-info="state == 'en_gestion'"
                  decoration-success="state == 'completada'"
                  decoration-muted="state == 'cancelada'">

                <field name="name"/>
                <field name="fecha_solicitud"/>
                <field name="tecnico_id"/>
                <field name="reparacion_id"/>
                <field name="marca"/>
                <field name="modelo"/>
                <field name="serie"/>
                <field name="total_partes"/>
                <field name="partes_pendientes"/>

                <field name="state"
                       widget="badge"
                       decoration-warning="state == 'enviada'"
                       decoration-info="state == 'en_gestion'"
                       decoration-success="state == 'completada'"
                       decoration-danger="state == 'cancelada'"/>

            </list>

        </field>
    </record>


    <!-- SEARCH -->
    <record id="view_solicitud_parte_tecnico_search" model="ir.ui.view">
        <field name="name">solicitud.parte.tecnico.search</field>
        <field name="model">solicitud.parte.tecnico</field>
        <field name="arch" type="xml">

            <search>

                <field name="name"/>
                <field name="tecnico_id"/>
                <field name="reparacion_id"/>
                <field name="serie"/>

                <separator/>

                <filter string="Enviadas"
                        name="enviadas"
                        domain="[('state','=','enviada')]"/>

                <filter string="En Gestión"
                        name="en_gestion"
                        domain="[('state','=','en_gestion')]"/>

                <filter string="Completadas"
                        name="completadas"
                        domain="[('state','=','completada')]"/>

                <filter string="Mis Solicitudes"
                        name="mis"
                        domain="[('tecnico_id','=',uid)]"/>

                <group expand="0" string="Agrupar por">
                    <filter string="Técnico"
                            name="by_tecnico"
                            context="{'group_by':'tecnico_id'}"/>
                    <filter string="Estado"
                            name="by_state"
                            context="{'group_by':'state'}"/>
                </group>

            </search>

        </field>
    </record>


    <!-- WIZARD TÉCNICO -->
    <record id="view_solicitud_parte_tecnico_wizard_form" model="ir.ui.view">
        <field name="name">solicitud.parte.tecnico.wizard.form</field>
        <field name="model">solicitud.parte.tecnico.wizard</field>
        <field name="arch" type="xml">

            <form string="Solicitar Parte">

                <sheet>

                    <div class="alert alert-info">
                        <strong>Ingrese las partes que necesita.</strong>
                        El jefe de área buscará disponibilidad.
                    </div>

                    <group string="Reparación / Máquina">
                        <field name="reparacion_id" readonly="1"/>
                        <field name="marca" readonly="1"/>
                        <field name="modelo" readonly="1"/>
                        <field name="serie" readonly="1"/>
                    </group>

                    <separator string="Partes a Solicitar"/>

                    <field name="linea_ids">

                        <list editable="bottom">

                            <field name="parte"/>
                            <field name="descripcion"/>

                            <field name="foto_referencia"
                                   widget="image"
                                   class="oe_avatar"
                                   options="{'size':[60,60]}"
                                   accept="image/*;capture=camera"/>

                            <field name="foto_referencia_filename" invisible="1"/>

                        </list>

                    </field>

                </sheet>

                <footer>

                    <button name="action_crear_solicitud"
                            string="Enviar Solicitud"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>

                </footer>

            </form>

        </field>
    </record>


    <!-- WIZARD JEFE -->
    <record id="view_solicitud_parte_gestionar_wizard_form" model="ir.ui.view">
        <field name="name">solicitud.parte.gestionar.wizard.form</field>
        <field name="model">solicitud.parte.gestionar.wizard</field>
        <field name="arch" type="xml">

            <form string="Gestionar Parte">

                <sheet>

                    <group string="Parte Solicitada">
                        <field name="parte" readonly="1"/>
                        <field name="descripcion" readonly="1"/>
                    </group>

                    <group string="Resultado">
                        <field name="resultado" widget="radio"/>
                    </group>

                    <group string="Origen"
                           invisible="resultado != 'encontrada'">

                        <field name="tipo_origen" widget="radio"/>

                        <field name="maquina_origen_alquiler_id"
                               invisible="tipo_origen != 'alquiler'"
                               required="tipo_origen == 'alquiler'"/>

                        <field name="maquina_origen_sat_id"
                               invisible="tipo_origen != 'sat'"
                               required="tipo_origen == 'sat'"/>

                    </group>

                    <group>
                        <field name="notas"/>
                    </group>

                </sheet>

                <footer>

                    <button name="action_confirmar"
                            string="Confirmar"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>

                </footer>

            </form>

        </field>
    </record>
</data>
</odoo>
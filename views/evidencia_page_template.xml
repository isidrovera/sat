<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════
         Página principal de subida de evidencia
         ════════════════════════════════════════════════════════════════ -->
    <template id="evidencia_page_template" name="Subir Evidencia Fotográfica">
        <html lang="es">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
                <title>Evidencia Ticket <t t-out="ticket.name"/></title>

                <style>
                    * {
                        box-sizing: border-box;
                        margin: 0;
                        padding: 0;
                    }

                    body {
                        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
                        background: #f5f5f5;
                        color: #2d3748;
                        padding: 12px;
                        -webkit-font-smoothing: antialiased;
                    }

                    .container {
                        max-width: 520px;
                        margin: 0 auto;
                    }

                    .header {
                        background: linear-gradient(135deg, #2f855a, #38a169);
                        color: white;
                        padding: 16px;
                        border-radius: 10px 10px 0 0;
                        text-align: center;
                    }

                    .header h1 {
                        font-size: 18px;
                        margin-bottom: 4px;
                    }

                    .header .subtitle {
                        font-size: 13px;
                        opacity: 0.95;
                    }

                    .ticket-info {
                        background: white;
                        padding: 14px 16px;
                        border-left: 1px solid #e2e8f0;
                        border-right: 1px solid #e2e8f0;
                    }

                    .info-row {
                        display: flex;
                        justify-content: space-between;
                        gap: 12px;
                        padding: 5px 0;
                        font-size: 13px;
                    }

                    .info-row .label {
                        color: #718096;
                        flex-shrink: 0;
                    }

                    .info-row .value {
                        font-weight: 600;
                        text-align: right;
                        max-width: 65%;
                        word-break: break-word;
                    }

                    .toggle-momento {
                        display: flex;
                        background: white;
                        border-left: 1px solid #e2e8f0;
                        border-right: 1px solid #e2e8f0;
                        border-top: 1px solid #e2e8f0;
                        margin-top: 8px;
                    }

                    .toggle-momento button {
                        flex: 1;
                        padding: 14px;
                        border: none;
                        background: white;
                        font-size: 14px;
                        font-weight: 700;
                        cursor: pointer;
                        color: #718096;
                        transition: all 0.2s;
                    }

                    .toggle-momento button.active {
                        background: #38a169;
                        color: white;
                    }

                    .upload-section {
                        background: white;
                        padding: 18px 16px;
                        border-left: 1px solid #e2e8f0;
                        border-right: 1px solid #e2e8f0;
                        border-bottom: 1px solid #e2e8f0;
                        border-radius: 0 0 10px 10px;
                    }

                    .gps-status {
                        padding: 11px 14px;
                        background: #fff5e6;
                        border-radius: 8px;
                        margin-bottom: 12px;
                        font-size: 13px;
                        text-align: center;
                        line-height: 1.45;
                    }

                    .gps-status.ok {
                        background: #f0fff4;
                        color: #22543d;
                    }

                    .gps-status.error {
                        background: #fff5f5;
                        color: #742a2a;
                    }

                    .gps-status.warning {
                        background: #fffaf0;
                        color: #7c2d12;
                    }

                    .btn-tomar-foto {
                        display: block;
                        width: 100%;
                        background: #38a169;
                        color: white;
                        padding: 16px;
                        border: none;
                        border-radius: 8px;
                        font-size: 16px;
                        font-weight: 700;
                        cursor: pointer;
                        margin-bottom: 10px;
                    }

                    .btn-tomar-foto:disabled {
                        background: #a0aec0;
                        cursor: not-allowed;
                    }

                    .btn-tomar-foto:active {
                        transform: scale(0.98);
                    }

                    .btn-reintentar {
                        display: block;
                        width: 100%;
                        background: white;
                        color: #38a169;
                        padding: 11px;
                        border: 1px solid #38a169;
                        border-radius: 7px;
                        font-size: 13px;
                        font-weight: 700;
                        cursor: pointer;
                        margin-bottom: 10px;
                    }

                    .nota-marca {
                        margin-top: 8px;
                        font-size: 12px;
                        line-height: 1.45;
                        color: #718096;
                        text-align: center;
                    }

                    .hidden-input {
                        display: none;
                    }

                    .preview-section {
                        display: none;
                        margin-top: 14px;
                        background: white;
                        padding: 14px;
                        border: 1px solid #e2e8f0;
                        border-radius: 10px;
                    }

                    .preview-section.show {
                        display: block;
                    }

                    .preview-section h3 {
                        font-size: 14px;
                        margin-bottom: 10px;
                        color: #4a5568;
                    }

                    .preview-section img {
                        width: 100%;
                        border-radius: 8px;
                        border: 1px solid #e2e8f0;
                    }

                    .galeria {
                        margin-top: 18px;
                        background: white;
                        padding: 16px;
                        border: 1px solid #e2e8f0;
                        border-radius: 10px;
                    }

                    .galeria h3 {
                        font-size: 14px;
                        color: #718096;
                        margin-bottom: 10px;
                    }

                    .grid-fotos {
                        display: grid;
                        grid-template-columns: repeat(3, 1fr);
                        gap: 7px;
                    }

                    .grid-fotos .foto-link {
                        display: block;
                        text-decoration: none;
                    }

                    .grid-fotos .foto-link img {
                        width: 100%;
                        aspect-ratio: 1;
                        object-fit: cover;
                        border-radius: 6px;
                        border: 1px solid #e2e8f0;
                        background: #edf2f7;
                        cursor: zoom-in;
                    }

                    .empty-gallery {
                        grid-column: 1 / -1;
                        padding: 18px;
                        text-align: center;
                        color: #a0aec0;
                        font-size: 13px;
                        background: #f7fafc;
                        border-radius: 7px;
                    }

                    .toast {
                        position: fixed;
                        bottom: 20px;
                        left: 50%;
                        transform: translateX(-50%);
                        padding: 12px 20px;
                        border-radius: 8px;
                        color: white;
                        font-size: 14px;
                        z-index: 1000;
                        opacity: 0;
                        transition: opacity 0.3s;
                        max-width: 90%;
                        text-align: center;
                        box-shadow: 0 8px 20px rgba(0,0,0,0.18);
                    }

                    .toast.show {
                        opacity: 1;
                    }

                    .toast.ok {
                        background: #38a169;
                    }

                    .toast.error {
                        background: #e53e3e;
                    }

                    .progress-overlay {
                        position: fixed;
                        inset: 0;
                        background: rgba(0,0,0,0.56);
                        display: none;
                        align-items: center;
                        justify-content: center;
                        z-index: 999;
                        padding: 20px;
                    }

                    .progress-overlay.show {
                        display: flex;
                    }

                    .progress-box {
                        background: white;
                        padding: 24px 30px;
                        border-radius: 10px;
                        text-align: center;
                        font-size: 14px;
                        max-width: 300px;
                    }

                    .spinner {
                        border: 3px solid #e2e8f0;
                        border-top-color: #38a169;
                        border-radius: 50%;
                        width: 34px;
                        height: 34px;
                        animation: spin 0.8s linear infinite;
                        margin: 0 auto 12px;
                    }

                    @keyframes spin {
                        to {
                            transform: rotate(360deg);
                        }
                    }

                    .debug-panel {
                        margin-top: 14px;
                        padding: 9px 10px;
                        background: #1a202c;
                        color: #68d391;
                        font-family: monospace;
                        font-size: 11px;
                        border-radius: 8px;
                        max-height: 210px;
                        overflow-y: auto;
                        word-break: break-word;
                    }

                    .debug-panel .log-line {
                        margin-bottom: 3px;
                        line-height: 1.35;
                    }

                    .debug-panel .log-error {
                        color: #fc8181;
                    }

                    .debug-panel .log-warn {
                        color: #f6ad55;
                    }

                    .debug-panel .log-ok {
                        color: #68d391;
                    }

                    .debug-panel .log-info {
                        color: #90cdf4;
                    }
                </style>
            </head>

            <body>
                <div class="container"
                     id="evidencia-app"
                     t-att-data-token="token">

                    <div class="header">
                        <h1>📸 Evidencia Fotográfica</h1>
                        <div class="subtitle">Ticket <t t-out="ticket.name"/></div>
                    </div>

                    <div class="ticket-info">
                        <div class="info-row">
                            <span class="label">Cliente</span>
                            <span class="value">
                                <t t-out="ticket.partner_id.name or 'N/A'"/>
                            </span>
                        </div>

                        <div class="info-row">
                            <span class="label">Equipo</span>
                            <span class="value">
                                <t t-out="ticket.modelo_id_r or 'N/A'"/>
                            </span>
                        </div>

                        <div class="info-row">
                            <span class="label">Serie</span>
                            <span class="value">
                                <t t-out="ticket.serie_id_r or 'N/A'"/>
                            </span>
                        </div>

                        <div class="info-row">
                            <span class="label">Técnico</span>
                            <span class="value">
                                <t t-out="ticket.responsable.name or 'N/A'"/>
                            </span>
                        </div>
                    </div>

                    <div class="toggle-momento">
                        <button id="btn-antes" class="active" type="button" data-momento="antes">
                            📷 Antes (<span id="count-antes" t-out="len(fotos_antes)"/>)
                        </button>

                        <button id="btn-despues" type="button" data-momento="despues">
                            ✅ Después (<span id="count-despues" t-out="len(fotos_despues)"/>)
                        </button>
                    </div>

                    <div class="upload-section">
                        <div id="gps-status" class="gps-status">
                            ⏳ Iniciando GPS...
                        </div>

                        <button id="btn-tomar" type="button" class="btn-tomar-foto">
                            📸 Tomar / Subir foto con marca
                        </button>

                        <button id="btn-reintentar-gps" type="button" class="btn-reintentar" style="display:none">
                            🔄 Reintentar GPS
                        </button>

                        <div class="nota-marca">
                            La foto se guardará con fecha, hora, GPS, mini mapa y marca Andes Solution Copiers.
                        </div>

                        <input
                            type="file"
                            id="input-foto"
                            class="hidden-input"
                            accept="image/*"
                            capture="environment"
                        />
                    </div>

                    <div id="preview-section" class="preview-section">
                        <h3>Vista previa de la foto marcada</h3>
                        <img id="preview-img" alt="Vista previa"/>
                    </div>

                    <div class="galeria">
                        <h3 id="galeria-titulo">Fotos antes</h3>

                        <div id="grid-fotos" class="grid-fotos">
                            <t t-if="not fotos_antes and not fotos_despues">
                                <div class="empty-gallery" data-momento="antes">
                                    Aún no hay fotos subidas.
                                </div>
                            </t>

                            <t t-foreach="fotos_antes" t-as="foto">
                                <a
                                    t-att-href="'/evidencia/%s/foto/%s' % (token, foto.id)"
                                    target="_blank"
                                    class="foto-link"
                                    data-momento="antes"
                                >
                                    <img
                                        t-att-src="'/evidencia/%s/foto/%s' % (token, foto.id)"
                                        alt="Foto antes"
                                    />
                                </a>
                            </t>

                            <t t-foreach="fotos_despues" t-as="foto">
                                <a
                                    t-att-href="'/evidencia/%s/foto/%s' % (token, foto.id)"
                                    target="_blank"
                                    class="foto-link"
                                    data-momento="despues"
                                    style="display:none"
                                >
                                    <img
                                        t-att-src="'/evidencia/%s/foto/%s' % (token, foto.id)"
                                        alt="Foto después"
                                    />
                                </a>
                            </t>
                        </div>
                    </div>

                    <div id="debug-panel" class="debug-panel">
                        <div class="log-line log-ok">[debug] Esperando inicialización...</div>
                    </div>
                </div>

                <div id="progress" class="progress-overlay">
                    <div class="progress-box">
                        <div class="spinner"></div>
                        <div id="progress-text">Procesando foto...</div>
                    </div>
                </div>

                <div id="toast" class="toast"></div>

                <script type="text/javascript" src="/sat/static/src/js/evidencia_publicv1.js?v=20260505_1915"></script>
            </body>
        </html>
    </template>

    <!-- ════════════════════════════════════════════════════════════════
         Página: Token inválido
         ════════════════════════════════════════════════════════════════ -->
    <template id="evidencia_token_invalido" name="Token Inválido">
        <html lang="es">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title>Link inválido</title>

                <style>
                    body {
                        font-family: Arial, sans-serif;
                        background: #f5f5f5;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        min-height: 100vh;
                        margin: 0;
                        padding: 20px;
                    }

                    .box {
                        background: white;
                        padding: 30px;
                        border-radius: 10px;
                        text-align: center;
                        max-width: 400px;
                        box-shadow: 0 10px 24px rgba(0,0,0,0.08);
                    }

                    h1 {
                        color: #e53e3e;
                        font-size: 22px;
                        margin-bottom: 12px;
                    }

                    p {
                        color: #4a5568;
                        font-size: 14px;
                        line-height: 1.6;
                    }
                </style>
            </head>

            <body>
                <div class="box">
                    <h1>❌ Link inválido</h1>
                    <p>
                        Este link de evidencia no existe o ha sido modificado.<br/>
                        Por favor solicita un nuevo link.
                    </p>
                </div>
            </body>
        </html>
    </template>

    <!-- ════════════════════════════════════════════════════════════════
         Página: Ticket cerrado
         ════════════════════════════════════════════════════════════════ -->
    <template id="evidencia_ticket_cerrado" name="Ticket Cerrado">
        <html lang="es">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title>Ticket finalizado</title>

                <style>
                    body {
                        font-family: Arial, sans-serif;
                        background: #f5f5f5;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        min-height: 100vh;
                        margin: 0;
                        padding: 20px;
                    }

                    .box {
                        background: white;
                        padding: 30px;
                        border-radius: 10px;
                        text-align: center;
                        max-width: 400px;
                        box-shadow: 0 10px 24px rgba(0,0,0,0.08);
                    }

                    h1 {
                        color: #d69e2e;
                        font-size: 22px;
                        margin-bottom: 12px;
                    }

                    p {
                        color: #4a5568;
                        font-size: 14px;
                        line-height: 1.6;
                    }

                    .ticket {
                        background: #f7fafc;
                        padding: 12px;
                        border-radius: 7px;
                        margin-top: 14px;
                        font-size: 13px;
                    }
                </style>
            </head>

            <body>
                <div class="box">
                    <h1>🔒 Ticket finalizado</h1>
                    <p>Este ticket ya fue cerrado y no se aceptan más fotos de evidencia.</p>

                    <div class="ticket">
                        Ticket: <strong t-out="ticket.name"/><br/>
                        Cliente: <span t-out="ticket.partner_id.name or 'N/A'"/>
                    </div>
                </div>
            </body>
        </html>
    </template>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

       <data>
    
        <!-- List View for Reparaciones Foto -->
        <record id="view_reparacion_foto_tree" model="ir.ui.view">
            <field name="name">reparacion.foto.tree</field>
            <field name="model">reparaciones.foto</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="mimetype"/>
                    <field name="nombre_foto"/>
                    <field name="url_foto"/>
                    <field name="file_id"/>
                    <field name="public_link"/>
                    <field name="sequence"/>
                    <field name="state"/>
                    
                    <field name="reparacion_id"/>
                </list>
            </field>
        </record>
    
        <!-- Form View for Reparaciones Foto -->
        <record id="view_reparacion_foto_form" model="ir.ui.view">
            <field name="name">reparacion.foto.form</field>
            <field name="model">reparaciones.foto</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="nombre_foto"/>
                            <field name="url_foto"/>
                            <field name="reparacion_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
</data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- Action for Reparaciones Foto -->
        <record id="action_reparacion_foto" model="ir.actions.act_window">
            <field name="name">Fotos de Reparaciones</field>
            <field name="res_model">reparaciones.foto</field>
            <field name="view_mode">list,form</field>
            <field name="help">Gestión de fotos asociadas a las reparaciones.</field>
        </record>
    
        <!-- Menuitem for Reparaciones Foto -->
        <menuitem id="menu_reparacion_foto_action" 
                  name="Fotos de Reparaciones" 
                  parent="sat.ajustes" 
                  action="action_reparacion_foto"/>
    
        <!-- Vista de formulario -->
    <record id="view_reparacion_foto_form" model="ir.ui.view">
        <field name="name">reparaciones.foto.form</field>
        <field name="model">reparaciones.foto</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="share_photo" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-share-alt"
                                >
                            <field name="share_count" widget="statinfo" string="Compartido"/>
                        </button>
                        <button name="download_photo" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-download"
                                >
                            <field name="download_count" widget="statinfo" string="Descargas"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="nombre_foto"/>
                            <field name="sequence"/>
                            <field name="reparacion_id"/>
                            <field name="url_foto" widget="url"/>
                            <field name="public_link" widget="url"/>
                        </group>
                        <group>
                            <field name="mimetype"/>
                            <field name="size" widget="float_time"/>
                            <field name="file_id" groups="base.group_system"/>
                            <field name="unique_id" groups="base.group_system"/>
                            <field name="active" groups="base.group_system"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Previsualización" name="preview">
                            <div class="row">
                                <div class="col-md-12 text-center">
                                    <field name="foto_binario" 
                                           widget="image"
                                           class="oe_avatar"
                                           options="{'preview_image': 'foto_binario', 'size': [800, 800]}"
                                           />
                                    <img t-if="url_foto" t-att-src="url_foto" 
                                         style="max-width: 800px; max-height: 800px;"
                                         />
                                </div>
                            </div>
                        </page>
                        <page string="Seguimiento" name="tracking">
                            <field name="message_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vista de árbol -->
    <record id="view_reparacion_foto_tree" model="ir.ui.view">
        <field name="name">reparaciones.foto.tree</field>
        <field name="model">reparaciones.foto</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="reparacion_id"/>
                <field name="mimetype"/>
                <field name="size"/>
                <field name="share_count"/>
                <field name="download_count"/>
                <field name="state" decoration-success="state == 'done'" 
                                  decoration-info="state == 'uploading'"
                                  decoration-danger="state == 'error'"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Vista de búsqueda -->
    <record id="view_reparacion_foto_search" model="ir.ui.view">
        <field name="name">reparaciones.foto.search</field>
        <field name="model">reparaciones.foto</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="nombre_foto"/>
                <field name="reparacion_id"/>
                <field name="mimetype"/>
                <field name="state"/>
                <filter string="Archivos Activos" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archivos Inactivos" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Completados" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="En Error" name="error" domain="[('state', '=', 'error')]"/>
                <filter string="Subiendo" name="uploading" domain="[('state', '=', 'uploading')]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Reparación" name="reparacion" domain="[]" context="{'group_by': 'reparacion_id'}"/>
                    <filter string="Estado" name="state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Tipo" name="mimetype" domain="[]" context="{'group_by': 'mimetype'}"/>
                    <filter string="Mes" name="month" domain="[]" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="view_reparacion_foto_kanban" model="ir.ui.view">
        <field name="name">reparaciones.foto.kanban</field>
        <field name="model">reparaciones.foto</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="url_foto"/>
                <field name="state"/>
                <field name="mimetype"/>
                <field name="download_count"/>
                <field name="share_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-if="record.url_foto.value" 
                                     t-att-src="record.url_foto.value" 
                                     class="o_kanban_image"/>
                                <span t-else="" class="o_kanban_image o_kanban_image_fill_left">
                                    <i class="fa fa-picture-o fa-3x" role="img" aria-label="Foto"/>
                                </span>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="state" widget="label_selection" 
                                               options="{'classes': {'draft': 'default', 
                                                                   'uploading': 'info',
                                                                   'done': 'success', 
                                                                   'error': 'danger'}}"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span class="badge text-bg-info" t-if="record.download_count.raw_value > 0">
                                            <i class="fa fa-download"/> <t t-esc="record.download_count.value"/>
                                        </span>
                                        <span class="badge text-bg-success" t-if="record.share_count.raw_value > 0">
                                            <i class="fa fa-share-alt"/> <t t-esc="record.share_count.value"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>

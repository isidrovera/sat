<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
    <!-- Onboarding Step -->
    <record id="alquiler_onboarding_sample_step" model="onboarding.onboarding.step">
        <field name="title">Nueva Máquina de Alquiler</field>
        <field name="description">Registrar una nueva máquina para alquiler</field>
        <field name="button_text">Crear</field>
        <field name="panel_step_open_action_name">action_open_alquiler_onboarding_sample</field>
    </record>

    <!-- Onboarding Panel -->
    <record id="onboarding_onboarding_alquiler" model="onboarding.onboarding">
        <field name="name">Alquiler Onboarding</field>
        <field name="step_ids" eval="[(6, 0, [ref('alquiler_onboarding_sample_step')])]"/>
        <field name="route_name">alquiler</field>
        <field name="panel_close_action_name">action_close_panel_alquiler</field>
    </record>
    </data>
</odoo>
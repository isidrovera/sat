<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ===================================================== -->
        <!-- FORMULARIO DE MARCAS                                  -->
        <!-- ===================================================== -->

        <record id="Marcas_form_view" model="ir.ui.view">
            <field name="name">marca.marca.form</field>
            <field name="model">marca.marca</field>
            <field name="arch" type="xml">
                <form string="Marca de máquina">

                    <header>
                        <button
                            name="action_generate_external_id"
                            type="object"
                            string="Generar ID externo"
                            icon="fa-link"
                            class="btn-primary"
                            invisible="not id or external_id_state == 'generated'"
                        />
                    </header>

                    <sheet>

                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field
                                    name="name"
                                    placeholder="Ejemplo: Ricoh"
                                />
                            </h1>
                        </div>

                        <group>
                            <group string="Identificación">
                                <field name="name"/>
                                <field
                                    name="codigo_tecnico"
                                    placeholder="Ejemplo: ricoh"
                                />
                                <field name="active"/>
                            </group>

                            <group string="Referencia XML">
                                <field
                                    name="external_id_state"
                                    widget="badge"
                                    readonly="1"
                                    decoration-success="external_id_state == 'generated'"
                                    decoration-warning="external_id_state == 'pending'"
                                    decoration-danger="external_id_state == 'conflict'"
                                />

                                <field
                                    name="external_id_display"
                                    readonly="1"
                                    placeholder="Pendiente de generar"
                                />

                                <field
                                    name="external_id_generated_date"
                                    readonly="1"
                                    invisible="not external_id_generated_date"
                                />

                                <field
                                    name="external_id_generated_by"
                                    readonly="1"
                                    invisible="not external_id_generated_by"
                                />
                            </group>
                        </group>

                        <div
                            class="alert alert-info"
                            invisible="external_id_state == 'generated'"
                        >
                            <strong>ID externo pendiente.</strong>
                            Guarde la marca y utilice el botón
                            <strong>Generar ID externo</strong>.
                        </div>

                        <div
                            class="alert alert-success"
                            invisible="external_id_state != 'generated'"
                        >
                            Esta marca ya cuenta con un ID externo y puede
                            utilizarse como referencia desde archivos XML.
                        </div>

                        <div
                            class="alert alert-danger"
                            invisible="external_id_state != 'conflict'"
                        >
                            Existe un conflicto con el ID externo propuesto.
                            Revise el código técnico antes de continuar.
                        </div>

                    </sheet>

               

                </form>
            </field>
        </record>

        <!-- ===================================================== -->
        <!-- LISTA DE MARCAS                                       -->
        <!-- ===================================================== -->

        <record id="Marcas_tree_view" model="ir.ui.view">
            <field name="name">marca.marca.list</field>
            <field name="model">marca.marca</field>
            <field name="arch" type="xml">
                <list string="Marcas de máquinas">

                    <field name="name"/>

                    <field
                        name="codigo_tecnico"
                        optional="show"
                    />

                    <field
                        name="external_id_display"
                        string="ID externo"
                        optional="show"
                    />

                    <field
                        name="external_id_state"
                        string="Estado ID"
                        widget="badge"
                        optional="show"
                        decoration-success="external_id_state == 'generated'"
                        decoration-warning="external_id_state == 'pending'"
                        decoration-danger="external_id_state == 'conflict'"
                    />

                    <field
                        name="active"
                        optional="hide"
                    />

                    <button
                        name="action_generate_external_id"
                        type="object"
                        title="Generar ID externo"
                        icon="fa-link"
                        invisible="external_id_state == 'generated'"
                    />

                </list>
            </field>
        </record>

        <!-- ===================================================== -->
        <!-- BÚSQUEDA DE MARCAS                                    -->
        <!-- ===================================================== -->

        <record id="Marcas_search_view" model="ir.ui.view">
            <field name="name">marca.marca.search</field>
            <field name="model">marca.marca</field>
            <field name="arch" type="xml">
                <search string="Buscar marcas">

                    <field name="name"/>
                    <field name="codigo_tecnico"/>

                    <separator/>

                    <filter
                        name="marcas_activas"
                        string="Activas"
                        domain="[('active', '=', True)]"
                    />

                    <filter
                        name="marcas_archivadas"
                        string="Archivadas"
                        domain="[('active', '=', False)]"
                    />

                    <filter
                        name="sin_codigo_tecnico"
                        string="Sin código técnico"
                        domain="[
                            '|',
                            ('codigo_tecnico', '=', False),
                            ('codigo_tecnico', '=', '')
                        ]"
                    />

                </search>
            </field>
        </record>

        <!-- ===================================================== -->
        <!-- ACCIÓN MASIVA                                         -->
        <!-- ===================================================== -->

        <record
            id="server_action_generate_brand_external_ids"
            model="ir.actions.server"
        >
            <field name="name">Generar IDs externos</field>
            <field name="model_id" ref="model_marca_marca"/>
            <field name="binding_model_id" ref="model_marca_marca"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
action = records.action_generate_external_id()
            </field>
        </record>

    </data>
</odoo>
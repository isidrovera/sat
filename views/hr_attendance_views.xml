<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vista de lista extendida para mostrar información de ubicación -->
    <record id="view_attendance_tree_inherit_sat" model="ir.ui.view">
        <field name="name">hr.attendance.list.inherit.sat</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="tiene_ubicacion_entrada" string="Ub. Entrada" optional="hide"/>
                <field name="tiene_ubicacion_salida" string="Ub. Salida" optional="hide"/>
                <field name="resumen_ubicacion_entrada" optional="hide"/>
                <field name="resumen_ubicacion_salida" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Vista de formulario extendida para mostrar mapas -->
    <record id="view_attendance_form_inherit_sat" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit.sat</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <!-- Agregar información de ubicación en la sección de Check In -->
            <xpath expr="//div[@name='in_location_info']" position="after">
                <div class="o_row" name="sat_location_summary_in">
                    <field name="tiene_ubicacion_entrada" invisible="1"/>
                    <field name="resumen_ubicacion_entrada" readonly="1" invisible="not tiene_ubicacion_entrada"/>
                    <button name="action_abrir_mapa_entrada" 
                            string="Ver Mapa Detallado" 
                            type="object" 
                            class="btn btn-sm btn-outline-success"
                            invisible="not tiene_ubicacion_entrada"/>
                </div>
            </xpath>

            <!-- Agregar información de ubicación en la sección de Check Out -->
            <xpath expr="//div[@name='out_location_info']" position="after">
                <div class="o_row" name="sat_location_summary_out">
                    <field name="tiene_ubicacion_salida" invisible="1"/>
                    <field name="resumen_ubicacion_salida" readonly="1" invisible="not tiene_ubicacion_salida"/>
                    <button name="action_abrir_mapa_salida" 
                            string="Ver Mapa Detallado" 
                            type="object" 
                            class="btn btn-sm btn-outline-danger"
                            invisible="not tiene_ubicacion_salida"/>
                </div>
            </xpath>

            <!-- Agregar notebook con mapas después del chatter -->
            <xpath expr="//chatter" position="before">
                <notebook>
                    <!-- Página de Mapas de Ubicación -->
                    <page string="Mapas de Ubicación" name="location_maps">
                        <group>
                            <group string="Mapa de Entrada" name="check_in_map">
                                <field name="mapa_entrada_html" widget="html" nolabel="1"/>
                            </group>
                            <group string="Mapa de Salida" name="check_out_map">
                                <field name="mapa_salida_html" widget="html" nolabel="1"/>
                            </group>
                        </group>
                    </page>
                    
                    <!-- Página de Detalles Técnicos -->
                    <page string="Información Técnica" name="technical_info">
                        <group>
                            <group string="Datos Técnicos de Entrada">
                                <field name="in_latitude" readonly="1"/>
                                <field name="in_longitude" readonly="1"/>
                                <field name="url_mapa_entrada" readonly="1" widget="url"/>
                                <field name="mapa_estatico_entrada" readonly="1" widget="url"/>
                            </group>
                            <group string="Datos Técnicos de Salida">
                                <field name="out_latitude" readonly="1"/>
                                <field name="out_longitude" readonly="1"/>
                                <field name="url_mapa_salida" readonly="1" widget="url"/>
                                <field name="mapa_estatico_salida" readonly="1" widget="url"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- Vista kanban mejorada para mostrar información de ubicación -->
    <record id="view_attendance_kanban_inherit_sat" model="ir.ui.view">
        <field name="name">hr.attendance.kanban.inherit.sat</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_hr_attendance_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="tiene_ubicacion_entrada"/>
                <field name="tiene_ubicacion_salida"/>
                <field name="resumen_ubicacion_entrada"/>
                <field name="resumen_ubicacion_salida"/>
                <field name="url_mapa_entrada"/>
                <field name="url_mapa_salida"/>
            </xpath>
            
            <xpath expr="//div" position="after">
                <!-- Indicadores de ubicación -->
                <div class="mt-2">
                    <div class="row">
                        <div class="col-6">
                            <small class="text-muted">Entrada:</small>
                            <div t-if="record.tiene_ubicacion_entrada.raw_value">
                                <i class="fa fa-map-marker text-success me-1" title="Con ubicación GPS"/>
                                <small class="text-truncate d-block" t-esc="record.resumen_ubicacion_entrada.value"/>
                                <a t-att-href="record.url_mapa_entrada.value" 
                                   target="_blank" 
                                   class="btn btn-sm btn-outline-success mt-1">
                                    <i class="fa fa-external-link"/> Ver Mapa
                                </a>
                            </div>
                            <div t-else="">
                                <i class="fa fa-map-marker text-muted me-1" title="Sin ubicación"/>
                                <small class="text-muted">Sin ubicación</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Salida:</small>
                            <div t-if="record.check_out.value">
                                <div t-if="record.tiene_ubicacion_salida.raw_value">
                                    <i class="fa fa-map-marker text-danger me-1" title="Con ubicación GPS"/>
                                    <small class="text-truncate d-block" t-esc="record.resumen_ubicacion_salida.value"/>
                                    <a t-att-href="record.url_mapa_salida.value" 
                                       target="_blank" 
                                       class="btn btn-sm btn-outline-danger mt-1">
                                        <i class="fa fa-external-link"/> Ver Mapa
                                    </a>
                                </div>
                                <div t-else="">
                                    <i class="fa fa-map-marker text-muted me-1" title="Sin ubicación"/>
                                    <small class="text-muted">Sin ubicación</small>
                                </div>
                            </div>
                            <div t-else="">
                                <small class="text-muted">No registrada</small>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Vista de búsqueda extendida para filtrar por ubicación -->
    <record id="view_attendance_search_inherit_sat" model="ir.ui.view">
        <field name="name">hr.attendance.search.inherit.sat</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='auto_check']" position="after">
                <separator/>
                <filter string="Con Ubicación de Entrada" name="with_check_in_location" 
                        domain="[('tiene_ubicacion_entrada', '=', True)]"/>
                <filter string="Con Ubicación de Salida" name="with_check_out_location" 
                        domain="[('tiene_ubicacion_salida', '=', True)]"/>
                <filter string="Sin Ubicación" name="without_location" 
                        domain="['&amp;', ('tiene_ubicacion_entrada', '=', False), ('tiene_ubicacion_salida', '=', False)]"/>
            </xpath>
            
            <xpath expr="//field[@name='check_in']" position="after">
                <field name="resumen_ubicacion_entrada"/>
                <field name="resumen_ubicacion_salida"/>
                <field name="in_city"/>
                <field name="out_city"/>
                <field name="in_country_name"/>
                <field name="out_country_name"/>
            </xpath>
        </field>
    </record>

    <!-- Acción para vista especializada de ubicaciones -->
    <record id="action_attendance_location_view" model="ir.actions.act_window">
        <field name="name">Asistencias con Ubicación</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_attendance_search_inherit_sat"/>
        <field name="context">
            {
                "search_default_with_check_in_location": 1,
                "search_default_groupby_name": 1,
                "search_default_employee": 2
            }
        </field>
        <field name="domain">[('tiene_ubicacion_entrada', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No se encontraron asistencias con ubicación
            </p>
            <p>
                Aquí se mostrarán las asistencias que tienen datos de ubicación GPS registrados.
                Las ubicaciones se capturan automáticamente cuando los empleados marcan entrada o salida
                desde dispositivos móviles o kioscos configurados.
            </p>
        </field>
    </record>

    <!-- Menú para acceder a la vista de ubicaciones -->
    <menuitem id="menu_attendance_locations" 
              name="Ubicaciones GPS" 
              parent="hr_attendance.menu_hr_attendance_root" 
              sequence="16" 
              action="action_attendance_location_view"
              groups="hr_attendance.group_hr_attendance_officer"/>

</odoo>
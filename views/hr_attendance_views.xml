<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agregar campos GPS a la vista de lista de asistencias -->
    <record id="view_attendance_tree_inherit_gps" model="ir.ui.view">
        <field name="name">hr.attendance.list.inherit.gps</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='out_country_name']" position="after">
                <field name="location_source" string="Location Source" optional="hidden" widget="badge" 
                       decoration-success="location_source == 'gps'" 
                       decoration-info="location_source == 'geoip'" 
                       decoration-muted="location_source == 'manual'"/>
                <field name="gps_accuracy" string="GPS Accuracy (m)" optional="hidden"/>
                <field name="gps_timestamp" string="GPS Time" optional="hidden"/>
            </xpath>
        </field>
    </record>

    <!-- Agregar campos GPS a la vista de formulario de asistencias -->
    <record id="hr_attendance_view_form_inherit_gps" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit.gps</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <!-- Agregar información GPS en la sección Check In -->
            <xpath expr="//group[@name='check_in_group']//group[2]" position="inside">
                <separator string="GPS Information" invisible="location_source != 'gps'"/>
                <group invisible="location_source != 'gps'">
                    <field name="location_source" invisible="1"/>
                    <field name="gps_accuracy" string="GPS Accuracy" widget="float" 
                           invisible="location_source != 'gps'"/>
                    <field name="gps_timestamp" string="GPS Captured At" 
                           invisible="location_source != 'gps'"/>
                </group>
            </xpath>

            <!-- Agregar badge de fuente de ubicación -->
            <xpath expr="//field[@name='in_mode']" position="after">
                <field name="location_source" widget="badge" 
                       decoration-success="location_source == 'gps'" 
                       decoration-info="location_source == 'geoip'" 
                       decoration-muted="location_source == 'manual'"/>
            </xpath>
        </field>
    </record>

    <!-- Agregar filtros de búsqueda para GPS -->
    <record id="hr_attendance_view_filter_inherit_gps" model="ir.ui.view">
        <field name="name">hr_attendance_view_filter_inherit_gps</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='auto_check']" position="after">
                <separator/>
                <filter string="GPS Location" name="gps_location" 
                        domain="[('location_source', '=', 'gps')]"/>
                <filter string="IP Location" name="ip_location" 
                        domain="[('location_source', '=', 'geoip')]"/>
                <filter string="Manual Location" name="manual_location" 
                        domain="[('location_source', '=', 'manual')]"/>
                <filter string="High GPS Accuracy" name="high_gps_accuracy" 
                        domain="[('gps_accuracy', '&lt;=', 50), ('location_source', '=', 'gps')]"/>
            </xpath>
            <xpath expr="//group[@expand='0']" position="inside">
                <filter string="Location Source" name="groupby_location_source" 
                        context="{'group_by': 'location_source'}"/>
            </xpath>
        </field>
    </record>

    <!-- Vista específica para análisis de ubicaciones GPS -->
    <record id="view_attendance_gps_analysis_tree" model="ir.ui.view">
        <field name="name">hr.attendance.gps.analysis.list</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <list string="GPS Location Analysis" create="false" edit="false">
                <field name="employee_id" widget="many2one_avatar_user"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="location_source" widget="badge" 
                       decoration-success="location_source == 'gps'" 
                       decoration-info="location_source == 'geoip'" 
                       decoration-muted="location_source == 'manual'"/>
                <field name="in_latitude" string="Latitude"/>
                <field name="in_longitude" string="Longitude"/>
                <field name="gps_accuracy" string="Accuracy (m)"/>
                <field name="in_city" string="City"/>
                <field name="in_country_name" string="Country"/>
                <field name="gps_timestamp" string="GPS Time"/>
            </list>
        </field>
    </record>

    <!-- Acción para análisis de ubicaciones GPS -->
    <record id="hr_attendance_gps_analysis_action" model="ir.actions.act_window">
        <field name="name">GPS Location Analysis</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_attendance_gps_analysis_tree"/>
        <field name="domain">[('location_source', '=', 'gps')]</field>
        <field name="context">
            {
                "search_default_groupby_name": 1,
                "search_default_employee": 2,
                "search_default_gps_location": 1
            }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No GPS attendance records found
            </p><p>
                GPS location data from attendance records will be displayed here.
                This helps analyze location accuracy and patterns.
            </p>
        </field>
    </record>

    <!-- Menú para análisis GPS -->
    <menuitem id="menu_hr_attendance_gps_analysis" 
              name="GPS Analysis" 
              action="hr_attendance_gps_analysis_action" 
              parent="hr_attendance.menu_hr_attendance_root" 
              sequence="20" 
              groups="hr_attendance.group_hr_attendance_manager"/>
</odoo>
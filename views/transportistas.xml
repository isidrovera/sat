<odoo>
    <data>
        <template id="location_change_success" name="Location Change Success">
            <t t-call="website.layout">
                <div class="container">
                    <div class="alert alert-success mt-3" role="alert">
                        Ubicación cambiada con éxito. Esta ventana se cerrará automáticamente.
                    </div>
                </div>
                <script type="text/javascript">
                    setTimeout(function() {
                        window.close();
                    }, 3000); // 3000 milisegundos = 3 segundos
                </script>
            </t>
        </template>
    </data>
</odoo>

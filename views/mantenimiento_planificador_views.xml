<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================================= -->
        <!-- PLANIFICADOR - LISTA                                      -->
        <!-- ========================================================= -->
        <record id="view_mantenimiento_planificador_list" model="ir.ui.view">
            <field name="name">mantenimiento.planificador.list</field>
            <field name="model">mantenimiento.planificador</field>
            <field name="arch" type="xml">
                <list string="Planificadores de mantenimiento"
                      decoration-info="estado == 'borrador'"
                      decoration-primary="estado == 'generado'"
                      decoration-warning="estado == 'en_proceso'"
                      decoration-success="estado == 'finalizado'"
                      decoration-muted="estado == 'cancelado'">
                    <field name="name"/>
                    <field name="fecha_inicio"/>
                    <field name="fecha_fin"/>
                    <field name="estado"/>
                    <field name="total_maquinas"/>
                    <field name="total_pendientes"/>
                    <field name="total_confirmadas"/>
                    <field name="total_programadas"/>
                    <field name="total_sin_cupo"/>
                    <field name="total_reasignar"/>
                </list>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- PLANIFICADOR - FORM                                       -->
        <!-- ========================================================= -->
        <record id="view_mantenimiento_planificador_form" model="ir.ui.view">
            <field name="name">mantenimiento.planificador.form</field>
            <field name="model">mantenimiento.planificador</field>
            <field name="arch" type="xml">
                <form string="Planificador inteligente">
                    <header>
                        <button name="action_generar_lineas"
                                string="Generar líneas"
                                type="object"
                                class="btn-primary"
                                invisible="estado not in ('borrador', 'generado')"/>

                        <button name="action_auto_asignar"
                                string="Auto-asignar"
                                type="object"
                                class="btn-success"
                                invisible="estado not in ('generado', 'en_proceso')"/>

                        <button name="action_ver_lineas_sin_cupo"
                                string="Ver sin cupo"
                                type="object"
                                class="btn-secondary"
                                invisible="total_sin_cupo == 0"/>

                        <button name="action_ver_lineas_reasignar"
                                string="Ver por reasignar"
                                type="object"
                                class="btn-secondary"
                                invisible="total_reasignar == 0"/>

                        <field name="estado"
                               widget="statusbar"
                               statusbar_visible="borrador,generado,en_proceso,finalizado"/>
                    </header>

                    <sheet>

                        <div class="oe_button_box" name="button_box">
                            <button name="action_ver_lineas_sin_cupo"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-exclamation-triangle"
                                    invisible="total_sin_cupo == 0">
                                <field name="total_sin_cupo"
                                       widget="statinfo"
                                       string="Sin cupo"/>
                            </button>

                            <button name="action_ver_lineas_reasignar"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-refresh"
                                    invisible="total_reasignar == 0">
                                <field name="total_reasignar"
                                       widget="statinfo"
                                       string="Reasignar"/>
                            </button>
                        </div>

                        <widget name="web_ribbon"
                                title="Borrador"
                                bg_color="text-bg-secondary"
                                invisible="estado != 'borrador'"/>

                        <widget name="web_ribbon"
                                title="En proceso"
                                bg_color="text-bg-warning"
                                invisible="estado != 'en_proceso'"/>

                        <widget name="web_ribbon"
                                title="Finalizado"
                                bg_color="text-bg-success"
                                invisible="estado != 'finalizado'"/>

                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Periodo">
                                <field name="fecha_inicio"/>
                                <field name="fecha_fin"/>
                            </group>

                            <group string="Alcance">
                                <field name="tecnico_ids" widget="many2many_tags"/>
                                <field name="zona_ids" widget="many2many_tags"/>
                            </group>
                        </group>

                        <group string="Resumen inteligente">
                            <field name="resumen_html" nolabel="1" readonly="1"/>
                        </group>

                        <notebook>

                            <page string="Planificación">
                                <field name="line_ids">
                                    <list editable="bottom"
                                          decoration-info="estado == 'confirmado'"
                                          decoration-success="estado in ('programado', 'ticket_creado')"
                                          decoration-danger="estado == 'sin_cupo'"
                                          decoration-warning="estado == 'reasignar'"
                                          decoration-muted="estado == 'cancelado'">
                                        <field name="estado"/>
                                        <field name="equipo_id"/>
                                        <field name="cliente_id"/>
                                        <field name="distrito"/>
                                        <field name="zona_id"/>
                                        <field name="fecha_ideal"/>
                                        <field name="fecha_confirmada"/>
                                        <field name="hora_confirmada" widget="float_time"/>
                                        <field name="fecha_programada"/>
                                        <field name="hora_inicio" widget="float_time"/>
                                        <field name="hora_fin" widget="float_time"/>
                                        <field name="tecnico_id"/>
                                        <field name="tecnico_apoyo_ids" widget="many2many_tags"/>
                                        <field name="cantidad_tecnicos"/>
                                        <field name="duracion_horas"/>
                                        <field name="ignorar_zona"/>
                                        <field name="ticket_id"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Pendientes">
                                <field name="line_ids"
                                       domain="[('estado', 'in', ['pendiente', 'confirmado'])]">
                                    <list>
                                        <field name="estado"/>
                                        <field name="equipo_id"/>
                                        <field name="cliente_id"/>
                                        <field name="distrito"/>
                                        <field name="zona_id"/>
                                        <field name="fecha_ideal"/>
                                        <field name="fecha_confirmada"/>
                                        <field name="hora_confirmada" widget="float_time"/>
                                        <field name="cantidad_tecnicos"/>
                                        <field name="duracion_horas"/>
                                        <field name="ignorar_zona"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Programadas">
                                <field name="line_ids"
                                       domain="[('estado', 'in', ['programado', 'ticket_creado'])]">
                                    <list>
                                        <field name="estado"/>
                                        <field name="fecha_programada"/>
                                        <field name="hora_inicio" widget="float_time"/>
                                        <field name="hora_fin" widget="float_time"/>
                                        <field name="tecnico_id"/>
                                        <field name="tecnico_apoyo_ids" widget="many2many_tags"/>
                                        <field name="equipo_id"/>
                                        <field name="cliente_id"/>
                                        <field name="zona_id"/>
                                        <field name="ticket_id"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Sin cupo / Reasignar">
                                <field name="line_ids"
                                       domain="[('estado', 'in', ['sin_cupo', 'reasignar'])]">
                                    <list decoration-danger="estado == 'sin_cupo'"
                                          decoration-warning="estado == 'reasignar'">
                                        <field name="estado"/>
                                        <field name="equipo_id"/>
                                        <field name="cliente_id"/>
                                        <field name="distrito"/>
                                        <field name="zona_id"/>
                                        <field name="fecha_ideal"/>
                                        <field name="fecha_confirmada"/>
                                        <field name="hora_confirmada" widget="float_time"/>
                                        <field name="cantidad_tecnicos"/>
                                        <field name="duracion_horas"/>
                                        <field name="ignorar_zona"/>
                                        <field name="nota"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Observaciones">
                                <field name="observacion"
                                       nolabel="1"
                                       placeholder="Notas internas de esta planificación mensual..."/>
                            </page>

                        </notebook>

                    </sheet>

                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- PLANIFICADOR - KANBAN MODERNO                             -->
        <!-- ========================================================= -->
        <record id="view_mantenimiento_planificador_kanban" model="ir.ui.view">
            <field name="name">mantenimiento.planificador.kanban</field>
            <field name="model">mantenimiento.planificador</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile"
                        default_group_by="estado">
                    <field name="name"/>
                    <field name="fecha_inicio"/>
                    <field name="fecha_fin"/>
                    <field name="estado"/>
                    <field name="total_maquinas"/>
                    <field name="total_pendientes"/>
                    <field name="total_confirmadas"/>
                    <field name="total_programadas"/>
                    <field name="total_sin_cupo"/>
                    <field name="total_reasignar"/>

                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click o_kanban_record">

                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <strong class="fs-5">
                                            <field name="name"/>
                                        </strong>
                                        <div class="text-muted small">
                                            <field name="fecha_inicio"/>
                                            -
                                            <field name="fecha_fin"/>
                                        </div>
                                    </div>

                                    <field name="estado" widget="badge"/>
                                </div>

                                <div class="row g-2">
                                    <div class="col-4">
                                        <div class="border rounded p-2 text-center">
                                            <div class="fw-bold fs-5">
                                                <field name="total_maquinas"/>
                                            </div>
                                            <div class="text-muted small">Máquinas</div>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="border rounded p-2 text-center">
                                            <div class="fw-bold fs-5">
                                                <field name="total_programadas"/>
                                            </div>
                                            <div class="text-muted small">Programadas</div>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="border rounded p-2 text-center">
                                            <div class="fw-bold fs-5">
                                                <field name="total_pendientes"/>
                                            </div>
                                            <div class="text-muted small">Pendientes</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-2 mt-2">
                                    <div class="col-6">
                                        <div class="border rounded p-2 text-center bg-light">
                                            <div class="fw-bold">
                                                <field name="total_sin_cupo"/>
                                            </div>
                                            <div class="text-muted small">Sin cupo</div>
                                        </div>
                                    </div>

                                    <div class="col-6">
                                        <div class="border rounded p-2 text-center bg-light">
                                            <div class="fw-bold">
                                                <field name="total_reasignar"/>
                                            </div>
                                            <div class="text-muted small">Reasignar</div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- PLANIFICADOR - SEARCH                                     -->
        <!-- ========================================================= -->
        <record id="view_mantenimiento_planificador_search" model="ir.ui.view">
            <field name="name">mantenimiento.planificador.search</field>
            <field name="model">mantenimiento.planificador</field>
            <field name="arch" type="xml">
                <search string="Buscar planificadores">
                    <field name="name"/>
                    <field name="fecha_inicio"/>
                    <field name="fecha_fin"/>
                    <field name="estado"/>
                    <field name="tecnico_ids"/>
                    <field name="zona_ids"/>

                    <filter name="filter_borrador"
                            string="Borrador"
                            domain="[('estado', '=', 'borrador')]"/>

                    <filter name="filter_generado"
                            string="Generado"
                            domain="[('estado', '=', 'generado')]"/>

                    <filter name="filter_en_proceso"
                            string="En proceso"
                            domain="[('estado', '=', 'en_proceso')]"/>

                    <filter name="filter_activos"
                            string="Activos"
                            domain="[('estado', 'in', ['borrador', 'generado', 'en_proceso'])]"/>

                    <group expand="0" string="Agrupar por">
                        <filter name="group_estado"
                                string="Estado"
                                context="{'group_by': 'estado'}"/>
                        <filter name="group_fecha_inicio"
                                string="Fecha inicio"
                                context="{'group_by': 'fecha_inicio'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- LINEA PLANIFICADOR - LISTA                                -->
        <!-- ========================================================= -->
        <record id="view_mantenimiento_planificador_linea_list" model="ir.ui.view">
            <field name="name">mantenimiento.planificador.linea.list</field>
            <field name="model">mantenimiento.planificador.linea</field>
            <field name="arch" type="xml">
                <list string="Líneas de planificación"
                      decoration-info="estado == 'confirmado'"
                      decoration-success="estado in ('programado', 'ticket_creado')"
                      decoration-danger="estado == 'sin_cupo'"
                      decoration-warning="estado == 'reasignar'"
                      decoration-muted="estado == 'cancelado'">
                    <field name="estado"/>
                    <field name="planificador_id"/>
                    <field name="equipo_id"/>
                    <field name="cliente_id"/>
                    <field name="distrito"/>
                    <field name="zona_id"/>
                    <field name="fecha_ideal"/>
                    <field name="fecha_confirmada"/>
                    <field name="hora_confirmada" widget="float_time"/>
                    <field name="fecha_programada"/>
                    <field name="hora_inicio" widget="float_time"/>
                    <field name="hora_fin" widget="float_time"/>
                    <field name="tecnico_id"/>
                    <field name="tecnico_apoyo_ids" widget="many2many_tags"/>
                    <field name="cantidad_tecnicos"/>
                    <field name="duracion_horas"/>
                    <field name="ignorar_zona"/>
                    <field name="ticket_id"/>
                </list>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- LINEA PLANIFICADOR - FORM                                 -->
        <!-- ========================================================= -->
        <record id="view_mantenimiento_planificador_linea_form" model="ir.ui.view">
            <field name="name">mantenimiento.planificador.linea.form</field>
            <field name="model">mantenimiento.planificador.linea</field>
            <field name="arch" type="xml">
                <form string="Línea de planificación">
                    <header>
                        <button name="action_confirmar_cliente"
                                string="Cliente confirmó"
                                type="object"
                                class="btn-primary"
                                invisible="estado not in ('pendiente', 'sin_cupo')"/>

                        <button name="action_buscar_y_asignar_slot"
                                string="Buscar y asignar slot"
                                type="object"
                                class="btn-success"
                                invisible="estado not in ('pendiente', 'confirmado', 'sin_cupo', 'reasignar')"/>

                        <button name="action_crear_ticket"
                                string="Crear ticket"
                                type="object"
                                class="btn-primary"
                                invisible="estado != 'programado'"/>

                        <button name="action_ver_ticket"
                                string="Ver ticket"
                                type="object"
                                class="btn-secondary"
                                invisible="not ticket_id"/>

                        <button name="action_marcar_reasignar"
                                string="Marcar para reasignar"
                                type="object"
                                class="btn-secondary"
                                invisible="estado in ('reasignar', 'cancelado')"/>

                        <field name="estado"
                               widget="statusbar"
                               statusbar_visible="pendiente,confirmado,programado,ticket_creado"/>
                    </header>

                    <sheet>

                        <widget name="web_ribbon"
                                title="Sin cupo"
                                bg_color="text-bg-danger"
                                invisible="estado != 'sin_cupo'"/>

                        <widget name="web_ribbon"
                                title="Reasignar"
                                bg_color="text-bg-warning"
                                invisible="estado != 'reasignar'"/>

                        <widget name="web_ribbon"
                                title="Ticket creado"
                                bg_color="text-bg-success"
                                invisible="estado != 'ticket_creado'"/>

                        <div class="oe_title">
                            <label for="resumen"/>
                            <h1>
                                <field name="resumen" readonly="1"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Origen">
                                <field name="planificador_id"/>
                                <field name="equipo_id"/>
                                <field name="cliente_id"/>
                                <field name="distrito"/>
                                <field name="zona_id"/>
                            </group>

                            <group string="Configuración">
                                <field name="prioridad"/>
                                <field name="cantidad_tecnicos"/>
                                <field name="duracion_horas"/>
                                <field name="ignorar_zona"/>
                            </group>
                        </group>

                        <group>
                            <group string="Fecha ideal / confirmación">
                                <field name="fecha_ideal"/>
                                <field name="fecha_confirmada"/>
                                <field name="hora_confirmada" widget="float_time"/>
                            </group>

                            <group string="Programación real">
                                <field name="fecha_programada"/>
                                <field name="hora_inicio" widget="float_time"/>
                                <field name="hora_fin" widget="float_time"/>
                                <field name="tecnico_id"/>
                                <field name="tecnico_apoyo_ids" widget="many2many_tags"/>
                            </group>
                        </group>

                        <group string="Ticket">
                            <field name="ticket_id" readonly="1"/>
                        </group>

                        <group string="Notas">
                            <field name="nota"
                                   nolabel="1"
                                   placeholder="Motivo de sin cupo, comentario de reasignación o nota operativa..."/>
                        </group>

                    </sheet>

                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- LINEA PLANIFICADOR - KANBAN                               -->
        <!-- ========================================================= -->
        <record id="view_mantenimiento_planificador_linea_kanban" model="ir.ui.view">
            <field name="name">mantenimiento.planificador.linea.kanban</field>
            <field name="model">mantenimiento.planificador.linea</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile"
                        default_group_by="estado">
                    <field name="estado"/>
                    <field name="equipo_id"/>
                    <field name="cliente_id"/>
                    <field name="distrito"/>
                    <field name="zona_id"/>
                    <field name="fecha_ideal"/>
                    <field name="fecha_programada"/>
                    <field name="hora_inicio"/>
                    <field name="hora_fin"/>
                    <field name="tecnico_id"/>
                    <field name="ticket_id"/>
                    <field name="cantidad_tecnicos"/>

                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click o_kanban_record">

                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>
                                            <field name="equipo_id"/>
                                        </strong>
                                        <div class="text-muted small">
                                            <field name="cliente_id"/>
                                        </div>
                                    </div>

                                    <field name="estado" widget="badge"/>
                                </div>

                                <div class="mt-3">
                                    <div>
                                        📍
                                        <field name="distrito"/>
                                        <t t-if="record.zona_id.raw_value">
                                            · <field name="zona_id"/>
                                        </t>
                                    </div>

                                    <div>
                                        📅 Ideal:
                                        <field name="fecha_ideal"/>
                                    </div>

                                    <div t-if="record.fecha_programada.raw_value">
                                        🗓️ Programado:
                                        <field name="fecha_programada"/>
                                        ·
                                        <field name="hora_inicio" widget="float_time"/>
                                        -
                                        <field name="hora_fin" widget="float_time"/>
                                    </div>

                                    <div t-if="record.tecnico_id.raw_value">
                                        👷 Técnico:
                                        <field name="tecnico_id"/>
                                    </div>

                                    <div>
                                        👥 Técnicos requeridos:
                                        <field name="cantidad_tecnicos"/>
                                    </div>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- LINEA PLANIFICADOR - CALENDAR                             -->
        <!-- ========================================================= -->
        <record id="view_mantenimiento_planificador_linea_calendar" model="ir.ui.view">
            <field name="name">mantenimiento.planificador.linea.calendar</field>
            <field name="model">mantenimiento.planificador.linea</field>
            <field name="arch" type="xml">
                <calendar string="Calendario de planificación"
                          date_start="fecha_programada"
                          color="tecnico_id"
                          mode="week">
                    <field name="equipo_id"/>
                    <field name="cliente_id"/>
                    <field name="zona_id"/>
                    <field name="distrito"/>
                    <field name="tecnico_id"/>
                    <field name="estado"/>
                </calendar>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- LINEA PLANIFICADOR - SEARCH                               -->
        <!-- ========================================================= -->
        <record id="view_mantenimiento_planificador_linea_search" model="ir.ui.view">
            <field name="name">mantenimiento.planificador.linea.search</field>
            <field name="model">mantenimiento.planificador.linea</field>
            <field name="arch" type="xml">
                <search string="Buscar líneas de planificación">
                    <field name="planificador_id"/>
                    <field name="equipo_id"/>
                    <field name="cliente_id"/>
                    <field name="distrito"/>
                    <field name="zona_id"/>
                    <field name="tecnico_id"/>
                    <field name="estado"/>
                    <field name="fecha_ideal"/>
                    <field name="fecha_programada"/>

                    <filter name="filter_pendiente"
                            string="Pendientes"
                            domain="[('estado', '=', 'pendiente')]"/>

                    <filter name="filter_confirmado"
                            string="Confirmados"
                            domain="[('estado', '=', 'confirmado')]"/>

                    <filter name="filter_programado"
                            string="Programados"
                            domain="[('estado', '=', 'programado')]"/>

                    <filter name="filter_ticket_creado"
                            string="Ticket creado"
                            domain="[('estado', '=', 'ticket_creado')]"/>

                    <filter name="filter_sin_cupo"
                            string="Sin cupo"
                            domain="[('estado', '=', 'sin_cupo')]"/>

                    <filter name="filter_reasignar"
                            string="Reasignar"
                            domain="[('estado', '=', 'reasignar')]"/>

                    <filter name="filter_hoy"
                            string="Hoy"
                            domain="[('fecha_programada', '=', context_today())]"/>

                    <filter name="filter_esta_semana"
                            string="Esta semana"
                            domain="[('fecha_programada', '&gt;=', context_today())]"/>

                    <group expand="0" string="Agrupar por">
                        <filter name="group_estado"
                                string="Estado"
                                context="{'group_by': 'estado'}"/>
                        <filter name="group_zona"
                                string="Zona"
                                context="{'group_by': 'zona_id'}"/>
                        <filter name="group_distrito"
                                string="Distrito"
                                context="{'group_by': 'distrito'}"/>
                        <filter name="group_tecnico"
                                string="Técnico"
                                context="{'group_by': 'tecnico_id'}"/>
                        <filter name="group_fecha_programada"
                                string="Fecha programada"
                                context="{'group_by': 'fecha_programada'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ========================================================= -->
        <!-- ACCIONES                                                  -->
        <!-- ========================================================= -->

        <record id="action_mantenimiento_planificador" model="ir.actions.act_window">
            <field name="name">Planificador inteligente</field>
            <field name="res_model">mantenimiento.planificador</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_mantenimiento_planificador_search"/>
            <field name="context">{'search_default_filter_activos': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea tu planificación mensual de mantenimientos
                </p>
                <p>
                    Genera líneas desde máquinas alquiladas, asigna técnicos y crea tickets automáticamente.
                </p>
            </field>
        </record>

        <record id="action_mantenimiento_planificador_linea" model="ir.actions.act_window">
            <field name="name">Líneas de planificación</field>

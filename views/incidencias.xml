<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================================= -->
        <!-- FORMULARIO INCIDENCIAS -->
        <!-- ========================================================= -->
        <record id="view_incidencia_form" model="ir.ui.view">
            <field name="name">taller.incidencia.form</field>
            <field name="model">taller.incidencia</field>
            <field name="arch" type="xml">
                <form string="Incidencia de Taller">

                    <header>
                        <button name="action_recargar_reparacion"
                                type="object"
                                string="Recargar Datos"
                                class="btn-secondary"/>

                        <button name="action_enviar_revision"
                                type="object"
                                string="Enviar a Revisión"
                                class="btn-primary"
                                invisible="estado not in ['reportado', 'fuera_plazo']"/>

                        <button name="action_marcar_procede"
                                type="object"
                                string="Procede"
                                class="btn-success"
                                invisible="estado != 'en_revision'"/>

                        <button name="action_marcar_no_procede"
                                type="object"
                                string="No Procede"
                                class="btn-warning"
                                invisible="estado != 'en_revision'"/>

                        <button name="action_enviar_gerencia"
                                type="object"
                                string="Enviar a Gerencia"
                                class="btn-secondary"
                                invisible="estado in ['gerencia', 'cerrado']"/>

                        <button name="action_marcar_corregido"
                                type="object"
                                string="Marcar Corregido"
                                class="btn-primary"
                                invisible="estado != 'procede'"/>

                        <button name="action_cerrar"
                                type="object"
                                string="Cerrar"
                                class="btn-secondary"
                                invisible="estado not in ['procede', 'no_procede', 'corregido', 'gerencia', 'fuera_plazo']"/>

                        <button name="action_reabrir"
                                type="object"
                                string="Reabrir"
                                class="btn-secondary"
                                invisible="estado != 'cerrado'"/>

                        <button name="action_reenviar_correo_estado"
                                type="object"
                                string="Reenviar Correo"
                                class="btn-secondary"/>

                        <field name="estado"
                               widget="statusbar"
                               statusbar_visible="reportado,en_revision,fuera_plazo,gerencia,procede,no_procede,corregido,cerrado"/>
                    </header>

                    <sheet>

                        <div class="oe_button_box" name="button_box">
                            <button name="action_ver_equipo"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-print"
                                    invisible="not equipo_id">
                                <field name="equipo_id" widget="statinfo" string="Equipo"/>
                            </button>

                            <button name="action_ver_reparacion"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-wrench"
                                    invisible="not reparacion_id">
                                <field name="reparacion_id" widget="statinfo" string="Reparación"/>
                            </button>
                        </div>

                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="semaforo" readonly="1"/>
                                <field name="name" readonly="1"/>
                            </h1>
                            <h3>
                                <field name="resumen_estado" readonly="1"/>
                            </h3>
                        </div>

                        <group>
                            <group string="Alerta">
                                <field name="alerta_nivel" readonly="1"/>
                                <field name="alerta_titulo" readonly="1"/>
                                <field name="alerta_resumen" widget="html" readonly="1" nolabel="1"/>
                            </group>

                            <group string="Indicadores">
                                <field name="indicador_plazo" readonly="1"/>
                                <field name="indicador_impacto" readonly="1"/>
                                <field name="aplica_evaluacion" readonly="1"/>
                                <field name="evaluacion_periodo" readonly="1"/>
                            </group>
                        </group>

                        <group>
                            <group string="Datos del Reclamo">
                                <field name="fecha_hora"/>
                                <field name="tipo"/>
                                <field name="prioridad"/>
                                <field name="equipo_id"
                                       options="{'no_create': True, 'no_open': False}"
                                       placeholder="Buscar por serie/equipo"/>
                                <field name="serie" readonly="1"/>
                                <field name="modelo_equipo" readonly="1"/>
                                <field name="marca" readonly="1"/>
                            </group>

                            <group string="Cliente y Asesora">
                                <field name="cliente_id" readonly="1"/>
                                <field name="asesora_nombre" readonly="1"/>
                                <field name="factura_venta" readonly="1"/>
                                <field name="fecha_entrega"/>
                                <field name="fecha_limite_reclamo" readonly="1"/>
                            </group>
                        </group>

                        <group>
                            <group string="Control de Plazo">
                                <field name="plazo_maximo_dias"/>
                                <field name="dias_desde_entrega" readonly="1"/>
                                <field name="dentro_plazo" readonly="1"/>
                            </group>

                            <group string="Reparación Relacionada">
                                <field name="reparacion_id" readonly="1"/>
                                <field name="tecnico_nombre" readonly="1"/>
                               <!-- <field name="tecnico_id" readonly="1"/>
                                <field name="tecnico_empleado_id" readonly="1"/>-->
                                <field name="fecha_finalizacion_reparacion" readonly="1"/>
                                <field name="estado_reparacion" readonly="1"/>
                                <field name="calidad_reparacion" readonly="1"/>
                            </group>
                        </group>

                        <group>
                            <group string="Análisis del Reclamo">
                                <field name="tipo_reclamo"/>
                                <field name="responsable_determinado"/>
                                <field name="procede"/>
                                <field name="afecta_tecnico" readonly="1"/>
                            </group>

                            <group string="Revisión">
                                <field name="revisado_por_id" readonly="1"/>
                                <field name="fecha_revision" readonly="1"/>
                                <field name="fecha_resolucion" readonly="1"/>
                                <field name="cerrado_por_id" readonly="1"/>
                            </group>
                        </group>

                        <notebook>

                            <page string="Descripción del Reclamo">
                                <group>
                                    <field name="descripcion"
                                           placeholder="Detalle del reclamo reportado"/>
                                    <field name="comentarios_cliente"
                                           placeholder="Comentarios adicionales del cliente"/>
                                </group>
                            </page>

                            <page string="Informe Técnico">
                                <field name="informe_tecnico"
                                       widget="html"
                                       readonly="1"
                                       nolabel="1"/>
                            </page>

                            <page string="Observaciones de Reparación">
                                <field name="observaciones_reparacion"
                                       widget="html"
                                       readonly="1"
                                       nolabel="1"/>
                            </page>

                            <page string="Validación y Acciones">
                                <group>
                                    <field name="observacion_validacion"
                                           widget="html"
                                           placeholder="Sustento de la revisión técnica"/>
                                    <field name="motivo_no_afecta"
                                           widget="html"
                                           placeholder="Motivo por el cual no afecta al técnico"/>
                                    <field name="acciones"
                                           widget="html"
                                           placeholder="Acciones tomadas"/>
                                </group>
                            </page>

                            <page string="Evidencias">
                                <field name="evidencia_ids"
                                       widget="many2many_binary"/>
                            </page>

                            <page string="Correos">
                                <group>
                                    <group string="Correos Enviados">
                                        <field name="email_creacion_enviado" readonly="1"/>
                                        <field name="email_revision_enviado" readonly="1"/>
                                        <field name="email_procede_enviado" readonly="1"/>
                                        <field name="email_no_procede_enviado" readonly="1"/>
                                        <field name="email_gerencia_enviado" readonly="1"/>
                                        <field name="email_cierre_enviado" readonly="1"/>
                                    </group>

                                    <group string="Último Envío">
                                        <field name="ultimo_correo_fecha" readonly="1"/>
                                        <field name="ultimo_correo_template" readonly="1"/>
                                        <field name="correo_error" readonly="1"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Costos y Responsable Operativo">
                                <group>
                                    <field name="costos"/>
                                    <field name="empleado_id"/>
                                </group>
                            </page>

                        </notebook>

                    </sheet>

                    <chatter/>

                </form>
            </field>
        </record>


        <!-- ========================================================= -->
        <!-- LISTA INCIDENCIAS -->
        <!-- ========================================================= -->
        <record id="view_incidencia_tree" model="ir.ui.view">
            <field name="name">taller.incidencia.list</field>
            <field name="model">taller.incidencia</field>
            <field name="arch" type="xml">
                <list string="Incidencias de Taller"
                      decoration-danger="alerta_nivel == 'danger'"
                      decoration-warning="alerta_nivel == 'warning'"
                      decoration-success="alerta_nivel == 'ok'"
                      decoration-muted="estado == 'cerrado'">

                    <field name="semaforo"/>
                    <field name="name"/>
                    <field name="fecha_hora"/>
                    <field name="estado"/>
                    <field name="prioridad"/>
                    <field name="equipo_id"/>
                    <field name="serie"/>
                    <field name="modelo_equipo"/>
                    <field name="cliente_id"/>
                    <field name="asesora_nombre"/>
                    <field name="reparacion_id"/>
                    <field name="tecnico_nombre"/>
                    <field name="fecha_entrega"/>
                    <field name="dias_desde_entrega"/>
                    <field name="dentro_plazo"/>
                    <field name="tipo_reclamo"/>
                    <field name="responsable_determinado"/>
                    <field name="procede"/>
                    <field name="afecta_tecnico"/>
                    <field name="indicador_impacto"/>
                    <field name="resumen_estado"/>
                    <field name="aplica_evaluacion"/>
                    <field name="ultimo_correo_fecha"/>

                </list>
            </field>
        </record>


        <!-- ========================================================= -->
        <!-- KANBAN INCIDENCIAS -->
        <!-- ========================================================= -->
        <record id="view_incidencia_kanban" model="ir.ui.view">
            <field name="name">taller.incidencia.kanban</field>
            <field name="model">taller.incidencia</field>
            <field name="arch" type="xml">
                <kanban default_group_by="estado" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="semaforo"/>
                    <field name="estado"/>
                    <field name="alerta_titulo"/>
                    <field name="resumen_estado"/>
                    <field name="serie"/>
                    <field name="cliente_id"/>
                    <field name="asesora_nombre"/>
                    <field name="tecnico_nombre"/>
                    <field name="dias_desde_entrega"/>
                    <field name="afecta_tecnico"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card">
                                <div class="o_kanban_record_top">
                                    <strong>
                                        <field name="semaforo"/>
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div>
                                    <span>Serie: </span>
                                    <field name="serie"/>
                                </div>
                                <div>
                                    <span>Cliente: </span>
                                    <field name="cliente_id"/>
                                </div>
                                <div>
                                    <span>Asesora: </span>
                                    <field name="asesora_nombre"/>
                                </div>
                                <div>
                                    <span>Técnico: </span>
                                    <field name="tecnico_nombre"/>
                                </div>
                                <div>
                                    <span>Días entrega: </span>
                                    <field name="dias_desde_entrega"/>
                                </div>
                                <div>
                                    <field name="resumen_estado"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <!-- ========================================================= -->
        <!-- BÚSQUEDA INCIDENCIAS -->
        <!-- ========================================================= -->
        <record id="view_incidencia_search" model="ir.ui.view">
            <field name="name">taller.incidencia.search</field>
            <field name="model">taller.incidencia</field>
            <field name="arch" type="xml">
                <search string="Buscar Incidencias">

                    <field name="name"/>
                    <field name="equipo_id"/>
                    <field name="serie"/>
                    <field name="cliente_id"/>
                    <field name="asesora_nombre"/>
                    <field name="reparacion_id"/>
                    <field name="tecnico_nombre"/>
                    <field name="tipo_reclamo"/>
                    <field name="responsable_determinado"/>
                    <field name="estado"/>

                    <filter string="Reportadas"
                            name="filter_reportado"
                            domain="[('estado','=','reportado')]"/>

                    <filter string="En Revisión"
                            name="filter_en_revision"
                            domain="[('estado','=','en_revision')]"/>

                    <filter string="Fuera de Plazo"
                            name="filter_fuera_plazo"
                            domain="[('estado','=','fuera_plazo')]"/>

                    <filter string="Gerencia"
                            name="filter_gerencia"
                            domain="[('estado','=','gerencia')]"/>

                    <filter string="Procede"
                            name="filter_procede"
                            domain="[('procede','=','si')]"/>

                    <filter string="No Procede"
                            name="filter_no_procede"
                            domain="[('procede','=','no')]"/>

                    <filter string="Afecta Técnico"
                            name="filter_afecta_tecnico"
                            domain="[('afecta_tecnico','=',True)]"/>

                    <filter string="No Afecta Técnico"
                            name="filter_no_afecta_tecnico"
                            domain="[('afecta_tecnico','=',False)]"/>

                    <separator/>

                    <filter string="Dentro de Plazo"
                            name="filter_dentro_plazo"
                            domain="[('dentro_plazo','=',True)]"/>

                    <filter string="Fuera de 10 días"
                            name="filter_no_dentro_plazo"
                            domain="[('dentro_plazo','=',False)]"/>

                    <filter string="Aplica Evaluación"
                            name="filter_aplica_evaluacion"
                            domain="[('aplica_evaluacion','=',True)]"/>

                    <group expand="0" string="Agrupar por">
                        <filter string="Estado"
                                name="group_estado"
                                context="{'group_by':'estado'}"/>

                        <filter string="Técnico"
                                name="group_tecnico"
                                context="{'group_by':'tecnico_nombre'}"/>

                        <filter string="Cliente"
                                name="group_cliente"
                                context="{'group_by':'cliente_id'}"/>

                        <filter string="Asesora"
                                name="group_asesora"
                                context="{'group_by':'asesora_nombre'}"/>

                        <filter string="Tipo Reclamo"
                                name="group_tipo_reclamo"
                                context="{'group_by':'tipo_reclamo'}"/>

                        <filter string="Responsable"
                                name="group_responsable"
                                context="{'group_by':'responsable_determinado'}"/>

                        <filter string="Impacto"
                                name="group_impacto"
                                context="{'group_by':'indicador_impacto'}"/>

                        <filter string="Periodo Evaluación"
                                name="group_periodo"
                                context="{'group_by':'evaluacion_periodo'}"/>
                    </group>

                </search>
            </field>
        </record>


    </data>
</odoo>
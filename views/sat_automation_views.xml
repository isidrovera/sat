    <record id="view_sat_automation_audit_form" model="ir.ui.view">
      <field name="name">sat.automation.audit.form</field>
      <field name="model">sat.automation.audit</field>
      <field name="arch" type="xml">
        <form string="Auditoría de Automatización">
          <sheet>
            <group>
              <field name="event_id"/>
              <field name="level"/>

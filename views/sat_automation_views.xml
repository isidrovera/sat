          <field name="source"/>
          <field name="event_type"/>
          <field name="target_key"/>
          <field name="expected_value"/>
          <field name="extracted_value"/>
          <field name="result"/>
        </list>
      </field>
    </record>

    <record id="view_sat_automation_pattern_learning_form" model="ir.ui.view">
      <field name="name">sat.automation.pattern.learning.form</field>
      <field name="model">sat.automation.pattern.learning</field>
      <field name="arch" type="xml">
        <form string="Prueba de Aprendizaje">
          <sheet>
            <group>
              <group>
                <field name="event_id"/>
                <field name="pattern_id"/>
                <field name="source"/>
                <field name="event_type"/>
              </group>
              <group>
                <field name="target_key"/>

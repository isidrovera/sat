<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ============================================================ -->
    <!-- EVENTOS DE AUTOMATIZACIÓN                                    -->
    <!-- ============================================================ -->
    <record id="view_sat_automation_event_list" model="ir.ui.view">
      <field name="name">sat.automation.event.list</field>
      <field name="model">sat.automation.event</field>
      <field name="arch" type="xml">
        <list string="Eventos de Automatización"
              decoration-success="state == 'done'"
              decoration-warning="state == 'review'"
              decoration-danger="state == 'error'"
              decoration-muted="state in ('ignored','cancelled')">
          <field name="event_datetime" string="Fecha"/>
          <field name="source" string="Origen"/>
          <field name="event_type" string="Tipo"/>
          <field name="partner_id" string="Cliente" optional="show"/>
          <field name="equipment_id" string="Equipo" optional="show"/>
          <field name="serial_number" string="Serie" optional="show"/>
          <field name="classification_method" string="Método" optional="show"/>
          <field name="pattern_confidence" string="Conf. patrón" optional="hide"/>
          <field name="ai_used" string="IA" optional="show"/>
          <field name="ai_confidence" string="Conf. IA" optional="hide"/>
          <field name="action_type" string="Acción" optional="show"/>
          <field name="state" string="Estado"/>
        </list>
      </field>
    </record>

    <record id="view_sat_automation_event_form" model="ir.ui.view">
      <field name="name">sat.automation.event.form</field>
      <field name="model">sat.automation.event</field>
      <field name="arch" type="xml">
        <form string="Evento de Automatización">
          <header>
            <button name="action_retry" type="object" string="Reprocesar"
                    class="btn-primary"
                    invisible="state not in ('new','review','error')"/>
            <button name="action_ignore" type="object" string="Ignorar"
                    class="btn-secondary"
                    invisible="state in ('done','ignored','cancelled')"/>
            <button name="action_cancel" type="object" string="Cancelar"
                    invisible="state in ('done','cancelled')"/>
            <field name="state" widget="statusbar"
                   statusbar_visible="new,classified,processing,review,done,error"/>
          </header>
          <sheet>
            <div class="oe_title">
              <h1><field name="name" readonly="1"/></h1>
            </div>

            <group>
              <group string="Origen">
                <field name="event_uuid" readonly="1"/>
                <field name="source"/>
                <field name="source_subtype"/>
                <field name="event_datetime"/>
                <field name="source_model" readonly="1"/>
                <field name="source_record_id" readonly="1"/>
              </group>
              <group string="Clasificación">
                <field name="event_type"/>
                <field name="event_subtype"/>
                <field name="classification_method" readonly="1"/>
                <field name="requires_review" readonly="1"/>
                <field name="review_reason" readonly="1" invisible="not requires_review"/>
              </group>
            </group>

            <notebook>
              <page string="Datos">
                <group>
                  <group string="Equipo / Cliente">
                    <field name="partner_id"/>
                    <field name="contact_id"/>
                    <field name="equipment_id"/>
                    <field name="serial_number"/>
                  </group>
                  <group string="Contadores">
                    <field name="meter_bn"/>
                    <field name="meter_color"/>
                    <field name="meter_scan"/>
                    <field name="meter_total"/>
                  </group>
                </group>
                <group>
                  <group string="Suministro">
                    <field name="supply_type"/>
                    <field name="supply_color"/>
                    <field name="supply_percentage"/>
                    <field name="requested_quantity"/>
                  </group>
                  <group string="Incidencia">
                    <field name="error_code"/>
                    <field name="location_detected"/>
                    <field name="issue_description"/>
                  </group>
                </group>
              </page>

              <page string="Correo" invisible="source != 'email'">
                <group>
                  <field name="sender"/>
                  <field name="sender_domain" readonly="1"/>
                  <field name="subject"/>
                  <field name="email_message_id"/>
                </group>
                <field name="body_plain" readonly="1"/>
              </page>

              <page string="Patrones / IA">
                <group>
                  <group string="Patrones">
                    <field name="patterns_used" readonly="1"/>
                    <field name="pattern_confidence" readonly="1"/>
                  </group>
                  <group string="Inteligencia Artificial">
                    <field name="ai_used" readonly="1"/>
                    <field name="ai_provider_name" readonly="1"/>
                    <field name="ai_model_name" readonly="1"/>
                    <field name="ai_confidence" readonly="1"/>
                    <field name="ai_input_tokens" readonly="1"/>
                    <field name="ai_output_tokens" readonly="1"/>
                    <field name="ai_cost" readonly="1"/>
                  </group>
                </group>
                <field name="ai_raw_response" readonly="1" invisible="not ai_used"/>
              </page>

              <page string="Acción">
                <group>
                  <field name="action_type" readonly="1"/>
                  <field name="action_model" readonly="1"/>
                  <field name="action_record_id" readonly="1"/>
                  <field name="action_description" readonly="1"/>
                </group>
              </page>

              <page string="Diagnóstico">
                <group>
                  <field name="retry_count" readonly="1"/>
                  <field name="last_retry_at" readonly="1"/>
                  <field name="error_message" readonly="1"/>
                </group>
                <field name="error_traceback" readonly="1" invisible="not error_traceback"/>
                <field name="payload_json" readonly="1"/>
              </page>
            </notebook>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>

    <record id="view_sat_automation_event_search" model="ir.ui.view">
    <field name="name">sat.automation.event.search</field>
    <field name="model">sat.automation.event</field>
    <field name="arch" type="xml">
        <search string="Buscar Eventos">

            <!-- Campos de búsqueda -->
            <field name="name"/>
            <field name="serial_number"/>
            <field name="equipment_id"/>
            <field name="partner_id"/>
            <field name="sender"/>

            <separator/>

            <!-- Filtros -->
            <filter
                name="filter_review"
                string="Revisión"
                domain="[('state', '=', 'review')]"
            />

            <filter
                name="filter_error"
                string="Errores"
                domain="[('state', '=', 'error')]"
            />

            <filter
                name="filter_ai"
                string="Con IA"
                domain="[('ai_used', '=', True)]"
            />

            <filter
                name="filter_today"
                string="Hoy"
                domain="[('event_datetime', '&gt;=', context_today().strftime('%Y-%m-%d'))]"
            />

            <!-- Agrupaciones -->
            <group string="Agrupar por">

                <filter
                    name="group_by_state"
                    string="Estado"
                    context="{'group_by': 'state'}"
                />

                <filter
                    name="group_by_source"
                    string="Origen"
                    context="{'group_by': 'source'}"
                />

                <filter
                    name="group_by_event_type"
                    string="Tipo"
                    context="{'group_by': 'event_type'}"
                />

                <filter
                    name="group_by_partner"
                    string="Cliente"
                    context="{'group_by': 'partner_id'}"
                />

            </group>

        </search>
    </field>
</record>

    <!-- ============================================================ -->
    <!-- APRENDIZAJE                                                  -->
    <!-- ============================================================ -->
    <record id="view_sat_automation_pattern_learning_list" model="ir.ui.view">
      <field name="name">sat.automation.pattern.learning.list</field>

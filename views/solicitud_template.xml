<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Template de Éxito para Aprobación -->
        <template id="parts_request_approval_success">
            <t t-call="web.layout">  <!-- Cambiado de website.layout a web.layout -->
                <div class="container min-vh-100 d-flex align-items-center py-5">
                    <div class="row justify-content-center w-100">
                        <div class="col-md-6 col-lg-5 col-xl-4">
                            <div t-attf-class="card rounded-4 shadow-sm border-0" 
                                 style="animation: fadeInUp 0.6s ease;">
                                <div class="card-body p-4 text-center">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4" 
                                         style="width: 90px; height: 90px; background: linear-gradient(135deg, #28a745, #20c997);">
                                        <i class="fa fa-check fa-2x text-white"/>
                                    </div>
                                    <h2 class="fw-bold text-success mb-3">¡Solicitud Aprobada!</h2>
                                    <p class="text-muted mb-4">La solicitud de partes ha sido aprobada correctamente y se ha notificado a logística.</p>
                                    <div class="py-2 px-3 bg-light rounded-3 text-muted small">
                                        Esta ventana se cerrará automáticamente
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <style>
                    @keyframes fadeInUp {
                        from {
                            opacity: 0;
                            transform: translateY(20px);
                        }
                        to {
                            opacity: 1;
                            transform: translateY(0);
                        }
                    }
                </style>
                <script type="text/javascript">
                    setTimeout(function() {
                        window.close();
                    }, 10000);
                </script>
            </t>
        </template>

        <!-- Template de Éxito para Entrega -->
        <template id="parts_request_delivery_success">
            <t t-call="web.layout">  <!-- Cambiado de website.layout a web.layout -->
                <div class="container min-vh-100 d-flex align-items-center py-5">
                    <div class="row justify-content-center w-100">
                        <div class="col-md-6 col-lg-5 col-xl-4">
                            <div t-attf-class="card rounded-4 shadow-sm border-0" 
                                 style="animation: fadeInUp 0.6s ease;">
                                <div class="card-body p-4 text-center">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4" 
                                         style="width: 90px; height: 90px; background: linear-gradient(135deg, #28a745, #20c997);">
                                        <i class="fa fa-truck fa-2x text-white"/>
                                    </div>
                                    <h2 class="fw-bold text-success mb-3">¡Entrega Confirmada!</h2>
                                    <p class="text-muted mb-4">La entrega de las partes ha sido confirmada exitosamente.</p>
                                    <div class="py-2 px-3 bg-light rounded-3 text-muted small">
                                        Esta ventana se cerrará automáticamente
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <style>
                    @keyframes fadeInUp {
                        from {
                            opacity: 0;
                            transform: translateY(20px);
                        }
                        to {
                            opacity: 1;
                            transform: translateY(0);
                        }
                    }
                </style>
                <script type="text/javascript">
                    setTimeout(function() {
                        window.close();
                    }, 10000);
                </script>
            </t>
        </template>

        <!-- Template de Error -->
        <template id="parts_request_invalid">
            <t t-call="web.layout">  <!-- Cambiado de website.layout a web.layout -->
                <div class="container min-vh-100 d-flex align-items-center py-5">
                    <div class="row justify-content-center w-100">
                        <div class="col-md-6 col-lg-5 col-xl-4">
                            <div t-attf-class="card rounded-4 shadow-sm border-0" 
                                 style="animation: fadeInUp 0.6s ease;">
                                <div class="card-body p-4 text-center">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4" 
                                         style="width: 90px; height: 90px; background: linear-gradient(135deg, #dc3545, #ff6b6b);">
                                        <i class="fa fa-exclamation-triangle fa-2x text-white"/>
                                    </div>
                                    <h2 class="fw-bold text-danger mb-3">Solicitud Inválida</h2>
                                    <t t-if="error_message">
                                        <p class="text-muted mb-4"><t t-esc="error_message"/></p>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted mb-3">La solicitud no puede ser procesada. Esto puede deberse a que:</p>
                                        <ul class="list-unstyled text-muted small mb-4">
                                            <li class="mb-2">• La solicitud ya ha sido procesada</li>
                                            <li class="mb-2">• El enlace ha expirado</li>
                                            <li class="mb-2">• El enlace no es válido</li>
                                        </ul>
                                    </t>
                                    <p class="text-muted small mb-4">Por favor, contacte al administrador si el problema persiste.</p>
                                    <div class="py-2 px-3 bg-light rounded-3 text-muted small">
                                        Esta ventana se cerrará automáticamente
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <style>
                    @keyframes fadeInUp {
                        from {
                            opacity: 0;
                            transform: translateY(20px);
                        }
                        to {
                            opacity: 1;
                            transform: translateY(0);
                        }
                    }
                </style>
                <script type="text/javascript">
                    setTimeout(function() {
                        window.close();
                    }, 10000);
                </script>
            </t>
        </template>
    </data>
</odoo>
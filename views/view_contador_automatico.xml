<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========== VISTAS ========== -->
    
    <!-- Vista List (antes Tree) -->
    <record id="view_contador_automatico_list" model="ir.ui.view">
        <field name="name">contador.automatico.list</field>
        <field name="model">contador.automatico</field>
        <field name="arch" type="xml">
            <list string="Contadores Automáticos" 
                  decoration-success="estado=='procesado'" 
                  decoration-warning="estado=='manual'" 
                  decoration-danger="estado=='error'"
                  multi_edit="1">
                <field name="name"/>
                <field name="remitente"/>
                <field name="serie_detectada"/>
                <field name="equipo_id"/>
                <field name="contador_bn_detectado"/>
                <field name="contador_color_detectado"/>
                <field name="contador_scan_detectado"/>
                <field name="estado" widget="badge"/>
                <field name="fecha_procesamiento"/>
                <field name="procesado_automaticamente" widget="boolean"/>
            </list>
        </field>
    </record>
    
    <!-- Vista Form -->
    <record id="view_contador_automatico_form" model="ir.ui.view">
        <field name="name">contador.automatico.form</field>
        <field name="model">contador.automatico</field>
        <field name="arch" type="xml">
            <form string="Contador Automático">
                <header>
                    <field name="estado" widget="statusbar" statusbar_visible="pendiente,procesado,manual,error"/>
                    <button name="reprocesar_manualmente" type="object" string="Reprocesar"
                            class="btn-primary" invisible="estado == 'procesado'"/>
                    <button name="marcar_como_procesado_manual" type="object" string="Marcar como Procesado"
                            class="btn-success" invisible="estado == 'procesado'"/>
                    <button name="buscar_y_procesar_correos" type="object" 
                            string="📧 Buscar Correos" class="btn-primary"/>
                    <button name="actualizar_patrones_para_bizhub" string="🔧 Actualizar Patrones Bizhub" type="object" class="btn-primary"/>
<button name="probar_patrones_con_texto_real" string="🧪 Probar Patrones" type="object" class="btn-info"/>
                </header>
                <sheet>
                    <group>
                        <group name="correo_info">
                            <field name="name"/>
                            <field name="remitente"/>
                            <field name="fecha_procesamiento"/>
                            <field name="procesado_automaticamente"/>
                        </group>
                        <group name="deteccion_info">
                            <field name="serie_detectada"/>
                            <field name="equipo_id"/>
                            <field name="mensaje_error" invisible="not mensaje_error"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Contadores Detectados" name="contadores">
                            <group>
                                <group name="contadores_nuevos">
                                    <separator string="Contadores Detectados"/>
                                    <field name="contador_bn_detectado"/>
                                    <field name="contador_color_detectado"/>
                                    <field name="contador_scan_detectado"/>
                                </group>
                                <group name="contadores_anteriores">
                                    <separator string="Valores Anteriores del Equipo"/>
                                    <field name="contador_bn_anterior" readonly="1"/>
                                    <field name="contador_color_anterior" readonly="1"/>
                                    <field name="contador_scan_anterior" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Contenido Original" name="contenido_original">
                            <field name="contenido_original" widget="html" nolabel="1"/>
                        </page>
                        <page string="Contenido Procesado" name="contenido_procesado">
                            <field name="contenido_procesado" widget="text" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Vista Search -->
    <record id="view_contador_automatico_search" model="ir.ui.view">
        <field name="name">contador.automatico.search</field>
        <field name="model">contador.automatico</field>
        <field name="arch" type="xml">
            <search string="Buscar Contadores Automáticos">
                <field name="name" string="Asunto"/>
                <field name="remitente"/>
                <field name="serie_detectada"/>
                <field name="equipo_id"/>
                <separator/>
                <filter string="Pendientes" name="pendientes" domain="[('estado', '=', 'pendiente')]"/>
                <filter string="Procesados" name="procesados" domain="[('estado', '=', 'procesado')]"/>
                <filter string="Errores" name="errores" domain="[('estado', '=', 'error')]"/>
                <filter string="Manuales" name="manuales" domain="[('estado', '=', 'manual')]"/>
                <separator/>
                <filter string="Automáticos" name="automaticos" domain="[('procesado_automaticamente', '=', True)]"/>
                <filter string="Hoy" name="hoy" domain="[('fecha_procesamiento', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_estado" context="{'group_by': 'estado'}"/>
                    <filter string="Remitente" name="group_remitente" context="{'group_by': 'remitente'}"/>
                    <filter string="Fecha" name="group_fecha" context="{'group_by': 'fecha_procesamiento:day'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Vista Kanban CORREGIDA -->
    <record id="view_contador_automatico_kanban" model="ir.ui.view">
        <field name="name">contador.automatico.kanban</field>
        <field name="model">contador.automatico</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado" class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="remitente"/>
                <field name="serie_detectada"/>
                <field name="estado"/>
                <field name="fecha_procesamiento"/>
                <field name="equipo_id"/>
                <field name="contador_bn_detectado"/>
                <field name="contador_color_detectado"/>
                <field name="contador_scan_detectado"/>
                <field name="procesado_automaticamente"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <i class="fa fa-envelope-o"/> <field name="remitente"/>
                                </div>
                                <div t-if="record.serie_detectada.value" class="mt-2">
                                    <i class="fa fa-barcode"/> Serie: <field name="serie_detectada"/>
                                </div>
                                <div t-if="record.equipo_id.value" class="mt-1">
                                    <i class="fa fa-cog"/> <field name="equipo_id"/>
                                </div>
                                <div class="mt-2">
                                    <span t-if="record.contador_bn_detectado.value" class="badge badge-info me-1">
                                        BN: <field name="contador_bn_detectado"/>
                                    </span>
                                    <span t-if="record.contador_color_detectado.value" class="badge badge-warning me-1">
                                        Color: <field name="contador_color_detectado"/>
                                    </span>
                                    <span t-if="record.contador_scan_detectado.value" class="badge badge-success">
                                        Scan: <field name="contador_scan_detectado"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_bottom mt-3">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="fecha_procesamiento" widget="date"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="procesado_automaticamente" widget="boolean"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========== ACCIONES ========== -->
    
    <!-- Acción principal -->
    <record id="action_contador_automatico" model="ir.actions.act_window">
        <field name="name">Contadores Automáticos</field>
        <field name="res_model">contador.automatico</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_contador_automatico_kanban"/>
        <field name="search_view_id" ref="view_contador_automatico_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡No hay registros de contadores automáticos!
            </p>
            <p>
                Los registros se crean automáticamente cuando llegan correos al canal "Correos" 
                con información de contadores de equipos.
            </p>
            <p>
                <strong>¿Cómo funciona?</strong>
            </p>
            <ul>
                <li>📧 Llega correo con contadores al canal "Correos"</li>
                <li>🤖 Se detecta automáticamente serie y contadores</li>
                <li>📊 Se actualiza el equipo correspondiente</li>
                <li>✅ Queda registrado el historial completo</li>
            </ul>
        </field>
    </record>
    
    <!-- Acción para pendientes -->
    <record id="action_contador_automatico_pendientes" model="ir.actions.act_window">
        <field name="name">Contadores Pendientes</field>
        <field name="res_model">contador.automatico</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('estado', '=', 'pendiente')]</field>
        <field name="context">{'search_default_pendientes': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡No hay contadores pendientes!
            </p>
            <p>
                Los contadores pendientes son correos que llegaron pero aún no se han procesado automáticamente.
            </p>
        </field>
    </record>
    
    <!-- Acción para errores y manuales -->
    <record id="action_contador_automatico_errores" model="ir.actions.act_window">
        <field name="name">Contadores con Problemas</field>
        <field name="res_model">contador.automatico</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('estado', 'in', ['error', 'manual'])]</field>
        <field name="context">{'search_default_errores': 1, 'search_default_manuales': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡No hay contadores con problemas!
            </p>
            <p>
                Aquí aparecen los correos que requieren intervención manual o tuvieron errores en el procesamiento.
            </p>
        </field>
    </record>

    <!-- Acción para procesados exitosos -->
    <record id="action_contador_automatico_procesados" model="ir.actions.act_window">
        <field name="name">Contadores Procesados</field>
        <field name="res_model">contador.automatico</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('estado', '=', 'procesado')]</field>
        <field name="context">{'search_default_procesados': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Aún no hay contadores procesados!
            </p>
            <p>
                Aquí verás todos los correos que se procesaron exitosamente y actualizaron contadores de equipos.
            </p>
        </field>
    </record>

    <!-- ========== MENÚS ========== -->
    
    <!-- Menú principal -->
    <menuitem id="menu_contador_automatico_root"
              name="Contadores Automáticos"
              parent="sat_menu_root"
              action="action_contador_automatico"
              sequence="80"/>
    
</odoo>
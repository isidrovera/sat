<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_snmp_credential_search" model="ir.ui.view">
            <field name="name">sat.snmp.credential.search</field>
            <field name="model">sat.snmp.credential</field>
            <field name="arch" type="xml">
                <search string="Credenciales SNMP">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="partner_id"/>
                    <field name="snmp_version"/>

                    <filter name="active" string="Activas" domain="[('active','=',True)]"/>
                    <filter name="validated" string="Validadas" domain="[('state','=','validated')]"/>
                    <filter name="testing" string="En pruebas" domain="[('state','=','testing')]"/>
                    <filter name="global" string="Globales" domain="[('global_credential','=',True)]"/>

                    <group expand="0" string="Agrupar por">
                        <filter name="group_partner" string="Cliente" context="{'group_by':'partner_id'}"/>
                        <filter name="group_version" string="Versión SNMP" context="{'group_by':'snmp_version'}"/>
                        <filter name="group_state" string="Estado" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_snmp_credential_list" model="ir.ui.view">
            <field name="name">sat.snmp.credential.list</field>
            <field name="model">sat.snmp.credential</field>
            <field name="arch" type="xml">
                <list string="Credenciales SNMP"
                      default_order="priority desc, sequence, name">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="partner_id"/>
                    <field name="global_credential"/>
                    <field name="snmp_version"/>
                    <field name="port"/>
                    <field name="priority"/>
                    <field name="community_set" optional="show"/>
                    <field name="success_rate" optional="hide"/>
                    <field name="state" widget="badge"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_snmp_credential_form" model="ir.ui.view">
            <field name="name">sat.snmp.credential.form</field>
            <field name="model">sat.snmp.credential</field>
            <field name="arch" type="xml">
                <form string="Credencial SNMP">
                    <header>
                        <button name="action_set_draft"
                                type="object"
                                string="Borrador"
                                invisible="state == 'draft'"/>

                        <button name="action_set_testing"
                                type="object"
                                string="En Pruebas"
                                class="btn-secondary"
                                invisible="state == 'testing'"/>

                        <button name="action_validate"
                                type="object"
                                string="Validar"
                                class="btn-primary"
                                invisible="state == 'validated'"/>

                        <button name="action_disable"
                                type="object"
                                string="Deshabilitar"
                                invisible="state == 'disabled'"/>

                        <button name="action_enable"
                                type="object"
                                string="Habilitar"
                                invisible="state != 'disabled'"/>

                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="draft,testing,validated,disabled"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>

                        <group>
                            <group string="IDENTIFICACIÓN">
                                <field name="code"/>
                                <field name="global_credential"/>
                                <field name="partner_id"
                                       invisible="global_credential"/>
                                <field name="snmp_version"/>
                                <field name="port"/>
                            </group>

                            <group string="CONEXIÓN">
                                <field name="priority"/>
                                <field name="timeout"/>
                                <field name="retries"/>
                                <field name="allow_discovery"/>
                                <field name="allow_polling"/>
                                <field name="fallback_enabled"/>
                            </group>
                        </group>

                        <notebook>

                            <page string="SNMP v1 / v2c"
                                  invisible="snmp_version == '3'">

                                <group>
                                    <group string="Community">
                                        <field name="community_preview"
                                               readonly="1"/>

                                        <field name="community_set"
                                               readonly="1"/>

                                        <field name="community_input"
                                               string="Community nueva"
                                               password="True"
                                               placeholder="Ejemplo: public"
                                               groups="base.group_system"/>
                                    </group>

                                    <group string="Información">
                                        <div class="o_form_label">
                                            Escriba la community en "Community nueva" y guarde.
                                            El valor será cifrado y el campo volverá a quedar vacío.
                                        </div>
                                    </group>
                                </group>

                            </page>

                            <page string="SNMP v3"
                                  invisible="snmp_version != '3'">

                                <group>
                                    <group string="Seguridad">
                                        <field name="v3_username"/>
                                        <field name="v3_security_level"/>
                                        <field name="v3_auth_protocol"
                                               invisible="v3_security_level == 'noAuthNoPriv'"/>
                                        <field name="v3_priv_protocol"
                                               invisible="v3_security_level != 'authPriv'"/>
                                    </group>

                                    <group string="Contexto">
                                        <field name="v3_context_name"/>
                                        <field name="v3_context_engine_id"/>
                                    </group>
                                </group>

                                <group>
                                    <group string="Autenticación"
                                           invisible="v3_security_level == 'noAuthNoPriv'">
                                        <field name="v3_auth_key_preview" readonly="1"/>
                                        <field name="v3_auth_key_set" readonly="1"/>
                                        <field name="v3_auth_key_input"
                                               string="Nueva clave autenticación"
                                               password="True"
                                               groups="base.group_system"/>
                                    </group>

                                    <group string="Privacidad"
                                           invisible="v3_security_level != 'authPriv'">
                                        <field name="v3_priv_key_preview" readonly="1"/>
                                        <field name="v3_priv_key_set" readonly="1"/>
                                        <field name="v3_priv_key_input"
                                               string="Nueva clave privacidad"
                                               password="True"
                                               groups="base.group_system"/>
                                    </group>
                                </group>

                            </page>

                            <page string="Estadísticas">
                                <group>
                                    <group>
                                        <field name="tested_count" readonly="1"/>
                                        <field name="success_count" readonly="1"/>
                                        <field name="failure_count" readonly="1"/>
                                        <field name="success_rate" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="last_test_date" readonly="1"/>
                                        <field name="last_success_date" readonly="1"/>
                                        <field name="last_failure_date" readonly="1"/>
                                        <field name="last_used_at" readonly="1"/>
                                        <field name="use_count" readonly="1"/>
                                    </group>
                                </group>
                                <field name="last_failure_message"
                                       readonly="1"
                                       nolabel="1"/>
                            </page>

                            <page string="Seguridad"
                                  groups="base.group_system">
                                <group>
                                    <group string="Auditoría">
                                        <field name="secret_revision" readonly="1"/>
                                        <field name="secret_updated_at" readonly="1"/>
                                        <field name="secret_updated_by" readonly="1"/>
                                    </group>
                                    <group string="Administración">
                                        <button name="action_clear_secrets"
                                                type="object"
                                                string="Borrar todos los secretos"
                                                class="btn-secondary"
                                                confirm="¿Desea borrar Community y claves SNMP v3 de esta credencial?"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Notas">
                                <field name="notes" nolabel="1"/>
                            </page>

                        </notebook>
                    </sheet>

                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_snmp_credential" model="ir.actions.act_window">
            <field name="name">Credenciales SNMP</field>
            <field name="res_model">sat.snmp.credential</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_snmp_credential_search"/>
        </record>

    </data>
</odoo>

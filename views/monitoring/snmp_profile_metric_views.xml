<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_snmp_profile_metric_search" model="ir.ui.view">
            <field name="name">sat.snmp.profile.metric.search</field>
            <field name="model">sat.snmp.profile.metric</field>
            <field name="arch" type="xml">
                <search string="Métricas SNMP">

                    <field name="name"/>
                    <field name="code"/>
                    <field name="profile_id"/>
                    <field name="marca_id"/>
                    <field name="category"/>
                    <field name="oid"/>

                    <filter name="active"
                            string="Activas"
                            domain="[('active','=',True)]"/>

                    <filter name="required"
                            string="Obligatorias"
                            domain="[('required','=',True)]"/>

                    <filter name="alerts"
                            string="Con alerta"
                            domain="[('alert_enabled','=',True)]"/>

                    <filter name="store_history"
                            string="Con histórico"
                            domain="[('store_history','=',True)]"/>

                    <group expand="0" string="Agrupar por">

                        <filter name="group_profile"
                                string="Perfil"
                                context="{'group_by':'profile_id'}"/>

                        <filter name="group_brand"
                                string="Marca"
                                context="{'group_by':'marca_id'}"/>

                        <filter name="group_category"
                                string="Categoría"
                                context="{'group_by':'category'}"/>

                        <filter name="group_method"
                                string="Método"
                                context="{'group_by':'method'}"/>

                        <filter name="group_confidence"
                                string="Confianza"
                                context="{'group_by':'confidence'}"/>

                    </group>

                </search>
            </field>
        </record>


        <record id="view_snmp_profile_metric_list" model="ir.ui.view">
            <field name="name">sat.snmp.profile.metric.list</field>
            <field name="model">sat.snmp.profile.metric</field>
            <field name="arch" type="xml">

                <list string="Métricas SNMP"
                      default_order="profile_id, category, sequence, name">

                    <field name="sequence"
                           widget="handle"/>

                    <field name="profile_id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="category"/>
                    <field name="subgroup"
                           optional="hide"/>

                    <field name="logical_type"/>
                    <field name="method"/>

                    <field name="oid"
                           optional="show"/>

                    <field name="required"/>
                    <field name="store_history"
                           optional="hide"/>

                    <field name="alert_enabled"
                           optional="hide"/>

                    <field name="confidence"
                           optional="show"/>

                    <field name="success_count"
                           optional="hide"/>

                    <field name="failure_count"
                           optional="hide"/>

                    <field name="active"/>

                </list>

            </field>
        </record>


        <record id="view_snmp_profile_metric_form" model="ir.ui.view">
            <field name="name">sat.snmp.profile.metric.form</field>
            <field name="model">sat.snmp.profile.metric</field>
            <field name="arch" type="xml">

                <form string="Métrica SNMP">

                    <sheet>

                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>


                        <group>

                            <group string="Identificación">

                                <field name="profile_id"/>
                                <field name="marca_id"
                                       readonly="1"/>

                                <field name="code"/>
                                <field name="category"/>
                                <field name="subgroup"/>
                                <field name="logical_type"/>
                                <field name="unit"/>

                            </group>

                            <group string="Configuración">

                                <field name="method"/>
                                <field name="sequence"/>
                                <field name="priority"/>
                                <field name="required"/>
                                <field name="active"/>
                                <field name="confidence"/>

                            </group>

                        </group>


                        <notebook>

                            <page string="Descripción">

                                <field name="description"
                                       nolabel="1"/>

                            </page>


                            <page string="OID">

                                <group>

                                    <group string="OID principal">

                                        <field name="oid"/>

                                        <field name="oid_fallback"/>

                                    </group>

                                    <group string="Índice">

                                        <field name="index_oid"/>

                                        <field name="fixed_index"/>

                                        <field name="dynamic_index"/>

                                    </group>

                                </group>

                            </page>


                            <page string="Tabla">

                                <group>

                                    <group string="Tabla">

                                        <field name="table_base_oid"/>

                                        <field name="label_column_oid"/>

                                        <field name="value_column_oid"/>

                                        <field name="secondary_value_column_oid"/>

                                    </group>

                                    <group string="Etiqueta">

                                        <field name="label_exact"/>

                                        <field name="label_regex"/>

                                        <field name="label_contains"/>

                                        <field name="label_case_sensitive"/>

                                    </group>

                                </group>

                                <group string="Filtro de fila">

                                    <field name="row_filter_oid"/>

                                    <field name="row_filter_operator"/>

                                    <field name="row_filter_value"/>

                                </group>

                            </page>


                            <page string="Presencia">

                                <group>

                                    <field name="presence_mode"/>

                                    <field name="presence_expected_value"/>

                                    <field name="presence_expected_regex"/>

                                </group>

                            </page>


                            <page string="Enumerados y Bits">

                                <group>

                                    <group string="Enumerados">

                                        <field name="enum_map_json"
                                               nolabel="1"/>

                                        <field name="unknown_enum_value"/>

                                    </group>

                                    <group string="Bits">

                                        <field name="bit_position"/>

                                        <field name="bit_mask"/>

                                        <field name="bit_expected"/>

                                    </group>

                                </group>

                            </page>


                            <page string="Transformación">

                                <group>

                                    <group string="Numérico">

                                        <field name="multiplier"/>

                                        <field name="divisor"/>

                                        <field name="offset"/>

                                        <field name="round_digits"/>

                                    </group>

                                    <group string="Texto">

                                        <field name="strip_text"/>

                                        <field name="uppercase_text"/>

                                        <field name="lowercase_text"/>

                                    </group>

                                </group>

                                <group string="Límites">

                                    <field name="use_minimum_value"/>

                                    <field name="minimum_value"
                                           invisible="not use_minimum_value"/>

                                    <field name="use_maximum_value"/>

                                    <field name="maximum_value"
                                           invisible="not use_maximum_value"/>

                                </group>

                            </page>


                            <page string="Sentinelas">

                                <group>

                                    <field name="sentinel_values"
                                           nolabel="1"/>

                                    <field name="sentinel_behavior"/>

                                </group>

                            </page>


                            <page string="Derivada">

                                <group>

                                    <field name="derived_formula"
                                           nolabel="1"/>

                                    <field name="dependency_codes"
                                           nolabel="1"/>

                                </group>

                            </page>


                            <page string="Polling">

                                <group>

                                    <group string="Frecuencia">

                                        <field name="polling_group"/>

                                        <field name="polling_interval"/>

                                        <field name="timeout_seconds"/>

                                        <field name="retries"/>

                                    </group>

                                    <group string="Almacenamiento">

                                        <field name="store_current"/>

                                        <field name="store_history"/>

                                        <field name="store_raw"/>

                                        <field name="history_mode"/>

                                        <field name="change_threshold"/>

                                    </group>

                                </group>

                            </page>


                            <page string="Alertas">

                                <group>

                                    <field name="alert_enabled"/>

                                    <field name="alert_condition"
                                           invisible="not alert_enabled"/>

                                    <field name="alert_value"
                                           invisible="not alert_enabled"/>

                                    <field name="alert_severity"
                                           invisible="not alert_enabled"/>

                                </group>

                            </page>


                            <page string="Validación">

                                <group>

                                    <group string="Pruebas">

                                        <field name="tested_count"
                                               readonly="1"/>

                                        <field name="success_count"
                                               readonly="1"/>

                                        <field name="failure_count"
                                               readonly="1"/>

                                    </group>

                                    <group string="Fechas">

                                        <field name="last_success_date"
                                               readonly="1"/>

                                        <field name="last_failure_date"
                                               readonly="1"/>

                                        <field name="discovery_source"
                                               readonly="1"/>

                                    </group>

                                </group>

                            </page>


                            <page string="Notas técnicas">

                                <field name="technical_notes"
                                       nolabel="1"/>

                            </page>

                        </notebook>

                    </sheet>

                </form>

            </field>
        </record>


        <record id="action_snmp_profile_metric"
                model="ir.actions.act_window">

            <field name="name">Métricas / OIDs</field>
            <field name="res_model">sat.snmp.profile.metric</field>
            <field name="view_mode">list,form</field>

            <field name="search_view_id"
                   ref="view_snmp_profile_metric_search"/>

        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_monitoring_agent_search" model="ir.ui.view">
            <field name="name">sat.monitoring.agent.search</field>
            <field name="model">sat.monitoring.agent</field>
            <field name="arch" type="xml">
                <search string="Agentes de Monitoreo">

                    <field name="name"/>
                    <field name="code"/>
                    <field name="partner_id"/>
                    <field name="hostname"/>
                    <field name="local_ip"/>
                    <field name="public_ip"/>

                    <filter name="online"
                            string="Online"
                            domain="[('online','=',True)]"/>

                    <filter name="offline"
                            string="Offline"
                            domain="[('online','=',False)]"/>

                    <filter name="enabled"
                            string="Habilitados"
                            domain="[('enabled','=',True)]"/>

                    <filter name="disabled"
                            string="Deshabilitados"
                            domain="[('enabled','=',False)]"/>

                    <filter name="with_errors"
                            string="Con errores"
                            domain="[('last_error_message','!=',False)]"/>

                    <filter name="needs_sync"
                            string="Pendiente sincronizar"
                            domain="[('needs_config_sync','=',True)]"/>

                    <group expand="0" string="Agrupar por">

                        <filter name="group_partner"
                                string="Cliente"
                                context="{'group_by':'partner_id'}"/>

                        <filter name="group_state"
                                string="Estado"
                                context="{'group_by':'state'}"/>

                    </group>

                </search>
            </field>
        </record>


        <record id="view_monitoring_agent_list" model="ir.ui.view">
            <field name="name">sat.monitoring.agent.list</field>
            <field name="model">sat.monitoring.agent</field>
            <field name="arch" type="xml">

                <list string="Agentes de Monitoreo"
                      default_order="online desc, last_seen desc, name"
                      decoration-success="online"
                      decoration-danger="not online"
                      decoration-muted="not enabled">

                    <field name="online"
                           widget="boolean_toggle"
                           readonly="1"/>

                    <field name="name"/>
                    <field name="code"/>
                    <field name="partner_id"/>
                    <field name="hostname"
                           optional="show"/>

                    <field name="local_ip"
                           optional="show"/>

                    <field name="public_ip"
                           optional="hide"/>

                    <field name="agent_version"
                           optional="show"/>

                    <field name="state"
                           widget="badge"/>

                    <field name="network_count"
                           string="Redes"/>

                    <field name="device_count"
                           string="Equipos"/>

                    <field name="online_device_count"
                           string="Online"
                           optional="hide"/>

                    <field name="offline_device_count"
                           string="Offline"
                           optional="hide"/>

                    <field name="last_heartbeat"
                           optional="show"/>

                    <field name="config_revision"
                           optional="hide"/>

                    <field name="last_config_sync_revision"
                           optional="hide"/>

                    <field name="needs_config_sync"
                           optional="hide"/>

                    <field name="enabled"/>

                </list>

            </field>
        </record>


        <record id="view_monitoring_agent_form" model="ir.ui.view">
            <field name="name">sat.monitoring.agent.form</field>
            <field name="model">sat.monitoring.agent</field>
            <field name="arch" type="xml">

                <form string="Agente de Monitoreo">

                    <header>

                        <button name="action_generate_token"
                                type="object"
                                string="Generar Token"
                                class="btn-primary"
                                groups="base.group_system"/>

                        <button name="action_revoke_token"
                                type="object"
                                string="Revocar Token"
                                groups="base.group_system"
                                invisible="not token_hash"/>

                        <button name="action_enable"
                                type="object"
                                string="Habilitar"
                                groups="base.group_system"
                                invisible="enabled"/>

                        <button name="action_disable"
                                type="object"
                                string="Deshabilitar"
                                groups="base.group_system"
                                invisible="not enabled"/>

                        <field name="state"
                               widget="statusbar"/>

                    </header>


                    <sheet>

                        <field name="token_hash"
                               invisible="1"/>

                        <widget name="web_ribbon"
                                title="OFFLINE"
                                bg_color="text-bg-danger"
                                invisible="online"/>

                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>


                        <group>

                            <group string="Identificación">

                                <field name="code"/>
                                <field name="partner_id"/>
                                <field name="branch_name"/>
                                <field name="location_description"/>
                                <field name="enabled"/>
                                <field name="active"/>

                            </group>

                            <group string="Estado">

                                <field name="online"
                                       readonly="1"/>

                                <field name="first_seen"
                                       readonly="1"/>

                                <field name="last_seen"
                                       readonly="1"/>

                                <field name="last_heartbeat"
                                       readonly="1"/>

                                <field name="last_config_request"
                                       readonly="1"/>

                                <field name="needs_config_sync"
                                       readonly="1"/>

                            </group>

                        </group>


                        <notebook>

                            <page string="Sistema">

                                <group>

                                    <group string="Equipo">

                                        <field name="hostname"
                                               readonly="1"/>

                                        <field name="os_name"
                                               readonly="1"/>

                                        <field name="os_version"
                                               readonly="1"/>

                                        <field name="architecture"
                                               readonly="1"/>

                                        <field name="python_version"
                                               readonly="1"/>

                                        <field name="agent_version"
                                               readonly="1"/>

                                    </group>

                                    <group string="Red">

                                        <field name="local_ip"
                                               readonly="1"/>

                                        <field name="public_ip"
                                               readonly="1"/>

                                        <field name="mac_address"
                                               readonly="1"/>

                                    </group>

                                </group>

                            </page>


                            <page string="Seguridad"
                                  groups="base.group_system">

                                <group>

                                    <group string="Token">

                                        <field name="token_preview"
                                               readonly="1"/>

                                        <field name="token_generated_at"
                                               readonly="1"/>

                                        <field name="token_generated_by"
                                               readonly="1"/>

                                        <field name="token_last_used_at"
                                               readonly="1"/>

                                    </group>

                                    <group string="Heartbeat">

                                        <field name="heartbeat_interval"/>

                                        <field name="offline_after_seconds"/>

                                    </group>

                                </group>

                            </page>


                            <page string="Discovery y Polling">

                                <group>

                                    <group string="Discovery">

                                        <field name="discovery_enabled"/>

                                        <field name="discovery_interval"/>

                                        <field name="max_parallel_hosts"/>

                                        <field name="discovery_count"
                                               readonly="1"/>

                                    </group>

                                    <group string="Polling">

                                        <field name="polling_enabled"/>

                                        <field name="default_poll_interval"/>

                                        <field name="max_parallel_snmp"/>

                                        <field name="poll_count"
                                               readonly="1"/>

                                        <field name="successful_poll_count"
                                               readonly="1"/>

                                        <field name="failed_poll_count"
                                               readonly="1"/>

                                    </group>

                                </group>

                            </page>


                            <page string="Capacidades">

                                <group>

                                    <field name="supports_snmp_v1"
                                           readonly="1"/>

                                    <field name="supports_snmp_v2c"
                                           readonly="1"/>

                                    <field name="supports_snmp_v3"
                                           readonly="1"/>

                                    <field name="supports_walk"
                                           readonly="1"/>

                                    <field name="supports_bulk"
                                           readonly="1"/>

                                    <field name="supports_icmp"
                                           readonly="1"/>

                                </group>

                            </page>


                            <page string="Redes">

                                <field name="network_ids">
                                    <list>
                                        <field name="sequence"
                                               widget="handle"/>

                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="partner_id"/>
                                        <field name="cidr"/>
                                        <field name="discovery_enabled"/>
                                        <field name="polling_enabled"/>
                                        <field name="device_count"
                                               string="Equipos"/>
                                        <field name="active"/>
                                    </list>
                                </field>

                            </page>


                            <page string="Equipos">

                                <field name="device_ids"
                                       readonly="1">

                                    <list>

                                        <field name="online"
                                               widget="boolean_toggle"
                                               readonly="1"/>

                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="ip_address"/>
                                        <field name="model"/>
                                        <field name="serial"/>
                                        <field name="status"
                                               widget="badge"/>

                                        <field name="last_seen"/>

                                    </list>

                                </field>

                            </page>


                            <page string="Sincronización">

                                <group>

                                    <group string="Configuración">

                                        <field name="config_revision"
                                               readonly="1"/>

                                        <field name="last_config_sync_revision"
                                               readonly="1"/>

                                        <field name="last_config_sync_at"
                                               readonly="1"/>

                                        <field name="needs_config_sync"
                                               readonly="1"/>

                                    </group>

                                    <group string="Estadísticas">

                                        <field name="heartbeat_count"
                                               readonly="1"/>

                                        <field name="config_request_count"
                                               readonly="1"/>

                                    </group>

                                </group>

                            </page>


                            <page string="Errores">

                                <group>

                                    <group>

                                        <field name="last_error_date"
                                               readonly="1"/>

                                        <field name="last_error_code"
                                               readonly="1"/>

                                        <field name="consecutive_errors"
                                               readonly="1"/>

                                    </group>

                                </group>

                                <group string="Último error">

                                    <field name="last_error_message"
                                           nolabel="1"
                                           readonly="1"/>

                                </group>

                            </page>


                            <page string="Notas">

                                <field name="notes"
                                       nolabel="1"/>

                            </page>

                        </notebook>

                    </sheet>

                    <chatter/>

                </form>

            </field>
        </record>


        <record id="action_monitoring_agent"
                model="ir.actions.act_window">

            <field name="name">Agentes de Monitoreo</field>
            <field name="res_model">sat.monitoring.agent</field>
            <field name="view_mode">list,form</field>

            <field name="search_view_id"
                   ref="view_monitoring_agent_search"/>

        </record>

    </data>
</odoo>

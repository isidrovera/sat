<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_monitoring_alert_search" model="ir.ui.view">
            <field name="name">sat.monitoring.alert.search</field>
            <field name="model">sat.monitoring.alert</field>
            <field name="arch" type="xml">
                <search string="Alertas">

                    <field name="device_id"/>
                    <field name="partner_id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="serial"/>
                    <field name="oid"/>

                    <filter name="active_alerts"
                            string="Activas"
                            domain="[('active','=',True)]"/>

                    <filter name="open"
                            string="Abiertas"
                            domain="[('state','=','open')]"/>

                    <filter name="acknowledged"
                            string="Reconocidas"
                            domain="[('state','=','acknowledged')]"/>

                    <filter name="resolved"
                            string="Resueltas"
                            domain="[('state','=','resolved')]"/>

                    <filter name="ignored"
                            string="Ignoradas"
                            domain="[('state','=','ignored')]"/>

                    <filter name="requires_service"
                            string="Requiere servicio"
                            domain="[('requires_service','=',True)]"/>

                    <filter name="requires_review"
                            string="Requiere revisión"
                            domain="[('requires_review','=',True)]"/>

                    <group expand="0" string="Agrupar por">

                        <filter name="group_device"
                                string="Equipo"
                                context="{'group_by':'device_id'}"/>

                        <filter name="group_partner"
                                string="Cliente"
                                context="{'group_by':'partner_id'}"/>

                        <filter name="group_severity"
                                string="Severidad"
                                context="{'group_by':'severity'}"/>

                        <filter name="group_category"
                                string="Categoría"
                                context="{'group_by':'category'}"/>

                        <filter name="group_state"
                                string="Estado"
                                context="{'group_by':'state'}"/>

                    </group>

                </search>
            </field>
        </record>


        <record id="view_monitoring_alert_list" model="ir.ui.view">
            <field name="name">sat.monitoring.alert.list</field>
            <field name="model">sat.monitoring.alert</field>
            <field name="arch" type="xml">

                <list string="Alertas"
                      default_order="severity_rank desc, last_seen desc"
                      decoration-danger="severity == 'critical'"
                      decoration-warning="severity == 'warning'"
                      decoration-muted="state in ('resolved','ignored')">

                    <field name="severity"
                           widget="badge"/>

                    <field name="device_id"/>

                    <field name="partner_id"
                           optional="show"/>

                    <field name="name"/>

                    <field name="category"
                           optional="show"/>

                    <field name="location"
                           optional="hide"/>

                    <field name="state"
                           widget="badge"/>

                    <field name="occurrence_count"
                           optional="show"/>

                    <field name="first_seen"
                           optional="hide"/>

                    <field name="last_seen"
                           optional="show"/>

                    <field name="duration_hours"
                           optional="hide"/>

                    <field name="requires_service"
                           optional="show"/>

                    <field name="requires_review"
                           optional="hide"/>

                    <field name="active"
                           optional="hide"/>

                </list>

            </field>
        </record>


        <record id="view_monitoring_alert_form" model="ir.ui.view">
            <field name="name">sat.monitoring.alert.form</field>
            <field name="model">sat.monitoring.alert</field>
            <field name="arch" type="xml">

                <form string="Alerta SNMP">

                    <header>

                        <button name="action_acknowledge"
                                type="object"
                                string="Reconocer"
                                class="btn-primary"
                                invisible="state != 'open'"/>

                        <button name="action_ignore"
                                type="object"
                                string="Ignorar"
                                invisible="state == 'ignored'"/>

                        <button name="action_reopen"
                                type="object"
                                string="Reabrir"
                                invisible="state not in ('resolved','ignored')"/>

                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="open,acknowledged,resolved,ignored"/>

                    </header>


                    <sheet>

                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>


                        <group>

                            <group string="Equipo">
                                <field name="device_id"
                                       readonly="1"/>

                                <field name="partner_id"
                                       readonly="1"/>

                                <field name="maquina_id"
                                       readonly="1"/>

                                <field name="manufacturer"
                                       readonly="1"/>

                                <field name="model"
                                       readonly="1"/>

                                <field name="serial"
                                       readonly="1"/>

                                <field name="firmware"
                                       readonly="1"/>
                            </group>

                            <group string="Estado">
                                <field name="severity"
                                       widget="badge"/>

                                <field name="severity_rank"
                                       readonly="1"/>

                                <field name="active"
                                       readonly="1"/>

                                <field name="category"
                                       readonly="1"/>

                                <field name="group"
                                       readonly="1"/>

                                <field name="location"
                                       readonly="1"/>
                            </group>

                        </group>


                        <notebook>

                            <page string="Detalle">

                                <group string="Descripción">
                                    <field name="description"
                                           nolabel="1"
                                           readonly="1"/>
                                </group>

                                <group>
                                    <group string="Servicio">
                                        <field name="requires_service"
                                               readonly="1"/>

                                        <field name="requires_review"
                                               readonly="1"/>

                                        <field name="review_reason"
                                               readonly="1"/>
                                    </group>

                                    <group string="Impacto">
                                        <field name="prevents_printing"
                                               readonly="1"/>

                                        <field name="prevents_copying"
                                               readonly="1"/>

                                        <field name="prevents_scanning"
                                               readonly="1"/>
                                    </group>
                                </group>

                            </page>


                            <page string="Historial">

                                <group>

                                    <group>
                                        <field name="first_seen"
                                               readonly="1"/>

                                        <field name="last_seen"
                                               readonly="1"/>

                                        <field name="resolved_at"
                                               readonly="1"/>

                                        <field name="occurrence_count"
                                               readonly="1"/>
                                    </group>

                                    <group>
                                        <field name="acknowledged_at"
                                               readonly="1"/>

                                        <field name="acknowledged_by"
                                               readonly="1"/>

                                        <field name="duration_seconds"
                                               readonly="1"/>

                                        <field name="duration_minutes"
                                               readonly="1"/>

                                        <field name="duration_hours"
                                               readonly="1"/>
                                    </group>

                                </group>

                            </page>


                            <page string="Origen">

                                <group>

                                    <group>
                                        <field name="snapshot_id"
                                               readonly="1"/>

                                        <field name="first_snapshot_id"
                                               readonly="1"/>

                                        <field name="metric_id"
                                               readonly="1"/>

                                        <field name="key"
                                               readonly="1"/>

                                        <field name="code"
                                               readonly="1"/>
                                    </group>

                                    <group>
                                        <field name="oid"
                                               readonly="1"/>

                                        <field name="oid_name"
                                               readonly="1"/>

                                        <field name="oid_index"
                                               readonly="1"/>

                                        <field name="source_label"
                                               readonly="1"/>

                                        <field name="source_name"
                                               readonly="1"/>

                                        <field name="snmp_type"
                                               readonly="1"/>
                                    </group>

                                </group>

                            </page>


                            <page string="Valor">

                                <group>
                                    <field name="value_text"
                                           readonly="1"/>

                                    <field name="confidence"
                                           readonly="1"/>
                                </group>

                            </page>


                            <page string="RAW"
                                  groups="base.group_system">

                                <group string="Valor RAW">
                                    <field name="raw_value"
                                           nolabel="1"
                                           readonly="1"/>
                                </group>

                                <group string="JSON RAW">
                                    <field name="raw_json"
                                           nolabel="1"
                                           readonly="1"/>
                                </group>

                            </page>


                            <page string="Notas">

                                <field name="notes"
                                       nolabel="1"/>

                            </page>

                        </notebook>

                    </sheet>

                    <chatter/>

                </form>

            </field>
        </record>


        <record id="action_monitoring_alert"
                model="ir.actions.act_window">

            <field name="name">Alertas</field>
            <field name="res_model">sat.monitoring.alert</field>
            <field name="view_mode">list,form</field>

            <field name="search_view_id"
                   ref="view_monitoring_alert_search"/>

            <field name="context">{'search_default_active_alerts': 1}</field>

        </record>

    </data>
</odoo>

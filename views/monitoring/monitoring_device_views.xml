<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        

        

        <record id="view_sat_monitoring_device_search" model="ir.ui.view">
            <field name="name">sat.monitoring.device.search</field>
            <field name="model">sat.monitoring.device</field>
            <field name="arch" type="xml">

                <search string="Buscar Equipos Monitoreados">

                    

                    <field name="name"/>

                    <field name="ip_address"/>

                    <field name="hostname"/>

                    <field name="mac_address"/>

                    <field name="serial"/>

                    <field name="model"/>

                    <field name="manufacturer_raw"/>

                    <field name="partner_id"/>

                    <field name="marca_id"/>

                    <field name="agent_id"/>

                    <field name="network_id"/>

                    <field name="profile_id"/>

                    

                    <separator string="Estado"/>

                    <filter name="online" string="Online" domain="[('online', '=', True)]"/>

                    <filter name="offline" string="Offline" domain="[('online', '=', False)]"/>

                    <filter name="with_alerts" string="Con alertas" domain="[('active_alert_count', '&gt;', 0)]"/>

                    <filter name="without_alerts" string="Sin alertas" domain="[('active_alert_count', '=', 0)]"/>

                    

                    <separator string="Monitoreo"/>

                    <filter name="monitoring_enabled" string="Monitoreo activo" domain="[('monitoring_enabled', '=', True)]"/>

                    <filter name="monitoring_disabled" string="Monitoreo desactivado" domain="[('monitoring_enabled', '=', False)]"/>

                    <filter name="needs_discovery" string="Requiere discovery" domain="[('needs_discovery', '=', True)]"/>

                    <filter name="without_profile" string="Sin perfil" domain="[('profile_id', '=', False)]"/>

                    <filter name="with_profile" string="Con perfil" domain="[('profile_id', '!=', False)]"/>

                    

                    <separator string="Discovery"/>

                    <filter name="discovery_new" string="Nuevos" domain="[('discovery_state', '=', 'new')]"/>

                    <filter name="discovery_identified" string="Identificados" domain="[('discovery_state', '=', 'identified')]"/>

                    <filter name="discovery_profiled" string="Perfil asignado" domain="[('discovery_state', '=', 'profiled')]"/>

                    <filter name="discovery_monitoring" string="En monitoreo" domain="[('discovery_state', '=', 'monitoring')]"/>

                    <filter name="unsupported" string="No soportados" domain="[('discovery_state', '=', 'unsupported')]"/>

                    <filter name="ignored" string="Ignorados" domain="[('discovery_state', '=', 'ignored')]"/>

                    

                    <separator string="Tecnología"/>

                    <filter name="color" string="Color" domain="[('technology', '=', 'color')]"/>

                    <filter name="mono" string="Monocromo" domain="[('technology', '=', 'mono')]"/>

                    

                    <group expand="0" string="Agrupar por">

                        <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>

                        <filter name="group_brand" string="Marca" context="{'group_by': 'marca_id'}"/>

                        <filter name="group_agent" string="Agente" context="{'group_by': 'agent_id'}"/>

                        <filter name="group_network" string="Red" context="{'group_by': 'network_id'}"/>

                        <filter name="group_profile" string="Perfil SNMP" context="{'group_by': 'profile_id'}"/>

                        <filter name="group_status" string="Estado" context="{'group_by': 'status'}"/>

                        <filter name="group_discovery" string="Discovery" context="{'group_by': 'discovery_state'}"/>

                        <filter name="group_technology" string="Tecnología" context="{'group_by': 'technology'}"/>

                    </group>

                </search>

            </field>
        </record>

        

        <record id="view_sat_monitoring_device_list" model="ir.ui.view">
            <field name="name">sat.monitoring.device.list</field>
            <field name="model">sat.monitoring.device</field>
            <field name="arch" type="xml">

                <list string="Equipos Monitoreados" default_order="online desc, last_seen desc, name asc" decoration-danger="not online" decoration-warning="active_alert_count &gt; 0" decoration-muted="not monitoring_enabled">

                    <field name="online" widget="boolean_toggle" optional="show" readonly="1"/>

                    <field name="name" optional="show"/>

                    <field name="partner_id" optional="show"/>

                    <field name="branch_name" optional="hide"/>

                    <field name="marca_id" optional="show"/>

                    <field name="model" string="Modelo" optional="show"/>

                    <field name="serial" string="Serie" optional="show"/>

                    <field name="ip_address" string="IP" optional="show"/>

                    <field name="hostname" optional="hide"/>

                    <field name="status" widget="badge" optional="show" decoration-success="status == 'online'" decoration-danger="status == 'offline'" decoration-warning="status == 'warning'"/>

                    <field name="active_alert_count" string="Alertas" optional="show" decoration-danger="active_alert_count &gt; 0"/>

                    <field name="highest_alert_severity" string="Severidad" widget="badge" optional="show"/>

                    <field name="profile_id" string="Perfil" optional="hide"/>

                    <field name="profile_match_score" string="Match" optional="hide"/>

                    <field name="agent_id" optional="hide"/>

                    <field name="network_id" optional="hide"/>

                    <field name="last_seen" optional="show"/>

                    <field name="last_poll_date" string="Último Poll" optional="hide"/>

                    <field name="last_response_ms" string="Respuesta ms" optional="hide"/>

                    <field name="discovery_state" string="Discovery" widget="badge" optional="hide"/>

                    <field name="monitoring_enabled" optional="hide"/>

                </list>

            </field>
        </record>

        

        <record id="view_sat_monitoring_device_kanban" model="ir.ui.view">
            <field name="name">sat.monitoring.device.kanban</field>
            <field name="model">sat.monitoring.device</field>
            <field name="arch" type="xml">

                <kanban default_group_by="partner_id" class="o_kanban_small_column">

                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="marca_id"/>
                    <field name="model"/>
                    <field name="serial"/>
                    <field name="ip_address"/>
                    <field name="online"/>
                    <field name="status"/>
                    <field name="technology"/>
                    <field name="active_alert_count"/>
                    <field name="highest_alert_severity"/>
                    <field name="toner_black"/>
                    <field name="toner_cyan"/>
                    <field name="toner_magenta"/>
                    <field name="toner_yellow"/>
                    <field name="toner_black_available"/>
                    <field name="toner_cyan_available"/>
                    <field name="toner_magenta_available"/>
                    <field name="toner_yellow_available"/>
                    <field name="last_seen"/>
                    <field name="profile_id"/>

                    <templates>

                        <t t-name="card">

                            <div class="d-flex flex-column gap-2">

                                

                                <div class="d-flex justify-content-between align-items-start">

                                    <div class="me-2">

                                        <strong class="fs-5">
                                            <field name="name"/>
                                        </strong>

                                        <div class="text-muted" t-if="record.partner_id.raw_value">
                                            <field name="partner_id"/>
                                        </div>

                                    </div>

                                    <div>

                                        <span t-if="record.online.raw_value" class="badge text-bg-success">
                                            Online
                                        </span>

                                        <span t-else="" class="badge text-bg-danger">
                                            Offline
                                        </span>

                                    </div>

                                </div>

                                

                                <div class="border-top pt-2">

                                    <div>
                                        <strong>Equipo:</strong>

                                        <span t-if="record.marca_id.raw_value">
                                            <field name="marca_id"/>
                                        </span>

                                        <span t-if="record.model.raw_value">
                                            <field name="model"/>
                                        </span>
                                    </div>

                                    <div t-if="record.serial.raw_value">
                                        <strong>Serie:</strong>
                                        <field name="serial"/>
                                    </div>

                                    <div t-if="record.ip_address.raw_value">
                                        <strong>IP:</strong>
                                        <field name="ip_address"/>
                                    </div>

                                </div>

                                

                                <div t-if="record.active_alert_count.raw_value" class="alert alert-danger py-1 px-2 mb-0">
                                    <strong>
                                        <field name="active_alert_count"/>
                                    </strong>

                                    alerta(s) activa(s)

                                    <span t-if="record.highest_alert_severity.raw_value">
                                        -
                                        <field name="highest_alert_severity"/>
                                    </span>
                                </div>

                                

                                <div class="border-top pt-2">

                                    <small class="text-muted">
                                        Tóner
                                    </small>

                                    <div t-if="record.toner_black_available.raw_value" class="d-flex justify-content-between">
                                        <span>Negro</span>
                                        <strong>
                                            <field name="toner_black"/>%
                                        </strong>
                                    </div>

                                    <div t-if="record.toner_cyan_available.raw_value" class="d-flex justify-content-between">
                                        <span>Cyan</span>
                                        <strong>
                                            <field name="toner_cyan"/>%
                                        </strong>
                                    </div>

                                    <div t-if="record.toner_magenta_available.raw_value" class="d-flex justify-content-between">
                                        <span>Magenta</span>
                                        <strong>
                                            <field name="toner_magenta"/>%
                                        </strong>
                                    </div>

                                    <div t-if="record.toner_yellow_available.raw_value" class="d-flex justify-content-between">
                                        <span>Amarillo</span>
                                        <strong>
                                            <field name="toner_yellow"/>%
                                        </strong>
                                    </div>

                                </div>

                                

                                <div class="border-top pt-2 text-muted">

                                    <small t-if="record.profile_id.raw_value">
                                        Perfil:
                                        <field name="profile_id"/>
                                    </small>

                                    <br t-if="record.profile_id.raw_value"/>

                                    <small t-if="record.last_seen.raw_value">
                                        Última comunicación:
                                        <field name="last_seen"/>
                                    </small>

                                </div>

                            </div>

                        </t>

                    </templates>

                </kanban>

            </field>
        </record>

        

        <record id="view_sat_monitoring_device_form" model="ir.ui.view">
            <field name="name">sat.monitoring.device.form</field>
            <field name="model">sat.monitoring.device</field>

            <field name="arch" type="xml">

                <form string="Equipo Monitoreado">

                    

                    <header>

                        <button name="action_find_snmp_profile" type="object" string="Buscar Perfil" class="btn-primary" icon="fa-search" groups="base.group_system"/>

                        <button name="action_enable_monitoring" type="object" string="Activar Monitoreo" icon="fa-play" groups="base.group_system" invisible="monitoring_enabled"/>

                        <button name="action_confirm_printer" type="object" string="Confirmar Impresora" class="btn-primary" groups="base.group_system" invisible="is_confirmed_printer"/>

                        <button name="action_ignore_device" type="object" string="Ignorar" groups="base.group_system" invisible="is_ignored"/>

                        <field name="discovery_state" widget="statusbar" statusbar_visible="new,identified,profiled,monitoring,unsupported,ignored"/>

                    </header>

                    <sheet>

                        

                        <widget name="web_ribbon" title="OFFLINE" bg_color="text-bg-danger" invisible="online"/>

                        <widget name="web_ribbon" title="IGNORADO" bg_color="text-bg-secondary" invisible="not is_ignored"/>

                        <div class="oe_title">

                            <label for="name"/>

                            <h1>
                                <field name="name" placeholder="Equipo monitoreado..."/>
                            </h1>

                            <div class="d-flex gap-2">

                                <field name="online" widget="boolean_toggle" readonly="1"/>

                                <field name="status" widget="badge" readonly="1" decoration-success="status == 'online'" decoration-warning="status == 'warning'" decoration-danger="status == 'offline'"/>

                            </div>

                        </div>

                        

                        <group>

                            <group string="Cliente">

                                <field name="partner_id"/>

                                <field name="branch_name"/>

                                <field name="location_description"/>

                                <field name="maquina_id" readonly="1"/>

                            </group>

                            <group string="Equipo">

                                <field name="marca_id"/>

                                <field name="model"/>

                                <field name="model_raw"/>

                                <field name="serial"/>

                                <field name="technology"/>

                                <field name="firmware"/>

                            </group>

                        </group>

                        

                        <notebook>

                            

                            <page string="Resumen" name="summary">

                                <group>

                                    <group string="Conectividad">

                                        <field name="ip_address" readonly="1"/>

                                        <field name="hostname" readonly="1"/>

                                        <field name="mac_address" readonly="1"/>

                                        <field name="snmp_available" readonly="1"/>

                                        <field name="snmp_version"/>

                                        <field name="snmp_port"/>

                                        <field name="last_snmp_version_used" readonly="1"/>

                                    </group>

                                    <group string="Última comunicación">

                                        <field name="first_seen" readonly="1"/>

                                        <field name="last_seen" readonly="1"/>

                                        <field name="last_poll_date" readonly="1"/>

                                        <field name="last_response_ms" readonly="1"/>

                                        <field name="consecutive_failures" readonly="1"/>

                                    </group>

                                </group>

                                <group string="Último error">

                                    </group>

                            </page>

                            

                            <page string="Contadores" name="counters">

                                <group>

                                    <group string="Total Equipo">

                                        <field name="counter_machine_total" string="Total máquina" readonly="1"/>

                                        <field name="counter_total_bw" string="Total B/N" readonly="1"/>

                                        <field name="counter_total_color" string="Total Color" readonly="1"/>

                                    </group>

                                    <group string="Copia">

                                        <field name="counter_copy_total" string="Total Copias" readonly="1"/>

                                        <field name="counter_copy_bw" string="Copias B/N" readonly="1"/>

                                        <field name="counter_copy_color" string="Copias Color" readonly="1"/>

                                    </group>

                                    <group string="Impresión">

                                        <field name="counter_print_total" string="Total Impresión" readonly="1"/>

                                        <field name="counter_print_bw" string="Impresión B/N" readonly="1"/>

                                        <field name="counter_print_color" string="Impresión Color" readonly="1"/>

                                    </group>

                                    <group string="Escáner / Fax">

                                        <field name="counter_scan_total" string="Total Escáner" readonly="1"/>

                                        <field name="counter_scan_bw" string="Escáner B/N" readonly="1"/>

                                        <field name="counter_scan_color" string="Escáner Color" readonly="1"/>

                                        <field name="counter_fax_total" string="Fax" readonly="1"/>

                                    </group>

                                    <group string="Otros">

                                        <field name="counter_duplex" string="Dúplex" readonly="1"/>

                                        <field name="counter_large_paper" string="Formato grande" readonly="1"/>

                                    </group>

                                </group>

                            </page>

                            

                            <page string="Tóner" name="toner">

                                <group>

                                    <group string="Negro">

                                        <field name="toner_black_available" string="Disponible" readonly="1"/>

                                        <field name="toner_black" string="Nivel" readonly="1" invisible="not toner_black_available"/>

                                    </group>

                                    <group string="Cyan">

                                        <field name="toner_cyan_available" string="Disponible" readonly="1"/>

                                        <field name="toner_cyan" string="Nivel" readonly="1" invisible="not toner_cyan_available"/>

                                    </group>

                                    <group string="Magenta">

                                        <field name="toner_magenta_available" string="Disponible" readonly="1"/>

                                        <field name="toner_magenta" string="Nivel" readonly="1" invisible="not toner_magenta_available"/>

                                    </group>

                                    <group string="Amarillo">

                                        <field name="toner_yellow_available" string="Disponible" readonly="1"/>

                                        <field name="toner_yellow" string="Nivel" readonly="1" invisible="not toner_yellow_available"/>

                                    </group>

                                </group>

                                <div class="alert alert-info mt-3">
                                    Los valores especiales reportados por el fabricante,
                                    por ejemplo <strong>-100</strong>, no deben interpretarse
                                    automáticamente como 0 %. El valor RAW permanece en
                                    las lecturas históricas.
                                </div>

                            </page>

                            

                            <page string="Capacidades" name="capabilities">

                                <group>

                                    <group string="Funciones principales">

                                        <field name="capability_print" string="Impresión" readonly="1"/>

                                        <field name="capability_copy" string="Copia" readonly="1"/>

                                        <field name="capability_scan" string="Escáner" readonly="1"/>

                                        <field name="capability_fax" string="Fax" readonly="1"/>

                                        <field name="capability_color" string="Color" readonly="1"/>

                                        <field name="capability_duplex" string="Dúplex" readonly="1"/>

                                    </group>

                                    <group string="Alimentador">

                                        <field name="capability_adf" string="ADF" readonly="1"/>

                                        <field name="capability_radf" string="RADF" readonly="1"/>

                                        <field name="capability_spdf" string="SPDF" readonly="1"/>

                                    </group>

                                    <group string="Documentos">

                                        <field name="capability_ocr" string="OCR" readonly="1"/>

                                        <field name="capability_searchable_pdf" string="PDF buscable" readonly="1"/>

                                        <field name="capability_pdfa" string="PDF/A" readonly="1"/>

                                    </group>

                                    <group string="Almacenamiento">

                                        <field name="capability_hdd" string="HDD" readonly="1"/>

                                        <field name="capability_ssd" string="SSD" readonly="1"/>

                                    </group>

                                    <group string="Conectividad">

                                        <field name="capability_wifi" string="Wi-Fi" readonly="1"/>

                                        <field name="capability_nfc" string="NFC" readonly="1"/>

                                        <field name="capability_card_reader" string="Lector de tarjetas" readonly="1"/>

                                    </group>

                                    <group string="Acabado">

                                        <field name="capability_finisher" string="Finisher" readonly="1"/>

                                        <field name="capability_stapler" string="Engrapador" readonly="1"/>

                                        <field name="capability_punch" string="Perforador" readonly="1"/>

                                        <field name="capability_booklet" string="Booklet" readonly="1"/>

                                    </group>

                                </group>

                            </page>

                            

                            <page string="Hardware" name="hardware">

                                <group>

                                    <group string="Memoria / Almacenamiento">

                                        <field name="storage_total_mb" string="Almacenamiento total (MB)" readonly="1"/>

                                        <field name="storage_free_mb" string="Almacenamiento libre (MB)" readonly="1"/>

                                    </group>

                                    <group string="Inventario detectado">

                                        <field name="tray_count" string="Bandejas" readonly="1"/>

                                        <field name="accessory_count" string="Accesorios" readonly="1"/>

                                        <field name="component_count" string="Componentes" readonly="1"/>

                                    </group>

                                </group>

                            </page>

                            

                            <page string="Identidad SNMP" name="identity">

                                <group>

                                    <group string="Identidad">

                                        <field name="manufacturer_raw" readonly="1"/>

                                        <field name="model_raw" readonly="1"/>

                                        <field name="serial" readonly="1"/>

                                        <field name="firmware" readonly="1"/>

                                        <field name="enterprise_id" readonly="1"/>

                                    </group>

                                    <group string="Sistema">

                                        <field name="system_name" readonly="1"/>

                                        <field name="system_location" readonly="1"/>

                                        <field name="system_contact" readonly="1"/>

                                        <field name="engine_id" readonly="1"/>

                                    </group>

                                </group>

                                <group string="sysDescr">

                                    <field name="sysdescr" nolabel="1" readonly="1"/>

                                </group>

                            </page>

                            

                            <page string="Agente y Red" name="network">

                                <group>

                                    <group string="Agente">

                                        <field name="agent_id"/>

                                        <field name="effective_credential_id" string="Credencial efectiva" readonly="1" groups="base.group_system"/>

                                    </group>

                                    <group string="Red">

                                        <field name="network_id"/>

                                        <field name="network_cidr" readonly="1"/>

                                        <field name="credential_id" groups="base.group_system"/>

                                    </group>

                                </group>

                                <group string="Configuración IP">

                                    <group>

                                        <field name="ip_address"/>

                                        <field name="ipv6_address"/>

                                        <field name="hostname"/>

                                    </group>

                                    <group>

                                        <field name="mac_address"/>

                                        <field name="gateway"/>

                                        <field name="subnet_mask"/>

                                    </group>

                                </group>

                            </page>

                            

                            <page string="Perfil SNMP" name="profile">

                                <group>

                                    <group string="Perfil">

                                        <field name="profile_id"/>

                                        <field name="profile_code" readonly="1"/>

                                        <field name="profile_version" readonly="1"/>

                                        <field name="profile_revision" readonly="1"/>

                                        <field name="profile_manual"/>

                                    </group>

                                    <group string="Detección">

                                        <field name="profile_match_score" readonly="1"/>

                                        <field name="profile_match_date" readonly="1"/>

                                        <field name="needs_discovery" readonly="1"/>

                                        <field name="discovery_reason" readonly="1"/>

                                    </group>

                                </group>

                                <group string="Detalles del Match">

                                    <field name="profile_match_details" nolabel="1" readonly="1"/>

                                </group>

                            </page>

                            

                            <page string="Discovery" name="discovery">

                                <group>

                                    <group string="Estado">

                                        <field name="discovery_state" readonly="1"/>

                                        <field name="is_confirmed_printer" readonly="1"/>

                                        <field name="is_ignored" readonly="1"/>

                                        <field name="needs_discovery" readonly="1"/>

                                    </group>

                                    <group string="Fechas">

                                        </group>

                                </group>

                                <group string="Motivo">

                                    <field name="discovery_reason" nolabel="1" readonly="1"/>

                                </group>

                            </page>

                            

                            <page string="Diagnóstico RAW" name="raw" groups="base.group_system">

                                <group string="Resumen">

                                    </group>

                                <group string="Último Payload">

                                    <field name="last_raw_payload" nolabel="1" readonly="1"/>

                                </group>

                            </page>

                            

                            <page string="Notas" name="notes">

                                <field name="notes" nolabel="1" placeholder="Notas internas del equipo..."/>

                            </page>

                        </notebook>

                    </sheet>

                </form>

            </field>
        </record>

        

        

        <record id="action_monitoring_device" model="ir.actions.act_window">
            <field name="name">Equipos Monitoreados</field>
            <field name="res_model">sat.monitoring.device</field>

            <field name="view_mode">list,kanban,form</field>

            <field name="search_view_id" ref="view_sat_monitoring_device_search"/>

            <field name="context">
                {
                    'search_default_monitoring_enabled': 1
                }
            </field>

            <field name="help" type="html">

                <p class="o_view_nocontent_smiling_face">
                    No hay equipos monitoreados
                </p>

                <p>
                    Los equipos aparecerán automáticamente al ser
                    descubiertos por los agentes SNMP.
                </p>

            </field>

        </record>

        

        <record id="action_monitoring_device_list_view" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>

            <field name="view_mode">list</field>

            <field name="view_id" ref="view_sat_monitoring_device_list"/>

            <field name="act_window_id" ref="action_monitoring_device"/>
        </record>

        <record id="action_monitoring_device_kanban_view" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>

            <field name="view_mode">kanban</field>

            <field name="view_id" ref="view_sat_monitoring_device_kanban"/>

            <field name="act_window_id" ref="action_monitoring_device"/>
        </record>

        <record id="action_monitoring_device_form_view" model="ir.actions.act_window.view">
            <field name="sequence" eval="3"/>

            <field name="view_mode">form</field>

            <field name="view_id" ref="view_sat_monitoring_device_form"/>

            <field name="act_window_id" ref="action_monitoring_device"/>
        </record>

    </data>
</odoo>

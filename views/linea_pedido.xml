<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="Opciones_pedido_form_view_inherit" model="ir.ui.view">
        <field name="name">Opciones Pedido Form View Inherited</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Usamos el xpath generado por Odoo Studio para insertar los campos después de 'name' en 'order_line' -->
            <xpath expr="//form/sheet/notebook/page[@name='order_lines']/field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="contometroa" string="Contometro Anterior"/>
                <field name="contometro" string="Contometro" optional="hide"/>
                <field name="estado_entrega" string="Estado de Entrega" optional="hide"/>
                <field name="total_copias_id" string="Total de Copias" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version='1.0' encoding='utf-8'?>
<odoo>
<data>
    <!-- ============================================ -->
    <!-- MENÚ PRINCIPAL Y DASHBOARD -->
    <!-- ============================================ -->
    
    <!-- Acción del cliente para el dashboard -->
    <record id="sat_dashboard_action" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">sat_dashboard_tag</field>
    </record>

    <!-- Menú principal con icono -->
    <menuitem name="Sistema de taller" 
              id="sat_menu_root" 
              web_icon="sat,static/description/icon.png" 
              sequence="1"/>

    <!-- Dashboard como primer elemento -->
    <menuitem id="sat_dashboard_menu" 
              name="Dashboard" 
              parent="sat_menu_root" 
              action="sat_dashboard_action" 
              sequence="1"/>

    <!-- ============================================ -->
    <!-- SECCIÓN MÁQUINAS Y EQUIPOS -->
    <!-- ============================================ -->
    
    <!-- Acción principal de máquinas -->
    <record model="ir.actions.act_window" id="sat.action_window">
        <field name="name">Máquinas</field>
        <field name="res_model">sat.sat</field>
        <field name="view_mode">list,kanban,form,pivot</field>
        <field name="context">{'search_default_filter_stock': 1}</field>
        <field name="help" type="html">
            <p class="button_in_list">
                Registra un equipo
            </p>
        </field>
    </record>

    <!-- Acción servidor para crear reparaciones -->
    <record id="action_crear_reparaciones" model="ir.actions.server">
        <field name="name">Crear Reparaciones</field>
        <field name="model_id" ref="model_sat_sat"/>
        <field name="binding_model_id" ref="model_sat_sat"/>
        <field name="state">code</field>
        <field name="code">action = env['sat.sat'].browse(env.context.get('active_ids')).action_crear_reparaciones()</field>
    </record>

    <!-- Acción servidor para revisiones -->
    <record model="ir.actions.server" id="sat.action_server_revision">
        <field name="name">Ver Máquinas Para Revisión</field>
        <field name="model_id" ref="model_sat_sat"/>
        <field name="state">code</field>
        <field name="code">
            action = {
                "type": "ir.actions.act_window",
                "view_mode": "list",
                "res_model": "sat.sat",
                "domain": [('estado_ventas_id', '=', 'para_revision')],
                "context": {'order': 'fecha_para_revision asc'},
            }
        </field>
    </record>

    <!-- Menú de Máquinas -->
    <menuitem name="Máquinas" 
              id="sat.stock_maquinas" 
              parent="sat_menu_root" 
              action="sat.action_window" 
              sequence="10"/>

    <!-- ============================================ -->
    <!-- SECCIÓN SERVICIOS -->
    <!-- ============================================ -->
    
    <!-- Reparaciones -->
    <record model="ir.actions.act_window" id="sat.action_reparaciones_window">
        <field name="name">Reparaciones</field>
        <field name="res_model">reparaciones.reparaciones</field>
        <field name="view_mode">list,form,graph,kanban</field>
    </record>

    <menuitem name="Reparaciones" 
              id="sat.reparaciones" 
              parent="sat_menu_root" 
              action="sat.action_reparaciones_window" 
              sequence="20"/>

    <!-- Alquiler -->
    <record model="ir.actions.act_window" id="sat.action_alquiler_window">
        <field name="name">Alquiler</field>
        <field name="res_model">alquiler</field>
        <field name="view_mode">list,form,calendar,graph,kanban</field>
    </record>

    <menuitem name="Alquiler" 
              id="sat.alquiler" 
              parent="sat_menu_root" 
              action="sat.action_alquiler_window" 
              sequence="30"/>

    <!-- Repuestos -->
    <record model="ir.actions.act_window" id="sat.action_repuestos_window">
        <field name="name">Repuestos alquiler</field>
        <field name="res_model">repuestos.alquiler</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem name="Repuestos" 
              id="sat.repuestos" 
              parent="sat_menu_root" 
              action="sat.action_repuestos_window" 
              sequence="40"/>

    <!-- Solicitudes de Partes -->
    <record id="action_solicitud_partes" model="ir.actions.act_window">
        <field name="name">Solicitudes de Partes Alquiler</field>
        <field name="res_model">solicitud.partes</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_solicitud_partes" 
              name="Solicitudes de Partes" 
              action="action_solicitud_partes" 
              parent="sat_menu_root" 
              sequence="45"/>

    <!-- ============================================ -->
    <!-- SECCIÓN EVALUACIONES Y CALIDAD -->
    <!-- ============================================ -->
    
    <!-- Evaluación de Personal -->
    <record id="action_evaluacion_personal" model="ir.actions.act_window">
        <field name="name">Evaluación de Personal</field>
        <field name="res_model">evaluacion.personal</field>
        <field name="view_mode">list,form,kanban,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear primera evaluación de personal
            </p>
            <p>
                Realice evaluaciones periódicas del personal técnico.
            </p>
        </field>
    </record>

    <menuitem id="menu_evaluacion_personal" 
              name="Evaluación de Personal" 
              parent="sat_menu_root" 
              action="action_evaluacion_personal" 
              sequence="60"/>

    <!-- Evaluaciones de Servicio -->
    <record id="action_client_service_evaluation" model="ir.actions.act_window">
        <field name="name">Evaluaciones de Servicio</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">client.service.evaluation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primera evaluación de servicio!
            </p>
            <p>
                Registra y monitorea las evaluaciones de servicio técnico.
            </p>
        </field>
    </record>

    <menuitem id="menu_service_evaluation" 
              name="Evaluaciones de Servicio" 
              parent="sat_menu_root" 
              action="action_client_service_evaluation" 
              sequence="70"/>

    <!-- ============================================ -->
    <!-- SECCIÓN TÓNER Y ENTREGAS -->
    <!-- ============================================ -->
    
    <!-- Reportes de Tóner -->
    <record id="action_toner_counter_submission" model="ir.actions.act_window">
        <field name="name">Reportes de Contadores y Tóner</field>
        <field name="res_model">toner.counter.submission</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_toner_counter_submission_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡No hay reportes de tóner!
            </p>
            <p>
                Los reportes de contadores y tóner aparecerán aquí cuando los clientes envíen información.
            </p>
        </field>
    </record>

    <menuitem id="menu_toner_counter_submission" 
              name="Reportes de Tóner" 
              parent="sat_menu_root" 
              action="action_toner_counter_submission" 
              sequence="71"/>

    <!-- Entregas de Tóner -->
    <record id="action_toner_delivery_schedule" model="ir.actions.act_window">
        <field name="name">Programación de Entregas</field>
        <field name="res_model">toner.delivery.schedule</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡No hay entregas programadas!
            </p>
            <p>
                Las entregas de tóner aparecerán aquí cuando se programen.
            </p>
        </field>
    </record>

    <menuitem id="menu_toner_delivery_schedule" 
              name="Entregas de Tóner" 
              parent="sat_menu_root" 
              action="action_toner_delivery_schedule" 
              sequence="72"/>

    <!-- Dashboard de Entregas -->
    <record id="action_toner_delivery_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard de Entregas</field>
        <field name="res_model">toner.delivery.schedule</field>
        <field name="view_mode">kanban</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_toner_delivery_dashboard" 
              name="Dashboard de Entregas" 
              parent="sat_menu_root" 
              action="action_toner_delivery_dashboard" 
              sequence="73"/>

    <!-- Confirmaciones de Entrega -->
    <record id="action_toner_delivery_confirmation" model="ir.actions.act_window">
        <field name="name">Confirmaciones de Entrega</field>
        <field name="res_model">toner.delivery.confirmation</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_toner_delivery_confirmation_search"/>
        <field name="context">{'search_default_draft': 1, 'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡No hay confirmaciones de entrega!
            </p>
            <p>
                Las confirmaciones aparecerán cuando se confirmen las entregas.
            </p>
        </field>
    </record>

    <menuitem id="menu_toner_delivery_confirmation" 
              name="Confirmaciones de Entrega" 
              parent="sat_menu_root" 
              action="action_toner_delivery_confirmation" 
              sequence="74"/>

    <!-- Validaciones Pendientes -->
    <record id="action_toner_delivery_validation_pending" model="ir.actions.act_window">
        <field name="name">Validaciones Pendientes</field>
        <field name="res_model">toner.delivery.confirmation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_toner_delivery_confirmation_search"/>
        <field name="domain">[('validation_status', '=', 'pending')]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_toner_delivery_validation" 
              name="Validaciones Pendientes" 
              parent="sat_menu_root" 
              action="action_toner_delivery_validation_pending" 
              sequence="75"/>

    <!-- ============================================ -->
    <!-- SECCIÓN CONTADORES AUTOMÁTICOS -->
    <!-- ============================================ -->
    
    <!-- Contadores Automáticos -->
    <record id="action_contador_automatico" model="ir.actions.act_window">
        <field name="name">Contadores Automáticos</field>
        <field name="res_model">contador.automatico</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_hoy': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Comienza a procesar correos de contadores!
            </p>
            <p>
                El sistema procesa automáticamente correos usando inteligencia artificial.
            </p>
        </field>
    </record>

    <menuitem id="menu_contador_automatico_root" 
              name="Contadores Automáticos" 
              parent="sat_menu_root" 
              action="action_contador_automatico" 
              sequence="80"/>

    <!-- Patrones de Detección -->
    <record id="action_patron_contador" model="ir.actions.act_window">
        <field name="name">Patrones de Detección</field>
        <field name="res_model">patron.contador</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_patron_contador_list"/>
        <field name="search_view_id" ref="view_patron_contador_search"/>
        <field name="context">{'search_default_activos': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea patrones para detectar contadores automáticamente!
            </p>
            <p>
                Los patrones permiten detectar automáticamente series y contadores.
            </p>
        </field>
    </record>

    <menuitem id="menu_patron_contador" 
              name="Patrones de Detección" 
              parent="sat_menu_root" 
              action="action_patron_contador" 
              sequence="85"/>

    <!-- ============================================ -->
    <!-- SECCIÓN PRINTTRACKER PRO -->
    <!-- ============================================ -->
    
    <menuitem id="menu_printtracker_root" 
              name="PrintTracker Pro" 
              parent="sat_menu_root" 
              sequence="100"/>

    <!-- Configuración PrintTracker -->
    <record id="action_printtracker_config" model="ir.actions.act_window">
        <field name="name">Configuración PrintTracker</field>
        <field name="res_model">printtracker.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configura la conexión con PrintTracker Pro
            </p>
            <p>
                Configura tu API key y entidad principal para sincronizar automáticamente.
            </p>
        </field>
    </record>

    <menuitem id="menu_printtracker_config" 
              name="Configuración API" 
              parent="menu_printtracker_root" 
              action="action_printtracker_config" 
              sequence="10"/>

    <!-- Entidades PrintTracker -->
    <record id="action_printtracker_entity" model="ir.actions.act_window">
        <field name="name">Entidades PrintTracker</field>
        <field name="res_model">printtracker.entity</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay entidades sincronizadas
            </p>
            <p>
                Las entidades se sincronizan automáticamente desde PrintTracker Pro.
            </p>
        </field>
    </record>

    <menuitem id="menu_printtracker_entities" 
              name="Entidades" 
              parent="menu_printtracker_root" 
              action="action_printtracker_entity" 
              sequence="20"/>

    <!-- Medidores PrintTracker -->
    <record id="action_printtracker_meter" model="ir.actions.act_window">
        <field name="name">Medidores PrintTracker</field>
        <field name="res_model">printtracker.meter</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay lecturas de medidores
            </p>
            <p>
                Las lecturas se sincronizan automáticamente desde PrintTracker Pro.
            </p>
        </field>
    </record>

    <menuitem id="menu_printtracker_meters" 
              name="Medidores" 
              parent="menu_printtracker_root" 
              action="action_printtracker_meter" 
              sequence="30"/>

    <!-- Suministros PrintTracker -->
    <record id="action_printtracker_supply" model="ir.actions.act_window">
        <field name="name">Suministros PrintTracker</field>
        <field name="res_model">printtracker.supply</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay suministros sincronizados
            </p>
            <p>
                Los suministros se sincronizan automáticamente desde PrintTracker Pro.
            </p>
        </field>
    </record>

    <menuitem id="menu_printtracker_supplies" 
              name="Suministros" 
              parent="menu_printtracker_root" 
              action="action_printtracker_supply" 
              sequence="40"/>

    <!-- Separador PrintTracker -->
    <menuitem id="menu_printtracker_consolidation" 
              name="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" 
              parent="menu_printtracker_root" 
              sequence="50"/>

    <!-- Lecturas Diarias PrintTracker -->
    <menuitem id="menu_printtracker_daily_readings" 
              name="Lecturas Diarias Consolidadas" 
              parent="menu_printtracker_root" 
              action="action_printtracker_daily_reading" 
              sequence="60"/>

    <!-- Alertas PrintTracker -->
    <menuitem id="menu_printtracker_alerts" 
              name="Alertas del Sistema" 
              parent="menu_printtracker_root" 
              action="action_printtracker_alert" 
              sequence="70"/>

    <!-- Separador Herramientas PrintTracker -->
    <menuitem id="menu_printtracker_tools" 
              name="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" 
              parent="menu_printtracker_root" 
              sequence="80"/>

    <!-- Consolidador Manual PrintTracker -->
    <menuitem id="menu_printtracker_consolidator" 
              name="Ejecutar Consolidación" 
              parent="menu_printtracker_root" 
              action="action_printtracker_consolidator" 
              sequence="90"/>

    <!-- Gestor de Alertas Manual PrintTracker -->
    <menuitem id="menu_printtracker_alert_manager" 
              name="Ejecutar Revisión de Alertas" 
              parent="menu_printtracker_root" 
              action="action_printtracker_alert_manager" 
              sequence="100"/>

    <!-- ============================================ -->
    <!-- SECCIÓN REPORTES -->
    <!-- ============================================ -->
    
    <menuitem id="menu_reporte_estado_maquinas_main" 
              name="Reportes Estado Máquinas" 
              parent="sat_menu_root" 
              sequence="140"/>

    <!-- Acción principal de reportes -->
    <record id="action_reporte_estado_maquinas" model="ir.actions.act_window">
        <field name="name">Reportes Estado de Máquinas</field>
        <field name="res_model">reporte.estado.maquina</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_reporte_estado_maquina_list"/>
        <field name="search_view_id" ref="view_reporte_estado_maquina_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Aún no hay reportes de estado de máquinas!
            </p>
            <p>
                Los reportes se generan automáticamente cada semana.
            </p>
        </field>
        <field name="context">{
            'search_default_group_by_estado': 1,
            'search_default_filter_esta_semana': 1
        }</field>
    </record>

    <menuitem id="menu_reporte_estado_maquinas_ver" 
              name="Ver Reportes" 
              parent="menu_reporte_estado_maquinas_main" 
              action="action_reporte_estado_maquinas" 
              sequence="10"/>

    <!-- Wizard generador de reportes -->
    <record id="action_reporte_estado_maquinas_wizard" model="ir.actions.act_window">
        <field name="name">Generar Reporte Estado Máquinas</field>
        <field name="res_model">reporte.estado.maquina.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_reporte_estado_maquina_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_reporte_estado_maquinas_generar" 
              name="Generar Reporte" 
              parent="menu_reporte_estado_maquinas_main" 
              action="action_reporte_estado_maquinas_wizard" 
              sequence="20"/>

    <!-- Reportes semana actual -->
    <record id="action_reporte_estado_maquinas_semana_actual" model="ir.actions.act_window">
        <field name="name">Reportes Semana Actual</field>
        <field name="res_model">reporte.estado.maquina</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_reporte_estado_maquina_list"/>
        <field name="domain">[('fecha_generacion', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]</field>
        <field name="context">{'search_default_group_by_estado': 1}</field>
    </record>

    <menuitem id="menu_reporte_estado_maquinas_semana" 
              name="Semana Actual" 
              parent="menu_reporte_estado_maquinas_main" 
              action="action_reporte_estado_maquinas_semana_actual" 
              sequence="30"/>

    <!-- Separador en reportes -->
    <menuitem id="menu_reporte_estado_maquinas_separator" 
              name="────────────────" 
              parent="menu_reporte_estado_maquinas_main" 
              sequence="40"/>

    <!-- Máquinas sin revisar -->
    <record id="action_reporte_estado_maquinas_sin_revisar" model="ir.actions.act_window">
        <field name="name">Máquinas Sin Revisar</field>
        <field name="res_model">reporte.estado.maquina</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_reporte_estado_maquina_list"/>
        <field name="domain">[
            ('estado_maquina', '=', 'sin_revisar'),
            ('fecha_generacion', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))
        ]</field>
    </record>

    <menuitem id="menu_reporte_estado_maquinas_sin_revisar" 
              name="Sin Revisar" 
              parent="menu_reporte_estado_maquinas_main" 
              action="action_reporte_estado_maquinas_sin_revisar" 
              sequence="50"/>

    <!-- Máquinas con problemas -->
    <record id="action_reporte_estado_maquinas_con_problemas" model="ir.actions.act_window">
        <field name="name">Máquinas Con Problemas</field>
        <field name="res_model">reporte.estado.maquina</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_reporte_estado_maquina_list"/>
        <field name="domain">[
            ('estado_maquina', '=', 'con_problemas'),
            ('fecha_generacion', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))
        ]</field>
    </record>

    <menuitem id="menu_reporte_estado_maquinas_problemas" 
              name="Con Problemas" 
              parent="menu_reporte_estado_maquinas_main" 
              action="action_reporte_estado_maquinas_con_problemas" 
              sequence="60"/>

    <!-- Máquinas de partes -->
    <record id="action_reporte_estado_maquinas_partes" model="ir.actions.act_window">
        <field name="name">Máquinas de Partes</field>
        <field name="res_model">reporte.estado.maquina</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_reporte_estado_maquina_list"/>
        <field name="domain">[
            ('estado_maquina', '=', 'partes'),
            ('fecha_generacion', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))
        ]</field>
    </record>

    <menuitem id="menu_reporte_estado_maquinas_partes" 
              name="De Partes" 
              parent="menu_reporte_estado_maquinas_main" 
              action="action_reporte_estado_maquinas_partes" 
              sequence="70"/>

    <!-- ============================================ -->
    <!-- SECCIÓN CONFIGURACIÓN -->
    <!-- ============================================ -->
    
    <menuitem name="Configuración" 
              id="sat.ajustes" 
              parent="sat_menu_root" 
              sequence="200"/>

    <!-- === CATÁLOGOS BÁSICOS === -->
    
    <!-- Marcas -->
    <record model="ir.actions.act_window" id="sat.action_marca_window">
        <field name="name">Marcas</field>
        <field name="res_model">marca.marca</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Marcas" 
              id="sat.menu_marca" 
              parent="sat.ajustes" 
              action="sat.action_marca_window" 
              sequence="10"/>

    <!-- Modelos -->
    <record model="ir.actions.act_window" id="sat.action_modelo_window">
        <field name="name">Modelo</field>
        <field name="res_model">modelo.maquina</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem name="Modelo" 
              id="sat.menu_modelo" 
              parent="sat.ajustes" 
              action="sat.action_modelo_window" 
              sequence="20"/>

    <!-- Tipo de máquina -->

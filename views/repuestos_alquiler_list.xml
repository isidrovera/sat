<odoo>
    <template id="repuestos_alquiler_list" name="Lista de Repuestos">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <h2>Repuestos para el Alquiler: <t t-esc="alquiler.name"/></h2>
                <input type="text" id="search" placeholder="Buscar por descripción..." class="form-control mb-3" value=""/>
                <script>
                    document.getElementById('search').addEventListener('input', function(e){
                        window.location.href = '/alquiler/repuestos/' + <t t-esc="alquiler.id"/> + '?search=' + e.target.value;
                    });
                </script>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Pedido #</th>
                            <th>Descripción</th>
                            <th>Cantidad</th>
                            <th>Contometro Anterior</th>                            
                            <th>Contometro último cambio</th>
                            <th>Rendimiento</th>
                            <th>Solicitante</th>
                            
                            <!-- Agrega más columnas según sea necesario -->
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="repuestos" t-as="repuesto">
                            <tr>
                                <td><t t-esc="repuesto.create_date"/></td>
                                <td><t t-esc="repuesto.referencia_reparacion_id"/></td>
                                <td><t t-esc="repuesto.name"/></td>
                                <td><t t-esc="repuesto.cantidad"/></td>
                                <td><t t-esc="repuesto.contometro_ultimo"/></td>
                                <td><t t-esc="repuesto.contometro_actual"/></td>
                                <td><t t-esc="repuesto.duracion_repuesto"/></td>
                                <td><t t-esc="repuesto.solicitante_id"/></td>
                                <!-- Agrega más campos según sea necesario -->
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>

        <t t-call="website.layout">
            <div class="container mt16 mb16">
                <div class="jumbotron text-center">
                    <h1 class="display-3">¡Gracias!</h1>
                    <p class="lead">Hemos recibido tu solicitud y nos pondremos en contacto contigo pronto.</p>
                    <hr class="my-4"/>

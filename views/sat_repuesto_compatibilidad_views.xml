<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data>
    <!-- ============================================================= -->
    <!-- BIBLIOTECA DE COMPATIBILIDADES - ODOO 19 / SAT EXISTENTE       -->
    <!-- Usa exclusivamente campos de sat.repuesto.compatibilidad     -->
    <!-- y sat.repuesto.foto. No modifica vistas/modelos anteriores.   -->
    <!-- ============================================================= -->

    <record id="view_sat_repuesto_compatibilidad_search" model="ir.ui.view">
      <field name="name">sat.repuesto.compatibilidad.search</field>
      <field name="model">sat.repuesto.compatibilidad</field>
      <field name="arch" type="xml">
        <search>
          <field name="subparte_id" string="Buscar subparte" filter_domain="[('subparte_id.name', 'ilike', self)]"/>
          <field name="name" string="N.º referencia"/>
          <field name="codigo_parte" string="Código de parte"/>
          <field name="componente_id"/>
          <field name="marca_id"/>
          <field name="toner_id"/>
          <field name="modelo_maquina_ids" string="Modelo compatible"/>
          <separator/>
          <filter name="filter_verificados" string="Verificados" domain="[('estado','=','verificado')]"/>
          <filter name="filter_pendientes" string="Pendientes" domain="[('estado','in',['borrador','pendiente'])]"/>
          <filter name="filter_repuestos" string="Repuestos" domain="[('tipo_registro','=','repuesto')]"/>
          <filter name="filter_toner" string="Tóner" domain="[('tipo_registro','=','toner')]"/>
          <filter name="filter_con_fotos" string="Con fotografías" domain="[('foto_ids','!=',False)]"/>
          <filter name="filter_archivados" string="Archivados" domain="[('active','=',False)]"/>
          <group>
            <filter name="group_componente" string="Componente" context="{'group_by':'componente_id'}"/>
            <filter name="group_subparte" string="Subparte" context="{'group_by':'subparte_id'}"/>
            <filter name="group_marca" string="Marca" context="{'group_by':'marca_id'}"/>
            <filter name="group_tipo" string="Tipo" context="{'group_by':'tipo_registro'}"/>
            <filter name="group_estado" string="Estado" context="{'group_by':'estado'}"/>
          </group>
        </search>
      </field>
    </record>

    <record id="view_sat_repuesto_compatibilidad_list" model="ir.ui.view">
      <field name="name">sat.repuesto.compatibilidad.list</field>
      <field name="model">sat.repuesto.compatibilidad</field>
      <field name="arch" type="xml">
        <list string="Biblioteca de compatibilidades" decoration-success="estado == 'verificado'" decoration-muted="not active" multi_edit="1">
          <field name="active" column_invisible="True"/>
          <field name="subparte_id" string="Subparte" optional="show"/>
          <field name="name" string="N.º referencia"/>
          <field name="tipo_registro" widget="badge"/>
          <field name="componente_id" optional="show"/>
          <field name="toner_id" optional="hide"/>
          <field name="codigo_parte" optional="show"/>
          <field name="marca_id" optional="show"/>
          <field name="color" optional="hide"/>
          <field name="modelo_count" string="Modelos" optional="show"/>
          <field name="foto_count" string="Fotos" optional="show"/>
          <field name="estado" widget="badge" decoration-success="estado == 'verificado'" decoration-warning="estado == 'pendiente'" decoration-danger="estado == 'descartado'"/>
          <field name="write_date" optional="hide"/>
        </list>
      </field>
    </record>

    <record id="view_sat_repuesto_compatibilidad_kanban" model="ir.ui.view">
      <field name="name">sat.repuesto.compatibilidad.kanban</field>
      <field name="model">sat.repuesto.compatibilidad</field>
      <field name="arch" type="xml">
        <kanban string="Catálogo técnico" class="o_kanban_mobile" sample="0">
  <field name="foto_principal_url"/><field name="name"/><field name="tipo_registro"/>
  <field name="subparte_id"/><field name="toner_id"/><field name="componente_id"/>
  <field name="codigo_parte"/><field name="estado"/><field name="foto_count"/>
  <field name="modelos_por_marca_html"/>
  <templates><t t-name="card">
    <div class="d-flex flex-column h-100 gap-2 p-2" style="min-width:0;">
      <div class="d-flex gap-3 align-items-start">
        <div class="rounded bg-light overflow-hidden flex-shrink-0" style="width:38%;height:135px;">
          <img t-if="record.foto_principal_url.raw_value" t-att-src="record.foto_principal_url.raw_value" class="w-100 h-100" style="object-fit:contain;" alt="Repuesto" loading="lazy"/>
          <div t-else="" class="h-100 d-flex align-items-center justify-content-center text-muted"><i class="fa fa-image fa-2x"/></div>
        </div>
        <div class="flex-grow-1" style="min-width:0;">
          <div class="mb-2">
            <span t-if="record.estado.raw_value == 'verificado'" class="badge rounded-pill text-bg-success">Verificado</span>
            <span t-elif="record.estado.raw_value == 'pendiente'" class="badge rounded-pill text-bg-warning">Pendiente</span>
            <span t-elif="record.estado.raw_value == 'descartado'" class="badge rounded-pill text-bg-danger">Descartado</span>
            <span t-else="" class="badge rounded-pill text-bg-secondary">Preparación</span>
          </div>
          <div class="fw-bold text-break fs-6"><t t-if="record.tipo_registro.raw_value == 'toner'"><field name="toner_id"/></t><t t-else=""><field name="subparte_id"/></t></div>
          <div class="small text-muted mt-1"><field name="name"/></div>
          <div class="small mt-1" t-if="record.tipo_registro.raw_value != 'toner'"><field name="componente_id"/></div>
          <div class="small mt-1 text-break" t-if="record.codigo_parte.raw_value">Código: <field name="codigo_parte"/></div>
        </div>
      </div>
      <div class="border-top pt-2">
        <div class="fw-semibold small mb-2">Equipos compatibles</div>
        <field name="modelos_por_marca_html" widget="html" readonly="1"/>
      </div>
      <div class="d-flex align-items-center justify-content-between border-top pt-2 mt-auto gap-2">
        <span class="text-muted small"><i class="fa fa-camera me-1"/> <field name="foto_count"/> archivos</span>
        <a type="open" class="btn btn-outline-primary btn-sm">Ver ficha <i class="fa fa-arrow-right ms-1"/></a>
      </div>
    </div>
  </t></templates>
</kanban></field>
    </record>

    <record id="view_sat_repuesto_compatibilidad_form" model="ir.ui.view">
      <field name="name">sat.repuesto.compatibilidad.form</field>
      <field name="model">sat.repuesto.compatibilidad</field>
      <field name="arch" type="xml">
        <form string="Referencia de repuesto / consumible">
          <header>
            <button name="action_verificar" type="object" string="Verificar compatibilidad" class="btn-primary" icon="fa-check" invisible="estado == 'verificado'"/>
            <button name="action_desvalidar" type="object" string="Enviar a revisión" icon="fa-undo" invisible="estado != 'verificado'"/>
            <button name="action_marcar_pendiente" type="object" string="Marcar pendiente" invisible="estado in ['pendiente','verificado']"/>
            <button name="action_asignar_referencia" type="object" string="Generar N.º REP" icon="fa-hashtag" invisible="name and name not in ['Nuevo', '/']"/>
            <field name="estado" widget="statusbar" statusbar_visible="borrador,pendiente,verificado"/>
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button name="action_subir_foto" type="object" class="oe_stat_button" icon="fa-cloud-upload">
                <div class="o_stat_info"><span class="o_stat_text">Agregar</span><span class="o_stat_text">Archivos</span></div>
              </button>
            </div>
            <div class="oe_title">
              <label for="name"/>
              <h1><field name="name" readonly="1" placeholder="Nuevo (se asigna al guardar)"/></h1>
              </div>
            <group>
              <group string="Identificación">
                <field name="tipo_registro" widget="radio" options="{'horizontal': True}"/>
                <field name="componente_id" invisible="tipo_registro != 'repuesto'" required="tipo_registro == 'repuesto'" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="subparte_permitida_ids" invisible="1"/>
                <field name="subparte_id" invisible="tipo_registro != 'repuesto'" required="tipo_registro == 'repuesto'" domain="[('id','in',subparte_permitida_ids)]" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="toner_id" invisible="tipo_registro != 'toner'" required="tipo_registro == 'toner'" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="marca_id" options="{'no_create': True}"/>
                <field name="color"/>
              </group>
              <group string="Referencia técnica">
                <field name="codigo_parte" placeholder="Código OEM / código de la pieza"/>
                <field name="codigos_alternativos" placeholder="Códigos equivalentes, alias de búsqueda..."/>
                <field name="active" widget="boolean_toggle"/>
                </group>
            </group>
            <group string="Compatibilidad por marca" col="1">
  <field name="modelos_por_marca_html" widget="html" readonly="1" nolabel="1"/>
  <field name="modelo_maquina_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}" placeholder="Agregar modelos compatibles..."/>
</group><group string="Galería multimedia" col="1">
  <button name="action_subir_foto" type="object" string="Agregar archivos" class="btn-primary" icon="fa-plus" invisible="not id"/>
<field name="foto_ids" nolabel="1" readonly="1" mode="kanban">
                  <kanban class="o_kanban_mobile" create="false" edit="false" delete="false">
  <field name="name"/><field name="principal"/><field name="mime_type"/><field name="media_url"/><field name="media_tipo"/><field name="sharepoint_web_url"/><field name="notas"/>
  <templates><t t-name="card">
    <div class="d-flex flex-column gap-2 p-2">
      <div class="bg-light rounded overflow-hidden d-flex align-items-center justify-content-center" style="height:175px;">
        <img t-if="record.media_tipo.raw_value == 'imagen' and record.media_url.raw_value" t-att-src="record.media_url.raw_value" class="w-100 h-100" style="object-fit:contain;" alt="Foto SharePoint" loading="lazy"/>
        <video t-elif="record.media_tipo.raw_value == 'video' and record.media_url.raw_value" t-att-src="record.media_url.raw_value" controls="controls" preload="none" class="w-100" style="max-height:175px;"/>
        <i t-else="" class="fa fa-file fa-3x text-muted"/>
      </div>
      <div class="d-flex justify-content-between align-items-start gap-2">
        <div class="fw-semibold text-break"><field name="name"/></div>
        <span t-if="record.principal.raw_value" class="badge text-bg-primary">Principal</span>
      </div>
      <div class="small text-muted text-break" t-if="record.notas.raw_value"><field name="notas"/></div>
      <a t-if="record.sharepoint_web_url.raw_value" t-att-href="record.sharepoint_web_url.raw_value" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">Ver original</a>
    </div>
  </t></templates>
</kanban>
                </field>
              </group><notebook>
              <page string="Información técnica" name="informacion">
                <group>
                  <field name="condiciones" placeholder="Anote restricciones por serie, versión, color, región o adaptación." nolabel="1"/>
              <field name="observaciones" placeholder="Descripción, equivalencias y recomendaciones."/>
                  <field name="fuente"/>
                  <field name="referencia_documental" widget="url"/>
                </group>
              </page>
              <page string="Verificación" name="verificacion">
                <group>
                  <field name="verificado_por_id" readonly="1"/>
                  <field name="fecha_verificacion" readonly="1"/>
                  <field name="estado" readonly="1"/>
                </group>
              </page>
            </notebook>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>

    <record id="view_sat_repuesto_foto_list" model="ir.ui.view">
      <field name="name">sat.repuesto.foto.list</field>
      <field name="model">sat.repuesto.foto</field>
      <field name="arch" type="xml">
        <list string="Archivos de repuestos" create="false">
          <field name="compatibilidad_id"/>
          <field name="name"/>
          <field name="principal"/>
          <field name="notas" optional="show"/>
          <field name="sharepoint_web_url" widget="url" optional="show"/>
          <button name="action_abrir_sharepoint" type="object" icon="fa-external-link" title="Ver original"/>
        </list>
      </field>
    </record>

    <!-- Acción independiente: añadir en el archivo de acciones que ya existe
         si allí centralizas todas las acciones de SAT. No duplicar IDs. -->
    <record id="action_sat_repuesto_compatibilidad" model="ir.actions.act_window">
      <field name="name">Biblioteca de Repuestos</field>
      <field name="res_model">sat.repuesto.compatibilidad</field>
      <field name="view_mode">kanban,list,form</field>
      <field name="search_view_id" ref="view_sat_repuesto_compatibilidad_search"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">Registra la primera referencia técnica</p>
        <p>Relaciona componentes, subpartes o tóner con sus modelos compatibles y galería multimedia.</p>
      </field>
    </record>
    <menuitem id="menu_sat_repuesto_biblioteca" name="Biblioteca de Repuestos" parent="sat_menu_root" action="action_sat_repuesto_compatibilidad" sequence="85" groups="base.group_user"/>
  </data>
</odoo>

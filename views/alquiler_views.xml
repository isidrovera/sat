<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data >
        <!-- Panel de onboarding -->
        <record id="model_alquiler_onboarding" model="onboarding.onboarding">
            <field name="name">Registro de Máquinas en Alquiler</field>
            <field name="route_name">alquiler</field>
            <field name="panel_close_action_name">action_close_panel_alquiler</field>
            <field name="step_ids" eval="[(5, 0, 0)]"/>
        </record>

        <!-- Paso de onboarding -->
        <record id="onboarding_step_alquiler_register" model="onboarding.onboarding.step">
            <field name="title">Registrar Nueva Máquina</field>
            <field name="description">Configure una nueva máquina para alquiler</field>
            <field name="button_text">Registrar Máquina</field>
            <field name="panel_step_open_action_name">action_open_alquiler_onboarding_sample</field>
            <field name="done_text">¡Listo!</field>
        </record>

        <!-- Agregar el paso al panel -->
        <record id="model_alquiler_onboarding" model="onboarding.onboarding">
            <field name="step_ids" eval="[(4, ref('onboarding_step_alquiler_register'))]"/>
        </record>
    </data>
</odoo>
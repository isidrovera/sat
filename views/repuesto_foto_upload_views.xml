<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- ============================================================ -->
    <!-- BIBLIOTECA DE REPUESTOS: ASISTENTE DE FOTOGRAFÍAS            -->
    <!-- Odoo 19 / SharePoint / sin adjuntos permanentes en Odoo       -->
    <!-- ============================================================ -->

    <record id="view_sat_repuesto_foto_upload_wizard_form" model="ir.ui.view">
      <field name="name">sat.repuesto.foto.upload.wizard.form</field>
      <field name="model">sat.repuesto.foto.upload.wizard</field>
      <field name="arch" type="xml">
        <form string="Agregar fotografía a SharePoint" create="false" edit="true" delete="false">
          <sheet>
            <div class="oe_title">
              <h1>Agregar fotografía</h1>
              <p class="text-muted">Guarda la imagen original en la biblioteca SharePoint seleccionada.</p>
            </div>

            <group>
              <group string="Referencia">
                <field name="compatibilidad_id" readonly="1" options="{'no_open': True}"/>
                <field name="location_id" options="{'no_create': True, 'no_create_edit': True}"/>
              </group>
              <group string="Información de la fotografía">
                <field name="principal"/>
                <field name="notas" placeholder="Ej.: vista frontal, etiqueta o código impreso"/>
              </group>
            </group>

            <group string="Archivo">
              <field name="imagen_filename" invisible="1"/>
              <field name="imagen" filename="imagen_filename" widget="binary" required="1"/>
              <div class="text-muted">
                Formatos admitidos: JPG, JPEG, PNG y WebP. La biblioteca no establece un límite propio de peso; se aplican los límites de transferencia del servidor y Microsoft 365.
              </div>
            </group>
          </sheet>
          <footer>
            <button name="action_upload" string="Guardar en SharePoint" type="object" class="btn-primary" icon="fa-cloud-upload"/>
            <button string="Cancelar" special="cancel" class="btn-secondary"/>
          </footer>
        </form>
      </field>
    </record>

    <record id="action_sat_repuesto_foto_upload_wizard" model="ir.actions.act_window">
      <field name="name">Agregar fotografía</field>
      <field name="res_model">sat.repuesto.foto.upload.wizard</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="view_sat_repuesto_foto_upload_wizard_form"/>
      <field name="target">new</field>
      <field name="context">{'default_compatibilidad_id': active_id}</field>
    </record>

  </data>
</odoo>
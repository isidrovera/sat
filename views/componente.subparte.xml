<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- SEARCH -->
    <record id="view_componente_subparte_search" model="ir.ui.view">
      <field name="name">componente.subparte.search</field>
      <field name="model">componente.subparte</field>
      <field name="arch" type="xml">
        <search string="Buscar Subpartes">
          <field name="name"/>
          
        </search>
      </field>
    </record>

    <!-- LIST -->
    <record id="view_componente_subparte_list" model="ir.ui.view">
      <field name="name">componente.subparte.list</field>
      <field name="model">componente.subparte</field>
      <field name="arch" type="xml">
        <list string="Subpartes" create="1" edit="1" delete="0">
          <field name="name"/>
          
        </list>
      </field>
    </record>

    <!-- FORM -->
    <record id="view_componente_subparte_form" model="ir.ui.view">
      <field name="name">componente.subparte.form</field>
      <field name="model">componente.subparte</field>
      <field name="arch" type="xml">
        <form string="Subparte">
          <group>
            <field name="name"/>
           
          </group>
        </form>
      </field>
    </record>

    </data>
</odoo>

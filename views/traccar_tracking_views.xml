<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  Parámetro del sistema: API Key integración Traccar    -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <record id="traccar_api_key_param" model="ir.config_parameter">
      <field name="key">traccar.api_key</field>
      <field name="value">CAMBIAR_POR_TU_API_KEY_SEGURA</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  VISTAS: tecnico.dispositivo.gps                       -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <record id="view_tecnico_dispositivo_gps_list" model="ir.ui.view">
      <field name="name">tecnico.dispositivo.gps.list</field>
      <field name="model">tecnico.dispositivo.gps</field>
      <field name="arch" type="xml">
        <list string="Dispositivos GPS" default_order="user_id">
          <field name="user_id" widget="many2one_avatar"/>
          <field name="nombre_dispositivo"/>
          <field name="traccar_device_id"/>
          <field name="traccar_unique_id"/>
          <field name="activo" widget="boolean_toggle"/>
        </list>
      </field>
    </record>

    <record id="view_tecnico_dispositivo_gps_form" model="ir.ui.view">
      <field name="name">tecnico.dispositivo.gps.form</field>
      <field name="model">tecnico.dispositivo.gps</field>
      <field name="arch" type="xml">
        <form string="Dispositivo GPS">
          <sheet>
            <group>
              <group string="Técnico">
                <field name="user_id" widget="many2one_avatar"/>
                <field name="activo" widget="boolean_toggle"/>
              </group>
              <group string="Dispositivo Traccar">
                <field name="traccar_device_id"/>
                <field name="traccar_unique_id"
                       placeholder="IMEI del celular o ID del rastreador"/>
                <field name="nombre_dispositivo"
                       placeholder="Ej: Celular Samsung A54 - Juan"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="view_tecnico_dispositivo_gps_search" model="ir.ui.view">
      <field name="name">tecnico.dispositivo.gps.search</field>
      <field name="model">tecnico.dispositivo.gps</field>
      <field name="arch" type="xml">
        <search string="Dispositivos GPS">
          <field name="user_id"/>
          <field name="nombre_dispositivo"/>
          <field name="traccar_unique_id"/>
          <separator/>
          <filter name="filter_activos" string="Activos" domain="[('activo', '=', True)]"/>
          <filter name="filter_inactivos" string="Inactivos" domain="[('activo', '=', False)]"/>
        </search>
      </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  ACCIÓN                                                -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <record id="action_tecnico_dispositivo_gps" model="ir.actions.act_window">
      <field name="name">Dispositivos GPS Técnicos</field>
      <field name="res_model">tecnico.dispositivo.gps</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="view_tecnico_dispositivo_gps_search"/>
      <field name="context">{'search_default_filter_activos': 1}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Vincular técnicos con dispositivos GPS
        </p>
        <p>
          Configure la relación entre cada técnico y su dispositivo
          de rastreo en Traccar (celular con OsmAnd o rastreador físico).
        </p>
      </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  MENÚ (bajo sat.ajustes / Configuración)               -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <menuitem id="menu_gps_tracking_separator"
              name="━━━━━━━━━━━ GPS Tracking ━━━━━━━━━━━"
              parent="sat.ajustes"
              sequence="170"/>

    <menuitem id="menu_dispositivos_gps"
              name="Dispositivos GPS Técnicos"
              parent="sat.ajustes"
              action="action_tecnico_dispositivo_gps"
              sequence="171"
              groups="base.group_system"/>

  </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="customer_records_page" name="Lista de maquinas">
        <t t-call="website.layout">
            <div class="container py-5 cust-records">
                <!-- Encabezado -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div>
                            <h1 class="mb-1 fw-bold text-primary">
                                <i class="fa fa-building me-2"/>
                                <t t-esc="cliente"/>
                            </h1>
                            <p class="text-muted mb-0">
                                <i class="fa fa-desktop me-1"/>
                                <span id="totalRecords"><t t-esc="len(registros)"/></span> equipos registrados
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Barra de búsqueda -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="input-group input-group-lg shadow-sm">
                            <span class="input-group-text bg-white">
                                <i class="fa fa-search text-muted"/>
                            </span>
                            <input type="text"
                                   id="searchInput"
                                   class="form-control"
                                   placeholder="Buscar por modelo, serie o área..."/>
                            <button class="btn btn-outline-secondary" type="button" id="clearSearchBtn">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Vista DESKTOP: tabla -->
                <div class="cust-records-desktop">
                    <div class="cust-records-desktop-card">
                        <div class="cust-table-wrapper">
                            <table class="cust-table" id="recordsTable">
                                <thead>
                                    <tr>
                                        <th><i class="fa fa-tag me-2"/>Modelo</th>
                                        <th><i class="fa fa-barcode me-2"/>Serie</th>
                                        <th><i class="fa fa-map-marker me-2"/>Área</th>
                                        <th class="text-center"><i class="fa fa-cog me-2"/>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="registros" t-as="registro">
                                        <tr class="record-row">
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="cust-icon-circle me-3">
                                                        <i class="fa fa-print text-primary"/>
                                                    </div>
                                                    <span class="fw-semibold">
                                                        <t t-esc="registro.name.name if registro.name else ''"/>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="cust-badge">
                                                    <t t-esc="registro.serie or ''"/>
                                                </span>
                                            </td>
                                            <td>
                                                <i class="fa fa-map-marker-alt text-muted me-2"/>
                                                <t t-esc="registro.ubicacion_instalacion or ''"/>
                                            </td>
                                            <td class="text-center">
                                                <div class="cust-actions">
                                                    <a t-att-href="'/ticket/reportar_incidencia?id_registro=%s&amp;user_name=%s&amp;phone_number=%s' % (registro.id, user_name or '', phone_number or '')"
                                                       class="cust-btn cust-btn-danger">
                                                        <i class="fa fa-exclamation-circle me-1"/>
                                                        <span>Incidencia</span>
                                                    </a>
                                                    <a t-att-href="'/toner/solicitar_toner?id_registro=%s&amp;user_name=%s&amp;phone_number=%s' % (registro.id, user_name or '', phone_number or '')"
                                                       class="cust-btn cust-btn-primary">
                                                        <i class="fa fa-print me-1"/>
                                                        <span>Tóner</span>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div id="noResults" class="cust-empty">
                        <i class="fa fa-search fa-3x text-muted mb-3"/>
                        <h5 class="text-muted">No se encontraron resultados</h5>
                        <p class="text-muted">Intenta con otros términos de búsqueda</p>
                    </div>
                </div>

                <!-- Vista MÓVIL: cards -->
                <div class="cust-records-mobile">
                    <t t-foreach="registros" t-as="registro">
                        <div class="record-card">
                            <div class="record-card-body">
                                <div class="d-flex align-items-start mb-3">
                                    <div class="cust-icon-square me-3">
                                        <i class="fa fa-print fa-lg text-primary"/>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h5 class="fw-bold mb-1">
                                            <t t-esc="registro.name.name if registro.name else ''"/>
                                        </h5>
                                        <span class="cust-badge">
                                            <i class="fa fa-barcode me-1"/>
                                            <t t-esc="registro.serie or ''"/>
                                        </span>
                                    </div>
                                </div>

                                <div class="cust-card-section">
                                    <p class="mb-0 text-muted">
                                        <i class="fa fa-map-marker-alt me-2"/>
                                        <small>Ubicación:</small>
                                    </p>
                                    <p class="mb-0 fw-semibold">
                                        <t t-esc="registro.ubicacion_instalacion or ''"/>
                                    </p>
                                </div>

                                <div class="cust-actions cust-actions-vertical">
                                    <a t-att-href="'/ticket/reportar_incidencia?id_registro=%s&amp;user_name=%s&amp;phone_number=%s' % (registro.id, user_name or '', phone_number or '')"
                                       class="cust-btn cust-btn-danger">
                                        <i class="fa fa-exclamation-circle me-2"/>
                                        Reportar Incidencia
                                    </a>
                                    <a t-att-href="'/toner/solicitar_toner?id_registro=%s&amp;user_name=%s&amp;phone_number=%s' % (registro.id, user_name or '', phone_number or '')"
                                       class="cust-btn cust-btn-primary">
                                        <i class="fa fa-print me-2"/>
                                        Solicitar Tóner
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>

                    <div id="noResultsMobile" class="cust-empty">
                        <i class="fa fa-search fa-3x text-muted mb-3"/>
                        <h5 class="text-muted">No se encontraron resultados</h5>
                        <p class="text-muted">Intenta con otros términos de búsqueda</p>
                    </div>
                </div>
            </div>

            <!-- Estilos CSS auto-contenidos (no dependen de Bootstrap responsive) -->
            <style>
                /* Mostrar desktop por defecto, ocultar móvil */
                .cust-records .cust-records-desktop { display: block; }
                .cust-records .cust-records-mobile  { display: none; }

                /* Cambio a móvil bajo 768px */
                @media (max-width: 767.98px) {
                    .cust-records .cust-records-desktop { display: none; }
                    .cust-records .cust-records-mobile  { display: block; }
                }

                /* Card que envuelve la tabla */
                .cust-records-desktop-card {
                    background: #fff;
                    border-radius: 12px;
                    box-shadow: 0 .125rem .25rem rgba(0,0,0,.075);
                    overflow: visible;
                    margin-bottom: 1rem;
                }

                .cust-table-wrapper {
                    width: 100%;
                    overflow-x: auto;
                    border-radius: 12px;
                }

                /* Tabla */
                .cust-table {
                    width: 100%;
                    border-collapse: collapse;
                    margin: 0;
                    background: #fff;
                }

                .cust-table thead tr {
                    background: #f8f9fa;
                }

                .cust-table thead th {
                    text-transform: uppercase;
                    font-size: 0.75rem;
                    font-weight: 600;
                    color: #6c757d;
                    padding: 1rem;
                    border: 0;
                    text-align: left;
                }

                .cust-table tbody tr {
                    border-top: 1px solid #dee2e6;
                    transition: background-color 0.2s ease;
                }

                .cust-table tbody tr:hover {
                    background-color: #f8f9fa;
                }

                .cust-table tbody td {
                    padding: 1rem;
                    vertical-align: middle;
                }

                /* Icono circular */
                .cust-icon-circle {
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    background: rgba(13, 110, 253, 0.1);
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    flex-shrink: 0;
                }

                .cust-icon-square {
                    width: 50px;
                    height: 50px;
                    border-radius: 8px;
                    background: rgba(13, 110, 253, 0.1);
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    flex-shrink: 0;
                }

                /* Badge */
                .cust-badge {
                    display: inline-block;
                    background: #f1f3f5;
                    color: #212529;
                    padding: 0.4rem 0.75rem;
                    border-radius: 6px;
                    font-size: 0.85rem;
                    font-weight: 500;
                }

                /* Acciones */
                .cust-actions {
                    display: flex;
                    gap: 0.5rem;
                    justify-content: center;
                    flex-wrap: wrap;
                }

                .cust-actions-vertical {
                    flex-direction: column;
                    align-items: stretch;
                }

                .cust-btn {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    padding: 0.5rem 1rem;
                    border-radius: 8px;
                    font-size: 0.875rem;
                    font-weight: 500;
                    text-decoration: none;
                    border: 0;
                    cursor: pointer;
                    transition: all 0.2s ease;
                    box-shadow: 0 .125rem .25rem rgba(0,0,0,.075);
                }

                .cust-btn:hover {
                    transform: translateY(-1px);
                    text-decoration: none;
                }

                .cust-btn-danger {
                    background: #dc3545;
                    color: #fff;
                }

                .cust-btn-danger:hover {
                    background: #bb2d3b;
                    color: #fff;
                }

                .cust-btn-primary {
                    background: #0d6efd;
                    color: #fff;
                }

                .cust-btn-primary:hover {
                    background: #0b5ed7;
                    color: #fff;
                }

                /* Tarjetas móvil */
                .record-card {
                    background: #fff;
                    border-radius: 12px;
                    box-shadow: 0 .125rem .25rem rgba(0,0,0,.075);
                    margin-bottom: 1rem;
                    overflow: hidden;
                    border-left: 4px solid transparent;
                    transition: all 0.3s ease;
                }

                .record-card:hover {
                    border-left-color: #0d6efd;
                }

                .record-card-body {
                    padding: 1.25rem;
                }

                .cust-card-section {
                    margin-bottom: 1rem;
                    padding-bottom: 1rem;
                    border-bottom: 1px solid #dee2e6;
                }

                /* Estado vacío */
                .cust-empty {
                    text-align: center;
                    padding: 3rem 1rem;
                    display: none;
                }

                .cust-empty.show {
                    display: block;
                }

                /* Ajustes para botones pequeños en tabla desktop */
                @media (min-width: 992px) {
                    .cust-records-desktop .cust-btn {
                        padding: 0.5rem 1rem;
                    }
                }

                @media (max-width: 991.98px) and (min-width: 768px) {
                    .cust-records-desktop .cust-btn span {
                        display: none;
                    }
                    .cust-records-desktop .cust-btn i {
                        margin: 0 !important;
                    }
                }
            </style>

            <!-- JS de filtrado -->
            <script type="text/javascript">
                (function () {
                    function filterRecords() {
                        var input = document.getElementById('searchInput');
                        if (!input) return;

                        var filter = input.value.toLowerCase().trim();

                        // Tabla desktop
                        var rows = document.querySelectorAll('#recordsTable tbody tr');
                        var visibleRows = 0;
                        rows.forEach(function (row) {
                            var text = (row.textContent || '').toLowerCase();
                            if (filter === '' || text.indexOf(filter) !== -1) {
                                row.style.display = '';
                                visibleRows++;
                            } else {
                                row.style.display = 'none';
                            }
                        });

                        var noResults = document.getElementById('noResults');
                        if (noResults) {
                            if (visibleRows === 0 &amp;&amp; filter !== '') {
                                noResults.classList.add('show');
                            } else {
                                noResults.classList.remove('show');
                            }
                        }

                        // Cards móvil
                        var cards = document.querySelectorAll('.record-card');
                        var visibleCards = 0;
                        cards.forEach(function (card) {
                            var text = (card.textContent || '').toLowerCase();
                            if (filter === '' || text.indexOf(filter) !== -1) {
                                card.style.display = '';
                                visibleCards++;
                            } else {
                                card.style.display = 'none';
                            }
                        });

                        var noResultsMobile = document.getElementById('noResultsMobile');
                        if (noResultsMobile) {
                            if (visibleCards === 0 &amp;&amp; filter !== '') {
                                noResultsMobile.classList.add('show');
                            } else {
                                noResultsMobile.classList.remove('show');
                            }
                        }
                    }

                    function clearSearch() {
                        var input = document.getElementById('searchInput');
                        if (input) {
                            input.value = '';
                            filterRecords();
                        }
                    }

                    function init() {
                        var searchInput = document.getElementById('searchInput');
                        var clearBtn = document.getElementById('clearSearchBtn');

                        if (searchInput) {
                            searchInput.addEventListener('input', filterRecords);
                        }
                        if (clearBtn) {
                            clearBtn.addEventListener('click', clearSearch);
                        }
                    }

                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', init);
                    } else {
                        init();
                    }
                })();
            </script>

        </t>
    </template>

    <template id="pagina_sin_registros" name="No se encontraron registros">
        <t t-call="website.layout">
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body text-center p-5">
                                <div class="mb-4">
                                    <i class="fa fa-inbox fa-4x text-muted"/>
                                </div>
                                <h3 class="mb-3 fw-bold">No se encontraron registros</h3>
                                <p class="text-muted mb-4">
                                    No hay registros de alquiler disponibles para el cliente:
                                    <strong class="text-primary"><t t-esc="cliente"/></strong>
                                </p>
                                <t t-if="user_name">
                                    <p class="mb-2">
                                        <i class="fa fa-user me-2 text-muted"/>
                                        <span t-esc="user_name"/>
                                    </p>
                                </t>
                                <t t-if="phone_number">
                                    <p class="mb-4">
                                        <i class="fa fa-phone me-2 text-muted"/>
                                        <span t-esc="phone_number"/>
                                    </p>
                                </t>
                                <a href="/" class="btn btn-primary btn-lg px-5 shadow-sm">
                                    <i class="fa fa-home me-2"/>
                                    Volver al inicio
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="pagina_error" name="Página de Error">
        <t t-call="website.layout">
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body text-center p-5">
                                <div class="mb-4">
                                    <i class="fa fa-exclamation-triangle fa-4x text-danger"/>
                                </div>
                                <h3 class="mb-3 fw-bold text-danger">Error</h3>
                                <p class="text-muted mb-4">
                                    Ha ocurrido un error al procesar su solicitud.
                                </p>
                                <a href="/" class="btn btn-primary btn-lg px-5 shadow-sm">
                                    <i class="fa fa-home me-2"/>
                                    Volver al inicio
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
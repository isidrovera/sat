<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="customer_records_page" name="Customer Records Page">
        <t t-call="website.layout">
            <div class="container">
                <h2>Registros del Cliente: <t t-esc="cliente"/></h2>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Modelo</th>
                            <th>Serie</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="registros" t-as="registro">
                            <tr>
                                <td><t t-esc="registro.name.name"/></td>
                                <td><t t-esc="registro.serie"/></td>
                                <td>
                                    <a t-att-href="'/ticket/reportar_incidencia?id_registro=' + str(registro.id) + '&amp;user_name=' + (user_name or '') + '&amp;phone_number=' + (phone_number or '')" class="btn btn-primary">Reportar Incidencia</a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>

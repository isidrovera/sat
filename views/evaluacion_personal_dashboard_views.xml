<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- VISTA KANBAN DASHBOARD EVALUACIÓN PERSONAL -->
        <!-- ============================================================ -->
        <record id="view_evaluacion_personal_dashboard_kanban" model="ir.ui.view">
            <field name="name">evaluacion.personal.dashboard.kanban</field>
            <field name="model">evaluacion.personal</field>
            <field name="arch" type="xml">
                <kanban
                    string="Dashboard Evaluaciones"
                    default_order="puntaje_total desc, porcentaje_productividad_total desc"
                    class="o_kanban_small_column o_evaluacion_dashboard_kanban"
                    sample="1">

                    <!-- Campos base -->
                    <field name="name"/>
                    <field name="fecha"/>
                    <field name="usuario_id"/>
                    <field name="nombre_usuario"/>
                    <field name="evaluador_id"/>
                    <field name="state"/>

                    <!-- Puntajes existentes -->
                    <field name="puntaje_total"/>
                    <field name="nivel_desempeno"/>
                    <field name="puntaje_objetivos"/>
                    <field name="puntaje_desempeno"/>

                    <!-- Métricas existentes -->
                    <field name="cantidad_reparaciones"/>
                    <field name="objetivo_reparaciones"/>
                    <field name="porcentaje_reparaciones"/>
                    <field name="cantidad_tickets"/>
                    <field name="objetivo_tickets"/>
                    <field name="porcentaje_tickets"/>

                    <!-- Campos nuevos del dashboard -->
                    <field name="total_trabajos_mes"/>
                    <field name="objetivo_total_trabajos"/>
                    <field name="porcentaje_productividad_total"/>
                    <field name="porcentaje_productividad_real"/>
                    <field name="promedio_diario_total"/>
                    <field name="diferencia_objetivo_total"/>
                    <field name="estado_productividad"/>
                    <field name="estado_dashboard"/>
                    <field name="requiere_seguimiento"/>
                    <field name="prioridad_seguimiento"/>
                    <field name="resumen_dashboard"/>
                    <field name="alerta_dashboard"/>
                    <field name="indicador_actividad"/>
                    <field name="resumen_productividad"/>
                    <field name="resumen_puntaje"/>
                    <field name="resumen_objetivo"/>

                    <!-- Días -->
                    <field name="tiene_detalle_diario"/>
                    <field name="total_dias_trabajados"/>
                    <field name="total_dias_sin_actividad"/>
                    <field name="porcentaje_dias_activos"/>
                    <field name="porcentaje_dias_sin_actividad"/>
                    <field name="actividad_promedio_por_dia_activo"/>

                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card oe_kanban_global_click o_eval_dash_card">

                                <!-- CABECERA -->
                                <div t-attf-class="o_eval_dash_header #{record.estado_dashboard.raw_value == 'destacado' ? 'o_eval_dash_success' : record.estado_dashboard.raw_value == 'estable' ? 'o_eval_dash_info' : record.estado_dashboard.raw_value == 'en_observacion' ? 'o_eval_dash_warning' : record.estado_dashboard.raw_value == 'requiere_revision' ? 'o_eval_dash_danger' : 'o_eval_dash_muted'}">

                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center">
                                            <div class="o_eval_dash_avatar">
                                                <i class="fa fa-user"/>
                                            </div>
                                            <div>
                                                <div class="o_eval_dash_name">
                                                    <field name="usuario_id"/>
                                                </div>
                                                <div class="o_eval_dash_date">
                                                    <i class="fa fa-calendar me-1"/>
                                                    <field name="fecha"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="text-end">
                                            <span t-attf-class="badge #{record.state.raw_value == 'enviado' || record.state.raw_value == 'finalizado' ? 'bg-success' : record.state.raw_value == 'aprobado' ? 'bg-info' : record.state.raw_value == 'en_revision' ? 'bg-warning' : 'bg-secondary'}">
                                                <field name="state"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- CUERPO -->
                                <div class="o_eval_dash_body">

                                    <!-- PUNTAJE TOTAL -->
                                    <div class="o_eval_dash_score_box">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="o_eval_dash_label">
                                                Puntaje Total
                                            </span>
                                            <strong>
                                                <t t-esc="Math.round(record.puntaje_total.raw_value || 0)"/>%
                                            </strong>
                                        </div>

                                        <div class="progress o_eval_dash_progress">
                                            <div
                                                t-attf-class="progress-bar #{record.puntaje_total.raw_value >= 81 ? 'bg-success' : record.puntaje_total.raw_value >= 71 ? 'bg-info' : record.puntaje_total.raw_value >= 61 ? 'bg-warning' : 'bg-danger'}"
                                                t-attf-style="width: #{Math.min(100, record.puntaje_total.raw_value || 0)}%;">
                                            </div>
                                        </div>

                                        <div class="mt-2">
                                            <span
                                                t-attf-class="badge #{record.nivel_desempeno.raw_value == 'excelente' ? 'bg-success' : record.nivel_desempeno.raw_value == 'muy_bueno' ? 'bg-primary' : record.nivel_desempeno.raw_value == 'bueno' ? 'bg-info' : record.nivel_desempeno.raw_value == 'regular' ? 'bg-warning' : 'bg-danger'}">
                                                <field name="nivel_desempeno"/>
                                            </span>
                                        </div>
                                    </div>

                                    <!-- PRODUCTIVIDAD TOTAL -->
                                    <div class="o_eval_dash_metric_block">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="o_eval_dash_label">
                                                <i class="fa fa-chart-line me-1"/>
                                                Productividad Total
                                            </span>
                                            <strong>
                                                <t t-esc="Math.round(record.porcentaje_productividad_total.raw_value || 0)"/>%
                                            </strong>
                                        </div>

                                        <div class="progress o_eval_dash_progress mt-1">
                                            <div
                                                t-attf-class="progress-bar #{record.porcentaje_productividad_total.raw_value >= 85 ? 'bg-success' : record.porcentaje_productividad_total.raw_value >= 70 ? 'bg-info' : record.porcentaje_productividad_total.raw_value >= 50 ? 'bg-warning' : 'bg-danger'}"
                                                t-attf-style="width: #{Math.min(100, record.porcentaje_productividad_total.raw_value || 0)}%;">
                                            </div>
                                        </div>

                                        <div class="o_eval_dash_small mt-1">
                                            <field name="resumen_dashboard"/>
                                        </div>
                                    </div>

                                    <!-- REPARACIONES Y TICKETS -->
                                    <div class="o_eval_dash_grid_2 mt-3">

                                        <div class="o_eval_dash_mini_card">
                                            <div class="o_eval_dash_icon text-primary">
                                                <i class="fa fa-wrench"/>
                                            </div>
                                            <div>
                                                <div class="o_eval_dash_mini_title">Reparaciones</div>
                                                <div class="o_eval_dash_mini_value">
                                                    <field name="cantidad_reparaciones"/>
                                                    /
                                                    <field name="objetivo_reparaciones"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="o_eval_dash_mini_card">
                                            <div class="o_eval_dash_icon text-info">
                                                <i class="fa fa-ticket"/>
                                            </div>
                                            <div>
                                                <div class="o_eval_dash_mini_title">Tickets</div>
                                                <div class="o_eval_dash_mini_value">
                                                    <field name="cantidad_tickets"/>
                                                    /
                                                    <field name="objetivo_tickets"/>
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                    <!-- DÍAS -->
                                    <div class="o_eval_dash_activity mt-3" t-if="record.tiene_detalle_diario.raw_value">
                                        <div class="d-flex justify-content-between">
                                            <span>
                                                <i class="fa fa-calendar-check text-success me-1"/>
                                                Días activos
                                            </span>
                                            <strong>
                                                <field name="total_dias_trabajados"/>
                                            </strong>
                                        </div>

                                        <div class="d-flex justify-content-between mt-1">
                                            <span>
                                                <i class="fa fa-calendar-times text-danger me-1"/>
                                                Sin actividad
                                            </span>
                                            <strong>
                                                <field name="total_dias_sin_actividad"/>
                                            </strong>
                                        </div>

                                        <div class="o_eval_dash_small mt-1">
                                            Promedio día activo:
                                            <field name="actividad_promedio_por_dia_activo"/>
                                        </div>
                                    </div>

                                    <!-- ALERTA -->
                                    <div
                                        t-attf-class="o_eval_dash_alert mt-3 #{record.requiere_seguimiento.raw_value ? 'o_eval_dash_alert_warning' : 'o_eval_dash_alert_success'}">

                                        <i t-attf-class="fa #{record.requiere_seguimiento.raw_value ? 'fa-exclamation-triangle' : 'fa-check-circle'} me-1"/>
                                        <field name="alerta_dashboard"/>
                                    </div>

                                    <!-- BOTONES -->
                                    <div class="o_eval_dash_buttons mt-3">
                                        <button
                                            name="action_ver_dashboard_detalle_diario"
                                            type="object"
                                            class="btn btn-sm btn-outline-primary"
                                            invisible="not tiene_detalle_diario">
                                            <i class="fa fa-calendar-check me-1"/>
                                            Detalle Diario
                                        </button>

                                        <button
                                            name="action_actualizar_dashboard"
                                            type="object"
                                            class="btn btn-sm btn-outline-secondary">
                                            <i class="fa fa-refresh me-1"/>
                                            Actualizar
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- VISTA LIST DASHBOARD -->
        <!-- ============================================================ -->
        <record id="view_evaluacion_personal_dashboard_list" model="ir.ui.view">
            <field name="name">evaluacion.personal.dashboard.list</field>
            <field name="model">evaluacion.personal</field>
            <field name="arch" type="xml">
                <list
                    string="Dashboard Evaluaciones"
                    default_order="puntaje_total desc"
                    decoration-danger="requiere_seguimiento"
                    decoration-success="estado_dashboard == 'destacado'"
                    decoration-info="estado_dashboard == 'estable'"
                    decoration-warning="estado_dashboard == 'en_observacion'">

                    <header>
                        <button
                            name="action_actualizar_dashboard"
                            string="Actualizar Dashboard"
                            type="object"
                            class="btn-secondary"/>
                        <button
                            name="action_enviar_reportes_masivo"
                            string="Enviar Reportes"
                            type="object"
                            class="btn-primary"/>
                    </header>

                    <field name="name"/>
                    <field name="fecha"/>
                    <field name="usuario_id"/>

                    <field name="total_trabajos_mes" sum="Total Trabajos"/>
                    <field name="objetivo_total_trabajos" sum="Objetivo Total"/>
                    <field name="porcentaje_productividad_total" widget="percentpie"/>

                    <field name="cantidad_reparaciones" sum="Total Reparaciones"/>
                    <field name="cantidad_tickets" sum="Total Tickets"/>

                    <field name="total_dias_trabajados" optional="show"/>
                    <field name="total_dias_sin_actividad" optional="show"/>

                    <field name="puntaje_total" widget="progressbar"/>
                    <field name="nivel_desempeno"
                           widget="badge"
                           decoration-danger="nivel_desempeno == 'deficiente'"
                           decoration-warning="nivel_desempeno == 'regular'"
                           decoration-info="nivel_desempeno == 'bueno' or nivel_desempeno == 'muy_bueno'"
                           decoration-success="nivel_desempeno == 'excelente'"/>

                    <field name="estado_productividad"
                           widget="badge"
                           decoration-danger="estado_productividad == 'critico'"
                           decoration-warning="estado_productividad == 'bajo' or estado_productividad == 'aceptable'"
                           decoration-info="estado_productividad == 'bueno'"
                           decoration-success="estado_productividad == 'excelente'"
                           decoration-muted="estado_productividad == 'sin_datos'"/>

                    <field name="estado_dashboard"
                           widget="badge"
                           decoration-danger="estado_dashboard == 'requiere_revision'"
                           decoration-warning="estado_dashboard == 'en_observacion'"
                           decoration-info="estado_dashboard == 'estable'"
                           decoration-success="estado_dashboard == 'destacado'"
                           decoration-muted="estado_dashboard == 'sin_datos'"/>

                    <field name="prioridad_seguimiento"
                           widget="badge"
                           decoration-danger="prioridad_seguimiento == 'critica' or prioridad_seguimiento == 'alta'"
                           decoration-warning="prioridad_seguimiento == 'media'"
                           decoration-info="prioridad_seguimiento == 'baja'"
                           decoration-success="prioridad_seguimiento == 'ninguna'"/>

                    <field name="state"
                           widget="badge"
                           decoration-danger="state == 'borrador'"
                           decoration-warning="state == 'en_revision'"
                           decoration-info="state == 'aprobado'"
                           decoration-success="state == 'enviado' or state == 'finalizado'"/>

                    <button
                        name="action_ver_dashboard_detalle_diario"
                        type="object"
                        string=""
                        icon="fa-calendar-check"
                        title="Ver Detalle Diario"
                        invisible="not tiene_detalle_diario"/>
                </list>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- VISTA GRAPH DASHBOARD -->
        <!-- ============================================================ -->
        <record id="view_evaluacion_personal_dashboard_graph" model="ir.ui.view">
            <field name="name">evaluacion.personal.dashboard.graph</field>
            <field name="model">evaluacion.personal</field>
            <field name="arch" type="xml">
                <graph string="Dashboard Productividad" type="bar">
                    <field name="usuario_id" type="row"/>
                    <field name="total_trabajos_mes" type="measure"/>
                    <field name="objetivo_total_trabajos" type="measure"/>
                    <field name="puntaje_total" type="measure"/>
                    <field name="porcentaje_productividad_total" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- VISTA PIVOT DASHBOARD -->
        <!-- ============================================================ -->
        <record id="view_evaluacion_personal_dashboard_pivot" model="ir.ui.view">
            <field name="name">evaluacion.personal.dashboard.pivot</field>
            <field name="model">evaluacion.personal</field>
            <field name="arch" type="xml">
                <pivot string="Análisis Dashboard">
                    <field name="fecha" type="row" interval="month"/>
                    <field name="usuario_id" type="row"/>
                    <field name="nivel_desempeno" type="col"/>
                    <field name="total_trabajos_mes" type="measure"/>
                    <field name="objetivo_total_trabajos" type="measure"/>
                    <field name="cantidad_reparaciones" type="measure"/>
                    <field name="cantidad_tickets" type="measure"/>
                    <field name="puntaje_total" type="measure"/>
                    <field name="porcentaje_productividad_total" type="measure"/>
                    <field name="total_dias_trabajados" type="measure"/>
                    <field name="total_dias_sin_actividad" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- SEARCH DASHBOARD -->
        <!-- ============================================================ -->
        <record id="view_evaluacion_personal_dashboard_search" model="ir.ui.view">
            <field name="name">evaluacion.personal.dashboard.search</field>
            <field name="model">evaluacion.personal</field>
            <field name="arch" type="xml">
                <search string="Buscar Evaluaciones Dashboard">

                    <field name="name"/>
                    <field name="usuario_id"/>
                    <field name="evaluador_id"/>
                    <field name="fecha"/>
                    <field name="nivel_desempeno"/>
                    <field name="estado_productividad"/>
                    <field name="estado_dashboard"/>

                    <separator/>

                    <filter
                        string="Requiere Seguimiento"
                        name="requiere_seguimiento"
                        domain="[('requiere_seguimiento', '=', True)]"/>

                    <filter
                        string="Sin Seguimiento"
                        name="sin_seguimiento"
                        domain="[('requiere_seguimiento', '=', False)]"/>

                    <separator/>

                    <filter
                        string="Productividad Crítica"
                        name="prod_critica"
                        domain="[('estado_productividad', '=', 'critico')]"/>

                    <filter
                        string="Productividad Baja"
                        name="prod_baja"
                        domain="[('estado_productividad', '=', 'bajo')]"/>

                    <filter
                        string="Productividad Aceptable"
                        name="prod_aceptable"
                        domain="[('estado_productividad', '=', 'aceptable')]"/>

                    <filter
                        string="Productividad Buena"
                        name="prod_buena"
                        domain="[('estado_productividad', '=', 'bueno')]"/>

                    <filter
                        string="Productividad Excelente"
                        name="prod_excelente"
                        domain="[('estado_productividad', '=', 'excelente')]"/>

                    <separator/>

                    <filter
                        string="Destacados"
                        name="destacados"
                        domain="[('estado_dashboard', '=', 'destacado')]"/>

                    <filter
                        string="Estables"
                        name="estables"
                        domain="[('estado_dashboard', '=', 'estable')]"/>

                    <filter
                        string="En Observación"
                        name="observacion"
                        domain="[('estado_dashboard', '=', 'en_observacion')]"/>

                    <filter
                        string="Requiere Revisión"
                        name="revision_dashboard"
                        domain="[('estado_dashboard', '=', 'requiere_revision')]"/>

                    <separator/>

                    <filter
                        string="Deficiente"
                        name="nivel_deficiente"
                        domain="[('nivel_desempeno', '=', 'deficiente')]"/>

                    <filter
                        string="Regular"
                        name="nivel_regular"
                        domain="[('nivel_desempeno', '=', 'regular')]"/>

                    <filter
                        string="Bueno"
                        name="nivel_bueno"
                        domain="[('nivel_desempeno', '=', 'bueno')]"/>

                    <filter
                        string="Muy Bueno"
                        name="nivel_muy_bueno"
                        domain="[('nivel_desempeno', '=', 'muy_bueno')]"/>

                    <filter
                        string="Excelente"
                        name="nivel_excelente"
                        domain="[('nivel_desempeno', '=', 'excelente')]"/>

                    <separator/>

                    <filter
                        string="Borrador"
                        name="state_borrador"
                        domain="[('state', '=', 'borrador')]"/>

                    <filter
                        string="En Revisión"
                        name="state_revision"
                        domain="[('state', '=', 'en_revision')]"/>

                    <filter
                        string="Aprobado"
                        name="state_aprobado"
                        domain="[('state', '=', 'aprobado')]"/>

                    <filter
                        string="Enviado"
                        name="state_enviado"
                        domain="[('state', '=', 'enviado')]"/>

                    <filter
                        string="Finalizado"
                        name="state_finalizado"
                        domain="[('state', '=', 'finalizado')]"/>

                    <group expand="0" string="Agrupar por">
                        <filter
                            string="Técnico"
                            name="group_usuario"
                            context="{'group_by': 'usuario_id'}"/>

                        <filter
                            string="Evaluador"
                            name="group_evaluador"
                            context="{'group_by': 'evaluador_id'}"/>

                        <filter
                            string="Mes"
                            name="group_fecha_mes"
                            context="{'group_by': 'fecha:month'}"/>

                        <filter
                            string="Nivel"
                            name="group_nivel"
                            context="{'group_by': 'nivel_desempeno'}"/>

                        <filter
                            string="Productividad"
                            name="group_productividad"
                            context="{'group_by': 'estado_productividad'}"/>

                        <filter
                            string="Estado Dashboard"
                            name="group_estado_dashboard"
                            context="{'group_by': 'estado_dashboard'}"/>

                        <filter
                            string="Estado"
                            name="group_state"
                            context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- ACCIÓN DASHBOARD -->
        <!-- ============================================================ -->
        <record id="action_evaluacion_personal_dashboard" model="ir.actions.act_window">
            <field name="name">Dashboard Evaluaciones</field>
            <field name="res_model">evaluacion.personal</field>
            <field name="view_mode">kanban,list,graph,pivot,form</field>
            <field name="search_view_id" ref="view_evaluacion_personal_dashboard_search"/>
            <field name="context">
                {
                    'search_default_group_fecha_mes': 0
                }
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Dashboard de Evaluaciones del Personal Técnico
                </p>
                <p>
                    Aquí podrás revisar productividad total, puntaje, nivel de desempeño,
                    seguimiento y actividad diaria de cada técnico.
                </p>
            </field>
        </record>

        <!-- Orden explícito de vistas para la acción -->
        <record id="action_evaluacion_personal_dashboard_view_kanban" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="view_evaluacion_personal_dashboard_kanban"/>
            <field name="act_window_id" ref="action_evaluacion_personal_dashboard"/>
        </record>

        <record id="action_evaluacion_personal_dashboard_view_list" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_evaluacion_personal_dashboard_list"/>
            <field name="act_window_id" ref="action_evaluacion_personal_dashboard"/>
        </record>

        <record id="action_evaluacion_personal_dashboard_view_graph" model="ir.actions.act_window.view">
            <field name="sequence" eval="3"/>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="view_evaluacion_personal_dashboard_graph"/>
            <field name="act_window_id" ref="action_evaluacion_personal_dashboard"/>
        </record>

        <record id="action_evaluacion_personal_dashboard_view_pivot" model="ir.actions.act_window.view">
            <field name="sequence" eval="4"/>
            <field name="view_mode">pivot</field>
            <field name="view_id" ref="view_evaluacion_personal_dashboard_pivot"/>
            <field name="act_window_id" ref="action_evaluacion_personal_dashboard"/>
        </record>

        <!-- ============================================================ -->
        <!-- MENÚ DASHBOARD -->
        <!-- ============================================================ -->
        <!-- Ajusta parent="" al menú padre real de tu módulo si tiene otro id -->
        <menuitem
            id="menu_evaluacion_personal_dashboard"
            name="Dashboard Evaluaciones"
            parent="menu_evaluaciones_root"
            action="action_evaluacion_personal_dashboard"
            sequence="5"/>

    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="email_template_maquinas_id" model="mail.template">

            <field name="name">Nombre de la plantilla</field>

            <field name="model_id" ref="sat.model_sat_sat"/>

            <field name="email_from">{{ user.company_id.email or user.email or '' }}</field>

            <field name="subject">Máquina con problemas</field>

            <field name="lang">{{ object.cliente_id.lang or 'es_PE' }}</field>

            <field name="auto_delete" eval="True"/>

            <field name="body_html" type="html">
                <div>
                    <p>
                        Hola,
                        <t t-out="object.cliente_id.name or 'cliente'"/>
                    </p>

                    <p>
                        Se informa sobre una máquina que presenta problemas.
                    </p>

                    <t t-if="object.disponibilidad_id == 'no_disponible'">

                        <table border="1"
                               cellpadding="8"
                               style="width:100%;border-collapse:collapse;">

                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Serie</th>
                                    <th>Descripción</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr>
                                    <td>
                                        <t t-out="object.name or ''"/>
                                    </td>

                                    <td>
                                        <t t-out="object.serie_id or ''"/>
                                    </td>

                                    <td>
                                        <t t-out="object.descripcion or ''"/>
                                    </td>
                                </tr>
                            </tbody>

                        </table>

                    </t>

                </div>
            </field>

        </record>

    </data>
</odoo>
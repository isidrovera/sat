<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- SEARCH -->
    <record id="view_checklist_map_search" model="ir.ui.view">
      <field name="name">checklist.map.search</field>
      <field name="model">checklist.componente.map</field>
      <field name="arch" type="xml">
        <search string="Buscar Mapeos">
          <field name="field_name"/>
          <field name="tipo_id"/>
          <group expand="0" string="Agrupar">
            <filter string="Por Tipo" name="grp_tipo" context="{'group_by':'tipo_id'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- LIST -->
    <record id="view_checklist_map_list" model="ir.ui.view">
      <field name="name">checklist.map.list</field>
      <field name="model">checklist.componente.map</field>
      <field name="arch" type="xml">
        <list string="Mapa Checklist → Componente" create="1" edit="1" delete="0">
          <field name="field_name"/>
          <field name="tipo_id"/>
          <field name="subparte_ids" widget="many2many_tags"/>
          <field name="estado_a_severidad"/>
        </list>
      </field>
    </record>

    <!-- FORM -->
    <record id="view_checklist_map_form" model="ir.ui.view">
      <field name="name">checklist.map.form</field>
      <field name="model">checklist.componente.map</field>
      <field name="arch" type="xml">
        <form string="Mapa de Checklist">
          <group>
            <field name="field_name" placeholder="p.ej. black_id, fusora_id, adf_id"/>
            <field name="tipo_id"/>
          </group>
          <group>
            <field name="subparte_ids" widget="many2many_tags"/>
            <field name="estado_a_severidad" placeholder='JSON: {"si":"ok","desgaste":"warn","cambio":"critical"}'/>
          </group>
          <group>
            <field name="notas"/>
          </group>
        </form>
      </field>
    </record>

  
  </data>
</odoo>

                <!-- AOS Animation -->
                <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
                <!-- Dashboard JS personalizado -->
                <script src="/sat/static/src/js/contadores_dashboard.js"></script>
                
                <!-- Funciones adicionales inline -->
                <script>
                    // Función para copiar al portapapeles
                    function copyToClipboard(element) {
                        const text = element.getAttribute('data-text');
                        if (navigator.clipboard) {
                            navigator.clipboard.writeText(text).then(() =&gt; {
                                showToast('Copiado: ' + text, 'success');
                            });
                        } else {
                            // Fallback para navegadores más antiguos
                            const textArea = document.createElement('textarea');
                            textArea.value = text;
                            document.body.appendChild(textArea);
                            textArea.select();
                            document.execCommand('copy');
                            document.body.removeChild(textArea);
                            showToast('Copiado: ' + text, 'success');
                        }
                    }
                    
                    // Función básica para mostrar notificaciones
                    function showToast(message, type = 'info') {
                        const toast = document.createElement('div');
                        toast.className = `alert alert-${type === 'success' ? 'success' : type === 'error' ? 'danger' : 'info'} toast-notification`;
                        toast.style.cssText = `
                            position: fixed;
                            top: 20px;
                            right: 20px;
                            z-index: 9999;
                            min-width: 300px;
                            opacity: 0;
                            transition: opacity 0.3s ease;
                        `;
                        toast.innerHTML = `
                            <div class="d-flex align-items-center">
                                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle'} me-2"></i>
                                ${message}
                                <button type="button" class="btn-close ms-auto" onclick="this.parentElement.parentElement.remove()"></button>
                            </div>
                        `;
                        
                        document.body.appendChild(toast);
                        
                        // Mostrar con animación
                        setTimeout(() =&gt; toast.style.opacity = '1', 100);
                        
                        // Auto-remover después de 3 segundos
                        setTimeout(() =&gt; {
                            toast.style.opacity = '0';
                            setTimeout(() =&gt; {
                                if (toast.parentNode) {
                                    toast.parentNode.removeChild(toast);
                                }
                            }, 300);
                        }, 3000);
                    }

                    // Filtros con navegación por URL
                    document.addEventListener('DOMContentLoaded', function() {
                        const filterButtons = document.querySelectorAll('.filter-btn');
                        
                        filterButtons.forEach(btn =&gt; {
                            btn.addEventListener('click', function(e) {
                                e.preventDefault();
                                
                                const filter = this.getAttribute('data-filter');
                                const currentUrl = new URL(window.location);
                                
                                // Mantener búsqueda y resetear página
                                currentUrl.searchParams.set('page', '1');
                                
                                if (filter === 'all') {
                                    currentUrl.searchParams.delete('filter_type');
                                } else {
                                    currentUrl.searchParams.set('filter_type', filter);
                                }
                                
                                // Navegar a la nueva URL
                                window.location.href = currentUrl.toString();
                            });
                        });
                    });
                </script>
            </t>
        </t>

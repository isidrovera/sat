<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Dashboard Kanban -->
    <record id="view_contador_dashboard_kanban" model="ir.ui.view">
        <field name="name">contador.dashboard.kanban</field>
        <field name="model">contador.automatico</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" create="false" edit="false" delete="false">
                <!-- Campos que necesitamos para el dashboard -->
                <field name="id"/>
                <field name="serie_detectada"/>
                <field name="cliente_detectado"/>
                <field name="tipo_equipo_detectado"/>
                <field name="contador_bn_detectado"/>
                <field name="contador_color_detectado"/>
                <field name="contador_total_detectado"/>
                <field name="create_date"/>
                <field name="estado"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_dashboard_item">
                            
                            <!-- Header del Dashboard -->
                            <div class="container-fluid bg-primary text-white py-4 mb-4">
                                <div class="row">
                                    <div class="col-12 text-center">
                                        <h1 class="display-4 mb-2">
                                            <i class="fa fa-dashboard me-3"></i>
                                            Dashboard de Contadores
                                        </h1>
                                        <p class="lead mb-3">Monitoreo en tiempo real de equipos de impresión</p>
                                        <button class="btn btn-light btn-lg" type="object" name="refresh_dashboard">
                                            <i class="fa fa-refresh me-2"></i>Actualizar Dashboard
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Estadísticas Principales -->
                            <div class="container-fluid mb-4">
                                <div class="row">
                                    <!-- Equipos Hoy -->
                                    <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fa fa-desktop text-primary" style="font-size: 3rem;"></i>
                                                <h2 class="card-title text-primary mt-3" id="equipos_hoy">
                                                    <t t-esc="record.equipos_hoy.value or 0"/>
                                                </h2>
                                                <p class="card-text fw-bold">Equipos Actualizados Hoy</p>
                                                <small class="text-muted">Últimas 24 horas</small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Equipos Semana -->
                                    <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fa fa-calendar text-success" style="font-size: 3rem;"></i>
                                                <h2 class="card-title text-success mt-3" id="equipos_semana">
                                                    <t t-esc="record.equipos_semana.value or 0"/>
                                                </h2>
                                                <p class="card-text fw-bold">Equipos Esta Semana</p>
                                                <small class="text-muted">Últimos 7 días</small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Total Equipos -->
                                    <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fa fa-database text-info" style="font-size: 3rem;"></i>
                                                <h2 class="card-title text-info mt-3" id="total_equipos">
                                                    <t t-esc="record.total_equipos.value or 0"/>
                                                </h2>
                                                <p class="card-text fw-bold">Total en Sistema</p>
                                                <small class="text-muted">Todos los equipos</small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Eficiencia -->
                                    <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
                                        <div class="card text-center h-100">
                                            <div class="card-body">
                                                <i class="fa fa-percent text-warning" style="font-size: 3rem;"></i>
                                                <h2 class="card-title text-warning mt-3" id="eficiencia">
                                                    <t t-esc="record.eficiencia.value or 0"/>%
                                                </h2>
                                                <p class="card-text fw-bold">Eficiencia Sistema</p>
                                                <small class="text-muted">Procesamiento automático</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Lista de Equipos -->
                            <div class="container-fluid">
                                <div class="card">
                                    <div class="card-header bg-primary text-white">
                                        <h4 class="mb-0">
                                            <i class="fa fa-print me-2"></i>
                                            Equipos de Impresión
                                        </h4>
                                    </div>
                                    <div class="card-body">
                                        <!-- Aquí irían los equipos, pero en Kanban es mejor usar un widget o JS -->
                                        <div class="text-center">
                                            <p>Vista de equipos cargada dinámicamente</p>
                                            <button class="btn btn-primary" onclick="window.location.reload();">
                                                Ver Lista Detallada
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acción Dashboard -->
    <record id="action_contador_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard Contadores</field>
        <field name="res_model">contador.automatico</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_contador_dashboard_kanban"/>
        <field name="target">current</field>
        <field name="domain">[('id', '=', 1)]</field> <!-- Solo muestra un registro dummy -->
        <field name="context">{
            'create': False,
            'edit': False,
            'delete': False,
            'default_equipos_hoy': 0,
            'default_equipos_semana': 0,
            'default_total_equipos': 0,
            'default_eficiencia': 0
        }</field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_contador_dashboard_root"
              name="Dashboard Contadores"
              parent="sat_menu_root"
              action="action_contador_dashboard"
              sequence="90"/>

</odoo>
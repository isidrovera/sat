<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Tree para listar registros -->
    <record id="view_contador_dashboard_tree" model="ir.ui.view">
        <field name="name">contador.dashboard.tree</field>
        <field name="model">contador.automatico</field>
        <field name="arch" type="xml">
            <list string="Lista de Contadores" 
                  create="false" 
                  edit="false" 
                  delete="false"
                  decoration-success="estado == 'procesado'"
                  decoration-warning="estado == 'pendiente'"
                  decoration-danger="estado == 'error'">
                
                <field name="cliente_detectado" string="Cliente"/>
                <field name="serie_detectada" string="Serie"/>
                <field name="tipo_equipo_detectado" string="Tipo"/>
                <field name="contador_bn_detectado" string="B/N"/>
                <field name="contador_color_detectado" string="Color"/>
                <field name="contador_total_detectado" string="Total"/>
                <field name="create_date" string="Fecha"/>
                <field name="estado" string="Estado" widget="badge"/>
                
            </list>
        </field>
    </record>

    <!-- Vista Search para filtros -->
    <record id="view_contador_dashboard_search" model="ir.ui.view">
        <field name="name">contador.dashboard.search</field>
        <field name="model">contador.automatico</field>
        <field name="arch" type="xml">
            <search string="Buscar Contadores">
                <field name="cliente_detectado" string="Cliente"/>
                <field name="serie_detectada" string="Serie"/>
                <field name="estado" string="Estado"/>
                
                <filter string="Procesados" name="filter_procesados"
                        domain="[('estado', '=', 'procesado')]"/>
                <filter string="Hoy" name="filter_hoy" 
                        domain="[('create_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                
                <group expand="0" string="Agrupar por">
                    <filter string="Cliente" name="group_cliente" 
                            context="{'group_by': 'cliente_detectado'}"/>
                    <filter string="Estado" name="group_estado" 
                            context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_contador_dashboard_main" model="ir.ui.view">
        <field name="name">contador.dashboard.main</field>
        <field name="model">contador.automatico</field>
        <field name="arch" type="xml">
            <form string="Dashboard Contadores" class="o_contador_dashboard_main">
                <header>
                    <!-- Botones de acción en el header -->
                    <button name="action_refresh_dashboard_data" 
                            type="object" 
                            string="🔄 Actualizar Dashboard" 
                            class="btn-primary"/>
                    <button name="obtener_estadisticas_dashboard" 
                            type="object" 
                            string="📊 Estadísticas" 
                            class="btn-secondary"/>
                    <button name="limpiar_registros_antiguos" 
                            type="object" 
                            string="🧹 Limpiar" 
                            class="btn-warning"/>
                    <button name="ejecutar_diagnostico_completo" 
                            type="object" 
                            string="🔬 Diagnóstico" 
                            class="btn-info"/>
                </header>
                
                <!-- Contenido principal del dashboard -->
                <div class="o_dashboard_view">
                    <!-- Header con título -->
                    <div class="dashboard-header text-center py-4 mb-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                        <div class="container">
                            <h1 class="display-4 fw-bold mb-2">
                                <i class="fa fa-chart-line me-3"></i>
                                Dashboard de Contadores
                            </h1>
                            <p class="lead mb-3">Monitoreo en tiempo real de equipos de impresión</p>
                        </div>
                    </div>

                    <!-- Estadísticas principales -->
                    <div class="container mb-5">
                        <div class="row g-4">
                            <!-- Equipos Activos Hoy -->
                            <div class="col-xl-3 col-lg-6 col-md-6">
                                <div class="card h-100 shadow-sm border-0">
                                    <div class="card-body text-center">
                                        <div class="mb-3">
                                            <div class="stat-icon bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                <i class="fa fa-desktop fa-lg"></i>
                                            </div>
                                        </div>
                                        <h3 class="stat-number mb-1" id="equipos_hoy">0</h3>
                                        <p class="stat-label text-muted mb-2">Equipos Actualizados Hoy</p>
                                        <div class="stat-subtitle text-muted small">
                                            <i class="fa fa-calendar-day me-1"></i>
                                            Últimas 24 horas
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Equipos Semana -->
                            <div class="col-xl-3 col-lg-6 col-md-6">
                                <div class="card h-100 shadow-sm border-0">
                                    <div class="card-body text-center">
                                        <div class="mb-3">
                                            <div class="stat-icon bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                <i class="fa fa-calendar-week fa-lg"></i>
                                            </div>
                                        </div>
                                        <h3 class="stat-number mb-1" id="equipos_semana">0</h3>
                                        <p class="stat-label text-muted mb-2">Equipos Esta Semana</p>
                                        <div class="stat-subtitle text-muted small">
                                            <i class="fa fa-chart-line me-1"></i>
                                            Últimos 7 días
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Total Equipos -->
                            <div class="col-xl-3 col-lg-6 col-md-6">
                                <div class="card h-100 shadow-sm border-0">
                                    <div class="card-body text-center">
                                        <div class="mb-3">
                                            <div class="stat-icon bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                <i class="fa fa-database fa-lg"></i>
                                            </div>
                                        </div>
                                        <h3 class="stat-number mb-1" id="total_equipos">0</h3>
                                        <p class="stat-label text-muted mb-2">Total en Sistema</p>
                                        <div class="stat-subtitle text-muted small">
                                            <i class="fa fa-building me-1"></i>
                                            Todos los equipos
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Eficiencia -->
                            <div class="col-xl-3 col-lg-6 col-md-6">
                                <div class="card h-100 shadow-sm border-0">
                                    <div class="card-body text-center">
                                        <div class="mb-3">
                                            <div class="stat-icon bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                <i class="fa fa-percentage fa-lg"></i>
                                            </div>
                                        </div>
                                        <h3 class="stat-number mb-1" id="eficiencia">0%</h3>
                                        <p class="stat-label text-muted mb-2">Eficiencia Sistema</p>
                                        <div class="stat-subtitle text-muted small">
                                            <i class="fa fa-thumbs-up me-1"></i>
                                            Procesamiento automático
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Filtros rápidos -->
                    <div class="container mb-4">
                        <div class="row">
                            <div class="col-12">
                                <div class="card shadow-sm border-0">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-md-8">
                                                <div class="d-flex flex-wrap gap-2">
                                                    <span class="badge bg-primary">Filtros disponibles en JavaScript</span>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="input-group">
                                                    <span class="input-group-text">
                                                        <i class="fa fa-search"></i>
                                                    </span>
                                                    <input type="text" 
                                                           class="form-control" 
                                                           placeholder="Buscar cliente o serie..."
                                                           id="search_input"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Lista de máquinas -->
                    <div class="container">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white">
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <h4 class="mb-0">
                                            <i class="fa fa-list me-2 text-primary"></i>
                                            Equipos de Impresión
                                        </h4>
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <span class="badge bg-light text-dark px-3 py-2">
                                            <i class="fa fa-clock me-1"></i>
                                            Actualizado: <span id="last_update">Cargando...</span>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0" id="machines_table">
                                        <thead class="bg-light">
                                            <tr>
                                                <th class="px-4 py-3 border-0">Cliente</th>
                                                <th class="px-4 py-3 border-0">Serie</th>
                                                <th class="px-4 py-3 border-0 text-center">Tipo</th>
                                                <th class="px-4 py-3 border-0 text-center">Contadores</th>
                                                <th class="px-4 py-3 border-0 text-center">Última Actualización</th>
                                                <th class="px-4 py-3 border-0 text-center">Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody id="machines_tbody">
                                            <tr>
                                                <td colspan="6" class="text-center py-5">
                                                    <div class="text-muted">
                                                        <div class="spinner-border mb-3" role="status">
                                                            <span class="visually-hidden">Cargando...</span>
                                                        </div>
                                                        <p>Cargando equipos...</p>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Footer con información -->
                            <div class="card-footer bg-light">
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <span class="text-muted">
                                            Mostrando <span id="showing_count">0</span> de <span id="total_count">0</span> equipos
                                        </span>
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <button name="action_refresh_dashboard_data" 
                                                type="object" 
                                                class="btn btn-sm btn-primary">
                                            <i class="fa fa-sync-alt me-1"></i>Actualizar Lista
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Loading overlay -->
                    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center d-none" 
                         id="loading_overlay"
                         style="background-color: rgba(0,0,0,0.5); z-index: 9999;">
                        <div class="text-center text-white">
                            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;"></div>
                            <h5>Cargando datos...</h5>
                            <p class="text-muted">Por favor espere un momento</p>
                        </div>
                    </div>
                </div>

                <!-- CSS personalizado -->
                <style>
                    .o_contador_dashboard_main {
                        min-height: 100vh;
                        background-color: #f8f9fa;
                    }
                    
                    .stat-card {
                        transition: transform 0.2s ease-in-out;
                    }
                    
                    .stat-card:hover {
                        transform: translateY(-5px);
                    }
                    
                    .counter-item {
                        text-align: center;
                    }
                    
                    .counter-value {
                        font-weight: bold;
                        font-size: 0.9rem;
                    }
                    
                    .counter-label {
                        font-size: 0.7rem;
                        color: #6c757d;
                    }
                    
                    @media (max-width: 768px) {
                        .dashboard-header h1 {
                            font-size: 2rem;
                        }
                        
                        .stat-number {
                            font-size: 1.5rem;
                        }
                        
                        .container {
                            padding-left: 15px;
                            padding-right: 15px;
                        }
                    }
                </style>
            </form>
        </field>
    </record>

    <!-- Acción principal del Dashboard -->
    <record id="action_contador_dashboard_main" model="ir.actions.act_window">
        <field name="name">📊 Dashboard Contadores</field>
        <field name="res_model">contador.automatico</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_contador_dashboard_tree"/>
        <field name="search_view_id" ref="view_contador_dashboard_search"/>
        <field name="target">current</field>
        <field name="domain">[]</field>
        <field name="context">{
            'create': False,
            'delete': False,
            'search_default_filter_procesados': 1
        }</field>
        
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face text-center">
                <i class="fa fa-chart-line fa-3x text-primary mb-3"></i>
            </p>
            <h3 class="text-center">¡Bienvenido al Dashboard de Contadores!</h3>
            <p class="text-center text-muted">
                Monitorea el estado de todos tus equipos de impresión en tiempo real.
                <br/>
                Aquí puedes ver todos los registros procesados de contadores.
            </p>
        </field>
    </record>

    <!-- Menú principal actualizado -->
    <menuitem id="menu_contador_dashboard_root"
              name="📊 Dashboard Contadores"
              parent="sat_menu_root"
              action="action_contador_dashboard_main"
              sequence="90"/>

</odoo>
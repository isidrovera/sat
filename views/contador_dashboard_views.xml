<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template principal del Dashboard Moderno -->
    <template id="contador_dashboard_template" name="Dashboard de Contadores">
        <t t-call="web.layout">
            <t t-set="title">Dashboard de Contadores</t>
            
            <!-- Enlaces a CSS externos -->
            <t t-set="head">
                <!-- Bootstrap 5.3 -->
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
                <!-- Font Awesome 6 -->
                <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
                <!-- AOS Animation -->
                <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet"/>
                <!-- Chart.js -->
                <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                <!-- CSS personalizado -->
                <link rel="stylesheet" type="text/css" href="/sat/static/src/css/contadores_dashboard.css"/>
            </t>
            
            <div class="dashboard-container">
                <!-- Header moderno con gradiente -->
                <div class="dashboard-header">
                    <div class="container-fluid">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <div class="header-content">
                                    <div class="header-icon">
                                        <i class="fas fa-chart-line"></i>
                                    </div>
                                    <div class="header-text">
                                        <h1 class="dashboard-title">Dashboard de Contadores</h1>
                                        <p class="dashboard-subtitle">Monitoreo en tiempo real de equipos de impresión</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 text-end">
                                <div class="header-actions">
                                    <a href="/dashboard/contador/refresh" class="btn btn-glass me-2" id="refreshBtn">
                                        <i class="fas fa-sync-alt me-2"></i>Actualizar
                                    </a>
                                    <div class="btn-group">
                                        <button class="btn btn-glass dropdown-toggle" data-bs-toggle="dropdown">
                                            <i class="fas fa-cog me-2"></i>Opciones
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" href="/dashboard/contador/stats">
                                                <i class="fas fa-chart-bar me-2"></i>Estadísticas Detalladas
                                            </a></li>
                                            <li><a class="dropdown-item" href="/dashboard/contador/diagnostico">
                                                <i class="fas fa-stethoscope me-2"></i>Diagnóstico del Sistema
                                            </a></li>
                                            <li><hr class="dropdown-divider"/></li>
                                            <li><a class="dropdown-item" href="/dashboard/contador/export/excel">
                                                <i class="fas fa-file-excel me-2"></i>Exportar Excel
                                            </a></li>
                                            <li><a class="dropdown-item" href="/dashboard/contador/export/csv">
                                                <i class="fas fa-file-csv me-2"></i>Exportar CSV
                                            </a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Estadísticas principales con diseño moderno -->
                <div class="stats-section">
                    <div class="container-fluid">
                        <div class="row g-4">
                            <!-- Equipos Hoy -->
                            <div class="col-xl-3 col-lg-6 col-md-6">
                                <div class="stat-card stat-card-primary" data-aos="fade-up" data-aos-delay="100">
                                    <div class="stat-card-body">
                                        <div class="stat-icon">
                                            <i class="fas fa-desktop"></i>
                                        </div>
                                        <div class="stat-content">
                                            <div class="stat-number" t-esc="estadisticas.get('equipos_unicos_hoy', 0)">0</div>
                                            <div class="stat-label">Equipos Hoy</div>
                                            <div class="stat-sublabel">Últimas 24 horas</div>
                                        </div>
                                        <div class="stat-trend">
                                            <i t-att-class="'fas ' + ('fa-arrow-up' if estadisticas.get('tendencia_hoy', 0) >= 0 else 'fa-arrow-down')"></i>
                                            <span t-esc="'+' + str(estadisticas.get('porcentaje_tendencia', 0)) + '%' if estadisticas.get('tendencia_hoy', 0) >= 0 else str(estadisticas.get('porcentaje_tendencia', 0)) + '%'">+0%</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Equipos Semana -->
                            <div class="col-xl-3 col-lg-6 col-md-6">
                                <div class="stat-card stat-card-success" data-aos="fade-up" data-aos-delay="200">
                                    <div class="stat-card-body">
                                        <div class="stat-icon">
                                            <i class="fas fa-calendar-week"></i>
                                        </div>
                                        <div class="stat-content">
                                            <div class="stat-number" t-esc="estadisticas.get('equipos_unicos_semana', 0)">0</div>
                                            <div class="stat-label">Esta Semana</div>
                                            <div class="stat-sublabel">Últimos 7 días</div>
                                        </div>
                                        <div class="stat-trend">
                                            <i class="fas fa-arrow-up"></i>
                                            <span>+8%</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Total Equipos -->
                            <div class="col-xl-3 col-lg-6 col-md-6">
                                <div class="stat-card stat-card-info" data-aos="fade-up" data-aos-delay="300">
                                    <div class="stat-card-body">
                                        <div class="stat-icon">
                                            <i class="fas fa-database"></i>
                                        </div>
                                        <div class="stat-content">
                                            <div class="stat-number" t-esc="estadisticas.get('total_equipos_sistema', 0)">0</div>
                                            <div class="stat-label">Total Sistema</div>
                                            <div class="stat-sublabel">Todos los equipos</div>
                                        </div>
                                        <div class="stat-trend">
                                            <i class="fas fa-minus"></i>
                                            <span>0%</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Eficiencia -->
                            <div class="col-xl-3 col-lg-6 col-md-6">
                                <div class="stat-card stat-card-warning" data-aos="fade-up" data-aos-delay="400">
                                    <div class="stat-card-body">
                                        <div class="stat-icon">
                                            <i class="fas fa-gauge-high"></i>
                                        </div>
                                        <div class="stat-content">
                                            <div class="stat-number">
                                                <t t-esc="estadisticas.get('eficiencia_sistema', 0)"/>%
                                            </div>
                                            <div class="stat-label">Eficiencia</div>
                                            <div class="stat-sublabel">Procesamiento</div>
                                        </div>
                                        <div class="stat-trend positive">
                                            <i class="fas fa-arrow-up"></i>
                                            <span>+5%</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Panel de filtros moderno -->
                <div class="filters-section">
                    <div class="container-fluid">
                        <div class="filter-card">
                            <div class="filter-header">
                                <h5 class="filter-title">
                                    <i class="fas fa-filter me-2"></i>Filtros y Búsqueda
                                </h5>
                            </div>
                            <div class="filter-body">
                                <div class="row align-items-center">
                                    <div class="col-lg-8">
                                        <div class="filter-buttons">
                                            <button class="filter-btn" t-att-class="'filter-btn ' + ('active' if not filter_type or filter_type == 'all' else '')" data-filter="all">
                                                <i class="fas fa-list"></i>
                                                <span>Todos</span>
                                                <div class="filter-count" id="count-all" t-esc="filter_counts.get('all', 0)">0</div>
                                            </button>
                                            <button class="filter-btn" t-att-class="'filter-btn ' + ('active' if filter_type == 'hoy' else '')" data-filter="hoy">
                                                <i class="fas fa-calendar-day"></i>
                                                <span>Hoy</span>
                                                <div class="filter-count" id="count-hoy" t-esc="filter_counts.get('hoy', 0)">0</div>
                                            </button>
                                            <button class="filter-btn" t-att-class="'filter-btn ' + ('active' if filter_type == 'color' else '')" data-filter="color">
                                                <i class="fas fa-palette"></i>
                                                <span>Color</span>
                                                <div class="filter-count" id="count-color" t-esc="filter_counts.get('color', 0)">0</div>
                                            </button>
                                            <button class="filter-btn" t-att-class="'filter-btn ' + ('active' if filter_type == 'mono' else '')" data-filter="mono">
                                                <i class="fas fa-circle"></i>
                                                <span>Monocromáticas</span>
                                                <div class="filter-count" id="count-mono" t-esc="filter_counts.get('mono', 0)">0</div>
                                            </button>
                                            <button class="filter-btn" t-att-class="'filter-btn ' + ('active' if filter_type == 'procesado' else '')" data-filter="procesado">
                                                <i class="fas fa-check-circle"></i>
                                                <span>Procesados</span>
                                                <div class="filter-count" id="count-procesado" t-esc="filter_counts.get('procesado', 0)">0</div>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="search-container">
                                            <form method="GET" action="/dashboard/contador" class="search-form">
                                                <input type="hidden" name="filter_type" t-att-value="filter_type or ''"/>
                                                <input type="hidden" name="page" value="1"/>
                                                <div class="search-input-group">
                                                    <input type="text" 
                                                           class="search-input" 
                                                           name="search" 
                                                           placeholder="Buscar cliente, serie o tipo..."
                                                           t-att-value="search_query or ''"
                                                           autocomplete="off"/>
                                                    <button class="search-btn" type="submit">
                                                        <i class="fas fa-search"></i>
                                                    </button>
                                                    <a t-if="search_query" href="/dashboard/contador" class="clear-btn" id="clearSearch">
                                                        <i class="fas fa-times"></i>
                                                    </a>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabla de equipos moderna -->
                <div class="table-section">
                    <div class="container-fluid">
                        <div class="table-card">
                            <div class="table-header">
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <h5 class="table-title">
                                            <i class="fas fa-printer me-2"></i>
                                            Equipos de Impresión
                                        </h5>
                                        <p class="table-subtitle">
                                            Mostrando <span class="text-primary" t-esc="len(equipos)">0</span> de 
                                            <span class="text-primary" t-esc="total_equipos">0</span> equipos
                                            <t t-if="search_query"> para "<strong t-esc="search_query"/>"</t>
                                            <t t-if="filter_type and filter_type != 'all'"> - Filtro: <strong t-esc="filter_type"/></t>
                                        </p>
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <div class="table-actions">
                                            <button class="btn btn-outline-secondary btn-sm me-2" id="viewToggle">
                                                <i class="fas fa-th-large me-1"></i>Vista
                                            </button>
                                            <span class="last-update">
                                                <i class="fas fa-clock me-1"></i>
                                                <t t-esc="ultima_actualizacion"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="table-body">
                                <t t-if="not equipos">
                                    <div class="empty-state">
                                        <div class="empty-icon">
                                            <i class="fas fa-search"></i>
                                        </div>
                                        <h4 class="empty-title">No se encontraron equipos</h4>
                                        <p class="empty-text">
                                            <t t-if="search_query or filter_type">
                                                No hay registros que coincidan con los filtros aplicados
                                            </t>
                                            <t t-else="">
                                                No hay equipos registrados en el sistema
                                            </t>
                                        </p>
                                        <div class="empty-actions">
                                            <a href="/dashboard/contador" class="btn btn-primary me-2">
                                                <i class="fas fa-refresh me-2"></i>Mostrar todos
                                            </a>
                                            <a href="/dashboard/contador/refresh" class="btn btn-outline-primary">
                                                <i class="fas fa-sync-alt me-2"></i>Actualizar datos
                                            </a>
                                        </div>
                                    </div>
                                </t>

                                <t t-if="equipos">
                                    <div class="table-responsive">
                                        <table class="modern-table">
                                            <thead>
                                                <tr>
                                                    <th class="sortable" data-sort="cliente">
                                                        <div class="th-content">
                                                            <i class="fas fa-building me-2"></i>Cliente
                                                            <i class="fas fa-sort sort-icon"></i>
                                                        </div>
                                                    </th>
                                                    <th class="sortable" data-sort="serie">
                                                        <div class="th-content">
                                                            <i class="fas fa-barcode me-2"></i>Serie
                                                            <i class="fas fa-sort sort-icon"></i>
                                                        </div>
                                                    </th>
                                                    <th class="text-center">
                                                        <div class="th-content">
                                                            <i class="fas fa-tag me-2"></i>Tipo
                                                        </div>
                                                    </th>
                                                    <th class="text-center">
                                                        <div class="th-content">
                                                            <i class="fas fa-calculator me-2"></i>Contadores
                                                        </div>
                                                    </th>
                                                    <th class="text-center sortable" data-sort="fecha">
                                                        <div class="th-content">
                                                            <i class="fas fa-clock me-2"></i>Actualización
                                                            <i class="fas fa-sort sort-icon"></i>
                                                        </div>
                                                    </th>
                                                    <th class="text-center">
                                                        <div class="th-content">
                                                            <i class="fas fa-info-circle me-2"></i>Estado
                                                        </div>
                                                    </th>
                                                    <th class="text-center">
                                                        <div class="th-content">
                                                            <i class="fas fa-cogs me-2"></i>Acciones
                                                        </div>
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="equipos" t-as="equipo">
                                                    <tr class="table-row" 
                                                        t-att-data-tipo="equipo.tipo_equipo_detectado"
                                                        t-att-data-estado="equipo.estado_ultimo"
                                                        t-att-data-cliente="equipo.cliente_detectado"
                                                        t-att-data-serie="equipo.serie_detectada">
                                                        
                                                        <!-- Cliente -->
                                                        <td class="cell-cliente">
                                                            <div class="client-info">
                                                                <div class="client-avatar">
                                                                    <i class="fas fa-building"></i>
                                                                </div>
                                                                <div class="client-details">
                                                                    <div class="client-name" t-esc="equipo.cliente_detectado"/>
                                                                    <div class="client-label">Cliente</div>
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <!-- Serie -->
                                                        <td class="cell-serie">
                                                            <div class="serie-info">
                                                                <div class="serie-avatar">
                                                                    <i class="fas fa-barcode"></i>
                                                                </div>
                                                                <div class="serie-details">
                                                                    <div class="serie-number" t-esc="equipo.serie_detectada"/>
                                                                    <div class="serie-label">N° Serie</div>
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <!-- Tipo -->
                                                        <td class="text-center">
                                                            <span t-att-class="'type-badge type-' + (equipo.tipo_equipo_detectado or 'unknown').lower().replace(' ', '')">
                                                                <i t-att-class="'fas me-1 ' + ('fa-palette' if equipo.tipo_equipo_detectado and 'color' in equipo.tipo_equipo_detectado.lower() else 'fa-circle')"></i>
                                                                <t t-esc="equipo.tipo_equipo_detectado or 'N/A'"/>
                                                            </span>
                                                        </td>

                                                        <!-- Contadores -->
                                                        <td class="text-center">
                                                            <div class="counters-grid">
                                                                <div class="counter-item">
                                                                    <div class="counter-icon">
                                                                        <i class="fas fa-circle"></i>
                                                                    </div>
                                                                    <div class="counter-value" t-esc="'{:,}'.format(equipo.contador_bn_actual)"/>
                                                                    <div class="counter-label">B/N</div>
                                                                </div>
                                                                <div class="counter-item">
                                                                    <div class="counter-icon color">
                                                                        <i class="fas fa-palette"></i>
                                                                    </div>
                                                                    <div class="counter-value" t-esc="'{:,}'.format(equipo.contador_color_actual)"/>
                                                                    <div class="counter-label">Color</div>
                                                                </div>
                                                                <div class="counter-item total">
                                                                    <div class="counter-icon">
                                                                        <i class="fas fa-plus"></i>
                                                                    </div>
                                                                    <div class="counter-value" t-esc="'{:,}'.format(equipo.contador_total_actual)"/>
                                                                    <div class="counter-label">Total</div>
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <!-- Fecha -->
                                                        <td class="text-center">
                                                            <div class="date-info">
                                                                <div class="date-value" t-esc="equipo.ultima_actualizacion_formatted"/>
                                                                <div class="date-relative" t-esc="equipo.tiempo_relativo or 'Hace un momento'">
                                                                    Hace 2 horas
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <!-- Estado -->
                                                        <td class="text-center">
                                                            <span t-att-class="'status-badge status-' + (equipo.estado_ultimo or 'unknown').lower()">
                                                                <i t-att-class="'fas me-1 ' + ('fa-check-circle' if equipo.estado_ultimo == 'procesado' else 'fa-clock' if equipo.estado_ultimo == 'pendiente' else 'fa-exclamation-circle' if equipo.estado_ultimo == 'error' else 'fa-question-circle')"></i>
                                                                <t t-esc="equipo.estado_ultimo or 'N/A'"/>
                                                            </span>
                                                        </td>

                                                        <!-- Acciones -->
                                                        <td class="text-center">
                                                            <div class="action-buttons">
                                                                <a t-att-href="'/dashboard/contador/detalle/' + str(equipo.id)" 
                                                                   class="action-btn action-btn-primary" 
                                                                   title="Ver detalle">
                                                                    <i class="fas fa-eye"></i>
                                                                </a>
                                                                <a t-att-href="'/dashboard/contador/historial/' + str(equipo.id)" 
                                                                   class="action-btn action-btn-secondary" 
                                                                   title="Ver historial">
                                                                    <i class="fas fa-history"></i>
                                                                </a>
                                                                <div class="dropdown">
                                                                    <button class="action-btn action-btn-info dropdown-toggle" 
                                                                            title="Más opciones"
                                                                            data-bs-toggle="dropdown"
                                                                            aria-expanded="false">
                                                                        <i class="fas fa-ellipsis-v"></i>
                                                                    </button>
                                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                                        <li><a class="dropdown-item" href="#" onclick="copyToClipboard(this)" t-att-data-text="equipo.serie_detectada">
                                                                            <i class="fas fa-copy me-2"></i>Copiar Serie
                                                                        </a></li>
                                                                        <li><a class="dropdown-item" href="#" onclick="copyToClipboard(this)" t-att-data-text="equipo.cliente_detectado">
                                                                            <i class="fas fa-copy me-2"></i>Copiar Cliente
                                                                        </a></li>
                                                                        <li><hr class="dropdown-divider"/></li>
                                                                        <li><a class="dropdown-item text-primary" t-att-href="'/dashboard/contador/detalle/' + str(equipo.id)">
                                                                            <i class="fas fa-info-circle me-2"></i>Ver detalles
                                                                        </a></li>
                                                                    </ul>
                                                                </div>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </t>
                            </div>

                            <!-- Paginación mejorada -->
                            <div class="table-footer" t-if="total_pages and total_pages > 1">
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <div class="pagination-info">
                                            <span class="text-muted">
                                                Mostrando 
                                                <strong t-esc="(current_page - 1) * 20 + 1"/>
                                                -
                                                <strong t-esc="min(current_page * 20, total_equipos)"/> 
                                                de 
                                                <strong t-esc="total_equipos"/> 
                                                registros
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <nav class="pagination-nav">
                                            <ul class="modern-pagination pagination justify-content-end">
                                                <!-- Botón Anterior -->
                                                <li t-att-class="'page-item ' + ('disabled' if current_page == 1 else '')">
                                                    <a class="page-link" 
                                                       t-att-href="'/dashboard/contador?page=' + str(current_page - 1) + ('&amp;search=' + (search_query or '') if search_query else '') + ('&amp;filter_type=' + (filter_type or '') if filter_type else '')"
                                                       aria-label="Anterior">
                                                        <i class="fas fa-chevron-left"></i>
                                                    </a>
                                                </li>
                                                
                                                <!-- Primera página -->
                                                <li t-if="current_page > 3" class="page-item">
                                                    <a class="page-link" 
                                                       t-att-href="'/dashboard/contador?page=1' + ('&amp;search=' + (search_query or '') if search_query else '') + ('&amp;filter_type=' + (filter_type or '') if filter_type else '')">
                                                        1
                                                    </a>
                                                </li>
                                                <li t-if="current_page > 4" class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                                
                                                <!-- Páginas del rango -->
                                                <t t-set="start_page" t-value="max(1, current_page - 2)"/>
                                                <t t-set="end_page" t-value="min(total_pages + 1, current_page + 3)"/>
                                                <t t-foreach="range(start_page, end_page)" t-as="page_num">
                                                    <li t-att-class="'page-item ' + ('active' if page_num == current_page else '')">
                                                        <a class="page-link" 
                                                           t-att-href="'/dashboard/contador?page=' + str(page_num) + ('&amp;search=' + (search_query or '') if search_query else '') + ('&amp;filter_type=' + (filter_type or '') if filter_type else '')"
                                                           t-esc="page_num"/>
                                                    </li>
                                                </t>
                                                
                                                <!-- Última página -->
                                                <li t-if="current_page &lt; total_pages - 3" class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                                <li t-if="current_page &lt; total_pages - 2" class="page-item">
                                                    <a class="page-link" 
                                                       t-att-href="'/dashboard/contador?page=' + str(total_pages) + ('&amp;search=' + (search_query or '') if search_query else '') + ('&amp;filter_type=' + (filter_type or '') if filter_type else '')"
                                                       t-esc="total_pages"/>
                                                </li>
                                                
                                                <!-- Botón Siguiente -->
                                                <li t-att-class="'page-item ' + ('disabled' if current_page == total_pages else '')">
                                                    <a class="page-link" 
                                                       t-att-href="'/dashboard/contador?page=' + str(current_page + 1) + ('&amp;search=' + (search_query or '') if search_query else '') + ('&amp;filter_type=' + (filter_type or '') if filter_type else '')"
                                                       aria-label="Siguiente">
                                                        <i class="fas fa-chevron-right"></i>
                                                    </a>
                                                </li>
                                            </ul>
                                        </nav>
                                    </div>

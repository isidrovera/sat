<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <!-- Template Dashboard Solo Bootstrap -->
    <template id="contador_dashboard_template" name="Dashboard de Contadores">
        <t t-call="web.layout">
            <t t-set="title">Dashboard de Contadores</t>
            
            <!-- Solo Bootstrap y Font Awesome -->
            <t t-set="head">
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
                <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
            </t>
            
            <!-- Container principal -->
            <div class="container-fluid bg-light min-vh-100">
                
                <!-- Header -->
                <div class="bg-primary text-white py-4 mb-4">
                    <div class="container-fluid">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <div class="d-flex align-items-center">
                                    <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3">
                                        <i class="fas fa-chart-line fs-4"></i>
                                    </div>
                                    <div>
                                        <h1 class="h2 mb-1">Dashboard de Contadores</h1>
                                        <p class="mb-0 opacity-75">Monitoreo en tiempo real de equipos de impresión</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 text-end">
                                <a href="/dashboard/contador/refresh" class="btn btn-light me-2">
                                    <i class="fas fa-sync-alt me-2"></i>Actualizar
                                </a>
                                <div class="btn-group">
                                    <button class="btn btn-outline-light dropdown-toggle" data-bs-toggle="dropdown">
                                        <i class="fas fa-cog me-2"></i>Opciones
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="/dashboard/contador/stats">
                                            <i class="fas fa-chart-bar me-2"></i>Estadísticas
                                        </a></li>
                                        <li><a class="dropdown-item" href="/dashboard/contador/diagnostico">
                                            <i class="fas fa-stethoscope me-2"></i>Diagnóstico
                                        </a></li>
                                        <li><hr class="dropdown-divider"/></li>
                                        <li><a class="dropdown-item" href="/dashboard/contador/export/excel">
                                            <i class="fas fa-file-excel me-2"></i>Exportar Excel
                                        </a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Estadísticas principales -->
                <div class="container-fluid mb-4">
                    <div class="row g-3">
                        <!-- Equipos Hoy -->
                        <div class="col-xl-3 col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                                            <i class="fas fa-desktop text-primary fs-4"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h3 class="h2 text-primary mb-1" t-esc="estadisticas.get('equipos_unicos_hoy', 0)">0</h3>
                                            <h6 class="text-muted mb-0">Equipos Hoy</h6>
                                            <small class="text-muted">Últimas 24 horas</small>
                                        </div>
                                        <div class="text-end">
                                            <small class="text-success">
                                                <i class="fas fa-arrow-up me-1"></i>+12%
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Equipos Semana -->
                        <div class="col-xl-3 col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                                            <i class="fas fa-calendar-week text-success fs-4"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h3 class="h2 text-success mb-1" t-esc="estadisticas.get('equipos_unicos_semana', 0)">0</h3>
                                            <h6 class="text-muted mb-0">Esta Semana</h6>
                                            <small class="text-muted">Últimos 7 días</small>
                                        </div>
                                        <div class="text-end">
                                            <small class="text-success">
                                                <i class="fas fa-arrow-up me-1"></i>+8%
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Total Equipos -->
                        <div class="col-xl-3 col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-info bg-opacity-10 rounded-circle p-3 me-3">
                                            <i class="fas fa-database text-info fs-4"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h3 class="h2 text-info mb-1" t-esc="estadisticas.get('total_equipos_sistema', 0)">0</h3>
                                            <h6 class="text-muted mb-0">Total Sistema</h6>
                                            <small class="text-muted">Todos los equipos</small>
                                        </div>
                                        <div class="text-end">
                                            <small class="text-muted">
                                                <i class="fas fa-minus me-1"></i>0%
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Eficiencia -->
                        <div class="col-xl-3 col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-warning bg-opacity-10 rounded-circle p-3 me-3">
                                            <i class="fas fa-gauge-high text-warning fs-4"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h3 class="h2 text-warning mb-1">
                                                <t t-esc="estadisticas.get('eficiencia_sistema', 0)"/>%
                                            </h3>
                                            <h6 class="text-muted mb-0">Eficiencia</h6>
                                            <small class="text-muted">Procesamiento</small>
                                        </div>
                                        <div class="text-end">
                                            <small class="text-success">
                                                <i class="fas fa-arrow-up me-1"></i>+5%
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filtros y Búsqueda -->
                <div class="container-fluid mb-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-filter me-2 text-primary"></i>Filtros y Búsqueda
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-lg-8">
                                    <div class="d-flex flex-wrap gap-2">
                                        <button class="btn btn-outline-primary position-relative" 
                                                t-att-class="'btn ' + ('btn-primary' if not filter_type or filter_type == 'all' else 'btn-outline-primary') + ' position-relative'"
                                                data-filter="all">
                                            <i class="fas fa-list me-2"></i>Todos
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                                <t t-esc="filter_counts.get('all', 0)"/>
                                            </span>
                                        </button>
                                        <button class="btn position-relative" 
                                                t-att-class="'btn ' + ('btn-success' if filter_type == 'hoy' else 'btn-outline-success') + ' position-relative'"
                                                data-filter="hoy">
                                            <i class="fas fa-calendar-day me-2"></i>Hoy
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                                <t t-esc="filter_counts.get('hoy', 0)"/>
                                            </span>
                                        </button>
                                        <button class="btn position-relative" 
                                                t-att-class="'btn ' + ('btn-info' if filter_type == 'color' else 'btn-outline-info') + ' position-relative'"
                                                data-filter="color">
                                            <i class="fas fa-palette me-2"></i>Color
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                                <t t-esc="filter_counts.get('color', 0)"/>
                                            </span>
                                        </button>
                                        <button class="btn position-relative" 
                                                t-att-class="'btn ' + ('btn-secondary' if filter_type == 'mono' else 'btn-outline-secondary') + ' position-relative'"
                                                data-filter="mono">
                                            <i class="fas fa-circle me-2"></i>Monocromáticas
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                                <t t-esc="filter_counts.get('mono', 0)"/>
                                            </span>
                                        </button>
                                        <button class="btn position-relative" 
                                                t-att-class="'btn ' + ('btn-warning' if filter_type == 'procesado' else 'btn-outline-warning') + ' position-relative'"
                                                data-filter="procesado">
                                            <i class="fas fa-check-circle me-2"></i>Procesados
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                                <t t-esc="filter_counts.get('procesado', 0)"/>
                                            </span>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <form method="GET" action="/dashboard/contador">
                                        <input type="hidden" name="filter_type" t-att-value="filter_type or ''"/>
                                        <input type="hidden" name="page" value="1"/>
                                        <div class="input-group">
                                            <input type="text" 
                                                   class="form-control" 
                                                   name="search" 
                                                   placeholder="Buscar cliente, serie o tipo..."
                                                   t-att-value="search_query or ''"
                                                   autocomplete="off"/>
                                            <button class="btn btn-outline-secondary" type="submit">
                                                <i class="fas fa-search"></i>
                                            </button>
                                            <a t-if="search_query" href="/dashboard/contador" class="btn btn-outline-danger">
                                                <i class="fas fa-times"></i>
                                            </a>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabla de equipos -->
                <div class="container-fluid">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <h5 class="card-title mb-1">
                                        <i class="fas fa-printer me-2 text-primary"></i>
                                        Equipos de Impresión
                                    </h5>
                                    <p class="text-muted mb-0">
                                        Mostrando <span class="text-primary fw-bold" t-esc="len(equipos)">0</span> de 
                                        <span class="text-primary fw-bold" t-esc="total_equipos">0</span> equipos
                                        <t t-if="search_query"> - Búsqueda: "<strong t-esc="search_query"/>"</t>
                                        <t t-if="filter_type and filter_type != 'all'"> - Filtro: <strong t-esc="filter_type"/></t>
                                    </p>
                                </div>
                                <div class="col-md-6 text-end">
                                    <small class="text-muted">
                                        <i class="fas fa-clock me-1"></i>
                                        Actualizado: <t t-esc="ultima_actualizacion"/>
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <t t-if="not equipos">
                                <div class="text-center py-5">
                                    <i class="fas fa-search text-muted" style="font-size: 4rem; opacity: 0.3;"></i>
                                    <h4 class="text-muted mt-3">No se encontraron equipos</h4>
                                    <p class="text-muted">
                                        <t t-if="search_query or filter_type">
                                            No hay registros que coincidan con los filtros aplicados
                                        </t>
                                        <t t-else="">
                                            No hay equipos registrados en el sistema
                                        </t>
                                    </p>
                                    <div class="mt-3">
                                        <a href="/dashboard/contador" class="btn btn-primary me-2">
                                            <i class="fas fa-refresh me-2"></i>Mostrar todos
                                        </a>
                                        <a href="/dashboard/contador/refresh" class="btn btn-outline-primary">
                                            <i class="fas fa-sync-alt me-2"></i>Actualizar
                                        </a>
                                    </div>
                                </div>
                            </t>

                            <t t-if="equipos">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="px-3 py-3">
                                                    <i class="fas fa-building me-2 text-primary"></i>Cliente
                                                </th>
                                                <th class="px-3 py-3">
                                                    <i class="fas fa-barcode me-2 text-primary"></i>Serie
                                                </th>
                                                <th class="px-3 py-3 text-center">
                                                    <i class="fas fa-tag me-2 text-primary"></i>Tipo
                                                </th>
                                                <th class="px-3 py-3 text-center">
                                                    <i class="fas fa-calculator me-2 text-primary"></i>Contadores
                                                </th>
                                                <th class="px-3 py-3 text-center">
                                                    <i class="fas fa-clock me-2 text-primary"></i>Actualización
                                                </th>
                                                <th class="px-3 py-3 text-center">
                                                    <i class="fas fa-info-circle me-2 text-primary"></i>Estado
                                                </th>
                                                <th class="px-3 py-3 text-center">
                                                    <i class="fas fa-cogs me-2 text-primary"></i>Acciones
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="equipos" t-as="equipo">
                                                <tr>
                                                    <!-- Cliente -->
                                                    <td class="px-3 py-3">
                                                        <div class="d-flex align-items-center">
                                                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                                <i class="fas fa-building text-primary"></i>
                                                            </div>
                                                            <div>
                                                                <div class="fw-semibold" t-esc="equipo.cliente_detectado"/>
                                                                <small class="text-muted">Cliente</small>
                                                            </div>
                                                        </div>
                                                    </td>

                                                    <!-- Serie -->
                                                    <td class="px-3 py-3">
                                                        <div class="d-flex align-items-center">
                                                            <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                                <i class="fas fa-barcode text-secondary"></i>
                                                            </div>
                                                            <div>
                                                                <div class="fw-semibold font-monospace" t-esc="equipo.serie_detectada"/>
                                                                <small class="text-muted">N° Serie</small>
                                                            </div>
                                                        </div>
                                                    </td>

                                                    <!-- Tipo -->
                                                    <td class="px-3 py-3 text-center">
                                                        <span t-att-class="'badge ' + ('bg-info' if equipo.tipo_equipo_detectado and 'color' in equipo.tipo_equipo_detectado.lower() else 'bg-secondary')">
                                                            <i t-att-class="'fas me-1 ' + ('fa-palette' if equipo.tipo_equipo_detectado and 'color' in equipo.tipo_equipo_detectado.lower() else 'fa-circle')"></i>
                                                            <t t-esc="equipo.tipo_equipo_detectado or 'N/A'"/>
                                                        </span>
                                                    </td>

                                                    <!-- Contadores -->
                                                    <td class="px-3 py-3">
                                                        <div class="row g-2 text-center">
                                                            <div class="col-4">
                                                                <div class="bg-light rounded p-2">
                                                                    <i class="fas fa-circle text-dark d-block mb-1"></i>
                                                                    <div class="fw-bold small" t-esc="'{:,}'.format(equipo.contador_bn_actual)"/>
                                                                    <div class="text-muted" style="font-size: 0.7rem;">B/N</div>
                                                                </div>
                                                            </div>
                                                            <div class="col-4">
                                                                <div class="bg-light rounded p-2">
                                                                    <i class="fas fa-palette text-info d-block mb-1"></i>
                                                                    <div class="fw-bold small" t-esc="'{:,}'.format(equipo.contador_color_actual)"/>
                                                                    <div class="text-muted" style="font-size: 0.7rem;">Color</div>
                                                                </div>
                                                            </div>
                                                            <div class="col-4">
                                                                <div class="bg-primary bg-opacity-10 rounded p-2">
                                                                    <i class="fas fa-plus text-primary d-block mb-1"></i>
                                                                    <div class="fw-bold small text-primary" t-esc="'{:,}'.format(equipo.contador_total_actual)"/>
                                                                    <div class="text-muted" style="font-size: 0.7rem;">Total</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>

                                                    <!-- Fecha -->
                                                    <td class="px-3 py-3 text-center">
                                                        <div>
                                                            <div class="fw-semibold small" t-esc="equipo.ultima_actualizacion_formatted"/>
                                                            <div class="text-muted" style="font-size: 0.7rem;" t-esc="equipo.tiempo_relativo or 'Hace un momento'">
                                                                Hace 2 horas
                                                            </div>
                                                        </div>
                                                    </td>

                                                    <!-- Estado -->
                                                    <td class="px-3 py-3 text-center">
                                                        <span t-att-class="'badge ' + ('bg-success' if equipo.estado_ultimo == 'procesado' else 'bg-warning' if equipo.estado_ultimo == 'pendiente' else 'bg-danger' if equipo.estado_ultimo == 'error' else 'bg-secondary')">
                                                            <i t-att-class="'fas me-1 ' + ('fa-check-circle' if equipo.estado_ultimo == 'procesado' else 'fa-clock' if equipo.estado_ultimo == 'pendiente' else 'fa-exclamation-circle' if equipo.estado_ultimo == 'error' else 'fa-question-circle')"></i>
                                                            <t t-esc="equipo.estado_ultimo or 'N/A'"/>
                                                        </span>
                                                    </td>

                                                    <!-- Acciones -->
                                                    <td class="px-3 py-3 text-center">
                                                        <div class="btn-group btn-group-sm">
                                                            <a t-att-href="'/dashboard/contador/detalle/' + str(equipo.id)" 
                                                               class="btn btn-outline-primary btn-sm" 
                                                               title="Ver detalle">
                                                                <i class="fas fa-eye"></i>
                                                            </a>
                                                            <a t-att-href="'/dashboard/contador/historial/' + str(equipo.id)" 
                                                               class="btn btn-outline-secondary btn-sm" 
                                                               title="Ver historial">
                                                                <i class="fas fa-history"></i>
                                                            </a>
                                                            <button class="btn btn-outline-info btn-sm dropdown-toggle" 
                                                                    data-bs-toggle="dropdown"
                                                                    title="Más opciones">
                                                                <i class="fas fa-ellipsis-v"></i>
                                                            </button>
                                                            <ul class="dropdown-menu dropdown-menu-end">
                                                                <li><a class="dropdown-item" href="#" onclick="navigator.clipboard.writeText(this.getAttribute('data-text'))" t-att-data-text="equipo.serie_detectada">
                                                                    <i class="fas fa-copy me-2"></i>Copiar Serie
                                                                </a></li>
                                                                <li><a class="dropdown-item" href="#" onclick="navigator.clipboard.writeText(this.getAttribute('data-text'))" t-att-data-text="equipo.cliente_detectado">
                                                                    <i class="fas fa-copy me-2"></i>Copiar Cliente
                                                                </a></li>
                                                            </ul>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </div>

                        <!-- Paginación -->
                        <div class="card-footer bg-white" t-if="total_pages and total_pages > 1">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <span class="text-muted">
                                        Mostrando <strong t-esc="(current_page - 1) * 20 + 1"/>-<strong t-esc="min(current_page * 20, total_equipos)"/> 
                                        de <strong t-esc="total_equipos"/> registros
                                    </span>
                                </div>
                                <div class="col-md-6">
                                    <nav class="d-flex justify-content-end">
                                        <ul class="pagination pagination-sm mb-0">
                                            <li t-att-class="'page-item ' + ('disabled' if current_page == 1 else '')">
                                                <a class="page-link" t-att-href="'/dashboard/contador?page=' + str(current_page - 1) + ('&amp;search=' + (search_query or '') if search_query else '') + ('&amp;filter_type=' + (filter_type or '') if filter_type else '')">
                                                    <i class="fas fa-chevron-left"></i>
                                                </a>
                                            </li>
                                            
                                            <t t-set="start_page" t-value="max(1, current_page - 2)"/>
                                            <t t-set="end_page" t-value="min(total_pages + 1, current_page + 3)"/>
                                            <t t-foreach="range(start_page, end_page)" t-as="page_num">
                                                <li t-att-class="'page-item ' + ('active' if page_num == current_page else '')">
                                                    <a class="page-link" t-att-href="'/dashboard/contador?page=' + str(page_num) + ('&amp;search=' + (search_query or '') if search_query else '') + ('&amp;filter_type=' + (filter_type or '') if filter_type else '')"
                                                       t-esc="page_num"/>
                                                </li>
                                            </t>
                                            
                                            <li t-att-class="'page-item ' + ('disabled' if current_page == total_pages else '')">
                                                <a class="page-link" t-att-href="'/dashboard/contador?page=' + str(current_page + 1) + ('&amp;search=' + (search_query or '') if search_query else '') + ('&amp;filter_type=' + (filter_type or '') if filter_type else '')">
                                                    <i class="fas fa-chevron-right"></i>
                                                </a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Información adicional -->
                <div class="container-fluid mt-4 pb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body text-center">
                                    <i class="fas fa-list-ul text-primary fs-1 mb-2"></i>
                                    <h6 class="text-muted">Total de registros</h6>
                                    <h4 class="text-primary" t-esc="total_equipos">0</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body text-center">
                                    <i class="fas fa-eye text-success fs-1 mb-2"></i>
                                    <h6 class="text-muted">Mostrando</h6>
                                    <h4 class="text-success">
                                        <t t-esc="len(equipos)"/> de <t t-esc="total_equipos"/>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FAB usando solo Bootstrap -->
                <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050;">
                    <div class="dropup">
                        <button class="btn btn-primary rounded-circle shadow" 
                                style="width: 56px; height: 56px;" 
                                data-bs-toggle="dropdown">
                            <i class="fas fa-plus"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end mb-2">
                            <li><a class="dropdown-item" href="/dashboard/contador/refresh">
                                <i class="fas fa-sync-alt me-2"></i>Actualizar datos
                            </a></li>
                            <li><a class="dropdown-item" href="/dashboard/contador/export/excel">
                                <i class="fas fa-file-excel me-2"></i>Exportar Excel
                            </a></li>
                            <li><a class="dropdown-item" href="/dashboard/contador/stats">
                                <i class="fas fa-chart-bar me-2"></i>Estadísticas
                            </a></li>
                            <li><a class="dropdown-item" href="/dashboard/contador/diagnostico">
                                <i class="fas fa-stethoscope me-2"></i>Diagnóstico
                            </a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Scripts -->
            <t t-set="scripts">
                <!-- Bootstrap 5.3 JS -->
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
                
                <!-- JavaScript básico para filtros -->
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        // Filtros
                        const filterButtons = document.querySelectorAll('[data-filter]');
                        
                        filterButtons.forEach(btn =&gt; {
                            btn.addEventListener('click', function(e) {
                                e.preventDefault();
                                
                                const filter = this.getAttribute('data-filter');
                                const currentUrl = new URL(window.location);
                                
                                // Resetear página y aplicar filtro
                                currentUrl.searchParams.set('page', '1');
                                
                                if (filter === 'all') {
                                    currentUrl.searchParams.delete('filter_type');
                                } else {
                                    currentUrl.searchParams.set('filter_type', filter);
                                }
                                
                                // Navegar a la nueva URL
                                window.location.href = currentUrl.toString();
                            });
                        });

                        // Tooltips de Bootstrap
                        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                            return new bootstrap.Tooltip(tooltipTriggerEl);
                        });

                        // Mensaje de copia al portapapeles
                        window.copyToClipboard = function(text) {
                            if (navigator.clipboard) {
                                navigator.clipboard.writeText(text).then(() =&gt; {
                                    showAlert('Copiado: ' + text, 'success');
                                });
                            }
                        };

                        // Función para mostrar alertas
                        window.showAlert = function(message, type = 'info') {
                            const alertDiv = document.createElement('div');
                            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
                            alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
                            alertDiv.innerHTML = `
                                ${message}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            `;
                            
                            document.body.appendChild(alertDiv);
                            
                            // Auto-remover después de 3 segundos
                            setTimeout(() =&gt; {
                                if (alertDiv.parentNode) {
                                    alertDiv.remove();
                                }
                            }, 3000);
                        };
                    });
                </script>
            </t>
        </t>
    </template>
    <template id="contador_detalle_template" t-name="sat.contador_detalle_template">

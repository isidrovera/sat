<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Crear un registro dummy para el dashboard CON TODOS los campos obligatorios -->
    <record id="dashboard_dummy_record" model="contador.automatico">
        <field name="name">📊 Dashboard de Contadores - Registro del Sistema</field>
        <field name="estado">procesado</field>
        <field name="remitente">sistema.dashboard@contador.local</field>
        <field name="contenido_procesado">Registro especial creado para el funcionamiento del Dashboard de Contadores. Este registro permite la visualización y gestión centralizada de todos los equipos.</field>
        <field name="serie_detectada">DASHBOARD-001</field>
        <field name="cliente_detectado">Sistema Dashboard</field>
        <field name="tipo_equipo_detectado">color</field>
        <field name="contador_bn_detectado">0</field>
        <field name="contador_color_detectado">0</field>
        <field name="contador_scan_detectado">0</field>
        <field name="procesado_automaticamente" eval="True"/>
        <field name="idioma_detectado">español</field>
        <field name="marca_detectada">Sistema</field>
        <field name="confianza_deteccion">100.0</field>
    </record>

    <!-- Vista Dashboard Principal -->
    <record id="view_contador_dashboard_main" model="ir.ui.view">
        <field name="name">contador.dashboard.main</field>
        <field name="model">contador.automatico</field>
        <field name="arch" type="xml">
            <form string="Dashboard Contadores" class="o_contador_dashboard_main" js_class="contador_dashboard_form">
                <!-- CSS Inline para compatibilidad -->
                <style>
                    .dashboard-header {
                        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                        color: white;
                        border-radius: 0 0 20px 20px;
                        margin: -16px -16px 20px -16px;
                        padding: 2rem 0;
                    }
                    .stat-card {
                        transition: transform 0.2s ease;
                    }
                    .stat-card:hover {
                        transform: translateY(-5px);
                    }
                    .filter-btn.active {
                        background-color: #0d6efd;
                        color: white;
                        border-color: #0d6efd;
                    }
                    .loading-overlay {
                        position: fixed;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                        background: rgba(0,0,0,0.5);
                        z-index: 9999;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                    }
                    .d-none {
                        display: none !important;
                    }
                </style>

                <!-- Header con título y botón refresh -->
                <div class="dashboard-header text-center">
                    <div class="container">
                        <h1 class="display-4 fw-bold mb-2">
                            📊 Dashboard de Contadores
                        </h1>
                        <p class="lead mb-3">Monitoreo en tiempo real de equipos de impresión</p>
                        <button name="refresh_dashboard" 
                                type="object" 
                                class="btn btn-light btn-lg rounded-pill px-4">
                            🔄 Actualizar Dashboard
                        </button>
                    </div>
                </div>

                <!-- Estadísticas principales -->
                <div class="container-fluid mb-4">
                    <div class="row g-3">
                        <!-- Equipos Activos Hoy -->
                        <div class="col-xl-3 col-lg-6 col-md-6">
                            <div class="card text-center shadow-sm stat-card">
                                <div class="card-body">
                                    <div class="text-primary mb-3">
                                        <i class="fa fa-desktop fa-3x"></i>
                                    </div>
                                    <h2 class="card-title text-primary" id="equipos_hoy">0</h2>
                                    <p class="card-text fw-bold">Equipos Actualizados Hoy</p>
                                    <small class="text-muted">📅 Últimas 24 horas</small>
                                </div>
                            </div>
                        </div>

                        <!-- Equipos Semana -->
                        <div class="col-xl-3 col-lg-6 col-md-6">
                            <div class="card text-center shadow-sm stat-card">
                                <div class="card-body">
                                    <div class="text-success mb-3">
                                        <i class="fa fa-calendar-week fa-3x"></i>
                                    </div>
                                    <h2 class="card-title text-success" id="equipos_semana">0</h2>
                                    <p class="card-text fw-bold">Equipos Esta Semana</p>
                                    <small class="text-muted">📈 Últimos 7 días</small>
                                </div>
                            </div>
                        </div>

                        <!-- Total Equipos -->
                        <div class="col-xl-3 col-lg-6 col-md-6">
                            <div class="card text-center shadow-sm stat-card">
                                <div class="card-body">
                                    <div class="text-info mb-3">
                                        <i class="fa fa-database fa-3x"></i>
                                    </div>
                                    <h2 class="card-title text-info" id="total_equipos">0</h2>
                                    <p class="card-text fw-bold">Total en Sistema</p>
                                    <small class="text-muted">🏢 Todos los equipos</small>
                                </div>
                            </div>
                        </div>

                        <!-- Eficiencia -->
                        <div class="col-xl-3 col-lg-6 col-md-6">
                            <div class="card text-center shadow-sm stat-card">
                                <div class="card-body">
                                    <div class="text-warning mb-3">
                                        <i class="fa fa-percentage fa-3x"></i>
                                    </div>
                                    <h2 class="card-title text-warning" id="eficiencia">0%</h2>
                                    <p class="card-text fw-bold">Eficiencia Sistema</p>
                                    <small class="text-muted">🤖 Procesamiento automático</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filtros rápidos -->
                <div class="container-fluid mb-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h6 class="mb-3">🔍 Filtros rápidos:</h6>
                                    <div class="d-flex flex-wrap gap-2">
                                        <button type="button" name="filter_all" class="btn btn-outline-primary btn-sm filter-btn active" data-filter="all">
                                            📋 Todos
                                        </button>
                                        <button type="button" name="filter_hoy" class="btn btn-outline-success btn-sm filter-btn" data-filter="hoy">
                                            📅 Hoy
                                        </button>
                                        <button type="button" name="filter_color" class="btn btn-outline-info btn-sm filter-btn" data-filter="color">
                                            🎨 Color
                                        </button>
                                        <button type="button" name="filter_mono" class="btn btn-outline-secondary btn-sm filter-btn" data-filter="mono">
                                            ⚫ Monocromáticas
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <h6 class="mb-3">🔍 Búsqueda:</h6>
                                    <div class="input-group">
                                        <span class="input-group-text">🔍</span>
                                        <input type="text" 
                                               class="form-control" 
                                               placeholder="Buscar cliente o serie..."
                                               id="search_input"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Lista de máquinas -->
                <div class="container-fluid">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <h4 class="mb-0">📋 Equipos de Impresión</h4>
                                </div>
                                <div class="col-md-6 text-end">
                                    <span class="badge bg-light text-dark px-3 py-2">
                                        🕒 Actualizado: <span id="last_update">Cargando...</span>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0" id="machines_table">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="px-3 py-3">🏢 Cliente</th>
                                            <th class="px-3 py-3">🔢 Serie</th>
                                            <th class="px-3 py-3 text-center">⚙️ Tipo</th>
                                            <th class="px-3 py-3 text-center">📊 Contadores</th>
                                            <th class="px-3 py-3 text-center">🕒 Última Actualización</th>
                                            <th class="px-3 py-3 text-center">📊 Estado</th>
                                            <th class="px-3 py-3 text-center">👁️ Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody id="machines_tbody">
                                        <tr id="loading_row">
                                            <td colspan="7" class="text-center py-5">
                                                <div class="spinner-border text-primary mb-3" role="status">
                                                    <span class="visually-hidden">Cargando...</span>
                                                </div>
                                                <h5>Cargando datos del dashboard...</h5>
                                                <p class="text-muted">Por favor espere un momento</p>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Footer con paginación -->
                        <div class="card-footer bg-light">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <span class="text-muted">
                                        Mostrando <span id="showing_count">0</span> de <span id="total_count">0</span> equipos
                                    </span>
                                </div>
                                <div class="col-md-6">
                                    <nav>
                                        <ul class="pagination pagination-sm justify-content-end mb-0" id="pagination">
                                            <!-- Paginación dinámica generada por JavaScript -->
                                        </ul>
                                    </nav>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal de detalle -->
                <div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title">📋 Detalle del Equipo</h5>
                                <button type="button" name="close_modal_btn" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body" id="modal_content">
                                <div class="text-center">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Cargando...</span>
                                    </div>
                                    <p class="mt-2">Cargando detalle del equipo...</p>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" name="close_modal_footer" class="btn btn-secondary" data-bs-dismiss="modal">
                                    ❌ Cerrar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Loading overlay -->
                <div class="loading-overlay d-none" id="loading_overlay">
                    <div class="text-center text-white">
                        <div class="spinner-border mb-3" style="width: 3rem; height: 3rem;" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <h5>Actualizando datos...</h5>
                        <p>Por favor espere un momento</p>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <!-- Acción corregida que apunta al registro dummy -->
    <record id="action_contador_dashboard" model="ir.actions.act_window">
        <field name="name">📊 Dashboard Contadores</field>
        <field name="res_model">contador.automatico</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_contador_dashboard_main"/>
        <field name="target">current</field>
        <field name="res_id" ref="dashboard_dummy_record"/>  <!-- Apuntar al registro dummy -->
        <field name="context">{
            'create': False, 
            'edit': False, 
            'delete': False, 
            'form_view_initial_mode': 'readonly'
        }</field>
    </record>

    <!-- Menú corregido -->
    <menuitem id="menu_contador_dashboard_root"
              name="📊 Dashboard Contadores"
              parent="sat_menu_root"
              action="action_contador_dashboard"
              sequence="90"/>
</odoo>
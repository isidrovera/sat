<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Tree para listar equipos -->
    <record id="view_contador_dashboard_tree" model="ir.ui.view">
        <field name="name">contador.dashboard.tree</field>
        <field name="model">contador.automatico</field>
        <field name="arch" type="xml">
            <list string="Dashboard Contadores" 
                  create="false" 
                  edit="false" 
                  delete="false"
                  export_xlsx="true"
                  decoration-success="estado == 'procesado'"
                  decoration-warning="estado == 'pendiente'"
                  decoration-danger="estado == 'error'">
                
                <field name="cliente_detectado" string="Cliente"/>
                <field name="serie_detectada" string="Serie"/>
                <field name="tipo_equipo_detectado" string="Tipo" widget="badge"/>
                <field name="contador_bn_detectado" string="Contador B/N" sum="Total B/N"/>
                <field name="contador_color_detectado" string="Contador Color" sum="Total Color"/>
                <field name="contador_total_detectado" string="Total" sum="Gran Total"/>
                <field name="create_date" string="Fecha"/>
                <field name="estado" string="Estado" widget="badge"/>
                
            </list>
        </field>
    </record>

    <!-- Vista Search para filtros -->
    <record id="view_contador_dashboard_search" model="ir.ui.view">
        <field name="name">contador.dashboard.search</field>
        <field name="model">contador.automatico</field>
        <field name="arch" type="xml">
            <search string="Filtros Dashboard">
                
                <!-- Filtros de búsqueda -->
                <field name="cliente_detectado" string="Cliente"/>
                <field name="serie_detectada" string="Serie"/>
                <field name="tipo_equipo_detectado" string="Tipo"/>
                <field name="estado" string="Estado"/>
                
                <!-- Filtros predefinidos -->
                <filter string="Hoy" name="filter_hoy" 
                        domain="[('create_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                
                <filter string="Esta Semana" name="filter_semana"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                
                <filter string="Color" name="filter_color"
                        domain="[('tipo_equipo_detectado', '=', 'color')]"/>
                
                <filter string="Monocromáticas" name="filter_mono"
                        domain="[('tipo_equipo_detectado', '=', 'monocromatica')]"/>
                
                <separator/>
                
                <filter string="Procesados" name="filter_procesados"
                        domain="[('estado', '=', 'procesado')]"/>
                
                <filter string="Pendientes" name="filter_pendientes"
                        domain="[('estado', '=', 'pendiente')]"/>
                
                <filter string="Con Errores" name="filter_errores"
                        domain="[('estado', '=', 'error')]"/>
                
                <!-- Agrupaciones -->
                <group expand="0" string="Agrupar por">
                    <filter string="Cliente" name="group_cliente" 
                            context="{'group_by': 'cliente_detectado'}"/>
                    <filter string="Tipo" name="group_tipo" 
                            context="{'group_by': 'tipo_equipo_detectado'}"/>
                    <filter string="Estado" name="group_estado" 
                            context="{'group_by': 'estado'}"/>
                    <filter string="Fecha" name="group_fecha" 
                            context="{'group_by': 'create_date:day'}"/>
                </group>
                
            </search>
        </field>
    </record>

    <!-- Vista Form simple para ver detalles -->
    <record id="view_contador_dashboard_form" model="ir.ui.view">
        <field name="name">contador.dashboard.form</field>
        <field name="model">contador.automatico</field>
        <field name="arch" type="xml">
            <form string="Detalle Equipo" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="serie_detectada" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="cliente_detectado" readonly="1"/>
                        </h2>
                    </div>
                    
                    <group>
                        <group string="Información del Equipo">
                            <field name="tipo_equipo_detectado" readonly="1"/>
                            <field name="marca_detectada" readonly="1"/>
                            <field name="estado" readonly="1"/>
                            <field name="confianza_deteccion" readonly="1"/>
                        </group>
                        <group string="Contadores">
                            <field name="contador_bn_detectado" readonly="1"/>
                            <field name="contador_color_detectado" readonly="1"/>
                            <field name="contador_total_detectado" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Fechas">
                            <field name="create_date" readonly="1"/>
                            <field name="write_date" readonly="1"/>
                        </group>
                        <group string="Origen">
                            <field name="name" readonly="1"/>
                            <field name="remitente" readonly="1"/>
                        </group>
                    </group>
                    
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Kanban para dashboard visual -->
    <record id="view_contador_dashboard_kanban" model="ir.ui.view">
        <field name="name">contador.dashboard.kanban</field>
        <field name="model">contador.automatico</field>
        <field name="arch" type="xml">
            <kanban string="Dashboard Equipos" create="false" edit="false" delete="false">
                <field name="serie_detectada"/>
                <field name="cliente_detectado"/>
                <field name="tipo_equipo_detectado"/>
                <field name="contador_bn_detectado"/>
                <field name="contador_color_detectado"/>
                <field name="contador_total_detectado"/>
                <field name="estado"/>
                <field name="create_date"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="serie_detectada"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle text-muted">
                                            <field name="cliente_detectado"/>
                                        </div>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown">
                                        <span class="o_badge" t-attf-class="badge-#{record.estado.raw_value}">
                                            <field name="estado"/>
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="o_kanban_record_body">
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="text-muted">Tipo:</div>
                                            <div><field name="tipo_equipo_detectado"/></div>
                                        </div>
                                        <div class="col-6">
                                            <div class="text-muted">Fecha:</div>
                                            <div><field name="create_date"/></div>
                                        </div>
                                    </div>
                                    
                                    <div class="row mt-2">
                                        <div class="col-4">
                                            <div class="text-center">
                                                <div class="text-muted small">B/N</div>
                                                <div class="h5 mb-0"><field name="contador_bn_detectado"/></div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="text-center">
                                                <div class="text-muted small">Color</div>
                                                <div class="h5 mb-0"><field name="contador_color_detectado"/></div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="text-center">
                                                <div class="text-muted small">Total</div>
                                                <div class="h5 mb-0 text-primary"><field name="contador_total_detectado"/></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Pivot para análisis -->
    <record id="view_contador_dashboard_pivot" model="ir.ui.view">
        <field name="name">contador.dashboard.pivot</field>
        <field name="model">contador.automatico</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Contadores">
                <field name="cliente_detectado" type="row"/>
                <field name="tipo_equipo_detectado" type="row"/>
                <field name="create_date" type="col" interval="day"/>
                <field name="contador_bn_detectado" type="measure"/>
                <field name="contador_color_detectado" type="measure"/>
                <field name="contador_total_detectado" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Vista Graph para gráficos -->
    <record id="view_contador_dashboard_graph" model="ir.ui.view">
        <field name="name">contador.dashboard.graph</field>
        <field name="model">contador.automatico</field>
        <field name="arch" type="xml">
            <graph string="Estadísticas de Contadores" type="line">
                <field name="create_date" type="row" interval="day"/>
                <field name="contador_total_detectado" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Acción principal del dashboard -->
    <record id="action_contador_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard Contadores</field>
        <field name="res_model">contador.automatico</field>
        <field name="view_mode">kanban,tree,graph,pivot,form</field>
        <field name="view_id" ref="view_contador_dashboard_kanban"/>
        <field name="search_view_id" ref="view_contador_dashboard_search"/>
        <field name="target">current</field>
        <field name="domain">[('serie_detectada', '!=', False)]</field>
        <field name="context">{
            'create': False,
            'edit': False,
            'delete': False,
            'search_default_filter_semana': 1,
            'search_default_group_cliente': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay equipos para mostrar
            </p>
            <p>
                Este dashboard muestra todos los equipos de impresión detectados automáticamente.
                <br/>
                Use los filtros para encontrar equipos específicos.
            </p>
        </field>
    </record>

    <!-- Acción para vista de estadísticas -->
    <record id="action_contador_stats" model="ir.actions.act_window">
        <field name="name">Estadísticas de Procesamiento</field>
        <field name="res_model">contador.automatico</field>
        <field name="view_mode">graph,pivot</field>
        <field name="view_id" ref="view_contador_dashboard_graph"/>
        <field name="domain">[('estado', '=', 'procesado')]</field>
        <field name="context">{'search_default_group_fecha': 1}</field>
    </record>

    <!-- Menú principal -->
    <menuitem id="menu_contador_dashboard_root"
              name="Dashboard Contadores"
              parent="sat_menu_root"
              action="action_contador_dashboard"
              sequence="90"/>

    <!-- Submenú para estadísticas -->
    <menuitem id="menu_contador_stats"
              name="Estadísticas"
              parent="menu_contador_dashboard_root"
              action="action_contador_stats"
              sequence="10"/>

</odoo>
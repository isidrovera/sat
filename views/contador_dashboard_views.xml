<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template principal del Dashboard -->
    <template id="contador_dashboard_template" name="Dashboard de Contadores">
        <t t-call="web.layout">
            <t t-set="title">Dashboard de Contadores</t>
            
            <!-- CSS personalizado -->
            <style>
                .dashboard-header {
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                    color: white;
                    padding: 3rem 0;
                }
                
                .stat-card {
                    background: white;
                    border-radius: 12px;
                    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                    transition: transform 0.3s ease;
                    border: none;
                    overflow: hidden;
                }
                
                .stat-card:hover {
                    transform: translateY(-5px);
                }
                
                .stat-icon {
                    width: 60px;
                    height: 60px;
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    margin-bottom: 1rem;
                }
                
                .stat-number {
                    font-size: 2.5rem;
                    font-weight: 700;
                    margin-bottom: 0.5rem;
                }
                
                .machine-row:hover {
                    background-color: rgba(102, 126, 234, 0.05);
                }
                
                .refresh-btn {
                    position: fixed;
                    bottom: 30px;
                    right: 30px;
                    width: 60px;
                    height: 60px;
                    border-radius: 50%;
                    background: linear-gradient(135deg, #667eea, #764ba2);
                    color: white;
                    border: none;
                    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
                    z-index: 1000;
                }
                
                .refresh-btn:hover {
                    transform: scale(1.1);
                    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.6);
                }
                
                .filter-btn {
                    border-radius: 20px;
                    margin: 0 0.25rem;
                    transition: all 0.2s ease;
                }
                
                .filter-btn.active {
                    background: linear-gradient(135deg, #667eea, #764ba2);
                    color: white;
                    border-color: #667eea;
                }
                
                @media (max-width: 768px) {
                    .dashboard-header h1 {
                        font-size: 2rem;
                    }
                    .stat-number {
                        font-size: 1.8rem;
                    }
                }
            </style>
            
            <div class="container-fluid">
                <!-- Header del Dashboard -->
                <div class="dashboard-header">
                    <div class="container">
                        <div class="row">
                            <div class="col-12 text-center">
                                <h1 class="display-4 mb-3">
                                    <i class="fa fa-chart-line me-3"></i>
                                    Dashboard de Contadores
                                </h1>
                                <p class="lead mb-4">Monitoreo en tiempo real de equipos de impresión</p>
                                
                                <!-- Botones de acción -->
                                <div class="btn-group" role="group">
                                    <a href="/dashboard/contador/refresh" class="btn btn-light btn-lg me-2">
                                        <i class="fa fa-sync-alt me-2"></i>Actualizar
                                    </a>
                                    <a href="/dashboard/contador/stats" class="btn btn-outline-light btn-lg me-2">
                                        <i class="fa fa-chart-bar me-2"></i>Estadísticas
                                    </a>
                                    <a href="/dashboard/contador/diagnostico" class="btn btn-outline-light btn-lg">
                                        <i class="fa fa-stethoscope me-2"></i>Diagnóstico
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Estadísticas principales -->
                <div class="container my-5">
                    <div class="row g-4">
                        <!-- Equipos Hoy -->
                        <div class="col-xl-3 col-lg-6">
                            <div class="stat-card text-center p-4">
                                <div class="stat-icon bg-primary text-white mx-auto">
                                    <i class="fa fa-desktop fa-lg"></i>
                                </div>
                                <div class="stat-number text-primary" t-esc="estadisticas['equipos_unicos_hoy']">0</div>
                                <h6 class="text-muted mb-0">Equipos Hoy</h6>
                                <small class="text-muted">Últimas 24 horas</small>
                            </div>
                        </div>
                        
                        <!-- Equipos Semana -->
                        <div class="col-xl-3 col-lg-6">
                            <div class="stat-card text-center p-4">
                                <div class="stat-icon bg-success text-white mx-auto">
                                    <i class="fa fa-calendar-week fa-lg"></i>
                                </div>
                                <div class="stat-number text-success" t-esc="estadisticas.equipos_unicos_semana">0</div>
                                <h6 class="text-muted mb-0">Equipos Esta Semana</h6>
                                <small class="text-muted">Últimos 7 días</small>
                            </div>
                        </div>
                        
                        <!-- Total Equipos -->
                        <div class="col-xl-3 col-lg-6">
                            <div class="stat-card text-center p-4">
                                <div class="stat-icon bg-info text-white mx-auto">
                                    <i class="fa fa-database fa-lg"></i>
                                </div>
                                <div class="stat-number text-info" t-esc="estadisticas.total_equipos_sistema">0</div>
                                <h6 class="text-muted mb-0">Total Sistema</h6>
                                <small class="text-muted">Todos los equipos</small>
                            </div>
                        </div>
                        
                        <!-- Eficiencia -->
                        <div class="col-xl-3 col-lg-6">
                            <div class="stat-card text-center p-4">
                                <div class="stat-icon bg-warning text-white mx-auto">
                                    <i class="fa fa-percentage fa-lg"></i>
                                </div>
                                <div class="stat-number text-warning">
                                    <t t-esc="estadisticas.eficiencia_sistema"/>%
                                </div>
                                <h6 class="text-muted mb-0">Eficiencia</h6>
                                <small class="text-muted">Procesamiento automático</small>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Filtros -->
                <div class="container mb-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <div class="d-flex flex-wrap">
                                        <button class="btn btn-outline-primary btn-sm filter-btn active" data-filter="all">
                                            <i class="fa fa-list me-1"></i>Todos
                                        </button>
                                        <button class="btn btn-outline-success btn-sm filter-btn" data-filter="hoy">
                                            <i class="fa fa-calendar-day me-1"></i>Hoy
                                        </button>
                                        <button class="btn btn-outline-info btn-sm filter-btn" data-filter="color">
                                            <i class="fa fa-palette me-1"></i>Color
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm filter-btn" data-filter="mono">
                                            <i class="fa fa-circle me-1"></i>Monocromáticas
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <form method="GET" action="/dashboard/contador">
                                        <div class="input-group">
                                            <input type="text" 
                                                   class="form-control" 
                                                   name="search" 
                                                   placeholder="Buscar cliente o serie..."
                                                   t-att-value="search_query or ''"/>
                                            <button class="btn btn-outline-secondary" type="submit">
                                                <i class="fa fa-search"></i>
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Lista de equipos -->
                <div class="container">
                    <div class="card">
                        <div class="card-header">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <h5 class="mb-0">
                                        <i class="fa fa-printer me-2 text-primary"></i>
                                        Equipos de Impresión
                                    </h5>
                                </div>
                                <div class="col-md-6 text-end">
                                    <span class="badge bg-light text-dark">
                                        <i class="fa fa-clock me-1"></i>
                                        Última actualización: <t t-esc="ultima_actualizacion"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="px-4 py-3">Cliente</th>
                                            <th class="px-4 py-3">Serie</th>
                                            <th class="px-4 py-3 text-center">Tipo</th>
                                            <th class="px-4 py-3 text-center">Contadores</th>
                                            <th class="px-4 py-3 text-center">Última Actualización</th>
                                            <th class="px-4 py-3 text-center">Estado</th>
                                            <th class="px-4 py-3 text-center">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="not equipos">
                                            <tr>
                                                <td colspan="7" class="text-center py-5">
                                                    <div class="text-muted">
                                                        <i class="fa fa-search fa-3x mb-3 d-block"></i>
                                                        <h5>No se encontraron equipos</h5>
                                                        <p>No hay registros que coincidan con los filtros aplicados</p>
                                                    </div>
                                                </td>
                                            </tr>
                                        </t>
                                        
                                        <t t-foreach="equipos" t-as="equipo">
                                            <tr class="machine-row">
                                                <td class="px-4 py-3">
                                                    <div class="d-flex align-items-center">
                                                        <div class="me-3">
                                                            <div class="avatar bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                                <i class="fa fa-building text-primary"></i>
                                                            </div>
                                                        </div>
                                                        <div>
                                                            <div class="fw-semibold" t-esc="equipo.cliente_detectado or 'Sin cliente'"/>
                                                            <small class="text-muted">Cliente</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3">
                                                    <div class="d-flex align-items-center">
                                                        <div class="me-3">
                                                            <div class="avatar bg-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                                <i class="fa fa-barcode text-white"></i>
                                                            </div>
                                                        </div>
                                                        <div>
                                                            <div class="fw-semibold font-monospace" t-esc="equipo.serie_detectada or 'Sin serie'"/>
                                                            <small class="text-muted">Número de serie</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3 text-center">
                                                    <span class="badge bg-light text-dark">
                                                        <i t-att-class="'fa me-1 ' + ('fa-palette' if equipo.tipo_equipo_detectado == 'color' else 'fa-circle')"></i>
                                                        <t t-esc="equipo.tipo_equipo_detectado or 'N/A'"/>
                                                    </span>
                                                </td>
                                                <td class="px-4 py-3 text-center">
                                                    <div class="row g-1">
                                                        <div class="col-4">
                                                            <small class="d-block">B/N</small>
                                                            <strong t-esc="'{:,}'.format(equipo.contador_bn_actual or 0)"/>
                                                        </div>
                                                        <div class="col-4">
                                                            <small class="d-block">Color</small>
                                                            <strong t-esc="'{:,}'.format(equipo.contador_color_actual or 0)"/>
                                                        </div>
                                                        <div class="col-4">
                                                            <small class="d-block text-primary">Total</small>
                                                            <strong class="text-primary" t-esc="'{:,}'.format(equipo.contador_total_actual or 0)"/>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-3 text-center">
                                                    <small class="text-muted">
                                                        <i class="fa fa-clock me-1"></i>
                                                        <t t-esc="equipo.ultima_actualizacion_formatted"/>
                                                    </small>
                                                </td>
                                                <td class="px-4 py-3 text-center">
                                                    <span t-att-class="'badge ' + ('bg-success' if equipo.estado_ultimo == 'procesado' else 'bg-warning' if equipo.estado_ultimo == 'pendiente' else 'bg-danger' if equipo.estado_ultimo == 'error' else 'bg-info')"
                                                          t-esc="equipo.estado_ultimo or 'N/A'"/>
                                                </td>
                                                <td class="px-4 py-3 text-center">
                                                    <div class="btn-group btn-group-sm">
                                                        <a t-att-href="'/dashboard/contador/detalle/' + str(equipo.id)" 
                                                           class="btn btn-outline-primary" 
                                                           title="Ver detalle">
                                                            <i class="fa fa-eye"></i>
                                                        </a>
                                                        <a t-att-href="'/dashboard/contador/historial/' + str(equipo.id)" 
                                                           class="btn btn-outline-secondary" 
                                                           title="Ver historial">
                                                            <i class="fa fa-history"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                        <!-- Paginación -->
                        <div class="card-footer" t-if="total_pages > 1">
                            <nav>
                                <ul class="pagination justify-content-center mb-0">
                                    <li t-att-class="'page-item ' + ('disabled' if current_page == 1 else '')">
                                        <a class="page-link" t-att-href="'/dashboard/contador?page=' + str(current_page - 1) + ('&amp;search=' + search_query if search_query else '')">
                                            <i class="fa fa-chevron-left"></i>
                                        </a>
                                    </li>
                                    
                                    <t t-foreach="range(max(1, current_page - 2), min(total_pages + 1, current_page + 3))" t-as="page_num">
                                        <li t-att-class="'page-item ' + ('active' if page_num == current_page else '')">
                                            <a class="page-link" t-att-href="'/dashboard/contador?page=' + str(page_num) + ('&amp;search=' + search_query if search_query else '')"
                                               t-esc="page_num"/>
                                        </li>
                                    </t>
                                    
                                    <li t-att-class="'page-item ' + ('disabled' if current_page == total_pages else '')">
                                        <a class="page-link" t-att-href="'/dashboard/contador?page=' + str(current_page + 1) + ('&amp;search=' + search_query if search_query else '')">
                                            <i class="fa fa-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
                
                <!-- Información adicional -->
                <div class="container mt-4 mb-5">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h6 class="text-muted">Total de registros</h6>
                                    <h4 class="text-primary" t-esc="total_equipos">0</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h6 class="text-muted">Mostrando</h6>
                                    <h4 class="text-success">
                                        <t t-esc="len(equipos)"/> de <t t-esc="total_equipos"/>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Botón flotante de refresh -->
                <a href="/dashboard/contador/refresh" class="refresh-btn d-flex align-items-center justify-content-center" title="Actualizar dashboard">
                    <i class="fa fa-sync-alt fa-lg"></i>
                </a>
            </div>
            
            <!-- JavaScript para filtros -->
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    // Filtros de equipos
                    const filterButtons = document.querySelectorAll('.filter-btn');
                    filterButtons.forEach(button =&gt; {
                        button.addEventListener('click', function() {
                            // Remover active de todos
                            filterButtons.forEach(btn =&gt; btn.classList.remove('active'));
                            // Agregar active al clickeado
                            this.classList.add('active');
                            
                            const filter = this.getAttribute('data-filter');
                            filterEquipos(filter);
                        });
                    });
                    
                    function filterEquipos(filter) {
                        const rows = document.querySelectorAll('.machine-row');
                        
                        rows.forEach(row =&gt; {
                            let show = true;
                            
                            if (filter === 'hoy') {
                                // Lógica para mostrar solo equipos de hoy
                                // Se puede implementar verificando la fecha
                            } else if (filter === 'color') {
                                const tipoCell = row.querySelector('td:nth-child(3)');
                                show = tipoCell.textContent.toLowerCase().includes('color');
                            } else if (filter === 'mono') {
                                const tipoCell = row.querySelector('td:nth-child(3)');
                                show = tipoCell.textContent.toLowerCase().includes('monocromatica');
                            }
                            
                            row.style.display = show ? '' : 'none';
                        });
                    }
                    
                    // Auto-refresh cada 5 minutos
                    setInterval(function() {
                        window.location.reload();
                    }, 5 * 60 * 1000);
                });
            </script>
        </t>
    </template>
</odoo>
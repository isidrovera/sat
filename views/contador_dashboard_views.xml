<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Dashboard Principal -->
    <record id="view_contador_dashboard_kanban" model="ir.ui.view">
        <field name="name">contador.dashboard.kanban</field>
        <field name="model">contador.dashboard</field>
        <field name="arch" type="xml">
            <kanban class="o_contador_dashboard" js_class="ContadorDashboardKanban">
                <field name="serie_detectada"/>
                <field name="cliente_detectado"/>
                <field name="tipo_equipo_detectado"/>
                <field name="contador_total_actual"/>
                <field name="contador_bn_actual"/>
                <field name="contador_color_actual"/>
                <field name="ultima_actualizacion"/>
                <field name="estado_ultimo"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click contador-card">
                            <div class="card h-100 shadow-sm border-0">
                                <!-- Header de la tarjeta -->
                                <div class="card-header bg-primary text-white py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0">
                                            <i class="fa fa-building me-2"></i>
                                            <field name="cliente_detectado"/>
                                        </h6>
                                        <span t-attf-class="badge badge-#{record.estado_ultimo.raw_value == 'procesado' ? 'success' : 'warning'}">
                                            <i t-attf-class="fa #{record.estado_ultimo.raw_value == 'procesado' ? 'fa-check' : 'fa-exclamation'}"></i>
                                            <field name="estado_ultimo"/>
                                        </span>
                                    </div>
                                </div>
                                
                                <!-- Cuerpo de la tarjeta -->
                                <div class="card-body">
                                    <!-- Información del equipo -->
                                    <div class="row mb-3">
                                        <div class="col-8">
                                            <div class="d-flex align-items-center mb-2">
                                                <i t-attf-class="fa #{record.tipo_equipo_detectado.raw_value == 'color' ? 'fa-palette text-info' : 'fa-circle text-dark'} me-2"></i>
                                                <span class="fw-bold"><field name="serie_detectada"/></span>
                                            </div>
                                            <small class="text-muted">
                                                <i class="fa fa-tag me-1"></i>
                                                <field name="tipo_equipo_detectado"/>
                                            </small>
                                        </div>
                                        <div class="col-4 text-end">
                                            <div class="contador-total">
                                                <h4 class="text-primary mb-0">
                                                    <field name="contador_total_actual" widget="integer"/>
                                                </h4>
                                                <small class="text-muted">Total</small>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Contadores detallados -->
                                    <div class="row text-center">
                                        <div class="col-4">
                                            <div class="contador-detalle">
                                                <i class="fa fa-circle text-dark mb-1"></i>
                                                <div class="fw-bold"><field name="contador_bn_actual" widget="integer"/></div>
                                                <small class="text-muted">B/N</small>
                                            </div>
                                        </div>
                                        <div class="col-4" t-if="record.tipo_equipo_detectado.raw_value == 'color'">
                                            <div class="contador-detalle">
                                                <i class="fa fa-palette text-info mb-1"></i>
                                                <div class="fw-bold text-info"><field name="contador_color_actual" widget="integer"/></div>
                                                <small class="text-muted">Color</small>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="contador-detalle">
                                                <i class="fa fa-clock text-success mb-1"></i>
                                                <div class="fw-bold text-success">
                                                    <field name="ultima_actualizacion" widget="relative"/>
                                                </div>
                                                <small class="text-muted">Actualizado</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Footer con acciones -->
                                <div class="card-footer bg-light border-0 py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <i class="fa fa-calendar me-1"></i>
                                            <field name="ultima_actualizacion" widget="date"/>
                                        </small>
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-primary" 
                                                name="action_ver_detalle_equipo">
                                            <i class="fa fa-eye me-1"></i>
                                            Detalle
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista de estadísticas superior -->
    <record id="view_contador_dashboard_stats" model="ir.ui.view">
        <field name="name">contador.dashboard.stats</field>
        <field name="model">contador.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard Estadísticas" class="o_contador_stats">
                <div class="alert alert-info text-center mb-4">
                    <h3 class="mb-3">
                        <i class="fa fa-chart-line me-2"></i>
                        Dashboard de Contadores
                    </h3>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="stat-card bg-primary text-white rounded p-3">
                                <i class="fa fa-desktop fa-2x mb-2"></i>
                                <h4 id="equipos_hoy">-</h4>
                                <small>Equipos Hoy</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card bg-success text-white rounded p-3">
                                <i class="fa fa-calendar-week fa-2x mb-2"></i>
                                <h4 id="equipos_semana">-</h4>
                                <small>Equipos Semana</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card bg-info text-white rounded p-3">
                                <i class="fa fa-database fa-2x mb-2"></i>
                                <h4 id="total_equipos">-</h4>
                                <small>Total Sistema</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card bg-warning text-white rounded p-3">
                                <i class="fa fa-percentage fa-2x mb-2"></i>
                                <h4 id="eficiencia">-</h4>
                                <small>Eficiencia</small>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <!-- Acción principal del Dashboard -->
    <record id="action_contador_dashboard" model="ir.actions.act_window">
        <field name="name">📊 Dashboard Contadores</field>
        <field name="res_model">contador.dashboard</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_contador_dashboard_kanban"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face text-center">
                <i class="fa fa-chart-line fa-3x text-primary mb-3"></i>
            </p>
            <h3 class="text-center">¡Bienvenido al Dashboard de Contadores!</h3>
            <p class="text-center text-muted">
                Aquí verás las últimas actualizaciones de contadores de tus equipos.<br/>
                Los datos se actualizan automáticamente cuando llegan correos de contadores.
            </p>
        </field>
    </record>

    <!-- Menú principal -->
    <menuitem id="menu_contador_dashboard_root"
          name="📊 Dashboard Contadores"
          parent="sat_menu_root"
          action="action_contador_dashboard"
          sequence="90"/>
</odoo>
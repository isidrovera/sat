<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Vista de lista -->
         <record id="view_evaluacion_personal_tree" model="ir.ui.view">
                <field name="name">evaluacion.personal.tree</field>
                <field name="model">evaluacion.personal</field>
                <field name="arch" type="xml">
                    <list default_order="fecha desc" 
                        decoration-danger="state=='borrador'" 
                        decoration-success="state=='enviado'" 
                        decoration-warning="puntaje_total&lt;80" 
                        decoration-info="puntaje_total>=80"
                        decoration-muted="state=='cancelado'">
                        <!-- Añadir el botón de envío aquí -->
                        <header>
                            <button name="action_enviar_reportes_masivo" string="Enviar Reportes" type="object" class="btn-primary"/>
                        </header>
                        <field name="name" />
                        <field name="fecha" />
                        <field name="usuario_id" />
                        <field name="cantidad_reparaciones" />
                        <field name="objetivo_reparaciones" />
                        <field name="porcentaje_reparaciones" widget="percentage" />
                        <field name="cantidad_tickets" />
                        <field name="objetivo_tickets" />
                        <field name="porcentaje_tickets" widget="percentage" />
                        <field name="puntaje_total" widget="progressbar" />
                        <field name="nivel_desempeno" />
                        <field name="state" widget="badge" />
                    </list>
                </field>
            </record>

        <!-- Vista de formulario -->
        <record id="view_evaluacion_personal_form" model="ir.ui.view">
            <field name="name">evaluacion.personal.form</field>
            <field name="model">evaluacion.personal</field>
            <field name="arch" type="xml">
                <form>
                    <!-- En la sección del header, reemplazamos states por invisible -->
                    <header>
                        
                        <field name="state" widget="statusbar"
                            statusbar_visible="borrador,en_revision,aprobado,finalizado" />
                            <button name="action_duplicar_abril"
                            string="Duplicar Evaluaciones de Abril"
                            type="object"
                            class="btn btn-primary"
                            />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="ver_reparaciones" type="object" class="oe_stat_button"
                                icon="fa-wrench">
                                <field name="cantidad_reparaciones" widget="statinfo"
                                    string="Reparaciones" />
                            </button>
                            <button name="ver_tickets" type="object" class="oe_stat_button"
                                icon="fa-ticket">
                                <field name="cantidad_tickets" widget="statinfo" string="Tickets" />
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="usuario_id" />
                                <field name="evaluador_id" />
                                <field name="fecha" />
                            </group>
                            <group>
                                <field name="puntaje_total" widget="progressbar" />
                                <field name="nivel_desempeno" />

                            </group>
                        </group>
                        <notebook>
                            <page string="Métricas Objetivas" name="metricas_objetivas">
                                <group>
                                    <group string="Reparaciones (25%)">
                                        <field name="cantidad_reparaciones" />
                                        <field name="objetivo_reparaciones" />
                                        <field name="porcentaje_reparaciones" widget="percentage" />
                                        <field name="puntaje_objetivos" widget="percentage" />
                                    </group>
                                    <group string="Tickets (25%)">
                                        <field name="cantidad_tickets" />
                                        <field name="objetivo_tickets" />
                                        <field name="porcentaje_tickets" widget="percentage" />
                                    </group>
                                </group>
                            </page>
                            <page string="Evaluación Técnica" name="evaluacion_tecnica">
                                <group>
                                    <group string="Calidad del Trabajo">
                                        <field name="calidad_trabajo" />
                                        <field name="conocimiento_tecnico" />
                                        <field name="resolucion_problemas" />
                                        <field name="uso_herramientas" />
                                    </group>
                                    <group string="Actitud y Comportamiento">
                                        <field name="puntualidad" />
                                        <field name="compromiso" />
                                        <field name="trabajo_equipo" />
                                    </group>
                                </group>
                                <group>
                                    <group string="Atención al Cliente">
                                        <field name="trato_cliente" />
                                        <field name="comunicacion_cliente" />
                                        <field name="manejo_conflictos" />
                                    </group>
                                </group>
                            </page>
                            <page string="Retroalimentación" name="retroalimentacion">
                                <group>
                                    <field name="fortalezas" />
                                    <field name="areas_mejora" />
                                    <field name="plan_accion" />
                                    <field name="comentarios" />
                                </group>
                            </page>
                            <page string="Seguimiento" name="seguimiento">
                                <group>
                                    <field name="proxima_evaluacion" />
                                    <field name="objetivos_proximos" />
                                    <field name="necesita_capacitacion" />
                                    <field name="temas_capacitacion" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>

        <!-- Vista Kanban -->
        <record id="view_evaluacion_personal_kanban" model="ir.ui.view">
            <field name="name">evaluacion.personal.kanban</field>
            <field name="model">evaluacion.personal</field>
            <field name="arch" type="xml">
                <kanban default_order="fecha desc" class="o_kanban_small_column" sample="1">
                    <field name="name"/>
                    <field name="usuario_id"/>
                    <field name="fecha"/>
                    <field name="puntaje_total"/>
                    <field name="nivel_desempeno"/>
                    <field name="cantidad_reparaciones"/>
                    <field name="cantidad_tickets"/>
                    <field name="objetivo_reparaciones"/>
                    <field name="objetivo_tickets"/>
                    
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <!-- Cabecera con color según el puntaje -->
                                <div t-attf-class="p-2 text-white #{record.puntaje_total.raw_value >= 80 ? 'bg-success' : (record.puntaje_total.raw_value >= 60 ? 'bg-warning' : 'bg-danger')}">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-user-circle me-2"/>
                                        <div class="flex-grow-1">
                                            <strong><field name="usuario_id"/></strong>
                                            <div class="small">
                                                <i class="fa fa-calendar-alt me-1"/>
                                                <field name="fecha"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="p-2">
                                    <!-- Velocímetro -->
                                    <div class="text-center py-2">
                                        <div class="mb-2">Puntaje Total</div>
                                        <div class="d-flex flex-column align-items-center">
                                            <div class="w-75">
                                                <div t-attf-class="progress" style="height: 100px;">
                                                    <div t-attf-class="progress-bar progress-bar-striped #{record.puntaje_total.raw_value >= 80 ? 'bg-success' : (record.puntaje_total.raw_value >= 60 ? 'bg-warning' : 'bg-danger')}"
                                                        t-attf-style="width: #{record.puntaje_total.raw_value}%"
                                                        role="progressbar">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="h3 mt-2 mb-0">
                                                <t t-esc="Math.round(record.puntaje_total.raw_value)"/>%
                                            </div>
                                            <div t-attf-class="badge mt-1 #{record.puntaje_total.raw_value >= 80 ? 'bg-success' : (record.puntaje_total.raw_value >= 60 ? 'bg-warning' : 'bg-danger')}">
                                                <field name="nivel_desempeno"/>
                                            </div>
                                        </div>
                                    </div>
        
                                    <!-- Métricas -->
                                    <div class="mt-3">
                                        <!-- Reparaciones -->
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <div>
                                                    <i class="fa fa-wrench me-1"/>
                                                    <span>Reparaciones</span>
                                                </div>
                                                <small class="text-muted">
                                                    <field name="cantidad_reparaciones"/> / <field name="objetivo_reparaciones"/>
                                                </small>
                                            </div>
                                            <div class="progress" style="height: 4px;">
                                                <div class="progress-bar bg-primary"
                                                    t-att-style="'width: ' + (record.cantidad_reparaciones.raw_value / record.objetivo_reparaciones.raw_value * 100) + '%'">
                                                </div>
                                            </div>
                                        </div>
        
                                        <!-- Tickets -->
                                        <div>
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <div>
                                                    <i class="fa fa-ticket-alt me-1"/>
                                                    <span>Tickets</span>
                                                </div>
                                                <small class="text-muted">
                                                    <field name="cantidad_tickets"/> / <field name="objetivo_tickets"/>
                                                </small>
                                            </div>
                                            <div class="progress" style="height: 4px;">
                                                <div class="progress-bar bg-info"
                                                    t-att-style="'width: ' + (record.cantidad_tickets.raw_value / record.objetivo_tickets.raw_value * 100) + '%'">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <!-- Vista Pivote -->
        <record id="view_evaluacion_personal_pivot" model="ir.ui.view">
            <field name="name">evaluacion.personal.pivot</field>
            <field name="model">evaluacion.personal</field>
            <field name="arch" type="xml">
                <pivot string="Análisis de Evaluaciones">
                    <field name="fecha" type="row" interval="month" />
                    <field name="usuario_id" type="row" />
                    <field name="cantidad_reparaciones" type="measure" />
                    <field name="cantidad_tickets" type="measure" />
                    <field name="puntaje_total" type="measure" />
                    <field name="porcentaje_reparaciones" type="measure" />
                    <field name="porcentaje_tickets" type="measure" />
                </pivot>
            </field>
        </record>

        <!-- Vista Gráfica -->
        <record id="view_evaluacion_personal_graph" model="ir.ui.view">
            <field name="name">evaluacion.personal.graph</field>
            <field name="model">evaluacion.personal</field>
            <field name="arch" type="xml">
                <graph string="Análisis de Desempeño" type="bar">
                    <field name="usuario_id" />
                    <field name="puntaje_total" type="measure" />
                </graph>
            </field>
        </record>

        <!-- Acción de Ventana -->
        <record id="action_evaluacion_personal" model="ir.actions.act_window">
            <field name="name">Evaluación de Personal</field>
            <field name="res_model">evaluacion.personal</field>
            <field name="view_mode">list,form,kanban,pivot,graph</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear primera evaluación de personal
                </p>
                <p>
                    Realice evaluaciones periódicas del personal técnico.
                </p>
            </field>
        </record>

        <!-- Elemento de Menú -->
        <menuitem id="menu_evaluacion_personal"
            name="Evaluación de Personal"
            parent="sat_menu_root"
            action="action_evaluacion_personal"
            sequence="60" />
    </data>
</odoo>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_evaluador_diario" model="ir.cron">
            <field name="name">Evaluador Diario</field>
            <field name="model_id" ref="model_sat_sat"/>
            <field name="state">code</field>
            <field name="code">model.cron_evaluador_diario()</field>
            <field name="interval_type">days</field>
            <field name="interval_number">1</field>         
        </record>
        <!-- Cron Job para notificar sobre tickets pendientes -->
        <record id="ir_cron_notificar_tickets_pendientes" model="ir.cron">
            <field name="name">Notificar técnicos sobre tickets pendientes</field>
            <field name="model_id" ref="model_ticket_alquiler"/>
            <field name="state">code</field>
            <field name="code">model._cron_notificar_tickets_pendientes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>            
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=8, minute=30, second=0)"/>
        </record>
    </data>
</odoo>

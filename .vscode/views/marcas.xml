<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="Marcas_form_view" model="ir.ui.view">
            <field name="name">Marcas.form</field>
            <field name="model">marca.marca</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>                        
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                               
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="Marcas_tree_view" model="ir.ui.view">
            <field name="name">Marcas.tree</field>
            <field name="model">marca.marca</field>
            <field name="arch" type="xml">
                <list string="ModelTitle">
                    <field name="name"/>                   
                </list>
            </field>
        </record>
    </data>
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Template para vista normal -->
    <t t-name="sat.StatusWidget" owl="1">
        <div class="o_status_widget">
            <t t-foreach="getSelectionValues()" t-as="option" t-key="option[0]">
                <button type="button"
                        class="status-button"
                        t-att-class="{ 'selected': option[0] === props.value }"
                        t-on-click="() => this.onStatusClick(option[0])"
                        t-att-disabled="props.readonly">
                    <div class="status-content"
                         t-att-style="'background-color: ' + getStatusConfig(option[0]).bgColor + ';' +
                                    'border-color: ' + getStatusConfig(option[0]).color + ';' +
                                    'color: ' + getStatusConfig(option[0]).color + ';'">
                        <i t-att-class="getStatusConfig(option[0]).icon"/>
                        <span class="status-label" t-esc="option[1]"/>
                    </div>
                </button>
            </t>
        </div>
    </t>

    <!-- Template para vista kanban -->
    <t t-name="sat.StatusKanbanWidget" owl="1">
        <div class="o_status_widget_kanban">
            <span class="status-label"
                  t-att-style="'color: ' + getStatusConfig(props.value).color + ';'">
                <i t-att-class="getStatusConfig(props.value).icon"/>
                <t t-foreach="getSelectionValues()" t-as="option" t-key="option[0]">
                    <t t-if="option[0] === props.value">
                        <t t-esc="option[1]"/>
                    </t>
                </t>
            </span>
        </div>
    </t>
</templates>
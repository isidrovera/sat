<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="StatusWidget" owl="1">
        <div class="status-widget-container">
            <t t-foreach="Object.entries(status_config)" t-as="[value, config]" t-key="value">
                <button 
                    type="button"
                    class="status-button"
                    t-att-class="{ selected: props.value === value }"
                    t-on-click="() => this._onSelectChange(value)"
                    t-att-disabled="props.readonly"
                    t-att-style="'background-color: ' + config.bgColor + ';' +
                               'border-color: ' + config.color + ';' +
                               'color: ' + config.color + ';'">
                    <i t-att-class="config.icon"/>
                    <span t-esc="config.label"/>
                </button>
            </t>
        </div>
    </t>
</templates>
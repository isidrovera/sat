<?xml version="1.0" encoding="UTF-8"?>

    <templates xml:space="preserve">
    <t t-name="sat.ListView.Buttons" owl="1">
        <div class="o_list_buttons">
            <t t-call="web.ListView.Buttons"/>
            <div class="sat-dashboard-buttons d-flex gap-2 flex-wrap w-100 mt-2 border-top pt-2">
                <button t-on-click="() => this.applyFilter(false)"
                        class="btn btn-light d-inline-flex align-items-center">
                    <i class="fa fa-cogs me-1 text-muted"/>
                    <span><t t-out="state.dashboardData.total"/> Total</span>
                </button>

                <button t-on-click="() => this.applyFilter('disponible')"
                        class="btn btn-success d-inline-flex align-items-center">
                    <i class="fa fa-check-circle me-1"/>
                    <span><t t-out="state.dashboardData.disponibles"/> Disponibles</span>
                </button>

                <button t-on-click="() => this.applyFilter('separada')"
                        class="btn btn-warning d-inline-flex align-items-center">
                    <i class="fa fa-exclamation-circle me-1"/>
                    <span><t t-out="state.dashboardData.separadas"/> Separadas</span>
                </button>

                <button t-on-click="() => this.applyFilter('no_disponible')"
                        class="btn btn-danger d-inline-flex align-items-center">
                    <i class="fa fa-times-circle me-1"/>
                    <span><t t-out="state.dashboardData.noDisponibles"/> No Disponibles</span>
                </button>
            </div>
        </div>
    </t>
</templates>

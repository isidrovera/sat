<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="sat.DashboardTemplate">
        <div class="row">
            <!-- Indicadores Numéricos -->
            <div class="col-md-4">
                <h3>Reparaciones Programadas Hoy: <span id="reparacionesHoy"></span></h3>
                <h3>Tickets Programados Hoy: <span id="ticketsHoy"></span></h3>
            </div>
            
            <!-- Gráfico de barras para Reparaciones y Tickets por Mes -->
            <div class="col-md-8">
                <canvas id="barChartMes"></canvas>
            </div>

            <!-- Gráfico circular para Reparaciones por Técnico -->
            <div class="col-md-6">
                <canvas id="pieReparaciones"></canvas>
            </div>
        </div>
    </t>
</templates>

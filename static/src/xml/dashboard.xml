<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="sat.DashboardTemplate">
        <div class="row main-section dashboard-container">

            <!-- Fila para Máquinas -->
            <div class="row dashboard-tiles maquinas-tiles">
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-cogs"></i>
                            <h3>Total Máquinas</h3>
                            <span id="total_maquinas">0</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-check-circle"></i>
                            <h3>Máquinas Disponibles</h3>
                            <span id="maquinas_disponibles">0</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-pause-circle"></i>
                            <h3>Máquinas Separadas</h3>
                            <span id="maquinas_separadas">0</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-times-circle"></i>
                            <h3>Máquinas No Disponibles</h3>
                            <span id="maquinas_no_disponibles">0</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fila para Reparaciones -->
            <div class="row dashboard-tiles reparaciones-tiles">
                <!-- Total Reparaciones -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-wrench"></i> <!-- Icono general de reparaciones -->
                            <h3>Total Reparaciones</h3>
                            <span id="total_reparaciones">0</span>
                        </div>
                    </div>
                </div>

                <!-- Reparaciones en Revisión -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-spinner"></i> <!-- Icono de progreso -->
                            <h3>Reparaciones en Revisión</h3>
                            <span id="reparaciones_en_revision">0</span>
                        </div>
                    </div>
                </div>
                <!-- Reparaciones Finalizadas -->
                <div class="col-md-2 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-check-circle"></i> <!-- Icono de finalizado -->
                            <h3>Reparaciones Finalizadas</h3>
                            <span id="reparaciones_finalizadas">0</span>
                        </div>
                    </div>
                </div>

                <!-- Reparaciones con Problemas -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-exclamation-triangle"></i> <!-- Icono de advertencia -->
                            <h3>Reparaciones con Problemas</h3>
                            <span id="reparaciones_con_problemas">0</span>
                        </div>
                    </div>
                </div>

                <!-- Reparaciones de Partes -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-cogs"></i> <!-- Icono de partes -->
                            <h3>Reparaciones de Partes</h3>
                            <span id="reparaciones_de_partes">0</span>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Fila para Tickets de Soporte Técnico -->
            <div class="row dashboard-tiles tickets-tiles">
                <!-- Total Tickets -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-life-ring"></i> <!-- Icono de soporte técnico general -->
                            <h3>Total Tickets</h3>
                            <span id="total_tickets">0</span>
                        </div>
                    </div>
                </div>

                <!-- Tickets Nuevos -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-plus-square"></i> <!-- Icono de nuevo ticket de soporte -->
                            <h3>Tickets Nuevos</h3>
                            <span id="tickets_nuevos">0</span>
                        </div>
                    </div>
                </div>

                <!-- Tickets en Proceso -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-cogs"></i> <!-- Icono de ticket en proceso de soporte -->
                            <h3>Tickets en Proceso</h3>
                            <span id="tickets_en_proceso">0</span>
                        </div>
                    </div>
                </div>

                <!-- Tickets Finalizados -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-check-circle"></i> <!-- Icono de ticket de soporte
                            finalizado -->
                            <h3>Tickets Finalizados</h3>
                            <span id="tickets_finalizados">0</span>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Fila para Alquiler de Fotocopiadoras -->
            <div class="row dashboard-tiles alquiler-tiles">
                <!-- Total Alquileres -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-archive"></i> <!-- Icono general de alquiler -->
                            <h3>Total Alquileres</h3>
                            <span id="total_alquileres">0</span>
                        </div>
                    </div>
                </div>

                <!-- Alquileres en Stock -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-box"></i> <!-- Icono de stock -->
                            <h3>En Stock</h3>
                            <span id="alquiler_stock">0</span>
                        </div>
                    </div>
                </div>

                <!-- Alquileres Lista -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-check-square"></i> <!-- Icono de lista -->
                            <h3>Lista</h3>
                            <span id="alquiler_lista">0</span>
                        </div>
                    </div>
                </div>

                <!-- Alquileres Para Venta -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-tag"></i> <!-- Icono de venta -->
                            <h3>Para Venta</h3>
                            <span id="alquiler_para_venta">0</span>
                        </div>
                    </div>
                </div>

                <!-- Alquileres Alquilada -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-handshake"></i> <!-- Icono de alquilada -->
                            <h3>Alquilada</h3>
                            <span id="alquiler_alquilada">0</span>
                        </div>
                    </div>
                </div>

                <!-- Alquileres con Problemas -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-exclamation-circle"></i> <!-- Icono de problemas -->
                            <h3>Con Problemas</h3>
                            <span id="alquiler_con_problemas">0</span>
                        </div>
                    </div>
                </div>

                <!-- Alquileres de Partes -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-cogs"></i> <!-- Icono de partes -->
                            <h3>De Partes</h3>
                            <span id="alquiler_partes">0</span>
                        </div>
                    </div>
                </div>

                <!-- Alquileres Externos -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-external-link-alt"></i> <!-- Icono de externo -->
                            <h3>Externo</h3>
                            <span id="alquiler_externo">0</span>
                        </div>
                    </div>
                </div>

                <!-- Alquileres Vendidos -->
                <div class="col-md-3 col-sm-6 tot_tasks">
                    <div class="oh-card">
                        <div class="oh-card-body text-center">
                            <i class="fa fa-shopping-cart"></i> <!-- Icono de vendido -->
                            <h3>Vendida</h3>
                            <span id="alquiler_vendida">0</span>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Gráficos -->
            <div class="row dashboard-charts">
                <div class="col-md-6">
                    <div class="chart-wrapper">
                        <div class="chart-header">
                            <h4>Máquinas por Disponibilidad</h4>
                            <button class="expand-button">
                                <i class="fa fa-expand"></i>
                            </button>
                        </div>
                        <div class="chart-container">
                            <canvas id="disponibilidadChart"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="chart-wrapper">
                        <div class="chart-header">
                            <h4>Máquinas por Estado</h4>
                            <button class="expand-button">
                                <i class="fa fa-expand"></i>
                            </button>
                        </div>
                        <div class="chart-container">
                            <canvas id="estadoChart"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="chart-wrapper">
                        <div class="chart-header">
                            <h4>Reparaciones por Técnico</h4>
                            <button class="expand-button">
                                <i class="fa fa-expand"></i>
                            </button>
                        </div>
                        <div class="chart-container">
                            <canvas id="tecnicosChart"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="chart-wrapper">
                        <div class="chart-header">
                            <h4>Máquinas por Asesora</h4>
                            <button class="expand-button">
                                <i class="fa fa-expand"></i>
                            </button>
                        </div>
                        <div class="chart-container">
                            <canvas id="asesoraChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
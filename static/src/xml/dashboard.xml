<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="sat.DashboardTemplate">
        <div class="raw main-section dashboard-container">
            <div class="content-scroll">
                

                <!-- Fila para Máquinas -->
                <div class="dashboard-tiles maquinas-tiles">
                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_total_maquinas">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-print" />
                                <h3>Máquinas</h3>
                                <span id="total_maquinas">0</span>
                            </div>
                        </div>
                    </div>
                
                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_maquinas_disponibles">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-check-circle" />
                                <h3>Disponibles</h3>
                                <span id="maquinas_disponibles">0</span>
                            </div>
                        </div>
                    </div>
                
                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_maquinas_separadas">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-pause-circle" />
                                <h3>Separadas</h3>
                                <span id="maquinas_separadas">0</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_maquinas_con_problemas">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-exclamation-triangle" />
                                <h3>Problemas</h3>
                                <span id="maquinas_con_problemas">0</span>
                            </div>
                        </div>
                    </div>
                
                    <!-- Botón "Partes" dentro del mismo contenedor -->
                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_maquinas_de_partes">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-exclamation-triangle" />
                                <h3>Partes</h3>
                                <span id="maquinas_de_partes">0</span>
                            </div>
                        </div>
                    </div>
                </div>
                

                <!-- Fila para Reparaciones -->
                <div class="dashboard-tiles reparaciones-tiles">
                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_total_reparaciones">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-wrench" />
                                <h3>Reparaciones</h3>
                                <span id="total_reparaciones">0</span>
                            </div>
                        </div>
                    </div>
                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_maquinas_sin_revisar">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-exclamation-circle text-danger" />
                                <h3>Sin revisar</h3>
                                <span id="maquinas_sin_revisar">0</span>
                            </div>
                        </div>
                    </div>
                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_maquinas_para_revision">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-cogs" />
                                <h3>Para revisión</h3>
                                <span id="maquinas_para_revision">0</span>
                            </div>
                        </div>
                    </div>
                   

                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_reparaciones_en_revision">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-spinner" />
                                <h3>Revisión</h3>
                                <span id="reparaciones_en_revision">0</span>
                            </div>
                        </div>
                    </div>

                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_reparaciones_finalizado">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-check-circle"  />
                                <h3>Finalizadas</h3>
                                <span id="reparaciones_finalizado">0</span>
                            </div>
                        </div>
                    </div>

                <!--    <div class="col-lg-3 col-md-4 col-sm-6 col-12 tot_tasks">
                        <div class="oh-card">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-exclamation-triangle" />
                                <h3>Problemas</h3>
                                <span id="reparaciones_con_problemas">0</span>
                            </div>
                        </div>
                    </div>-->
                </div>

                <!-- Fila para Tickets de Soporte Técnico -->
                <div class="dashboard-tiles tickets-tiles">
                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_total_tickets">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-life-ring" />
                                <h3>Tickets</h3>
                                <span id="total_tickets">0</span>
                            </div>
                        </div>
                    </div>

                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_tickets_nuevos">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-plus-square" />
                                <h3>Nuevos</h3>
                                <span id="tickets_nuevos">0</span>
                            </div>
                        </div>
                    </div>

                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_tickets_proceso">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-cogs" />
                                <h3>Proceso</h3>
                                <span id="tickets_proceso">0</span>
                            </div>
                        </div>
                    </div>

                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_tickets_finalizado">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-check-circle text-success" />
                                <h3>Finalizados</h3>
                                <span id="tickets_finalizado">0</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fila para Alquiler de Fotocopiadoras -->
                <div class="dashboard-tiles alquiler-tiles">
                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_total_maquinas_alquiler">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-archive" />
                                <h3>Alquileres</h3>
                                <span id="total_maquinas_alquiler">0</span>
                            </div>
                        </div>
                    </div>

                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_alquiler_sin_revisar">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-exclamation-circle text-danger" />
                                <h3>Sin revisar</h3>
                                <span id="alquiler_sin_revisar">0</span>
                            </div>
                        </div>
                    </div>
                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_alquiler_revisada">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-check-circle text-success" />
                                <h3>Revisada</h3>
                                <span id="alquiler_revisada">0</span>
                            </div>
                        </div>
                    </div>

                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_alquiler_lista">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-check-square" />
                                <h3>Lista</h3>
                                <span id="alquiler_lista">0</span>
                            </div>
                        </div>
                    </div>

                    <div class="tot_tasks">
                        <div class="oh-card" id="tile_alquiler_con_problemas">
                            <div class="oh-card-body text-center">
                                <i class="fa fa-exclamation-triangle" />
                                <h3>Problemas</h3>
                                <span id="alquiler_con_problemas">0</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fila para Gráficos -->
                <div class="row dashboard-charts">
                    <!-- Gráfico 1: Máquinas por Disponibilidad -->
                    <div class="col-lg-6 col-md-12">
                        <div class="chart-wrapper">
                            <div class="chart-header">
                                <h4>Máquinas por Disponibilidad</h4>
                                <button class="expand-button">
                                    <i class="fa fa-expand" />
                                </button>
                            </div>                            
                            <div class="chart-container">
                                <div id="disponibilidadChart" style="width: 100%; height: 100%;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Gráfico 2: Estado de las Máquinas -->
                    <div class="col-lg-6 col-md-12">
                        <div class="chart-wrapper">
                            <div class="chart-header">
                                <h4>Estado de Máquinas</h4>
                                <button class="expand-button">
                                    <i class="fa fa-expand"></i>
                                </button>
                            </div>
                            <div class="chart-container">
                                <div id="estadoChart" style="width: 100%; height: 100%;"></div>
                            </div>
                        </div>
                    </div>
                    <!-- Gráfico 3: Reparaciones por Técnico -->
                    <div class="col-lg-6 col-md-12">
                        <div class="chart-wrapper">
                            <div class="chart-header">
                                <h4>Reparaciones por Técnico</h4>
                                <button class="expand-button">
                                    <i class="fa fa-expand" />
                                </button>
                            </div>
                            <div class="filter-section mb-3 d-flex align-items-center">
                                <label for="startDateTecnicos" class="mr-2">Fecha de Inicio:</label>
                                <input type="date" id="startDateTecnicos" class="form-control mr-2"
                                    style="width: auto;" />
                                <label for="endDateTecnicos" class="mr-2">Fecha de Fin:</label>
                                <input type="date" id="endDateTecnicos" class="form-control mr-2"
                                    style="width: auto;" />
                                <button id="applyFilterTecnicos" class="btn btn-primary">Aplicar
                                    Filtros</button>
                            </div>
                            <div class="chart-container">
                                <canvas id="tecnicosChart" />
                            </div>
                        </div>
                    </div>

                    <!-- Gráfico 4: Tickets por Técnico -->
                    <div class="col-lg-6 col-md-12">
                        <div class="chart-wrapper">
                            <div class="chart-header">
                                <h4>Tickets por Técnico</h4>
                                <button class="expand-button">
                                    <i class="fa fa-expand" />
                                </button>
                            </div>
                            <div class="filter-section mb-3 d-flex align-items-center">
                                <label for="startDate" class="mr-2">Fecha de Inicio:</label>
                                <input type="date" id="startDate" class="form-control mr-2"
                                    style="width: auto;" />
                                <label for="endDate" class="mr-2">Fecha de Fin:</label>
                                <input type="date" id="endDate" class="form-control mr-2"
                                    style="width: auto;" />
                                <button id="applyFilter" class="btn btn-primary">Aplicar Filtros</button>
                            </div>
                            <div class="chart-container">
                                <canvas id="ticketsTecnicoChart" />
                            </div>
                        </div>
                    </div>

                    <!-- Gráfico: Tickets por Mes -->
                    <div class="col-lg-6 col-md-12">
                        <div class="chart-wrapper">
                            <div class="chart-header">
                                <h4>Tickets por Mes</h4>
                                <button class="expand-button">
                                    <i class="fa fa-expand" />
                                </button>
                            </div>
                            <div class="chart-container">
                                <canvas id="ticketsMesChart" />
                            </div>
                        </div>
                    </div>
                    <!-- Gráfico: Tickets por Año -->
                    <div class="col-lg-6 col-md-12">
                        <div class="chart-wrapper">
                            <div class="chart-header">
                                <h4>Tickets por Año</h4>
                                <button class="expand-button">
                                    <i class="fa fa-expand" />
                                </button>
                            </div>
                            <div class="chart-container">
                                <canvas id="ticketsAnoChart" />
                            </div>
                        </div>
                    </div>

                    <!-- Gráfico: Máquinas por Asesora -->
                    <div class="col-lg-6 col-md-12">
                        <div class="chart-wrapper">
                            <div class="chart-header">
                                <h4>Máquinas por Asesora</h4>
                                <button class="expand-button">
                                    <i class="fa fa-expand" />
                                </button>
                            </div>
                            <div class="chart-container">
                                <canvas id="asesoraChart" />
                            </div>
                        </div>
                    </div>
                </div>
                    
                    <!-- Gráfico: Alquileres por Cliente -->
                    <div class="col-12">
                        <div class="chart-wrapper">
                            <div class="chart-header">
                                <h4>Alquileres por Cliente</h4>
                                <button class="expand-button">
                                    <i class="fa fa-expand"/>
                                </button>
                            </div>
                            <div class="chart-container" style="height: 400px; max-width: 100%; overflow: hidden;">
                                <canvas id="alquileresClienteChart"/>
                            </div>
                        </div>
                    </div>
                    

                <!-- Pie de página -->
                <div class="row mt-4">
                    <div class="col-12 text-center">
                        <p class="text-muted">© Isidro Vera</p>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
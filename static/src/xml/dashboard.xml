<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="sat.DashboardTemplate">
        <div class="row">
            <!-- Gráfico de barras para Evaluaciones, Reparaciones, Alquileres y Máquinas en alquiler -->
            <div class="col-md-6">
                <canvas id="myBarChart"></canvas>
            </div>
            <!-- Gráfico circular para Costes, Ingresos y Beneficio -->
            <div class="col-md-6">
                <canvas id="myPieChart"></canvas>
            </div>
        </div>
        <div class="row">
            <!-- Gráfico tipo Gauge para mostrar la relación Coste vs Beneficio -->
            <div class="col-md-6">
                <canvas id="myGaugeChart"></canvas>
            </div>
            <!-- Gráfico de línea para la evolución de las puntuaciones de las evaluaciones -->
            <div class="col-md-6">
                <canvas id="myLineChart"></canvas>
            </div>
        </div>
    </t>
</templates>

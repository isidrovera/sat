<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="sat.DashboardTemplate">
        <div class="row main-section" style="margin-left: 120px;">
            <!-- Tile para Evaluaciones -->
            <div class="col-md-3 col-sm-6 tot_tasks" style="padding: 20px;">
                <div class="oh-card">
                    <div class="oh-card-body">
                        <h3>Total Evaluaciones</h3>
                        <span id="total_evaluaciones">0</span>
                    </div>
                </div>
            </div>
            <!-- Tile para Reparaciones -->
            <div class="col-md-3 col-sm-6 tot_tasks" style="padding: 20px;">
                <div class="oh-card">
                    <div class="oh-card-body">
                        <h3>Total Reparaciones</h3>
                        <span id="total_reparaciones">0</span>
                    </div>
                </div>
            </div>
            <!-- Tile para Tickets de Alquiler -->
            <div class="col-md-3 col-sm-6 tot_tasks" style="padding: 20px;">
                <div class="oh-card">
                    <div class="oh-card-body">
                        <h3>Total Tickets de Alquiler</h3>
                        <span id="total_alquileres">0</span>
                    </div>
                </div>
            </div>
            <!-- Tile para Máquinas en Alquiler -->
            <div class="col-md-3 col-sm-6 tot_tasks" style="padding: 20px;">
                <div class="oh-card">
                    <div class="oh-card-body">
                        <h3>Total Máquinas en Alquiler</h3>
                        <span id="total_maquinas">0</span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Gráficos ya existentes -->
        <div class="row">
            <div class="col-md-6">
                <canvas id="myBarChart"></canvas>
            </div>
            <!-- Otros gráficos -->
        </div>
    </t>
</templates>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sat.ChipSelectField">
        <div class="o_chip_select" t-att-class="{ 'o_readonly': props.readonly }">

            <div class="o_chip_select_loading" t-if="uiState.loading">
                <i class="fa fa-spinner fa-spin"/>
                <span> Cargando estados...</span>
            </div>

            <div class="o_chip_select_empty"
                 t-if="!uiState.loading and uiState.options.length === 0">
                <i class="fa fa-info-circle me-1"/>
                <span>No hay estados disponibles</span>
            </div>

            <div t-if="!uiState.loading and uiState.options.length > 0">

                <button t-if="selectedOption"
                        type="button"
                        class="o_chip o_chip_current"
                        t-att-class="{
                            'o_chip_saving': uiState.saving,
                            'o_chip_saved': uiState.saved,
                            'o_chip_error': uiState.saveError
                        }"
                        t-att-style="getChipStyle(selectedOption, true)"
                        t-att-title="selectedOption.name"
                        t-on-click.stop.prevent="(ev) => toggleOptions(ev)">

                    <span class="o_chip_check" t-if="!uiState.saving">✓</span>
                    <span class="o_chip_check" t-if="uiState.saving">
                        <i class="fa fa-spinner fa-spin"/>
                    </span>

                    <span class="o_chip_label" t-esc="getShortLabel(selectedOption)"/>

                    <span class="o_chip_arrow" t-if="!uiState.expanded">▼</span>
                    <span class="o_chip_arrow" t-if="uiState.expanded">▲</span>
                </button>

                <div class="o_chip_save_status"
                     t-if="uiState.saveMessage"
                     t-att-class="{
                        'o_chip_save_status_saving': uiState.saving,
                        'o_chip_save_status_saved': uiState.saved,
                        'o_chip_save_status_error': uiState.saveError
                     }">
                    <span t-esc="uiState.saveMessage"/>
                </div>

                <div class="o_chip_select_grid"
                     t-if="!selectedOption or uiState.expanded">

                    <t t-foreach="uiState.options" t-as="option" t-key="option.id">
                        <button type="button"
                                class="o_chip"
                                t-att-class="{ 'o_chip_selected': isSelected(option) }"
                                t-att-style="getChipStyle(option, isSelected(option))"
                                t-att-title="option.name"
                                t-on-click.stop.prevent="(ev) => select(option, ev)">

                            <span class="o_chip_check" t-if="isSelected(option)">✓</span>
                            <span class="o_chip_label" t-esc="getShortLabel(option)"/>

                        </button>
                    </t>

                </div>

            </div>

        </div>
    </t>

</templates>
<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sat.ChipSelectField">
        <div class="o_chip_select" t-att-class="{ 'o_readonly': props.readonly }">

            <div class="o_chip_select_loading" t-if="uiState.loading">
                <i class="fa fa-spinner fa-spin"/>
                <span> Cargando estados...</span>
            </div>

            <div class="o_chip_select_empty" t-if="!uiState.loading and uiState.options.length === 0">
                <i class="fa fa-info-circle me-1"/>
                <span>No hay estados disponibles para este componente</span>
            </div>

            <div class="o_chip_select_grid" t-if="!uiState.loading and uiState.options.length > 0">
                <t t-foreach="uiState.options" t-as="option" t-key="option.id">
                    <button type="button"
                            class="o_chip"
                            t-att-class="{ 'o_chip_selected': isSelected(option) }"
                            t-att-style="getChipStyle(option, isSelected(option))"
                            t-att-title="option.name"
                            t-on-click="() => this.select(option)">
                        <span class="o_chip_check" t-if="isSelected(option)">✓</span>
                        <span class="o_chip_label" t-esc="getShortLabel(option)"/>
                    </button>
                </t>
            </div>

        </div>
    </t>

</templates>
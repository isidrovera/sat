<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sat.SatPruebasDashboardWidget">

        <div t-att-class="isColorMachine ? 'sat_pruebas_dashboard sat_dashboard_color' : 'sat_pruebas_dashboard sat_dashboard_bn'">

            <!-- ======================================================
                 EMPTY STATE
                 ====================================================== -->
            <t t-if="!hasData">
                <div class="sat_empty_state">
                    <div class="sat_empty_icon">
                        <i class="fa fa-flask"/>
                    </div>
                    <div>
                        <h3>No hay pruebas técnicas registradas</h3>
                        <p>Cuando SNMP genere lecturas, aquí aparecerán contadores, tóner, unidades y validaciones.</p>
                    </div>
                </div>
            </t>

            <t t-if="hasData">

                <!-- ======================================================
                     HERO / HEADER
                     ====================================================== -->
                <div class="sat_dashboard_hero">

                    <div class="sat_dashboard_hero_left">
                        <div class="sat_dashboard_overline">
                            Dashboard técnico SNMP
                        </div>

                        <h2>
                            <t t-esc="data.modelo || 'Máquina'"/>
                        </h2>

                        <div class="sat_dashboard_meta">
                            <span>
                                <i class="fa fa-barcode"/>
                                Serie:
                                <strong>
                                    <t t-esc="data.serie || '-'"/>
                                </strong>
                            </span>

                            <t t-if="ultima.snmp_ip">
                                <span>
                                    <i class="fa fa-wifi"/>
                                    IP:
                                    <strong>
                                        <t t-esc="ultima.snmp_ip"/>
                                    </strong>
                                </span>
                            </t>

                            <span t-att-class="'sat_machine_badge ' + machineTypeClass">
                                <i t-att-class="'fa ' + machineTypeIcon"/>
                                Tipo:
                                <strong>
                                    <t t-esc="machineTypeLabel"/>
                                </strong>
                            </span>

                            <t t-if="ultima.snmp_marca">
                                <span>
                                    <i class="fa fa-industry"/>
                                    Marca:
                                    <strong>
                                        <t t-esc="ultima.snmp_marca"/>
                                    </strong>
                                </span>
                            </t>
                        </div>
                    </div>

                    <div class="sat_dashboard_hero_right">
                        <span t-att-class="'sat_big_badge ' + estadoGeneralClass">
                            <i class="fa fa-check-circle"/>
                            <t t-esc="ultima.estado_prueba_label || 'Pendiente'"/>
                        </span>

                        <span t-att-class="'sat_big_badge ' + tonerGeneralClass">
                            <i class="fa fa-tint"/>
                            Tóner:
                            <t t-esc="ultima.estado_toner_label || 'Sin datos'"/>
                        </span>

                        <span t-if="hasAlertas" class="sat_big_badge sat_estado_con_alertas">
                            <i class="fa fa-warning"/>
                            <t t-esc="alertasCount"/>
                            alerta(s)
                        </span>
                    </div>

                </div>

                <!-- ======================================================
                     RESUMEN SUPERIOR
                     ====================================================== -->
                <div class="sat_summary_strip">

                    <div class="sat_summary_item">
                        <div class="sat_summary_icon sat_summary_blue">
                            <i class="fa fa-database"/>
                        </div>
                        <div>
                            <span>Lecturas</span>
                            <strong>
                                <t t-esc="totalPruebas"/>
                            </strong>
                        </div>
                    </div>

                    <div class="sat_summary_item">
                        <div class="sat_summary_icon sat_summary_green">
                            <i class="fa fa-check-circle"/>
                        </div>
                        <div>
                            <span>Validaciones</span>
                            <strong>
                                <t t-esc="checksOkCount"/>
                                /
                                <t t-esc="checksTotalCount"/>
                            </strong>
                        </div>
                    </div>

                    <div class="sat_summary_item">
                        <div class="sat_summary_icon sat_summary_toner">
                            <i class="fa fa-tint"/>
                        </div>
                        <div>
                            <span>Tóner mínimo</span>
                            <strong>
                                <t t-esc="tonerMinimo"/>
                                %
                            </strong>
                        </div>
                    </div>

                    <div class="sat_summary_item">
                        <div class="sat_summary_icon sat_summary_units">
                            <i class="fa fa-cogs"/>
                        </div>
                        <div>
                            <span>Componentes</span>
                            <strong>
                                <t t-esc="componentesSnmp.length"/>
                            </strong>
                        </div>
                    </div>

                </div>

                <!-- ======================================================
                     CONTADORES
                     ====================================================== -->
                <div class="sat_section_header">
                    <div>
                        <h3>Contadores principales</h3>
                        <p>Lectura actual y diferencia desde el inicio de la prueba.</p>
                    </div>
                    <span class="sat_section_pill">
                        <t t-esc="totalPruebas"/>
                        lectura(s)
                    </span>
                </div>

                <div class="sat_kpi_grid">
                    <t t-foreach="counters" t-as="counter" t-key="counter.key">
                        <div t-att-class="counter.main ? 'sat_kpi_card sat_kpi_main sat_kpi_' + counter.accent : 'sat_kpi_card sat_kpi_' + counter.accent">
                            <div class="sat_kpi_icon">
                                <i t-att-class="'fa ' + counter.icon"/>
                            </div>

                            <div class="sat_kpi_body">
                                <div class="sat_kpi_label">
                                    <t t-esc="counter.label"/>
                                </div>

                                <div class="sat_kpi_value">
                                    <t t-esc="formatValue(counter.value, counter.delta)"/>
                                </div>

                                <div class="sat_kpi_footer">
                                    <t t-esc="counter.footer"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- ======================================================
                     TÓNER
                     ====================================================== -->
                <div class="sat_panel sat_panel_toner">

                    <div class="sat_panel_header">
                        <div>
                            <h3>Niveles de tóner</h3>
                            <p>
                                <t t-esc="tonerResumenTexto"/>
                            </p>
                        </div>

                        <span class="sat_panel_date">
                            <i class="fa fa-clock-o"/>
                            <t t-esc="ultima.fecha_ultima_actualizacion || '-'"/>
                        </span>
                    </div>

                    <div t-att-class="isColorMachine ? 'sat_toner_grid sat_toner_grid_color' : 'sat_toner_grid sat_toner_grid_bn'">
                        <t t-foreach="tonerCards" t-as="toner" t-key="toner.key">

                            <div t-att-class="'sat_toner_card ' + toner.className + ' ' + getTonerLevelClass(toner.value)">

                                <div class="sat_toner_card_top">
                                    <div>
                                        <span class="sat_toner_code">
                                            <t t-esc="toner.code"/>
                                        </span>
                                    </div>

                                    <div class="sat_toner_title">
                                        <strong>
                                            <t t-esc="toner.label"/>
                                        </strong>
                                        <span>
                                            <t t-esc="toner.description"/>
                                        </span>
                                    </div>

                                    <span class="sat_toner_status">
                                        <t t-esc="getTonerMessage(toner.value)"/>
                                    </span>
                                </div>

                                <div class="sat_toner_visual">
                                    <div class="sat_toner_circle" t-att-style="circleStyle(toner.value)">
                                        <div class="sat_toner_circle_inner">
                                            <strong>
                                                <t t-esc="toner.value"/>
                                            </strong>
                                            <span>%</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="sat_toner_bar">
                                    <div t-att-style="percentStyle(toner.value)"/>
                                </div>

                                <div class="sat_toner_hint">
                                    <t t-if="toner.value &lt;= 0">
                                        Sin dato confiable de SNMP.
                                    </t>
                                    <t t-elif="toner.value &lt;= 10">
                                        Requiere atención inmediata.
                                    </t>
                                    <t t-elif="toner.value &lt;= 25">
                                        Nivel bajo, considerar reemplazo.
                                    </t>
                                    <t t-else="">
                                        Nivel correcto para pruebas.
                                    </t>
                                </div>

                            </div>

                        </t>
                    </div>

                </div>

                <!-- ======================================================
                     COMPONENTES Y UNIDADES
                     ====================================================== -->
                <div class="sat_panel sat_panel_components" t-if="hasComponentesSnmp">

                    <div class="sat_panel_header">
                        <div>
                            <h3>Unidades, consumibles y sistema</h3>
                            <p>Developer, drum, fusora, residual, transferencia, accesorios y datos técnicos enviados por SNMP.</p>
                        </div>

                        <span class="sat_section_pill">
                            <t t-esc="componentesSnmp.length"/>
                            elemento(s)
                        </span>
                    </div>

                    <div class="sat_component_summary_grid" t-if="hasComponentesResumen">
                        <t t-foreach="componentesResumen" t-as="summary" t-key="summary.key">
                            <div t-att-class="'sat_component_summary ' + summary.className">
                                <i t-att-class="'fa ' + summary.icon"/>
                                <span>
                                    <t t-esc="summary.label"/>
                                </span>
                                <strong>
                                    <t t-esc="summary.value"/>
                                </strong>
                            </div>
                        </t>
                    </div>

                    <!-- UNIDADES -->
                    <div class="sat_component_group" t-if="hasUnidadesSnmp">
                        <div class="sat_component_group_header">
                            <div>
                                <h4>
                                    <i class="fa fa-cogs"/>
                                    Unidades
                                </h4>
                                <p>Drum, developer, fusora, transferencia e imagen.</p>
                            </div>
                            <span>
                                <t t-esc="unidadesSnmp.length"/>
                            </span>
                        </div>

                        <div class="sat_component_grid">
                            <t t-foreach="unidadesSnmp" t-as="item" t-key="item.id">
                                <div t-att-class="componentCardClass(item)">
                                    <div class="sat_component_icon">
                                        <i t-att-class="'fa ' + getComponentIcon(item)"/>
                                    </div>

                                    <div class="sat_component_body">
                                        <div class="sat_component_top">
                                            <span class="sat_component_type">
                                                <t t-esc="getComponentTypeLabel(item)"/>
                                            </span>

                                            <span t-att-class="'sat_component_status sat_status_' + (item.estado || 'info')">
                                                <t t-esc="getComponentEstadoLabel(item)"/>
                                            </span>
                                        </div>

                                        <strong class="sat_component_name">
                                            <t t-esc="item.nombre"/>
                                        </strong>

                                        <div class="sat_component_value">
                                            <span>
                                                <t t-esc="formatDecimal(getComponentValue(item), 0)"/>
                                            </span>
                                            <small>
                                                <t t-esc="componentUnit(item)"/>
                                            </small>
                                        </div>

                                        <div class="sat_component_bar" t-if="hasComponentPercent(item)">
                                            <div t-att-style="getComponentBarStyle(item)"/>
                                        </div>

                                        <div class="sat_component_source" t-if="componentSource(item)">
                                            <i class="fa fa-code"/>
                                            <t t-esc="componentSource(item)"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- CONSUMIBLES -->
                    <div class="sat_component_group" t-if="hasConsumiblesSnmp">
                        <div class="sat_component_group_header">
                            <div>
                                <h4>
                                    <i class="fa fa-flask"/>
                                    Consumibles
                                </h4>
                                <p>Tóner residual, suministros y consumibles adicionales.</p>
                            </div>
                            <span>
                                <t t-esc="consumiblesSnmp.length"/>
                            </span>
                        </div>

                        <div class="sat_component_grid">
                            <t t-foreach="consumiblesSnmp" t-as="item" t-key="item.id">
                                <div t-att-class="componentCardClass(item)">
                                    <div class="sat_component_icon">
                                        <i t-att-class="'fa ' + getComponentIcon(item)"/>
                                    </div>

                                    <div class="sat_component_body">
                                        <div class="sat_component_top">
                                            <span class="sat_component_type">
                                                <t t-esc="getComponentTypeLabel(item)"/>
                                            </span>

                                            <span t-att-class="'sat_component_status sat_status_' + (item.estado || 'info')">
                                                <t t-esc="getComponentEstadoLabel(item)"/>
                                            </span>
                                        </div>

                                        <strong class="sat_component_name">
                                            <t t-esc="item.nombre"/>
                                        </strong>

                                        <div class="sat_component_value">
                                            <span>
                                                <t t-esc="formatDecimal(getComponentValue(item), 0)"/>
                                            </span>
                                            <small>
                                                <t t-esc="componentUnit(item)"/>
                                            </small>
                                        </div>

                                        <div class="sat_component_bar" t-if="hasComponentPercent(item)">
                                            <div t-att-style="getComponentBarStyle(item)"/>
                                        </div>

                                        <div class="sat_component_source" t-if="componentSource(item)">
                                            <i class="fa fa-code"/>
                                            <t t-esc="componentSource(item)"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- ACCESORIOS Y SISTEMA -->
                    <div class="sat_component_two_cols" t-if="hasAccesoriosSnmp || hasSistemaSnmp">

                        <div class="sat_component_group sat_component_group_compact" t-if="hasAccesoriosSnmp">
                            <div class="sat_component_group_header">
                                <div>
                                    <h4>
                                        <i class="fa fa-puzzle-piece"/>
                                        Accesorios
                                    </h4>
                                    <p>ADF, finalizador, lector y accesorios detectados.</p>
                                </div>
                                <span>
                                    <t t-esc="accesoriosSnmp.length"/>
                                </span>
                            </div>

                            <div class="sat_component_list">
                                <t t-foreach="accesoriosSnmp" t-as="item" t-key="item.id">
                                    <div t-att-class="'sat_component_line ' + (item.css_class || '')">
                                        <i t-att-class="'fa ' + getComponentIcon(item)"/>
                                        <div>
                                            <strong>
                                                <t t-esc="item.nombre"/>
                                            </strong>
                                            <span>
                                                <t t-esc="componentSource(item) || getComponentTypeLabel(item)"/>
                                            </span>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <div class="sat_component_group sat_component_group_compact" t-if="hasSistemaSnmp">
                            <div class="sat_component_group_header">
                                <div>
                                    <h4>
                                        <i class="fa fa-hdd-o"/>
                                        Sistema
                                    </h4>
                                    <p>HDD, firmware, memoria y datos internos.</p>
                                </div>
                                <span>
                                    <t t-esc="sistemaSnmp.length"/>
                                </span>
                            </div>

                            <div class="sat_component_list">
                                <t t-foreach="sistemaSnmp" t-as="item" t-key="item.id">
                                    <div t-att-class="'sat_component_line ' + (item.css_class || '')">
                                        <i t-att-class="'fa ' + getComponentIcon(item)"/>
                                        <div>
                                            <strong>
                                                <t t-esc="item.nombre"/>
                                            </strong>
                                            <span>
                                                <t t-esc="componentSource(item) || getComponentTypeLabel(item)"/>
                                            </span>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                    </div>

                </div>

                <!-- ======================================================
                     VALIDACIONES
                     ====================================================== -->
                <div class="sat_panel">

                    <div class="sat_panel_header">
                        <div>
                            <h3>Validaciones automáticas</h3>
                            <p>Según movimiento de contadores durante la prueba.</p>
                        </div>

                        <span class="sat_section_pill">
                            Nivel:
                            <t t-esc="ultima.nivel_prueba_label || '-'"/>
                        </span>
                    </div>

                    <div t-att-class="isColorMachine ? 'sat_check_grid sat_check_grid_color' : 'sat_check_grid sat_check_grid_bn'">
                        <t t-foreach="pruebaChecks" t-as="check" t-key="check.key">
                            <div t-att-class="check.value ? 'sat_check_item sat_check_ok' : 'sat_check_item sat_check_fail'">
                                <div class="sat_check_icon">
                                    <i t-att-class="check.value ? 'fa fa-check-circle' : 'fa fa-circle-o'"/>
                                </div>

                                <div>
                                    <strong>
                                        <t t-esc="check.label"/>
                                    </strong>
                                    <span>
                                        <t t-if="check.value">Correcto</t>
                                        <t t-if="!check.value">Sin confirmar</t>
                                    </span>
                                </div>
                            </div>
                        </t>
                    </div>

                </div>

                <!-- ======================================================
                     HISTORIAL
                     ====================================================== -->
                <div class="sat_panel">

                    <div class="sat_panel_header">
                        <div>
                            <h3>Historial de pruebas</h3>
                            <p>Últimas lecturas SNMP registradas para esta máquina.</p>
                        </div>

                        <span class="sat_section_pill">
                            <t t-esc="totalPruebas"/>
                            registro(s)
                        </span>
                    </div>

                    <div class="sat_history_table_wrap">
                        <table class="sat_history_table">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Total</th>
                                    <th>Δ Total</th>
                                    <th>Copias</th>
                                    <th>Impresiones</th>
                                    <th>Scanner</th>
                                    <th>Dúplex</th>
                                    <th>B/N</th>
                                    <th t-if="isColorMachine">Color</th>
                                    <th>Tóner</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-foreach="pruebas" t-as="p" t-key="p.id">
                                    <tr>
                                        <td>
                                            <t t-esc="p.fecha_ultima_actualizacion || '-'"/>
                                        </td>

                                        <td>
                                            <strong>
                                                <t t-esc="formatNumber(p.contador_actual_total)"/>
                                            </strong>
                                        </td>

                                        <td>
                                            <t t-esc="formatDelta(p.delta_total)"/>
                                        </td>

                                        <td>
                                            <t t-esc="formatNumber(p.contador_copias)"/>
                                        </td>

                                        <td>
                                            <t t-esc="formatNumber(p.contador_impresiones)"/>
                                        </td>

                                        <td>
                                            <t t-esc="formatNumber(p.contador_scanner)"/>
                                        </td>

                                        <td>
                                            <t t-esc="formatNumber(p.contador_duplex)"/>
                                        </td>

                                        <td>
                                            <t t-esc="formatNumber(p.contador_actual_bn)"/>
                                        </td>

                                        <td t-if="isColorMachine">
                                            <t t-esc="formatNumber(p.contador_actual_color)"/>
                                        </td>

                                        <td>
                                            <span t-att-class="'sat_mini_badge sat_toner_' + p.estado_toner">
                                                <t t-esc="p.estado_toner_label || '-'"/>
                                            </span>
                                        </td>

                                        <td>
                                            <span t-att-class="'sat_mini_badge sat_estado_' + p.estado_prueba">
                                                <t t-esc="p.estado_prueba_label || '-'"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                </div>

            </t>

        </div>

    </t>

</templates>
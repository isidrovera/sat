<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
  <t t-name="sat.SelectionSubparts">
  <select t-att-disabled="props.readonly"
          class="o_input"
          t-on-change="props.onChange"
          t-att-value="props.value">
    <t t-foreach="props.selectionList" t-as="opt" t-key="opt &amp;&amp; opt[0] || _tIndex">
      <option t-att-value="opt &amp;&amp; opt[0]">
        <t t-esc="(opt &amp;&amp; opt[1]) || ''"/>
      </option>
    </t>
  </select>
</t>

</templates>

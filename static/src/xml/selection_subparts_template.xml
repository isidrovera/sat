<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="SelectionSubparts.Template">
        <select t-att-class="props.class" 
                t-att-id="props.id"
                t-att-name="props.name"
                t-on-change="onChange"
                t-att-disabled="props.readonly">
            <option value="">-- Seleccionar --</option>
            <t t-foreach="selection" t-as="option" t-key="option[0]">
                <option t-att-value="option[0]" 
                        t-att-selected="option[0] === value ? 'selected' : undefined">
                    <t t-esc="option[1]"/>
                </option>
            </t>
        </select>
    </t>
</templates>
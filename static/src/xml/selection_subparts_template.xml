<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
  <!-- Wrapper que renderiza el widget nativo y captura el change -->
  <t t-name="sat.SelectionSubpartsWrapper">
    <FieldSelection
      value="props.value"
      readonly="props.readonly"
      required="props.required"
      name="props.name"
      record="props.record"
      selection="props.selection"
      options="props.options"
      t-on-change="onNativeChange"
    />
  </t>
</templates>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sat.MobileTicketLayout">
        <div t-if="uiState.isMobile" class="o_mobile_ticket_layout">

            <!-- HEADER -->
            <div class="o_mobile_ticket_header">
                <button type="button"
                        class="o_mobile_back"
                        t-on-click="onMobileBack">
                    ←
                </button>

                <div class="o_mobile_title">
                    <div class="o_mobile_ticket_number" t-esc="ticketNumber"/>
                    <div class="o_mobile_ticket_subtitle">Ticket de servicio</div>
                </div>

                <span class="o_mobile_status_badge"
                      t-att-class="stateClass"
                      t-esc="stateLabel"/>

                <button type="button"
                        class="o_mobile_menu_btn"
                        t-on-click="toggleMenu">
                    ⋮
                </button>
            </div>

            <!-- BODY -->
            <div class="o_mobile_ticket_body">

                <!-- CLIENTE -->
                <div class="o_mobile_card">
                    <div class="o_mobile_card_header">
                        <div class="o_mobile_avatar o_avatar_circle"
                             t-esc="clientInitials"/>

                        <div class="o_mobile_card_title_box">
                            <div class="o_mobile_card_label">CLIENTE</div>
                            <div class="o_mobile_card_title" t-esc="clientName"/>
                        </div>
                    </div>

                    <div class="o_mobile_card_section" t-if="clientAddress">
                        <div class="o_mobile_section_label">DIRECCIÓN</div>
                        <div class="o_mobile_section_value" t-esc="clientAddress"/>

                        <div class="o_mobile_section_muted"
                             t-if="clientLocation"
                             t-esc="clientLocation"/>

                        <div class="o_mobile_reference"
                             t-if="clientReference">
                            Ref: <t t-esc="clientReference"/>
                        </div>

                        <div class="o_mobile_actions_row" t-if="hasCoordinates">
                            <button type="button"
                                    t-on-click="onAbrirMapa">
                                🗺 Ver mapa
                            </button>

                            <button type="button"
                                    class="o_btn_primary"
                                    t-on-click="onNavegar">
                                🧭 Navegar
                            </button>
                        </div>
                    </div>

                    <div class="o_mobile_card_section" t-if="contactName">
                        <div class="o_mobile_section_label">CONTACTO</div>

                        <div class="o_mobile_contact_row">
                            <div class="o_mobile_contact_name" t-esc="contactName"/>

                            <a t-if="reporterPhone"
                               t-att-href="'tel:' + reporterPhone"
                               class="o_mobile_phone_btn">
                                📞 Llamar
                            </a>
                        </div>

                        <div class="o_mobile_phone_text"
                             t-if="reporterPhone"
                             t-esc="reporterPhone"/>
                    </div>

                    <div class="o_mobile_card_section">
                        <div class="o_mobile_grid_2">
                            <div t-if="tipoServicio">
                                <div class="o_mobile_section_label">TIPO SERVICIO</div>
                                <div class="o_mobile_section_value" t-esc="tipoServicio"/>
                            </div>

                            <div t-if="agendaTexto">
                                <div class="o_mobile_section_label">AGENDADO</div>
                                <div class="o_mobile_section_value" t-esc="agendaTexto"/>
                            </div>

                            <div t-if="responsableName">
                                <div class="o_mobile_section_label">RESPONSABLE</div>
                                <div class="o_mobile_section_value" t-esc="responsableName"/>
                            </div>

                            <div t-if="asistenciaName">
                                <div class="o_mobile_section_label">ASISTENCIA</div>
                                <div class="o_mobile_section_value" t-esc="asistenciaName"/>
                            </div>

                            <!-- RETORNO -->
                            <div>
                                <div class="o_mobile_section_label">RETORNO</div>

                                <select class="o_mobile_select"
                                        t-on-change="onChangeRetorno"
                                        t-att-disabled="uiState.saving || uiState.retornoLoading || currentState === 'finalizado'">

                                    <option value=""
                                            t-att-selected="!retornoId">
                                        Seleccione...
                                    </option>

                                    <t t-foreach="uiState.retornoOptions" t-as="opt" t-key="opt.value">
                                        <option t-att-value="opt.value"
                                                t-att-selected="opt.value == retornoId">
                                            <t t-esc="opt.label"/>
                                        </option>
                                    </t>
                                </select>

                                <div class="o_mobile_hint" t-if="uiState.retornoLoading">
                                    Cargando retorno...
                                </div>

                                <div class="o_mobile_hint" t-if="!uiState.retornoLoading and retornoLabel">
                                    Valor actual: <t t-esc="retornoLabel"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- EQUIPO -->
                <div class="o_mobile_card">
                    <div class="o_mobile_card_header">
                        <div class="o_mobile_avatar">🖨</div>

                        <div class="o_mobile_card_title_box">
                            <div class="o_mobile_card_label">EQUIPO</div>
                            <div class="o_mobile_card_title" t-esc="equipoMarca || 'Sin marca'"/>
                            <div class="o_mobile_card_subtitle"
                                 t-if="equipoModelo"
                                 t-esc="equipoModelo"/>
                        </div>
                    </div>

                    <div class="o_mobile_card_section" t-if="equipoSerie">
                        <div class="o_mobile_section_label">SERIE</div>
                        <div class="o_mobile_monospace" t-esc="equipoSerie"/>
                    </div>

                    <div class="o_mobile_card_section">
                        <div class="o_mobile_section_label o_mb_6">CONTADORES</div>

                        <div class="o_mobile_contadores">
                            <div class="o_contador_box">
                                <div class="o_contador_label">K</div>
                                <input type="number"
                                       inputmode="numeric"
                                       class="o_mobile_counter_input"
                                       t-att-value="uiState.contadorDraft.k || contadorK"
                                       t-on-input="onInputContadorK"
                                       t-att-disabled="uiState.saving || currentState === 'finalizado'"/>
                            </div>

                            <div class="o_contador_box" t-if="esColor">
                                <div class="o_contador_label">COLOR</div>
                                <input type="number"
                                       inputmode="numeric"
                                       class="o_mobile_counter_input"
                                       t-att-value="uiState.contadorDraft.color || contadorColor"
                                       t-on-input="onInputContadorColor"
                                       t-att-disabled="uiState.saving || currentState === 'finalizado'"/>
                            </div>

                            <div class="o_contador_box">
                                <div class="o_contador_label">SCAN</div>
                                <input type="number"
                                       inputmode="numeric"
                                       class="o_mobile_counter_input"
                                       t-att-value="uiState.contadorDraft.scan || contadorScan"
                                       t-on-input="onInputContadorScan"
                                       t-att-disabled="uiState.saving || currentState === 'finalizado'"/>
                            </div>
                        </div>

                        <div class="o_mobile_actions_row o_mt_10">
                            <button type="button"
                                    class="o_btn_primary o_mobile_full_width_btn"
                                    t-on-click="onGuardarContadores"
                                    t-att-disabled="uiState.saving || currentState === 'finalizado'">
                                💾 Guardar contadores
                            </button>
                        </div>

                        <div class="o_mobile_hint" t-if="!uiState.contadoresDirty">
                            Complete los contadores y presione Guardar.
                        </div>

                        <div class="o_mobile_hint" t-if="uiState.contadoresDirty">
                            Hay contadores pendientes por guardar.
                        </div>
                    </div>
                </div>

                <!-- PROBLEMA REPORTADO -->
                <div class="o_mobile_card">
                    <div class="o_mobile_problem_header">
                        <div class="o_mobile_section_label">PROBLEMA REPORTADO</div>

                        <span t-if="tienePhoto" class="o_mobile_photo_badge">
                            📷 Foto disponible
                        </span>
                    </div>

                    <textarea class="o_mobile_textarea"
                              placeholder="Escribe el problema reportado..."
                              t-att-value="descripcionProblema"
                              t-on-change="onChangeDescription"
                              t-att-disabled="uiState.saving"/>

                    <div class="o_mobile_reporter"
                         t-if="reporterName or reporterPhone">
                        <t t-if="reporterName">
                            Reportó <strong t-esc="reporterName"/>
                        </t>

                        <t t-if="reporterPhone">
                            ·
                            <a t-att-href="'tel:' + reporterPhone"
                               t-esc="reporterPhone"/>
                        </t>
                    </div>
                </div>

                <!-- COMPONENTES -->
                <div t-att-class="accordionClass('componentes')">
                    <div class="o_accordion_header"
                         t-on-click="toggleComponentes">

                        <div class="o_accordion_icon_box">
                            <span t-if="componentesCompleto">✓</span>
                            <span t-else="">🔧</span>
                        </div>

                        <div class="o_accordion_title_box">
                            <div class="o_accordion_title">Componentes</div>

                            <div class="o_accordion_subtitle">
                                <t t-esc="componentesEvaluados"/>
                                de
                                <t t-esc="componentesCount"/>
                                evaluados
                                <t t-if="componentesCompleto"> · Completo</t>
                            </div>
                        </div>

                        <span t-if="componentesPendientes &gt; 0"
                              class="o_accordion_badge o_badge_warning">
                            <t t-esc="componentesPendientes"/> PEND.
                        </span>

                        <span class="o_accordion_chevron">▼</span>
                    </div>

                    <div class="o_accordion_body"
                         t-if="isAccordionOpen('componentes')">

                        <div class="o_mobile_hint">
                            Abre la evaluación para cambiar estados y observaciones.
                        </div>

                        <button type="button"
                                class="o_mobile_full_width_btn"
                                t-on-click="openComponentes">
                            🔧 Abrir evaluación de componentes
                        </button>
                    </div>
                </div>

                <!-- ACCESORIOS -->
                <div t-att-class="accordionClass('accesorios')">
                    <div class="o_accordion_header"
                         t-on-click="toggleAccesorios">

                        <div class="o_accordion_icon_box">
                            <span t-if="accesoriosCompleto">✓</span>
                            <span t-else="">🔩</span>
                        </div>

                        <div class="o_accordion_title_box">
                            <div class="o_accordion_title">Accesorios</div>

                            <div class="o_accordion_subtitle">
                                <t t-esc="accesoriosEvaluados"/>
                                de
                                <t t-esc="accesoriosCount"/>
                                evaluados
                                <t t-if="accesoriosCompleto"> · Completo</t>
                            </div>
                        </div>

                        <span t-if="accesoriosPendientes &gt; 0"
                              class="o_accordion_badge o_badge_danger">
                            <t t-esc="accesoriosPendientes"/> PEND.
                        </span>

                        <span class="o_accordion_chevron">▼</span>
                    </div>

                    <div class="o_accordion_body"
                         t-if="isAccordionOpen('accesorios')">

                        <div class="o_mobile_hint">
                            Abre la evaluación para cambiar estados y observaciones.
                        </div>

                        <button type="button"
                                class="o_mobile_full_width_btn"
                                t-on-click="openAccesorios">
                            🔩 Abrir evaluación de accesorios
                        </button>
                    </div>
                </div>

                <!-- INFORME TÉCNICO -->
                <div t-att-class="accordionClass('informe')">
                    <div class="o_accordion_header"
                         t-on-click="toggleInforme">

                        <div class="o_accordion_icon_box">📄</div>

                        <div class="o_accordion_title_box">
                            <div class="o_accordion_title">Informe técnico</div>
                            <div class="o_accordion_subtitle">
                                Editar informe del ticket
                            </div>
                        </div>

                        <span class="o_accordion_chevron">▼</span>
                    </div>

                    <div class="o_accordion_body"
                         t-if="isAccordionOpen('informe')">

                        <textarea class="o_mobile_informe_editor"
                                  placeholder="Escribe o corrige el informe técnico..."
                                  t-att-value="informeHtml"
                                  t-on-change="onChangeInforme"
                                  t-att-disabled="uiState.saving"/>

                        <div class="o_mobile_hint">
                            El informe se guarda al salir del campo.
                        </div>
                    </div>
                </div>

                <!-- PEDIDOS -->
                <div class="o_mobile_card" t-if="pedidosCount">
                    <div class="o_mobile_card_header">
                        <div class="o_mobile_avatar">📦</div>

                        <div class="o_mobile_card_title_box">
                            <div class="o_mobile_card_label">PEDIDOS</div>
                            <div class="o_mobile_card_title">
                                <t t-esc="pedidosCount"/> pedido(s) de repuestos
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            class="o_mobile_full_width_btn"
                            t-on-click="openPedidos">
                        📦 Abrir pedidos
                    </button>
                </div>

            </div>

            <!-- BOTTOM BAR -->
            <div class="o_mobile_bottom_bar">
                <button type="button"
                        class="o_btn_secondary"
                        t-att-disabled="!canCargarContadores || uiState.saving"
                        t-on-click="onCargarContadores">
                    🔄 Cargar contadores
                </button>

                <button type="button"
                        class="o_btn_primary"
                        t-att-disabled="!canCerrarTicket || uiState.saving || uiState.contadoresDirty"
                        t-on-click="onCerrarTicket">
                    ✓ Cerrar ticket
                </button>
            </div>

            <!-- MENÚ DE ACCIONES -->
            <t t-if="uiState.menuOpen">
                <div class="o_mobile_actions_overlay"
                     t-on-click="closeMenu"/>

                <div class="o_mobile_actions_menu">
                    <div class="o_mobile_action_item"
                         t-on-click="openFullForm">
                        <i class="fa fa-edit"/>
                        <span>Abrir form completo</span>
                    </div>

                    <t t-foreach="menuActions" t-as="actionItem" t-key="actionItem.method">
                        <div class="o_mobile_action_item"
                             t-on-click="() => onMenuAction(actionItem)">
                            <i t-att-class="'fa ' + actionItem.icon"/>
                            <span t-esc="actionItem.label"/>
                        </div>
                    </t>
                </div>
            </t>

        </div>
    </t>

</templates>
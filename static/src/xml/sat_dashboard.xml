<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <!-- Dashboard Component -->
    <t t-name="sat.SatSatDashboard">
        <div class="o_sat_dashboard container-fluid py-2">
            <!-- Fila de KPIs -->
            <div class="row g-1">
                <!-- Total máquinas (SIN entregadas) -->
                <div class="col-4 col-md-2 col-lg-1">
                    <div class="o_sat_card_kpi" t-on-click="() => this.filterByState('all')">
                        <div class="o_sat_card_icon o_sat_icon_primary o_sat_icon_pulse">
                            <i class="fa fa-cubes"></i>
                        </div>
                        <div class="o_sat_card_content">
                            <div class="o_sat_card_title">Total</div>
                            <div class="o_sat_card_value">
                                <t t-esc="state.data.total_maquinas"/>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Resto de botones igual... -->
                <div class="col-4 col-md-2 col-lg-1">
                    <div class="o_sat_card_kpi" t-on-click="() => this.filterByState('disponible')">
                        <div class="o_sat_card_icon o_sat_icon_success o_sat_icon_bounce">
                            <i class="fa fa-check-circle"></i>
                        </div>
                        <div class="o_sat_card_content">
                            <div class="o_sat_card_title">Disponible</div>
                            <div class="o_sat_card_value">
                                <t t-esc="state.data.total_disponibles"/>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-4 col-md-2 col-lg-1">
                    <div class="o_sat_card_kpi" t-on-click="() => this.filterByState('separada')">
                        <div class="o_sat_card_icon o_sat_icon_warning o_sat_icon_shake">
                            <i class="fa fa-bookmark"></i>
                        </div>
                        <div class="o_sat_card_content">
                            <div class="o_sat_card_title">Separada</div>
                            <div class="o_sat_card_value">
                                <t t-esc="state.data.total_separadas"/>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-4 col-md-2 col-lg-1">
                    <div class="o_sat_card_kpi" t-on-click="() => this.filterByState('sin_revisar')">
                        <div class="o_sat_card_icon o_sat_icon_secondary">
                            <i class="fa fa-pause-circle"></i>
                        </div>
                        <div class="o_sat_card_content">
                            <div class="o_sat_card_title">Sin revisar</div>
                            <div class="o_sat_card_value">
                                <t t-esc="state.data.total_sin_revisar"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-4 col-md-2 col-lg-1">
                    <div class="o_sat_card_kpi" t-on-click="() => this.filterByState('para_revision')">
                        <div class="o_sat_card_icon o_sat_icon_info">
                            <i class="fa fa-clock-o"></i>
                        </div>
                        <div class="o_sat_card_content">
                            <div class="o_sat_card_title">P/Revisión</div>
                            <div class="o_sat_card_value">
                                <t t-esc="state.data.total_para_revision"/>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-4 col-md-2 col-lg-1">
                    <div class="o_sat_card_kpi" t-on-click="() => this.filterByState('en_revision')">
                        <div class="o_sat_card_icon o_sat_icon_info o_sat_icon_spin">
                            <i class="fa fa-cog"></i>
                        </div>
                        <div class="o_sat_card_content">
                            <div class="o_sat_card_title">En revisión</div>
                            <div class="o_sat_card_value">
                                <t t-esc="state.data.total_en_revision"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-4 col-md-2 col-lg-1">
                    <div class="o_sat_card_kpi" t-on-click="() => this.filterByState('finalizado')">
                        <div class="o_sat_card_icon o_sat_icon_success">
                            <i class="fa fa-check"></i>
                        </div>
                        <div class="o_sat_card_content">
                            <div class="o_sat_card_title">Finalizado</div>
                            <div class="o_sat_card_value">
                                <t t-esc="state.data.total_finalizado"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-4 col-md-2 col-lg-1">
                    <div class="o_sat_card_kpi" t-on-click="() => this.filterByState('con_problemas')">
                        <div class="o_sat_card_icon o_sat_icon_danger o_sat_icon_blink">
                            <i class="fa fa-exclamation-triangle"></i>
                        </div>
                        <div class="o_sat_card_content">
                            <div class="o_sat_card_title">Problemas</div>
                            <div class="o_sat_card_value">
                                <t t-esc="state.data.total_problemas"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-4 col-md-2 col-lg-1">
                    <div class="o_sat_card_kpi" t-on-click="() => this.filterByState('de_partes')">
                        <div class="o_sat_card_icon o_sat_icon_danger">
                            <i class="fa fa-wrench"></i>
                        </div>
                        <div class="o_sat_card_content">
                            <div class="o_sat_card_title">De partes</div>
                            <div class="o_sat_card_value">
                                <t t-esc="state.data.total_de_partes"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-4 col-md-2 col-lg-1">
                    <div class="o_sat_card_kpi" t-on-click="() => this.filterByState('entregada')">
                        <div class="o_sat_card_icon o_sat_icon_primary">
                            <i class="fa fa-truck"></i>
                        </div>
                        <div class="o_sat_card_content">
                            <div class="o_sat_card_title">Entregada</div>
                            <div class="o_sat_card_value">
                                <t t-esc="state.data.total_entregada"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-4 col-md-2 col-lg-1">
                    <div class="o_sat_card_kpi" t-on-click="() => this.filterByState('no_disponible')">
                        <div class="o_sat_card_icon o_sat_icon_dark">
                            <i class="fa fa-ban"></i>
                        </div>
                        <div class="o_sat_card_content">
                            <div class="o_sat_card_title">No Disp.</div>
                            <div class="o_sat_card_value">
                                <t t-esc="state.data.total_no_disponibles"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- Custom List View Template -->
    <t t-name="sat.SatListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='props.Renderer']" position="before">
            <SatDashboard model="props.model"/>
        </xpath>
    </t>
</templates>
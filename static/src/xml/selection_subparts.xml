<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
  <t t-name="sat.SelectionSubparts">
    <select t-on-change="onChange" t-att-value="value" class="o_input">
      <t t-foreach="selectionList" t-as="opt" t-key="opt[0]">
        <option t-att-value="opt[0]"><t t-esc="opt[1]"/></option>
      </t>
    </select>
  </t>
</templates>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="reparaciones.GalleryWidget">
        <div class="reparacion-photo-gallery">
            <div class="gallery-actions mb-3">
                <div class="btn-group">
                    <t t-if="!props.readonly">
                        <label class="btn btn-primary">
                            <i class="fa fa-upload me-2"/>Subir Fotos
                            <input type="file" 
                                   class="d-none" 
                                   accept="image/*"
                                   multiple="true"
                                   t-on-change="uploadPhoto"/>
                        </label>
                    </t>
                    <t t-if="hasPhotos">
                        <button class="btn btn-secondary" 
                                t-on-click="toggleSelectMode">
                            <i class="fa fa-check-square-o me-2"/>
                            <t t-if="state.selectMode">Cancelar Selección</t>
                            <t t-else="">Seleccionar</t>
                        </button>
                    </t>
                </div>
            </div>

            <t t-if="state.isLoading">
                <div class="text-center py-4">
                    <i class="fa fa-spinner fa-spin fa-2x"/>
                    <p>Cargando fotos...</p>
                </div>
            </t>

            <t t-elif="state.error">
                <div class="alert alert-danger">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <span t-esc="state.error"/>
                </div>
            </t>

            <t t-elif="hasPhotos">
                <div class="photo-grid">
                    <t t-foreach="state.photos" t-as="photo" t-key="photo.id">
                        <div class="photo-item" 
                             t-on-click="() => onPhotoClick(photo)"
                             t-att-class="{'selected': state.selectedPhotos.has(photo.id)}">
                            <div class="photo-container">
                                <img t-att-src="photo.imageUrl" 
                                     t-att-alt="photo.nombre_foto"
                                     class="photo-image"/>
                            </div>
                            <div class="photo-info">
                                <div class="photo-name" t-esc="photo.nombre_foto || 'Sin nombre'"/>
                                <button class="btn btn-sm btn-light mt-2" 
                                        t-on-click.stop="(ev) => downloadPhoto(photo, ev)">
                                    <i class="fa fa-download"/> Descargar
                                </button>
                            </div>
                            <t t-if="state.selectMode">
                                <div class="select-overlay">
                                    <div class="checkbox">
                                        <i t-if="state.selectedPhotos.has(photo.id)" 
                                           class="fa fa-check-square fa-2x"/>
                                        <i t-else="" 
                                           class="fa fa-square-o fa-2x"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </t>

            <t t-else="">
                <div class="text-center text-muted py-4">
                    No hay fotos disponibles
                </div>
            </t>

            <Dialog t-if="state.isModalOpen"
                    title="'Vista Previa'"
                    size="'lg'"
                    t-on-close="closePhotoModal">
                <t t-if="state.selectedPhoto">
                    <div class="photo-preview">
                        <img t-att-src="state.selectedPhoto.imageUrl"
                             t-att-alt="state.selectedPhoto.nombre_foto"
                             class="preview-image"/>
                        <div class="preview-info mt-3">
                            <h5 t-esc="state.selectedPhoto.nombre_foto"/>
                            <button class="btn btn-primary"
                                    t-on-click="(ev) => downloadPhoto(state.selectedPhoto, ev)">
                                <i class="fa fa-download"/> Descargar
                            </button>
                        </div>
                    </div>
                </t>
            </Dialog>
        </div>
    </t>
</templates>
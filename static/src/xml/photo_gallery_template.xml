<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="reparaciones.GalleryWidget">
        <div class="reparacion-photo-gallery">
            <!-- Acciones -->
            <div class="gallery-actions mb-3">
                <div class="btn-group">
                    <t t-if="!props.readonly">
                        <label class="btn btn-primary">
                            <i class="fa fa-upload me-2"/>Subir Fotos
                            <input type="file" 
                                   class="d-none" 
                                   accept="image/*"
                                   multiple="true"
                                   t-on-change="uploadPhoto"/>
                        </label>
                    </t>
                    <t t-if="hasPhotos">
                        <button class="btn btn-secondary" 
                                t-on-click="toggleSelectMode">
                            <i class="fa fa-check-square-o me-2"/>
                            <t t-if="state.selectMode">Cancelar Selección</t>
                            <t t-else="">Seleccionar</t>
                        </button>
                        <t t-if="state.selectMode">
                            <button class="btn btn-primary" 
                                    t-att-disabled="state.selectedPhotos.size === 0"
                                    t-on-click="downloadSelectedPhotos">
                                <i class="fa fa-download me-2"/>
                                Descargar (<t t-esc="state.selectedPhotos.size"/>)
                            </button>
                        </t>
                    </t>
                </div>
            </div>

            <!-- Estado de carga -->
            <t t-if="state.isLoading">
                <div class="text-center py-4">
                    <i class="fa fa-spinner fa-spin fa-2x"/>
                    <p>Cargando fotos...</p>
                </div>
            </t>

            <!-- Galería de fotos -->
            <t t-elif="hasPhotos">
                <div class="photo-grid">
                    <t t-foreach="state.photos" t-as="photo" t-key="photo.id">
                        <div class="photo-item" 
                             t-att-class="{'selected': state.selectedPhotos.has(photo.id)}"
                             t-on-click="() => onPhotoClick(photo)">
                            <div class="photo-container">
                                <t t-if="photo.url_foto">
                                    <img t-att-src="photo.url_foto" 
                                         t-att-alt="photo.nombre_foto"
                                         class="photo-image"
                                         onerror="this.src='/web/static/img/placeholder.png';"/>
                                </t>
                                <t t-else="">
                                    <div class="photo-placeholder">
                                        <i class="fa fa-image fa-3x"/>
                                    </div>
                                </t>
                            </div>
                            <div class="photo-info">
                                <span class="photo-name" t-esc="photo.nombre_foto || 'Sin nombre'"/>
                                <button class="btn btn-sm btn-light" 
                                        t-on-click="(ev) => downloadPhoto(photo, ev)">
                                    <i class="fa fa-download"/> Descargar
                                </button>
                            </div>
                        </div>
                    </t>
                </div>
            </t>

            <!-- Mensaje sin fotos -->
            <t t-elif="!state.isLoading">
                <div class="text-center text-muted py-4">
                    No hay fotos disponibles
                </div>
            </t>

            <!-- Modal de vista previa -->
            <Dialog t-if="state.isModalOpen"
                    title="'Vista Previa'"
                    size="'lg'"
                    t-on-close="closePhotoModal">
                <t t-if="state.selectedPhoto">
                    <div class="photo-preview">
                        <img t-if="state.selectedPhoto.url_foto"
                             t-att-src="state.selectedPhoto.url_foto"
                             t-att-alt="state.selectedPhoto.nombre_foto"
                             class="preview-image"
                             onerror="this.src='/web/static/img/placeholder.png';"/>
                        <div class="preview-info mt-3">
                            <h5 t-esc="state.selectedPhoto.nombre_foto"/>
                            <button class="btn btn-primary"
                                    t-on-click="(ev) => downloadPhoto(state.selectedPhoto, ev)">
                                <i class="fa fa-download"/> Descargar
                            </button>
                        </div>
                    </div>
                </t>
            </Dialog>
        </div>
    </t>
</templates>
<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="reparaciones.GalleryWidget">
        <div class="reparacion-photo-gallery">
            <!-- Sección de subida de fotos -->
            <div class="upload-section mb-4">
                <label class="btn btn-primary">
                    <i class="fa fa-upload me-2"/>Subir Foto
                    <input type="file" 
                           class="d-none" 
                           accept="image/*"
                           t-on-change="uploadPhoto"/>
                </label>
            </div>

            <!-- Grid de fotos -->
            <div class="photo-grid">
                <t t-foreach="photos" t-as="photo" t-key="photo.id">
                    <div t-if="photo" class="photo-card" t-on-click="() => this.openPhotoModal(photo)">
                        <div class="photo-container">
                            <img t-if="photo.url_foto" 
                                 t-att-src="photo.url_foto" 
                                 t-att-alt="photo.nombre_foto || ''"
                                 class="photo-image"/>
                        </div>
                        <div class="photo-overlay">
                            <div class="photo-info">
                                <span class="photo-name" t-esc="photo.nombre_foto || ''"/>
                                <button class="btn btn-light btn-sm download-btn" 
                                        t-if="photo.url_foto"
                                        t-on-click.stop="() => this.downloadPhoto(photo)">
                                    <i class="fa fa-download"/> Descargar
                                </button>
                            </div>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Modal de vista previa -->
            <Dialog t-if="state.isModalOpen and state.selectedPhoto"
                    title="'Vista Previa'"
                    size="'lg'"
                    t-on-close="() => this.closePhotoModal()">
                <div class="photo-preview">
                    <img t-if="state.selectedPhoto.url_foto"
                         t-att-src="state.selectedPhoto.url_foto"
                         t-att-alt="state.selectedPhoto.nombre_foto || ''"
                         class="preview-image"/>
                    <div class="preview-info">
                        <h5 class="preview-title" t-esc="state.selectedPhoto.nombre_foto || ''"/>
                        <button class="btn btn-primary"
                                t-if="state.selectedPhoto.url_foto"
                                t-on-click="() => this.downloadPhoto(state.selectedPhoto)">
                            <i class="fa fa-download"/> Descargar
                        </button>
                    </div>
                </div>
            </Dialog>
        </div>
    </t>
</templates>
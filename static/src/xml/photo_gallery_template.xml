<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="reparaciones.GalleryWidget">
        <div class="reparacion-photo-gallery">
            <div t-if="!props.readonly" class="upload-section mb-4">
                <label class="btn btn-primary">
                    <i class="fa fa-upload me-2"/>Subir Foto
                    <input type="file" 
                           class="d-none" 
                           accept="image/*"
                           t-on-change="uploadPhoto"/>
                </label>
            </div>

            <div class="photo-grid" t-if="photos.length">
                <t t-foreach="photos" t-as="photo" t-key="photo.id">
                    <t t-if="photo.url_foto">
                        <div class="photo-item" t-on-click="() => openPhotoModal(photo)">
                            <div class="photo-container">
                                <img t-att-src="'/web/content/reparaciones.foto/' + photo.id + '/url_foto'"
                                     t-att-alt="photo.nombre_foto"
                                     class="photo-image"/>
                            </div>
                            <div class="photo-overlay">
                                <div class="photo-info">
                                    <span class="photo-name" t-esc="photo.nombre_foto"/>
                                    <button class="btn btn-light btn-sm" 
                                            t-on-click.stop="(ev) => downloadPhoto(photo, ev)">
                                        <i class="fa fa-download"/> Descargar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </div>
            
            <div t-if="!photos.length" class="text-center text-muted py-4">
                No hay fotos disponibles
            </div>

            <Dialog t-if="state.isModalOpen"
                    title="'Vista Previa'"
                    size="'lg'"
                    t-on-close="closePhotoModal">
                <t t-if="state.selectedPhoto">
                    <div class="photo-preview">
                        <img t-if="state.selectedPhoto.url_foto"
                             t-att-src="'/web/content/reparaciones.foto/' + state.selectedPhoto.id + '/url_foto'"
                             t-att-alt="state.selectedPhoto.nombre_foto"
                             class="preview-image"/>
                        <div class="photo-info mt-3">
                            <h5 t-esc="state.selectedPhoto.nombre_foto"/>
                            <button class="btn btn-primary"
                                    t-on-click="(ev) => downloadPhoto(state.selectedPhoto, ev)">
                                <i class="fa fa-download"/> Descargar
                            </button>
                        </div>
                    </div>
                </t>
            </Dialog>
        </div>
    </t>
</templates>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_evaluaciones" model="ir.sequence">
    <field name="name">Secuencia Evaluación Personal</field>
    <field name="code">evaluacion.personal</field>
    <field name="prefix">EVAL-%(year)s-%(month)s-</field>
    <field name="padding">3</field>
    <field name="company_id" eval="False"/>
</record>
        <record id="seq_taller_incidencia" model="ir.sequence">
            <field name="name">Incidencia</field>
            <field name="code">taller.incidencia</field>
            <field name="prefix">INCI-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

        <record id="seq_equipment_visit_report" model="ir.sequence">
            <field name="name">Secuencia Reporte Visitas Técnicas</field>
            <field name="code">equipment.visit.report</field>
            <field name="prefix">EVR/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_reporte_estado_excel" model="ir.sequence">
            <field name="name">Reporte Estado Máquinas</field>
            <field name="code">sat.reporte_estado_excel</field>
            <!-- Prefijo con año/mes; Ojo: este valor no irá al filename si tiene "/" -->
            <field name="prefix">REM/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="implementation">no_gap</field>
            <!-- opcional: <field name="company_id" ref="base.main_company"/> -->
            <!-- si quieres reinicios por periodo:
            <field name="use_date_range">True</field>
            <field name="prefix">REM/%(range_year)s/%(range_month)s/</field>
            -->
         </record>

    </data>
</odoo>
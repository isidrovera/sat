                        <t t-if="linea.notas_jefe">
                            <br/><span style="color:#718096;font-size:12px;">
                                Nota: <t t-out="linea.notas_jefe"/>
                            </span>
                        </t>
                    </div>
                </t>
            </t>
        </div>


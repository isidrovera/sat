                    <td style="padding:6px 10px;"><t t-out="object.tecnico_id.name"/></td>
                </tr>
                <tr style="background:#c6f6d5;">
                    <td style="padding:6px 10px;font-weight:bold;">Reparación:</td>
                    <td style="padding:6px 10px;"><t t-out="object.reparacion_id.name"/></td>
                </tr>
                <tr>
                    <td style="padding:6px 10px;font-weight:bold;">Máquina:</td>
                    <td style="padding:6px 10px;">
                        <t t-out="object.marca or ''"/> <t t-out="object.modelo or ''"/>
                    </td>
                </tr>
                <tr style="background:#c6f6d5;">
                    <td style="padding:6px 10px;font-weight:bold;">Serie:</td>
                    <td style="padding:6px 10px;"><t t-out="object.serie or ''"/></td>
                </tr>
            </table>
        </div>

        <!-- Partes encontradas -->
        <div style="background:#fff;border:1px solid #e2e8f0;padding:18px;margin-bottom:20px;">
            <h3 style="margin-top:0;">🔩 Partes Listas para Retirar</h3>

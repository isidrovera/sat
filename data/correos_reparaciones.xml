                    <div style="padding:10px;margin-bottom:8px;border-left:4px solid #48bb78;background:#f0fff4;">
                        <b><t t-out="linea.parte"/></b><br/>
                        <span style="color:#276749;font-size:13px;">
                            📍 Origen: <t t-out="linea.tipo_origen or 'Sin definir'"/>

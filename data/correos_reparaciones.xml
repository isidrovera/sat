        <div style="text-align:center;margin:30px 0;">
            <a t-attf-href="{{ object._get_base_url() }}/solicitud-parte/aprobar/{{ object.access_token }}"
               style="background:#48bb78;color:#fff;padding:15px 35px;
                      text-decoration:none;border-radius:4px;font-weight:bold;font-size:17px;">
                ✅ APROBAR RETIRO

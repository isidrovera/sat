<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <data noupdate="1">
       
       <!-- CRON PRINCIPAL: Procesar correos perdidos cada hora -->
       <record id="cron_procesar_correos_perdidos" model="ir.cron">
           <field name="name">🔄 Procesar Correos Perdidos - Sistema Contadores</field>
           <field name="model_id" ref="model_contador_automatico"/>
           <field name="state">code</field>
           <field name="code">model.cron_procesar_correos_perdidos()</field>
           <field name="active" eval="True"/>
           <field name="user_id" ref="base.user_root"/>
           <field name="interval_number">1</field>
           <field name="interval_type">hours</field>
       </record>

       <!-- CRON MANTENIMIENTO: Sistema completo cada 6 horas -->
       <record id="cron_mantenimiento_sistema_contadores" model="ir.cron">
           <field name="name">🔧 Mantenimiento Automático - Sistema Contadores</field>
           <field name="model_id" ref="model_contador_automatico"/>
           <field name="state">code</field>
           <field name="code">model.mantenimiento_automatico_sistema()</field>
           <field name="active" eval="True"/>
           <field name="user_id" ref="base.user_root"/>
           <field name="interval_number">6</field>
           <field name="interval_type">hours</field>
       </record>

       <!-- CRON OPTIMIZACIÓN: Optimizar patrones diariamente -->
       <record id="cron_optimizar_patrones" model="ir.cron">
           <field name="name">⚙️ Optimización de Patrones - Sistema Contadores</field>
           <field name="model_id" ref="model_contador_automatico"/>
           <field name="state">code</field>
           <field name="code">model.optimizar_patrones_automaticamente()</field>
           <field name="active" eval="True"/>
           <field name="user_id" ref="base.user_root"/>
           <field name="interval_number">1</field>
           <field name="interval_type">days</field>
       </record>

       <!-- CRON ESTADÍSTICAS: Actualizar estadísticas diarias -->
       <record id="cron_actualizar_estadisticas" model="ir.cron">
           <field name="name">📊 Actualizar Estadísticas - Sistema Contadores</field>
           <field name="model_id" ref="model_contador_automatico"/>
           <field name="state">code</field>
           <field name="code">model.actualizar_estadisticas_diarias()</field>
           <field name="active" eval="True"/>
           <field name="user_id" ref="base.user_root"/>
           <field name="interval_number">1</field>
           <field name="interval_type">days</field>
       </record>

       <!-- CRON LIMPIEZA: Limpiar registros antiguos semanalmente -->
       <record id="cron_limpiar_registros_antiguos" model="ir.cron">
           <field name="name">🧹 Limpieza Semanal - Sistema Contadores</field>
           <field name="model_id" ref="model_contador_automatico"/>
           <field name="state">code</field>
           <field name="code">model.limpiar_registros_antiguos()</field>
           <field name="active" eval="True"/>
           <field name="user_id" ref="base.user_root"/>
           <field name="interval_number">7</field>
           <field name="interval_type">days</field>
       </record>

       <!-- CRON BACKUP: Procesamiento manual de respaldo (cada 4 horas) -->
       <record id="cron_procesamiento_respaldo" model="ir.cron">
           <field name="name">🛡️ Procesamiento de Respaldo - Sistema Contadores</field>
           <field name="model_id" ref="model_contador_automatico"/>
           <field name="state">code</field>
           <field name="code">model.procesar_correos_respaldo()</field>
           <field name="active" eval="True"/>
           <field name="user_id" ref="base.user_root"/>
           <field name="interval_number">4</field>
           <field name="interval_type">hours</field>
       </record>

       <!-- CRON MONITOREO: Verificar salud del sistema cada 2 horas -->
       <record id="cron_monitoreo_sistema" model="ir.cron">
           <field name="name">🩺 Monitoreo de Salud - Sistema Contadores</field>
           <field name="model_id" ref="model_contador_automatico"/>
           <field name="state">code</field>
           <field name="code">model.monitorear_salud_sistema()</field>
           <field name="active" eval="True"/>
           <field name="user_id" ref="base.user_root"/>
           <field name="interval_number">2</field>
           <field name="interval_type">hours</field>
       </record>

   </data>
</odoo>
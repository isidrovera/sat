<odoo>
  <!-- ====================================== -->
  <!-- TIPOS DE COMPONENTE COMPLETOS -->
  <!-- ====================================== -->
  
  <!-- ====== MFP / FOTOCOPIADORAS ====== -->
  <!-- Sensibles a color -->
  <record id="comp_tipo_ui" model="componente.tipo">
    <field name="name">Unidad de imagen (IU/Drum)</field>
    <field name="code">UI</field>
    <field name="is_color_sensitive">1</field>
  </record>
  <record id="comp_tipo_developer" model="componente.tipo">
    <field name="name">Developer</field>
    <field name="code">DEVELOPER</field>
    <field name="is_color_sensitive">1</field>
  </record>
  <record id="comp_tipo_toner_system" model="componente.tipo">
    <field name="name">Sistema de tóner</field>
    <field name="code">TONER_SYSTEM</field>
    <field name="is_color_sensitive">1</field>
  </record>

  <!-- No sensibles a color -->
  <record id="comp_tipo_faja" model="componente.tipo">
    <field name="name">Faja/Banda de transferencia (ITB)</field>
    <field name="code">FAJA</field>
    <field name="is_color_sensitive">0</field>
  </record>
  <record id="comp_tipo_transfer_roller" model="componente.tipo">
    <field name="name">Rodillo de transferencia</field>
    <field name="code">TRANSFER_ROLLER</field>
    <field name="is_color_sensitive">0</field>
  </record>
  <record id="comp_tipo_fusora" model="componente.tipo">
    <field name="name">Fusora (Fuser)</field>
    <field name="code">FUSORA</field>
    <field name="is_color_sensitive">0</field>
  </record>
  <record id="comp_tipo_adf" model="componente.tipo">
    <field name="name">ADF (Alimentador de documentos)</field>
    <field name="code">ADF</field>
    <field name="is_color_sensitive">0</field>
  </record>
  <record id="comp_tipo_tray" model="componente.tipo">
    <field name="name">Bandejas de papel (TRAY)</field>
    <field name="code">TRAY</field>
    <field name="is_color_sensitive">0</field>
  </record>
  <record id="comp_tipo_bypass" model="componente.tipo">
    <field name="name">Bypass</field>
    <field name="code">BYPASS</field>
    <field name="is_color_sensitive">0</field>
  </record>
  <record id="comp_tipo_duplex" model="componente.tipo">
    <field name="name">Unidad dúplex</field>
    <field name="code">DUPLEX</field>
    <field name="is_color_sensitive">0</field>
  </record>
  <record id="comp_tipo_finisher" model="componente.tipo">
    <field name="name">Finalizador (Finisher)</field>
    <field name="code">FINISHER</field>
    <field name="is_color_sensitive">0</field>
  </record>
  <record id="comp_tipo_optico" model="componente.tipo">
    <field name="name">Óptico</field>
    <field name="code">OPTICO</field>
    <field name="is_color_sensitive">0</field>
  </record>
  <record id="comp_tipo_waste" model="componente.tipo">
    <field name="name">Depósito de residuos (Waste)</field>
    <field name="code">WASTE_TONER</field>
    <field name="is_color_sensitive">0</field>
  </record>

  <!-- ====== FUNCIONES DE LA MÁQUINA ====== -->
  <record id="comp_tipo_func_copia" model="componente.tipo">
    <field name="name">Función de Copia</field>
    <field name="code">FUNCION_COPIA</field>
    <field name="is_color_sensitive">0</field>
  </record>
  <record id="comp_tipo_func_impresion" model="componente.tipo">
    <field name="name">Función de Impresión</field>
    <field name="code">FUNCION_IMPRESION</field>
    <field name="is_color_sensitive">0</field>
  </record>
  <record id="comp_tipo_func_usb_print" model="componente.tipo">
    <field name="name">Función Impresión USB</field>
    <field name="code">FUNCION_USB_PRINT</field>
    <field name="is_color_sensitive">0</field>
  </record>
  <record id="comp_tipo_func_scan_smb" model="componente.tipo">
    <field name="name">Función Escaneo SMB</field>
    <field name="code">FUNCION_SCAN_SMB</field>
    <field name="is_color_sensitive">0</field>
  </record>
  <record id="comp_tipo_func_scan_usb" model="componente.tipo">
    <field name="name">Función Escaneo USB</field>
    <field name="code">FUNCION_SCAN_USB</field>
    <field name="is_color_sensitive">0</field>
  </record>
  <record id="comp_tipo_func_scan_ftp" model="componente.tipo">
    <field name="name">Función Escaneo FTP</field>
    <field name="code">FUNCION_SCAN_FTP</field>
    <field name="is_color_sensitive">0</field>
  </record>
  <record id="comp_tipo_func_scan_mail" model="componente.tipo">
    <field name="name">Función Escaneo Email</field>
    <field name="code">FUNCION_SCAN_MAIL</field>
    <field name="is_color_sensitive">0</field>
  </record>

  <!-- ====================================== -->
  <!-- ESTADOS DE COMPONENTE COMPLETOS -->
  <!-- ====================================== -->
  
  <!-- Críticos -->
  <record id="estado_requiere_cambio" model="componente.estado">
    <field name="name">Requiere cambio</field>
    <field name="code">requiere_cambio</field>
    <field name="color">1</field>
    <field name="prioridad">1</field>
    <field name="descripcion">Reemplazo urgente antes de entrega.</field>
  </record>
  <record id="estado_cambio_repuestos" model="componente.estado">
    <field name="name">Cambio de repuestos</field>
    <field name="code">cambio_de_repuestos</field>
    <field name="color">1</field>
    <field name="prioridad">1</field>
  </record>

  <!-- Medios / desgaste -->
  <record id="estado_regular" model="componente.estado">
    <field name="name">Regular</field>
    <field name="code">regular</field>
    <field name="color">3</field>
    <field name="prioridad">2</field>
  </record>
  <record id="estado_gastada" model="componente.estado">
    <field name="name">Gastada pero puede trabajar</field>
    <field name="code">gastada_pero_puede_trabajar</field>
    <field name="color">4</field>
    <field name="prioridad">2</field>
  </record>
  <record id="estado_mantenimiento" model="componente.estado">
    <field name="name">Mantenimiento</field>
    <field name="code">mantenimiento</field>
    <field name="color">4</field>
    <field name="prioridad">2</field>
  </record>

  <!-- Bajos / info -->
  <record id="estado_sin_revisar" model="componente.estado">
    <field name="name">Sin revisar</field>
    <field name="code">sin_revisar</field>
    <field name="color">0</field>
    <field name="prioridad">3</field>
  </record>
  <record id="estado_revisado" model="componente.estado">
    <field name="name">Revisado</field>
    <field name="code">revisado</field>
    <field name="color">10</field>
    <field name="prioridad">3</field>
  </record>
  <record id="estado_nuevo" model="componente.estado">
    <field name="name">Nuevo</field>
    <field name="code">nuevo</field>
    <field name="color">10</field>
    <field name="prioridad">3</field>
  </record>
  <record id="estado_no_aplica" model="componente.estado">
    <field name="name">No aplica</field>
    <field name="code">no_aplica</field>
    <field name="color">0</field>
    <field name="prioridad">3</field>
  </record>

  <!-- Estados específicos para funciones -->
  <record id="estado_correcto" model="componente.estado">
    <field name="name">Correcto</field>
    <field name="code">correcto</field>
    <field name="color">10</field>
    <field name="prioridad">3</field>
    <field name="descripcion">Función operando correctamente.</field>
  </record>
  <record id="estado_sin_probar" model="componente.estado">
    <field name="name">Sin probar</field>
    <field name="code">sin_probar</field>
    <field name="color">0</field>
    <field name="prioridad">3</field>
    <field name="descripcion">Función no verificada.</field>
  </record>
  <record id="estado_falla" model="componente.estado">
    <field name="name">Falla</field>
    <field name="code">falla</field>
    <field name="color">1</field>
    <field name="prioridad">1</field>
    <field name="descripcion">Función con errores o no operativa.</field>
  </record>

  <!-- Estados específicos para tóners -->
  <record id="estado_vacio" model="componente.estado">
    <field name="name">Vacío</field>
    <field name="code">vacio</field>
    <field name="color">1</field>
    <field name="prioridad">1</field>
    <field name="descripcion">Tóner agotado - 0% restante.</field>
  </record>
  <record id="estado_bajo" model="componente.estado">
    <field name="name">Bajo</field>
    <field name="code">bajo</field>
    <field name="color">3</field>
    <field name="prioridad">2</field>
    <field name="descripcion">Tóner en nivel bajo - aproximadamente 25%.</field>
  </record>
  <record id="estado_sin_botella" model="componente.estado">
    <field name="name">Sin contenedor</field>
    <field name="code">sin_botella</field>
    <field name="color">1</field>
    <field name="prioridad">1</field>
    <field name="descripcion">Contenedor de tóner no instalado.</field>
  </record>

</odoo>
    <field name="code">toner_75</field>
    <field name="color">10</field>
    <field name="prioridad">3</field>
    <field name="descripcion">Nivel aproximado 75%: operación normal.</field>
  </record>

  <record id="estado_toner_100" model="componente.estado">

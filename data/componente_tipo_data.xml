    <field name="code">toner_chip_error</field>
    <field name="color">1</field>
    <field name="prioridad">1</field>
    <field name="descripcion">Botella instalada pero chip no leído/inválido.</field>
  </record>

  <record id="estado_bajo" model="componente.estado">
    <field name="name">Bajo</field>
    <field name="code">bajo</field>
    <field name="color">3</field>
    <field name="prioridad">2</field>

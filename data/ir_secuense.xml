<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_reparaciones" model="ir.sequence">
            <field name="name">Reparacion</field>
            <field name="code">reparaciones.reparaciones</field>
            <field name="prefix">RP/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_client_service_evaluation" model="ir.sequence">
            <field name="name">Secuencia para Evaluaciones</field>
            <field name="code">client.service.evaluation</field>
            <field name="prefix">EVAL-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_inspeccion_resultado" model="ir.sequence">
            <field name="name">Secuencia Inspección</field>
            <field name="code">inspeccion.resultado</field>
            <field name="prefix">INSP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_copier_parts_request" model="ir.sequence">
            <field name="name">Secuencia Solicitud de Partes</field>
            <field name="code">copier.parts.request</field>
            <field name="prefix">SP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>            
        </record>
        <record id="sequence_solicitud_partes" model="ir.sequence">
            <field name="name">Secuencia Solicitud de Partes Alquiler</field>
            <field name="code">solicitud.partes</field>
            <field name="prefix">SPA/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="sequence_toner_counter_submission" model="ir.sequence">
            <field name="name">Reportes de Contadores y Tóner</field>
            <field name="code">toner.counter.submission</field>
            <field name="prefix">TCS/</field>
            <field name="suffix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="active">True</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>

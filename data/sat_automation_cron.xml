<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============================================================ -->
    <!-- RECUPERAR EVENTOS BLOQUEADOS                                 -->
    <!-- ============================================================ -->

    <record id="ir_cron_sat_automation_recover_stuck"
            model="ir.cron">

        <field name="name">
            SAT Automation: recuperar eventos bloqueados
        </field>

        <field name="model_id"
               ref="model_sat_automation_event"/>

        <field name="state">code</field>

        <field name="code">
            model.cron_recover_stuck_events()
        </field>

        <field name="interval_number">1</field>

        <field name="interval_type">hours</field>

        <field name="active">True</field>

    </record>

</odoo>
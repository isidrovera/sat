<odoo>
    <data noupdate="1">
        <record id="ir_cron_evaluador_diario" model="ir.cron">
            <field name="name">Evaluador Diario</field>
            <field name="model_id" ref="model_sat_sat"/>
            <field name="state">code</field>
            <field name="code">model.cron_evaluador_diario()</field>
            <field name="interval_type">days</field>
            <field name="interval_number">1</field>         
        </record>
        <record id="ir_cron_send_service_evaluations" model="ir.cron">
            <field name="name">Enviar Evaluaciones de Servicio</field>
            <field name="model_id" ref="model_client_service_evaluation"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_service_evaluations()</field>
            <field name="interval_type">days</field>
            <field name="interval_number">1</field>
        </record>
        <record id="ir_cron_duplicar_evaluaciones_mensuales" model="ir.cron">
            <field name="name">Duplicar Evaluaciones Mensuales Automáticas</field>
            <field name="model_id" ref="model_evaluacion_personal"/>
            <field name="state">code</field>
            <field name="code">model._cron_duplicar_evaluaciones_mensuales()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>                      
            <field name="active" eval="True"/>
            <!-- Programado para ejecutarse a las 23:00 del día -->
            <field name="nextcall" eval="(datetime.now().replace(hour=23, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>

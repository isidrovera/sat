        <record id="whatsapp_intent_rule_greeting_hola" model="whatsapp.intent.rule">
            <field name="name">Saludo - hola / menú técnico</field>
            <field name="active">True</field>
            <field name="sequence">10</field>
            <field name="priority">99</field>
            <field name="intent">greeting</field>
            <field name="action">reply</field>
            <field name="target_flow">none</field>
            <field name="response_template">main_menu_technical</field>
            <field name="match_type">regex</field>
            <field name="pattern">^\s*(hola|holas|buenas|buenos dias|buenos días|buenas tardes|buenas noches|menu|menú|ayuda|opciones|inicio)\s*$</field>
            <field name="applies_to">all</field>
            <field name="only_during_idle">True</field>
            <field name="stop_flow">False</field>
            <field name="allow_ai_after">False</field>
        </record>


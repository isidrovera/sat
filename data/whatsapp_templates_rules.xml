<record id="whatsapp_intent_rule_dni" model="whatsapp.intent.rule">
<field name="name">Detectar DNI</field>
<field name="active">True</field>
<field name="sequence">70</field>
<field name="priority">85</field>
<field name="intent">dni</field>
<field name="action">ask_ruc</field>
<field name="match_type">regex</field>
<field name="pattern">^\s*\d{8}\s*$</field>

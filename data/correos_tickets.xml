                    <div style="font-size: 18px; font-weight: bold; margin-bottom: 15px;">📋 Detalles del Servicio</div>
                    <div style="margin: 10px 0;">📅 Fecha: <strong><t t-out="object.agenda_local"/></strong></div>
                    <div style="margin: 10px 0;">⚡ Prioridad: <strong><t t-out="object.priority"/></strong></div>
                    <div style="margin: 10px 0;">🔧 Tipo: <strong><t t-out="object.tipo_servicio_id"/></strong></div>
                    <div style="margin: 10px 0;">📍 Dirección: <strong><t t-out="object.direccion_id_r"/></strong></div>
                    <div style="margin: 10px 0;">👨‍🔧 Técnico: <strong><t t-out="object.responsable.name"/></strong></div>
                    <div style="margin: 10px 0;">🆔 DNI: <strong><t t-out="object.responsable.vat"/></strong></div>
                </div>
    
                <!-- Equipo Atendido -->
                <div style="background-color: #e6fffa; padding: 20px; margin: 15px 0;">
                    <div style="font-size: 18px; font-weight: bold; margin-bottom: 15px;">🖨️ Equipo Atendido</div>
                    <div style="margin: 10px 0;">Marca: <strong><t t-out="object.marca_id_r"/></strong></div>
                    <div style="margin: 10px 0;">Modelo: <strong><t t-out="object.product_alquiler.name.name"/></strong></div>
                    <div style="margin: 10px 0;">Serie: <strong><t t-out="object.serie_id_r"/></strong></div>
                    
                    <div style="font-size: 16px; font-weight: bold; margin: 15px 0 10px 0;">📊 Contadores</div>
                    <div style="background-color: #edf2f7; padding: 8px 15px; margin: 5px 0; display: inline-block;">
                        ⚫ Negro: <strong><t t-out="object.contometrok_id"/></strong>
                    </div>
                    <div style="background-color: #edf2f7; padding: 8px 15px; margin: 5px 0; display: inline-block;">
                        🎨 Color: <strong><t t-out="object.contometroc_id"/></strong>
                    </div>
                    <div style="background-color: #edf2f7; padding: 8px 15px; margin: 5px 0; display: inline-block;">
                        📄 Scanner: <strong><t t-out="object.contometros_id"/></strong>
                    </div>
                </div>
    
                <!-- Problema Reportado -->
                <div style="background-color: #f7fafc; padding: 20px; margin: 15px 0;">
                    <div style="font-size: 18px; font-weight: bold; margin-bottom: 15px;">⚠️ Problema Reportado</div>
                    <div style="margin: 10px 0;"><t t-out="object.description"/></div>
                </div>
    
                <!-- Informe Técnico -->
                <div style="background-color: #f0fff4; padding: 20px; margin: 15px 0;">
                    <div style="font-size: 18px; font-weight: bold; margin-bottom: 15px;">📝 Informe Técnico</div>
                    <div style="margin: 10px 0;"><t t-out="object.informe_id"/></div>
                    <div style="margin: 10px 0; color: #2c5282; font-style: italic;">
                        📎 Se adjunta el informe técnico detallado en formato PDF.

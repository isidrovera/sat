                    <div style="font-size: 18px; font-weight: bold; margin-bottom: 15px;">👤 Información del Cliente</div>
                    <div style="margin: 10px 0;">Cliente: <strong><t t-out="object.partner_id.name"/></strong></div>
                    <div style="background-color: #edf2f7; padding: 8px 15px; margin: 10px 0; display: inline-block;">
                        📞 Contacto: <strong><t t-out="object.contacto_id_r"/></strong>
                    </div>
                    <div style="background-color: #edf2f7; padding: 8px 15px; margin: 10px 0; display: inline-block;">
                        📱 Celular: <strong><t t-out="object.product_alquiler.celular"/></strong>
                    </div>
                </div>
    
                <!-- Especificaciones del Equipo -->
                <div style="background-color: #ebf8ff; padding: 20px; margin: 15px 0; border-left: 4px solid #4299e1;">
                    <div style="font-size: 18px; font-weight: bold; margin-bottom: 15px;">🖨️ Especificaciones del Equipo</div>
                    <div style="margin: 10px 0;">Marca: <strong><t t-out="object.marca_id_r"/></strong></div>
                    <div style="margin: 10px 0;">Modelo: <strong><t t-out="object.product_alquiler.name.name"/></strong></div>
                    <div style="margin: 10px 0;">Serie: <strong><t t-out="object.serie_id_r"/></strong></div>
                </div>
    
                <!-- Problema Reportado -->

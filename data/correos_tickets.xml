<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="email_template_ticket_cliente" model="mail.template">
            <field name="name">Envio de Ticket al Cliente</field>
            <field name="email_from">soporte@andescopiers.com.pe</field>
            <field name="email_to">{{object.product_alquiler.correo_}}</field>
            <field name="email_cc">comercial01@andescopiers.com.pe,
                comercial@andescopiers.com.pe, campuero@corapsac.com.pe</field>
            <field name="subject">Nuevo Ticket # {{object.name}}</field>
            <field name="model_id" ref="model_ticket_alquiler" />
            <field name="auto_delete" eval="True" />
            <field name="body_html"><![CDATA[
    <!DOCTYPE html>
    <html>
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    </head>
    <body bgcolor="#f5f5f5" style="margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; line-height: 1.6; color: #333333;">
        <!-- Contenedor Principal -->
        <div style="max-width: 800px; margin: 0 auto; padding: 20px;">
            
            <!-- Encabezado -->
            <div style="background-color: #2C5282; padding: 20px; text-align: center;">
                <div style="color: #ffffff; font-size: 24px; font-weight: bold;">🎫 Ticket de Servicio #<t t-out="object.name"/></div>
            </div>
            
            <!-- Contenido Principal -->
            <div style="background-color: #ffffff; padding: 25px; border: 1px solid #e2e8f0;">
                <!-- Saludo -->
                <div style="margin-bottom: 20px;">
                    Estimado/a <strong><t t-out="object.partner_id.name"/></strong>,
                </div>
                
                <div style="margin-bottom: 20px;">
                    Reciba un cordial saludo. Le informamos que hemos programado una visita técnica para atender su requerimiento.
                </div>
                
                <!-- Detalles de la Visita -->
                <div style="background-color: #f7fafc; padding: 20px; margin: 15px 0;">
                    <div style="font-size: 18px; font-weight: bold; margin-bottom: 15px;">📅 Detalles de la Visita</div>
                    <div style="margin: 10px 0;">🕒 Fecha: <strong><t t-out="object.agenda_local"/></strong></div>
                    <div style="margin: 10px 0;">⚡ Prioridad: <strong><t t-out="object.priority"/></strong></div>
                    <div style="margin: 10px 0;">🔧 Tipo de servicio: <strong><t t-out="object.tipo_servicio_id"/></strong></div>
                    <div style="margin: 10px 0;">📍 Dirección: <strong><t t-out="object.direccion_id_r"/></strong></div>
                    <div style="margin: 10px 0;">👨‍🔧 Técnico: <strong><t t-out="object.responsable.name"/></strong></div>
                    <div style="margin: 10px 0;">🆔 DNI: <strong><t t-out="object.responsable.vat"/></strong></div>
                </div>
    
                <!-- Especificaciones del Equipo -->
                <div style="background-color: #ebf8ff; padding: 20px; margin: 15px 0;">
                    <div style="font-size: 18px; font-weight: bold; margin-bottom: 15px;">🖨️ Especificaciones del Equipo</div>
                    <div style="margin: 10px 0;">Marca: <strong><t t-out="object.marca_id_r"/></strong></div>
                    <div style="margin: 10px 0;">Modelo: <strong><t t-out="object.product_alquiler.name.name"/></strong></div>
                    <div style="margin: 10px 0;">Serie: <strong><t t-out="object.serie_id_r"/></strong></div>
                </div>
    
                <!-- Problema Reportado -->
                <div style="background-color: #fff5f5; padding: 20px; margin: 15px 0;">
                    <div style="font-size: 18px; font-weight: bold; margin-bottom: 15px;">⚠️ Problema Reportado</div>
                    <div style="margin: 10px 0;"><t t-out="object.description"/></div>
                </div>
    
                <!-- Nota Importante -->
                <div style="margin: 20px 0; padding-left: 15px; border-left: 4px solid #4299e1;">
                    <div style="margin: 10px 0;">
                        Por favor, notifíquenos sobre su stock de toner para garantizarles el total abastecimiento. Además, le solicitamos reportar cualquier inconveniente adicional que presente al técnico en su visita.
                    </div>
                </div>
    
                <!-- Requerimientos -->
                <div style="margin: 20px 0;">
                    <div style="font-size: 18px; font-weight: bold; margin-bottom: 15px;">📋 Requerimos su apoyo en:</div>
                    <div style="margin-left: 20px;">
                        1. Dar autorización para el ingreso de nuestro personal.<br>
                        2. Disponibilidad de espacio y tiempo para nuestro trabajo.
                    </div>
                </div>
    
                <!-- Botón de Acción -->
                <div style="text-align: center; margin: 30px 0;">
                    <a href="#" style="background-color: #2C5282; color: #ffffff; padding: 12px 25px; text-decoration: none; display: inline-block;">
                        Ver Ticket 🔍
                    </a>
                </div>
    
                <!-- Pie -->
                <div style="text-align: center; margin-top: 30px; color: #666666;">
                    Gracias por su atención
                </div>
            </div>
        </div>
    </body>
    </html>
        ]]></field>
        </record>
        <record id="email_template_ticket_cliente_finalizacion" model="mail.template">

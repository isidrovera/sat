<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- noupdate="1" significa que los datos no se actualizarán cuando actualices tu módulo -->
        <record id="cron_your_task" model="ir.cron">
            <field name="name">Activador de maquinas con porblemas</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="model_id" ref="model_sat_sat"/>
            <field name="state">code</field>
            <field name="code">model.execute_task()</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=-(datetime.today().weekday()-1)%7)).strftime('%Y-%m-%d') + ' 14:00:00'"/>
        </record>
        <record id="cron_update_fecha_recurrente" model="ir.cron">
            <field name="name">Actualizar fecha recurrente</field>
            <field name="model_id" ref="model_alquiler"/>
            <field name="state">code</field>
            <field name="code">model.update_fecha_recurrente()</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
        <record id="cron_send_maintenance_reminders" model="ir.cron">
            <field name="name">Enviar recordatorios de mantenimiento</field>
            <field name="model_id" ref="model_alquiler"/>
            <field name="state">code</field>
            <field name="code">model.send_maintenance_reminders()</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
        <record id="cron_check_expired_evaluations" model="ir.cron">
            <field name="name">Marcar Evaluaciones Expiradas</field>
            <field name="model_id" ref="model_client_service_evaluation"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expired_evaluations()</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>
        <!-- Cron Consolidador - cada 2 horas -->
        <record id="cron_procesador_printtracker" model="ir.cron">
            <field name="name">PrintTracker - Procesador de Datos</field>
            <field name="model_id" ref="model_printtracker_processor"/>
            <field name="code">model.ejecutar_procesamiento_automatico()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
        <record id="cron_printtracker_api_sync" model="ir.cron">
            <field name="name">PrintTracker - Sincronización API</field>
            <field name="model_id" ref="model_printtracker_config"/>
            <field name="state">code</field>
            <field name="code">config = model.search([('sync_enabled', '=', True)], limit=1)
if config:
    config.sync_all_devices()
    config.sync_current_meters()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Cron Alertas - cada 5 minutos -->
        <record id="cron_alertas_printtracker" model="ir.cron">
            <field name="name">PrintTracker - Gestor de Alertas</field>
            <field name="model_id" ref="model_printtracker_alert_manager"/>
            <field name="code">model.ejecutar_revision_automatica()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_check_reposiciones_pendientes" model="ir.cron">
        <field name="name">Verificar Reposiciones Pendientes - Solicitudes Partes Alquiler</field>
        <field name="model_id" ref="model_solicitud_partes"/>
        <field name="state">code</field>
        <field name="code">model.action_check_reposiciones_pendientes()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>        
        <field name="active" eval="True"/>        
        <field name="priority">10</field>
        <field name="user_id" ref="base.user_admin"/>
    </record>
    <record id="cron_ticket_en_revision" model="ir.cron">
        <field name="name">Tracking: en_sitio → en_revision automático</field>
        <field name="model_id" ref="sat.model_ticket_alquiler"/>
        <field name="state">code</field>
        <field name="code">model.cron_actualizar_en_revision()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>        
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <!-- Cron: sincronización automática dispositivos MDM cada 10 minutos -->
    <record id="cron_mdm_sync_devices" model="ir.cron">
        <field name="name">MDM: Sincronizar estado de dispositivos</field>
        <field name="model_id" ref="sat.model_mdm_config"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_all_devices()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>        
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <!-- Cron 1: proceso → en_ruta (red de seguridad deviceMoving) -->
        <record id="cron_gps_detectar_movimiento" model="ir.cron">
            <field name="name">Tracking GPS: proceso → en_ruta</field>
            <field name="model_id" ref="sat.model_ticket_alquiler"/>
            <field name="state">code</field>
            <field name="code">model.cron_gps_detectar_movimiento()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Cron 2: en_ruta → en_sitio (red de seguridad geofenceEnter) -->
        <record id="cron_gps_detectar_llegada" model="ir.cron">
            <field name="name">Tracking GPS: en_ruta → en_sitio</field>
            <field name="model_id" ref="sat.model_ticket_alquiler"/>
            <field name="state">code</field>
            <field name="code">model.cron_gps_detectar_llegada()</field>
            <field name="interval_number">3</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Cron 3: en_sitio → salida (red de seguridad geofenceExit) -->
        <record id="cron_gps_detectar_salida" model="ir.cron">
            <field name="name">Tracking GPS: en_sitio → salida</field>
            <field name="model_id" ref="sat.model_ticket_alquiler"/>
            <field name="state">code</field>
            <field name="code">model.cron_gps_detectar_salida()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    <record id="google_maps_api_key" model="ir.config_parameter">
            <field name="key">alquiler_geo.google_maps_api_key</field>
            <field name="value"></field>
        </record>
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!-- CATÁLOGO COMPLETO DE ACCESORIOS             -->
    <!-- Para: Fotocopiadoras, Impresoras, Ploters,  -->
    <!--       Duplicadoras, Escáneres, Fax, etc.    -->
    <!-- ============================================ -->

    <!-- ========================================== -->
    <!-- ALIMENTACIÓN Y SALIDA DE PAPEL            -->
    <!-- ========================================== -->
    <record id="acc_tipo_lct" model="accesorio.tipo">
        <field name="name">Bandeja LCT (Alta Capacidad)</field>
        <field name="code">lct</field>
        <field name="sequence">10</field>
        <field name="descripcion">Bandeja de papel de gran capacidad (Large Capacity Tray)</field>
    </record>

    <record id="acc_tipo_ot" model="accesorio.tipo">
        <field name="name">Bandeja de Salida OT (Offset)</field>
        <field name="code">ot</field>
        <field name="sequence">20</field>
        <field name="descripcion">Bandeja de salida con separación offset</field>
    </record>

    <record id="acc_tipo_bypass" model="accesorio.tipo">
        <field name="name">Bandeja Bypass Manual</field>
        <field name="code">bypass</field>
        <field name="sequence">25</field>
        <field name="descripcion">Bandeja de alimentación manual</field>
    </record>

    <record id="acc_tipo_tray_adicional" model="accesorio.tipo">
        <field name="name">Bandeja Adicional</field>
        <field name="code">tray_adicional</field>
        <field name="sequence">30</field>
        <field name="descripcion">Bandeja de papel adicional (2000+ hojas)</field>
    </record>

    <!-- ========================================== -->
    <!-- ALIMENTADORES AUTOMÁTICOS                 -->
    <!-- ========================================== -->
    <record id="acc_tipo_adf_simple" model="accesorio.tipo">
        <field name="name">ADF Simple (Una Cara)</field>
        <field name="code">adf_simple</field>
        <field name="sequence">40</field>
        <field name="descripcion">Alimentador automático de documentos simple</field>
    </record>

    <record id="acc_tipo_adf_dual" model="accesorio.tipo">
        <field name="name">ADF Dual (Doble Cara)</field>
        <field name="code">adf_dual</field>
        <field name="sequence">50</field>
        <field name="descripcion">Alimentador automático duplex/reversible</field>
    </record>

    <record id="acc_tipo_radf" model="accesorio.tipo">
        <field name="name">RADF (Reversing ADF)</field>
        <field name="code">radf</field>
        <field name="sequence">55</field>
        <field name="descripcion">Alimentador automático reversible de documentos</field>
    </record>

    <record id="acc_tipo_spf" model="accesorio.tipo">
        <field name="name">SPF (Single Pass Feeder)</field>
        <field name="code">spf</field>
        <field name="sequence">57</field>
        <field name="descripcion">Alimentador de un solo paso para escaneo duplex</field>
    </record>

    <!-- ========================================== -->
    <!-- FINALIZADORES Y ACABADO                   -->
    <!-- ========================================== -->
    <record id="acc_tipo_finisher_int" model="accesorio.tipo">
        <field name="name">Finalizador Interno</field>
        <field name="code">finisher_int</field>
        <field name="sequence">60</field>
        <field name="descripcion">Sistema de grapado/ordenado interno</field>
    </record>

    <record id="acc_tipo_finisher_ext" model="accesorio.tipo">
        <field name="name">Finalizador Externo</field>
        <field name="code">finisher_ext</field>
        <field name="sequence">70</field>
        <field name="descripcion">Torre finalizadora externa con grapado</field>
    </record>

    <record id="acc_tipo_booklet_finisher" model="accesorio.tipo">
        <field name="name">Finalizador de Folletos</field>
        <field name="code">booklet_finisher</field>
        <field name="sequence">75</field>
        <field name="descripcion">Creador de folletos con grapado central</field>
    </record>

    <record id="acc_tipo_stapler" model="accesorio.tipo">
        <field name="name">Grapadora (Stapler)</field>
        <field name="code">stapler</field>
        <field name="sequence">80</field>
        <field name="descripcion">Módulo grapador independiente</field>
    </record>

    <record id="acc_tipo_hole_punch" model="accesorio.tipo">
        <field name="name">Perforadora (Hole Punch)</field>
        <field name="code">hole_punch</field>
        <field name="sequence">85</field>
        <field name="descripcion">Perforadora de documentos (2/3/4 huecos)</field>
    </record>

    <record id="acc_tipo_folder" model="accesorio.tipo">
        <field name="name">Plegadora (Folder)</field>
        <field name="code">folder</field>
        <field name="sequence">87</field>
        <field name="descripcion">Unidad de plegado de documentos</field>
    </record>

    <record id="acc_tipo_trimmer" model="accesorio.tipo">
        <field name="name">Cortador (Trimmer)</field>
        <field name="code">trimmer</field>
        <field name="sequence">89</field>
        <field name="descripcion">Cortador de bordes para folletos</field>
    </record>


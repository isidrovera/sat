    <!-- ========================================== -->
    <record id="acc_tipo_wifi" model="accesorio.tipo">
        <field name="name">Módulo Wi-Fi</field>
        <field name="code">wifi</field>
        <field name="sequence">110</field>
        <field name="descripcion">Adaptador de red inalámbrica</field>
    </record>

    <record id="acc_tipo_ethernet" model="accesorio.tipo">

    </record>

    <record id="acc_tipo_panel_normal" model="accesorio.tipo">
        <field name="name">Panel LCD Estándar</field>
        <field name="code">panel_normal</field>
        <field name="sequence">100</field>
        <field name="descripcion">Panel LCD básico no táctil</field>
    </record>

    <record id="acc_tipo_panel_color" model="accesorio.tipo">
        <field name="name">Panel LCD Color</field>
        <field name="code">panel_color</field>
        <field name="sequence">105</field>
        <field name="descripcion">Panel LCD a color de tamaño medio</field>

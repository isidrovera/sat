<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Timeout en minutos de un flujo conversacional WhatsApp.
            Si el cliente no responde antes de este tiempo, el flujo se resetea a idle.
            El admin puede cambiarlo en Ajustes > Técnico > Parámetros del sistema
            sin que se sobrescriba al actualizar el módulo.
        -->
        <record id="ir_config_whatsapp_conversation_timeout" model="ir.config_parameter">
            <field name="key">sat.whatsapp_conversation_state_timeout_minutes</field>
            <field name="value">15</field>
        </record>

        <record id="param_sat_whatsapp_gateway_base_url" model="ir.config_parameter">
            <field name="key">sat.whatsapp_gateway_base_url</field>
            <field name="value">https://boot.andessolutioncopiers.com</field>
        </record>

        <record id="param_sat_whatsapp_gateway_api_key" model="ir.config_parameter">
            <field name="key">sat.whatsapp_gateway_api_key</field>
            <field name="value">TU_API_KEY_REAL</field>
        </record>

    </data>
</odoo>
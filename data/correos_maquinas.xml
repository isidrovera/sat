                    </tr>
                    <tr>
                        <td style="padding:8px 0;color:#666;"><strong>Modelo:</strong></td>
                        <td style="padding:8px 0;color:#333;"><t t-out="object.name.name"/></td>
                    </tr>
                    <tr>
                        <td style="padding:8px 0;color:#666;"><strong>Serie:</strong></td>
                        <td style="padding:8px 0;color:#333;"><t t-out="object.serie_id"/></td>
                    </tr>
                    <tr>

            <field name="model_id" ref="model_sat_sat" />
            <field name="email_from">soporte@andescopiers.com.pe</field>
            <field name="email_to">lincoln@corapsac.com</field>
            <field name="email_cc">{{object.cliente_id.asesora_id.email}}; campuero@corapsac.com.pe</field>
            <field name="subject">✅ Máquina disponible: {{object.name.name}}</field>
            <field name="auto_delete" eval="True" />

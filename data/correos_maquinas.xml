                            <t t-out="ctx.get('snmp_new_model', '—')"/>
                        </td>
                    </tr>
                </table>
            </div>

            <!-- Razón -->
            <div style="margin:20px 0;padding:15px;background-color:#eff6ff;border-left:4px solid #3b82f6;">
                <p style="margin:0;color:#1e40af;font-size:14px;">
                    <strong>ℹ️ Motivo:</strong> El sistema SNMP obtuvo información más precisa del equipo 

        <!-- 1️⃣ CAMBIO AUTOMÁTICO DE MODELO POR MISMATCH DE NÚCLEO -->
<record id="email_template_snmp_model_mismatch" model="mail.template">
    <field name="name">🚨 SNMP - Mismatch de modelo (cambio automático)</field>
    <field name="model_id" ref="model_sat_sat"/>
    <field name="email_from">soporte@andescopiers.com.pe</field>
    <field name="email_to">lincoln@corapsac.com</field>
    <field name="email_cc">logistica@corapsac.com</field>
    <field name="subject">Modelo cambiado automáticamente por SNMP: {{ object.serie_id }}</field>
    <field name="auto_delete" eval="True"/>

    <field name="body_html"><![CDATA[
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
</head>
<body bgcolor="#f5f5f5" style="margin:0; padding:0; font-family: Arial, Helvetica, sans-serif;">
    <div style="max-width:700px;margin:0 auto;padding:20px;">
        
        <!-- Encabezado -->
        <div style="background-color:#dc2626;padding:20px;text-align:center;">
            <div style="color:#ffffff;font-size:24px;font-weight:bold;">
                🚨 Mismatch de modelo detectado
            </div>
            <div style="color:#fee2e2;font-size:14px;margin-top:8px;">
                El modelo se cambió automáticamente
            </div>
        </div>

        <!-- Contenido -->
        <div style="background-color:#ffffff;padding:20px;border:1px solid #e2e8f0;">
            <p style="font-size:16px;color:#333333;">
                <strong>Estimado equipo de Logística/Gerencia,</strong>
            </p>
            
            <p style="margin-top:15px;color:#555555;">
                El sistema SNMP detectó que el <strong>núcleo del modelo NO coincide</strong> 
                con lo registrado en el sistema. El modelo se actualizó automáticamente.
            </p>

            <!-- Información del equipo -->
            <div style="margin:20px 0;padding:20px;background-color:#fef2f2;border-left:4px solid #dc2626;">
                <h3 style="margin:0 0 15px 0;color:#dc2626;font-size:18px;">📋 Información del Equipo</h3>
                
                <table style="width:100%;border-collapse:collapse;">
                    <tr>
                        <td style="padding:8px 0;color:#666;width:40%;"><strong>Marca:</strong></td>
                        <td style="padding:8px 0;color:#333;"><t t-out="object.marca"/></td>
                    </tr>
                    <tr>
                        <td style="padding:8px 0;color:#666;"><strong>Serie:</strong></td>
                        <td style="padding:8px 0;color:#333;"><t t-out="object.serie_id"/></td>
                    </tr>
                    <tr>
                        <td style="padding:8px 0;color:#666;"><strong>Cliente/Ubicación:</strong></td>
                        <td style="padding:8px 0;color:#333;"><t t-out="object.cliente_id.name or 'N/A'"/></td>
                    </tr>
                </table>
            </div>

            <!-- Cambios detectados -->
            <div style="margin:20px 0;padding:20px;background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;">
                <h3 style="margin:0 0 15px 0;color:#111827;font-size:18px;">🔄 Cambios Detectados</h3>
                
                <table style="width:100%;border-collapse:collapse;">
                    <tr style="background-color:#fee2e2;">
                        <td style="padding:12px;border:1px solid #fecaca;font-weight:bold;width:40%;">Modelo Anterior:</td>
                        <td style="padding:12px;border:1px solid #fecaca;color:#dc2626;font-size:16px;font-weight:bold;">
                            <t t-out="ctx.get('snmp_current_model', '—')"/>
                        </td>
                    </tr>
                    <tr style="background-color:#dcfce7;">
                        <td style="padding:12px;border:1px solid #bbf7d0;font-weight:bold;">Modelo Nuevo:</td>
                        <td style="padding:12px;border:1px solid #bbf7d0;color:#16a34a;font-size:16px;font-weight:bold;">
                            <t t-out="ctx.get('snmp_new_model', '—')"/>
                        </td>
                    </tr>
                    <tr style="background-color:#fef3c7;">
                        <td style="padding:12px;border:1px solid #fde68a;font-weight:bold;">Detectado por SNMP:</td>
                        <td style="padding:12px;border:1px solid #fde68a;color:#ca8a04;font-weight:bold;">
                            <t t-out="ctx.get('snmp_detected_model', '—')"/>
                        </td>
                    </tr>
                </table>
            </div>

            <!-- Razón del cambio -->
            <div style="margin:20px 0;padding:15px;background-color:#fffbeb;border-left:4px solid #f59e0b;">
                <p style="margin:0;color:#92400e;font-size:14px;">
                    <strong>⚠️ Motivo:</strong> El núcleo del modelo (velocidad) detectado por SNMP 
                    no coincide con el modelo registrado. Esto puede indicar:
                </p>
                <ul style="margin:10px 0 0 20px;color:#92400e;font-size:14px;">
                    <li>Cambio de equipo físico</li>
                    <li>Error en el registro inicial</li>
                    <li>Proveedor entregó modelo diferente al cotizado</li>
                </ul>
            </div>

            <!-- Acciones recomendadas -->
            <div style="margin:20px 0;padding:15px;background-color:#eff6ff;border-left:4px solid #3b82f6;">
                <p style="margin:0 0 10px 0;color:#1e40af;font-weight:bold;">📌 Acciones Recomendadas:</p>
                <ol style="margin:5px 0 0 20px;color:#1e3a8a;font-size:14px;line-height:1.6;">
                    <li><strong>Verificar físicamente</strong> el equipo y su placa de serie</li>
                    <li><strong>Revisar documentos del proveedor</strong> (guía, factura, garantía)</li>
                    <li><strong>Contactar al proveedor</strong> si hubo cambio no autorizado</li>
                    <li><strong>Actualizar cotizaciones/contratos</strong> si aplica</li>
                </ol>
            </div>

            <!-- Información adicional -->
            <div style="margin:20px 0;padding:15px;background-color:#f3f4f6;border-radius:6px;">
                <table style="width:100%;border-collapse:collapse;font-size:13px;">
                    <tr>
                        <td style="padding:5px 0;color:#666;width:40%;"><strong>Contómetro actual:</strong></td>
                        <td style="padding:5px 0;color:#333;"><t t-out="object.contometro or '0'"/></td>
                    </tr>
                    <tr>
                        <td style="padding:5px 0;color:#666;"><strong>Estado:</strong></td>
                        <td style="padding:5px 0;color:#333;"><t t-out="object.estado_ventas_id or 'N/A'"/></td>
                    </tr>
                    <tr>
                        <td style="padding:5px 0;color:#666;"><strong>Última actualización SNMP:</strong></td>
                        <td style="padding:5px 0;color:#333;">
                            <t t-out="object.ultima_actualizacion_snmp or 'N/A'"/>
                        </td>
                    </tr>
                </table>
            </div>

            <!-- Botón -->
            <div style="text-align:center;margin:30px 0 10px 0;">
                <a t-att-href="ctx.get('record_url', '#')"
                   style="background-color:#dc2626;color:#ffffff;padding:14px 30px;
                          text-decoration:none;display:inline-block;border-radius:6px;
                          font-weight:bold;font-size:15px;">
                    🔍 Ver Equipo en Odoo
                </a>
            </div>

            
        </div>
    </div>
</body>
</html>
    ]]></field>
</record>

<!-- 2️⃣ CAMBIO NORMAL DE MODELO POR SNMP -->
<record id="email_template_snmp_model_change" model="mail.template">

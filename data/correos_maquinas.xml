                        <td style="padding:8px 0;color:#333;"><t t-out="object.cliente_id.name or 'N/A'"/></td>
                    </tr>
                </table>
            </div>

            <!-- Cambios -->
            <div style="margin:20px 0;padding:20px;background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;">
                <h3 style="margin:0 0 15px 0;color:#111827;font-size:18px;">🔄 Actualización</h3>
                
                <table style="width:100%;border-collapse:collapse;">

                        <td style="padding:5px 0;color:#333;"><t t-out="object.estado_ventas_id or 'N/A'"/></td>
                    </tr>
                    <tr>
                        <td style="padding:5px 0;color:#666;"><strong>Última actualización SNMP:</strong></td>
                        <td style="padding:5px 0;color:#333;">
                            <t t-out="object.ultima_actualizacion_snmp or 'N/A'"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:5px 0;color:#666;"><strong>Contador antes de SNMP:</strong></td>
                        <td style="padding:5px 0;color:#333;">
                            <t t-out="object.contador_antes_snmp or 'N/A'"/>
                        </td>
                    </tr>
                </table>
            </div>

            <!-- Botón -->
            <div style="text-align:center;margin:30px 0 10px 0;">
                <a t-att-href="object.generate_record_url(object)"
                   style="background-color:#dc2626;color:#ffffff;padding:14px 30px;
                          text-decoration:none;display:inline-block;border-radius:6px;
                          font-weight:bold;font-size:15px;">
                    🔍 Ver Equipo en Odoo (URGENTE)
                </a>
            </div>

            
        </div>
    </div>
</body>
</html>
    ]]></field>
</record>


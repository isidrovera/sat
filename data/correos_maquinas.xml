    <!DOCTYPE html>
    <html>
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    </head>
    <body bgcolor="#f5f5f5" style="margin: 0; padding: 0;">
        <!-- Contenedor Principal -->

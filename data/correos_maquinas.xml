            <div style="margin:20px 0;padding:20px;background-color:#fef2f2;border:2px solid #dc2626;border-radius:6px;">
                <h3 style="margin:0 0 15px 0;color:#dc2626;font-size:18px;">🚨 Anomalía Detectada</h3>
                
                <table style="width:100%;border-collapse:collapse;">
                    <tr style="background-color:#ffffff;">
                        <td style="padding:12px;border:1px solid #fecaca;font-weight:bold;width:40%;">Contador Anterior:</td>
                        <td style="padding:12px;border:1px solid #fecaca;color:#991b1b;font-size:18px;font-weight:bold;font-family:monospace;">
                            <t t-out="ctx.get('snmp_old_counter', '—')"/>
                        </td>
                    </tr>
                    <tr style="background-color:#ffffff;">
                        <td style="padding:12px;border:1px solid #fecaca;font-weight:bold;">Contador Nuevo:</td>
                        <td style="padding:12px;border:1px solid #fecaca;color:#dc2626;font-size:18px;font-weight:bold;font-family:monospace;">

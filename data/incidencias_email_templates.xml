                        <li><strong>Resultado:</strong> No afecta al técnico.</li>
                    </ul>

                    <p><strong>Motivo:</strong></p>
                    <div t-out="object.motivo_no_afecta or ''"/>

                    <p>
                        <a t-att-href="ctx.get('incidencia_url')"
                           style="background-color:#875A7B;color:#ffffff;padding:8px 12px;text-decoration:none;border-radius:4px;">
                            Ver incidencia
                        </a>
                    </p>
                </div>
            ]]></field>
        </record>



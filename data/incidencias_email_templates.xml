                <div>📅 Fecha resolución: <strong><t t-out="object.fecha_resolucion or ''"/></strong></div>
            </div>

            <p style="margin-top:25px;">
                <a t-att-href="ctx.get('incidencia_url') or '#'"
                   style="background-color:#875A7B; color:#ffffff; padding:10px 14px; text-decoration:none; border-radius:4px;">
                    Ver incidencia
                </a>
            </p>

            <div style="margin-top:30px; padding-top:15px; border-top:1px solid #eeeeee;">
                Saludos,<br/>
                <strong>Área Técnica</strong>
            </div>

        </div>
    </div>
</body>
</html>
            ]]></field>
        </record>

    </data>
</odoo>

<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <!-- ========================================================= -->
        <!-- INCIDENCIA CREADA -->
        <!-- ========================================================= -->
        <record id="email_template_taller_incidencia_creada" model="mail.template">
            <field name="name">Taller Incidencia - Creada</field>
            <field name="model_id" ref="model_taller_incidencia"/>
            <field name="email_from">{{ ctx.get('incidencia_email_from') or 'soporte@andescopiers.com.pe' }}</field>
            <field name="email_to">{{ ctx.get('incidencia_email_to') or 'soporte@andescopiers.com.pe' }}</field>
            <field name="subject">📌 Incidencia registrada {{ object.name }} - Serie {{ object.serie or '' }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html"><![CDATA[
<!DOCTYPE html>
<html>
<body style="margin:0; padding:0; font-family:Arial, Helvetica, sans-serif; background-color:#f5f5f5; color:#2d3748;">
    <div style="max-width:850px; margin:0 auto; padding:20px;">

        <div style="background-color:#667eea; padding:20px; text-align:center;">
            <div style="color:#ffffff; font-size:24px; font-weight:bold;">📌 Incidencia de Taller Registrada</div>
        </div>

        <div style="background-color:#ffffff; padding:25px; border:1px solid #e2e8f0;">

            <p>Estimados,</p>
            <p>Se ha registrado una nueva incidencia de taller para revisión.</p>

            <div style="background-color:#ebf8ff; padding:18px; margin:15px 0;">
                <div style="font-size:18px; font-weight:bold; margin-bottom:12px;">📋 Datos de la incidencia</div>
                <div>🆔 Incidencia: <strong><t t-out="object.name or ''"/></strong></div>
                <div>🔢 Serie: <strong><t t-out="object.serie or ''"/></strong></div>
                <div>🖨️ Modelo: <strong><t t-out="object.modelo_equipo or ''"/></strong></div>
                <div>🏢 Cliente: <strong><t t-out="object.cliente_id.name or ''"/></strong></div>
                <div>👩‍💼 Asesora: <strong><t t-out="object.asesora_nombre or ''"/></strong></div>
                <div>📅 Fecha entrega: <strong><t t-out="object.fecha_entrega or ''"/></strong></div>
                <div>📌 Estado: <strong><t t-out="dict(object._fields['estado'].selection).get(object.estado) or object.estado or ''"/></strong></div>
            </div>

            <div style="background-color:#fffaf0; padding:18px; margin:15px 0;">
                <div style="font-size:18px; font-weight:bold; margin-bottom:12px;">📝 Descripción del reclamo</div>
                <div><t t-out="object.descripcion or ''"/></div>
            </div>

            <p style="margin-top:25px;">
                <a t-att-href="ctx.get('incidencia_url') or '#'"
                   style="background-color:#875A7B; color:#ffffff; padding:10px 14px; text-decoration:none; border-radius:4px;">
                    Ver incidencia
                </a>
            </p>

            <div style="margin-top:30px; padding-top:15px; border-top:1px solid #eeeeee;">
                Saludos,<br/>
                <strong>Área Técnica</strong>
            </div>

        </div>
    </div>
</body>
</html>
            ]]></field>
        </record>



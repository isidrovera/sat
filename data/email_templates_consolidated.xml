                <t t-if="ctx.get('tickets_asistencia_directa')">
                    <t t-foreach="ctx.get('tickets_asistencia_directa')" t-as="ticket">
                        <div style="background-color: #edf2f7; padding: 10px; margin: 8px 0; border-left: 3px solid #38a169;">
                            <div style="font-weight: bold;">
                                <t t-out="ticket_index + 1"/>. Ticket <t t-out="ticket.name"/>
                            </div>
                            <div style="margin: 3px 0;">Equipo: <t t-out="ticket.product_alquiler.name.name if ticket.product_alquiler and ticket.product_alquiler.name else 'NA'"/></div>
                            <div style="margin: 3px 0;">Serie: <t t-out="ticket.serie_id_r"/></div>
                            <div style="margin: 3px 0;">Servicio: <t t-out="ticket.tipo_servicio_id"/></div>
                        </div>
                    </t>
                </t>
                <t t-else="">
                    <div style="background-color: #edf2f7; padding: 10px; border-left: 3px solid #38a169;">
                        <div style="font-weight: bold;">Ticket <t t-out="object.name"/></div>
                        <div style="margin: 3px 0;">Equipo: <t t-out="object.product_alquiler.name.name if object.product_alquiler and object.product_alquiler.name else 'NA'"/></div>
                        <div style="margin: 3px 0;">Serie: <t t-out="object.serie_id_r"/></div>
                        <div style="margin: 3px 0;">Servicio: <t t-out="object.tipo_servicio_id"/></div>
                    </div>
                </t>
            </div>

            <!-- Mensaje Final -->
            <div style="margin: 20px 0;">
                Quedo a su disposición para cualquier consulta o información adicional que requiera.
            </div>

            <!-- Firma -->
            <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee; color: #718096;">
                <div style="margin: 0;">
                    Cordialmente,<br>
                    <strong>Equipo de Soporte Técnico</strong>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
            ]]></field>
        </record>

    </data>
</odoo>
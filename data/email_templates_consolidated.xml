<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ================= CLIENTE ================= -->
    <record id="email_template_ticket_cliente_consolidado" model="mail.template">
      <field name="name">Tickets Consolidados - Cliente</field>
      <field name="model_id" ref="sat.model_ticket_alquiler"/>
      <field name="email_from">soporte@andescopiers.com.pe</field>
      <field name="email_to">{{object.product_alquiler.correo_}}</field>
      <field name="email_cc">jamilet.roggero@andescopiers.com.pe, comercial@andescopiers.com.pe, campuero@corapsac.com.pe, lincoln@corapsac.com, alquiler@andescopiers.com.pe, ventas3@andescopiers.com</field>
      <field name="subject">Visita Técnica </field>
      <field name="auto_delete" eval="True"/>
      <field name="body_html"><![CDATA[
<!DOCTYPE html>
<html><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"></head>
<body>
  <div>
    <div>
      <div>Visita Técnica Programada</div>
      <div>
        <t t-if="ctx.get('cantidad_tickets', 1) &gt; 1">
          <t t-out="ctx.get('cantidad_tickets')"/> Servicios para <t t-out="object.partner_id.name"/>
        </t>
        <t t-else="">Servicio para <t t-out="object.partner_id.name"/></t>
      </div>
    </div>

    <div>
      Estimado/a <strong><t t-out="object.partner_id.name"/></strong>,
      <div>
        Hemos programado
        <t t-if="ctx.get('cantidad_tickets', 1) &gt; 1"><strong><t t-out="ctx.get('cantidad_tickets')"/> servicios técnicos</strong></t>
        <t t-else=""><strong>una visita técnica</strong></t>.
      </div>

      <div>
        <div>Información General</div>
        <div>Fecha: <strong><t t-out="object.agenda_local"/></strong></div>
        <div>Dirección: <strong><t t-out="object.direccion_id_r"/></strong></div>
        <div>Técnico: <strong>
          <t t-if="ctx.get('tecnico_principal')"><t t-out="ctx.get('tecnico_principal').name"/></t>
          <t t-else=""><t t-out="object.responsable.name"/></t>
        </strong></div>
        <div>DNI: <strong>
          <t t-if="ctx.get('tecnico_principal')"><t t-out="ctx.get('tecnico_principal').vat"/></t>
          <t t-else=""><t t-out="object.responsable.vat"/></t>
        </strong></div>
      </div>

      <div>
        <div>
          <t t-if="ctx.get('cantidad_tickets', 1) &gt; 1">Equipos a Atender</t>
          <t t-else="">Equipo a Atender</t>
        </div>

        <t t-if="ctx.get('tickets_grupo')">
          <t t-foreach="ctx.get('tickets_grupo')" t-as="ticket" t-foreach-index="i">
            <div>
              <div>
                <t t-if="ctx.get('cantidad_tickets', 1) &gt; 1">Equipo #<t t-out="i + 1"/> - </t>
                Ticket <t t-out="ticket.name"/>
              </div>
              <div>Marca: <strong><t t-out="ticket.marca_id_r"/></strong></div>
              <div>Modelo: <strong><t t-out="ticket.product_alquiler.name.name if ticket.product_alquiler and ticket.product_alquiler.name else 'NA'"/></strong></div>
              <div>Serie: <strong><t t-out="ticket.serie_id_r"/></strong></div>
              <div>Servicio: <strong><t t-out="ticket.tipo_servicio_id"/></strong></div>
              <div>Problema: <t t-out="ticket.description"/></div>
            </div>
          </t>
        </t>
        <t t-else="">
          <div>
            <div>Marca: <strong><t t-out="object.marca_id_r"/></strong></div>
            <div>Modelo: <strong><t t-out="object.product_alquiler.name.name"/></strong></div>
            <div>Serie: <strong><t t-out="object.serie_id_r"/></strong></div>
            <div>Problema: <t t-out="object.description"/></div>
          </div>
        </t>
      </div>
    </div>
  </div>
</body></html>
      ]]></field>
    </record>

    <!-- ================ TÉCNICO ================= -->
    <record id="email_template_ticket_tecnico_consolidado" model="mail.template">
      <field name="name">Tickets Consolidados - Técnico</field>
      <field name="model_id" ref="sat.model_ticket_alquiler"/>
      <field name="email_from">soporte@andescopiers.com.pe</field>
      <field name="subject">Asignación </field>
      <field name="auto_delete" eval="False"/>
      <field name="email_to">
        
      </field>
      <field name="body_html"><![CDATA[
<!DOCTYPE html>
<html><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"></head>
<body>
  <div>
    <div>
      <div>
        <t t-if="ctx.get('cantidad_tickets', 1) &gt; 1">Asignación Masiva de Tickets</t>
        <t t-else="">Nuevo Ticket Asignado</t>
      </div>
      <div><t t-out="ctx.get('cantidad_tickets', 1)"/> Ticket(s) Asignado(s)</div>
    </div>

    <div>
      Estimado(a)
      <strong>
        <t t-if="ctx.get('tecnico_principal')"><t t-out="ctx.get('tecnico_principal').name"/></t>
        <t t-else=""><t t-out="object.responsable.name"/></t>
      </strong>,
      <div>
        <t t-if="ctx.get('cantidad_tickets', 1) &gt; 1">
          Se le han asignado <strong><t t-out="ctx.get('cantidad_tickets')"/> tickets</strong>.
        </t>
        <t t-else="">Se le ha asignado un nuevo ticket.</t>
      </div>

      <div>
        <div>Información General</div>
        <div>Cliente: <strong><t t-out="object.partner_id.name"/></strong></div>
        <div>Fecha: <strong><t t-out="object.agenda_local"/></strong></div>
        <div>Dirección: <strong><t t-out="object.direccion_id_r"/></strong></div>
        <div>Contacto: <strong><t t-out="object.contacto_id_r"/></strong></div>
        <div>Celular: <strong><t t-out="object.product_alquiler.celular if object.product_alquiler else 'NA'"/></strong></div>
      </div>

      <div>
        <div>
          <t t-if="ctx.get('cantidad_tickets', 1) &gt; 1">Equipos a Atender</t>
          <t t-else="">Equipo a Atender</t>
        </div>

        <t t-if="ctx.get('tickets_grupo')">
          <t t-foreach="ctx.get('tickets_grupo')" t-as="ticket" t-foreach-index="i">
            <div>
              <div><t t-out="i + 1"/>. Ticket <t t-out="ticket.name"/> - <t t-out="ticket.tipo_servicio_id"/></div>
              <div>Marca: <strong><t t-out="ticket.marca_id_r"/></strong></div>
              <div>Modelo: <strong><t t-out="ticket.product_alquiler.name.name if ticket.product_alquiler and ticket.product_alquiler.name else 'NA'"/></strong></div>
              <div>Serie: <strong><t t-out="ticket.serie_id_r"/></strong></div>
              <div>Problema: <t t-out="ticket.description"/></div>
            </div>
          </t>
        </t>
        <t t-else="">
          <div>
            <div>Marca: <strong><t t-out="object.marca_id_r"/></strong></div>
            <div>Modelo: <strong><t t-out="object.product_alquiler.name.name"/></strong></div>
            <div>Serie: <strong><t t-out="object.serie_id_r"/></strong></div>
            <div>Problema: <t t-out="object.description"/></div>
          </div>
        </t>
      </div>
    </div>
  </div>
</body></html>
      ]]></field>
    </record>

    
    <record id="mail_template_asistencia_directa_consolidado" model="mail.template">
      <field name="name">Asistencia Directa Consolidada</field>
      <field name="model_id" ref="sat.model_ticket_alquiler"/>
      <field name="email_from">soporte@andescopiers.com.pe</field>
      <field name="email_to">t.escalante@corapsac.com.pe</field>
      <field name="email_cc">jamilet.roggero@andescopiers.com.pe, campuero@corapsac.com.pe, lincoln@corapsac.com</field>
      <field name="subject">Reporte de Asistencia Directa </field>
      <field name="auto_delete" eval="True"/>
      <field name="body_html"><![CDATA[
<!DOCTYPE html>
<html><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"></head>
<body>
  <div>
    <div>
      <div>Reporte de Asistencia Directa</div>
      <div><t t-out="ctx.get('cantidad_tickets', 1)"/> Servicio(s) Programado(s)</div>
    </div>

    <div>
      Estimada Señora Teresa,
      <div>
        Le informo que el trabajador designado realizará
        <t t-if="ctx.get('cantidad_tickets', 1) &gt; 1"><strong><t t-out="ctx.get('cantidad_tickets')"/> visitas técnicas directas</strong></t>
        <t t-else=""><strong>una visita técnica directa</strong></t>.
      </div>

      <div>
        <div>Información General</div>
        <div>Cliente: <strong><t t-out="object.partner_id.name"/></strong></div>
        <div>Fecha: <strong><t t-out="object.agenda_local"/></strong></div>
        <div>Trabajador: <strong>
          <t t-if="ctx.get('tecnico_principal')"><t t-out="ctx.get('tecnico_principal').name"/></t>
          <t t-else=""><t t-out="object.responsable.name"/></t>
        </strong></div>
        <div>Dirección: <strong><t t-out="object.direccion_id_r"/></strong></div>
      </div>

      <div>
        <div>
          <t t-if="ctx.get('cantidad_tickets', 1) &gt; 1">Servicios con Asistencia Directa</t>
          <t t-else="">Servicio con Asistencia Directa</t>
        </div>

        <t t-if="ctx.get('tickets_asistencia_directa')">
          <t t-foreach="ctx.get('tickets_asistencia_directa')" t-as="ticket" t-foreach-index="i">
            <div>
              <div><t t-out="i + 1"/>. Ticket <t t-out="ticket.name"/></div>
              <div>Equipo: <t t-out="ticket.product_alquiler.name.name if ticket.product_alquiler and ticket.product_alquiler.name else 'NA'"/></div>
              <div>Serie: <t t-out="ticket.serie_id_r"/></div>
              <div>Servicio: <t t-out="ticket.tipo_servicio_id"/></div>
            </div>
          </t>
        </t>
        <t t-else="">
          <div>
            <div>Ticket <t t-out="object.name"/></div>
            <div>Equipo: <t t-out="object.product_alquiler.name.name if object.product_alquiler and object.product_alquiler.name else 'NA'"/></div>
            <div>Serie: <t t-out="object.serie_id_r"/></div>
            <div>Servicio: <t t-out="object.tipo_servicio_id"/></div>
          </div>
        </t>
      </div>

      <div>Quedo a su disposición para cualquier consulta adicional.</div>
    </div>
  </div>
</body></html>
      ]]></field>
    </record>

  </data>
</odoo>

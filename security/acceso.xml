<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record model="ir.module.category" id="module_sat_category">
            <field name="name">Taller</field>
            <field name="description">Taller</field>
            <field name="sequence">20</field>
        </record>
      
        <record id="Sat_ventas_group_user" model="res.groups">
            <field name="name">Area ventas taller</field>
            <field name="category_id" ref="module_sat_category" />
            <field name="implied_ids" eval="[(4,ref('base.group_user'))]" />
        </record>
        <!-- Nuevo grupo para el área técnica del taller -->
        <record id="sat_tecnica_group_user" model="res.groups">
            <field name="name">Area técnica taller</field>
            <field name="category_id" ref="module_sat_category"/>
            <field name="implied_ids" eval="[(4,ref('base.group_user'))]"/>
        </record> 
        <record id="sat_jefes_group_user" model="res.groups">
            <field name="name">Jefes de Área</field>
            <field name="category_id" ref="module_sat_category"/>
            <field name="implied_ids" eval="[(4,ref('base.group_user'))]"/>
        </record>   

    </data>
</odoo>
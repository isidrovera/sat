<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Categoría del módulo -->
        <record model="ir.module.category" id="module_sat_category">
            <field name="name">Taller</field>
            <field name="description">Taller</field>
            <field name="sequence">20</field>
        </record>

        <!-- Grupo para el área de ventas del taller -->
        <record id="Sat_ventas_group_user" model="res.groups">
            <field name="name">Área ventas taller</field>
            <field name="category_id" ref="module_sat_category" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <!-- Grupo para el área técnica del taller -->
        <record id="sat_tecnica_group_user" model="res.groups">
            <field name="name">Área técnica taller</field>
            <field name="category_id" ref="module_sat_category"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Grupo para los jefes de área -->
        <record id="sat_jefes_group_user" model="res.groups">
            <field name="name">Jefes de Área</field>
            <field name="category_id" ref="module_sat_category"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Regla para técnicos: ver solo sus reparaciones -->
        <record id="repair_order_technician_rule" model="ir.rule">
            <field name="name">Técnicos: ver solo sus reparaciones</field>
            <field name="model_id" ref="sat.model_reparaciones_reparaciones"/>
            <field name="groups" eval="[(4, ref('sat_tecnica_group_user'))]"/>
            <field name="domain_force">[
                ('responsable_id', '=', user.id), 
                ('estado_id', '!=', 'entregada'), 
                ('estado_id', '!=', 'finalizado')
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla para técnicos: ver solo sus tickets de alquiler -->
        <record id="ticket_order_technician_rule" model="ir.rule">
            <field name="name">Técnicos: ver solo sus tickets</field>
            <field name="model_id" ref="sat.model_ticket_alquiler"/>
            <field name="groups" eval="[(4, ref('sat_tecnica_group_user'))]"/>
            <field name="domain_force">[
                ('responsable', '=', user.id), 
                ('estado', '!=', 'proceso')
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
       

    </data>
</odoo>

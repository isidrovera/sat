<odoo>

    <record id="view_sat_entrega_wizard_form" model="ir.ui.view">
        <field name="name">sat.entrega.wizard.form</field>
        <field name="model">sat.entrega.wizard</field>
        <field name="arch" type="xml">

            <form string="Registrar entrega" create="false" edit="false">

                <group>
                    <field name="maquina_id" readonly="1"/>
                    <field name="factura_venta"/>
                    <field name="fecha_entrega"/>
                </group>

                <footer>

                    <!-- 🔥 ESTE ES EL BOTÓN REAL -->
                    <button name="action_confirmar"
                            string="Confirmar entrega"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

</odoo>
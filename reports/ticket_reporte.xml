<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <report
            id="ticket_alquiler"
            model="ticket.alquiler"
            string="Ticket Alquiler"
            name="sat.ticket_view"
            file="ticket.alquiler"
            report_type="qweb-pdf"
            print_report_name="object.name"/>

        <template id="ticket_view">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="ticket">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="oe_structure"/>

                            <style>
                                .header {
                                    font-size: 24px;
                                    font-weight: bold;
                                    margin-top: 20px;
                                    text-align: center;
                                }
                                .section-title {
                                    font-size: 20px;
                                    font-weight: bold;
                                    background-color: black;
                                    color: white;
                                    padding: 5px;
                                    margin-top: 20px;
                                }
                                .info-table {
                                    width: 100%;
                                    border-collapse: collapse;
                                    margin-bottom: 20px;
                                }
                                .info-table th, .info-table td {
                                    border: 1px solid #ddd;
                                    padding: 8px;
                                }
                                .info-table th {
                                    background-color: #f2f2f2;
                                    text-align: left;
                                }
                                .color-cyan {
                                    background-color: cyan;
                                    color: black;
                                }
                                .color-magenta {
                                    background-color: magenta;
                                    color: white;
                                }
                                .color-yellow {
                                    background-color: yellow;
                                    color: black;
                                }
                                .color-black {
                                    background-color: black;
                                    color: white;
                                }
                                .highlight {
                                    font-weight: bold;
                                    color: #007BFF;
                                }
                            </style>

                            <h2 class="header">
                                <span t-field="ticket.name"/>
                            </h2>

                            <div id="informationss">
                                <table class="info-table">
                                    <tr>
                                        <th>Fecha de visita</th>
                                        <td><t t-esc="ticket.agenda_local"/></td>
                                    </tr>
                                    <tr>
                                        <th>Marca</th>
                                        <td><t t-esc="ticket.marca_id_r"/></td>
                                        <th>Maquina</th>
                                        <td><t t-esc="ticket.product_alquiler.name.name"/></td>
                                        <th>Serie</th>
                                        <td><t t-esc="ticket.product_alquiler.serie"/></td>
                                    </tr>
                                    <tr>
                                        <th>Contometro Black</th>
                                        <td><t t-esc="ticket.contometrok_id"/></td>
                                        <th>Contometro Color</th>
                                        <td><t t-esc="ticket.contometroc_id"/></td>
                                        <th>Contometro Scanner</th>
                                        <td><t t-esc="ticket.contometros_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Calidad</th>
                                        <td><t t-esc="ticket.calidad_id"/></td>
                                    </tr>
                                </table>
                            </div>

                            <div>
                                <h2 class="section-title">Informe Técnico</h2>
                                <p><t t-esc="ticket.informe_id"/></p>
                            </div>

                            <div class="oe_structure"/>
                            <h2 class="section-title">ACCESORIOS</h2>

                            <div id="informations">
                                <table class="info-table">
                                    <tr>
                                        <th>Caseteras N°</th>
                                        <td><t t-esc="ticket.tray_id"/></td>
                                        <th>ADF simple</th>
                                        <td><t t-esc="ticket.adf_simple_id"/></td>
                                        <th>ADF dual scan</th>
                                        <td><t t-esc="ticket.adf_dual_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Finalizador interno</th>
                                        <td><t t-esc="ticket.finalizador_interno_id"/></td>
                                        <th>Finalizador externo</th>
                                        <td><t t-esc="ticket.finalizador_externo_id"/></td>
                                        <th>Mueble</th>
                                        <td><t t-esc="ticket.mueble_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Transformador</th>
                                        <td><t t-esc="ticket.transformador_id"/></td>
                                        <th>Wi-Fi</th>
                                        <td><t t-esc="ticket.wi_fi_id"/></td>
                                        <th>Estabilizador</th>
                                        <td><t t-esc="ticket.estabilizador"/></td>
                                    </tr>
                                    <tr>
                                        <th>Panel normal</th>
                                        <td><t t-esc="ticket.panel_normal_id"/></td>
                                        <th>Panel smart</th>
                                        <td><t t-esc="ticket.panel_smart_id"/></td>
                                        <th>Cable de impresión USB</th>
                                        <td><t t-esc="ticket.cable_usb_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Cable de red</th>
                                        <td><t t-esc="ticket.cable_red_id"/></td>
                                        <th>Bluetooth</th>
                                        <td><t t-esc="ticket.bluetooth_id"/></td>
                                    </tr>
                                </table>
                            </div>

                            <div class="oe_structure"/>
                            <h2 class="section-title">CHECK LIST</h2>

                            <div id="informations">
                                <table class="info-table">
                                    <tr>
                                        <th>Copia</th>
                                        <td><t t-esc="ticket.selection_labels['copia_id']"/></td>
                                        <th>Impresión</th>
                                        <td><t t-esc="ticket.impresion_id"/></td>
                                        <th>Impresión USB</th>
                                        <td><t t-esc="ticket.impresion_usb_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Scaner SMB</th>
                                        <td><t t-esc="ticket.scaner_smb_id"/></td>
                                        <th>Scaner USB</th>
                                        <td><t t-esc="ticket.scaner_usb_id"/></td>
                                        <th>Scaner FTP</th>
                                        <td><t t-esc="ticket.scaner_ftp_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Scaner Mail</th>
                                        <td><t t-esc="ticket.scaner_mail_id"/></td>
                                        <th>Bypass</th>
                                        <td><t t-esc="ticket.bypass_id"/></td>
                                        <th>Tray 1</th>
                                        <td><t t-esc="ticket.tray1_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Tray 2</th>
                                        <td><t t-esc="ticket.tray2_id"/></td>
                                        <th>Tray 3</th>
                                        <td><t t-esc="ticket.tray3_id"/></td>
                                        <th>Tray 4</th>
                                        <td><t t-esc="ticket.tray4_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>ADF</th>
                                        <td><t t-esc="ticket.adf_id"/></td>
                                        <th>Finalizador</th>
                                        <td><t t-esc="ticket.finalizador_id"/></td>
                                        <th>Tacho residual</th>
                                        <td><t t-esc="ticket.tacho_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Faja fusora</th>
                                        <td><t t-esc="ticket.fusora_id"/></td>
                                        <th>Faja de transferencia</th>
                                        <td><t t-esc="ticket.transfer_id"/></td>
                                        <th>Optico</th>
                                        <td><t t-esc="ticket.optico_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Toner black</th>
                                        <td class="color-black"><t t-esc="ticket.toner_black_id"/></td>
                                        <th>Toner magenta</th>
                                        <td class="color-magenta"><t t-esc="ticket.toner_magenta_id"/></td>
                                        <th>Unidad Imagen cyan</th>
                                        <td class="color-cyan"><t t-esc="ticket.cyan_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Toner yellow</th>
                                        <td class="color-yellow"><t t-esc="ticket.toner_yellow_id"/></td>
                                        <th>Unidad Imagen black</th>
                                        <td><t t-esc="ticket.black_id"/></td>
                                        <th>Unidad Imagen magenta</th>
                                        <td><t t-esc="ticket.magenta_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Toner cyan</th>
                                        <td class="color-cyan"><t t-esc="ticket.toner_cyan_id"/></td>
                                    </tr>
                                </table>
                            </div>

                            <div id="informations" class="row mt32 mb32">
                                <div class="col-3 bm-2">
                                    <strong>Técnico</strong>
                                    <t>
                                        <span t-esc="ticket.responsable.name"/>
                                    </t>
                                </div>
                                <div class="col-3 bm-2">
                                    <strong>DNI</strong>
                                    <t>
                                        <span t-esc="ticket.responsable.vat"/>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>

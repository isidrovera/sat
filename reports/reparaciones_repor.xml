<odoo>
    
        
        <template id="report_reparaciones_ventas">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="reparaciones">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="oe_structure"/>

                            <style>
                                .header {
                                    font-size: 24px;
                                    font-weight: bold;
                                    margin-top: 20px;
                                    text-align: left;
                                }
                                .section-title {
                                    font-size: 20px;
                                    font-weight: bold;
                                    background-color: black;
                                    color: white;
                                    padding: 5px;
                                    margin-top: 20px;
                                }
                                .info-table {
                                    width: 100%;
                                    border-collapse: collapse;
                                    margin-bottom: 20px;
                                }
                                .info-table th, .info-table td {
                                    border: 1px solid #ddd;
                                    padding: 8px;
                                }
                                .info-table th {
                                    background-color: #f2f2f2;
                                    text-align: left;
                                }
                                .color-cyan {
                                    background-color: cyan;
                                    color: black;
                                }
                                .color-magenta {
                                    background-color: magenta;
                                    color: white;
                                }
                                .color-yellow {
                                    background-color: yellow;
                                    color: black;
                                }
                                .color-black {
                                    background-color: black;
                                    color: white;
                                }
                                .highlight {
                                    font-weight: bold;
                                    color: #007BFF;
                                }
                            </style>

                            <h2 class="header">
                                <span t-field="reparaciones.name"/>
                            </h2>

                            <div id="informationss">
                                <table class="info-table">
                                    <tr>
                                        <th>Tipo de equipo</th>
                                        <td><t t-esc="reparaciones.tipo_machine"/></td>
                                        <th>Marca</th>
                                        <td><t t-esc="reparaciones.marca"/></td>
                                        <th>Maquina</th>
                                        <td><t t-esc="reparaciones.maquina_id.name.name"/></td>
                                    </tr>
                                    <tr>
                                        <th>Contometro</th>
                                        <td><t t-esc="reparaciones.contometrok_id"/></td>
                                        <th>Calidad</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('calidad_id', 'NA')"/></td>
                                        <th>Tapas</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('tapas_id', 'NA')"/></td>
                                    </tr>
                                    <tr>
                                        <th>Panel</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('panel_id', 'NA')"/></td>
                                    </tr>
                                </table>
                            </div>

                            <div>
                                <h2 class="section-title">Informe Técnico</h2>
                                <p><t t-esc="reparaciones.informe"/></p>
                            </div>

                            <div class="oe_structure"/>
                            <h2 class="section-title">ACCESORIOS</h2>

                            <div id="informations">
                                <table class="info-table">
                                    <tr>
                                        <th>Caseteras</th>
                                        <td><t t-esc="reparaciones.tray_id"/></td>
                                        <th>ADF simple</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('adf_simple_id', 'NA')"/></td>
                                        <th>ADF dual scan</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('adf_dual_id', 'NA')"/></td>
                                    </tr>
                                    <tr>
                                        <th>Finalizador interno</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('finalizador_interno_id', 'NA')"/></td>
                                        <th>Finalizador externo</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('finalizador_externo_id', 'NA')"/></td>
                                        <th>Mueble</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('mueble_id', 'NA')"/></td>
                                    </tr>
                                    <tr>
                                        <th>LCT</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('lct_id', 'NA')"/></td>
                                        <th>Wi-Fi</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('wi_fi_id', 'NA')"/></td>
                                        <th>Cable de poder</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('cable_poder_id', 'NA')"/></td>
                                    </tr>
                                    <tr>
                                        <th>Panel normal</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('panel_normal_id', 'NA')"/></td>
                                        <th>Panel smart</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('panel_smart_id', 'NA')"/></td>
                                        <th>Bandeja OT</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('ot_id', 'NA')"/></td>
                                    </tr>
                                    <tr>
                                        <th>Disco duro</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('hdd_id', 'NA')"/></td>
                                    </tr>
                                </table>
                            </div>

                            <div class="oe_structure"/>
                            <h2 class="section-title">CHECK LIST</h2>

                            <div id="informations">
                                <table class="info-table">
                                    <tr>
                                        <th>Copia</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('copia_id', 'NA')"/></td>
                                        <th>Impresión</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('impresion_id', 'NA')"/></td>
                                        <th>Impresión USB</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('impresion_usb_id', 'NA')"/></td>
                                    </tr>
                                    <tr>
                                        <th>Scaner SMB</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('scaner_smb_id', 'NA')"/></td>
                                        <th>Scaner USB</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('scaner_usb_id', 'NA')"/></td>
                                        <th>Scaner FTP</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('scaner_ftp_id', 'NA')"/></td>
                                    </tr>
                                    <tr>
                                        <th>Scaner Mail</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('scaner_mail_id', 'NA')"/></td>
                                        <th>Bypass</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('bypass_id', 'NA')"/></td>
                                        <th>Tray 1</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('tray1_id', 'NA')"/></td>
                                    </tr>
                                    <tr>
                                        <th>Tray 2</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('tray2_id', 'NA')"/></td>
                                        <th>Tray 3</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('tray3_id', 'NA')"/></td>
                                        <th>Tray 4</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('tray4_id', 'NA')"/></td>
                                    </tr>
                                    <tr>
                                        <th>ADF</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('adf_id', 'NA')"/></td>
                                        <th>Finalizador</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('finalizador_id', 'NA')"/></td>
                                        <th>Tacho residual</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('tacho_id', 'NA')"/></td>
                                    </tr>
                                    <tr>
                                        <th>Faja fusora</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('fusora_id', 'NA')"/></td>
                                        <th>Rodillo de presión</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('rodillo_id', 'NA')"/></td>
                                        <th>Rodillo de calor</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('calor_id', 'NA')"/></td>
                                    </tr>
                                    <tr>
                                        <th>Faja de transferencia</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('transfer_id', 'NA')"/></td>
                                        <th>Optico</th>
                                        <td><t t-esc="selection_labels.get(reparaciones.id, {}).get('optico_id', 'NA')"/></td>
                                         <th>Unidad Imagen black</th>
                                        <td class="color-black"><t t-esc="selection_labels.get(reparaciones.id, {}).get('black_id', 'NA')"/></td>
                                    </tr>
                                    <tr>                                       
                                        <th>Unidad Imagen magenta</th>
                                        <td class="color-magenta"><t t-esc="selection_labels.get(reparaciones.id, {}).get('magenta_id', 'NA')"/></td>
                                        <th>Unidad Imagen cyan</th>
                                        <td class="color-cyan"><t t-esc="selection_labels.get(reparaciones.id, {}).get('cyan_id', 'NA')"/></td>
                                        <th>Unidad Imagen yellow</th>
                                        <td class="color-yellow"><t t-esc="selection_labels.get(reparaciones.id, {}).get('yellow_id', 'NA')"/></td>
                                        
                                    </tr>
                                    <tr>
                                        
                                    </tr>
                                    <tr>
                                        <th>Developer black</th>
                                        <td class="color-black"><t t-esc="selection_labels.get(reparaciones.id, {}).get('developerk_id', 'NA')"/></td>
                                        <th>Developer magenta</th>
                                        <td class="color-magenta"><t t-esc="selection_labels.get(reparaciones.id, {}).get('developerm_id', 'NA')"/></td>
                                        <th>Developer cyan</th>
                                        <td class="color-cyan"><t t-esc="selection_labels.get(reparaciones.id, {}).get('developerc_id', 'NA')"/></td>
                                    </tr>
                                    <tr> 
                                        <th>Developer yellow</th>
                                        <td class="color-yellow"><t t-esc="selection_labels.get(reparaciones.id, {}).get('developery_id', 'NA')"/></td>                                       
                                        <th>Toner black</th>
                                        <td class="color-black"><t t-esc="selection_labels.get(reparaciones.id, {}).get('toner_black_id', 'NA')"/></td>
                                        <th>Toner magenta</th>
                                        <td class="color-magenta"><t t-esc="selection_labels.get(reparaciones.id, {}).get('toner_magenta_id', 'NA')"/></td>
                                    </tr>
                                    <tr>                                    
                                        <th>Toner cyan</th>
                                        <td class="color-cyan"><t t-esc="selection_labels.get(reparaciones.id, {}).get('toner_cyan_id', 'NA')"/></td>
                                        <th>Toner yellow</th>
                                        <td class="color-yellow"><t t-esc="selection_labels.get(reparaciones.id, {}).get('toner_yellow_id', 'NA')"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    
</odoo>


<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <report id="report_reparaciones_ventas" 
                model="reparaciones.reparaciones" 
                string="Reparación" 
                name="sat.reparacion_view" 
                file="reparaciones.reparaciones" 
                report_type="qweb-pdf" 
                print_report_name="object.name"/>

        <template id="reparacion_view">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="reparaciones">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="oe_structure"/>

                            <style>
                                .header {
                                    font-size: 24px;
                                    font-weight: bold;
                                    margin-top: 20px;
                                    text-align: center;
                                }
                                .section-title {
                                    font-size: 20px;
                                    font-weight: bold;
                                    background-color: black;
                                    color: white;
                                    padding: 5px;
                                    margin-top: 20px;
                                }
                                .info-table {
                                    width: 100%;
                                    border-collapse: collapse;
                                    margin-bottom: 20px;
                                }
                                .info-table th, .info-table td {
                                    border: 1px solid #ddd;
                                    padding: 8px;
                                }
                                .info-table th {
                                    background-color: #f2f2f2;
                                    text-align: left;
                                }
                                .color-cyan {
                                    background-color: cyan;
                                    color: black;
                                }
                                .color-magenta {
                                    background-color: magenta;
                                    color: white;
                                }
                                .color-yellow {
                                    background-color: yellow;
                                    color: black;
                                }
                                .color-black {
                                    background-color: black;
                                    color: white;
                                }
                                .highlight {
                                    font-weight: bold;
                                    color: #007BFF;
                                }
                            </style>

                            <h2 class="header">
                                <span t-field="reparaciones.name"/>
                            </h2>

                            <div id="informationss">
                                <table class="info-table">
                                    <tr>
                                        <th>Tipo de equipo</th>
                                        <td><t t-esc="reparaciones.tipo_machine"/></td>
                                        <th>Marca</th>
                                        <td><t t-esc="reparaciones.marca"/></td>
                                        <th>Maquina</th>
                                        <td><t t-esc="reparaciones.maquina_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <th>Contometro</th>
                                        <td><t t-esc="reparaciones.contometrok_id"/></td>
                                        <th>Calidad</th>
                                        <td><t t-esc="reparaciones.calidad_id"/></td>
                                        <th>Tapas</th>
                                        <td><t t-esc="reparaciones.tapas_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Panel</th>
                                        <td><t t-esc="reparaciones.panel_id"/></td>
                                    </tr>
                                </table>
                            </div>

                            <div>
                                <h2 class="section-title">Informe Técnico</h2>
                                <p><t t-esc="reparaciones.informe"/></p>
                            </div>

                            <div class="oe_structure"/>
                            <h2 class="section-title">ACCESORIOS</h2>

                            <div id="informations">
                                <table class="info-table">
                                    <tr>
                                        <th>Caseteras</th>
                                        <td><t t-esc="reparaciones.tray_id"/></td>
                                        <th>ADF simple</th>
                                        <td><t t-esc="reparaciones.adf_simple_id"/></td>
                                        <th>ADF dual sacn</th>
                                        <td><t t-esc="reparaciones.adf_dual_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Finalizador interno</th>
                                        <td><t t-esc="reparaciones.finalizador_interno_id"/></td>
                                        <th>Finalizador externo</th>
                                        <td><t t-esc="reparaciones.finalizador_externo_id"/></td>
                                        <th>Mueble</th>
                                        <td><t t-esc="reparaciones.mueble_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>LCT</th>
                                        <td><t t-esc="reparaciones.lct_id"/></td>
                                        <th>Wi-Fi</th>
                                        <td><t t-esc="reparaciones.wi_fi_id"/></td>
                                        <th>Cable de poder</th>
                                        <td><t t-esc="reparaciones.cable_poder_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Panel normal</th>
                                        <td><t t-esc="reparaciones.panel_normal_id"/></td>
                                        <th>Panel smart</th>
                                        <td><t t-esc="reparaciones.panel_smart_id"/></td>
                                        <th>Bandeja OT</th>
                                        <td><t t-esc="reparaciones.ot_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Disco duro</th>
                                        <td><t t-esc="reparaciones.hdd_id"/></td>
                                    </tr>
                                </table>
                            </div>

                            <div class="oe_structure"/>
                            <h2 class="section-title">CHECK LIST</h2>

                            <div id="informations">
                                <table class="info-table">
                                    <tr>
                                        <th>Copia</th>
                                        <td><t t-esc="reparaciones.copia_id"/></td>
                                        <th>Impresión</th>
                                        <td><t t-esc="reparaciones.impresion_id"/></td>
                                        <th>Impresión USB</th>
                                        <td><t t-esc="reparaciones.impresion_usb_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Scaner SMB</th>
                                        <td><t t-esc="reparaciones.scaner_smb_id"/></td>
                                        <th>Scaner USB</th>
                                        <td><t t-esc="reparaciones.scaner_usb_id"/></td>
                                        <th>Scaner FTP</th>
                                        <td><t t-esc="reparaciones.scaner_ftp_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Scaner Mail</th>
                                        <td><t t-esc="reparaciones.scaner_mail_id"/></td>
                                        <th>Bypass</th>
                                        <td><t t-esc="reparaciones.bypass_id"/></td>
                                        <th>Tray 1</th>
                                        <td><t t-esc="reparaciones.tray1_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Tray 2</th>
                                        <td><t t-esc="reparaciones.tray2_id"/></td>
                                        <th>Tray 3</th>
                                        <td><t t-esc="reparaciones.tray3_id"/></td>
                                        <th>Tray 4</th>
                                        <td><t t-esc="reparaciones.tray4_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>ADF</th>
                                        <td><t t-esc="reparaciones.adf_id"/></td>
                                        <th>Finalizador</th>
                                        <td><t t-esc="reparaciones.finalizador_id"/></td>
                                        <th>Tacho residual</th>
                                        <td><t t-esc="reparaciones.tacho_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Faja fusora</th>
                                        <td><t t-esc="reparaciones.fusora_id"/></td>
                                        <th>Rodillo de presión</th>
                                        <td><t t-esc="reparaciones.rodillo_id"/></td>
                                        <th>Rodillo de calor</th>
                                        <td><t t-esc="reparaciones.calor_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Faja de transferencia</th>
                                        <td><t t-esc="reparaciones.transfer_id"/></td>
                                        <th>Optico</th>
                                        <td><t t-esc="reparaciones.optico_id"/></td>
                                        <th>Toner black</th>
                                        <td class="color-black"><t t-esc="reparaciones.toner_black_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Toner magenta</th>
                                        <td class="color-magenta"><t t-esc="reparaciones.toner_magenta_id"/></td>
                                        <th>Unidad Imagen cyan</th>
                                        <td class="color-cyan"><t t-esc="reparaciones.cyan_id"/></td>
                                        <th>Toner yellow</th>
                                        <td class="color-yellow"><t t-esc="reparaciones.toner_yellow_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Unidad Imagen black</th>
                                        <td><t t-esc="reparaciones.black_id"/></td>
                                        <th>Unidad Imagen magenta</th>
                                        <td><t t-esc="reparaciones.magenta_id"/></td>
                                        <th>Toner cyan</th>
                                        <td class="color-cyan"><t t-esc="reparaciones.toner_cyan_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Developer black</th>
                                        <td class="color-black"><t t-esc="reparaciones.developerk_id"/></td>
                                        <th>Developer magenta</th>
                                        <td class="color-magenta"><t t-esc="reparaciones.developerm_id"/></td>
                                        <th>Developer cyan</th>
                                        <td class="color-cyan"><t t-esc="reparaciones.developerc_id"/></td>
                                    </tr>
                                    <tr>
                                        <th>Developer yellow</th>
                                        <td class="color-yellow"><t t-esc="reparaciones.developery_id"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>

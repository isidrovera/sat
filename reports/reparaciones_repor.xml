<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <report id="report_reparaciones_ventas" 
                model="reparaciones.reparaciones" 
                string="Reparación" 
                name="sat.reparacion_view" 
                file="reparaciones.reparaciones" 
                report_type="qweb-pdf" 
                print_report_name="object.name"/>

        <template id="reparacion_view">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="reparaciones">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="oe_structure"/>

                            <style>
                                .header {
                                    font-size: 24px;
                                    font-weight: bold;
                                    margin-top: 20px;
                                    text-align: center;
                                }
                                .section-title {
                                    font-size: 20px;
                                    font-weight: bold;
                                    background-color: black;
                                    color: white;
                                    padding: 5px;
                                    margin-top: 20px;
                                }
                                .info-table {
                                    width: 100%;
                                    border-collapse: collapse;
                                    margin-bottom: 20px;
                                }
                                .info-table th, .info-table td {
                                    border: 1px solid #ddd;
                                    padding: 8px;
                                }
                                .info-table th {
                                    background-color: #f2f2f2;
                                    text-align: left;
                                }
                                .color-cyan {
                                    background-color: cyan;
                                    color: black;
                                }
                                .color-magenta {
                                    background-color: magenta;
                                    color: white;
                                }
                                .color-yellow {
                                    background-color: yellow;
                                    color: black;
                                }
                                .color-black {
                                    background-color: black;
                                    color: white;
                                }
                                .highlight {
                                    font-weight: bold;
                                    color: #007BFF;
                                }
                            </style>

                            <h2 class="header">
                                <span t-field="reparaciones.name"/>
                            </h2>

                            <div id="informationss">
                                <table class="info-table">
                                    <tr>
                                        <th>Tipo de equipo</th>
                                        <td t-field="reparaciones.tipo_machine" class="m-0"/>
                                        <th>Marca</th>
                                        <td t-field="reparaciones.marca" class="m-0"/>
                                        <th>Maquina</th>
                                        <td t-field="reparaciones.maquina_id" class="m-0"/>
                                    </tr>
                                    <tr>
                                        <th>Contometro</th>
                                        <td t-field="reparaciones.contometrok_id" class="m-0"/>
                                        <th>Calidad</th>
                                        <td t-field="reparaciones.calidad_id" class="m-0"/>
                                        <th>Tapas</th>
                                        <td t-field="reparaciones.tapas_id" class="m-0"/>
                                    </tr>
                                    <tr>
                                        <th>Panel</th>
                                        <td t-field="reparaciones.panel_id" class="m-0"/>
                                    </tr>
                                </table>
                            </div>

                            <div>
                                <h2 class="section-title">Informe Técnico</h2>
                                <p><span t-field="reparaciones.informe"/></p>
                            </div>

                            <div class="oe_structure"/>
                            <h2 class="section-title">ACCESORIOS</h2>

                            <div id="informations">
                                <table class="info-table">
                                    <tr>
                                        <th>Caseteras</th>
                                        <td t-field="reparaciones.tray_id" class="m-0"/>
                                        <th>ADF simple</th>
                                        <td t-field="reparaciones.adf_simple_id" class="m-0"/>
                                        <th>ADF dual sacn</th>
                                        <td t-field="reparaciones.adf_dual_id" class="m-0"/>
                                    </tr>
                                    <tr>
                                        <th>Finalizador interno</th>
                                        <td t-field="reparaciones.finalizador_interno_id" class="m-0"/>
                                        <th>Finalizador externo</th>
                                        <td t-field="reparaciones.finalizador_externo_id" class="m-0"/>
                                        <th>Mueble</th>
                                        <td t-field="reparaciones.mueble_id" class="m-0"/>
                                    </tr>
                                    <tr>
                                        <th>LCT</th>
                                        <td t-field="reparaciones.lct_id" class="m-0"/>
                                        <th>Wi-Fi</th>
                                        <td t-field="reparaciones.wi_fi_id" class="m-0"/>
                                        <th>Cable de poder</th>
                                        <td t-field="reparaciones.cable_poder_id" class="m-0"/>
                                    </tr>
                                    <tr>
                                        <th>Panel normal</th>
                                        <td t-field="reparaciones.panel_normal_id" class="m-0"/>
                                        <th>Panel smart</th>
                                        <td t-field="reparaciones.panel_smart_id" class="m-0"/>
                                        <th>Bandeja OT</th>
                                        <td t-field="reparaciones.ot_id" class="m-0"/>
                                    </tr>
                                    <tr>
                                        <th>Disco duro</th>
                                        <td t-field="reparaciones.hdd_id" class="m-0"/>
                                    </tr>
                                </table>
                            </div>

                            <div class="oe_structure"/>
                            <h2 class="section-title">CHECK LIST</h2>

                            <div id="informations">
                                <table class="info-table">
                                    <tr>
                                        <th>ADF</th>
                                        <td t-field="reparaciones.adf_id" class="m-0"/>
                                        <th>Caseteras</th>
                                        <td t-field="reparaciones.caseteras_id" class="m-0"/>
                                        <th>Duplex</th>
                                        <td t-field="reparaciones.duplex_id" class="m-0"/>
                                    </tr>
                                    <tr>
                                        <th>Bypass</th>
                                        <td t-field="reparaciones.bypass_id" class="m-0"/>
                                        <th>Copia</th>
                                        <td t-field="reparaciones.copia_id" class="m-0"/>
                                        <th>Impresión</th>
                                        <td t-field="reparaciones.impresion_id" class="m-0"/>
                                    </tr>
                                    <tr>
                                        <th>Impresión USB</th>
                                        <td t-field="reparaciones.impresion_usb_id" class="m-0"/>
                                        <th>Scaner SMB</th>
                                        <td t-field="reparaciones.scaner_smb_id" class="m-0"/>
                                        <th>Scaner USB</th>
                                        <td t-field="reparaciones.scaner_usb_id" class="m-0"/>
                                    </tr>
                                    <tr>
                                        <th>Scaner FTP</th>
                                        <td t-field="reparaciones.scaner_ftp_id" class="m-0"/>
                                        <th>Scaner Mail</th>
                                        <td t-field="reparaciones.scaner_mail_id" class="m-0"/>
                                        <th>Developer black</th>
                                        <td t-field="reparaciones.developerk_id" class="color-black m-0"/>
                                    </tr>
                                    <tr>
                                        <th>Developer magenta</th>
                                        <td t-field="reparaciones.developerm_id" class="color-magenta m-0"/>
                                        <th>Developer cyan</th>
                                        <td t-field="reparaciones.developerc_id" class="color-cyan m-0"/>
                                        <th>Developer yellow</th>
                                        <td t-field="reparaciones.developery_id" class="color-yellow m-0"/>
                                    </tr>
                                    <tr>
                                        <th>Chip Developer Cyan</th>
                                        <td t-field="reparaciones.chip_developerc_id" class="color-cyan m-0"/>
                                        <th>Chip Developer Magenta</th>
                                        <td t-field="reparaciones.chip_developerm_id" class="color-magenta m-0"/>
                                        <th>Chip Developer Yellow</th>
                                        <td t-field="reparaciones.chip_developery_id" class="color-yellow m-0"/>
                                    </tr>
                                    <tr>
                                        <th>Chip Developer Black</th>
                                        <td t-field="reparaciones.chip_developerk_id" class="color-black m-0"/>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
